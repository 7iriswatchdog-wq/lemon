@{
    ViewData["Title"] = "Parameter Master";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
<script src="~/plugins/jquery/jquery.min.js"></script>


<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">List</h3>
                        <a href="@Url.Action("Create", "parametermaster")" type="button" class="btn btn-info btn-sm float-right">Add New</a>
                    </div>
                    <div class="card-body">
                        <div style="width: 100%; padding-left: -10px;">
                            <div class="table-responsive">
                                <table id="example" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>value</th>
                                            <th>Type</th>  
                                            <th>Edit</th>
                                            <th>Delete</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">

    var table;
    $(document).ready(function () {
        table = $('#example').DataTable({
            "serverSide": true, "processing": true,
            order: [[0, 'desc']],
            ajax: {
                url: 'parametermaster/custompagination',
                type: 'POST'
            },
            columns: [
                { data: "paraCode" },
                { data: "paraValue" },
                { data: "paraType" },
                {
                    "render": function (data, type, full, meta, row) { return '<a class="btn btn-info" href="parametermaster/edit/' + full.paraCode + '/' + full.paraType + '">Edit</a>'; }
                },
                {
                    
                    "render": function (data, type, full, meta, row) {
                        return '<a  class="btn btn-danger" href="codesmaster/delete/' + full.paraCode + '/' + full.paraType + '" >Delete</a>';
                    }
                },
            ]
        });
    });


   
</script>
