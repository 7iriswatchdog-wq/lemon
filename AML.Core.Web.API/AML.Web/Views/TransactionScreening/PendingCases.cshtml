<script type="text/javascript">
    function confirmSubmit()
    {
        var agree = confirm("Are you sure you wish to continue?");
        if (agree)
            return true;
        else
            return false;
    }
    var table;



    $(document).ready(function () {

        LoadTable();

    });


function LoadTable() {
     var tranref = $("#hdntranrefno").val();

        table = $('#example').DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "order": [[0, 'asc']], // default sorting column(1 = "id") and sorting order
            "iDisplayLength": 25,
            "destroy": true,
            ajax: {
                url: '/transactioncase/pendingcases',
                type: 'POST',
                data : function(d)
                        {
                             d.tranrefno = tranref
                        },

                complete: function (data) {
                console.log(data);
                wait = false; }
                 
            },
            columns: [
                {
                    "render": function (data, type, full, meta) { return '<a class="btn btn-info btn-sm" title="@localizer["Process"]" href="/transactioncase/process/' + full.id + '"><i class="fas fa-arrow-right"></i></a>'; }
                },
                { data: "id" },
                { data: "custrefno" },
                { data: "name" },
                { data: "createdOnDB" },       
                { data: "matchscore" },
            ],
            error: function (e, message) {
                jQuery("#example").dataTable({

                }),
                    alert(message);
            },

            destroy: true
            
        });
        $.fn.dataTable.ext.errMode = 'throw';
      
    }
  
</script>