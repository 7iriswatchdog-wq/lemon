@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = @localizer["Transaction Screening Case"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="~/plugins/jquery/jquery.min.js"></script>
@model AML.ViewModel.ViewModels.Report.ReportLogSearchModel

@*<div class="se-pre-con1"></div>*@
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary br-20 bg-blue" style="margin-bottom: 0;">
                    <div class="card-header" style="background-color: transparent;border-radius: 20px;padding: 0;">
                        <h4 class="mb-0"><b>@localizer["Transaction Screening - Case Details "]</b></h4>
                    </div>
                    @*<div class="card-body bg-blue">
                        <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="dtStartDate">@localizer["Start Date"]</label>
                                    <input type="date" asp-for="StartDate" class="form-control" id="dtStartDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder="Start Date">
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="dtEndDate">@localizer["End Date"]</label>
                                <input type="date" asp-for="EndDate" class="form-control" id="dtEndDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder="End Date">
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
          
                        </div>
            
                    </div>*@

                    @*  <div class="card-footer fc-center">
                    <button type="submit" id="btnSearch" class="btn btn-primary center" onclick="LoadTable();">@localizer["Go"]</button>
                    </div>*@
                    <!-- /.card-body -->
                    <!--/form-->
                </div><br/>
                <div class="card card-body bg-blue br-20">
                    <div style="width: 100%; padding-left: -10px;">
                        <div class="table-responsive">
                            <table id="example" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>@localizer["Action"]</th>
                                        <th>@localizer["Transaction RefNo"]</th>
                                        <th>@localizer["Created Date"]</th>
                                        <th>@localizer["Case Count"]</th>
                                        <th>@localizer["Pending Count"]</th>
                                        <th>@localizer["Approved Count"]</th>
                                        @*<th>@localizer["Rejected Count"]</th>*@
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    function confirmSubmit()
    {
        var agree = confirm("Are you sure you wish to continue?");
        if (agree)
            return true;
        else
            return false;
    }
    var table;

    $( window ).on( "load", function() {
        console.log(sessionStorage.getItem('MiddlewareResponse'))
        const caseResponse = sessionStorage.getItem('CaseResponse');
        const middlewareResponse = JSON.parse(sessionStorage.getItem('MiddlewareResponse') || null);

        if (caseResponse){
            toastr.success(caseResponse);

            if (middlewareResponse && middlewareResponse?.statusCode !== 200){
                toastr.error(middlewareResponse?.content || middlewareResponse?.errorMessage || "Some error occured in callback")
            } else {
                toastr.success(middlewareResponse?.content || "Callback sucessfull");
            }
        }

        sessionStorage.setItem('CaseResponse', "");
        sessionStorage.setItem('MiddlewareResponse', "");
    })

    $(document).ready(function () {
        LoadTable();
    });


function LoadTable() {
     var startDate = $('#dtStartDate').val();
     var endDate = $('#dtEndDate').val();

        table = $('#example').DataTable({
             "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "order": [[0, 'asc']], // default sorting column(1 = "id") and sorting order
            "iDisplayLength": 25,
            "destroy": true,
             "columnDefs": [{
                        "defaultContent": "-",
                        "targets": "_all"
                            }],
            ajax: {
                url: '/transactioncase/pendingtransactions',
                type: 'POST',
               
                "datatype": "json",
                "dataSrc":"data",
                "data": {
                    "startDate": startDate,
                    "endDate": endDate
                },


                complete: function (data) {
                    console.log(data);
                    wait = false; }
                 
            },
            columns: [
                {
                    "render": function (data, type, full, meta) { return '<a class="btn btn-info" href="/transactioncase/pendingcases/' + full.tranrefno + '">@localizer["View"]</a>'; }
                },
                //{ data: "tranrefno" },
                
                 {
                    "data": "tranrefno", "name": "Tran Ref No", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.tranrefno;
                    }
                },
                { data: "createdOn" },

               
                  {
                    "data": "caseCount", "name": "Case #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.caseCount;
                    }
                    
               },
                 {
                    "data": "pending", "name": "Pending #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.pending;
                    }
                    
               },
               {
                    "data": "approved", "name": "Approved #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.approved;
                    }
                    
               },
               //{
               //     "data": "rejected", "name": "Rejected #", "autoWidth": true,
               //     "render": function (data, type, row) {
               //         return row.rejected;
               //     }
                    
               //}

             
            ],
            error: function (e, message) {
                jQuery("#example").dataTable({

                }),
                    alert(message);
            },

            destroy: true
            
        });
        $.fn.dataTable.ext.errMode = 'throw';
      
    }
  
</script>