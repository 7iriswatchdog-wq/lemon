@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = localizer["Manage Transaction Case"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.TransactionScreening.TransactionCaseProcessModel
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<style>


    .modal-confirm {
        color: #543fad;
        width: 325px;
        margin: 30px auto;
    }

        .modal-confirm .modal-content {
            padding: 20px;
            border-radius: 5px;
            border: none;
        }

        .modal-confirm .modal-header {
            border-bottom: none;
            position: relative;
        }

        .modal-confirm h4 {
            text-align: center;
            font-size: 26px;
            margin: 30px 0 -15px;
        }

        .modal-confirm .form-control, .modal-confirm .btn {
            min-height: 40px;
            border-radius: 3px;
        }

        .modal-confirm .close {
            position: absolute;
            top: -5px;
            right: -5px;
        }

        .modal-confirm .modal-footer {
            border: none;
            text-align: center;
            border-radius: 5px;
            font-size: 13px;
        }

        .modal-confirm .icon-box {
            color: floralwhite;
            position: absolute;
            margin: 0 auto;
            left: 0;
            right: 0;
            top: -70px;
            width: 95px;
            height: 95px;
            border-radius: 50%;
            z-index: 9;
            background: #543fad;
            padding: 15px;
            text-align: center;
            box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.1);
        }

            .modal-confirm .icon-box i {
                font-size: 58px;
                position: relative;
                top: 3px;
            }

        .modal-confirm.modal-dialog {
            margin-top: 80px;
        }

        .modal-confirm .btn, modal-content .btn-primary {
            color: floralwhite;
            border-radius: 4px;
            background: #543fad;
            text-decoration: none;
            transition: all 0.4s;
            line-height: normal;
            border: none;
        }



    .trigger-btn {
        display: inline-block;
        margin: 100px auto;
    }
</style>

<script src="~/plugins/jquery/jquery.min.js"></script>
<div class="card card-primary">
    <div class="px-6 py-4 border-b border-bordercolor">
        <div class="row">
            <div class="col"><b>@localizer["Transaction Reference No"]:</b> @(Model.Case.TranRefNo)</div>
            <div class="col"><b>@localizer["Customer Id"]:</b> @(Model.Case.CustRefNo)</div>
            <div class="col"><b>@localizer["Customer Name"]:</b> @(Model.Case.Name)</div>                
            
            <div class="col"><b>@localizer["Status"]:</b> @(Convert.ToString((AML.Core.DataContract.Enum.CaseStatus)Model.Case.Status))</div>
           
          

        </div>
    </div>
    <input id="hdnStatus" type="hidden" name="CaseId" value="@(Model.Case.Status)" />
    <input id="hdntranrefno" type="hidden" name="TranRefNo" value="@(Model.Case.TranRefNo)" />
    <!-- /.card-header -->
    <!-- form start -->
    <form role="form" id="frmDocument" class="form-horizontal" enctype="multipart/form-data" method="post">
        <input id="hdnCaseId" type="hidden" name="CaseId" value="@Model.Case.id" />
        <div class="p-6">
            <h2>@localizer["Case"]: @Model.Case.id</h2>
            <div class="row">

                <div class="col"><b>@localizer["Fullname"]:</b> @(Model.Case.Name)</div>
                <div class="col"><b>@localizer["Status"]:</b> @(Convert.ToString((AML.Core.DataContract.Enum.CaseStatus)Model.Case.Status))</div>
                   
            </div>
            <div class="row">
                
                <div class="col"><b>@localizer["Match score"]:</b> @(Model.Case.MatchScore)%</div>
                <div class="col"><b>@localizer["Nationality"]:</b> @(Model.Case.Country)</div>
               @* <div class="col"><b>@localizer["DOB"]:</b> @DateTime.Parse(Model.Case.DOB).ToString("dd-MMM-yyyy")</div>*@
            </div>
            <div class="row">
                <div class="col"><b>@localizer["Source"]:</b> @(Model.Case.Source)</div>
                <div class="col"><b>@localizer["Source Id"]:</b> @(Model.Case.SourceUniqueId)</div>
                @*<div class="col"><b>@localizer["Id Type"]:</b> @(Model.Case.CustomerIdType)</div>*@
            </div>
          
            <hr />
            <div class="row" style="display:none;">
                <div class="col-4">
                    <div class="form-group">
                        <label>@localizer["Document Categories"]</label>
                        <select id="ddlCategories" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" name="DocumentCategory" asp-items="Model.DocumentCategories">
                            <option value="0">--@localizer["EMPTY"]--</option>
                        </select>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label>@localizer["Document Types"]</label>
                        <select id="ddlType" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" name="DocumentType" asp-items="Model.DocumentTypes">
                            <option value="0">--@localizer["EMPTY"]--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label for="txDocNo">@localizer["Document No"]</label>
                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtDocNo" name="DocumentName" placeholder=@localizer["Document No"]>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="txIssuedDate">@localizer["Issued Date"]</label>
                        <input type="date" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtIssuedDate" name="IssuedDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder=@localizer["Document Issued Date"]>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="txtExpiryDate">@localizer["Expiry Date"]</label>

                        <input type="date" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtExpiryDate" name="ExpiryDate" min="@(DateTime.Now.ToString("yyyy-MM-dd"))" max="4444-12-31" placeholder=@localizer["Document Expiry Date"]>

                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label for="txtDetails">@localizer["Document Details"]</label>
                        <textarea rows="3" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtDetails" name="DocumentDetails" placeholder=@localizer["Document Details"]></textarea>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="txtRemarks">@localizer["Remarks"]</label>
                        <textarea rows="3" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtRemarks" name="Remarks" placeholder=@localizer["Remarks"]></textarea>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label for="txtFile">@localizer["Document"]</label>
                        <input type="file" name="Document" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtFile" placeholder=@localizer["Document Expiry Date"]>
                    </div>
                </div>
                <div class="col-4">
                </div>
                <div class="col-2">
                    <!-- Button trigger modal -->
                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#docModal">
                        @localizer["View Uploaded Documents"]
                    </button>
                </div>
            </div>



            <button type="submit" class="btn btn-primary" title="@localizer["Save the Document"]" aria-label="@localizer["Save the Document"]"><i class="fas fa-save"></i></button>
            @*<button type="button" class="btn btn-danger" onclick="clearDocuemnt();">New Document</button>*@
        </div>
    </form>


    <form role="form" id="frmCmment" class="form-horizontal" enctype="multipart/form-data" method="post">

        <input type="hidden" name="CaseId" value="@Model.Case.id" />
        <div class="p-6" style="overflow: scroll;overflow-x:hidden; height:auto; max-height: 400px; ">
            <h3>@localizer["Case Comments"]</h3>

            <div class="col-md-12">
                @*//  The time line*@

                <div id="Comments">
                    @*   //    Timeline time label*@
                    <div class="time-label">
                        @* //   <span class="bg-red">10 Feb. 2014</span>*@
                    </div>
                    @*//  Timeline-label*@
                    <div class="comment-section timeline">
                    </div>
                </div>
                <div id="nocomment"><label>No comments yet</label></div>
            </div>
        </div>
        <br />
        <div class="input-group" style="width:94%;padding-left:2%;">
            @*<input type="text" id="txtCaseComment" name="Comment" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">*@
            <textarea id="txtCaseComment" name="Comment" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" placeholder="Enter Your Comments" rows="2"></textarea>
            <span class="input-group-btn">
                &nbsp;&nbsp;<button type="submit" class="btn btn-info btn-flat">Send <i class="fa fa-paper-plane" aria-hidden="true"></i></button>
            </span>
        </div>

    </form>




    <div class="p-6">

        @*<h3>@localizer["Case Action"]</h3>*@
        <form role="form" id="frmCloseCase" class="form-horizontal" enctype="multipart/form-data" method="post">
            <input type="hidden" name="CaseId" value="@Model.Case.id" />



            <input type="hidden" id="hdnTransferUser" name="TransferUser" value="" />
            <input type="hidden" id="hdnRemark" name="Comment" value="" />
            <input type="hidden" id="hdnAction" name="Action" value="" />



            <div class="row" style="display:none;">
                <div class="col-6">
                    <div class="form-group">
                        <label for="txtDescription">@localizer["Remarks"]</label>
                        <textarea rows="3" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCaseActionRemarks" name="Comment" placeholder=@localizer["Remarks"]></textarea>
                    </div>
                </div>
            </div>
            <input type="submit" name="Approve" class="btn btn-success" onClick='return confirmSubmit()' value=@localizer["Approve Case"] />

            @*<input type="submit" name="Reject" class="btn btn-danger" value=@localizer["Reject Case"] />*@
            <input type="submit" name="Reject" class="btn btn-danger" onClick='return confirmSubmit()' value=@localizer["Reject"] />


            @*<input type="submit" name="Whitelist" class="btn btn-success" value=@localizer["Whitelist Case"] />*@
            <input type="submit" name="Whitelist" class="btn btn-success" onClick='return confirmSubmit()' style = "display:none" value=@localizer["Whitelist"] />

        @*    @{
                //if (@Model.Users.Count() != 0)
                //{
                    <button type="button" name="Transfer" class="btn btn-success" data-toggle="modal" data-target="#assignModal" title="@localizer["Transfer Case"]" aria-label="@localizer["Transfer Case"]"><i class="fas fa-share"></i></button>

                //}
            }*@

        </form>
        <hr />


        <h3>@localizer["API Result"]</h3>
        @if (@Model.DataList != null)
        {
            <div class="table-responsive">
                <table id="APITable" class="w-full text-sm text-left" cellspacing="0">
                    <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                        <tr>
                            <th>@localizer["Id"]</th>
                            <th>@localizer["Type"]</th>
                            <th>@localizer["Category"]</th>
                            <th>@localizer["Name"]</th>
                            <th>@localizer["Score"]</th>
                            <th>@localizer["Nationality"]</th>
                            <th>@localizer["Id No"]</th>
                            <th>@localizer["DOB"]</th>
                            <th style=" @(@Model.Case.Source != "KYC6" ? "display:none" : "height:auto")">@localizer["Details"]</th>
                            <th style=" @(@Model.Case.Source != "KYC6" ? "display:none" : "height:auto")">@localizer["Download"]</th>
                            <th>@localizer["Remarks"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bordercolor">

                        @foreach (var item in @Model.DataList)
                        {
                            <tr>
                                <td>@item.matchuid</td>
                                <td>@item.matchtype</td>
                                <td>@item.matchcategory</td>
                                <td>@item.matchname</td>
                                <td>@item.matchscore</td>
                                <td>@item.matchnationality</td>
                                <td>@item.matchidno</td>
                                <td>@item.matchdob</td>
                                <td style=" @(item.matchtype != "KYC6" ? "display:none" : "height:auto")">
                                    <input type="button" value=@localizer["Details"] onclick="location.href='@Url.Action("GetDetailsApi", "Case", new { Id = @item.matchuid, Category = @item.matchcategory })'" />
                                </td>
                                <td style=" @(item.matchtype != "KYC6" ? "display:none" : "height:auto")">
                                    <input type="button" value=@localizer["Download"] onclick="location.href='@Url.Action("CallApi", "Case", new { Id = @item.matchuid, Category = @item.matchcategory })'" />
                                </td>
                                <td>
                                    <textarea rows="2" asp-for="@item.remarks" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="apiResultRemarks" name="Comment" placeholder=@localizer["Remarks"]></textarea>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
                <input type="submit" value="Save Remarks" class="btn btn-success" onclick="saveRemarks(@Model.Case.id)" />
            </div>
        }
       
        <!-- Modal -->
        <div class="modal fade" id="assignModal" tabindex="-1" role="dialog" aria-labelledby="docModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form role="form" id="frmTransferCase" class="form-horizontal" enctype="multipart/form-data" method="post">
                        <div class="modal-header">
                            <h2>Transfer</h2>

                            <input type="hidden" name="CaseId" value="@Model.Case.id" />
                            <input type="hidden" id="hdnTransferUserTransfer" name="TransferUser" value="" />
                            <input type="hidden" id="hdnRemarkTransfer" name="Comment" value="" />
                        </div>
                        <div class="modal-body">
                            <div class="col-4">
                                <div class="form-group">
                                    <label>Transfer To (Officer)</label>
                                    <select id="ddlUsers" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" name="UserId" asp-items="Model.Users">
                                        <option value="0">--EMPTY--</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" id="btnTransfer" class="btn btn-primary">Transfer Case</button>
                        </div>
                    </form>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">@localizer["Close"]</button>
                    </div>
                </div>
            </div>


        </div>

        <!-- Modal -->
        <div class="modal fade" id="docModal" tabindex="-1" role="dialog" aria-labelledby="docModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="docModalLabel">@localizer["Documents"]</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <ul>
                            @foreach (var item in Model.CaseDocuments)
                            {
                                @*<li><a href="" onclick="DownloadDocument('@item.DocumentFullPath', '@item.DocumentFileName');" target="_self" download>@item.DocumentFileName</a></li>*@
                                <li><a href='/TransactionScreening/DownloadCaseDocument?filePath=@item.DocumentFullPath&fileName=@item.DocumentFileName' download='@item.DocumentFileName'>@item.DocumentFileName</a></li>
                            }
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">@localizer["Close"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!----Modal to Confirm Deletion starts here--->

<input type="hidden" id="hiddenId" />


<div id="confirmDeleteModal" class="modal fade" role='dialog'>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Information</h2>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times</button>
                <!--<h4 class="modal-title">Delete </h4> -->

            </div>
            <div class="modal-body">
                <p>Are You Sure to Approve Case?</p>

            </div>
            <div class="modal-footer">
                <!-- <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
    <span id='deleteButton'></span>-->
                <button type="button" class="btn btn-default" data-dismiss="modal" title="Cancel" aria-label="Cancel"><i class="fas fa-times"></i></button>
                <button type="button" class="btn btn-primary" onclick="confirm()" title="Confirm" aria-label="Confirm"><i class="fas fa-check"></i></button>
            </div>

        </div>
    </div>
</div>




<script type="text/javascript">

    function confirmSubmit() {
        var agree = confirm("Are you sure you wish to continue?");
        if (agree)
            return true;
        else
            return false;
    }

    function DownloadDocument(fiPath, fiName) {
        $.ajax({
            type: "GET",
            url: "/TransactionScreening/DownloadCaseDocument",
            data: {
                filePath: fiPath,
                fileName: fiName
            },
            success: function (data) {
                window.location = '/TransactionScreening/DownloadCaseDocument?filePath=' + fiPath + '&fileName=' + fiName;
            },
            error: function (result) {
                alert('error');
            }
        });
    }
</script>
<script type="text/javascript">
    var comments = [];
    $('#Comments').hide();
    $('#nocomment').show();

    $(document).ready(function () {

        if ($('#hdnStatus').val() == '2' || $('#hdnStatus').val() == '3') {
            $('#txtCaseActionRemarks').attr('disabled', 'disabled');
            $("input[type=submit]").attr('disabled', 'disabled');
            $('#ddlUsers').attr('disabled', 'disabled');
            $("#btnTransfer").attr('disabled', 'disabled');
        }

        $.ajax({
            url: '/transactioncase/comment/' + $('#hdnCaseId').val(),
            type: 'get',
            success: function (response) {
                comments = response;
                buildComments();
            },
            cache: false
        });
    });


    $('#frmDocument').submit(function (e) {
        e.preventDefault();


        if (document.getElementById("txtFile").value == "") {
            e.preventDefault();
            alert("Please select a file.");
            return false;
        }
       

        var formdata = new FormData();
        formdata.append('CaseId', $('#hdnCaseId').val());
        formdata.append('TranRefNo', $('#hdntranrefno').val());
        formdata.append('DocumentName', $('#txtDocNo').val());
        formdata.append('DocumentCategory', $('#ddlCategories').val());
        formdata.append('DocumentType', $('#ddlType').val());
        formdata.append('Document', $('#txtFile')[0].files[0]);
        formdata.append('Remarks', $('#txtRemarks').val());
        formdata.append('DocumentDetails', $('#txtDetails').val());
        formdata.append('IssuedDate', $('#txtIssuedDate').val());
        formdata.append('ExpiryDate', $('#txtExpiryDate').val());
        $.ajax({
            url: '/transactioncase/document',
            type: 'post',
            data: formdata,
            contentType: false,
            processData: false,
            success: function () {
                clearDocuemnt();
                toastr.success('Document Updated');
                location.reload();
            }
        });
    });
    function saveRemarks(id) {
        var model = new Array();
        $("#APITable TBODY TR").each(function () {
            var row = $(this);
            var result = {};
            result.matchuid = row.find("TD").eq(0).html();
            result.matchtype = row.find("TD").eq(1).html();
            result.matchcategory = row.find("TD").eq(2).html();
            result.matchname = row.find("TD").eq(3).html();
            result.matchcore = row.find("TD").eq(4).html();
            result.matchnationality = row.find("TD").eq(5).html();
            result.matchidno = row.find("TD").eq(6).html();
            result.matchdob = row.find("TD").eq(7).html();
            result.remarks = row.find("TD").eq(10).find("textarea").val()
            model.push(result);
        });


        $.ajax({
            url: '/transactioncase/saveRemark',
            type: 'post',
            //  contentType: 'application/json'
            data:
            {
                id: id,
                model: model
            },


            //     dataType: "json",
            success: function (response) {
                toastr.success(response);
            }
        });
    }

    $('#frmCmment').submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: '/transactioncase/comment',
            type: 'post',
            data: $('#frmCmment').serialize(),
            success: function (response) {
                comments = response;
                $('.commment-list').remove();
                buildComments();
            }
        });
    });




    $('#frmCloseCase').submit(function (e) {
        e.preventDefault();

        $('#hdnRemark').val($('#txtCaseActionRemarks').val());
        $('#hdnRemark').val($('#txtCaseComment').val());
        var val = $("input[type=submit][clicked=true]").val();
        if (val == 'Approve') {
            $('#hdnAction').val(2);

        } else if (val == 'Whitelist') {
            $('#hdnAction').val(1);
        }
        else if (val == 'Reject') {
            $('#hdnAction').val(3);
        }
        else if (val == 'Transfer Case') {
            $('#hdnTransferUser').val($("#ddlUsers option:selected").text());
            $('#hdnAction').val(4);
        }
        $.ajax({
            url: '/transactioncase/close',
            type: 'post',
            data: $('#frmCloseCase').serialize(),
            success: function (response) {
                $('#txtCaseActionRemarks').val('');
                $('#txtCaseActionRemarks').attr('disabled', 'disabled');
                $("input[type=submit]").attr('disabled', 'disabled');
                $('#ddlUsers').attr('disabled', 'disabled');
                $("#btnTransfer").attr('disabled', 'disabled');
                sessionStorage.setItem('CaseResponse', response[0]);
                sessionStorage.setItem('MiddlewareResponse', response[1]);
                console.log(response);
                location.href = '/transactioncase';
            }
        });
    });
    $("#frmCloseCase input[type=submit]").click(function () {
        $("input[type=submit]", $(this).parents("form")).removeAttr("clicked");
        $(this).attr("clicked", "true");
    });

    $('#frmTransferCase').submit(function (e) {
        e.preventDefault();
        // location.href = "/case/assign";
        $('#hdnTransferUserTransfer').val($("#ddlUsers option:selected").text());
        //$('#hdnRemarkTransfer').val($('#txtCaseActionRemarks').val());
        $('#hdnRemarkTransfer').val($('#txtCaseComment').val());
        $.ajax({
            url: '/transactioncase/assign',
            type: 'post',
            data: $('#frmTransferCase').serialize(),
            success: function () {
                $('#ddlUsers').val(0);
                toastr.success('Case Transferred');
                setTimeout(function () { location.href = '/case'; }, 3000);
                location.href = '/transactioncase';
            }
        });
    });


    function buildComments() {
        if (comments.length) {
            $('#Comments').show();
            $('#nocomment').hide();
            var template = '<div class="commment-list"><i class="fas fa-user bg-green"></i><div class="timeline-item"><span class="time" ><i class="fas fa-clock"></i> <label class="time-ago"></label></span >' +
                '<h3 class="timeline-header no-border"><a class="a-user" href="#"></a>&nbsp;&nbsp;<label class="case-comment"></label></h3></div></div>';
            $("#Comments").find('div.comment-section').prepend(template);
            $.each(comments, function (i, v) {
               
                setDataOnRow($(template), v, i);
                
            });
            $('#txtCaseComment').val('');
           
            $($("#Comments").find('div.commment-list').last()).remove();
            $($("#Comments").find('i').last()).remove();
            $($("#Comments").find('div.commment-list').parent()).append('<div><i class= "fas fa-clock bg-gray" ></i></div>');
        }
    }

    function setDataOnRow(rowObject, v, i) {
        $(rowObject).find(".a-user").html(v.createdUser);
        $(rowObject).find(".time-ago").html(v.duration);
        $(rowObject).find(".case-comment").html(v.comment);
        $("#Comments").find('div.comment-section').prepend(rowObject);
    }
    function clearDocuemnt() {
        $('#frmDocument').find("input[type=text], textarea").val("");
        $('#frmDocument').find("input[type=file]").val(null);
        $('#frmDocument').find("select").val(0);
    }
</script>