@using AML.Core.ServiceContract.AmlTracker
@using AML.ViewModel.ViewModels.AmlTracker
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject IAmlTrackerService TrackerService
@inject AML.Web.Helper.IHttpClientHandler ClientHandler
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var userName = HttpContextAccessor.HttpContext.Session.GetString("SessUsername") ?? "User";
    var greeting = DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening";

    int totalCases = (int)(ViewBag.totalcount ?? 0);
    int pending = (int)(ViewBag.pendingvalcount ?? 0);
    int approved = (int)(ViewBag.Toatalapprovedcount ?? 0);
    int rejected = (int)(ViewBag.rejectvalcount ?? 0);
    int autoApproved = (int)(ViewBag.autoapproved ?? 0);
    int manualApproved = (int)(ViewBag.ManuallyApproved ?? 0);
    int totalHigh = (int)(ViewBag.totalhighrisk ?? 0);
    int totalMedium = (int)(ViewBag.totalmediumrisk ?? 0);
    int totalLow = (int)(ViewBag.totallowrisk ?? 0);
    int unclassified = (int)(ViewBag.Unclassifiedriskcount ?? 0);
    int individuals = (int)(ViewBag.individualcustomertype ?? 0);
    int corporates = (int)(ViewBag.corporatecustomertype ?? 0);

    // Live values from the tracker service for a richer dashboard
    SummaryJsonVM summary = null;
    AmlTrackerIndexVM trackerSnap = null;
    try { summary = TrackerService.GetSummary(ClientHandler.GetUserId(), ClientHandler.GetClientId()); } catch { }
    try { trackerSnap = TrackerService.GetTracker(new AmlTrackerFilterVM(), ClientHandler.GetUserId(), "", ClientHandler.GetClientId(), null); } catch { }

    // Risk distribution segments (avoid divide-by-zero)
    int totalForRisk = Math.Max(1, totalHigh + totalMedium + totalLow + unclassified);
    double pHigh = totalHigh * 100.0 / totalForRisk;
    double pMed = totalMedium * 100.0 / totalForRisk;
    double pLow = totalLow * 100.0 / totalForRisk;
    double pUnc = unclassified * 100.0 / totalForRisk;

    // Status segments for case-mix bar
    int totalForStatus = Math.Max(1, approved + pending + rejected + autoApproved);
    double sApproved = (manualApproved + autoApproved) * 100.0 / totalForStatus;
    double sPending = pending * 100.0 / totalForStatus;
    double sRejected = rejected * 100.0 / totalForStatus;

    // Donut math
    double Circumference = 2 * Math.PI * 80;
    double DashHigh = pHigh / 100.0 * Circumference;
    double DashMed = pMed / 100.0 * Circumference;
    double DashLow = pLow / 100.0 * Circumference;
    double DashUnc = pUnc / 100.0 * Circumference;

    // Recent cases (top 8 from tracker snapshot)
    var recentCases = trackerSnap?.Rows?.OrderByDescending(r => r.CreatedOn).Take(8).ToList() ?? new List<AmlTrackerRowVM>();
    // High-risk open cases for alerts
    var highRiskOpen = trackerSnap?.Rows?
        .Where(r => string.Equals(r.RiskTier, "High", StringComparison.OrdinalIgnoreCase) && r.SlaStatus != "Closed")
        .OrderByDescending(r => r.AgingDays ?? 0).Take(5).ToList() ?? new List<AmlTrackerRowVM>();
    // SLA-breaching cases
    var slaBreaches = trackerSnap?.Rows?
        .Where(r => string.Equals(r.SlaStatus, "Breach", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(r => r.AgingDays ?? 0).Take(5).ToList() ?? new List<AmlTrackerRowVM>();
}

<style>
    .dash-bg{background:linear-gradient(180deg,#f8fafc 0%,#eff6ff 60%,#f8fafc 100%);min-height:100vh}
    .dash-hero{background:linear-gradient(135deg,#1e3a8a 0%,#3730a3 50%,#5b21b6 100%);color:#fff;border-radius:20px;padding:32px;position:relative;overflow:hidden;box-shadow:0 20px 40px -20px rgba(67,56,202,.45)}
    .dash-hero::before{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.12),transparent 70%)}
    .dash-hero::after{content:'';position:absolute;bottom:-150px;left:-50px;width:350px;height:350px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.08),transparent 70%)}
    .dash-hero-inner{position:relative;z-index:1}
    .kpi-card{background:#fff;border-radius:16px;padding:20px;box-shadow:0 1px 2px rgba(15,23,42,.04);border:1px solid #e2e8f0;transition:all .25s ease;position:relative;overflow:hidden}
    .kpi-card:hover{transform:translateY(-2px);box-shadow:0 12px 24px -8px rgba(15,23,42,.12);border-color:#c7d2fe}
    .kpi-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:14px}
    .kpi-num{font-size:36px;font-weight:800;color:#0f172a;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
    .kpi-label{font-size:11px;color:#64748b;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-top:6px}
    .kpi-sub{font-size:12px;color:#94a3b8;margin-top:4px}
    .glass-card{background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.18);border-radius:16px;box-shadow:0 8px 24px -8px rgba(15,23,42,.10)}
    .panel{background:#fff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 1px 2px rgba(15,23,42,.04);padding:20px}
    .panel-title{font-size:14px;font-weight:700;color:#0f172a;letter-spacing:-.01em;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .panel-title-link{font-size:12px;font-weight:600;color:#4f46e5;text-decoration:none}
    .panel-title-link:hover{text-decoration:underline}
    .quick-action{display:flex;align-items:center;gap:12px;padding:14px 16px;background:#fff;border:1px solid #e2e8f0;border-radius:14px;text-decoration:none;color:#1e293b;transition:all .2s ease;position:relative;overflow:hidden}
    .quick-action:hover{transform:translateY(-1px);box-shadow:0 8px 16px -4px rgba(15,23,42,.10);border-color:#c7d2fe;color:#1e293b}
    .quick-action::before{content:'';position:absolute;top:0;left:0;width:0;height:100%;background:linear-gradient(90deg,rgba(99,102,241,.05),transparent);transition:width .25s ease}
    .quick-action:hover::before{width:100%}
    .qa-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;color:#fff;flex-shrink:0;position:relative}
    .qa-text{flex:1;position:relative}
    .qa-title{font-size:14px;font-weight:600;color:#0f172a;line-height:1.2}
    .qa-sub{font-size:12px;color:#64748b;margin-top:2px}
    .donut-wrap{position:relative;width:200px;height:200px;margin:0 auto}
    .donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
    .donut-num{font-size:28px;font-weight:800;color:#0f172a;line-height:1}
    .donut-lbl{font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-top:4px}
    .legend{display:flex;flex-direction:column;gap:8px;margin-top:14px}
    .legend-row{display:flex;align-items:center;gap:8px;font-size:13px;color:#334155;text-decoration:none;padding:4px 6px;margin:-4px -6px;border-radius:6px;transition:background .15s}
    .legend-row:hover{background:#f1f5f9;color:#0f172a}
    a.kpi-card,a.glass-card{text-decoration:none;color:inherit;display:block}
    a.glass-card:hover{background:rgba(255,255,255,1)}
    a.stack-seg{text-decoration:none}
    .legend-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
    .legend-num{margin-left:auto;font-weight:700;color:#0f172a;font-variant-numeric:tabular-nums}
    .stack-bar{display:flex;height:24px;border-radius:8px;overflow:hidden;background:#f1f5f9}
    .stack-seg{display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;transition:all .3s ease}
    .stack-seg:hover{filter:brightness(1.05)}
    .pulse{position:absolute;top:8px;right:8px;width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 0 0 rgba(16,185,129,.5);animation:pulse 2s infinite}
    @@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}70%{box-shadow:0 0 0 8px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
    .alert-card{padding:12px 14px;border-radius:12px;border:1px solid;display:flex;align-items:center;gap:12px;transition:all .2s}
    .alert-card:hover{transform:translateX(2px)}
    .alert-rose{background:#fff1f2;border-color:#fecaca;color:#9f1239}
    .alert-amber{background:#fffbeb;border-color:#fde68a;color:#92400e}
    .alert-blue{background:#eff6ff;border-color:#bfdbfe;color:#1e40af}
    .case-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f1f5f9;text-decoration:none;color:inherit;transition:background .15s}
    .case-row:hover{background:#f8fafc;color:inherit}
    .case-row:last-child{border-bottom:none}
    .case-avatar{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;flex-shrink:0;font-size:13px}
    .pill{padding:2px 8px;font-size:10px;font-weight:700;border-radius:10px;text-transform:uppercase;letter-spacing:.04em}
    .pill-high{background:#fee2e2;color:#991b1b}
    .pill-med{background:#fef3c7;color:#92400e}
    .pill-low{background:#d1fae5;color:#065f46}
    .pill-unc{background:#f1f5f9;color:#475569}
    .grad-blue{background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff}
    .grad-amber{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff}
    .grad-rose{background:linear-gradient(135deg,#f43f5e,#e11d48);color:#fff}
    .grad-emerald{background:linear-gradient(135deg,#10b981,#059669);color:#fff}
    .grad-violet{background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff}
    .grad-slate{background:linear-gradient(135deg,#64748b,#475569);color:#fff}
    .ico-blue{background:#dbeafe;color:#1d4ed8}
    .ico-amber{background:#fef3c7;color:#b45309}
    .ico-rose{background:#fee2e2;color:#b91c1c}
    .ico-emerald{background:#d1fae5;color:#047857}
    .ico-violet{background:#ede9fe;color:#6d28d9}
</style>

<section class="dash-bg py-6 px-5">
    <div class="max-w-[1700px] mx-auto">

        <!-- Hero -->
        <div class="dash-hero mb-5">
            <div class="dash-hero-inner">
                <div class="flex items-start justify-between flex-wrap gap-4">
                    <div>
                        <p class="text-sm opacity-80 mb-1">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
                        <h1 class="text-3xl font-extrabold tracking-tight">@greeting, @userName.</h1>
                        <p class="text-sm opacity-90 mt-2 max-w-xl">Here's a snapshot of your AML compliance posture today. @(summary?.Open ?? pending) cases need attention; @(summary?.SlaBreach ?? 0) are breaching SLA.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <a href="@Url.Action("Index","AmlTracker")" class="px-4 py-2 bg-white text-indigo-700 hover:bg-indigo-50 text-sm font-semibold rounded-lg shadow">
                            <i class="fas fa-table mr-1"></i> Open AML Tracker
                        </a>
                        <a href="@Url.Action("Reports","AmlTracker")" class="px-4 py-2 bg-white/15 hover:bg-white/25 text-white text-sm font-semibold rounded-lg backdrop-blur border border-white/20">
                            <i class="fas fa-chart-bar mr-1"></i> Reports
                        </a>
                        <a href="@Url.Action("Workspace","AmlTracker")" class="px-4 py-2 bg-white/15 hover:bg-white/25 text-white text-sm font-semibold rounded-lg backdrop-blur border border-white/20">
                            <i class="fas fa-clipboard-check mr-1"></i> QA Workspace
                        </a>
                    </div>
                </div>

                @if (summary != null)
                {
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                        <a href="@Url.Action("Index","AmlTracker")" class="glass-card p-4">
                            <div class="text-[10px] uppercase tracking-wide text-slate-600 font-bold">Total Cases</div>
                            <div class="text-3xl font-extrabold text-slate-900 mt-1">@summary.Total</div>
                        </a>
                        <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 0 })" class="glass-card p-4">
                            <div class="text-[10px] uppercase tracking-wide text-slate-600 font-bold">Open</div>
                            <div class="text-3xl font-extrabold text-blue-700 mt-1">@summary.Open</div>
                        </a>
                        <a href="@Url.Action("Index","AmlTracker", new { RiskLevel = "High Risk" })" class="glass-card p-4">
                            <div class="text-[10px] uppercase tracking-wide text-slate-600 font-bold">High Risk</div>
                            <div class="text-3xl font-extrabold text-rose-600 mt-1">@summary.HighRisk</div>
                        </a>
                        <a href="@Url.Action("SlaBreachTrend","AmlTracker")" class="glass-card p-4">
                            <div class="text-[10px] uppercase tracking-wide text-slate-600 font-bold">SLA Breach</div>
                            <div class="text-3xl font-extrabold text-rose-600 mt-1">@summary.SlaBreach</div>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- KPI strip -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-5">
            <a href="@Url.Action("Index","AmlTracker")" class="kpi-card">
                <div class="kpi-icon ico-blue"><i class="fas fa-folder-open"></i></div>
                <div class="kpi-num">@totalCases</div>
                <div class="kpi-label">Total Cases</div>
                <div class="kpi-sub">@individuals individual · @corporates corporate</div>
            </a>
            <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 0 })" class="kpi-card">
                <div class="kpi-icon ico-amber"><i class="fas fa-hourglass-half"></i></div>
                <div class="kpi-num">@pending</div>
                <div class="kpi-label">Pending Review</div>
                <div class="kpi-sub">@(summary?.PendingSrMgmt ?? 0) awaiting Sr Mgmt</div>
            </a>
            <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 2 })" class="kpi-card">
                <div class="kpi-icon ico-emerald"><i class="fas fa-check-circle"></i></div>
                <div class="kpi-num">@approved</div>
                <div class="kpi-label">Approved</div>
                <div class="kpi-sub">@autoApproved auto · @manualApproved manual</div>
            </a>
            <a href="@Url.Action("HighRiskRegister","AmlTracker")" class="kpi-card">
                <div class="kpi-icon ico-rose"><i class="fas fa-shield-alt"></i></div>
                <div class="kpi-num">@totalHigh</div>
                <div class="kpi-label">High Risk</div>
                <div class="kpi-sub">@totalMedium medium · @totalLow low</div>
            </a>
            <a href="@Url.Action("Index","AmlTracker", new { QaStatus = 1 })" class="kpi-card">
                <div class="kpi-icon ico-violet"><i class="fas fa-clipboard-list"></i></div>
                <div class="kpi-num">@(summary?.QaPending ?? 0)</div>
                <div class="kpi-label">QA Pending</div>
                <div class="kpi-sub">@(summary?.QaApproved ?? 0) approved · @(summary?.QaRejected ?? 0) rejected</div>
                <div class="pulse"></div>
            </a>
        </div>

        <!-- Quick actions -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
            <a href="@Url.Action("Index","AmlTracker")?Search=&CaseStatus=4" class="quick-action">
                <div class="qa-icon grad-amber"><i class="fas fa-user-shield"></i></div>
                <div class="qa-text">
                    <div class="qa-title">Sr Mgmt Queue</div>
                    <div class="qa-sub">@(summary?.PendingSrMgmt ?? 0) cases awaiting</div>
                </div>
            </a>
            <a href="@Url.Action("Workspace","AmlTracker")" class="quick-action">
                <div class="qa-icon grad-violet"><i class="fas fa-clipboard-check"></i></div>
                <div class="qa-text">
                    <div class="qa-title">QA Workspace</div>
                    <div class="qa-sub">@(summary?.QaEligibleAwaiting ?? 0) closed-awaiting-QA</div>
                </div>
            </a>
            <a href="@Url.Action("HighRiskRegister","AmlTracker")" class="quick-action">
                <div class="qa-icon grad-rose"><i class="fas fa-fire"></i></div>
                <div class="qa-text">
                    <div class="qa-title">High Risk Register</div>
                    <div class="qa-sub">@totalHigh customers flagged</div>
                </div>
            </a>
            <a href="@Url.Action("DailyDigest","AmlTracker")" class="quick-action">
                <div class="qa-icon grad-blue"><i class="fas fa-calendar-day"></i></div>
                <div class="qa-text">
                    <div class="qa-title">Daily Digest</div>
                    <div class="qa-sub">today's snapshot</div>
                </div>
            </a>
        </div>

        <!-- Visualizations row -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">

            <div class="panel">
                <div class="panel-title">
                    <span><i class="fas fa-circle-notch text-indigo-500 mr-2"></i>Risk Distribution</span>
                    <a href="@Url.Action("CustomerDemographics","AmlTracker")" class="panel-title-link">Details →</a>
                </div>
                <a href="@Url.Action("CustomerDemographics","AmlTracker")" class="donut-wrap block" style="text-decoration:none">
                    <svg viewBox="0 0 200 200" class="w-full h-full -rotate-90">
                        <circle cx="100" cy="100" r="80" fill="none" stroke="#f1f5f9" stroke-width="22"></circle>
                        @{
                            double offset = 0;
                        }
                        <circle cx="100" cy="100" r="80" fill="none" stroke="#ef4444" stroke-width="22"
                                stroke-dasharray="@DashHigh.ToString("0.0") @Circumference.ToString("0.0")"
                                stroke-dashoffset="@offset.ToString("0.0")"></circle>
                        @{ offset -= DashHigh; }
                        <circle cx="100" cy="100" r="80" fill="none" stroke="#f59e0b" stroke-width="22"
                                stroke-dasharray="@DashMed.ToString("0.0") @Circumference.ToString("0.0")"
                                stroke-dashoffset="@offset.ToString("0.0")"></circle>
                        @{ offset -= DashMed; }
                        <circle cx="100" cy="100" r="80" fill="none" stroke="#10b981" stroke-width="22"
                                stroke-dasharray="@DashLow.ToString("0.0") @Circumference.ToString("0.0")"
                                stroke-dashoffset="@offset.ToString("0.0")"></circle>
                        @{ offset -= DashLow; }
                        <circle cx="100" cy="100" r="80" fill="none" stroke="#cbd5e1" stroke-width="22"
                                stroke-dasharray="@DashUnc.ToString("0.0") @Circumference.ToString("0.0")"
                                stroke-dashoffset="@offset.ToString("0.0")"></circle>
                    </svg>
                    <div class="donut-center">
                        <div class="donut-num">@(totalHigh + totalMedium + totalLow + unclassified)</div>
                        <div class="donut-lbl">Customers</div>
                    </div>
                </a>
                <div class="legend">
                    <a href="@Url.Action("Index","AmlTracker", new { RiskLevel = "High Risk" })" class="legend-row"><span class="legend-dot" style="background:#ef4444"></span><span>High Risk</span><span class="legend-num">@totalHigh</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { RiskLevel = "Medium Risk" })" class="legend-row"><span class="legend-dot" style="background:#f59e0b"></span><span>Medium Risk</span><span class="legend-num">@totalMedium</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { RiskLevel = "Low Risk" })" class="legend-row"><span class="legend-dot" style="background:#10b981"></span><span>Low Risk</span><span class="legend-num">@totalLow</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { RiskLevel = "Unclassified" })" class="legend-row"><span class="legend-dot" style="background:#cbd5e1"></span><span>Unclassified</span><span class="legend-num">@unclassified</span></a>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">
                    <span><i class="fas fa-chart-bar text-indigo-500 mr-2"></i>Case Status Mix</span>
                    <a href="@Url.Action("Index","AmlTracker")" class="panel-title-link">View tracker →</a>
                </div>
                <div class="stack-bar">
                    @if (sApproved > 0) { <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 2 })" class="stack-seg" style="width:@(sApproved.ToString("0.0"))%;background:#10b981" title="Approved (@(manualApproved + autoApproved))">@(sApproved >= 8 ? $"{sApproved:0}%" : "")</a> }
                    @if (sPending > 0) { <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 0 })" class="stack-seg" style="width:@(sPending.ToString("0.0"))%;background:#f59e0b" title="Pending (@pending)">@(sPending >= 8 ? $"{sPending:0}%" : "")</a> }
                    @if (sRejected > 0) { <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 3 })" class="stack-seg" style="width:@(sRejected.ToString("0.0"))%;background:#ef4444" title="Rejected (@rejected)">@(sRejected >= 8 ? $"{sRejected:0}%" : "")</a> }
                </div>
                <div class="legend">
                    <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 2 })" class="legend-row"><span class="legend-dot" style="background:#10b981"></span><span>Approved (auto + manual)</span><span class="legend-num">@(manualApproved + autoApproved)</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 0 })" class="legend-row"><span class="legend-dot" style="background:#f59e0b"></span><span>Pending</span><span class="legend-num">@pending</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { CaseStatus = 3 })" class="legend-row"><span class="legend-dot" style="background:#ef4444"></span><span>Rejected</span><span class="legend-num">@rejected</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { QaStatus = 2 })" class="legend-row mt-2 pt-2 border-t border-slate-100"><span class="legend-dot" style="background:#6366f1"></span><span class="font-semibold text-indigo-700">QA Approved</span><span class="legend-num">@(summary?.QaApproved ?? 0)</span></a>
                    <a href="@Url.Action("Index","AmlTracker", new { QaStatus = 3 })" class="legend-row"><span class="legend-dot" style="background:#a855f7"></span><span class="font-semibold text-violet-700">QA Rejected</span><span class="legend-num">@(summary?.QaRejected ?? 0)</span></a>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">
                    <span><i class="fas fa-bell text-rose-500 mr-2"></i>Live Alerts</span>
                    <span class="text-xs text-slate-400">auto-refresh</span>
                </div>
                <div class="space-y-2.5">
                    @if ((summary?.SlaBreach ?? 0) > 0)
                    {
                        <a href="@Url.Action("Index","AmlTracker")" class="alert-card alert-rose block">
                            <i class="fas fa-bolt"></i>
                            <div class="flex-1">
                                <div class="font-semibold text-sm">@summary.SlaBreach SLA breach@(summary.SlaBreach == 1 ? "" : "es")</div>
                                <div class="text-xs opacity-80">cases past at-risk threshold</div>
                            </div>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    }
                    @if ((summary?.PendingSrMgmt ?? 0) > 0)
                    {
                        <a href="@Url.Action("Index","AmlTracker")?CaseStatus=4" class="alert-card alert-amber block">
                            <i class="fas fa-user-shield"></i>
                            <div class="flex-1">
                                <div class="font-semibold text-sm">@summary.PendingSrMgmt awaiting Sr Mgmt</div>
                                <div class="text-xs opacity-80">decision needed</div>
                            </div>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    }
                    @if ((summary?.QaSlaBreach ?? 0) > 0)
                    {
                        <a href="@Url.Action("Workspace","AmlTracker")" class="alert-card alert-rose block">
                            <i class="fas fa-clipboard-check"></i>
                            <div class="flex-1">
                                <div class="font-semibold text-sm">@summary.QaSlaBreach QA SLA breach@(summary.QaSlaBreach == 1 ? "" : "es")</div>
                                <div class="text-xs opacity-80">closed cases without QA review</div>
                            </div>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    }
                    @if ((summary?.QaEligibleAwaiting ?? 0) > 0)
                    {
                        <a href="@Url.Action("Workspace","AmlTracker")" class="alert-card alert-blue block">
                            <i class="fas fa-clock"></i>
                            <div class="flex-1">
                                <div class="font-semibold text-sm">@summary.QaEligibleAwaiting awaiting QA</div>
                                <div class="text-xs opacity-80">closed cases need review</div>
                            </div>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    }
                    @if ((summary?.SlaBreach ?? 0) == 0 && (summary?.PendingSrMgmt ?? 0) == 0 && (summary?.QaSlaBreach ?? 0) == 0 && (summary?.QaEligibleAwaiting ?? 0) == 0)
                    {
                        <div class="alert-card" style="background:#f0fdf4;border-color:#bbf7d0;color:#166534">
                            <i class="fas fa-check-circle"></i>
                            <div class="flex-1">
                                <div class="font-semibold text-sm">All clear</div>
                                <div class="text-xs opacity-80">no active alerts at this time</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent activity + High risk + Today summary -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

            <div class="panel lg:col-span-2">
                <div class="panel-title">
                    <span><i class="fas fa-stream text-indigo-500 mr-2"></i>Recent Cases</span>
                    <a href="@Url.Action("Index","AmlTracker")" class="panel-title-link">Open Tracker →</a>
                </div>
                @if (recentCases.Any())
                {
                    foreach (var r in recentCases)
                    {
                        var initials = string.IsNullOrWhiteSpace(r.CustomerName) ? "?" :
                            string.Concat(r.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
                        var avCls = (r.RiskTier ?? "").ToLowerInvariant() switch
                        {
                            "high" => "grad-rose",
                            "medium" => "grad-amber",
                            "low" => "grad-emerald",
                            _ => "grad-slate"
                        };
                        var pillCls = (r.RiskTier ?? "").ToLowerInvariant() switch
                        {
                            "high" => "pill-high",
                            "medium" => "pill-med",
                            "low" => "pill-low",
                            _ => "pill-unc"
                        };
                        <a href="@Url.Action("Customer360","AmlTracker", new { cmid = r.CustomerMasterId })" class="case-row">
                            <div class="case-avatar @avCls">@initials</div>
                            <div class="flex-1 min-w-0">
                                <div class="font-semibold text-slate-800 truncate">@(string.IsNullOrWhiteSpace(r.CustomerName) ? "—" : r.CustomerName)</div>
                                <div class="text-xs text-slate-500 flex items-center gap-2">
                                    <span>@r.CustomerType</span>
                                    <span>·</span>
                                    <span>Case #@r.CaseId</span>
                                    <span>·</span>
                                    <span>@(r.CreatedOn?.ToString("MMM d, HH:mm") ?? "—")</span>
                                </div>
                            </div>
                            <span class="pill @pillCls">@r.RiskTier</span>
                            <span class="text-xs text-slate-500 hidden md:inline">@r.StatusLabel</span>
                        </a>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-slate-400 text-sm italic">No recent cases.</div>
                }
            </div>

            <div class="panel">
                <div class="panel-title">
                    <span><i class="fas fa-fire text-rose-500 mr-2"></i>High-Risk Watch</span>
                    <a href="@Url.Action("HighRiskRegister","AmlTracker")" class="panel-title-link">Register →</a>
                </div>
                @if (highRiskOpen.Any())
                {
                    foreach (var r in highRiskOpen)
                    {
                        <a href="@Url.Action("Customer360","AmlTracker", new { cmid = r.CustomerMasterId })" class="case-row">
                            <div class="case-avatar grad-rose">!</div>
                            <div class="flex-1 min-w-0">
                                <div class="font-semibold text-slate-800 truncate text-sm">@(string.IsNullOrWhiteSpace(r.CustomerName) ? "—" : r.CustomerName)</div>
                                <div class="text-xs text-slate-500">@(r.AgingDays?.ToString() ?? "—")d open · @r.StatusLabel</div>
                            </div>
                            <i class="fas fa-arrow-right text-slate-400 text-xs"></i>
                        </a>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-emerald-600 text-sm">
                        <i class="fas fa-shield-alt text-xl block mb-1"></i>
                        No high-risk cases open
                    </div>
                }

                @if (slaBreaches.Any())
                {
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <div class="text-xs uppercase font-bold text-rose-700 tracking-wide mb-2">SLA Breaching</div>
                        @foreach (var r in slaBreaches)
                        {
                            <a href="@Url.Action("Customer360","AmlTracker", new { cmid = r.CustomerMasterId })" class="case-row">
                                <div class="case-avatar grad-amber"><i class="fas fa-clock text-xs"></i></div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-semibold text-slate-800 truncate text-sm">@r.CustomerName</div>
                                    <div class="text-xs text-rose-600">@(r.AgingDays?.ToString() ?? "—")d · breach</div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <p class="text-center text-xs text-slate-400 mt-6">
            Data refreshes when you reload. Tracker auto-refresh runs every 60s when you're on the AML Tracker page.
        </p>
    </div>
</section>
