</div>

<!-- Reminder Modal -->
<div id="reminderModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 hidden" style="backdrop-filter: blur(4px);">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 mx-4 transform transition-all">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-slate-800">Create Reminder</h3>
            <button onclick="closeReminderModal()" class="p-1 rounded-lg hover:bg-slate-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Title</label>
                <input id="reminderTitle" type="text" placeholder="e.g. KYC Refresh for NAT468" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Date</label>
                <input id="reminderDate" type="date" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Priority</label>
                <select id="reminderPriority" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all">
                    <option value="low">Low</option>
                    <option value="medium" selected>Medium</option>
                    <option value="high">High</option>
                </select>
            </div>
            <button onclick="saveReminder()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">
                Save Reminder
            </button>
        </div>
    </div>
</div>

<script>
// ── Chart.js: Customer Count Donut ──
(function() {
    var ctx1 = document.getElementById('customerDonut');
    if (ctx1) {
        new Chart(ctx1, {
            type: 'doughnut',
            data: {
                labels: ['Individuals', 'Corporates'],
                datasets: [{
                    data: [@individuals, @corporates],
                    backgroundColor: ['#2563eb', '#38bdf8'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '65%',
                responsive: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleFont: { family: 'Geist' },
                        bodyFont: { family: 'Geist' },
                        cornerRadius: 8,
                        padding: 10
                    }
                }
            }
        });
    }

    // ── Chart.js: Screening Results Donut ──
    var ctx2 = document.getElementById('screeningDonut');
    if (ctx2) {
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['Auto Approved', 'Manually Approved', 'Potential Match'],
                datasets: [{
                    data: [@autoApproved, @manuallyApproved, @potentialMatch],
                    backgroundColor: ['#38bdf8', '#2563eb', '#8b5cf6'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '60%',
                responsive: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleFont: { family: 'Inter' },
                        bodyFont: { family: 'Inter' },
                        cornerRadius: 8,
                        padding: 10
                    }
                }
            }
        });
    }
})();

// ── Calendar Widget with Navigation ──
(function() {
    var container = document.getElementById('calendarWidget');
    if (!container) return;

    var realNow = new Date();
    var realYear = realNow.getFullYear();
    var realMonth = realNow.getMonth();
    var realToday = realNow.getDate();
    var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var dayNames = ['Su','Mo','Tu','We','Th','Fr','Sa'];

    var viewYear = realYear;
    var viewMonth = realMonth;

    window.calPrev = function() { viewMonth--; if (viewMonth < 0) { viewMonth = 11; viewYear--; } renderCal(); };
    window.calNext = function() { viewMonth++; if (viewMonth > 11) { viewMonth = 0; viewYear++; } renderCal(); };

    function renderCal() {
        var firstDay = new Date(viewYear, viewMonth, 1).getDay();
        var daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
        var isCurrentMonth = (viewYear === realYear && viewMonth === realMonth);

        var html = '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">';
        html += '<button onclick="calPrev()" style="border:none;background:none;cursor:pointer;padding:4px 8px;border-radius:6px;color:#64748b;font-size:16px;line-height:1;" onmouseover="this.style.background=\'#f1f5f9\'" onmouseout="this.style.background=\'none\'">‹</button>';
        html += '<span class="text-sm font-semibold text-slate-800">' + monthNames[viewMonth] + ' ' + viewYear + '</span>';
        html += '<button onclick="calNext()" style="border:none;background:none;cursor:pointer;padding:4px 8px;border-radius:6px;color:#64748b;font-size:16px;line-height:1;" onmouseover="this.style.background=\'#f1f5f9\'" onmouseout="this.style.background=\'none\'">›</button>';
        html += '</div>';

        html += '<div class="grid grid-cols-7 gap-1 text-center">';
        dayNames.forEach(function(d) { html += '<div class="text-[10px] font-medium text-slate-400 py-1">' + d + '</div>'; });

        for (var i = 0; i < firstDay; i++) { html += '<div></div>'; }
        for (var d = 1; d <= daysInMonth; d++) {
            var isToday = isCurrentMonth && d === realToday;
            var cls = isToday
                ? 'w-7 h-7 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mx-auto cursor-pointer'
                : 'w-7 h-7 rounded-full hover:bg-slate-100 text-xs text-slate-600 flex items-center justify-center mx-auto cursor-pointer transition-colors';
            html += '<div class="' + cls + '">' + d + '</div>';
        }
        html += '</div>';
        container.innerHTML = html;
    }
    renderCal();
})();

// ── Reminder System (localStorage) ──
function getReminders() {
    try { return JSON.parse(localStorage.getItem('lemon_reminders') || '[]'); } catch(e) { return []; }
}
function renderReminders() {
    var list = document.getElementById('reminderList');
    var reminders = getReminders();
    if (!reminders.length) {
        list.innerHTML = '<div class="text-center py-4 text-slate-400 text-sm">No reminders set. Click "Add Reminder" to create one.</div>';
        return;
    }
    var priorityColors = { high: 'bg-red-100 text-red-700', medium: 'bg-amber-100 text-amber-700', low: 'bg-emerald-100 text-emerald-700' };
    list.innerHTML = reminders.sort(function(a,b) { return new Date(a.date) - new Date(b.date); }).map(function(r, i) {
        return '<div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors">' +
            '<button onclick="deleteReminder(' + i + ')" class="w-5 h-5 rounded-full border-2 border-slate-300 hover:border-red-400 hover:bg-red-50 flex-shrink-0 transition-colors"></button>' +
            '<div class="flex-1 min-w-0"><p class="text-sm font-medium text-slate-700 truncate">' + r.title + '</p></div>' +
            '<span class="px-2 py-0.5 rounded-full text-xs font-medium ' + (priorityColors[r.priority] || priorityColors.medium) + '">' + r.priority + '</span>' +
            '<span class="text-xs text-slate-400 flex-shrink-0">' + r.date + '</span>' +
        '</div>';
    }).join('');
}
function openReminderModal() {
    document.getElementById('reminderModal').classList.remove('hidden');
    document.getElementById('reminderDate').valueAsDate = new Date();
}
function closeReminderModal() {
    document.getElementById('reminderModal').classList.add('hidden');
}
function saveReminder() {
    var title = document.getElementById('reminderTitle').value.trim();
    var date = document.getElementById('reminderDate').value;
    var priority = document.getElementById('reminderPriority').value;
    if (!title || !date) return;
    var reminders = getReminders();
    reminders.push({ title: title, date: date, priority: priority });
    localStorage.setItem('lemon_reminders', JSON.stringify(reminders));
    renderReminders();
    closeReminderModal();
    document.getElementById('reminderTitle').value = '';
}
function deleteReminder(index) {
    var reminders = getReminders();
    reminders.splice(index, 1);
    localStorage.setItem('lemon_reminders', JSON.stringify(reminders));
    renderReminders();
}
renderReminders();
</script>
