            $('#mediumhighTxt').text("2.01-3.00");
            $('#highTxt').text("3.01-4.00");


            if (total >= 3.01 && total <= 4.00) {
                riskStatus = '@localizer["High Risk"]';
                @* $('#btntotalscoretop').removeClass('form-control');
                $('#btntotalscoretop').removeClass('col-12 btn lowrisk_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn mediumrisk_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn mediumhigh_background br-50 riskscore'); 
                $('#btntotalscoretop').addClass('col-12 btn highrisk_background br-50 riskscore');*@
                $('#btntotalscoretop').attr('class', `${baseClasses} bg-red-400
               `)
                $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - High"]');
                @* $('#btnAsPerRiskScore').removeClass();
                $('#btnAsPerRiskScore').removeClass('btn lowrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn mediumrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn mediumhigh_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').addClass('btn highrisk_background  br-50 risk-button riskscore'); *@
                $('#btnAsPerRiskScore').attr('class', `${baseClasses} bg-red-400
               `);
            }
            if (total >=2.01 && total <=3.00) {
                riskStatus = '@localizer["Medium High Risk"]';
                @* $('#btntotalscoretop').removeClass('form-control');
                $('#btntotalscoretop').removeClass('col-12 btn lowrisk_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn mediumrisk_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn highrisk_background br-50 riskscore');
                $('#btntotalscoretop').addClass('col-12 btn mediumhigh_background br-50 riskscore'); *@
                $('#btntotalscoretop').attr('class', `${baseClasses} bg-amber-400
               `);
                $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Medium High Risk"]');
                @* $('#btnAsPerRiskScore').removeClass();
                $('#btnAsPerRiskScore').removeClass('btn lowrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn mediumrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn highrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').addClass('btn mediumhigh_background  br-50 risk-button riskscore'); *@
                $('#btnAsPerRiskScore').attr('class', `${baseClasses} bg-amber-400
               `);
            }
            if (total >=1.01 &&  total <=2.00) {
                riskStatus = '@localizer["Medium Risk"]';
                @* $('#btntotalscoretop').removeClass('form-control');
                $('#btntotalscoretop').removeClass('col-12 btn lowrisk_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn mediumhigh_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn highrisk_background br-50 riskscore');
                $('#btntotalscoretop').addClass('col-12 btn mediumrisk_background br-50 riskscore'); *@
                $('#btntotalscoretop').attr('class', `${baseClasses} bg-yellow-400
               `);
                $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Medium"]');
                @* $('#btnAsPerRiskScore').removeClass('form-control');
                $('#btnAsPerRiskScore').removeClass('btn lowrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn mediumhigh_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn highrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').addClass('btn mediumrisk_background  br-50 risk-button riskscore'); *@
                $('#btnAsPerRiskScore').attr('class', `${baseClasses} bg-yellow-400
               `);
            }
            if (total >= 0 && total <= 1.00 ) {
                riskStatus = '@localizer["Low Risk"]';
                @* $('#btntotalscoretop').removeClass('form-control');
                $('#btntotalscoretop').removeClass('col-12 btn mediumrisk_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn mediumhigh_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn highrisk_background br-50 riskscore');
