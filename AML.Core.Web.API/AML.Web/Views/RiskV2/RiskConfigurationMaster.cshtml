    function renderRiskTypePager(currentPage, totalItems, pageSize) {
        const $pager = $('.risk-type-pagination-controls');
        $pager.empty();

        const totalPages = Math.ceil(totalItems / pageSize);
        if (totalPages <= 1) return;

        const createBtn = (label, p, disabled = false, active = false) =>
            `<button type="button" class="px-3 py-1 border rounded
            ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
            ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
        data-page="${p}" ${disabled ? 'disabled' : ''}>${label}</button>`;

        // First and Prev
        $pager.append(createBtn('First', 1, currentPage === 1));
        $pager.append(createBtn('Prev', currentPage - 1, currentPage === 1));

        // Numbered page buttons (e.g., 3 pages around the current)
        for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
            $pager.append(createBtn(i, i, false, i === currentPage));
        }

        // Next and Last
        $pager.append(createBtn('Next', currentPage + 1, currentPage === totalPages));
        $pager.append(createBtn('Last', totalPages, currentPage === totalPages));
    } *@

