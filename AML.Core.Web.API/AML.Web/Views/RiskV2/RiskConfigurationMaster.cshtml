    function LoadTable(riskTypeID, page = 1) {
        if (!riskTypeID) return;
        currentRiskTypeID = riskTypeID;

        // cancel any in‑flight request
        if (riskItemsAjaxRequest) {
            riskItemsAjaxRequest.abort();
            riskItemsAjaxRequest = null;
        }
        const $tbody = $('#availableRiskItems tbody');
        $tbody.empty();
        const searchValue = $('#riskItemsSearchBox').val().trim() || '';
        const start = (page - 1) * riskItemsPageSize;
        const length = riskItemsPageSize;
        const columns = ["LovRiskData", "LovRiskScore", "OverrideScore"];
        $.ajax({
            url: '/riskV2/custompaginationRiskItems',
            type: 'POST',
            dataType: 'json',
            data: {
                model: {
                    start: start,
                    length: length,
                    search: { value: searchValue },
                    order: [{ column: columns.indexOf(riskItemsSortColumn), dir: riskItemsSortDirection }],
                    columns: columns.map(col => ({ data: col }))
                },
                riskTypeID: riskTypeID
            },
            success: function (response) {
                const rows = response.data || [];
                const total = response.recordsTotal || 0;
                $tbody.empty();
                if (!rows.length) {
                    $tbody.append(`<tr><td colspan="4" class="text-center">No records found</td></tr>`);
                    $('.risk-item-pagination-controls').empty();
                    $('#riskItemsLoading').addClass('hidden');
                    hideLoader();
                    return;
                }

                rows.forEach((item, index) => {
                    let rowHtml = '<tr>';

                    // Column 1: RiskItem input
                    rowHtml += `<td>
                    <input type="text" class = "w-full border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring focus:ring-blue-300 my-2" value="${item.lovRiskData}" name="AvailableItems[${index}].RiskItem" maxlength="500" onkeypress="alphaNumericCheck(event)" />
                    <input type="hidden" value="${item.id}" name="AvailableItems[${index}].Id" />
                </td>`;

                    // Column 2: RiskScore dropdown (0 to 4)
                    let riskScoreOptions = '';
                    for (let i = 0; i <= 4; i++) {
                        riskScoreOptions += `<option value="${i}" ${item.lovRiskScore == i ? 'selected' : ''}>${i}</option>`;
                    }
                    rowHtml += `<td>
                    <select id="AvailableItems[${index}].RiskScore" class = "border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring focus:ring-blue-300 my-2" name="AvailableItems[${index}].RiskScore"
                        onchange="tableRiskScoreOnChange(${index})" style="width:50%">
                        ${riskScoreOptions}
                    </select>
                </td>`;

                    // Column 3: OverrideScore dropdown (0, 3, 4)
                    const isEnabled = item.lovRiskScore == 3 || item.lovRiskScore == 4;
                    let overrideOptions = '';
                    [0, 3, 4].forEach(score => {
                        overrideOptions += `<option value="${score}" ${item.overrideScore == score ? 'selected' : ''}>${score}</option>`;
                    });
                    rowHtml += `<td>
                    <select id="AvailableItems[${index}].OverrideScore" class = "border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring focus:ring-blue-300 my-2" name="AvailableItems[${index}].OverrideScore"
                        style="width:40%" ${isEnabled ? '' : 'disabled'}>
                        ${overrideOptions}
                    </select>
                </td>`;

                    // Column 4: isActive checkbox
                    const isChecked = item.isActive === 'True' || item.isActive === true;
                    rowHtml += `<td>
                    <input type="checkbox" onchange="ChangeStatus(${index}, this);" ${isChecked ? 'checked' : ''} />
                    <input type="hidden" value="${isChecked}" name="AvailableItems[${index}].isActive" />
                </td>`;

                    rowHtml += '</tr>';
                    $tbody.append(rowHtml);
                });
                renderRiskItemsPager(page, total, riskItemsPageSize);
                $('#riskItemsLoading').addClass('hidden');
                hideLoader();
            },
            error: function (err) {
                console.error('Error loading risk items:', err);
                $tbody.append(`<tr><td colspan="4" class="text-center text-red-600">Error loading data</td></tr>`);
                $('#riskItemsLoading').addClass('hidden');
                hideLoader();
            }
        });
    }
    function renderRiskItemsPager(currentPage, totalItems, pageSize) {
        const $pager = $('.risk-items-pagination-controls');
        $pager.empty();

        const totalPages = Math.ceil(totalItems / pageSize);
        if (totalPages <= 1) return;

        const createBtn = (label, pageNum, disabled = false, active = false) =>
            `<button type="button" class="px-3 py-1 border rounded
            ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
            ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
        data-page="${pageNum}" ${disabled ? 'disabled' : ''}>${label}</button>`;

        // First and Prev
        $pager.append(createBtn('First', 1, currentPage === 1));
        $pager.append(createBtn('Prev', currentPage - 1, currentPage === 1));

        // Page number buttons
        for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
            $pager.append(createBtn(i, i, false, i === currentPage));
        }

        // Next and Last
        $pager.append(createBtn('Next', currentPage + 1, currentPage === totalPages));
        $pager.append(createBtn('Last', totalPages, currentPage === totalPages));
    } *@

