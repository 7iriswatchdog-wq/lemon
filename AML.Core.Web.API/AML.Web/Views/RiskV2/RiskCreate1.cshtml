<script type="text/javascript">
    $(function () {

        $('#ddlCustomer').change(function () {
            //$(document).find("select").val('0');
            //$(document).find("button").text('0');

            $("#finalRiskBody").prop("disabled", true)
            $("#riskBody").prop("disabled", true)
    @{
        int ddlCount = 0;

        for (int i = 0; i < Model.RiskTypeCategoryDTO.Count; i++)
        {
            for (var j = 0; j < Model.RiskTypeCategoryDTO[i].RiskTypes.Count; j++)
            {
                ddlCount++;
            }
        }
    }
                const ddlItemCount = @ddlCount;

            for (let i = 0; i <= ddlItemCount; i++) {
                $(`#ddlItem_${i}`).prop("disabled", true)
                $(`#ddlItem_${i}`).val("0").trigger('change')
            }

            var selectedId = $("#ddlCustomer option:selected").val();
            var selectedText = $("#ddlCustomer option:selected").text().split(" - ");
            var coustomerCode = selectedText[0];

            console.log("Show loading screen")
            $('.se-pre-con').css("display", "block");

            $.ajax({
                url: '/RiskV2/GetCustomerDetailById/',
                data: { "id": selectedId },
                type: "POST",
                success: function (data) {
                    console.log("Got data from '/RiskV2/GetCustomerDetailById/'")

                    $('#hfCustomerCode').val(data.customerReferenceId);
                    $('#dtCustomerName').val(((data.firstName != '' && data.firstName != null) ? data.firstName : '') + ' ' + ((data.middleName != '' && data.middleName != null) ? data.middleName : '') + ' ' + ((data.lastName != '' && data.lastName != null) ? data.lastName : ''));
                    $('#mainNationalityTxt').val(((data.nationality != '' && data.nationality != 'null') ? data.nationality : ''));
                    data.dob
                    $('#txtdob').val(((data.dob != '' && data.dob != 'null') ? data.dob : ''));
                    //const d = new Date(data.dateofAssessment);
                    //const formattedDate = d.getFullYear() + '-' + ("0" + (d.getMonth() + 1)).slice(-2) + '-' + ("0" + d.getDate()).slice(-2)
                    //$('#txtDateofAssessment').val(formattedDate);

                    console.log("Send request to '/Risk/GetRiskDetailsByCIdIndividual/'")

                    $.ajax({
                        url: "/RiskV2/GetRiskDetailsByCIdIndividual/",
                        data: { "id": coustomerCode },
                        type: "POST",
                        success: function (data) {
                            console.log("Got response from '/Risk/GetRiskDetailsByCIdIndividual/'")

                            const riskDetails = data

                            for (let i = 0; i <= riskDetails.riskTypeCategoryDTO.length - 1; i++) {
                                for (let j = 0; j <= riskDetails.riskTypeCategoryDTO[i].riskTypes.length - 1; j++) {
                                    if (riskDetails.riskTypeCategoryDTO[i].riskTypes[j].itemTxt == null) { continue }

                                    const option = $(`#risk-item-${i}-${j} select option`)
                                        .filter(function () { return $(this).html() == riskDetails.riskTypeCategoryDTO[i].riskTypes[j].itemTxt; })
                                        .val()

                                    $(`#risk-item-${i}-${j} select`)
                                        .val(`${option}`)
                                        .trigger('change')
                                }
                            }

                            for (let i = 0; i <= ddlItemCount; i++) {
                                $(`#ddlItem_${i}`).prop("disabled", false)
                            }

                            console.log("Hide loading screen")

                            $('.se-pre-con').fadeOut("slow");
                        },
                        error: async function (response) {

                            for (let i = 0; i <= ddlItemCount; i++) {
                                $(`#ddlItem_${i}`).prop("disabled", false)
                            }

                            response.then(val => console.log(val));
                        },
                        failure: function (response) {

                            for (let i = 0; i <= ddlItemCount; i++) {
                                $(`#ddlItem_${i}`).prop("disabled", false)
                            }
                            console.log(response.responseText);
                        }
                    });
                },
                complete: function (data) {
                    for (let i = 0; i <= ddlItemCount; i++) {
                        $(`#ddlItem_${i}`).prop("disabled", false)
                    }
                    console.log(response);
                    console.log(data);
                    wait = false;
                },
                error: function (response) {

                    for (let i = 0; i <= ddlItemCount; i++) {
                        $(`#ddlItem_${i}`).prop("disabled", false)
                    }
                    console.log(response);
                },
                failure: function (response) {

                    for (let i = 0; i <= ddlItemCount; i++) {
                        $(`#ddlItem_${i}`).prop("disabled", false)
                    }
                    console.log(response);
                }
            });
        });
    });

    function ValidateCustomerId(e) {
        var uniquiIdVal = $('#hfCustomerCode').val();
        if (uniquiIdVal != '' && uniquiIdVal != null)
            return true;
        else
            alert('@localizer["Customer Code not Selected!"]');
        event.preventDefault();
        return false;
    }
    $(document).ready(function () {

        $('.js-example-basic-multiple').select2();

    });
</script>
