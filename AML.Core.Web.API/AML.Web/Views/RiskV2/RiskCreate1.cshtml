<script>

    $(document).ready(function () {
        /*$('#risk-item-0-1 select').prop("disabled", true)*/
        $("#ddlCustomer").select2({ dropdownAutoWidth: false });
        $('.risk-button').hide();
    });

    var OverRideVariables = [];
    var b = $('#RiskSubTable tr').length;
    for (i = 0; i <= b; i++) {
        OverRideVariables[i] = false
    }
    var OverRides = "false";
    $('#ddlMainNationality').change(function () {
        $('#mainNationalityTxt').val($("#ddlMainNationality option:selected").text());
    });

    $('#dtCustomerCode').keyup(function () {
        $('#hfCustomerCode').val($("#dtCustomerCode").val());
    });

    function ItemChange(a, data) {
        //if ($('#risk-item-0-0 select').val() !== '2|0|6503' && data === undefined) {


        //    $('#clrScore_' + 1).removeClass('btn btn-success');
        //    $('#clrScore_' + 1).removeClass('btn btn-warning');
        //    $('#clrScore_' + 1).removeClass('btn btn-danger pulse-button');
        //    $('#clrScore_' + 1).addClass('btn btn-block btn-secondary');
        //    $('#clrScore_' + 1).text(0);
        //    $('#clrScorehdn_' + 1).val(0);
        //    OverRideVariables[1] = false;

        //    calculateTotal();
        //} else {
        //    $('#risk-item-0-1 select').prop("disabled", false)
        //}

        if (!$("#ddlItem_" + a + " option:selected").val()) {
            return
        }
        var score = $("#ddlItem_" + a + " option:selected").val()?.split("|");
        var selectedVal = score[0];
        var overrideScore = score[1];
        var selectedItemId = score[2];
        $('#RiskItemTxt_' + a).val($("#ddlItem_" + a + " option:selected").text());
        $('#RiskItem_' + a).val(selectedVal);
        $('#RiskItemId_' + a).val(selectedItemId);
        if (selectedVal == 1) {
            $('#clrScore_' + a).removeClass('btn btn-warning');
            $('#clrScore_' + a).removeClass('btn btn-danger pulse-button');
            $('#clrScore_' + a).addClass('btn btn-success');
            $('#clrScore_' + a).text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);
            OverRideVariables[a] = false;
        }
        else if (selectedVal == 2) {

            $('#clrScore_' + a).removeClass('btn btn-success');
            $('#clrScore_' + a).removeClass('btn btn-danger pulse-button');
            $('#clrScore_' + a).addClass('btn btn-warning');
            $('#clrScore_' + a).text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);
            OverRideVariables[a] = false;
        }
        else if (selectedVal == 3) {
            $('#clrScore_' + a).removeClass('btn btn-success');
            $('#clrScore_' + a).removeClass('btn btn-warning');
            $('#clrScore_' + a).text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);
            $('#clrScore_' + a).addClass('btn btn-danger');
            if (overrideScore == 3) {
                $('#clrScore_' + a).addClass('pulse-button');
                OverRideVariables[a] = true;
            } else {
                $('#clrScore_' + a).removeClass('pulse-button');
                OverRideVariables[a] = false;
            }
        }
        else if (selectedVal == 0) {
            $('#clrScore_' + a).removeClass('btn btn-success');
            $('#clrScore_' + a).removeClass('btn btn-warning');
            $('#clrScore_' + a).removeClass('btn btn-danger pulse-button');
            $('#clrScore_' + a).addClass('btn btn-block btn-secondary');
            $('#clrScore_' + a).text(0);
            $('#clrScorehdn_' + a).val(0);
            OverRideVariables[a] = false;
        }
        else {
            OverRideVariables[a] = false;
        }
        calculateTotal();
    }
    function calculateTotal() {
        var total = 0;
        var i = 0;
        var riskStatus = '@localizer["Low Risk"]';



        $(".riskscorehdn").each(function () {
            //alert($(this).val());
            total = parseInt(total) + parseInt($(this).val());
            if ($(this).val() != 0) {
                i++;
            }
        });
        $('#btntotalscore').text(total);
        $('#btntotal').text(i);

        $('#btnAsPerRiskScore').show();

        var highscoreVal = (i * 3);
        var mediumScoreVal = (i * 2.24);
        var lowScoreVal = (i * 1.49);

        $('#lowTxt').text(lowScoreVal.toFixed(2));
        $('#mediumTxt').text(mediumScoreVal.toFixed(2));
        $('#highTxt').text(highscoreVal.toFixed(2));

        if (total <= highscoreVal) {
            riskStatus = '@localizer["High Risk"]';
            $('#btntotalscoretop').removeClass();
            $('#btntotalscoretop').addClass('btn btn-danger form-control br-50');
            $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - High"]');
            $('#btnAsPerRiskScore').removeClass();
            $('#btnAsPerRiskScore').addClass('btn btn-danger form-control br-50 risk-button');
        }
        if (total <= mediumScoreVal) {
            riskStatus = '@localizer["Medium Risk"]';
            $('#btntotalscoretop').removeClass();
            $('#btntotalscoretop').addClass('btn btn-warning form-control br-50');
            $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Medium"]');
            $('#btnAsPerRiskScore').removeClass();
            $('#btnAsPerRiskScore').addClass('btn btn-warning form-control br-50 risk-button');
        }
        if (total <= lowScoreVal) {
            riskStatus = '@localizer["Low Risk"]';
            $('#btntotalscoretop').removeClass();
            $('#btntotalscoretop').addClass('btn btn-info form-control br-50');
            $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Low"]');
            $('#btnAsPerRiskScore').removeClass();
            $('#btnAsPerRiskScore').addClass('btn btn-info form-control br-50 risk-button');
        }



        //Set Risk score witout override
        $('#riskScoreBeforeOverrideTxt').val(riskStatus);

        var OverRides = "false";

        for (x = 0; x <= b; x++) {

            OverRides = OverRides + "||" + OverRideVariables[x];
            if (OverRides.includes("true")) {
                riskStatus = '@localizer["High Risk"]';
                $('#btntotalscoretop').removeClass();
                $('#btntotalscoretop').addClass('btn btn-danger form-control br-50');
            }
        }
        //Set final risk score
        $('#finalRiskScoreTxt').val(riskStatus);

        $('#btntotalscoretop').text(riskStatus);

        $('#riskScoreSumTxt').val(total);
        $('#riskScoreCountTxt').val(i);




    }

    function fnSubmit() {
        $(".se-pre-con").show();
    }
    function myFunction() {

        var checkBox = document.getElementById("checked");

        var agree = confirm("Are you sure you wish to continue?");

        if (checkBox.checked == true) {

            if (agree) {
                document.getElementById("hiddenvalue").value = 1;
                return true;
            }
            else {
                return false;
            }
        }
    }

    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    })
</script>