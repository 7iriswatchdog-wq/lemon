
@{
    ViewData["Title"] = "Individual Assessment";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="~/plugins/jquery/jquery.min.js"></script>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <h3 class="card-title">RISK ASSESSMENT FOR INDIVIDUALS</h3>
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">List</h3>
                        <a href="@Url.Action("Create", "risk")" type="button" class="btn btn-info btn-sm float-right">Create</a>
                    </div>
                    <div class="card-body">
                        <div style="width: 100%; padding-left: -10px;">
                            <div class="table-responsive">
                                <table id="example" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Action</th>
                                            <th>Customer Id</th>
                                            <th>Customer Name</th>
                                            <th>Created By</th>
                                            <th>Created On</th>
                                            @*<th>Is Matched</th>*@
                                            <th>Match Score</th>
                                            <th>Risk Score</th>
                                            @*<th>Nationality</th>
                                        <th>DOB</th>
                                        <th>Source</th>
                                        <th>Source Unique Id</th>
                                        <th>Risk Score</th>*@
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>






<script type="text/javascript">

    var table;
    $(document).ready(function () {
        table = $('#example').DataTable({
            "serverSide": true, "processing": true,
            ajax: {
                url: '/case/custompagination',
                type: 'POST'
            },
            columns: [
                {
                    "render": function (data, type, full, meta) { return '<a class="btn btn-info" href="/case/process/' + full.id + '">Process</a>'; }
                },
                { data: "customerId" },
                {
                    "data": null,
                    "render": function (data, type, full) {
                        return full['firstName'] + ' ' + full['middleName']+ ' ' + full['lastName'];
                    }
                },
                //{ data: "nationality" },
                //{
                //    data: "dob",
                //    "render": function (data) {
                //        return formatDate(data);
                //    }
                //},
                //{ data: "source" },
                //{ data: "sourceUniqueId" },
                
                { data: "createdUser" },
                { data: "createdOnDB" },
                //{
                //    data: "isMatched",
                //    "render": function (data) {
                //        return (data == "1") ? "True" : "False";
                //    }
                //},
                { data: "matchScore" },
                { data: "riskScore" }
            ]
        });
    });
</script>