@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Risk Summary";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

@model AML.ViewModel.ViewModels.Risk.RiskRequestModel
<script src="~/plugins/jquery/jquery.min.js"></script>

<div class="w-full h-full">
    <!-- Header -->
    <nav class="flex items-center px-6 h-[72.8px] border-b border-gray-200 w-full bg-white">
        <div class="flex items-center justify-between w-full">
            <h2 class="text-xl font-bold text-gray-900 tracking-tight whitespace-nowrap overflow-hidden text-ellipsis">
                Risk Summary
            </h2>
            <div class="text-right flex items-center space-x-4">
                <img src="@Clientlogo" alt="Client Logo" class="h-8 w-auto object-contain" />
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="p-6 bg-gray-50 min-h-[calc(100vh-72.8px)]">
        
        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Risk Summary Filter</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <!-- Date Filter -->
                <div class="flex flex-col">
                    <label for="dtOnDate" class="text-[13px] font-medium text-[#374151] mb-1">Date</label>
                    <input type="date" asp-for="OnDate" id="dtOnDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full h-[48px] px-[12px] bg-[#FFFFFF] border border-[#D1D5DB] rounded-[8px] focus:outline-none focus:border-[#2563EB] focus:ring-[3px] focus:ring-[#2563EB]/12 transition-shadow text-gray-900" />
                    <span asp-validation-for="OnDate" class="text-[12px] text-[#DC2626] mt-1"></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-end mt-6 space-x-3 pt-6 border-t border-gray-200">
                <button type="button" id="btnReset" class="px-6 py-[10px] bg-white border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-200">
                    Clear All
                </button>
                <button type="button" id="btnSearch" onclick="LoadTable();" class="px-6 py-[10px] bg-[#2563EB] border border-transparent text-white font-medium rounded-lg hover:bg-[#1D4ED8] transition-colors focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2">
                    Search
                </button>
            </div>
        </div>

        <!-- Search Results -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-6 border-b border-gray-200 flex justify-between items-center">
                <h3 class="text-lg font-semibold text-gray-900">Search Results</h3>
                <button type="button" onclick="ExportList();" class="flex items-center space-x-2 px-4 py-2 bg-green-50 text-green-700 font-medium rounded-lg hover:bg-green-100 border border-green-200 transition-colors text-sm">
                    <span>Export to Excel</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                </button>
            </div>
            
            <div class="p-0">
                <div class="table-responsive w-full">
                    <table id="riskSummaryTbl" class="w-full text-sm text-left whitespace-nowrap" cellspacing="0">
                        <thead class="text-xs font-semibold text-gray-500 uppercase tracking-wider bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 text-left">Risk Type</th>
                                <th class="px-6 py-4 text-right">Count of High Risk</th>
                                <th class="px-6 py-4 text-right">Count of Medium Risk</th>
                                <th class="px-6 py-4 text-right">Count of Low Risk</th>
                                <th class="px-6 py-4 text-right">Total Risks</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white tabular-nums">
                            <!-- DataTables will populate this -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var table;
    $(document).ready(function () {
        LoadTable();
    });

    function LoadTable() {
        var onDate = $('#dtOnDate').val();
        table = $('#riskSummaryTbl').DataTable({
            "processing": true,
            "serverSide": true,
            "filter": true,
            "orderMulti": false,
            "order": [[2, 'desc']],
            "iDisplayLength": 25,
            "destroy": true,
            "dom": '<"flex flex-col md:flex-row justify-between items-center p-4 border-b border-gray-200"<"text-sm text-gray-600"l><"flex items-center space-x-2"f>>rt<"flex flex-col md:flex-row justify-between items-center p-4 bg-gray-50 border-t border-gray-200"<"text-sm text-gray-600"i><"text-sm"p>>',
            "language": {
                "search": "",
                "searchPlaceholder": "Search records...",
                "lengthMenu": "Show _MENU_ entries"
            },
            "ajax": {
                "url": "/Risk/RiskSummaryCustomPagination",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "OnDate": onDate
                }
            },
            "columns": [
                {
                    "data": "riskType", "name": "Risk Type", "autoWidth": true,
                    "className": "px-6 py-4 font-medium text-gray-900",
                    "render": function (data, type, row) {
                        return row.riskType;
                    }
                },
                {
                    "data": "highRiskCount", "name": "High Risk Count", "autoWidth": true,
                    "className": "px-6 py-4 text-right",
                    "render": function (data, type, row) {
                        return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">' + row.highRiskCount + '</span>';
                    }
                },
                {
                    "data": "mediumRiskCount", "name": "Medium Risk Count", "autoWidth": true,
                    "className": "px-6 py-4 text-right",
                    "render": function (data, type, row) {
                        return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">' + row.mediumRiskCount + '</span>';
                    }
                },
                {
                    "data": "lowRiskCount", "name": "Low Risk Count", "autoWidth": true,
                    "className": "px-6 py-4 text-right",
                    "render": function (data, type, row) {
                        return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">' + row.lowRiskCount + '</span>';
                    }
                },
                {
                    "data": "Total", "name": "Total", "autoWidth": true,
                    "className": "px-6 py-4 text-right font-semibold text-gray-900",
                    "render": function (data, type, row) {
                        return parseInt(row.highRiskCount) + parseInt(row.mediumRiskCount) + parseInt(row.lowRiskCount);
                    }
                }
            ],
            "drawCallback": function(settings) {
                $('.dataTables_filter input').addClass('h-9 px-3 py-1 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:border-transparent transition-shadow w-64');
                $('.dataTables_length select').addClass('h-9 px-3 py-1 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:border-transparent transition-shadow');
                $('.paginate_button').addClass('px-3 py-1 border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 rounded-md mx-1 transition-colors');
                $('.paginate_button.current').removeClass('bg-white text-gray-700 hover:bg-gray-50').addClass('bg-[#2563EB] text-white hover:bg-[#1D4ED8] border-transparent');
                $('.paginate_button.disabled').addClass('opacity-50 cursor-not-allowed hover:bg-white');
            }
        });
    }

    function ExportList() {
        $.ajax({
            type: "GET",
            url: "/Risk/ExportRiskSummary/",
            data: {
                OnDate: $('#dtOnDate').val()
            },
            success: function (data) {
                window.location = '/Risk/ExportRiskSummary?OnDate=' + $('#dtOnDate').val();
            },
            error: function (result) {
                alert('Export failed.');
            }
        });
    }

    $("#btnReset").click(function () {
        var date = new Date();
        var day = date.getDate();
        var month = date.getMonth() + 1;
        var year = date.getFullYear();
        if (month < 10) month = "0" + month;
        if (day < 10) day = "0" + day;
        var today = year + "-" + month + "-" + day;
        $('#dtOnDate').val(today);
        LoadTable();
    });
</script>
