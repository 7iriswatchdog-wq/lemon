@{
    ViewData["Title"] = "Risk Summary";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.Risk.RiskRequestModel
<script src="~/plugins/jquery/jquery.min.js"></script>
<style>
select {
    appearance: none !important;
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.41 0L6 4.59L10.59 0L12 1.42L6 7.42L0 1.42L1.41 0Z' fill='white'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-position-x: calc(100% - 20px) !important;
    background-position-y: 50% !important;
}
select option {
    background-color: #1a2038;
}
</style>
<div class="custom-container aml-risk-summary">
    <div class="sas-breadcrumbs aml-breadcrumbs pb-3">
        <ul class="mb-0 pl-0 d-flex">
            <li><a href="#">Home</a></li>/
            <li><a href="#">Reports</a></li>/
            <li><a href="#">Risk Summary</a></li>
        </ul>
    </div>
    <div class="page-heading">
        <div class="sas-card rounded-card br-20 mb-2 bg-blue">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><b>Risk Summary</b></h4>
                <div class="menu-icon">
                    <i class="lni lni-microsoft"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- /.card-header -->
    <!-- form start -->
    <!--form role="form" asp-controller="Case" asp-action="SanctionScreening" class="form-horizontal" enctype="multipart/form-data" method="post"-->
    <div class="sas-card rounded-card mb-2 bg-blue">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Risk Summary Filter</h6>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="dtOnDate">Date</label>
                    <input type="date" asp-for="OnDate" class="form-control br-50" id="dtOnDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder="Filter Date">
                    <span asp-validation-for="OnDate" class="text-danger"></span>
                </div>
            </div>
        </div>
    
    <!-- /.card-body -->

    <div class="row justify-content-end">
        <button type="submit" id="btnSearch" class="sas-button p-8-25 bg-color-2" onclick="LoadTable();">Search</button>
        <button type="reset" id="btnReset" class="sas-button p-8-25 color-white bg-color-3 ml-3">Clear All</button>
    </div>
    </div>
    <!--/form-->

    <div class="sas-card rounded-card mb-2 bg-blue">
        <div class="d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Search Results</h6>
    </div>
    <hr />
    <div class="card-body table-responsive p-2">
            <button type="button" onclick="ExportList();" class="sas-button p-8-25 bg-color-1">Export to Excel <i class="fas fa-file-excel-o ml-2"></i></button>
            <hr />
        <table id="riskSummaryTbl" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
            <thead>
                <tr>
                    <th style="text-align: left;">Risk Type</th>
                    <th style="text-align: left;">Count of High Risk</th>
                    <th style="text-align: left;">Count of Medium Risk</th>
                    <th style="text-align: left;">Count of Low Risk</th>
                    <th style="text-align: left;">Total Risks</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
</div>
<script type="text/javascript">
    var table;
    $(document).ready(function () {
        LoadTable();
    });

    function LoadTable() {
        var onDate = $('#dtOnDate').val();
        table = $('#riskSummaryTbl').DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "order": [[2, 'desc']], // default sorting column(1 = "id") and sorting order
            "iDisplayLength": 25,
            "destroy": true,
            "ajax": {
                "url": "/Risk/RiskSummaryCustomPagination",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "OnDate": onDate
                }
            },
            "columns": [
                {
                    "data": "riskType", "name": "Risk Type", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.riskType;
                    }
                },
                {
                    "data": "highRiskCount", "name": "High Risk Count", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.highRiskCount;
                    }
                },
                {
                    "data": "mediumRiskCount", "name": "Medium Risk Count", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.mediumRiskCount;
                    }
                },
                {
                    "data": "lowRiskCount", "name": "Low Risk Count", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.lowRiskCount;
                    }
                },
                {
                    "data": "Total", "name": "Total", "autoWidth": true,
                    "render": function (data, type, row) {
                        return parseInt(row.highRiskCount) + parseInt(row.mediumRiskCount) + parseInt(row.lowRiskCount);
                    }
                }
            ]

        });
    }

    function ExportList() {

        $.ajax({
            type: "GET",
            url: "/Risk/ExportRiskSummary/",
            data: {
                OnDate: $('#dtOnDate').val()
            },
            success: function (data) {
                window.location = '/Risk/ExportRiskSummary?OnDate=' + $('#dtOnDate').val();
            },
            error: function (result) {
                alert('error');
            }
        });
    }
    $("#btnReset").click(function () {
        var date = new Date();
        var day = date.getDate();
        var month = date.getMonth() + 1;
        var year = date.getFullYear();
        if (month < 10) month = "0" + month;
        if (day < 10) day = "0" + day;
        var today = year + "-" + month + "-" + day;
        $('#dtOnDate').val(today);
        LoadTable();
    });
</script>
