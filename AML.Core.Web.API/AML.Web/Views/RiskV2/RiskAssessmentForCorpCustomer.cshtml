                $('#btntotalscoretop').removeClass('col-12 btn mediumhigh_background br-50 riskscore');
                $('#btntotalscoretop').removeClass('col-12 btn highrisk_background br-50 riskscore');
                $('#btntotalscoretop').addClass('col-12 btn lowrisk_background br-50 riskscore'); *@
                $('#btnRiskAssessmentRating').attr('class', `${baseClasses} bg-green-500
               `);
                $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Low"]');
                @* $('#btnAsPerRiskScore').removeClass('form-control');
                $('#btnAsPerRiskScore').removeClass('btn mediumrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn mediumhigh_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').removeClass('btn highrisk_background  br-50 risk-button riskscore');
                $('#btnAsPerRiskScore').addClass('btn lowrisk_background  br-50 risk-button riskscore'); *@
                $('#btnAsPerRiskScore').attr('class', `${baseClasses} bg-green-500
               `);
            }



            //Set Risk score witout override
            $('#riskScoreBeforeOverrideTxt').val(riskStatus);

            var OverRides = "false";

            for (x = 0; x <= b; x++) {

                OverRides = OverRides + "||" + OverRideVariables[x];
                if (OverRides.includes("true")) {
                    riskStatus = '@localizer["High Risk"]';
                    @* $('#btntotalscoretop').removeClass(); *@
                    $('#btnRiskAssessmentRating').attr('class', `${baseClasses} bg-red-400
               `);
                }
            }
            //Set final risk score
            $('#riskAssessmentRatingTxt').val(riskStatus);

            $('#riskAssessmentRatingWithoutOverrideTxt').val(riskStatus);

           $('#riskScoreSumTxt').val(total);
            $('#riskScoreCountTxt').val(i);


             
                                    

        }
        function fnSubmit() {
            //$(".se-pre-con").show();
            showLoader();
        }
        function myFunction() {

            var checkBox = document.getElementById("checked");

            var agree = confirm("Are you sure you wish to continue?");

            if (checkBox.checked == true)
            {

                if (agree) {
                    document.getElementById("hiddenvalue").value = 1;
                    return true;
                }
                else
                {
                    return false;
                }


            }
        }
        function showLoader() {
            $('#loadingRiskCategory').removeClass('hidden');
        }

        function hideLoader() {
            $('#loadingRiskCategory').addClass('hidden');
        }
</script>







