    <br />
    <br />
    <br />
    <div class="card-primary" id="reportViewDetails">*@
<div style="width:100% !important;height:70px !important;" align="right">
    <a asp-controller="Risk" asp-action="GetRiskReport"> <button type="button" id="btnBack" class="btn btn-primary center" align="right">Back</button></a>
<input name="b_print" type="button" onClick="printdiv('reportViewDetails');" value="Print" style="float:right;margin:20px;">
</div>

<div class="card-primary" id="reportViewDetails">
    <br />
    <div style="width:100%;display:none" id="logodiv">
        <div style="width:98%;text-align:center;">
            <h2>@companyName</h2>
            <img src=@logo style="width:8%;float:right;" />
        </div>
        <br />
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-md-8">
            <div class="card card-primary card-body">
                <div class="px-6 py-4 border-b border-bordercolor">
                    <h3 class="card-title">RISK ASSESSMENT FOR CORRESPONDENT BANKING</h3>
                </div>
                <div class="risk-assessment-div">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="txtUniqueIDNumber">Unique ID Number</label>
                                <input type="text" asp-for="UniqueIDNumber" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtUniqueIDNumber" placeholder="Unique ID Number" readonly />
                                <span asp-validation-for="UniqueIDNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="txtLegalNameOfTheEntity">Legal Name of the Entity</label>
                                <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="LegalNameOfTheEntity" id="txtLegalNameOfTheEntity" placeholder="Name" readonly>
                                <div id="container">
                                </div>
                                <span asp-validation-for="LegalNameOfTheEntity" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Country Of Incorporation</label>
                                <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="TxtCountryOfIncorporation" id="countryTxt" placeholder="Nationality" readonly />
                                <span asp-validation-for="CountryOfIncorporation" class="text-danger"></span>
                                <input type="hidden" asp-for="CountryOfIncorporation" id="ddlCountry" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="dtEntityDate">Date</label>
                                <input type="date" asp-for="EntityDate" class="form-control mandatory" max="3000-12-31" id="dtEntityDate" placeholder="Date" readonly>
                                <span asp-validation-for="EntityDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-primary card-body">
                <div class="px-6 py-4 border-b border-bordercolor">
                    <h3 class="card-title">Risk Assessment Rating</h3>
                </div>
                <br>
                <div class="col-sm">
                    @*<button id="btnRiskAssessmentRating" disabled class="dt-button-info form-control" type="button">Low</button>*@
                    <label for="dtEntityDate">Final Risk Rating</label><br />
                    <input type="text" asp-for="RiskAssessmentRating" id="riskAssessmentRatingTxt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly />
                    <br />
                    <label for="dtEntityDate">Risk Rating Before Override</label><br />
                    <input type="text" asp-for="RiskAssessmentRatingWithoutOverride" id="riskAssessmentRatingWithoutOverrideTxt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly />
                </div>
            </div>
        </div>
    </div>
    <div class="card card-body">
        <div>
            <table class="table">
                <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                    <tr class="row">
                        <th class="col-md-2">
                            Risk Type Category
                        </th>
                        <th class="col-md-6" style=" padding-left: 98px;">
                            Risk Type
                        </th>
                        <th class="col-md-2">
                            Risk Items
                        </th>
                        <th class="col-md-2" style="padding-left: 71px;">
                            Rating Scale
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-bordercolor">
                    @{
                        int a = 0;
                    }
                    @foreach (var i in Model.RiskTypeCategoryDTO)
                    {
                        <tr class="row">
                            <td class="col-md-2">
                                @i.RiskCategory
                            </td>
                            <td class="col-md-10 row">
                                <table class=" subcategory" id="RiskSubTable">
                                    <tbody class="divide-y divide-bordercolor">
                                        @foreach (var j in i.RiskTypes)
                                        {
                                            <tr>
                                                <td style="width: 592px;">
                                                    @j.RiskType
                                                </td>
                                                <td>
                                                    <input type="text" asp-for="@j.ItemTxt" id="RiskItemTxt_@a" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly />
                                                </td>
                                                <td style="text-align: center;">
                                                    @if (j.ItemScore == 0)
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-secondary riskscorebtn">@j.ItemScore</button>
                                                    }
                                                    else if (j.ItemScore == 1)
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-success riskscorebtn">@j.ItemScore</button>
                                                    }
                                                    else if (j.ItemScore == 2)
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-warning riskscorebtn">@j.ItemScore</button>
                                                    }
                                                    else if (j.ItemScore == 3)
                                                    {
                                                        if (j.OverrideScore == 3)
                                                        {
                                                            <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger pulse-button riskscorebtn">@j.ItemScore</button>
                                                        }
                                                        else
                                                        {
                                                            <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger riskscorebtn">@j.ItemScore</button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger riskscorebtn">@j.ItemScore</button>
                                                    }
                                                </td>
                                            </tr>
                                            a = a + 1;
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-4 border-b border-bordercolor">
            <div class="row">
                <div class="col-sm">
                    <h3 class="card-title">Total Selected :    <button id="btntotal" class="dt-button-info" type="submit">@Model.RiskScoreCount</button></h3>  <h3 class="card-title">Total score :    <button id="btntotalscore" class="dt-button-info" type="submit">@Model.RiskScoreSum</button></h3>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div style="width:90%;display:none;padding-left:2%;" id="footdiv">
        <p>Computer generated report; hence no signature is required.</p>
    </div>
</div>
