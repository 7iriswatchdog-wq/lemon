@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "EWRA Report";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.EWRA.EWRAModel
<script src="~/plugins/jquery/jquery.min.js"></script>
<style>
    select {
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        background-color: #1a2038 !important;
        background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.41 0L6 4.59L10.59 0L12 1.42L6 7.42L0 1.42L1.41 0Z' fill='white'/%3E%3C/svg%3E") !important;
        background-repeat: no-repeat !important;
        background-position-x: calc(100% - 20px) !important;
        background-position-y: 50% !important;
        color: #fff !important;
        border: none !important;
        height: calc(2rem + 20px) !important;
        border-radius: 10px !important;
        font-variant: none !important;
    }

        select option {
            background-color: #1a2038;
        }
</style>
<div class="aml-ewra-report">
    <div class="card card-primary">
        <div class="sas-card rounded-card br-20 mb-2 bg-blue">
            <h4 class="mb-0">
                <b>@localizer["Risk Summary"]</b>
            </h4>
        </div>
        <!-- /.card-header -->
        <!-- form start -->
        <!--form role="form" asp-controller="Case" asp-action="SanctionScreening" class="form-horizontal" enctype="multipart/form-data" method="post"-->
        <div class="sas-card rounded-card mb-2 bg-blue">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm">
                        <div class="form-group">
                            <label for="dtFromDate">@localizer["From Date"]</label>
                            <input type="date" asp-for="FromDate" class="form-control br-50" id="dtFromDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder="From Date">
                            @*<span asp-validation-for="OnDate" class="text-danger"></span>*@
                        </div>
                    </div>
                    <div class="col-sm">
                        <div class="form-group">
                            <label for="dtToDate">@localizer["To Date"]</label>
                            <input type="date" asp-for="ToDate" class="form-control br-50" id="dtToDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder="To Date">
                            @*<input type="date" asp-for="ToDate" class="form-control" id="dtToDate" min="@(DateTime.Now.ToString("yyyy-MM-dd"))" max="3000-12-31" placeholder="To Date">*@
                            <span asp-validation-for="ToDate" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            </div>
            <!-- /.card-body -->

            <div class="card-footer fc-center">
                <button type="submit" id="btnSearch" class="btn btn-primary center" onclick="LoadTable();">@localizer["Search"]</button>
            </div>
        </div>
        <!--/form-->
    </div>
    <div class="card card-primary">
        <div class="sas-card rounded-card br-20 mb-2 bg-blue">
            <h4 class="m-0">@localizer["Search Results"]</h4>
        </div>
        <div class="sas-card rounded-card mb-2 table-responsive p-2 bg-blue">
            <table id="ewraReportTbl" class="table table-striped table-hover dt-responsive display" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width:6%;">@localizer["Id"]</th>
                        <th style="width:20%;">@localizer["Quantitative Assessment Created By"]</th>
                        <th style="width:20%;">@localizer["Quantitative Assessment Created On"]</th>
                        <th style="width:20%;">@localizer["Qualitative Assessment Created By"]</th>
                        <th style="width:20%;">@localizer["Qualitative Assessment Created On"]</th>
                        <th style="width:14%;">@localizer["Action"]</th>

                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        LoadTable();

    });
    function LoadTable() {
        var fromDate = $('#dtFromDate').val();
        var toDate = $('#dtToDate').val();
        table = $('#ewraReportTbl').DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "order": [[0, 'asc']], // default sorting column(1 = "id") and sorting order
            "iDisplayLength": 25,
            "destroy": true,
            "ajax": {
                "url": "/EWRA/EWRAReportCustomPagination",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "fromDate": fromDate,
                    "toDate": toDate

                }
            },
            "columns": [
                //{ data: "department" },
                {
                    "render": function (data, type, full, meta) {
                        return meta.row + 1;
                    }
                },
                { "data": "createdBy" },
                { "data": "createdDate" },
                { "data": "qCreatedBy" },
                {
                    //"data": "qCreatedOn"
                    "render": function (data, type, full, meta) {
                        if (full.createdDate.split('T')[0] == '0001-01-01') {
                            return '';
                        } else {
                            return full.qCreatedDate;
                        }
                    }
                },
                {
                    "data": "view", "name": "View", "autoWidth": true,
                    "render": function (data, type, row) {
                        return '<a class="btn btn-info" href="ViewEWRAReport?id=' + row.id + '&qid='+row.qId+'">View</a>';
                    }
                }
            ]

        });
    }
</script>