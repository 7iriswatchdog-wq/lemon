@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
}
@model AML.DTO.DTO.EWRA.EWRAModelDTO
<style>
    #table-scroll {
        overflow: scroll;
        margin-top: 20px;
    }

    .table {
        width: 150%;
    }

    #FraudTable {
        width: 120%;
        margin-left: 1.8px;
        overflow: scroll;
    }

    .table td, .table th {
        padding: .65rem;
    }

    table, th {
        text-align: center;
    }

    td {
        vertical-align: bottom;
        text-align: left !important;
    }

    .form-control {
        width: 100%;
    }
</style>
@*<div style="width:100% !important;height:70px !important;">

    </div>*@
<div id="printDetails" style="width:100%">
    <br />
    <div style="width:100%;display:none" id="logodiv">
        <div style="width:98%;text-align:center;">
            <h2>@companyName</h2>
            <img src="~/img/brand-logo.svg" style="width:8%;float:right;" />
        </div>
        <br />
    </div>
    <br />
    <div class="card-primary" id="reportViewDetails" style="width:100%;padding-left:1%;">
        <div class="row" style="width:100%;padding-left:1%;">
            <h3 style="width:90%">EWRA Report Of @companyName</h3>
            <input name="b_print" id="b_print" type="button" onClick="printdiv('printDetails');" value=" Print " style="float:right;margin:20px;width:50px;"><br />
        </div>
        <div id="counterparty" class="card card-body" style="padding-bottom:0px;padding-top:10px;">
            <div class="card card-header" style="width:100%;float:left;background-color: darkgrey;">
                <h3 class="card-title">
                    @localizer["Counterparty Risk"]
                </h3>
            </div>
            <div class="card-footer row">
                <div style="width:50%;">
                    <label>@localizer["Overall Average Score"]</label>
                    <div class="form-group" style="width:70%;">
                        <button id="btnCounterPartyAvgScore" disabled class="dt-button-info form-control risk-button" type="button">@Model.CounterOverallScore</button>
                    </div>
                </div>
                <div style="width:50%;float:right">
                    <label>@localizer["Overall Risk Assessement Level"]</label>
                    <div class="form-group" style="width:70%;">
                        @if (@Model.CounterOverallRisk == "Low")
                        {
                            <button id="CounterOverallRisk" disabled class="dt-button-info form-control risk-button btn-success" type="button">@Model.CounterOverallRisk</button>
                        }
                        else if (@Model.CounterOverallRisk == "Medium")
                        {
                            <button id="CounterOverallRisk" disabled class="dt-button-info form-control risk-button btn-warning" type="button">@Model.CounterOverallRisk</button>
                        }
                        else if (@Model.CounterOverallRisk == "High")
                        {
                            <button id="CounterOverallRisk" disabled class="dt-button-info form-control risk-button btn-danger" type="button">@Model.CounterOverallRisk</button>
                        }
                        else
                        {
                            <button id="CounterOverallRisk" disabled class="dt-button-info form-control risk-button" type="button">@Model.CounterOverallRisk</button>
                        }
                    </div>
                </div>
            </div>
            <br />
            <div id="counterPartyRisk" class="card card-body counterpartyDivs">
                <div style="width:100% !important;">
                    <table class="table" id="counterPartyTable" style="width:100% !important;">
                        <thead style="display:table-header-group;background-color: white;opacity: 100;">
                            <tr class="row" style="width:100%;background-color:white">
                                <th style="vertical-align:middle;width:20% !important;align-items:center;">
                                    @localizer["Counterparty"]
                                </th>
                                <th style="vertical-align:middle;width:12% !important;align-items:center;">
                                    @localizer["Risk Assessed As Per EDD"]
                                </th>
                                <th style="vertical-align:middle;width:13% !important;align-items:center;">
                                    @localizer["Country"]
                                </th>
                                <th style="vertical-align:middle;width:9% !important;align-items:center;">
                                    @localizer["Country Risk Score"]
                                </th>
                                <th style="vertical-align:middle;width:12% !important;align-items:center;">
                                    @localizer["Country Risk Level Assessed"]
                                </th>
                                <th style="vertical-align:middle;width:9% !important;align-items:center;display:none;">
                                    @localizer["Override"]
                                </th>
                                <th style="vertical-align:middle;width:12% !important;align-items:center;">
                                    @localizer["Exposure By Amount - Ledger Debit Balances Only"]
                                </th>
                                <th style="vertical-align:middle;width:22% !important;align-items:center;">
                                    @localizer["Overide (Applicable And Reasoning)"]
                                </th>
                            </tr>
                        </thead>
                        @{
                            int b = 0;
                            int b1 = 0;
                        }
                        @foreach (var item in Model.EWRACounterPartyType)
                        {
                            int b2 = 0;
                            @foreach (var cust in item.EWRACounterPartyList)
                            {
                                <tr class="row" style="width:100%;">
                                    <td style="width: 20%;">
                                        @cust.CounterParty
                                    </td>
                                    <td style="width:12%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" value="@cust.selectedRisk" id="hdnSelectedRisk_@b" disabled />
                                    </td>
                                    <td style="width:13%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="country_@b" value="@cust.Country" disabled />
                                    </td>
                                    <td style="width:9%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countryRiskScore_@b" value="@cust.CountryRiskScore" disabled />
                                    </td>
                                    <td style="width:12%">
                                        @if (cust.CountryRiskLevel == "Low")
                                        {
                                            <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countryRisk_@b" value="Low" disabled />
                                        }
                                        else if (cust.CountryRiskLevel == "Medium")
                                        {
                                            <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countryRisk_@b" value="Medium" disabled />
                                        }
                                        else if (cust.CountryRiskLevel == "High")
                                        {
                                            <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countryRisk_@b" value="High" disabled />
                                        }
                                        else
                                        {
                                            <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countryRisk_@b" value="" disabled />
                                        }
                                    </td>
                                    <td style="width:9%;display:none;">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" value="@cust.CountryRiskRating" id="countryRiskRating_@b" disabled />
                                    </td>
                                    <td style="width:12%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" value="@cust.ExpenseAmount" id="expAmount_@b" disabled />
                                    </td>
                                    <td style="width:22%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" value="@cust.OverrideApplied" id="overrideApplied_@b" disabled />
                                    </td>
                                </tr>

                                b = b + 1;
                                b2 = b2 + 1;
                            }
                            b1 = b1 + 1;
                        }
                    </table>
                </div>


            </div>
        </div>
        <div class="row" style="width:98%;">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="dtCreatedBy">@localizer["Created By"]</label>
                    <input type="text" asp-for="@Model.CreatedBy" class="form-control mandatory" id="dtCreatedBy" placeholder="" maxlength="200" readonly>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="dtCreatedOn">@localizer["Created On"]</label>
                    <input type="text" asp-for="@Model.CreatedOn" class="form-control mandatory" id="dtCreatedOn" placeholder="" maxlength="200" readonly>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div style="width:90%;display:none;padding-left:2%;" id="footdiv">
        <p>@localizer["Computer generated report; hence no signature is required."]</p>
    </div>
</div>
<script type="text/javascript">
    function printdiv(printpage) {
        var headstr1 = "<html><head>";
        var headstr2 = "<title></title></head><body class='printDiv'>";
        var footstr = "</body>";
        var newstr = document.all.item(printpage).innerHTML;
        var oldstr = document.body.innerHTML;
        document.body.innerHTML = headstr1 + headstr2 + newstr + footstr;
        document.getElementById("logodiv").style.display = "";
        document.getElementById("footdiv").style.display = "";
        document.getElementById("b_print").style.display = "none";
        window.print();
        document.body.innerHTML = oldstr;
        return false;
    }
</script>
