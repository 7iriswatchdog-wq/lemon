@using AML.Core.Common.StaticResource;
@model AML.ViewModel.ViewModels.EWRA.EWRAModel
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    #table-scroll {
        overflow: scroll;
        margin-top: 20px;
    }

    table, th {
        text-align: center;
    }

    td {
        vertical-align: bottom;
        text-align: left !important;
    }

    .nav-tabs {
        border-bottom: 3px solid #007bff;
    }

    a.nav-link.active {
        background-color: #007afd !important;
        color: #fff !important;
    }

    .subcategory tr td {
        border-top: none !important;
    }

    .subcategory tr td {
        border-bottom: none !important;
    }

    .btn.disabled, .btn:disabled {
        opacity: 1 !important;
    }

    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>
<script src="~/plugins/jquery/jquery.min.js"></script>
