            $('#volumeTotal_' + i).val(total);
            $('#hdnVolumeTotal_' + i).val(total);
            var weightedHighVal = highVal / total;
            var weightedMediumVal = mediumVal / total;
            var weightedLowVal = lowVal / total;
            var riskScore = (3 * weightedHighVal) + (2 * weightedMediumVal) + (1 * weightedLowVal);
            if (riskScore.toFixed(2) == 'NaN') {
                riskScore = 0;
            }
            $('#volumeRiskScore_' + i).text(riskScore.toFixed(2));
            $('#hdnVolumeRiskScore_' + i).val(riskScore.toFixed(2));
            if (riskScore < 1) {
                $('#volumeRiskScore_' + i).removeClass("bg-red-500 text-white");
                $('#volumeRiskScore_' + i).removeClass("bg-yellow-400 text-white");
                $('#volumeRiskScore_' + i).addClass("bg-green-500 text-white");
            } else if (riskScore > 2) {
                $('#volumeRiskScore_' + i).removeClass("bg-green-500 text-white");
                $('#volumeRiskScore_' + i).removeClass("bg-yellow-400 text-white");
                $('#volumeRiskScore_' + i).addClass("bg-red-500 text-white");
            } else {
