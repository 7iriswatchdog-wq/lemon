        function calculateOverallScoreCustomer() {
            var custCnt = 0;
            if ($('#volumeScore').val() != '0' && $('#volumeScore').val() != '') {
                custCnt++;
            }
            if ($('#countScore').val() != '0' && $('#countScore').val() != '') {
                custCnt++;
            }
            if ($('#transactionScore').val() != '0' && $('#transactionScore').val() != '') {
                custCnt++;
            }
            var total = Number($('#volumeScore').val()) + Number($('#countScore').val()) + Number($('#transactionScore').val());
            //var average = total / 3;
            var average = total / custCnt;
            $('#btnCustomerAvgScore').text(average.toFixed(2));
            $('#hdnCustomerAvgScore').val(average.toFixed(2));
            if (average < 1) {
                $('#btnCustomerRiskLevel').text('@localizer["Low"]');
                $('#hdnCustomerRiskLevel').val("Low");
                $('#btnCustomerRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnCustomerRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnCustomerRiskLevel').addClass("bg-green-500 text-white");
            } else if (average > 2) {
                $('#btnCustomerRiskLevel').text('@localizer["High"]');
                $('#hdnCustomerRiskLevel').val("High");
                $('#btnCustomerRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnCustomerRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnCustomerRiskLevel').addClass("bg-red-500 text-white");
            } else {
                $('#btnCustomerRiskLevel').text('@localizer["Medium"]');
                $('#hdnCustomerRiskLevel').val("Medium");
                $('#btnCustomerRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnCustomerRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnCustomerRiskLevel').addClass("bg-yellow-400 text-white");
            }
            calculateTotal();
        }
        function SaveCustomerProfile(type) {
            $.ajax({
                type: 'POST',
                url: '/EWRA/SaveCustomerProfile',     //your action
                data: $('#myform').serialize(),   //your form name.it takes all the values of model
                dataType: 'json',
                beforeSend: function () {
                    $(".se-pre-con").show();
                    $(".card-header").fadeOut()
                },
                success: function (data) {
                    console.log(data);
                    $('#Id').val(data.id);
                    if (data.isCount != "0") {
                        $('#doneCount').show();
                    } else {
                        $('#doneCount').hide();
                    }
                    if (data.isVolume != "0") {
                        $('#doneVolume').show();
                    } else {
                        $('#doneVolume').hide();
                    }
                    if (data.isTransaction != "0") {
                        $('#doneTransaction').show();
                    } else {
                        $('#doneTransaction').hide();
                    }
                },
                error: function (request, data) {
                    console.log(data);
                },
                complete: function (data) {
                    $(".se-pre-con").fadeOut();
                    $(".card-header").show();
                }
            });
        }
