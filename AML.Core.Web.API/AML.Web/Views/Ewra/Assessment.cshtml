        function counterChange(i, count) {
            var key = event.which;

            if (!((key >= 48 && key <= 57) || (key == 46))) {
                if (event.type != "change") {
                    event.preventDefault();
                    return false;
                }
            }
            var countryRisk = Number($('#countryRiskRating_' + i).val());
            var total = 0;
            for (var j = 0; j < count; j++) {
                if ($('#riskEdd_' + j).val() != 0) {
                    total += Number($('#expAmount_' + j).val());
                }
            }
            var totalWeightedScore = 0;
            var high = 0;
            var medium = 0;
            var low = 0;
            for (var j = 0; j < count; j++) {
                var override = $('#countryRiskRating_' + j).val();
                if (override == 1) {
                    if ($('#riskEdd_' + j).val() != 0) {
                        low += Number($('#expAmount_' + j).val());
                    }
                } else if (override == 2) {
                    if ($('#riskEdd_' + j).val() != 0) {
                        medium += Number($('#expAmount_' + j).val());
                    }
                } else if (override == 3) {
                    if ($('#riskEdd_' + j).val() != 0) {
                        high += Number($('#expAmount_' + j).val());
                    }
                }
            }

            var weightedLow = 0;
            var weightedMedium = 0;
            var weightedHigh = 0;
            if (total > 0) {
                weightedLow = 1 * (low / total);
                weightedMedium = 2 * (medium / total);
                weightedHigh = 3 * (high / total);
            }
            totalWeightedScore = Number(weightedLow) + Number(weightedMedium) + Number(weightedHigh);
            $('#btnCounterPartyAvgScore').text(totalWeightedScore.toFixed(2));
            $('#hdnCounterPartyAvgScore').val(totalWeightedScore.toFixed(2));
            if (totalWeightedScore < 1) {
                $('#btnCounterPartyRiskLevel').text("Low");
                $('#hdnCounterPartyRiskLevel').val("Low");
                $('#btnCounterPartyRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnCounterPartyRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnCounterPartyRiskLevel').addClass("bg-green-500 text-white");
            } else if (totalWeightedScore > 2) {
                $('#btnCounterPartyRiskLevel').text("High");
                $('#hdnCounterPartyRiskLevel').val("High");
                $('#btnCounterPartyRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnCounterPartyRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnCounterPartyRiskLevel').addClass("bg-red-500 text-white");
            } else {
                $('#btnCounterPartyRiskLevel').text("Medium");
                $('#hdnCounterPartyRiskLevel').val("Medium");
                $('#btnCounterPartyRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnCounterPartyRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnCounterPartyRiskLevel').addClass("bg-yellow-400 text-white");
            }
            $('#counterDone').show();
            calculateTotal();
        }
        function deliveryChange(i, count, risk) {
            var key = event.which;

            if (!((key >= 48 && key <= 57) || (key == 46))) {
                if (event.type != "change") {
                    event.preventDefault();
                    return false;
                }
            }
            var bankRisk = Number($('#bank_' + i).val());
            var cashRisk = Number($('#cash_' + i).val());
            var totRiskScore = Number(bankRisk.toFixed(2)) + Number(cashRisk.toFixed(2));
            var deliveryRisk = (1 * (bankRisk / totRiskScore)) + (3 * (cashRisk / totRiskScore));
            $('#deliveryRiskScore_' + i).val(deliveryRisk.toFixed(2));
            $('#hdndeliveryRiskScore_' + i).val(deliveryRisk.toFixed(2));
            var tot = 0;
            for (var j = 0; j < count; j++) {
                tot += Number($('#deliveryRiskScore_' + j).val());
            }
            var avg = tot / count;
            $('#btnDeliveryAvgScore').text(avg.toFixed(1));
            $('#hdnDeliveryAvgScore').val(avg.toFixed(1));
            if (avg <= 1) {
                $('#btnDeliveryRiskLevel').text('@localizer["Low"]');
                $('#hdnDeliveryRiskLevel').val("Low");
                $('#btnDeliveryRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnDeliveryRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnDeliveryRiskLevel').addClass("bg-green-500 text-white");
            } else if (avg > 2) {
                $('#btnDeliveryRiskLevel').text('@localizer["High"]');
                $('#hdnDeliveryRiskLevel').val("High");
                $('#btnDeliveryRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnDeliveryRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnDeliveryRiskLevel').addClass("bg-red-500 text-white");
            } else {
                $('#btnDeliveryRiskLevel').text('@localizer["Medium"]');
                $('#hdnDeliveryRiskLevel').val("Medium");
                $('#btnDeliveryRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnDeliveryRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnDeliveryRiskLevel').addClass("bg-yellow-400 text-white");
            }
            $('#deliveryDone').show();
            calculateTotal();
        }
        function countryOnChange(i) {
            var selected = $('#jurisCountry_' + i).val();
            var text = $("#jurisCountry_" + i + " option:selected").text();
            $("#jurCountry_" + i).val(text);
            $("#jurCountryId_" + i).val(selected);
            var id = $('#jurisCountry_' + i).val();
            $.ajax({
                url: '/EWRA/GetJurisdictionData',
                type: 'GET',
                data: {
                    'Id': id
                },
                dataType: 'json',
                beforeSend: function () {
                    //$(".se-pre-con").show();
                    showLoader();
                },
                success: function (data) {
                    $(".se-pre-con").hide();
                    $('#countryRiskScoreJurisdiction_' + i).val(data.countryRiskScore);
                    $('#hdncountryRiskScoreJurisdiction_' + i).val(data.countryRiskScore);
                    var level;
                    if (data.countryRiskRating == 1) {
                        level = '@localizer["Low"]';
                    } else if (data.countryRiskRating == 2) {
                        level = '@localizer["Medium"]';
                    } else if (data.countryRiskRating == 3) {
                        level = '@localizer["High"]';
                    }
                    $('#countryRiskLevelJurisdiction_' + i).val(level);
                    $('#riskScoreJurisdiction_' + i).val(data.countryRiskRating);
                    $('#hdncountryRiskLevelJurisdiction_' + i).val(level);
                    $('#hdnriskScoreJurisdiction_' + i).val(data.countryRiskRating);
                    hideLoader();
                },
                error: function (request, error) {

                },
                complete: function (data) {
                }
            });
        }
        function jurisdictionChange(i) {
            var key = event.which;

            if (!((key >= 48 && key <= 57) || (key == 46))) {
                if (event.type != "change") {
                    event.preventDefault();
                    return false;
                }
            }
            var count = $('#jurisdictionRisk input[data-field="jurisdictionLedger"]').length;
            var ledgerAmount = $('#ledgerBalance_' + i).val();
            var total = 0;
            var totWeightedScore = 0;
            for (var j = 0; j < count; j++) {
                total += Number($('#ledgerBalance_' + j).val());
            }
            for (var j = 0; j < count; j++) {
                var riskScore = $('#riskScoreJurisdiction_' + j).val();
                var ledAmount = $('#ledgerBalance_' + j).val();
                var weightedScore = riskScore * (Number(ledAmount) / Number(total));
                totWeightedScore += weightedScore;
            }
            $('#btnJurisdictionAvgScore').text(totWeightedScore.toFixed(2));
            $('#hdnJurisdictionAvgScore').val(totWeightedScore.toFixed(2));
            if (totWeightedScore <= 1) {
                $('#btnJurisdictionRiskLevel').text('@localizer["Low"]');
                $('#hdnJurisdictionRiskLevel').val("Low");
                $('#btnJurisdictionRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnJurisdictionRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnJurisdictionRiskLevel').addClass("bg-green-500 text-white");
            } else if (totWeightedScore > 2) {
                $('#btnJurisdictionRiskLevel').text('@localizer["High"]');
                $('#hdnJurisdictionRiskLevel').val("High");
                $('#btnJurisdictionRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnJurisdictionRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnJurisdictionRiskLevel').addClass("bg-red-500 text-white");
            } else {
                $('#btnJurisdictionRiskLevel').text('@localizer["Medium"]');
                $('#hdnJurisdictionRiskLevel').val("Medium");
                $('#btnJurisdictionRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnJurisdictionRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnJurisdictionRiskLevel').addClass("bg-yellow-400 text-white");
            }
            $('#jurisdictionDone').show();
            calculateTotal();
        }
        function calculateTotal() {
            var totCnt = 0;
            if ($('#btnCustomerAvgScore').text() != '0' && $('#btnCustomerAvgScore').text() != '') {
                totCnt++;
            }
            if ($('#btnCounterPartyAvgScore').text() != '0' && $('#btnCustomerAvgScore').text() != '') {
                totCnt++;
            }
            if ($('#btnProductAvgScore').text() != '0' && $('#btnCustomerAvgScore').text() != '') {
                totCnt++;
            }
            if ($('#btnJurisdictionAvgScore').text() != '0' && $('#btnCustomerAvgScore').text() != '') {
                totCnt++;
            }
            if ($('#btnDeliveryAvgScore').text() != '0' && $('#btnCustomerAvgScore').text() != '') {
                totCnt++;
            }
            var total = Number($('#btnCustomerAvgScore').text()) + Number($('#btnCounterPartyAvgScore').text()) + Number($('#btnProductAvgScore').text()) + Number($('#btnJurisdictionAvgScore').text()) + Number($('#btnDeliveryAvgScore').text());
            //var average = total / 5;
            var average = total / totCnt;
            $('#btnTotalScore').text(average.toFixed(2));
            $('#hdnTotalScore').val(average.toFixed(2));
            if (average <= 1) {
                $('#btnTotalRiskLevel').text('@localizer["Low"]');
                $('#hdnTotalRiskLevel').val("Low");
                $('#btnTotalRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnTotalRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnTotalRiskLevel').addClass("bg-green-500 text-white");
            } else if (average > 2) {
                $('#btnTotalRiskLevel').text('@localizer["High"]');
                $('#hdnTotalRiskLevel').val("High");
                $('#btnTotalRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnTotalRiskLevel').removeClass("bg-yellow-400 text-white");
                $('#btnTotalRiskLevel').addClass("bg-red-500 text-white");
            } else {
                $('#btnTotalRiskLevel').text('@localizer["Medium"]');
                $('#hdnTotalRiskLevel').val("Medium");
                $('#btnTotalRiskLevel').removeClass("bg-green-500 text-white");
                $('#btnTotalRiskLevel').removeClass("bg-red-500 text-white");
                $('#btnTotalRiskLevel').addClass("bg-yellow-400 text-white");
            }
        }
        function AddJurisdictionRow(i) {
            $('#jurisdictionAddRow_' + i).hide();
            var dditems = @Html.Raw(jsonItems);
            var empTab = document.getElementById('jurisdictionTable');
            var rowCnt = empTab.rows.length - 1;
            var str = '<tr>';
            str += '<td class="px-4 py-2 text-left text-sm text-gray-900">';
            //str += '<select id="jurisCountry_' + rowCnt + '" class="form-control" onchange="countryOnChange(' + rowCnt + ')" asp-items="Model.MainNationalityLists">';
            //str += '<option value="0">--SELECT--</option>';
            //str += '</select>';
            str += "<select id='jurisCountry_" + rowCnt + "' class='form-control w-full px-3 py-2 border border-gray-300 rounded-md font-extralight' onchange='countryOnChange(" + rowCnt + ")'>";
            var opt = "<option value='0'>--@localizer["SELECT"]--</option>";
            for (var i = 0; i < dditems.length; i++) {
                opt += '<option value="' + dditems[i]['Value'] + '">' + dditems[i]['Text'] + '</option>';
            }
            str += opt + "</select></td>";
            str += '<input type="hidden" class="form-control w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="jurCountry_' + rowCnt + '" name="Model.EWRAJurisdiction[' + rowCnt + '].Country"  />';
            str += '<input type="hidden" class="form-control w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="jurCountryId_' + rowCnt + '" name="Model.EWRAJurisdiction[' + rowCnt + '].CountryId" value="0" />';
            str += '</td>';
            str += '<td class="px-4 py-2 text-left text-sm text-gray-900">';
            str += '<input type="text" class="form-control custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="countryRiskScoreJurisdiction_'+rowCnt+'" asp-for="Model.EWRAJurisdiction['+rowCnt+'].CountryRiskScore" readonly />';
            str += '<input type="hidden" class="form-control custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="hdncountryRiskScoreJurisdiction_'+rowCnt+'" asp-for="Model.EWRAJurisdiction['+rowCnt+'].CountryRiskScore" />';
            str += '</td>';
            str += '<td class="px-4 py-2 text-left text-sm text-gray-900">';
            str += '<input type="text" class="form-control custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="countryRiskLevelJurisdiction_'+rowCnt+'" asp-for="Model.EWRAJurisdiction['+rowCnt+'].CountryRiskLevel" readonly />';
            str += '<input type="hidden" class="form-control custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="hdncountryRiskLevelJurisdiction_' + rowCnt + '" asp-for="Model.EWRAJurisdiction[' + rowCnt + '].CountryRiskLevel" />';
            str += '</td>';
            str += '<td class="px-4 py-2 text-left text-sm text-gray-900">';
            str += '<input type="text" class="form-control custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="riskScoreJurisdiction_'+rowCnt+'" asp-for="Model.EWRAJurisdiction['+rowCnt+'].CountryRiskRating" readonly />';
            str += '<input type="hidden" class="form-control custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="hdnriskScoreJurisdiction_' + rowCnt + '" asp-for="Model.EWRAJurisdiction[' + rowCnt + '].CountryRiskRating" value="0" />';
            str += '</td>';
            str += '<td class="px-4 py-2 text-left text-sm text-gray-900">';
            str += '<input type="text" class="form-control decimal custTxt w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" maxlength="15" id="ledgerBalance_' + rowCnt + '" data-field="jurisdictionLedger" asp-for="Model.EWRAJurisdiction[' + rowCnt + '].LedgerAmount" onkeyup="jurisdictionChange(' + rowCnt + ')" onchange="jurisdictionChange(' + rowCnt + ')" />';
        //str += '<i class="nav-icon fa fa-plus-circle fa-lg" id="jurisdictionAddRow_' + rowCnt + '" onclick="AddJurisdictionRow(' + rowCnt + ')" style="float:right;color:#ff8a48;padding-top:10%;"></i>';
            str += '</td>';
            str += '</tr>';
            $('#jurisdictionTable > tbody:last-child').append(str);
    }
    function showLoader() {
        $('#loadingRiskCategory').removeClass('hidden');
    }
    function hideLoader() {
        $('#loadingRiskCategory').addClass('hidden');
    }
</script>
