                $('#volumeRiskScore_' + i).removeClass("bg-red-500 text-white");
                $('#volumeRiskScore_' + i).addClass("bg-yellow-400 text-white");
            }
            var totVolumeRiskScore = 0;
            var enteredCount = 0;
            for (var j = 0; j < count; j++) {
                totVolumeRiskScore += Number($('#volumeRiskScore_' + j).text());
