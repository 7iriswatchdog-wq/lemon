    function calculateInherentScore(i, j, k, riskCount, inherentCount) {

        if (i == 0) {
            $('#doneCustomerInherent').show();
            $('#customerDone').show();
        } else if (i == 1) {
            $('#doneCounterInherent').show();
            $('#counterDone').show();
        } else if (i == 2) {
            $('#doneProductsInherent').show();
            $('#productsDone').show();
        } else if (i == 3) {
            $('#doneJurisdictionInherent').show();
            $('#jurisdictionDone').show();
        } else if (i == 4) {
            $('#doneDeliveryInherent').show();
            $('#deliveryDone').show();
        }
        var impactId = $('#ddlInherentImpact_' + i + '_' + j + '_' + k).val();
        var impact = $("#ddlInherentImpact_" + i + '_' + j + '_' + k + " option:selected").text();
        $('#hdnInherentImpactId_' +i+'_' + j + '_' + k).val(impactId);
        $('#hdnInherentImpact_'+i + '_' + j + '_' + k).val(impact);

        var likelihoodId = $('#ddlInherentLikelihood_' + i + '_' + j + '_' + k).val();
        var likelihood = $("#ddlInherentLikelihood_" + i + '_' + j + '_' + k + " option:selected").text();
        $('#hdnInherentLikelihoodId_'+i + '_' + j + '_' + k).val(likelihoodId);
        $('#hdnInherentLikelihood_'+i + '_' + j + '_' + k).val(likelihood);

        var inherentRiskScore = 0;


        inherentRiskScore = +impactId * +likelihoodId;
        $('#btnInherentRiskScore_'+i + '_' + j + '_' + k).text(inherentRiskScore);
        $('#hdnInherentRiskScore_'+i + '_' + j + '_' + k).val(inherentRiskScore);
        var inherentRisk = 'Low';
        if (inherentRiskScore < 3) {
            inherentRisk = 'Low';
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).text(inherentRisk);
            $('#hdnInherentRiskRating_' + i + '_' + j + '_' + k).val(inherentRisk);
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-danger text-white bg-red-500");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).addClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-danger text-white bg-red-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).addClass("btn btn-success text-white bg-green-500");

        }
      else   if (inherentRiskScore >= 3 && inherentRiskScore < 6) {
            inherentRisk = 'Medium';
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).text(inherentRisk);
            $('#hdnInherentRiskRating_' + i + '_' + j + '_' + k).val(inherentRisk);
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-danger text-white bg-red-500");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).addClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-danger text-white bg-red-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).addClass("btn btn-warning text-white bg-yellow-400");
        }
      else  if (inherentRiskScore <= 6)
        {
            inherentRisk = 'High';
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).text(inherentRisk);
            $('#hdnInherentRiskRating_' + i + '_' + j + '_' + k).val(inherentRisk);
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).addClass("btn btn-danger text-white bg-red-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).addClass("btn btn-danger text-white bg-red-500");
        }
        else if (inherentRiskScore == 9) {
            inherentRisk = 'High';
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).text(inherentRisk);
            $('#hdnInherentRiskRating_' + i + '_' + j + '_' + k).val(inherentRisk);
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).removeClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskRating_' + i + '_' + j + '_' + k).addClass("btn btn-danger text-white bg-red-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).removeClass("btn btn-success text-white bg-green-500");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).addClass("btn btn-danger text-white bg-red-500");
        }

        //KEYCONTROL SCORE

        var keycontrolscoreId = $('#dllkeycontrolscore_' + i + '_' + j + '_' + k).val();
        var keycontrolscore = $("#dllkeycontrolscore_" + i + '_' + j + '_' + k + " option:selected").text();
        $('#hdnkeycontrolscoreId_' + i + '_' + j + '_' + k).val(keycontrolscoreId);
        $('#hdnkeycontrolscore_' + i + '_' + j + '_' + k).val(keycontrolscore);

        var residualriskscore = 0;
        var residualriskscoreval = 0;

        var avgRiskRating = 'Low';
        residualriskscore = +inherentRiskScore / keycontrolscoreId;
        residualriskscoreval = Math.round(residualriskscore);
        $('#residualriskscore_' + i + '_' + j + '_' + k).text(residualriskscoreval);
        $('#hdresidualriskscore_' + i + '_' + j + '_' + k).val(residualriskscoreval);
        if (residualriskscoreval < 3) {
            $('#residualriskscore_' + i + '_' + j + '_' + k).addClass("text-white bg-green-500");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-yellow-400");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-red-500");
            avgRiskRating = 'Low';
            $('#hdresidualriskrating_' + i + '_' + j + '_' + k).text(avgRiskRating);

            $('#clrScorehdn_' + i + '_' + j + '_' + k).val(residualriskscoreval);


        }
        else if (residualriskscoreval >= 3 && residualriskscoreval < 6) {

            $('#residualriskscore_' + i + '_' + j + '_' + k).addClass("text-white bg-yellow-400");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-green-500");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-red-500");
            avgRiskRating = 'Medium';
            $('#hdresidualriskrating_' + i + '_' + j + '_' + k).text(avgRiskRating);
            $('#clrScorehdn_' + i + '_' + j + '_' + k).val(residualriskscoreval);
        }
        else if (residualriskscoreval >= 6) {

            $('#residualriskscore_' + i + '_' + j + '_' + k).addClass("text-white bg-red-500");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-green-500");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-yellow-400");
            avgRiskRating = 'High';
            $('#hdresidualriskrating_' + i + '_' + j + '_' + k).text(avgRiskRating);
            $('#clrScorehdn_' + i + '_' + j + '_' + k).val(residualriskscoreval);
        }
        else if (residualriskscoreval == 9) {

            $('#residualriskscore_' + i + '_' + j + '_' + k).addClass("text-white bg-red-500");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-green-500");
            $('#residualriskscore_' + i + '_' + j + '_' + k).removeClass("text-white bg-yellow-400");
            avgRiskRating = 'High';
            $('#hdresidualriskrating_' + i + '_' + j + '_' + k).text(avgRiskRating);
            $('#clrScorehdn_' + i + '_' + j + '_' + k).val(residualriskscoreval);
        }
        //Final Residual Risk
        calculateTotal(i);
    }
    function calculateTotal(i) {

        if (i == 0) {
            $('#doneCustomerResidual').show();
            $('#customerDone').show();
        } else if (i == 1) {
            $('#doneCounterResidual').show();
            $('#counterDone').show();
        } else if (i == 2) {
            $('#doneProductsResidual').show();
            $('#productsDone').show();
        } else if (i == 3) {
            $('#doneJurisdictionResidual').show();
            $('#jurisdictionDone').show();
        } else if (i == 4) {
            $('#doneDeliveryResidual').show();
            $('#deliveryDone').show();
        }
        var total = 0;
        var j = 0;
        var residualriskscore = 0;
        $('.riskscorehdn_' + i).each(function () {
            total = parseInt(total) + parseInt($(this).val());
            if ($(this).val() != 0) {
                j++;
            }
        });
        $('#btntotalscore1').text(total);
        $('#btntotal').text(j);
        console.log(total,j)
        residualriskscore += total / j;
        residualriskscore_roundoff = Math.round(residualriskscore);
        var residualRiskLevel = 'Low';
        if (residualriskscore_roundoff < 3) {
            residualRiskLevel = 'Low';
            $('#btnResidualRiskRating_' + i).text(residualRiskLevel);
            $('#btntotalscore_'+i).text(residualriskscore_roundoff);
            $('#btnResidualRiskRating_' + i).val(residualRiskLevel);

            $('#hdnResidualRiskRating_' + i).val(residualRiskLevel);
            $('#hdnbtntotalscore_' + i).val(residualriskscore_roundoff);
            $('#hdnResidualRiskRatingType_' + i).val(residualRiskLevel);
            $('#hdnResidualRiskRatingscore_' + i).val(residualriskscore_roundoff);



            $('#btnResidualRiskRating_' + i).addClass("text-white bg-blue-500");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-yellow-400");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-red-500");


            $('#btntotalscore_' + i).addClass("text-white bg-green-500");
            $('#btntotalscore_' + i).removeClass("text-white bg-yellow-400");
            $('#btntotalscore_' + i).removeClass("text-white bg-red-500");

        }
        else if (residualriskscore_roundoff >= 3 && residualriskscore_roundoff < 6) {
            residualRiskLevel = 'Medium';
            $('#btnResidualRiskRating_'+i).text(residualRiskLevel);
            $('#btntotalscore_'+i).text(residualriskscore_roundoff);
            $('#btnResidualRiskRating_'+i).val(residualRiskLevel);

            $('#hdnResidualRiskRating_' + i).val(residualRiskLevel);
            $('#hdnbtntotalscore_' + i).val(residualriskscore_roundoff);
            $('#hdnResidualRiskRatingType_' + i).val(residualRiskLevel);
            $('#hdnResidualRiskRatingscore_' + i).val(residualriskscore_roundoff);


            $('#btnResidualRiskRating_' + i).addClass("text-white bg-yellow-400");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-green-500");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-red-500");

            $('#btntotalscore_' + i).addClass("text-white bg-yellow-400");
            $('#btntotalscore_' + i).removeClass("text-white bg-green-500");
            $('#btntotalscore_' + i).removeClass("text-white bg-red-500");


        }
        else if (residualriskscore_roundoff >= 6) {
            residualRiskLevel = 'High';

            $('#btnResidualRiskRating_'+i).text(residualRiskLevel);
            $('#btntotalscore_'+i).text(residualriskscore_roundoff);
            $('#btnResidualRiskRating_'+i).val(residualRiskLevel);

            $('#hdnResidualRiskRating_' + i).val(residualRiskLevel);
            $('#hdnbtntotalscore_' + i).val(residualriskscore_roundoff);
            $('#hdnResidualRiskRatingType_' + i).val(residualRiskLevel);
            $('#hdnResidualRiskRatingscore_' + i).val(residualriskscore_roundoff);


            $('#btnResidualRiskRating_' + i).addClass("text-white bg-red-500");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-green-500");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-yellow-400");

            $('#btntotalscore_' + i).addClass("text-white bg-red-500");
            $('#btntotalscore_' + i).removeClass("text-white bg-green-500");
            $('#btntotalscore_' + i).removeClass("text-white bg-yellow-400");



        }
        else if (residualriskscore_roundoff == 9) {
            residualRiskLevel = 'High';

            $('#btnResidualRiskRating_' + i).text(residualRiskLevel);
            $('#btntotalscore_' + i).text(residualriskscore_roundoff);
            $('#btnResidualRiskRating_' + i).val(residualRiskLevel);

            $('#hdnResidualRiskRating_' + i).val(residualRiskLevel);
            $('#hdnbtntotalscore_' + i).val(residualriskscore_roundoff);
            $('#hdnResidualRiskRatingType_' + i).val(residualRiskLevel);
            $('#hdnResidualRiskRatingscore_' + i).val(residualriskscore_roundoff);

            $('#btnResidualRiskRating_' + i).addClass("text-white bg-red-500");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-green-500");
            $('#btnResidualRiskRating_' + i).removeClass("text-white bg-yellow-400");

            $('#btntotalscore_' + i).addClass("text-white bg-red-500");
            $('#btntotalscore_' + i).removeClass("text-white bg-green-500");
            $('#btntotalscore_' + i).removeClass("text-white bg-yellow-400");

        }
        //overallscore calculation
        calculateOverallScore();
    }
    function calculateOverallScore() {
        var total = 0;
        var selectedCount = 0;
        for (var i = 0; i < 5; i++) {
            var residRiskScore = Number($('#btntotalscore_' + i).text());

            if(residRiskScore > 0){
                total += residRiskScore;
                selectedCount++;
            }
        }
        var avg = total / selectedCount;
        $('#btnTotalScore').text(avg.toFixed(2));
        $('#hdnTotalScore').val(avg.toFixed(2));
        if (avg < 3) {
            $('#btnTotalRiskLevel').text('@localizer["Low"]');
            $('#hdnTotalRiskLevel').val('Low');
            $('#btnTotalRiskLevel').removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnTotalRiskLevel').removeClass("btn btn-danger text-white bg-red-500");
            $('#btnTotalRiskLevel').addClass("btn btn-success text-white bg-green-500");

        } else if (avg >= 3 && avg < 6) {

            $('#btnTotalRiskLevel').text('@localizer["Medium"]');
            $('#hdnTotalRiskLevel').val('Medium');
            $('#btnTotalRiskLevel').removeClass("btn btn-danger text-white bg-red-500");
            $('#btnTotalRiskLevel').removeClass("btn btn-success text-white bg-green-500");
            $('#btnTotalRiskLevel').addClass("btn btn-warning text-white bg-yellow-400");


        } else if (avg >= 6) {
             $('#btnTotalRiskLevel').text('@localizer["High"]');
            $('#hdnTotalRiskLevel').val('High');
            $('#btnTotalRiskLevel').removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnTotalRiskLevel').removeClass("btn btn-success text-white bg-green-500");
            $('#btnTotalRiskLevel').addClass("btn btn-danger text-white bg-red-500");

        }
        else if (avg ==9) {
             $('#btnTotalRiskLevel').text('@localizer["High"]');
            $('#hdnTotalRiskLevel').val('High');
            $('#btnTotalRiskLevel').removeClass("btn btn-warning text-white bg-yellow-400");
            $('#btnTotalRiskLevel').removeClass("btn btn-success text-white bg-green-500");
            $('#btnTotalRiskLevel').addClass("btn btn-danger text-white bg-red-500");

        }
                }
                function showLoader() {
                    $('#loadingRiskCategory').removeClass('hidden');
                }
                function hideLoader() {
                    $('#loadingRiskCategory').addClass('hidden');
                }
