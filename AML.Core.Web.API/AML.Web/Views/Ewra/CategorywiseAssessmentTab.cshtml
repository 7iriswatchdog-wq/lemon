@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@using AML.Core.Common.StaticResource;
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-beta.1/css/select2.min.css" integrity="sha512-yI2XOLiLTQtFA9IYePU0Q1Wt0Mjm/UkmlKMy4TU4oNXEws0LybqbifbO8t9rEIU65qdmtomQEQ+b3XfLfCzNaw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@("@")ttskch/select2-bootstrap4-theme@x.x.x/dist/select2-bootstrap4.min.css">
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-beta.1/js/select2.min.js" defer integrity="sha512-qiKM6FJbI5x5+GL5CEbAUK0suRhjXVMRXnH/XQJaaQ6iQPf05XxbFBE4jS6VJzPGIRg7xREZTrGJIZVk1MLclA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
@model AML.ViewModel.ViewModels.EWRA.EWRAModel
<style>
    #table-scroll {
        overflow: scroll;
        margin-top: 20px;
    }

    table, th {
        text-align: center;
    }

    td {
        vertical-align: bottom;
        text-align: left !important;
        border-top: none !important;
        border-bottom: 1px solid #dee2e6 !important;
    }

    .nav-tabs {
        border-bottom: 3px solid #007bff;
    }

    a.nav-link.active {
        background-color: #007afd !important;
        color: #fff !important;
    }

    .subcategory tr td {
        border-top: none !important;
    }

    .subcategory tr td {
        border-bottom: none !important;
    }

    .btn.disabled, .btn:disabled {
        opacity: 1 !important;
    }

    #assessmentTable {
        overflow: scroll;
    }

    .inTb {
        overflow: hidden;
        white-space: nowrap;
    }

    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }

    .btn {
        color: white;
    }
</style>
<div class="card-primary">
    <div class="p-6">
        @* <nav class="border-b">
            <div class="flex flex-row items-center justify-between w-full h-full md:p-5 p-5">
                <div>
                    <h2 class="text-2xl font-bold">EWRA - Qualitative Risk Assessment</h2>
                </div>
                <div class="md:block hidden">
                   <img src="@Clientlogo" alt="Client Logo" width="50px" />
                </div>
            </div>
        </nav> *@
        <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-surface">
            <div class="flex items-center justify-between w-full">
                <!-- Title -->
                <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                    EWRA - Qualitative Risk Assessment
                </h2>

                <!-- Right-side content -->
                <div class="text-sm md:text-base text-right">
                    <img src="@Clientlogo" alt="Client Logo" width="50px" />
                </div>
            </div>
        </nav>
        <div class="h-full bg-gray-50 items-center ">
            <div id="block1" class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4 mx-auto">
                <div class="sas-card rounded-card w-full bg-surface rounded-xl shadow-sm p-4 overflow-hidden border border-blue-100 relative">
                    <form role="form" id="myform" asp-controller="EWRA" asp-action="CategorywiseAssessmentTab" class="form-horizontal" enctype="multipart/form-data" method="post">
                        <div class="se-pre-con1" id="se" style="display:none;"></div>
                        <div class="flex flex-col md:flex-row gap-4">
                            <div class="md:w-1/2 flex flex-col">
                                <div class="bg-blue-100 rounded-lg shadow-md p-4 h-full">
                                    <div class="bg-orange-500 text-white px-4 py-2 rounded-md mb-5">
                                        <h3 class="text-lg font-semibold">@localizer["EWRA - Qualitative Risk Assessment"]</h3>
                                        <input type="hidden" asp-for="@Model.Id" id="Id" />
                                    </div>
                                    <div class="risk-assessment-div">
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <div class="form-group">
                                                    <label for="txtDateofAssessment" class="block text-sm font-medium text-gray-700">@localizer["Date Of Assessment"]</label>
                                                    <input type="date" class="form-input mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 mandatory" asp-for="@Model.DateOfAssessment" max="3000-12-31" id="txtDateofAssessment" placeholder=@localizer["Date of Assessment"]>
                                                    <span class="text-red-600 text-sm"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <div class="form-group mb-0">
                                                    <label for="qid" class="block text-sm font-medium text-gray-700">@localizer["Quantitative Assessment"]</label>
                                                    <select id="qid" class="form-select mt-1 block w-full border-gray-300 rounded-md shadow-sm delddl" asp-items="@Model.QuantitativeList" onchange="QIDOnchange()" asp-for="@Model.QuantitativeId">
                                                        <option value="0">--@localizer["SELECT"]--</option>
                                                    </select>
                                                    <input type="hidden" asp-for="@Model.QuantitativeId" id="hdnQid" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="md:w-1/2 flex flex-col">
                                <div class="bg-blue-100 rounded-lg shadow-md p-4 space-y-6 h-full">
                                    <div>
                                        <div class="row">
                                            <div class="col-sm">
                                                <label class="block text-sm font-medium text-gray-700">@localizer["Overall Average Score"]</label>
                                                <div class="form-group">
                                                    <button id="btnTotalScore" disabled class="w-full bg-blue-500 text-white py-2 rounded-md shadow-sm cursor-not-allowed" type="button">@Model.QualitativeOverallScore</button>
                                                    <input type="hidden" id="hdnTotalScore" asp-for="@Model.QualitativeOverallScore" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <br />
                                    <div>
                                        <div class="row">
                                            <div class="col-sm">
                                                <label class="block text-sm font-medium text-gray-700">@localizer["Overall Risk Assessement Level"]</label>
                                                <div class="form-group">
                                                    @if (@Model.QualitativeOverallRating == "Low")
                                                    {
                                                        <button id="btnTotalRiskLevel" disabled class="w-full bg-green-500 text-white py-2 rounded-md shadow-sm cursor-not-allowed" type="button">@Model.QualitativeOverallRating</button>
                                                    }
                                                    else if (@Model.QualitativeOverallRating == "Medium")
                                                    {
                                                        <button id="btnTotalRiskLevel" disabled class="w-full bg-yellow-400 text-white py-2 rounded-md shadow-sm cursor-not-allowed" type="button">@Model.QualitativeOverallRating</button>
                                                    }
                                                    else if (@Model.QualitativeOverallRating == "High")
                                                    {
                                                        <button id="btnTotalRiskLevel" disabled class="w-full bg-red-500 text-white py-2 rounded-md shadow-sm cursor-not-allowed" type="button">@Model.QualitativeOverallRating</button>
                                                    }
                                                    else
                                                    {
                                                        <button id="btnTotalRiskLevel" disabled class="w-full bg-gray-300 text-black py-2 rounded-md shadow-sm cursor-not-allowed" type="button">@Model.QualitativeOverallRating</button>
                                                    }
                                                    <input type="hidden" id="hdnTotalRiskLevel" asp-for="@Model.QualitativeOverallRating" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--Customer Begin-->
                        <div id="customerRisk"
                             class="card card-body tab-pane active"
                             role="tabpanel"
                             style="padding-bottom:0px;padding-top:10px;">

                            <!-- HEADER -->
                            <div class="w-full bg-primary px-4 py-3 rounded-t-md">
                                <h3 class="text-white text-lg font-semibold flex items-center justify-between">
                                    @localizer["Customer Risk"]

                                    @if (Model.QCustOverallScore != null)
                                    {
                                        if (Model.QCustOverallScore.ParseFloat() > 0)
                                        {
                                            <i class="nav-icon fa fa-check-circle" id="customerDone" style="color:green;"></i>
                                        }
                                        else
                                        {
                                            <i class="nav-icon fa fa-check-circle" id="customerDone" style="color:green;display:none;"></i>
                                        }
                                    }
                                    else
                                    {
                                        <i class="nav-icon fa fa-check-circle" id="customerDone" style="color:green;display:none;"></i>
                                    }

                                    <i class="nav-icon fa fa-plus-circle customerAdd" id="customerAdd" onclick="toggleCustomer()"></i>
                                    <i class="nav-icon fa fa-minus-circle customerAdd" id="customerMinus" onclick="toggleCustomer()"></i>
                                </h3>
                            </div>

                            <!-- TAB HEADER -->
                            <div class="customerDivs" style="display:none;">
                                <ul class="flex flex-col md:flex-row border-b border-gray-300 bg-gray-100 rounded-t-md" role="tablist">
                                    <li class="md:w-1/3 w-full text-center border-b md:border-b-0 md:border-r border-gray-300">
                                        <a class="flex justify-between items-center px-4 py-3 text-gray-800 font-semibold hover:bg-blue-100 transition-all"
                                           role="tab"
                                           data-toggle="tab"
                                           href="#customerInherent"
                                           onclick="tabChange()">
                                            @localizer["INHERENT RISK"]
                                            <i class="nav-icon fa fa-check-circle text-green-500 hidden" id="doneCustomerInherent"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- TAB CONTENT -->
                            <div class="tab-content customerDivs" style="display:none;">
                                <div id="customerInherent" class="bg-surface p-4 tab-pane active my-2">

                                    <!-- ✅ RESPONSIVE SCROLL WRAPPER -->
                                    <div class="w-full overflow-x-auto">

                                        <!-- TABLE -->
                                        <table id="assessmentTable"
                                               class="min-w-[1600px] table-auto table-striped table-hover border-collapse"
                                               cellspacing="0">

                                            <thead class="bg-[#E9EFFD] text-center">
                                                <tr>
                                                    <!-- ✅ STICKY FIRST COLUMN -->
                                                    <th class="sticky left-0 z-30 bg-[#E9EFFD] px-4 py-2 text-left text-sm font-semibold">
                                                        @localizer["Risk Description"]
                                                    </th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Inherent Risk"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Inherent Impact"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Inherent Likelihood"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Inherent Risk Rating"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Inherent Risk Score"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Key Control/Mitization"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Key Control Score"]</th>
                                                    <th class="px-4 py-2 text-left text-sm font-semibold">@localizer["Residual Risk"]</th>
                                                </tr>
                                            </thead>

                                            <tbody class="divide-y divide-bordercolor">
                                                @for (var i = 0; i < Model.EWRAQualitativeModel.Count; i++)
                                                {
                                                    if (Model.EWRAQualitativeModel[i].RiskTypeId == 1)
                                                    {
                                                        <tr>
                                                            <td class="sticky left-0 bg-surface z-20">
                                                                <input type="hidden"
                                                                       id="hdrisktypeid@(i)"
                                                                       asp-for="@Model.EWRAQualitativeModel[i].RiskTypeId" />
                                                            </td>
                                                        </tr>

                                                        for (var j = 0; j < Model.EWRAQualitativeModel[i].EWRARiskModel.Count; j++)
                                                        {
                                                            <tr>
                                                                <!-- ✅ STICKY FIRST COLUMN -->
                                                                <td class="sticky left-0 bg-surface z-20 text-sm align-middle">
                                                                    @Model.EWRAQualitativeModel[i].EWRARiskModel[j].RiskDescription
                                                                    <input type="hidden"
                                                                           id="hdnDescriptionId_@(i)_@(j)"
                                                                           asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].DescriptionId" />
                                                                </td>


                                                                <!-- Inherent Risk -->
                                                                <td class="py-2 text-left text-sm text-gray-900">
                                                                    @if (Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData != null &&
                                                                                                                            Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count > 0)
                                                                    {
                                                                        <select class="form-control w-full p-2 border-[#E2E8F0] border rounded-lg bg-surface font-extralight"
                                                                                asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentRiskId">
                                                                            @for (var k = 0; k < Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count; k++)
                                                                            {
                                                                                <option value="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskId">
                                                                                    @Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskDescription
                                                                                </option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-sm text-red-500">No inherent risk data available.</span>
                                                                    }
                                                                </td>

                                                                <!-- Inherent Impact -->
                                                                <td class="py-2 text-left text-sm text-gray-900">
                                                                    @{
                                                                        var inherentList = Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData;
                                                                    }
                                                                    @if (inherentList != null && inherentList.Count > 0)
                                                                    {
                                                                        <select class="form-control grid-select inher_impact w-full p-2 border-[#E2E8F0] border rounded-lg bg-surface font-extralight"
                                                                                id="ddlInherentImpact_@(i)_@(j)_0"
                                                                                asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentImpactId"
                                                                                onchange="calculateInherentScore(@i,@j,0,@Model.EWRAQualitativeModel[i].EWRARiskModel.Count,@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count)">
                                                                            <option value="0">--@localizer["EMPTY"]--</option>
                                                                            <option value="3">@localizer["HIGH"]</option>
                                                                            <option value="2">@localizer["MEDIUM"]</option>
                                                                            <option value="1">@localizer["LOW"]</option>
                                                                        </select>

                                                                        <input type="hidden" id="hdnInherentImpactId_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentImpactId" />
                                                                        <input type="hidden" id="hdnInherentImpact_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentImpact" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-red-500 text-sm">No Inherent Impact data found.</span>
                                                                    }
                                                                </td>

                                                                <!-- Inherent Likelihood -->
                                                                <td class="py-2 text-left text-sm text-gray-900">
                                                                    @{
                                                                        var inherentList1 = Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData;
                                                                    }
                                                                    @if (inherentList1 != null && inherentList1.Count > 0 && inherentList1[0].InherentRiskRating == null)
                                                                    {
                                                                        <select class="form-control grid-select inher_likel w-full p-2 border-[#E2E8F0] border rounded-lg bg-surface font-extralight"
                                                                                id="ddlInherentLikelihood_@(i)_@(j)_0"
                                                                                asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentLikelihoodId"
                                                                                onchange="calculateInherentScore(@i,@j,0,@Model.EWRAQualitativeModel[i].EWRARiskModel.Count,@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count)">
                                                                            <option value="0">--@localizer["EMPTY"]--</option>
                                                                            <option value="3">@localizer["HIGH"]</option>
                                                                            <option value="2">@localizer["MEDIUM"]</option>
                                                                            <option value="1">@localizer["LOW"]</option>
                                                                        </select>

                                                                        <input type="hidden" id="hdnInherentLikelihoodId_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentLikelihoodId" />
                                                                        <input type="hidden" id="hdnInherentLikelihood_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentLikelihood" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-red-500 text-sm">No Inherent Likelihood data found.</span>
                                                                    }
                                                                </td>

                                                                <!-- Rating -->
                                                                <!-- Score -->
                                                                @{
                                                                    var inherentDataList = Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData;
                                                                }

                                                                @if (inherentDataList != null && inherentDataList.Count > 0 && inherentDataList[0].InherentRiskRating == null)
                                                                {
                                                                    <td class="px-4 py-2 text-left text-sm text-gray-900">
                                                                        <button type="button"
                                                                                id="btnInherentRiskRating_@(i)_@(j)_0"
                                                                                class="btn btn-block btn-secondary riskscorebtn inher_risk_rate w-full px-4 py-2 rounded-md shadow-sm">
                                                                            @localizer["Low"]
                                                                        </button>
                                                                        <input type="hidden"
                                                                               id="hdnInherentRiskRating_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentRiskRating" />
                                                                    </td>

                                                                    <td class="px-4 py-2 text-left text-sm text-gray-900">
                                                                        <button type="button"
                                                                                id="btnInherentRiskScore_@(i)_@(j)_0"
                                                                                class="btn btn-block btn-secondary riskscorebtn inher_risk_score w-full px-4 py-2 rounded-md shadow-sm">
                                                                            0
                                                                        </button>
                                                                        <input type="hidden"
                                                                               id="hdnInherentRiskScore_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[0].InherentRiskScore" />
                                                                    </td>
                                                                }

                                                                <!-- Key Control -->
                                                                <td class="py-2 text-left text-sm text-gray-900">
                                                                    @{
                                                                        var keyControlList = Model.EWRAQualitativeModel[i].EWRARiskModel[j].KeyControlModelData;
                                                                    }
                                                                    @if (keyControlList != null && keyControlList.Count > 0)
                                                                    {
                                                                        <select class="form-control key_cont w-full p-2 border-[#E2E8F0] border rounded-lg bg-surface font-extralight"
                                                                                asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].KeyControlModelData[0].KeyId">
                                                                            @for (var k = 0; k < keyControlList.Count; k++)
                                                                            {
                                                                                <option value="@keyControlList[k].KeyId">
                                                                                    @keyControlList[k].KeyControl
                                                                                </option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-red-500 text-sm">No key controls available</span>
                                                                    }
                                                                </td>

                                                                <!-- Key Control Score -->
                                                                <td class="py-2 text-left text-sm text-gray-900">
                                                                    @{
                                                                        var keyControlList1 = Model.EWRAQualitativeModel[i].EWRARiskModel[j].KeyControlModelData;
                                                                    }
                                                                    @if (keyControlList1 != null && keyControlList1.Count > 0)
                                                                    {
                                                                        <select class="form-control grid-select keycontrol_score w-full p-2 border-[#E2E8F0] border rounded-lg bg-surface font-extralight"
                                                                                id="dllkeycontrolscore_@(i)_@(j)_0"
                                                                                asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].KeyControlModelData[0].KeyControlScoreId"
                                                                                onchange="calculateInherentScore(@i,@j,0,@Model.EWRAQualitativeModel[i].EWRARiskModel.Count,@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count)">
                                                                            <option value="0">--@localizer["EMPTY"]--</option>
                                                                            <option value="3">@localizer["HIGH"]</option>
                                                                            <option value="2">@localizer["MEDIUM"]</option>
                                                                            <option value="1">@localizer["LOW"]</option>
                                                                        </select>

                                                                        <input type="hidden" id="hdnkeycontrolscoreId_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].KeyControlModelData[0].SelectedKeyId" />
                                                                        <input type="hidden" id="hdnkeycontrolscore_@(i)_@(j)_0"
                                                                               asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].KeyControlModelData[0].SelectedKey" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-red-500 text-sm">No Key Control Scores available</span>
                                                                    }
                                                                </td>

                                                                <!-- Residual Risk -->
                                                                <td class="px-4 py-2 text-left text-sm text-gray-900">
                                                                    @{
                                                                        int a = 0;
                                                                    }

                                                                    @for (var k = 0; k < Model.EWRAQualitativeModel[i].EWRARiskModel[j].ResidualRiskModelData.Count; k++)
                                                                    {
                                                                        <input type="hidden"
                                                                               id="hdresidualriskscore_@(i)_@(j)_@(k)"
