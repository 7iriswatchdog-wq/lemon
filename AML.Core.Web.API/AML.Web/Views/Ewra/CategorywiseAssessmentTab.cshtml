                        <div id="counterRisk"
     class="card card-body tab-pane active"
     role="tabpanel"
     style="padding-bottom:0px;padding-top:10px;">

    <div class="w-full bg-primary px-4 py-3 rounded-t-md">
        <h3 class="text-white text-lg font-semibold flex items-center justify-between">
            @localizer["Counterparty Risk"]

            <div class="flex items-center gap-3">
                @if (@Model.QCounterOverallScore != null)
                {
                    if (@Model.QCounterOverallScore.ParseFloat() > 0)
                    {
                        <i class="nav-icon fa fa-check-circle" id="counterDone" style="color:green;"></i>
                    }
                    else
                    {
                        <i class="nav-icon fa fa-check-circle" id="counterDone" style="color:green;display:none;"></i>
                    }
                }
                else
                {
                    <i class="nav-icon fa fa-check-circle" id="counterDone" style="color:green;display:none;"></i>
                }

                <i class="nav-icon fa fa-plus-circle counterAdd cursor-pointer" id="counterAdd" onclick="toggleCounter()"></i>
                <i class="nav-icon fa fa-minus-circle counterAdd cursor-pointer" id="counterMinus" onclick="toggleCounter()" style="display:none;"></i>
            </div>
        </h3>
    </div>

    <div class="counterDivs" style="display:none;">
        <ul class="flex flex-col md:flex-row border-b border-gray-300 bg-gray-100 rounded-t-md" role="tablist">
