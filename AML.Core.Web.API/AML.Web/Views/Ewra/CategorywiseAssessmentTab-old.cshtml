        $(".productsDivs").hide();
        $(".jurisdictionDivs").hide();
        $(".deliveryAdd").toggle();
        $("#customerMinus").hide();
        $("#counterMinus").hide();
        $("#productsMinus").hide();
        $("#jurisdictionMinus").hide();
        $("#customerAdd").show();
        $("#counterAdd").show();
        $("#productsAdd").show();
        $("#jurisdictionAdd").show();
    }
    function calculateInherentScore(i, j, k, riskCount, inherentCount) {
        if (i == 0) {
            $('#doneCustomerInherent').show();
            $('#customerDone').show();
        } else if (i == 1) {
            $('#doneCounterInherent').show();
            $('#counterDone').show();
        } else if (i == 2) {
            $('#doneProductsInherent').show();
            $('#productsDone').show();
        } else if (i == 3) {
            $('#doneJurisdictionInherent').show();
            $('#jurisdictionDone').show();
        } else if (i == 4) {
            $('#doneDeliveryInherent').show();
            $('#deliveryDone').show();
        }
        var impactId = $('#ddlInherentImpact_' + i+'_'+j+'_'+k).val();
        var impact = $("#ddlInherentImpact_" + i + '_' + j + '_' + k +" option:selected").text();
        $('#hdnInherentImpactId_' +i+'_' + j + '_' + k).val(impactId);
        $('#hdnInherentImpact_'+i + '_' + j + '_' + k).val(impact);

        var likelihoodId = $('#ddlInherentLikelihood_'+i + '_' + j + '_' + k).val();
        var likelihood = $("#ddlInherentLikelihood_"+i + '_' + j + '_' + k + " option:selected").text();
        $('#hdnInherentLikelihoodId_'+i + '_' + j + '_' + k).val(likelihoodId);
        $('#hdnInherentLikelihood_'+i + '_' + j + '_' + k).val(likelihood);

        var inherentRiskScore = 0;
        if (impactId == 1 && likelihoodId == 1) {
            inherentRiskScore = 1;
        } else if (impactId == 2 && likelihoodId == 1) {
            inherentRiskScore = 1;
        } else if (impactId == 3 && likelihoodId == 1) {
            inherentRiskScore = 2;
        } else if (impactId == 1 && likelihoodId == 2) {
            inherentRiskScore = 1;
        } else if (impactId == 2 && likelihoodId == 2) {
            inherentRiskScore = 2;
        } else if (impactId == 3 && likelihoodId == 2) {
            inherentRiskScore = 3;
        } else if (impactId == 1 && likelihoodId == 3) {
            inherentRiskScore = 2;
        } else if (impactId == 2 && likelihoodId == 3) {
            inherentRiskScore = 3;
        } else if (impactId == 3 && likelihoodId == 3) {
            inherentRiskScore = 3;
        } else {
            if (impactId == 0 && likelihoodId != 0) {
                inherentRiskScore = likelihoodId;
            } else if (impactId != 0 && likelihoodId == 0) {
                inherentRiskScore = impactId;
            } else {
                inherentRiskScore = 0;
            }
        }
        $('#btnInherentRiskScore_'+i + '_' + j + '_' + k).text(inherentRiskScore);
        $('#hdnInherentRiskScore_'+i + '_' + j + '_' + k).val(inherentRiskScore);
        var inherentRisk = 'Low';
        if (inherentRiskScore == 1) {
            inherentRisk = 'Low';
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).text(inherentRisk);
            $('#hdnInherentRiskRating_' +i+'_'+j+'_'+k).val(inherentRisk);
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-danger");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-warning");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).addClass("btn btn-success");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-danger");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-warning");
            $('#btnInherentRiskScore_' + i + '_' + j + '_' + k).addClass("btn btn-success");

        } else if (inherentRiskScore == 2) {
            inherentRisk = 'Medium';
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).text(inherentRisk);
            $('#hdnInherentRiskRating_' +i+'_'+j+'_'+k).val(inherentRisk);
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-danger");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-success");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).addClass("btn btn-warning");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-danger");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-success");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).addClass("btn btn-warning");
        } else if (inherentRiskScore == 3) {
            inherentRisk = 'High';
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).text(inherentRisk);
            $('#hdnInherentRiskRating_' +i+'_'+j+'_'+k).val(inherentRisk);
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-warning");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-success");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).addClass("btn btn-danger");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-warning");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-success");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).addClass("btn btn-danger");
        } else {
            inherentRisk = 'Low';
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).text(inherentRisk);
            $('#hdnInherentRiskRating_' +i+'_'+j+'_'+k).val(inherentRisk);
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-warning");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-success");
            $('#btnInherentRiskRating_' +i+'_'+j+'_'+k).removeClass("btn btn-danger");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-warning");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-success");
            $('#btnInherentRiskScore_' +i+'_'+j+'_'+k).removeClass("btn btn-danger");
        }
        var totInherentImpact = 0;
        var avgInherentImpact = 0;
        var totalInherentLikelihood = 0;
        var avgInherentLikelihood = 0;
        var totalRiskScore = 0;
        var avgRiskScore = 0;
        var avgRiskRating = 'Low';

        for (var l = 0; l < riskCount; l++) {
            var rowTotImpact = 0;
            var rowAvgImpact = 0;
            var rowTotLikelihood = 0;
            var rowAvgLikelihood = 0;
            var rowTotRiskScore = 0;
            var rowAvgRiskScore = 0;
            var enteredCount = 0;
            for (var m = 0; m < inherentCount; m++) {
                rowTotImpact += Number($('#ddlInherentImpact_' + i + '_' + l + '_' + m).val());
                rowTotLikelihood += Number($('#ddlInherentLikelihood_' + i + '_' + l + '_' + m).val());
                rowTotRiskScore += Number($('#btnInherentRiskScore_' + i + '_' + l + '_' + m).text());
                if ($('#btnInherentRiskScore_' + i + '_' + l + '_' + m).text() != "" && $('#btnInherentRiskScore_' + i + '_' + l + '_' + m).text() != '0') {
                    enteredCount++;
                }
            }
            rowAvgImpact = rowTotImpact / inherentCount;
            rowAvgImpact = rowTotImpact / enteredCount;
            totInherentImpact += rowAvgImpact;
            rowAvgLikelihood = rowTotLikelihood / inherentCount;
            rowAvgLikelihood = rowTotLikelihood / enteredCount;
            totalInherentLikelihood += rowAvgLikelihood;
            rowAvgRiskScore = rowTotRiskScore / inherentCount;
            totalRiskScore += rowAvgRiskScore;
        }

        avgInherentImpact = totInherentImpact / riskCount;
        if (avgInherentImpact <= 1) {
            $('#btnInherentImpactAvg_' + i).text('@localizer["Low"]');
            $('#hdnInherentImpactAvg_' + i).val('Low');
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-danger");
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-warning");
            $('#btnInherentImpactAvg_' + i).addClass("btn btn-success");
        } else if (avgInherentImpact > 2) {
            $('#btnInherentImpactAvg_' + i).text('@localizer["High"]');
            $('#hdnInherentImpactAvg_' + i).val('High');
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-success");
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-warning");
            $('#btnInherentImpactAvg_' + i).addClass("btn btn-danger");

        } else if (avgInherentImpact > 1 && avgInherentImpact <= 2) {
            $('#btnInherentImpactAvg_' + i).text('@localizer["Medium"]');
            $('#hdnInherentImpactAvg_' + i).val('Medium');
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-danger");
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-success");
            $('#btnInherentImpactAvg_' + i).addClass("btn btn-warning");
        } else {
            $('#btnInherentImpactAvg_' + i).text('@localizer["Low"]');
            $('#hdnInherentImpactAvg_' + i).val('Low');
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-danger");
            $('#btnInherentImpactAvg_' + i).removeClass("btn btn-warning");
            $('#btnInherentImpactAvg_' + i).addClass("btn btn-success");
        }

        avgInherentLikelihood = totalInherentLikelihood / riskCount;
        if (avgInherentLikelihood <= 1) {
            $('#btnInherentLikelihoodAvg_' + i).text('@localizer["Low"]');
            $('#hdnInherentLikelihoodAvg_' + i).val('Low');
            $('#btnInherentLikelihoodAvg_' + i).removeClass("btn btn-danger");
            $('#btnInherentLikelihoodAvg_' + i).removeClass("btn btn-warning");
            $('#btnInherentLikelihoodAvg_' + i).addClass("btn btn-success");
        } else if (avgInherentLikelihood > 2) {
            $('#btnInherentLikelihoodAvg_' + i).text('@localizer["High"]');
            $('#hdnInherentLikelihoodAvg_' + i).val('High');
            $('#btnInherentLikelihoodAvg_' + i).removeClass("btn btn-warning");
            $('#btnInherentLikelihoodAvg_' + i).removeClass("btn btn-success");
            $('#btnInherentLikelihoodAvg_' + i).addClass("btn btn-danger");
        } else if (avgInherentLikelihood > 1 && avgInherentLikelihood <= 2) {
            $('#btnInherentLikelihoodAvg_' + i).text('@localizer["Medium"]');
