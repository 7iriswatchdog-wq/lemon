@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
@using AML.Core.Common.StaticResource;

@model AML.ViewModel.ViewModels.EWRA.EWRAModel
<style>
    #table-scroll {
        overflow: scroll;
        margin-top: 20px;
    }

    table, th {
        text-align: center;
    }

    td {
        vertical-align: bottom;
        text-align: left !important;
        border-top: none !important;
        border-bottom: 1px solid #dee2e6 !important;
    }

    .nav-tabs {
        border-bottom: 3px solid #007bff;
    }

    a.nav-link.active {
        background-color: #007afd !important;
        color: #fff !important;
    }

    .subcategory tr td {
        border-top: none !important;
    }

    .subcategory tr td {
        border-bottom: none !important;
    }

    .btn.disabled, .btn:disabled {
        opacity: 1 !important;
    }

    #assessmentTable {
        overflow: scroll;
    }

    .inTb {
        overflow: hidden;
        white-space: nowrap;
    }
</style>
<script src="~/plugins/jquery/jquery.min.js"></script>
<form role="form" id="myform" asp-controller="EWRA" asp-action="CategorywiseAssessmentTab" class="form-horizontal" enctype="multipart/form-data" method="post">
    <div class="se-pre-con1" id="se" style="display:none;"></div>
    <div class="row card-body">
        <div class="col-md-8">
            <div class="card card-primary card-body">
                <div class="card-header">
                    <h3 class="card-title">@localizer["EWRA - Qualitative Risk Assessment"]</h3>
                    <input type="hidden" asp-for="@Model.Id" id="Id" />
                </div>
                <div class="risk-assessment-div">
                    <div class="row">
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="txtDateofAssessment">@localizer["Date Of Assessment"]</label>
                                <input type="date" class="form-control mandatory" asp-for="@Model.DateOfAssessment" max="3000-12-31" id="txtDateofAssessment" placeholder=@localizer["Date of Assessment"]>
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="qid">@localizer["Quantittative Assessment"]</label>
                                <select id="qid" class="form-control delddl" asp-items="@Model.QuantitativeList" onchange="QIDOnchange()" asp-for="@Model.QuantitativeId">
                                    <option value="0">--@localizer["SELECT"]--</option>
                                </select>
                                <input type="hidden" asp-for="@Model.QuantitativeId" id="hdnQid" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body">
                <div>
                    <div class="row">
                        <div class="col-sm">
                            <label>@localizer["Overall Average Score"]</label>
                            <div class="form-group">
                                <button id="btnTotalScore" disabled class="dt-button-info form-control risk-button" type="button">@Model.QualitativeOverallScore</button>
                                <input type="hidden" id="hdnTotalScore" asp-for="@Model.QualitativeOverallScore" />
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div>
                    <div class="row">
                        <div class="col-sm">
                            <label>@localizer["Overall Risk Assessement Level"]</label>
                            <div class="form-group">
                                @if(@Model.QualitativeOverallRating == "Low"){
                                <button id="btnTotalRiskLevel" disabled class="form-control btn btn-success" type="button">@Model.QualitativeOverallRating</button>
                                }else if(@Model.QualitativeOverallRating == "Medium"){
                                <button id="btnTotalRiskLevel" disabled class="form-control btn btn-warning" type="button">@Model.QualitativeOverallRating</button>
                                }else if(@Model.QualitativeOverallRating == "High"){
                                <button id="btnTotalRiskLevel" disabled class="form-control btn btn-danger" type="button">@Model.QualitativeOverallRating</button>
                                }else{
                                <button id="btnTotalRiskLevel" disabled class="form-control risk-button" type="button">@Model.QualitativeOverallRating</button>
                                }
                                <input type="hidden" id="hdnTotalRiskLevel" asp-for="@Model.QualitativeOverallRating" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--Customer Begin-->
    <div id="customerRisk" class="card card-body tab-pane active" role="tabpanel" style="padding-bottom:0px;padding-top:10px;">
        <div class="card card-header" style="width:100%;float:left;background-color: darkgrey;">
            <h3 class="card-title">
                @localizer["Customer Risk"]
                @if(@Model.QCustOverallScore != null){
                @if(@Model.QCustOverallScore.ParseFloat() > 0){
                <i class="nav-icon fa fa-check-circle" id="customerDone" style="color:green;"></i>
                    }else{
                <i class="nav-icon fa fa-check-circle" id="customerDone" style="color:green;display:none;"></i>
                    }
                }else{
                <i class="nav-icon fa fa-check-circle" id="customerDone" style="color:green;display:none;"></i>
                }
                <i class="nav-icon fa fa-plus-circle customerAdd" id="customerAdd" onclick="toggleCustomer()" style="float:right;"></i>
                <i class="nav-icon fa fa-minus-circle customerAdd" id="customerMinus" onclick="toggleCustomer()" style="float:right;display:none;"></i>
            </h3>
        </div>
        <div class="customerDivs" style="display:none;">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item active" style="width:33.3%;text-align:center;">
                    <a class="nav-link active" role="tab" data-toggle="tab" href="#customerInherent" style="color:black;" onclick="tabChange()">@localizer["INHERENT RISK"]<i class="nav-icon fa fa-check" id="doneCustomerInherent" style="display:none;float:right;color:green"></i></a>
                </li>
                <li class="nav-item" style="width:33.3%;text-align:center;">
                    <a class="nav-link" role="tab" data-toggle="tab" href="#customerKey" style="color:black;" onclick="tabChange()">@localizer["KEY CONTROL/MITIGATION"]<i class="nav-icon fa fa-check" id="doneCustomerKey" style="display:none;float:right;color:green"></i></a>
                </li>
                <li class="nav-item" style="width:33.3%;text-align:center;">
                    <a class="nav-link" role="tab" data-toggle="tab" href="#customerResidual" style="color:black;" onclick="tabChange()">@localizer["RESIDUAL RISK"]<i class="nav-icon fa fa-check" id="doneCustomerResidual" style="display:none;float:right;color:green"></i></a>
                </li>
            </ul>
        </div>
        <div class="tab-content customerDivs" style="display:none;">
            <div id="customerInherent" class="card card-body tab-pane active" role="tabpanel">
                <table class="table" id="assessmentTable" style="width:100%;">
                    <thead style="display:table-header-group;background-color: white;opacity: 100;position:sticky;top:0;">
                        <tr class="row" style="width:100%;background-color:white;flex-wrap:nowrap">
                            <th style="vertical-align:middle;width:20% !important;align-items:center;display:flex;">
                                @localizer["Risk Description"]
                            </th>
                            <th style="vertical-align:middle;width:30% !important;align-items:center;display:flex;">
                                @localizer["Inherent Risk"]
                            </th>
                            <th style="vertical-align:middle;width:12.5% !important;align-items:center;display:flex;">
                                @localizer["Inherent Impact"]
                            </th>
                            <th style="vertical-align:middle;width:12.5% !important;align-items:center;display:flex;">
                                @localizer["Inherent Likelihood"]
                            </th>
                            <th style="vertical-align:middle;width:12.5% !important;align-items:center;display:flex;">
                                @localizer["Inherent Risk Rating"]
                            </th>
                            <th style="vertical-align:middle;width:12.5% !important;align-items:center;display:flex;">
                                @localizer["Inherent Risk Score"]
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.EWRAQualitativeModel.Count; i++)
                        {
                        @if (@Model.EWRAQualitativeModel[i].RiskTypeId == 1)
                            {
                        <tr class="row" style="width:100%;background-color:white;flex-wrap:nowrap">
                            <td style="vertical-align: middle; align-items: center; display: flex;width:100%;">
                                <table id="qualityTable" style="width:100%;">
                                    @for (var j = 0; j < Model.EWRAQualitativeModel[i].EWRARiskModel.Count; j++)
                                            {
                                    <tr class="row" style="width:100%;background-color:white;flex-wrap:nowrap;">
                                        <td style="width:20%;">
                                            @Model.EWRAQualitativeModel[i].EWRARiskModel[j].RiskDescription
                                            <input type="hidden" id="hdnDescriptionId_@(i)_@(j)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].DescriptionId" value="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].DescriptionId" />
                                            @*<input type="hidden" id="hdnDescription_@(i)_@(j)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].RiskDescription" value="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].RiskDescription" />*@
                                        </td>
                                        <td style="width:80%;">
                                            <table style="width:106%">
                                                @for (var k = 0; k < Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count; k++)
                                                            {
                                                <tr class="row">
                                                    <td style="width:35.8%;border-bottom:0px !important;">
                                                        @Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskDescription
                                                        <input type="hidden" id="hdnInherentRiskId_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskId" />
                                                        @*<input type="hidden" id="hdnInherentRisk_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskDescription" />*@
                                                    </td>
                                                    <!-- Inherent start-->
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <select class="form-control grid-select" id="ddlInherentImpact_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentImpactId" onchange="calculateInherentScore(@i,@j,@k,@Model.EWRAQualitativeModel[i].EWRARiskModel.Count,@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count)" style="width:90%">
                                                            <option value="0">--@localizer["EMPTY"]--</option>
                                                            <option value="3">@localizer["HIGH"]</option>
                                                            <option value="2">@localizer["MEDIUM"]</option>
                                                            <option value="1">@localizer["LOW"]</option>
                                                        </select>
                                                        <input type="hidden" id="hdnInherentImpactId_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentImpactId" />
                                                        <input type="hidden" id="hdnInherentImpact_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentImpact" />
                                                    </td>
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <select class="form-control grid-select" id="ddlInherentLikelihood_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentLikelihoodId" onchange="calculateInherentScore(@i,@j,@k,@Model.EWRAQualitativeModel[i].EWRARiskModel.Count,@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData.Count)" style="width:90%">
                                                            <option value="0">--@localizer["EMPTY"]--</option>
                                                            <option value="3">@localizer["HIGH"]</option>
                                                            <option value="2">@localizer["MEDIUM"]</option>
                                                            <option value="1">@localizer["LOW"]</option>
                                                        </select>
                                                        <input type="hidden" id="hdnInherentLikelihoodId_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentLikelihoodId" />
                                                        <input type="hidden" id="hdnInherentLikelihood_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentLikelihood" />
                                                    </td>
                                                    @if (@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating != null)
                                                                    {
                                                    @if (@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating == "Low")
                                                                        {
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskRating_@(i)_@(j)_@(k)" class="btn btn-success" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating</button>
                                                        <input type="hidden" id="hdnInherentRiskRating_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating" />
                                                    </td>
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskScore_@(i)_@(j)_@(k)" class="btn btn-success" style="width:50px;height:40px;">@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore</button>
                                                        <input type="hidden" id="hdnInherentRiskScore_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore" />
                                                    </td>
                                                                        }
                                                                        else if (@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating == "Medium")
                                                                        {
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskRating_@(i)_@(j)_@(k)" class="btn btn-warning" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating</button>
                                                        <input type="hidden" id="hdnInherentRiskRating_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating" />
                                                    </td>
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskScore_@(i)_@(j)_@(k)" class="btn btn-warning" style="width:50px;height:40px;">@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore</button>
                                                        <input type="hidden" id="hdnInherentRiskScore_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore" />
                                                    </td>
                                                                        }
                                                                        else if (@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating == "High")
                                                                        {
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskRating_@(i)_@(j)_@(k)" class="btn btn-danger" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating</button>
                                                        <input type="hidden" id="hdnInherentRiskRating_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating" />
                                                    </td>
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskScore_@(i)_@(j)_@(k)" class="btn btn-danger" style="width:50px;height:40px;">@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore</button>
                                                        <input type="hidden" id="hdnInherentRiskScore_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore" />
                                                    </td>
                                                                        }else{
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskRating_@(i)_@(j)_@(k)" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>
                                                        <input type="hidden" id="hdnInherentRiskRating_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating" />
                                                    </td>
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskScore_@(i)_@(j)_@(k)" class="btn btn-block btn-secondary riskscorebtn" style="width:50px;height:40px;">0</button>
                                                        <input type="hidden" id="hdnInherentRiskScore_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore" />
                                                    </td>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskRating_@(i)_@(j)_@(k)" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>
                                                        <input type="hidden" id="hdnInherentRiskRating_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskRating" />
                                                    </td>
                                                    <td style="width:15.8%;border-bottom:0px !important;">
                                                        <button type="button" id="btnInherentRiskScore_@(i)_@(j)_@(k)" class="btn btn-block btn-secondary riskscorebtn" style="width:50px;height:40px;">0</button>
                                                        <input type="hidden" id="hdnInherentRiskScore_@(i)_@(j)_@(k)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].InherentRiskModelData[k].InherentRiskScore" />
                                                    </td>
                                                                    }
                                                    <!-- Inherent end-->
                                                </tr>
                                                            }
                                            </table>
                                        </td>
                                    </tr>
                                            }
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="card-footer row">
                                    <div style="width:20%">
                                        <label>@Model.EWRAQualitativeModel[i].RiskType Final</label>
                                    </div>
                                    <div style="width:20%;">
                                        <label>@localizer["Inherent Impact"]</label>
                                        <div class="form-group" style="width:70%;">
                                            @if (@Model.EWRAQualitativeModel[i].InherentImpactAvg == "Low")
                                                    {
                                            <button type="button" id="btnInherentImpactAvg_@i" class="btn btn-success" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentImpactAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentImpactAvg == "Medium")
                                                    {
                                            <button type="button" id="btnInherentImpactAvg_@i" class="btn btn-warning" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentImpactAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentImpactAvg == "High")
                                                    {
                                            <button type="button" id="btnInherentImpactAvg_@i" class="btn btn-danger" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentImpactAvg</button>
                                                    }
                                                    else
                                                    {
                                            <button type="button" id="btnInherentImpactAvg_@i" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>
                                                    }
                                            <input type="hidden" id="hdnInherentImpactAvg_@i" asp-for="@Model.EWRAQualitativeModel[i].InherentImpactAvg" />
                                        </div>
                                    </div>
                                    <div style="width:20%;">
                                        <label>@localizer["Inherent Likelihood"]</label>
                                        <div class="form-group" style="width:70%;">
                                            @if (@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg == "Low")
                                                    {
                                            <button type="button" id="btnInherentLikelihoodAvg_@i" class="btn btn-success" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg == "Medium")
                                                    {
                                            <button type="button" id="btnInherentLikelihoodAvg_@i" class="btn btn-warning" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg == "High")
                                                    {
                                            <button type="button" id="btnInherentLikelihoodAvg_@i" class="btn btn-danger" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg</button>
                                                    }
                                                    else
                                                    {
                                            <button type="button" id="btnInherentLikelihoodAvg_@i" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>
                                                    }
                                            @*<button type="button" id="btnInherentLikelihoodAvg_@i" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>*@
                                            <input type="hidden" id="hdnInherentLikelihoodAvg_@i" asp-for="@Model.EWRAQualitativeModel[i].InherentLikelihoodAvg" />
                                        </div>
                                    </div>
                                    <div style="width:20%;">
                                        <label>@localizer["Inherent Risk Rating"]</label>
                                        <div class="form-group" style="width:70%;">
                                            @if (@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg == "Low")
                                                    {
                                            <button type="button" id="btnInherentRiskRatingAvg_@i" class="btn btn-success" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg == "Medium")
                                                    {
                                            <button type="button" id="btnInherentRiskRatingAvg_@i" class="btn btn-warning" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg == "High")
                                                    {
                                            <button type="button" id="btnInherentRiskRatingAvg_@i" class="btn btn-danger" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg</button>
                                                    }
                                                    else
                                                    {
                                            <button type="button" id="btnInherentRiskRatingAvg_@i" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>
                                                    }
                                            @*<button type="button" id="btnInherentRiskRatingAvg_@i" class="btn btn-block btn-secondary riskscorebtn" style="width:70px;height:40px;">@localizer["Low"]</button>*@
                                            <input type="hidden" id="hdnInherentRiskRatingAvg_@i" asp-for="@Model.EWRAQualitativeModel[i].InherentRiskRatingAvg" />
                                        </div>
                                    </div>
                                    <div style="width:20%;">
                                        <label>@localizer["Inherent Risk Score"]</label>
                                        <div class="form-group" style="width:70%;">
                                            @if (@Model.EWRAQualitativeModel[i].InherentRiskScoreAvg <= 1)
                                                    {
                                            <button type="button" id="btnInherentRiskScoreAvg_@i" class="btn btn-success" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].InherentRiskScoreAvg</button>
                                                    }
                                                    else if (@Model.EWRAQualitativeModel[i].InherentRiskScoreAvg >1 && @Model.EWRAQualitativeModel[i].InherentRiskScoreAvg <= 2)
                                                    {
