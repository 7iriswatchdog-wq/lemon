                                        <div class="form-group" style="width:70%;">
                                            <button type="button" id="btnResidualRiskRating_@i" class="btn btn-danger" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].ResidualRiskRatingAvg</button>
                                            <input type="hidden" id="hdnResidualRiskRating_@i" asp-for="@Model.EWRAQualitativeModel[i].ResidualRiskRatingAvg" />
                                            <input type="hidden" id="hdnResidualRiskRatingType_@i" asp-for="@Model.QDeliveryOverallRisk" />
                                        </div>
                                    </div>
                                    <div style="width:20%;">
                                        <label>@localizer["Residual Risk Score"]</label>
                                        <div class="form-group" style="width:70%;">
                                            <button type="button" id="btnResidualRiskScore_@(i)" class="btn btn-danger" style="width:70px;height:40px;">@Model.EWRAQualitativeModel[i].ResidualRiskScoreAvg</button>
                                            <input type="hidden" id="hdnResidualRiskScore_@i" asp-for="@Model.EWRAQualitativeModel[i].ResidualRiskScoreAvg" />
                                            <input type="hidden" id="hdnResidualRiskScoreType_@i" asp-for="@Model.QDeliveryOverallScore" />
                                        </div>
                                    </div>
                                            }
                                            else
                                            {
                                    <div style="width:20%;">
                                        <label>@localizer["Residual Risk Level"]</label>
                                        <div class="form-group" style="width:70%;">
                                            <button type="button" id="btnResidualRiskRating_@i" class="btn btn-block" style="width:70px;height:40px;">Low</button>
                                            <input type="hidden" id="hdnResidualRiskRating_@i" asp-for="@Model.EWRAQualitativeModel[i].ResidualRiskRatingAvg" />
                                            <input type="hidden" id="hdnResidualRiskRatingType_@i" asp-for="@Model.QDeliveryOverallRisk" />
                                        </div>
                                    </div>
                                    <div style="width:20%;">
                                        <label>@localizer["Residual Risk Score"]</label>
                                        <div class="form-group" style="width:70%;">
                                            <button type="button" id="btnResidualRiskScore_@(i)" class="btn btn-block" style="width:70px;height:40px;">0</button>
                                            <input type="hidden" id="hdnResidualRiskScore_@i" asp-for="@Model.EWRAQualitativeModel[i].ResidualRiskScoreAvg" />
                                            <input type="hidden" id="hdnResidualRiskScoreType_@i" asp-for="@Model.QDeliveryOverallScore" />
                                        </div>
                                    </div>
                                            }
                                </div>
                            </td>
                        </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="row" style="float:right;padding-right:4%;padding:2%;">
                <div>
                    <button type="submit" class="btn btn-primary" onclick="fnSubmit(1,@Model.Id,@Model.QuantitativeId)">@localizer["Save"]</button>
                </div>
            </div>
        </div>
    </div>
    <!--delivery end-->
    <div class="card-footer">
        <button type="submit" class="btn btn-primary" onclick="fnSubmit(2,@Model.Id,@Model.QuantitativeId)">@localizer["Submit"]</button>
        <button type="button" class="btn btn-danger" onclick="location.href='@Url.Action("Assessment", "EWRA" )'">@localizer["Cancel"]</button>
    </div>
