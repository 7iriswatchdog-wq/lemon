        $(".counterDivs").hide();
        $(".jurisdictionDivs").hide();
        $(".deliveryDivs").hide();
        $(".productsAdd").toggle();
        $("#customerMinus").hide();
        $("#counterMinus").hide();
        $("#jurisdictionMinus").hide();
