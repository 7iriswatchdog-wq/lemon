    function residualCalculation(i, j, riskCount, avgSelectedPercentage) {
        var inherentScore = 0;
        var keyScore = 0;
        inherentScore = $('#btnInherentRiskScoreAvg_' + i).text();
        keyScore = $('#btnkeyControlRiskScore_' + i).text();
        var residualRiskScore = 0;
        if (inherentScore == 1 && keyScore == 1) {
            residualRiskScore = 1;
        } else if (inherentScore == 2 && keyScore == 1) {
            residualRiskScore = 1;
        } else if (inherentScore == 3 && keyScore == 1) {
            residualRiskScore = 2;
        } else if (inherentScore == 1 && keyScore == 2) {
            residualRiskScore = 1;
        } else if (inherentScore == 2 && keyScore == 2) {
            residualRiskScore = 2;
        } else if (inherentScore == 3 && keyScore == 2) {
            residualRiskScore = 3;
        } else if (inherentScore == 1 && keyScore == 3) {
            residualRiskScore = 2;
        } else if (inherentScore == 2 && keyScore == 3) {
            residualRiskScore = 3;
        } else if (inherentScore == 3 && keyScore == 3) {
            residualRiskScore = 3;
        } else {
            if (inherentScore == 0 && keyScore != 0) {
                residualRiskScore = keyScore;
            } else if (inherentScore != 0 && keyScore == 0) {
                residualRiskScore = inherentScore;
            } else {
                residualRiskScore = 0;
            }
        }

        $('#btnResidualRiskScore_' + i).text(residualRiskScore);
        $('#hdnResidualRiskScore_' + i).val(residualRiskScore);
        $('#hdnResidualRiskScoreType_' + i).val(residualRiskScore);
        var residualRisk = 'Low';
        if (residualRiskScore == 1) {
            residualRisk = 'Low';
            $('#btnResidualRiskRating_' + i).text(residualRisk);
            $('#hdnResidualRiskRating_' + i).val(residualRisk);
            $('#hdnResidualRiskRatingType_' + i).val(residualRisk);
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-danger");
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-warning");
            $('#btnResidualRiskRating_' + i).addClass("btn btn-success");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-danger");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-warning");
            $('#btnResidualRiskScore_' + i).addClass("btn btn-success");
        } else if (residualRiskScore == 2) {
            residualRisk = 'Medium';
            $('#btnResidualRiskRating_' + i).text(residualRisk);
            $('#hdnResidualRiskRating_' + i).val(residualRisk);
            $('#hdnResidualRiskRatingType_' + i).val(residualRisk);
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-danger");
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-success");
            $('#btnResidualRiskRating_' + i).addClass("btn btn-warning");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-danger");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-success");
            $('#btnResidualRiskScore_' + i).addClass("btn btn-warning");
        } else if (residualRiskScore == 3) {
            residualRisk = 'High';
            $('#btnResidualRiskRating_' + i).text(residualRisk);
            $('#hdnResidualRiskRating_' + i).val(residualRisk);
            $('#hdnResidualRiskRatingType_' + i).val(residualRisk);
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-warning");
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-success");
            $('#btnResidualRiskRating_' + i).addClass("btn btn-danger");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-warning");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-success");
            $('#btnResidualRiskScore_' + i).addClass("btn btn-danger");
        } else {
            residualRisk = 'Low';
            $('#btnResidualRiskRating_' + i).text(residualRisk);
            $('#hdnResidualRiskRating_' + i).val(residualRisk);
            $('#hdnResidualRiskRatingType_' + i).val(residualRisk);
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-warning");
            $('#btnResidualRiskRating_' + i).removeClass("btn btn-danger");
            $('#btnResidualRiskRating_' + i).addClass("btn btn-success");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-warning");
            $('#btnResidualRiskScore_' + i).removeClass("btn btn-danger");
            $('#btnResidualRiskScore_' + i).addClass("btn btn-success");
        }
        calculateOverallScore();
    }
    function calculateOverallScore() {
        var total = 0; 
        var selectedCount = 0;
        for (var i = 0; i < 5; i++) {
            var residRiskScore = Number($('#btnResidualRiskScore_' + i).text());
            if(residRiskScore > 0){
                total += residRiskScore;
                selectedCount++;
            }
        }
        var avg = total / selectedCount;
        $('#btnTotalScore').text(avg.toFixed(2));
        $('#hdnTotalScore').val(avg.toFixed(2));
        if (avg <= 1) {
            $('#btnTotalRiskLevel').text('@localizer["Low"]');
            $('#hdnTotalRiskLevel').val('Low');
            $('#btnTotalRiskLevel').removeClass("btn btn-warning");
            $('#btnTotalRiskLevel').removeClass("btn btn-danger");
            $('#btnTotalRiskLevel').addClass("btn btn-success");

        } else if (avg > 2) {
            $('#btnTotalRiskLevel').text('@localizer["High"]');
            $('#hdnTotalRiskLevel').val('High');
            $('#btnTotalRiskLevel').removeClass("btn btn-warning");
            $('#btnTotalRiskLevel').removeClass("btn btn-success");
            $('#btnTotalRiskLevel').addClass("btn btn-danger");
        } else {
            $('#btnTotalRiskLevel').text('@localizer["Medium"]');
            $('#hdnTotalRiskLevel').val('Medium');
            $('#btnTotalRiskLevel').removeClass("btn btn-danger");
            $('#btnTotalRiskLevel').removeClass("btn btn-success");
            $('#btnTotalRiskLevel').addClass("btn btn-warning");
        }
    }
