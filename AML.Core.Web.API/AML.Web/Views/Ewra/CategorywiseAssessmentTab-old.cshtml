                                                        <input type="hidden" id="hdnResidualImpact_@(i)_@(j)_@(m)" asp-for="@Model.EWRAQualitativeModel[i].EWRARiskModel[j].ResidualRiskModelData[m].SelectedKey" />
                                                    </td>
                                                </tr>
                                                            }
