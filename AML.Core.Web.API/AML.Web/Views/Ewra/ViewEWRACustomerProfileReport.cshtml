                                <tr class="row" style="width:100%;background-color:white">
                                    <th style="vertical-align:middle;width:25% !important;align-items:center;display:flex;">
                                        @localizer["Customer Type"]
                                    </th>
                                    <th style="width:45% !important">
                                        <table style="width:100%">
                                            <tr>
                                                <td colspan="3">
                                                    @localizer["Risk Level Assessed"]
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @localizer["High"]
                                                </td>
                                                <td>
                                                    @localizer["Medium"]
                                                </td>
                                                <td>
                                                    @localizer["Low"]
                                                </td>
                                            </tr>
                                        </table>
                                    </th>
                                    <th style="vertical-align:middle;width:15% !important;align-items:center;display:flex;">
                                        @localizer["Total"]
                                    </th>
                                    <th style="vertical-align:middle;width:15% !important;align-items:center;display:flex;">
                                        @localizer["Risk Score"]
                                    </th>
                                </tr>
                            </thead>
                            @for (var i = 0; i < Model.EWRACustomerCount.Count; i++)
                            {
                                <tr class="row" style="text-align:left !important">
                                    <td style="width:25%;">
                                        @Model.EWRACustomerCount[i].Type
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countHigh_@i" value="@Model.EWRACustomerCount[i].High" placeholder="0" />
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countMedium_@i" value="@Model.EWRACustomerCount[i].Medium" placeholder="0" />
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countLow_@i" value="@Model.EWRACustomerCount[i].Low" placeholder="0" />
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="countTotal_@i" disabled value="@Model.EWRACustomerCount[i].Total" />
                                    </td>
                                    <td style="width:15%">
                                        @*<button id="countRiskScore_@i" disabled class="dt-button-info form-control risk-button" type="button">@Model.EWRACustomerCount[i].RiskScore</button>*@
                                        @if (Convert.ToDouble(@Model.EWRACustomerCount[i].RiskScore) < 1)
                                        {
                                            <button id="volumeRiskScore_@i" disabled class="dt-button-info form-control risk-button btn-success" type="button">@Model.EWRACustomerCount[i].RiskScore</button>
                                        }
                                        else if (Convert.ToDouble(@Model.EWRACustomerCount[i].RiskScore) >= 1 && Convert.ToDouble(@Model.EWRACustomerCount[i].RiskScore) < 2)
                                        {
                                            <button id="volumeRiskScore_@i" disabled class="dt-button-info form-control risk-button btn-warning" type="button">@Model.EWRACustomerCount[i].RiskScore</button>
                                        }
                                        else if (Convert.ToDouble(@Model.EWRACustomerCount[i].RiskScore) >= 2)
                                        {
                                            <button id="volumeRiskScore_@i" disabled class="dt-button-info form-control risk-button btn-danger" type="button">@Model.EWRACustomerCount[i].RiskScore</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="row">
                        <div style="width:100% !important;float:right;padding-right: 1%;">
                            <h3 class="card-title" style="font-weight: bold; text-align: left; width: 30%; float: right;">
                                @localizer["Assessment Score"] :
                                <input type="text" id="countScore" value="@Model.CustCountScore" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" style="width:43%;float:right;" disabled />
                            </h3>
                        </div>
                    </div>
                </div>
                <div id="customerTransaction" class="card card-body">
                    <div class="card card-header" style="width:100%;float:left;background-color:lightgray;">
                        <h3 class="card-title">@localizer["Risk based segregation - Number of transactions"]</h3>
                    </div>
                    <div style="width:100% !important;">
                        <table class="table" id="customerTransactionTable" style="width:100% !important;">
                            <thead style="display:table-header-group;background-color: white;opacity: 100;">
                                <tr class="row" style="width:100%;background-color:white">
                                    <th style="vertical-align:middle;width:25% !important;align-items:center;display:flex;">
                                        @localizer["Customer Type"]
                                    </th>
                                    <th style="width:45% !important">
                                        <table style="width:100%">
                                            <tr>
                                                <td colspan="3">
                                                    @localizer["Risk Level Assessed"]
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @localizer["High"]
                                                </td>
                                                <td>
                                                    @localizer["Medium"]
                                                </td>
                                                <td>
                                                    @localizer["Low"]
                                                </td>
                                            </tr>
                                        </table>
                                    </th>
                                    <th style="vertical-align:middle;width:15% !important;align-items:center;display:flex;">
                                        @localizer["Total"]
                                    </th>
                                    <th style="vertical-align:middle;width:15% !important;align-items:center;display:flex;">
                                        @localizer["Risk Score"]
                                    </th>
                                </tr>
                            </thead>
                            @for (var i = 0; i < Model.EWRACustomerTransaction.Count; i++)
                            {
                                <tr class="row" style="text-align:left !important">
                                    <td style="width:25%;">
                                        @Model.EWRACustomerTransaction[i].Type
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="transactionHigh_@i" value="@Model.EWRACustomerTransaction[i].High" placeholder="0" />
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="transactionMedium_@i" value="@Model.EWRACustomerTransaction[i].Medium" placeholder="0" />
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="transactionLow_@i" value="@Model.EWRACustomerTransaction[i].Low" placeholder="0" />
                                    </td>
                                    <td style="width:15%">
                                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="transactionTotal_@i" disabled value="@Model.EWRACustomerTransaction[i].Total" />
                                    </td>
                                    <td style="width:15%">
                                        @*<button id="transactionRiskScore_@i" disabled class="dt-button-info form-control risk-button" type="button">@Model.EWRACustomerTransaction[i].RiskScore</button>*@
                                        @if (Convert.ToDouble(@Model.EWRACustomerTransaction[i].RiskScore) < 1)
                                        {
                                            <button id="volumeRiskScore_@i" disabled class="dt-button-info form-control risk-button btn-success" type="button">@Model.EWRACustomerTransaction[i].RiskScore</button>
                                        }
                                        else if (Convert.ToDouble(@Model.EWRACustomerTransaction[i].RiskScore) >= 1 && Convert.ToDouble(@Model.EWRACustomerTransaction[i].RiskScore) < 2)
                                        {
                                            <button id="volumeRiskScore_@i" disabled class="dt-button-info form-control risk-button btn-warning" type="button">@Model.EWRACustomerTransaction[i].RiskScore</button>
                                        }
                                        else if (Convert.ToDouble(@Model.EWRACustomerTransaction[i].RiskScore) >= 2)
                                        {
                                            <button id="volumeRiskScore_@i" disabled class="dt-button-info form-control risk-button btn-danger" type="button">@Model.EWRACustomerTransaction[i].RiskScore</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="row">
                        <div style="width:100% !important;float:right;padding-right: 1%;">
                            <h3 class="card-title" style="font-weight: bold; text-align: left; width: 30%; float: right;">
                                @localizer["Assessment Score"] :
                                <input type="text" id="transactionScore" value="@Model.CustTransactionScore" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" style="width:43%;float:right;" disabled />
                            </h3>
                        </div>
                    </div>
                </div>


            </div>
        </div>
        <div class="row" style="width:98%;">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="dtCreatedBy">@localizer["Created By"]</label>
                    <input type="text" asp-for="@Model.CreatedBy" class="form-control mandatory" id="dtCreatedBy" placeholder="" maxlength="200" readonly>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="dtCreatedOn">@localizer["Created On"]</label>
                    <input type="text" asp-for="@Model.CreatedOn" class="form-control mandatory" id="dtCreatedOn" placeholder="" maxlength="200" readonly>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div style="width:90%;display:none;padding-left:2%;" id="footdiv">
        <p>@localizer["Computer generated report; hence no signature is required."]</p>
    </div>
</div>
<script type="text/javascript">
    function printdiv(printpage) {
        var headstr1 = "<html><head>";
        var headstr2 = "<title></title></head><body class='printDiv'>";
        var footstr = "</body>";
        var newstr = document.all.item(printpage).innerHTML;
        var oldstr = document.body.innerHTML;
        document.body.innerHTML = headstr1 + headstr2 + newstr + footstr;
        document.getElementById("logodiv").style.display = "";
        document.getElementById("footdiv").style.display = "";
        document.getElementById("b_print").style.display = "none";
        window.print();
        document.body.innerHTML = oldstr;
        return false;
    }
</script>
