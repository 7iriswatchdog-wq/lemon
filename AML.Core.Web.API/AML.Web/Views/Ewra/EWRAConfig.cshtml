<style>
    #availabledivCounterparty {
        border-collapse: separate !important;
        border-spacing: 0 10px !important; /* Adjust 10px for more/less space */
    }

    thead {
        text-align: center;
    }

    td {
        text-align: center;
    }

    .no-js #loader {
        display: none;
    }

    .js #loader {
        display: block;
        position: absolute;
        left: 100px;
        top: 0;
    }

    /*    .se-pre-con {
                position: fixed;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                z-index: 9999;
                background: url(/img/loader1.gif) center no-repeat #fff;
                opacity: 0.8
            }*/

    table.dataTable.nowrap th, table.dataTable.nowrap td {
        background: none;
    }

    #divRiskAspect {
        display: block !important;
    }

    .nav-tabs {
        border-bottom: 3px solid #007bff;
    }

    a.nav-link.active {
        background-color: #007afd !important;
        color: #fff !important;
    }

    .select2-container .select2-selection--single {
        height: auto !important;
        padding: 0.5rem 0.75rem !important;
        border-radius: 0.375rem !important;
        font-weight: 200 !important;
        border-color: #D1D5DB !important;
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        top: 50% !important;
        right: 6px !important; /* Move it slightly left */
        transform: translateY(-50%);
        position: absolute;
        width: 24px;
        height: 24px;
    }

        .select2-container--default .select2-selection--single .select2-selection__arrow b {
            display: inline-block !important;
            width: 8px !important; /* Bigger width */
            height: 8px !important; /* Bigger height */
            border: solid #6b7280 !important;
            border-width: 0 2px 2px 0 !important;
            transform: rotate(45deg) !important;
            margin-left: -4px !important;
            margin-top: -4px !important;
            transition: transform 0.2s ease !important;
        }

    .select2-container {
        width: 100% !important; /* Adjust this to your desired width (e.g., 300px or 50%) */
        max-width: 350px; /* Optional: Set a max width */
    }

        .select2-container .select2-selection--single {
            height: 42px !important; /* Decrease height */
            padding: 0.25rem 0.5rem !important; /* Adjust vertical/horizontal padding */
            font-size: 14px !important;
            border-radius: 0.375rem !important;
        }

    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }

    th.sortable {
        position: relative;
        padding-right: 20px;
        cursor: pointer;
    }

        /* Show vertical gray arrows by default */
        th.sortable::after {
            content: '▲\A▼';
            white-space: pre; /* respect \A (newline) */
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            color: #bbb;
            line-height: 1;
            text-align: center;
        }

        /* Only ▲ when sorting ascending */
        th.sortable.active.asc::after {
            content: '▲';
            color: #000;
        }

        /* Only ▼ when sorting descending */
        th.sortable.active.desc::after {
            content: '\A▼';
            color: #000;
        }
</style>
