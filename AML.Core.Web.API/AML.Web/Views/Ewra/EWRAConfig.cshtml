        document.addEventListener('DOMContentLoaded', function () {
        const table = document.getElementById('availableCustomerType');
        const headers = table.querySelectorAll('th.sortable');
        let sortDirection = 1;
        let activeColumn = null;

        headers.forEach(header => {
            header.addEventListener('click', function () {
                const columnIndex = parseInt(this.dataset.column);

                // Reset previous sort classes
                headers.forEach(h => h.classList.remove('active', 'asc', 'desc'));

                // Toggle direction if clicking same column
                if (activeColumn === columnIndex) {
                    sortDirection *= -1;
                } else {
                    sortDirection = 1;
                    activeColumn = columnIndex;
                }

                // Apply new sort class
                this.classList.add('active');
                this.classList.add(sortDirection === 1 ? 'asc' : 'desc');

                // Show loader
                $('#customerLoading').removeClass('hidden');

                // Add a small delay so loader appears
                setTimeout(() => {
                    sortTable(columnIndex);
                    paginateCustomerTable(); // your pagination function if exists

                    // Hide loader after sort
                    $('#customerLoading').addClass('hidden');
                }, 300); // Delay for smooth UX
            });
        });

        function sortTable(columnIndex) {
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.sort((a, b) => {
                const cellA = a.children[columnIndex].querySelector('input')?.value?.toLowerCase() || '';
                const cellB = b.children[columnIndex].querySelector('input')?.value?.toLowerCase() || '';

                if (cellA < cellB) return -1 * sortDirection;
                if (cellA > cellB) return 1 * sortDirection;
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        const table = document.getElementById('availabledivCounterparty');
        const headers = table.querySelectorAll('th.sortable');
        let sortDirection = 1;
        let activeColumn = null;

        headers.forEach(header => {
            header.addEventListener('click', function () {
                const columnIndex = parseInt(this.dataset.column);

                // Reset sort state
                headers.forEach(h => h.classList.remove('active', 'asc', 'desc'));

                // Toggle sort direction
                if (activeColumn === columnIndex) {
                    sortDirection *= -1;
                } else {
                    sortDirection = 1;
                    activeColumn = columnIndex;
                }

                this.classList.add('active');
                this.classList.add(sortDirection === 1 ? 'asc' : 'desc');

                // Show loader
                $('#counterpartyLoading').removeClass('hidden');

                setTimeout(() => {
                    sortCounterpartyTable(columnIndex);
                    paginateCounterpartyTable();
                    $('#counterpartyLoading').addClass('hidden');
                }, 300);
            });
        });

        function sortCounterpartyTable(columnIndex) {
            const tbody = table.querySelector('tbody') || table;
            const rows = Array.from(tbody.querySelectorAll('tr.counterparty-row'));

            rows.sort((a, b) => {
                let cellA, cellB;

                if (columnIndex === 0 || columnIndex === 1) {
                    // Text columns: Counterparty and Country
                    cellA = a.children[columnIndex].querySelector('input, select')?.value?.toLowerCase() || '';
                    cellB = b.children[columnIndex].querySelector('input, select')?.value?.toLowerCase() || '';
                } else if (columnIndex === 2) {
                    // Checkbox column: Active Y/N
                    cellA = a.children[columnIndex].querySelector('input[type="checkbox"]')?.checked ? 1 : 0;
                    cellB = b.children[columnIndex].querySelector('input[type="checkbox"]')?.checked ? 1 : 0;
                }

                if (cellA < cellB) return -1 * sortDirection;
                if (cellA > cellB) return 1 * sortDirection;
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    });
