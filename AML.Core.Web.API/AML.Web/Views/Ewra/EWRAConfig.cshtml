<script>
    document.addEventListener("DOMContentLoaded", function () {
        // === MAIN TAB SWITCHING ===
        const mainTabs = ['#quantitative', '#qualitative'];

        mainTabs.forEach(selector => {
            document.querySelector(`a[href="${selector}"]`)?.addEventListener("click", function (e) {
                e.preventDefault();

                // Hide all main tab panes
                mainTabs.forEach(id => {
                    const pane = document.querySelector(id);
                    if (pane) pane.classList.add("hidden");
                });

                // Show the clicked pane
                const targetId = this.getAttribute("href");
                document.querySelector(targetId)?.classList.remove("hidden");

                // Toggle main tab styles
                mainTabs.forEach(s => {
                    const tab = document.querySelector(`a[href="${s}"]`);
                    tab?.classList.remove("border-b-2", "border-blue-600", "text-black", "font-normal");
                    tab?.classList.add("text-[#64748B]", "font-extralight");
                });

                this.classList.remove("text-[#64748B]", "font-extralight");
                this.classList.add("border-b-2", "border-blue-600", "text-black", "font-normal");
            });
        });

        // === SUB-TAB SWITCHING INSIDE #qualitative ===
        const subTabLinks = document.querySelectorAll('#subTab1 a[role="tab"]');

        subTabLinks.forEach(link => {
            link.addEventListener("click", function (e) {
                e.preventDefault();

                const targetId = this.getAttribute("href").substring(1);
                const targetPane = document.getElementById(targetId);
                if (!targetPane) return;

                // Reset all tab links to inactive styles
                subTabLinks.forEach(tab => {
                    tab.classList.remove('border-b-2', 'border-blue-600', 'text-black', 'font-normal', 'text-md');
                    tab.classList.add('text-[#64748B]', 'font-extralight');
                });

                // Activate the clicked tab
                this.classList.remove('text-[#64748B]', 'font-extralight');
                this.classList.add('border-b-2', 'border-blue-600', 'text-black', 'font-normal', 'text-md');
            });
        });

        const riskTabs = ['#description', '#inherent', '#key', '#residual'];

        riskTabs.forEach(selector => {
            document.querySelector(`a[href="${selector}"]`)?.addEventListener("click", function (e) {
                e.preventDefault();

                // Hide all tab panes
                riskTabs.forEach(id => {
                    document.querySelector(id)?.classList.add("hidden");
                });

                // Show selected tab pane
                const targetId = this.getAttribute("href");
                document.querySelector(targetId)?.classList.remove("hidden");

                // Reset all tab styles
                riskTabs.forEach(s => {
                    const tab = document.querySelector(`a[href="${s}"]`);
                    tab?.classList.remove("border-b-2", "border-blue-600", "text-black", "font-normal");
                    tab?.classList.add("text-[#64748B]", "font-extralight");
                });

                // Highlight active tab
                this.classList.remove("text-[#64748B]", "font-extralight");
                this.classList.add("border-b-2", "border-blue-600", "text-black", "font-normal");
            });
        });
    });
</script>



