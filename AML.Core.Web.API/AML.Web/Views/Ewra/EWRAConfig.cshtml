        let residualCurrentPage = 1;
        let residualPageSize = parseInt($('#rowsPerPageResidual').val()) || 10;
        let residualTotalPages = 1;
        let sortColumnResidual = "ResidualRiskDescription";  // Must match your DTO property
        let sortDirectionResidual = "asc";
        function getColumnIndexResidual(columnName) {
            const columns = ["ResidualRiskDescription"];
            return columns.indexOf(columnName);
        }
        function LoadResidualTable(page = 1) {
            const riskTypeID = $('#ddlRiskType').val();
            const searchQueryresidual = $('#residualSearchBox').val()?.trim() || '';
            residualPageSize = parseInt($('#rowsPerPageResidual').val()) || 10;
            const start = (page - 1) * residualPageSize;

            $.ajax({
                url: '/ewra/CustomPaginationResidual',
                type: 'POST',
                dataType: 'json',
                data: {
                    riskTypeID: riskTypeID,
                    start: start,
                    search: { value: searchQueryresidual },
                    length: residualPageSize,
                    order: [{ column: getColumnIndexResidual(sortColumnResidual), dir: sortDirectionResidual }],
                    columns: [{ data: "ResidualRiskDescription" }]
                },
                beforeSend: function () {
                    //$(".se-pre-con").show();
                    //$(".card-header").fadeOut();
                },
                success: function (resp) {
                    //$(".se-pre-con").hide();
                    const data = resp.data || [];
                    const total = resp.recordsFiltered || 0;

                    residualTotalPages = Math.ceil(total / residualPageSize);
                    renderResidualTable(data);
                    renderResidualPager(page);
                    $('#residualLoading').addClass('hidden');
                    hideLoader();
                },
                error: function (err) {
                    //$(".se-pre-con").hide();
                    console.error("Failed to load residual risk data", err);
                    hideLoader();
                }
            });
        }

        function renderResidualTable(data) {
            const $tbody = $('#availableResidual tbody');
            $tbody.empty();

            if (!data.length) {
                $tbody.append('<tr><td colspan="2" class="text-center">No data available</td></tr>');
                return;
            }

            data.forEach((item, index) => {
                const isChecked = item.isActive === 1 ? 'checked' : '';
                const row = `
                <tr><td colspan="2" style="height: 8px; border: none;"></td></tr> <!-- spacer row -->
            <tr>
                <td>
                    <textarea rows="2" style="width:100%;" maxlength="500"
                        name="EWRAQualitativeConfigModel[0].AvailableResidualRisk[${index}].ResidualRiskDescription">${item.residualRiskDescription}</textarea>
                    <input type="hidden"
                        name="EWRAQualitativeConfigModel[0].AvailableResidualRisk[${index}].ResidualRiskId"
                        value="${item.residualRiskId}" />
                </td>
                <td>
                    <input type="checkbox" onchange="ChangeStatusresidual(${index}, this, 5);" ${isChecked} />
                    <input type="hidden"
                        id="EWRAQualitativeConfigModel_0_AvailableResidualRisk_${index}_IsActive"
                        name="EWRAQualitativeConfigModel[0].AvailableResidualRisk[${index}].IsActive"
                        value="${item.isActive}" />
                </td>
            </tr>
            `;
                $tbody.append(row);
            });
        }
        function ChangeStatusresidual(index, checkbox, mode) {
            const hiddenInput = $(`#EWRAQualitativeConfigModel_0_AvailableResidualRisk_${index}_IsActive`);
            hiddenInput.val(checkbox.checked ? 1 : 0);
        }
        function renderResidualPager(page) {
            const $pager = $('.residual-pagination-controls');
            $pager.empty();

            if (residualTotalPages <= 1) return;

            const createBtn = (label, p, disabled = false, active = false) =>
                `<button type="button" class="px-3 py-1 border rounded
            ${active ? 'bg-primary text-white' : 'bg-surface text-primary'}
            ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
            data-page="${p}" ${disabled ? 'disabled' : ''}>${label}</button>`;

            $pager.append(createBtn('First', 1, page === 1));
            $pager.append(createBtn('Prev', page - 1, page === 1));

            for (let i = Math.max(1, page - 2); i <= Math.min(residualTotalPages, page + 2); i++) {
                $pager.append(createBtn(i, i, false, i === page));
            }

            $pager.append(createBtn('Next', page + 1, page === residualTotalPages));
            $pager.append(createBtn('Last', residualTotalPages, page === residualTotalPages));
        }

        // Pagination click handler
        $(document).on('click', '.residual-pagination-controls button', function () {
            const pg = parseInt($(this).data('page'));
            if (!isNaN(pg)) {
                residualCurrentPage = pg;
                $('#residualLoading').removeClass('hidden');
                LoadResidualTable(pg);
            }
        });

        // Rows per page change
        $('#rowsPerPageResidual').on('change', function () {
            residualCurrentPage = 1;
            residualPageSize = parseInt($(this).val()) || 10;
            showLoader();
            LoadResidualTable(residualCurrentPage);
        });

        $('#residualSearchBox').on('keyup', function () {
            residualCurrentPage = 1;
            $('#residualLoading').removeClass('hidden');
            LoadResidualTable(residualCurrentPage);
        });
        $('#availableResidual thead').on('click', 'th.sortable', function () {
            const selectedColumn = $(this).data('column');

            if (sortColumnResidual === selectedColumn) {
                sortDirectionResidual = sortDirectionResidual === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumnResidual = selectedColumn;
                sortDirectionResidual = 'asc';
            }

            // Update visual indicators
            $('#availableResidual thead th.sortable').removeClass('active asc desc');
            $(this).addClass(`active ${sortDirectionResidual}`);

            residualCurrentPage = 1;
            $('#residualLoading').removeClass('hidden');
            LoadResidualTable(residualCurrentPage);
        });

