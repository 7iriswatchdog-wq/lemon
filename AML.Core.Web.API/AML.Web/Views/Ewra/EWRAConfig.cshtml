                function ChangeStatus(index, that, mode) {
                    var status = 0;
                    if ($(that).prop("checked")) {
                        status = 1;
                    }
                    if (mode == 1) {
                        $('#EWRAQuantitativeConfigModel_0_AvailableCustomerType_' + index + '_isActive').val(status);
