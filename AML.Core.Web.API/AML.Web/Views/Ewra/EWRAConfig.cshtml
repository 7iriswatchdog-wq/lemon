        function paginateCustomerTable() {
            setTimeout(() => {
            const allRows = Array.from(document.querySelectorAll('.customer-row'));
            const searchQuery = document.getElementById('customerSearchBox').value.toLowerCase();

            const filteredRows = allRows.filter(row => {
                const tds = row.querySelectorAll('td');
                let rowText = '';
                for (let td of tds) {
                    const input = td.querySelector('input');
                    if (input) {
                        rowText += input.value || '';
                    } else {
                        rowText += td.textContent;
                    }
                }
                return rowText.toLowerCase().includes(searchQuery);
            });

            const totalPages = Math.ceil(filteredRows.length / rowsPerPageCustomer);

            allRows.forEach(row => row.style.display = 'none');

            filteredRows.forEach((row, index) => {
                row.style.display = (index >= (currentCustomerPage - 1) * rowsPerPageCustomer &&
                    index < currentCustomerPage * rowsPerPageCustomer)
                    ? '' : 'none';
            });

                renderCustomerPagination(totalPages);
                $('#customerLoading').addClass('hidden');
            hideLoader();
        }, 300);
        }

        function renderCustomerPagination(totalPages) {
            const pager = document.getElementById('customerPagination');
            pager.innerHTML = '';

            if (totalPages <= 1) return;

            const createBtn = (label, page, disabled = false, active = false) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = label;
                btn.className = `px-3 py-1 border rounded ${active ? 'bg-primary text-white' : 'bg-surface text-primary'} ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}`;
                btn.disabled = disabled;
                btn.dataset.page = page;
                return btn;
            };

            pager.appendChild(createBtn('First', 1, currentCustomerPage === 1));
            pager.appendChild(createBtn('Prev', currentCustomerPage - 1, currentCustomerPage === 1));

            const maxVisible = 5;
            let start = Math.max(1, currentCustomerPage - Math.floor(maxVisible / 2));
            let end = Math.min(totalPages, start + maxVisible - 1);
            if (end - start < maxVisible - 1) {
                start = Math.max(1, end - maxVisible + 1);
            }

            for (let i = start; i <= end; i++) {
                const btn = createBtn(i, i, false, i === currentCustomerPage);
                pager.appendChild(btn);
            }

            pager.appendChild(createBtn('Next', currentCustomerPage + 1, currentCustomerPage === totalPages));
            pager.appendChild(createBtn('Last', totalPages, currentCustomerPage === totalPages));

            pager.querySelectorAll('button').forEach(btn => {
                btn.addEventListener('click', () => {
                    currentCustomerPage = parseInt(btn.dataset.page);
                    $('#customerLoading').removeClass('hidden');
                    paginateCustomerTable();
                });
            });
        }
