                        ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
                    data-page="${p}" ${disabled ? 'disabled' : ''}>${label}</button>`;

            $pager.append(createBtn('First', 1, page === 1));
            $pager.append(createBtn('Prev', page - 1, page === 1));

            for (let i = Math.max(1, page - 2); i <= Math.min(riskDescTotalPages, page + 2); i++) {
