@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
}
@model AML.DTO.DTO.EWRA.EWRAModelDTO
<style>
    #table-scroll {
        overflow: scroll;
        margin-top: 20px;
    }

    .table {
        width: 150%;
    }

    #FraudTable {
        width: 120%;
        margin-left: 1.8px;
        overflow: scroll;
    }

    .table td, .table th {
        padding: .65rem;
    }

    table, th {
        text-align: center;
    }

    td {
        vertical-align: bottom;
        text-align: left !important;
    }

    .form-control {
        width: 100%;
    }
</style>
@*<div style="width:100% !important;height:70px !important;">

    </div>*@
<div id="printDetails" style="width:100%">
    <br />
    <div style="width:100%;display:none" id="logodiv">
        <div style="width:98%;text-align:center;">
            <h2>@companyName</h2>
            <img src="~/img/logo.png" style="width:8%;float:right;" />
        </div>
        <br />
    </div>
    <br />
    <div class="card-primary" id="reportViewDetails" style="width:100%;padding-left:1%;">
        <div class="row" style="width:100%;padding-left:1%;">
            <h3 style="width:90%">EWRA Report Of @companyName</h3>
            <input name="b_print" id="b_print" type="button" onClick="printdiv('printDetails');" value=" Print " style="float:right;margin:20px;width:50px;"><br />
        </div>
        <div id="products" class="card card-body" style="padding-bottom:0px;padding-top:10px;">
            <div class="card card-header" style="width:100%;float:left;background-color: darkgrey;">
                <h3 class="card-title">
                    @localizer["Products And Services Risk"]
                </h3>
            </div>
            <div class="card-footer row">
                <div style="width:50%;">
                    <label>@localizer["Overall Average Score"]</label>
                    <div class="form-group" style="width:70%;">
                        <button id="btnProductAvgScore" disabled class="dt-button-info form-control risk-button" type="button">@Model.ProductOverallScore</button>
                        <input type="hidden" id="hdnProductAvgScore" asp-for="@Model.ProductOverallScore" value="0" />
                    </div>
                </div>
                <div style="width:50%;float:right">
                    <label>@localizer["Overall Risk Assessement Level"]</label>
                    <div class="form-group" style="width:70%;">
                        @if (@Model.ProductOverallRisk == "Low")
                        {
                            <button id="btnCustomerRiskLevel" disabled class="dt-button-info form-control risk-button btn-success" type="button">@Model.ProductOverallRisk</button>
                        }
                        else if (@Model.ProductOverallRisk == "Medium")
                        {
                            <button id="btnCustomerRiskLevel" disabled class="dt-button-info form-control risk-button btn-warning" type="button">@Model.ProductOverallRisk</button>
                        }
                        else if (@Model.ProductOverallRisk == "High")
                        {
                            <button id="btnCustomerRiskLevel" disabled class="dt-button-info form-control risk-button btn-danger" type="button">@Model.ProductOverallRisk</button>
                        }
                        else
                        {
                            <button id="btnCustomerRiskLevel" disabled class="dt-button-info form-control risk-button" type="button">@Model.ProductOverallRisk</button>
                        }
                    </div>
                </div>
            </div>
            <br />
            <div id="productRisk" class="card card-body productsDivs">
                <div style="width:100% !important;">
                    <table class="table" id="productsTable" style="width:100% !important;">
                        <thead style="display:table-header-group;position: sticky;top: 0;background-color: white;opacity: 100;">
                            <tr class="row" style="width:100%;background-color:white">
                                <th style="vertical-align:middle;width:25% !important;align-items:center;display:flex;">
                                    @localizer["Product"]
                                </th>
                                <th style="width:45% !important">
                                    <table style="width:100%">
                                        <tr>
                                            <td colspan="3">
                                                @localizer["Customer Risk Level Assessed"]
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                @localizer["High"]
                                            </td>
                                            <td>
                                                @localizer["Medium"]
                                            </td>
                                            <td>
                                                @localizer["Low"]
                                            </td>
                                        </tr>
                                    </table>
                                </th>
                                <th style="vertical-align:middle;width:15% !important;align-items:center;display:flex;">
                                    @localizer["Total"]
                                </th>
                                <th style="vertical-align:middle;width:15% !important;align-items:center;display:flex;">
                                    @localizer["Risk Score"]
                                </th>
                            </tr>
                        </thead>
                        @{
                            int a = 0;
                        }
                        <tr class="row" style="text-align:left !important">
                            <td style="width:100%;" class="row">
                                <table class=" subcategory" id="RiskSubTable" style="width:100%;">
                                    <tbody>
                                        @for (var j = 0; j < Model.EWRAProductList.Count; j++)
                                        {
                                            <tr>
                                                <td style="width: 25%;">
                                                    @Model.EWRAProductList[j].Product
                                                </td>
                                                <td style="width:15%">
                                                    <input type="text" class="form-control" id="productHigh_@a" value="@Model.EWRAProductList[j].High" disabled placeholder="0" />
                                                </td>
                                                <td style="width:15%">
                                                    <input type="text" class="form-control" id="productMedium_@a" value="@Model.EWRAProductList[j].Medium" disabled placeholder="0" />
                                                </td>
                                                <td style="width:15%">
                                                    <input type="text" class="form-control" id="productLow_@a" value="@Model.EWRAProductList[j].Low" disabled placeholder="0" />
                                                </td>
                                                <td style="width:15%">
                                                    <input type="text" class="form-control" id="productTotal_@a" disabled value="@Model.EWRAProductList[j].Total" />
                                                </td>
                                                <td style="width:15%">
                                                    @if (Convert.ToDouble(@Model.EWRAProductList[j].RiskScore) <= 1)
                                                    {
                                                        <button id="productRiskScore_@a" disabled class="dt-button-info form-control risk-button btn-success" type="button">@Model.EWRAProductList[j].RiskScore</button>
                                                    }
                                                    else if (Convert.ToDouble(@Model.EWRAProductList[j].RiskScore) > 1 && Convert.ToDouble(@Model.EWRAProductList[j].RiskScore) <= 2)
                                                    {
                                                        <button id="productRiskScore_@a" disabled class="dt-button-info form-control risk-button btn-warning" type="button">@Model.EWRAProductList[j].RiskScore</button>
                                                    }
                                                    else if (Convert.ToDouble(@Model.EWRAProductList[j].RiskScore) > 2)
                                                    {
                                                        <button id="productRiskScore_@a" disabled class="dt-button-info form-control risk-button btn-danger" type="button">@Model.EWRAProductList[j].RiskScore</button>
                                                    }
                                                </td>
                                            </tr>
                                            a = a + 1;
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>

            </div>
        </div>
        <div class="row" style="width:98%;">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="dtCreatedBy">@localizer["Created By"]</label>
                    <input type="text" asp-for="@Model.CreatedBy" class="form-control mandatory" id="dtCreatedBy" placeholder="" maxlength="200" readonly>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="dtCreatedOn">@localizer["Created On"]</label>
                    <input type="text" asp-for="@Model.CreatedOn" class="form-control mandatory" id="dtCreatedOn" placeholder="" maxlength="200" readonly>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div style="width:90%;display:none;padding-left:2%;" id="footdiv">
        <p>@localizer["Computer generated report; hence no signature is required."]</p>
    </div>
</div>
<script type="text/javascript">
    function printdiv(printpage) {
        var headstr1 = "<html><head>";
        var headstr2 = "<title></title></head><body class='printDiv'>";
        var footstr = "</body>";
        var newstr = document.all.item(printpage).innerHTML;
        var oldstr = document.body.innerHTML;
        document.body.innerHTML = headstr1 + headstr2 + newstr + footstr;
        document.getElementById("logodiv").style.display = "";
        document.getElementById("footdiv").style.display = "";
        document.getElementById("b_print").style.display = "none";
        window.print();
        document.body.innerHTML = oldstr;
        return false;
    }
</script>
