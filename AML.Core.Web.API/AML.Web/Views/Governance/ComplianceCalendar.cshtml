@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Compliance Calendar — Searchin Governance"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-gov-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#0d9488,#14b8a6);color:#fff}
.si-cal-layout{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-bottom:24px}
.si-cal-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}
.si-cal-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #f1f5f9}
.si-cal-nav{display:flex;align-items:center;gap:8px}
.si-cal-nav button{width:32px;height:32px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center}
.si-cal-month{font-size:15px;font-weight:700;color:#0f172a}
.si-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);padding:12px}
.si-cal-day-header{text-align:center;font-size:11px;font-weight:700;color:#94a3b8;padding:8px;text-transform:uppercase}
.si-cal-day{text-align:center;padding:8px;cursor:pointer;border-radius:8px;transition:all .15s;position:relative}
.si-cal-day:hover{background:#f1f5f9}
.si-cal-day.today{background:#eef2ff;font-weight:700;color:#6366f1}
.si-cal-day.has-event::after{content:'';position:absolute;bottom:4px;left:50%;transform:translateX(-50%);width:6px;height:6px;border-radius:50%;background:var(--event-color,#6366f1)}
.si-cal-day .day-num{font-size:13px;font-weight:600;color:#334155}
.si-cal-day.other-month .day-num{color:#cbd5e1}
.si-sidebar-title{font-size:14px;font-weight:700;color:#0f172a;padding:16px 20px;border-bottom:1px solid #f1f5f9}
.si-event-list{padding:12px;max-height:500px;overflow-y:auto}
.si-event-item{padding:12px 14px;border-radius:10px;margin-bottom:8px;border-left:4px solid var(--ev-color,#6366f1);background:#fafbfc;transition:all .15s;cursor:default}
.si-event-item:hover{background:#f1f5f9}
.si-event-item-title{font-size:13px;font-weight:600;color:#0f172a;margin-bottom:4px}
.si-event-item-date{font-size:11px;color:#64748b;display:flex;align-items:center;gap:4px}
.si-event-item-category{display:inline-flex;padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700;margin-top:4px}
.cat-regulatory{background:#fee2e2;color:#991b1b}.cat-internal{background:#e0e7ff;color:#3730a3}.cat-sanctions{background:#fef3c7;color:#92400e}.cat-training{background:#d1fae5;color:#065f46}
.si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}.si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}.si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}.si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}
@@media(max-width:1024px){.si-cal-layout{grid-template-columns:1fr}}@@media(max-width:768px){.si-kpi-row{grid-template-columns:repeat(2,1fr)}}</style>
<div class="si-page" x-data="complianceCalendar()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Compliance Calendar</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/Governance">Governance</a> / Compliance Calendar</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-gov-badge"><i class="fa-solid fa-gavel"></i> Governance</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#6366f1;--kpi-bg:#eef2ff"><div class="si-kpi-icon"><i class="fa-solid fa-calendar"></i></div><div class="si-kpi-value" x-text="events.length"></div><div class="si-kpi-label">Total Events</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-clock"></i></div><div class="si-kpi-value" x-text="upcoming"></div><div class="si-kpi-label">Due This Month</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-circle-check"></i></div><div class="si-kpi-value" x-text="completed"></div><div class="si-kpi-label">Completed</div></div>
            <div class="si-kpi" style="--kpi-color:#f59e0b;--kpi-bg:#fef3c7"><div class="si-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div><div class="si-kpi-value" x-text="overdue"></div><div class="si-kpi-label">Overdue</div></div>
        </div>
        <div class="si-cal-layout">
            <div class="si-cal-card">
                <div class="si-cal-header">
                    <div class="si-cal-nav"><button @@click="prevMonth()"><i class="fa-solid fa-chevron-left"></i></button><div class="si-cal-month" x-text="monthLabel"></div><button @@click="nextMonth()"><i class="fa-solid fa-chevron-right"></i></button></div>
                </div>
                <div class="si-cal-grid">
                    <template x-for="d in ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']"><div class="si-cal-day-header" x-text="d"></div></template>
                    <template x-for="day in calDays" :key="day.key">
                        <div class="si-cal-day" :class="{'today':day.isToday,'has-event':day.hasEvent,'other-month':!day.inMonth}" :style="day.eventColor?'--event-color:'+day.eventColor:''">
                            <div class="day-num" x-text="day.num"></div>
                        </div>
                    </template>
                </div>
            </div>
            <div class="si-cal-card">
                <div class="si-sidebar-title">Upcoming Deadlines</div>
                <div class="si-event-list">
                    <template x-for="ev in events" :key="ev.id">
                        <div class="si-event-item" :style="'--ev-color:'+ev.color">
                            <div class="si-event-item-title" x-text="ev.title"></div>
                            <div class="si-event-item-date"><i class="fa-regular fa-calendar"></i> <span x-text="ev.date"></span></div>
                            <div class="si-event-item-category" :class="'cat-'+ev.category" x-text="ev.categoryLabel"></div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function complianceCalendar(){return{currentMonth:new Date().getMonth(),currentYear:new Date().getFullYear(),
events:[
{id:1,title:'CBUAE AML/CFT Return Filing',date:'31 Mar 2026',category:'regulatory',categoryLabel:'Regulatory',color:'#ef4444'},
{id:2,title:'Sanctions List Update Review',date:'25 Mar 2026',category:'sanctions',categoryLabel:'Sanctions',color:'#f59e0b'},
{id:3,title:'Q1 Risk Assessment Report',date:'20 Mar 2026',category:'internal',categoryLabel:'Internal',color:'#6366f1'},
{id:4,title:'AML Training – New Staff',date:'18 Mar 2026',category:'training',categoryLabel:'Training',color:'#22c55e'},
{id:5,title:'Board Compliance Report',date:'15 Apr 2026',category:'regulatory',categoryLabel:'Regulatory',color:'#ef4444'},
{id:6,title:'Annual KYC Refresh Deadline',date:'30 Apr 2026',category:'internal',categoryLabel:'Internal',color:'#6366f1'},
{id:7,title:'goAML System Reconciliation',date:'10 Apr 2026',category:'regulatory',categoryLabel:'Regulatory',color:'#ef4444'},
{id:8,title:'Sanctions Screening Validation',date:'05 Apr 2026',category:'sanctions',categoryLabel:'Sanctions',color:'#f59e0b'}],
upcoming:4,completed:12,overdue:1,
get monthLabel(){return new Date(this.currentYear,this.currentMonth).toLocaleDateString('en-US',{month:'long',year:'numeric'})},
get calDays(){const d=[];const first=new Date(this.currentYear,this.currentMonth,1);const last=new Date(this.currentYear,this.currentMonth+1,0);const startDay=first.getDay();const today=new Date();
for(let i=startDay-1;i>=0;i--){const pd=new Date(this.currentYear,this.currentMonth,-i);d.push({key:'p'+i,num:pd.getDate(),inMonth:false,isToday:false,hasEvent:false,eventColor:null})}
for(let i=1;i<=last.getDate();i++){const isToday=i===today.getDate()&&this.currentMonth===today.getMonth()&&this.currentYear===today.getFullYear();
d.push({key:'c'+i,num:i,inMonth:true,isToday,hasEvent:i%7===0||i===15||i===20||i===25||i===31,eventColor:i===31?'#ef4444':i===25?'#f59e0b':i===20?'#6366f1':'#22c55e'})}
const remain=42-d.length;for(let i=1;i<=remain;i++){d.push({key:'n'+i,num:i,inMonth:false,isToday:false,hasEvent:false,eventColor:null})}
return d},
init(){},prevMonth(){if(this.currentMonth===0){this.currentMonth=11;this.currentYear--}else this.currentMonth--},nextMonth(){if(this.currentMonth===11){this.currentMonth=0;this.currentYear++}else this.currentMonth++}}}
</script>
