.cc-header {
    height: 56px;
    background: #ffffff;
    border-bottom: 1px solid #e8ecf1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    position: sticky;
    top: 0;
    z-index: 40;
    flex-shrink: 0;
}
.cc-header h2 {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.01em;
}
.cc-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 50%, transparent 100%);
    opacity: 0.6;
}
.cc-sidebar {
    background: #ffffff;
    border: 1px solid #e8ecf1;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 1px 2px rgba(0,0,0,.02);
}
.cc-sidebar h2 {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}
.cc-sidebar .cc-subtitle {
    font-size: 12.5px;
    color: #64748b;
    margin-top: 2px;
}
.cc-sidebar .cc-method-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    margin-bottom: 8px;
}
.cc-method-card {
    border-radius: 12px;
    border: 1.5px solid #e8ecf1;
    padding: 14px 16px;
    height: auto;
    min-height: 72px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    background: #fff;
}
.cc-method-card:hover {
    border-color: #bfdbfe;
    background: #f8faff;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(59,130,246,.08);
}
.cc-method-card.active {
    border-color: #2563eb;
    background: linear-gradient(135deg, #eff6ff 0%, #f0f4ff 100%);
    box-shadow: 0 0 0 3px rgba(37,99,235,.08), 0 2px 8px rgba(37,99,235,.1);
}
.cc-method-card .cc-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
}
.cc-method-card .cc-icon.default {
    background: #f1f5f9;
    color: #64748b;
}
.cc-method-card:hover .cc-icon.default {
    background: #eff6ff;
    color: #3b82f6;
}
.cc-method-card.active .cc-icon {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #fff;
    box-shadow: 0 2px 6px rgba(37,99,235,.3);
}
.cc-method-card h3 {
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.01em;
}
.cc-method-card p {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 1px;
    line-height: 1.4;
}
.cc-method-card .cc-check {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #2563eb;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
}
.cc-content-panel {
    background: #ffffff;
    border: 1px solid #e8ecf1;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(0,0,0,.04);
}
.cc-content-panel h2.cc-panel-title {
