                                                <input type="text" id="expirydate" asp-for="CorporateDetailList[0].CaseDocumentsL[0].ExpiryDate" placeholder="DD/MM/YYYY"
                                                        x-model="manualForm.expiryDate"
                                                       class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium">
                                                
                                        </div>
                                    @if(Model.CustomerRiskCategory)
