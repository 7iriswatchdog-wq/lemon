        $(function () {
    console.log("Corporate Form Validation Loaded");

    const $form = $("#myForm"); // single corporate form

    // --- 1. Counter Party Dropdown Change ---
    $form.find("#ddlCounterParty").off("change.counterParty").on("change.counterParty", function () {
        const counterParty = ($(this).val() || "").trim();
        const $name = $form.find("#counterPartyName");
        const nameValue = ($name.val() || "").trim();

        // Clear previous error
        $name.removeClass("is-invalid");
        $form.find("span[data-valmsg-for='CorporateDetailList[0].CounterPartyName']")
            .text("")
            .removeClass("field-validation-error");

        if (counterParty && counterParty !== "0") {
            $name.prop("required", true);
            if (!nameValue && $name.is(":visible")) {
                $name.addClass("is-invalid");
                $form.find("span[data-valmsg-for='CorporateDetailList[0].CounterPartyName']")
                    .text("Counter Party Name is required.")
                    .addClass("field-validation-error");
            }
        } else {
            $name.prop("required", false).removeClass("is-invalid");
        }
    });

    // --- 2. Counter Party Input ---
    $form.find("#counterPartyName").off("input.counterParty").on("input.counterParty", function () {
        const counterParty = ($form.find("#ddlCounterParty").val() || "").trim();
        const value = ($(this).val() || "").trim();

        if (counterParty && counterParty !== "0" && value) {
            $(this).removeClass("is-invalid");
            $form.find("span[data-valmsg-for='CorporateDetailList[0].CounterPartyName']")
                .text("")
                .removeClass("field-validation-error");
        }
    });

    // Trigger once on load
    $form.find("#ddlCounterParty").trigger("change");

    // --- 3. Form Submit Validation ---
    $form.off("submit.customValidation").on("submit.customValidation", function (e) {
        e.preventDefault();
        console.log("Corporate Form Submit Validation Started");

        // Clear previous errors
        $form.find("span[data-valmsg-for]").text("").removeClass("field-validation-error");
        $form.find(".is-invalid").removeClass("is-invalid");

        let isValid = true;
        let $firstErrorElement = null;

        function markInvalid(valFor, selector, message) {
            $form.find(`span[data-valmsg-for='${valFor}']`).text(message).addClass("field-validation-error");
            const $el = $form.find(selector);
            $el.addClass("is-invalid");
            if (!$firstErrorElement) $firstErrorElement = $el;
            isValid = false;
        }

        // --- Field Values ---
        const fullName = ($form.find("#txtCompanyName").val() || "").trim();
        const legalStatus = ($form.find("#LegalStatus").val() || "").trim();
        const bussinessType = ($form.find("#bussinessType").val() || "").trim();
        const producttype = ($form.find("#ddlProductType").val() || "").trim();
        const deliveryChannel = ($form.find("#ddlDeliveryChannel").val() || "").trim();
        const modeofpayment = ($form.find("#ddlModeofpayment").val() || "").trim();
        const counterParty = ($form.find("#ddlCounterParty").val() || "").trim();
        const counterPartyName = ($form.find("#counterPartyName").val() || "").trim();

        // --- Required Field Validations ---
        if ($form.find("#txtCompanyName").is(":visible") && fullName.length === 0)
            markInvalid("CorporateDetailList[0].FirstName", "#txtCompanyName", "Company Full Name is required.");

        if ($form.find("#LegalStatus").is(":visible") && (!legalStatus || legalStatus === "0"))
