             function initDatePicker(selector, defaultDate, options = {}) {
                            const elements = document.querySelectorAll(selector);
                            elements.forEach(el => {
                                // ✅ prevent duplicate initialization
                                if (el._flatpickr) return;
                                flatpickr(el, {
                                    dateFormat: "Y-m-d",
                                    altInput: true,
                                    altFormat: "d/m/Y",
                                    altInputClass: "block w-full h-11 bg-surface border border-bordercolor rounded-xl px-4 text-sm font-medium",
                                    allowInput: true,
                                    defaultDate: defaultDate,
                                    ...options,
                                    // ✅ Attach events AFTER input is created
                                    onReady: function (selectedDates, dateStr, instance) {
                                        const input = instance.altInput;
                                        // Restrict keys
                                        input.addEventListener("keydown", function (e) {
                                            const allowedKeys = ["Backspace", "Delete", "ArrowLeft", "ArrowRight", "Tab"];
                                            if (
                                                allowedKeys.includes(e.key) ||
                                                (e.key >= "0" && e.key <= "9")
                                            ) return;
                                            e.preventDefault();
                                        });
                                        // Auto format
                                        input.addEventListener("input", function () {
                                            let value = input.value.replace(/\D/g, '');
                                            if (value.length > 8) value = value.substring(0, 8);
                                            let formatted = '';
                                            if (value.length > 0) formatted += value.substring(0, 2);
                                            if (value.length >= 3) formatted += '/' + value.substring(2, 4);
                                            if (value.length >= 5) formatted += '/' + value.substring(4, 8);
                                            input.value = formatted;
                                        });
                                    },
                                    // ✅ Sync with Alpine (IMPORTANT)
                                    onChange: function (selectedDates, dateStr, instance) {
                                        if (el._x_model) {
                                            el._x_model.set(dateStr);
                                        }
                                    },
                                    // ✅ Final validation
                                    onClose: function (selectedDates, dateStr, instance) {
                                        if (selectedDates.length > 0) return;
                                        let val = instance.altInput.value;
                                        if (!val) return;
                                        let regex = /^\d{2}\/\d{2}\/\d{4}$/;
                                        if (!regex.test(val)) {
                                            instance.clear();
                                            return;
                                        }
                                        let parts = val.split('/');
                                        let dd = parseInt(parts[0], 10);
                                        let mm = parseInt(parts[1], 10);
                                        let yyyy = parseInt(parts[2], 10);
                                        let date = new Date(yyyy, mm - 1, dd);
                                        if (
                                            date.getFullYear() !== yyyy ||
                                            date.getMonth() !== mm - 1 ||
                                            date.getDate() !== dd
                                        ) {
                                            instance.clear();
                                            return;
                                        }
                                        instance.setDate(`${yyyy}-${parts[1]}-${parts[0]}`, true);
                                    }
                                });
                            });
                        }
                        document.addEventListener("DOMContentLoaded", function () {
                            // DOB → no future dates
                            const dobPicker = initDatePicker("#DOB", null, {
                                maxDate: "today",
                                            static: true
                            });
                          const issueDatePicker = initDatePicker("#issueDate", null, {
                                            maxDate: "today",
                                                        static: true
                          });
                          const expiryDatePicker = initDatePicker("#expirydate", null, {
                                                        minDate: "today",
                                                                    static: true
                          });
                        });
                                     function initAllDatePickers() {
                                        const elements = document.querySelectorAll(".date-picker");
                            console.log("Date elements found:", elements.length); // 👈 DEBUG
                                                    initDatePicker(".date-picker-dob", null, {
                                                maxDate: "today",
                                                static: true
                                            });
                                            initDatePicker(".date-picker-past", null, {
                                                maxDate: "today",
                                                static: true
                                            });
                                            // ✅ Future dates (Expiry)
                                            initDatePicker(".date-picker-future", null, {
                                                minDate: "today",
                                                static: true
                                            });
                        }
                                      function setShareholderViewFlag() {
                            localStorage.setItem("hideBackButton", "true");
                        }
        </script>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('groupEntities', () => ({
            groupsData: [],
            filteredGroups: [],
            groupSearchQuery: '',
            showCreateGroupForm: false,
            newGroupName: '',
            newGroupIds: [{id: '', name: '', loading: false}],
            isSubmittingGroup: false
        }));
    });

    window.addEventListener('load-group-entities', function(e) {
        fetch('/case/GetAllGroupEntities')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.dispatchEvent(new CustomEvent('update-groups-data', { detail: data.data }));
                }
            })
            .catch(err => console.error(err));
    });

    function fetchEntityName(index, id) {
        if (!id || id.length < 3) return;
        const alpineData = document.querySelector('body')._x_dataStack[0];
        alpineData.newGroupIds[index].loading = true;

        fetch(`/case/GetCustomerNameById?customerId=${id}`)
            .then(res => res.json())
            .then(data => {
                alpineData.newGroupIds[index].loading = false;
                if (data.success) {
                    alpineData.newGroupIds[index].name = data.name;
                } else {
                    alpineData.newGroupIds[index].name = 'Not Found';
                }
            })
            .catch(err => {
                alpineData.newGroupIds[index].loading = false;
                alpineData.newGroupIds[index].name = 'Error fetching name';
            });
    }

    function fetchGroupMembers(groupId) {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        alpineProxy.selectedGroupMembers = []; // Clear
        const gid = groupId || alpineProxy.selectedGroupId;
        fetch(`/case/GetGroupMembers?groupId=${encodeURIComponent(gid)}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alpineProxy.selectedGroupMembers = data.data;
                } else {
                    console.warn('GetGroupMembers failed:', data);
                }
            })
            .catch(err => console.error(err));
    }

    function addGroupMember() {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        if (!alpineProxy.newMemberId) return;
        
        const payload = {
            GroupId: alpineProxy.selectedGroupId,
            CustomerId: alpineProxy.newMemberId
        };

        fetch('/case/AddGroupMember', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alpineProxy.newMemberId = '';
                alpineProxy.newMemberName = '';
                alpineProxy.newMemberError = '';
                fetchGroupMembers(alpineProxy.selectedGroupId);
                window.dispatchEvent(new Event('load-group-entities'));
            } else {
                // show inline error — could bind to alpineProxy.addMemberError if needed
                console.error('AddGroupMember:', data.message);
            }
        })
        .catch(err => console.error('Server error', err));
    }

    function lookupNewMemberName() {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        if (!alpineProxy.newMemberId) {
            alpineProxy.newMemberName = '';
            alpineProxy.newMemberError = '';
            return;
        }

        fetch(`/case/GetCustomerNameById?customerId=${encodeURIComponent(alpineProxy.newMemberId)}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alpineProxy.newMemberName = data.name;
                    alpineProxy.newMemberError = '';
                } else {
                    alpineProxy.newMemberName = '';
                    alpineProxy.newMemberError = 'Case ID not found';
                }
            })
            .catch(err => {
                alpineProxy.newMemberName = '';
                alpineProxy.newMemberError = 'Error fetching name';
            });
    }

    function removeGroupMember(customerId) {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        
        const payload = {
            GroupId: alpineProxy.selectedGroupId,
            CustomerId: customerId.toString()
        };

        fetch('/case/RemoveGroupMember', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            alpineProxy.pendingRemoveMemberId = null;
            if (data.success) {
                fetchGroupMembers(alpineProxy.selectedGroupId);
                window.dispatchEvent(new Event('load-group-entities'));
            } else {
                console.error('RemoveGroupMember:', data.message);
            }
        })
        .catch(err => alert('Server error'));
    }

    function submitGroupEntity() {
        const alpineData = document.querySelector('body')._x_dataStack[0];
        alpineData.isSubmittingGroup = true;

        const payload = {
            groupName: alpineData.newGroupName,
            customerIds: alpineData.newGroupIds.filter(e => e.id && e.name && e.name !== 'Not Found').map(e => e.id)
        };

        fetch('/case/CreateGroupEntity', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            alpineData.isSubmittingGroup = false;
            if (data.success) {
                alpineData.newGroupName = '';
                alpineData.newGroupIds = [{id: '', name: '', loading: false}];
                alpineData.showCreateGroupForm = false;
                window.dispatchEvent(new Event('load-group-entities'));
                window.dispatchEvent(new CustomEvent('show-success-modal', { detail: { refId: data.groupName, isGroup: true } }));
            } else {
                alert(data.message || 'Error creating group');
            }
        })
        .catch(err => {
            alpineData.isSubmittingGroup = false;
            alert('Server error occurred');
        });
    }
</script>
</body>


