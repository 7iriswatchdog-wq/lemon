        if ($form.find("#bussinessType").is(":visible") && (!bussinessType || bussinessType === "0"))
            markInvalid("CorporateDetailList[0].BusinessType", "#bussinessType", "Business Type is required.");

        if ($form.find("#ddlProductType").is(":visible") && (!producttype || producttype === "0"))
            markInvalid("CorporateDetailList[0].ProductName", "#ddlProductType", "Product Type is required.");

        if ($form.find("#ddlDeliveryChannel").is(":visible") && (!deliveryChannel || deliveryChannel === "0"))
            markInvalid("CorporateDetailList[0].DeliveryChannelName", "#ddlDeliveryChannel", "Delivery Channel is required.");

        if ($form.find("#ddlModeofpayment").is(":visible") && (!modeofpayment || modeofpayment === "0"))
            markInvalid("CorporateDetailList[0].Modeofpayment", "#ddlModeofpayment", "Mode Of Payment is required.");

        // Counter Party validation
        if (counterParty && counterParty !== "0" && $form.find("#counterPartyName").is(":visible") && counterPartyName.length === 0)
            markInvalid("CorporateDetailList[0].CounterPartyName", "#counterPartyName", "Counter Party Name is required.");

        // --- Scroll to first error if invalid ---
        if (!isValid) {
            if ($firstErrorElement) {
                $("html, body").animate({ scrollTop: $firstErrorElement.offset().top - 150 }, 400);
                $firstErrorElement.focus();
            }
            return false;
        }

        // --- Submit Form ---
        $('#loadingeffect').show();
        $('#btn-ld').prop('disabled', true);

        setTimeout(() => {
            $form.off("submit.customValidation").submit();
        }, 200);
    });
});


