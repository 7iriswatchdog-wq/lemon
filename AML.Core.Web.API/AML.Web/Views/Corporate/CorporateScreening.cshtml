                                            Add Related Parties
                                        </h2>
                                        <p class="text-sm text-slate-500 font-medium mt-1">
                                            Add Related Parties to Existing Corporate
                                        </p>
                                    </div>

                                <!-- Info Banner -->
                                <div class="bg-yellow-50 border border-yellow-100 rounded-lg p-3 flex items-center gap-2 text-yellow-800 text-[11px] font-medium">
                                    <i data-lucide="info" class="w-4 h-4 text-yellow-600"></i>
                                    Fields marked with * are mandatory for screening
                                </div>

                                <!-- Corporate Search -->
                                <div class="space-y-2">
                                    <label class="text-xs font-semibold text-slate-700">
                                        Existing Corporate Lemon Id <span class="text-red-500">*</span>
                                    </label>
