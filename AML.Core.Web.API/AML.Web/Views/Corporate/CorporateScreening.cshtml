                                                <label class="text-[13px] font-bold text-slate-700">Trade Licence Sector</label>
                                                <input type="text" x-model="manualForm.tradeLicensesector" placeholder="Enter Trade Licence Sector" asp-for="CorporateDetailList[0].TradeLicenseSector" id="tradelicenseSector"
                                                       class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm outline-none">
                                            </div> *@
                                            
                                        <div class="space-y-2">
                                            <label class="text-[13px] font-bold text-slate-700">Date of Registration</label>
                                                <input type="text" id="DOB" asp-for="CorporateDetailList[0].DOB" placeholder="DD/MM/YYYY"
