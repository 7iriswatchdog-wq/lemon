                      function formatCaseStatus(statusText) {
                                if (!statusText) return '';
                                            function getStatusClass(text) {

                                                const t = text.toLowerCase().trim();

                                                if (t.includes('pending')) return 'bg-yellow-100 text-yellow-800';
                                                if (t.includes('approved')) return 'bg-blue-100 text-blue-800';
                                                //if (t.includes('auto')) return     'bg-amber-100 text-amber-800';
                                                if (t.includes('auto')) return 'bg-orange-100 text-orange-800';
                                                if (t.includes('transfer')) return 'bg-green-100 text-green-800';
                                                if (t.includes('rejected')) return 'bg-red-100 text-red-800';

                                                return 'bg-slate-100 text-slate-800';
                                            }
                                    const statusClass = getStatusClass(statusText);

                                return `
                                                            <span class="inline-flex items-center justify-center min-w-[120px] px-3 py-1.5 rounded-full text-xs font-semibold ${statusClass}">
                            ${statusText}
                        </span>`;
                                    }



                                            function formatDateTime(dateStr) {
                                if (!dateStr) return { date: '-', time: '-' };

                                const d = new Date(dateStr);

                                return {
                                    date: d.toLocaleDateString('en-GB'), // 20/02/2026
                                    time: d.toLocaleTimeString([], {
                                        hour: '2-digit',
                                        minute: '2-digit',
                                        second: '2-digit',   // ✅ added
                                        hour12: true
                                    }) // 06:43:15 PM
                                };
                            }

        function checkDuplicatefunction(){

                 //alert("hai");
