    <script>
                 function shareholderTree() {

                    return {

                        items: [],

                        syncFromStore() {

                            this.items = JSON.parse(
                                JSON.stringify(Alpine.store('screeningStore').screeningList || [])
                            );
                        },

                        init() {

                            this.syncFromStore();

                            this.$nextTick(() => {
                                this.initSortable();
                            });

                            window.addEventListener('store-updated', () => {
                                this.syncFromStore();
                            });
                        },


                        // ⭐ Numbering + Tree Build
                        flattenedItems() {

                            let list = this.items || [];

                            function build(parentId = null, prefix = "", depth = 0) {

                                let children = list.filter(x => x.parentId === parentId);

                                return children.flatMap((item, index) => {

                                    let number = prefix
                                        ? `${prefix}.${index + 1}`
                                        : `${index + 1}`;

                                    return [
                                        { ...item, depth, displayId: number },
                                        ...build(item.id, number, depth + 1)
                                    ];
                                });
                            }

                            return build();
                        },


                        // ⭐ Drag Logic
                        initSortable() {

                            let self = this;
                            let container = document.getElementById("shareholderTreeContainer");

                            if (!container) return;

                            new Sortable(container, {

                                animation: 150,
                                handle: ".drag-handle",

                                onEnd(evt) {

                                    if (!evt.item || !evt.item.dataset.id) return;

                                    let movedId = Number(evt.item.dataset.id);
                                    let prev = evt.item.previousElementSibling;

                                    let newParentId = null;
                                        let parentType = null;

                                    if (prev && prev.dataset.id) {

                                        let prevId = Number(prev.dataset.id);
                                        let prevItem = self.items.find(x => x.id === prevId);

                                        if (prevItem) {

                                                if (prevItem.type === "Corporate_Corp") {
                                                    newParentId = prevItem.id;
                                                    parentType = prevItem.type;
                                            }
                                            else {
                                                newParentId = prevItem.parentId ?? null;

                                                    let parent = self.items.find(x => x.id === newParentId);
                                                    parentType = parent ? parent.type : null
                                            }
                                        }
                                    }

                                    let store = Alpine.store('screeningStore');
                                    let moved = store.screeningList.find(x => x.id === movedId);

                                    if (!moved) return;

                                    moved.parentId = newParentId;

                                        if (parentType === "Corporate_Corp") {

    // If dropped under corporate, make it corporate child
                                        if (moved.type === "Corporate_Ind") {
                                            moved.type = "Corporate_Corp_Ind";
                                        }

                                    } else {

                                        // If moved outside corporate, convert back to individual
                                        if (moved.type === "Corporate_Corp_Ind") {
                                            moved.type = "Corporate_Ind";
                                        }

                                    }

                                    window.dispatchEvent(new Event('store-updated'));
                                }
                            });
                        }
                    }
                }
