    <style>
        .screening-overlay {
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
        }

        .screening-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 28px 36px 24px;
            min-width: 320px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            font-family: 'Inter', sans-serif;
        }

        .screening-radar {
            position: relative;
            width: 92px;
            height: 92px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 6px;
        }

            .screening-radar .radar-ring {
                position: absolute;
                inset: 0;
                border-radius: 50%;
                border: 2px solid #2563eb;
                opacity: 0;
                animation: screening-pulse 1.4s ease-out infinite;
            }

                .screening-radar .radar-ring.delay-1 {
                    animation-delay: 0.45s;
                }

                .screening-radar .radar-ring.delay-2 {
                    animation-delay: 0.9s;
                }

            .screening-radar .radar-core {
                position: relative;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: #2563eb;
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 6px 16px rgba(37, 99, 235, 0.45);
                animation: screening-bob 1.2s ease-in-out infinite;
            }

        .screening-title {
            font-size: 16px;
            font-weight: 600;
            color: #0f172a;
        }

        .screening-subtitle {
            font-size: 13px;
            color: #475569;
            min-height: 18px;
            transition: opacity 0.2s ease;
        }

        .screening-progress {
            margin-top: 6px;
            width: 240px;
            height: 4px;
            background: #e2e8f0;
            border-radius: 999px;
            overflow: hidden;
        }

            .screening-progress > span {
                display: block;
                height: 100%;
                width: 40%;
                background: linear-gradient(90deg, transparent, #2563eb 50%, transparent);
                border-radius: 999px;
                animation: screening-slide 1.1s linear infinite;
            }

        .flatpickr-wrapper {
            width: 100% !important;
        }
        .flatpickr-alt-input {
            width: 100% !important;
            display: block !important;
        }

        @@keyframes screening-pulse {
            0% {
                transform: scale(0.55);
                opacity: 0.8;
            }
            80% {
                opacity: 0;
            }
            100% {
                transform: scale(1.4);
                opacity: 0;
            }
        }

        @@keyframes screening-bob {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.06);
            }
        }

        @@keyframes screening-slide {
            0% {
                transform: translateX(-120%);
            }
            100% {
                transform: translateX(320%);
            }
        }
    
    </style>
</head>
