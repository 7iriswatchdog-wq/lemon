                                               class="flex-1 h-10 border border-slate-200 rounded-md px-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                                        <input type="text" placeholder="Thershold" id="Thershold" hidden
                                               class="flex-1 h-10 border border-slate-200 rounded-md px-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                                        <button @@click="searchCompanyCodefunction()"
                                                class="bg-blue-600 hover:bg-blue-700 text-white px-8 h-10 rounded-md font-bold text-sm transition-colors shadow-lg shadow-blue-500/10">
                                            Search
                                        </button>
                                    </div>
                                </div>

                                <!-- Actions Area - Only Visible After Search -->
                                    <div x-data="{ hasSearched: false, activeShareholderTab: 'related_shareholder',showDropdown: false }"
                                         x-on:company-searched.window="
                                                hasSearched = true;
                                                activeShareholderTab = 'related_shareholder';
                                             "
                                         x-on:company-notfound.window="hasSearched = false"
                                         class="space-y-6 pt-4 border-t border-slate-100 animate-in fade-in slide-in-from-top-2 duration-300">
                                        <div x-show="hasSearched" x-transition>
                                            <div class="flex gap-3 items-center mb-4 relative">

                                                <!-- Form Button -->
                                                <button x-on:click="showDropdown = !showDropdown"
                                                        class="bg-blue-600 hover:bg-blue-700 text-white px-6 h-10 rounded-md font-bold text-sm shadow-sm">
                                                    Select Related Party Type
                                                </button>

                                                <!-- SELECT DROPDOWN (beside button) -->
                                                <select x-show="showDropdown"
