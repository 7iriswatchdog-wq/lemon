                    function shareholderRepeater(parentTab) {
                return {
                    forms: [{ type: parentTab, isDuplicate: false }],
                    maxForms: 5,
                    activeShareholderTab: parentTab, // track current tab
                                  init() {
                                                    // listen for dropdown change
                                                    window.addEventListener('tab-changed', (e) => {
                                                        if (!e.detail) return;
                                                        this.updateFormsType(e.detail);
                                                    });
                                                },
                    // Add a new form
                    addForm() {
                        if (this.forms.length >= this.maxForms) {
                            toastr.error("Only 5 forms allowed");
                            return;
                        }
                        this.forms.push({ type: this.activeShareholderTab, isDuplicate: false });
                                    this.$nextTick(() => {
                                                                            initAllDatePickers(); // 🔥 reinitialize new inputs
                                                });
                    },
                    // Remove a form
                    removeForm(index) {
                        this.forms.splice(index, 1);
                    },
                    // Update all forms type when tab changes
                    updateFormsType(newType) {
                        this.activeShareholderTab = newType;
                        this.forms.forEach(f => f.type = newType); // update all existing forms
                    },
                    // Submit forms to the server
                    async submitForms() {
                        const payload = [];
                        const formData = new FormData();
                        const CompanyCode = $('#CompanyCodeInput').val() || "";
                        const CompanyName = $('#CompanyNameHidden').val() || "";
                        const Thershold = parseInt($('#Thershold').val() || 0);
                        // Prepare payload only from filled forms
                                               this.forms.forEach((form,index) => {
                if (!form.name || form.name.trim() === "") return;
                
                const typeValue = form.type === 'shareholder'
                      ? 'Corporate_Ind'
                      : form.type === 'corporate_shareholder'
                      ? 'Corporate_Corp'
                      : form.type === 'related_shareholder'
                      ? 'Corporate_Ind'
                      : form.type === 'related_corporate_shareholder'
                      ? 'Corporate_Corp'
                      : form.type === 'signatories'
                      ? 'Corporate_Ind'
                      : 'Corporate_Ind';
                 const flagType = form.type === 'shareholder'
                      ? 'Individual Sharholder'
                      : form.type === 'corporate_shareholder'
                      ? 'Corporate Shareholder'
                      : form.type === 'related_shareholder'
                      ? 'Individual Related Parties'
                      : form.type === 'related_corporate_shareholder'
                      ? 'Corporate Related Parties'
                      : form.type === 'signatories'
                      ? 'Authorized Signatory'
                      : 'Senior Management';
                const obj = {
                    Name: form.name,
                    Share: parseInt(form.share || 0),
                    Designation: form.designation || "",
                    Nationality: form.nationality || "",
                    Residence: form.residence || "",
                    TradeLicence: form.tradeLicence || "",
                    RegistrationDate: form.registrationDate || "",
                    IdType: form.idType || "",
                    IdNumber: form.idNumber || "",
                    IssueDate: form.issueDate || "",
                    IdExpiry: form.idExpiry || "",
                    Cif: form.cif || "",
                    IsDuplicate: form.isDuplicate ? 1 : 0,
                    Type: typeValue,
                    CompanyCode: CompanyCode,
                    CompanyName: CompanyName,
                    Thershold: Thershold,
                    Employer: form.employername || "",
                    GoldenVisa: form.goldenvisa || "",
                    EmployerIndustry:form.employerindustry || "",
                    EmployerSector:form.employersector || "",
                    SOWSOFCountry:form.sowsofcountry || "",
                    TradeLicenseAuthority:form.tradeLicenceAuthority || "",
                    TradeLicenseSector:form.tradeLicenceSector  || "",
                    Gender:form.gender || "",
                    Relationship:form.relationship || "",
                    PlaceOfBirth:form.placeofbirth || '',
                    FlagType:flagType,
                    CustType:"C",
                    ClientID: 0,
                    UserId: 0,
                    
                };
                                                                        
                                                            
                                                            
                payload.push(obj);
                if (form.document) {
                    formData.append("Documents", form.document);
                }
            });
            // THIS LINE WAS MISSING
            formData.append("data", JSON.stringify(payload));
                        
                                                                        
                        if (payload.length === 0) {
                            toastr.warning("No shareholder details to save");
                            return;
                        }
                        try {
                            // Send payload to server
                        const res = await fetch('/Corporate/SaveShareholders', {
                        method: 'POST',
                        body: formData
                    });
                            if (!res.ok) throw new Error("Save failed");
                            toastr.success("Saved Successfully");
                            // Refresh pending shareholders via event
                            //window.dispatchEvent(new Event('load-pending-shareholders'));
                                    await new Promise(resolve => {
                                                            window.dispatchEvent(new CustomEvent('load-casecreated-shareholders', {
                                                                detail: { skipModal: true }
                                                            }));
                                                            setTimeout(resolve, 300);
                                                        });
                                                        await new Promise(resolve => {
                                                            window.dispatchEvent(new CustomEvent('load-pending-shareholders', {
                                                                detail: { skipModal: true }
                                                            }));
                                                            setTimeout(resolve, 300);
                                                        });
                            // Optionally, clear forms after submit
                            this.forms = [{ type: this.activeShareholderTab }];
                        } catch (err) {
                            console.error("Error saving shareholders:", err);
                            toastr.error("Failed to save shareholders");
                        }
                    }
                };
            }
            
             
       
