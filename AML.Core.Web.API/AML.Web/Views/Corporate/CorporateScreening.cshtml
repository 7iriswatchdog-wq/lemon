                        return {
                            items: [],

                            init() {
                                this.syncFromStore();
                                window.addEventListener('store-updated', () => this.syncFromStore());
                            },

                            syncFromStore() {
                                this.items = JSON.parse(JSON.stringify(Alpine.store('screeningStore').screeningList || []));
                            },

                            flattenedItems() {
                                const list = this.items || [];
                                function build(parentId = null, prefix = "", depth = 0) {
                                    const children = list.filter(i => i.parentId === parentId);
                                    return children.flatMap((item, index) => {
                                        const number = prefix ? `${prefix}.${index + 1}` : `${index + 1}`;
                                        return [{ ...item, depth, displayId: number }, ...build(item.id, number, depth + 1)];
                                    });
                                }
                                return build();
                            },

