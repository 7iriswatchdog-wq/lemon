         function searchCompanyCodefunction() {
                    var CompanyCode = Alpine.store('searchQuery') || document.getElementById('CompanyCodeInput').value;
                                    var CustomerType="C";

            if (!CompanyCode || CompanyCode.trim() === '') {
                toastr.error("Please enter a valid Corporate ID");
                return;
            }

            $("#loader").show();

                        //alert(CompanyCode);

            $.ajax({
                url: '/corporate/searchcompanycode',
                type: 'POST',
                data: { CompanyCode: CompanyCode,CustomerType:CustomerType },
                success: function (data) {
                    console.log(data);

                    if (data && data.length > 0) {
                        
                        // Dispatch event for company found
                        window.dispatchEvent(new CustomEvent('company-searched', {
                            detail: data
                        }));

                        // Load pending shareholders (if any)
                        window.dispatchEvent(new Event('load-pending-shareholders'));
                    }
                    else {
                        window.dispatchEvent(new CustomEvent('company-notfound'));

                        toastr.error('No Corporate ID was found for the entered value.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                    }
                },
                error: function (xhr) {
                    console.error('Error:', xhr.responseText);
                    toastr.error("Error loading company details");
                },
                complete: function () {
                    $("#loader").hide();
                }
            });
        }

