                                                           @@input="filteredGroups = groupSearchQuery ? groupsData.filter(g => (g.groupName && g.groupName.toLowerCase().includes(groupSearchQuery.toLowerCase())) || (g.groupId && g.groupId.toLowerCase().includes(groupSearchQuery.toLowerCase())) || (g.riskLevel && g.riskLevel.toLowerCase().includes(groupSearchQuery.toLowerCase()))) : groupsData"
                                                           class="w-full h-10 pl-9 pr-4 text-sm border border-bordercolor rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                                </div>
                                                <button type="button" @@click="showCreateGroupForm = true; newGroupIds = [{id: '', name: '', loading: false}]"
                                                        class="h-10 px-4 bg-primary hover:bg-primary-hover text-white text-sm font-bold rounded-lg shadow-sm flex items-center gap-2">
                                                    <i data-lucide="plus" class="w-4 h-4"></i> Create Group
                                                </button>
                                            </div>

                                            <div class="overflow-x-auto">
                                                <table class="w-full text-left border-collapse">
                                                    <thead>
                                                        <tr class="bg-appbg text-xs text-textmuted uppercase tracking-wider">
                                                            <th class="px-4 py-3 font-semibold rounded-tl-lg">Group Name</th>
                                                            <th class="px-4 py-3 font-semibold">Member Count</th>
                                                            <th class="px-4 py-3 font-semibold">Risk Level</th>
                                                            <th class="px-4 py-3 font-semibold rounded-tr-lg">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <template x-for="(group, index) in paginatedGroups" :key="index">
                                                            <tr class="border-b border-bordercolor hover:bg-slate-50 transition-colors">
                                                                <td class="px-4 py-4 text-sm font-bold text-textprimary" x-text="group.groupName"></td>
                                                                <td class="px-4 py-4 text-sm text-textsecondary">
                                                                    <span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-full text-xs font-bold" x-text="group.memberCount + ' Members'"></span>
                                                                </td>
                                                                <td class="px-4 py-4 text-sm">
                                                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold"
                                                                          :class="group.riskLevel === 'High Risk' ? 'bg-red-50 text-red-600' : (group.riskLevel === 'Medium Risk' ? 'bg-orange-50 text-orange-600' : 'bg-emerald-50 text-emerald-600')"
                                                                          x-text="group.riskLevel"></span>
                                                                </td>
                                                                <td class="px-4 py-4">
                                                                    <button @@click="selectedGroupId = group.groupId; selectedGroupName = group.groupName; showGroupDetailsModal = true; fetchGroupMembers(group.groupId)" class="text-primary hover:text-primary-hover font-medium text-sm">View Details</button>
                                                                </td>
                                                            </tr>
                                                        </template>
                                                        <tr x-show="filteredGroups.length === 0">
                                                            <td colspan="4" class="px-4 py-8 text-center text-textmuted text-sm">
                                                                No groups found.
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <!-- Pagination Controls -->
                                            <div class="flex items-center justify-between px-4 py-4 border-t border-bordercolor mt-4" x-show="filteredGroups.length > 0">
                                                <!-- Page length dropdown -->
                                                <div class="flex items-center gap-2 text-sm">
                                                    <select x-model.number="groupPageSize" @@change="groupCurrentPage = 1"
                                                            class="h-8 rounded-md border border-bordercolor bg-surface px-2 pr-7 text-sm">
                                                        <option value="10">10</option>
                                                        <option value="20">20</option>
                                                        <option value="50">50</option>
                                                        <option value="100">100</option>
                                                    </select>
                                                    <label class="text-textlabel font-medium">Entries per page</label>
                                                </div>
                                                <div class="text-sm text-textmuted">
                                                    Showing <span class="font-medium text-textprimary" x-text="Math.min((groupCurrentPage - 1) * groupPageSize + 1, filteredGroups.length)"></span>
                                                    to <span class="font-medium text-textprimary" x-text="Math.min(groupCurrentPage * groupPageSize, filteredGroups.length)"></span>
                                                    of <span class="font-medium text-textprimary" x-text="filteredGroups.length"></span> groups
                                                </div>
                                                <div class="flex items-center space-x-2">
                                                    <button type="button" @@click="if(groupCurrentPage > 1) groupCurrentPage--" 
                                                            :disabled="groupCurrentPage === 1" title="Previous page"
                                                            class="h-8 w-8 flex items-center justify-center text-sm font-medium border border-bordercolor bg-surface rounded-md text-textlabel disabled:opacity-50 disabled:cursor-not-allowed hover:bg-appbg">
                                                        <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i>
                                                    </button>
                                                    <button type="button" @@click="if(groupCurrentPage * groupPageSize < filteredGroups.length) groupCurrentPage++" 
                                                            :disabled="groupCurrentPage * groupPageSize >= filteredGroups.length" title="Next page"
                                                            class="h-8 w-8 flex items-center justify-center text-sm font-medium border border-bordercolor bg-surface rounded-md text-textlabel disabled:opacity-50 disabled:cursor-not-allowed hover:bg-appbg">
                                                        <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Create Form View -->
                                        <div x-show="showCreateGroupForm" class="p-6">
                                            <div class="flex items-center gap-4 mb-6 pb-6 border-b border-bordercolor">
                                                <button type="button" @@click="showCreateGroupForm = false" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-100 text-textmuted">
                                                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                                                </button>
                                                <div>
                                                    <h3 class="text-lg font-bold text-textprimary">Create New Group Entity</h3>
                                                    <p class="text-sm text-textmuted">Add multiple entities to a single group</p>
                                                </div>
                                            </div>

                                            <div class="space-y-6 w-full">
                                                <div class="space-y-2">
                                                    <label class="text-sm font-semibold text-textlabel">Group Name <span class="text-red-500">*</span></label>
                                                    <input type="text" x-model="newGroupName" placeholder="Enter group name (e.g. Al Futtaim Group)"
                                                           class="w-full h-11 border border-bordercolor rounded-lg px-4 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                                                </div>

                                                <div class="space-y-4">
                                                    <label class="text-sm font-semibold text-textlabel flex justify-between">
                                                        <span>Entities in Group</span>
                                                        <button type="button" @@click="newGroupIds.push({id: '', name: '', loading: false})" class="text-primary hover:underline text-xs flex items-center gap-1">
                                                            <i data-lucide="plus" class="w-3 h-3"></i> Add Row
                                                        </button>
                                                    </label>

                                                    <template x-for="(entity, index) in newGroupIds" :key="index">
                                                        <div class="flex gap-4 items-start">
                                                            <div class="flex-1 space-y-1 relative">
                                                                <input type="text" x-model="entity.id" placeholder="Entity ID (e.g. CSC123)"
                                                                       @@input.debounce.500ms="fetchEntityName(index, entity.id)"
                                                                       class="w-full h-11 border border-bordercolor rounded-lg px-4 text-sm focus:ring-2 focus:ring-blue-500 outline-none uppercase">
                                                                <div x-show="entity.loading" class="absolute right-3 top-3.5">
                                                                    <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-primary"></i>
                                                                </div>
                                                            </div>
                                                            <div class="flex-1 space-y-1">
                                                                <input type="text" x-model="entity.name" placeholder="Entity Name (Auto-filled)" readonly
                                                                       class="w-full h-11 border border-bordercolor bg-appbg rounded-lg px-4 text-sm text-textsecondary cursor-not-allowed outline-none">
                                                            </div>
                                                            <button type="button" @@click="newGroupIds.splice(index, 1)" x-show="newGroupIds.length > 1"
                                                                    class="h-11 w-11 flex items-center justify-center text-red-500 hover:bg-red-50 rounded-lg shrink-0">
                                                                <i data-lucide="trash-2" class="w-5 h-5"></i>
                                                            </button>
                                                        </div>
                                                    </template>
                                                </div>

                                                <div class="pt-6 flex justify-end gap-3">
                                                    <button type="button" @@click="showCreateGroupForm = false"
                                                            class="h-11 px-6 bg-surface border border-bordercolor text-textlabel font-bold rounded-lg hover:bg-slate-50">
                                                        Cancel
                                                    </button>
                                                    <button type="button" @@click="submitGroupEntity()" :disabled="isSubmittingGroup || !newGroupName || newGroupIds.filter(e => e.id && e.name).length === 0"
                                                            class="h-11 px-6 bg-primary hover:bg-primary-hover text-white font-bold rounded-lg shadow-sm disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">
                                                        <span x-show="!isSubmittingGroup">Create Group</span>
                                                        <span x-show="isSubmittingGroup" class="flex items-center gap-2">
                                                            <i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Saving...
                                                        </span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

