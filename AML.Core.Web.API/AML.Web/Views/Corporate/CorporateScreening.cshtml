                                                    <input type="number" placeholder="Enter Product Value" asp-for="CorporateDetailList[0].ProductValue" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium outline-none" id="productValue">
                                                </div>
                                            </div>
                                            @* <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">
                                                    Product Type
                                                </label>
                                                <div class="relative">
                                                    <input type="text" placeholder="Enter Product Type" asp-for="CorporateDetailList[0].ProductType" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium outline-none" id="productType">
                                                </div>
                                            </div> *@
                                     @if(Model.DeliveryChannelCategory)
                                            {
                                         @if (Model.DeliveryChannelList != null && Model.DeliveryChannelList.Any())
                                                    {
                                        <div class="space-y-2">
                                            <label class="text-[13px] font-bold text-slate-700">Delivery Channel <span class="text-red-500">*</span></label>
                                            <div class="relative">
                                                <select x-model="manualForm.deliveryChannel" required class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm appearance-none outline-none" id="ddlDeliveryChannel" asp-for="CorporateDetailList[0].DeliveryChannelName" asp-items="Model.DeliveryChannelList">
                                                    <option value="0">--@localizer["EMPTY"]--</option>
                                                </select>
                                                <i data-lucide="chevron-down" class="w-4 h-4 absolute right-3 top-3 text-slate-400 pointer-events-none"></i>
                                                <span asp-validation-for="CorporateDetailList[0].DeliveryChannelName" class="validstyle" style="color:red"></span>
                                            </div>
                                        </div>
                                        }
                                        }
                                        @if(Model.ModeOfPaymentCategory)
                                            {   
                                                    @if (Model.ModeofpaymentList != null && Model.ModeofpaymentList.Any())
                                                            {
                                                <div class="space-y-2">
                                                    <label class="text-[13px] font-bold text-slate-700">Mode Of Payment<span class="text-red-500">*</span></label>
                                                    <div class="relative">
                                                        <select x-model="manualForm.modeofpayment" required class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm appearance-none outline-none" id="ddlModeofpayment" asp-items="Model.ModeofpaymentList" asp-for="CorporateDetailList[0].Modeofpayment">
                                                            <option value="0">--@localizer["EMPTY"]--</option>
                                                        </select>
                                                        <i data-lucide="chevron-down" class="w-4 h-4 absolute right-3 top-3 text-slate-400 pointer-events-none"></i>
                                                        <span asp-validation-for="CorporateDetailList[0].Modeofpayment" class="validstyle" style="color:red"></span>
                                                    </div>
                                                </div>
                                                }
                                        }

                                        <div class="space-y-2">
                                            <label class="text-[13px] font-bold text-slate-700">Customer CIF No</label>
                                            <input type="text" id="cifnumber" x-model="manualForm.cif" placeholder="Enter Customer CIF No" asp-for="CorporateDetailList[0].CIFNumber"
                                                class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm outline-none">
                                        </div>
                                            <div class="space-y-2.5">
                                                <label class="text-[13px] font-bold text-slate-700">
                                                    Product Ref No
                                                </label>
                                                <div class="relative">
                                                    <input type="text" placeholder="Enter Product Ref No" asp-for="CorporateDetailList[0].ProductRefNo" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium outline-none" id="productrefno">
                                                </div>
                                            </div>
                                            
                                        <div class="space-y-3">
                                            <div class="flex justify-between items-center">
                                                <label class="text-[13px] font-bold text-slate-700">Match Parameter</label>
                                                <span class="text-xs font-bold text-slate-900" x-text="matchParam + '%'"></span>
                                            </div>
                                            <div class="relative h-1.5 flex items-center">
                                                @* <input type="range" min="0" max="100" x-model="matchParam" asp-for="Threshold"
                                                    class="w-full h-1.5 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-blue-600 outline-none"
                                                    :style="`background: linear-gradient(to right, #2563eb ${matchParam}%, #f1f5f9 ${matchParam}%);`" /> *@
                                                    <input type="range"
                                                           x-model="matchParam"
                                                           min="50"
                                                           max="100"
                                                           id="threshold"
                                                           asp-for="Threshold"
                                                           class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-blue-600"
                                                           :style="`background: linear-gradient(to right, #2563eb ${((matchParam-50)/(100-50))*100}%, #f1f5f9 ${((matchParam-50)/(100-50))*100}%)`">
                                            </div>
                                        </div>
                                             <div x-data="{ fileName: 'No file chosen' }" class="space-y-2">
                                                    <label class="text-xs font-semibold text-slate-700">Document</label>

                                                    <div class="relative flex items-center">

                                                        <!-- Hidden File Input -->
                                                        <input type="file"
                                                               class="hidden"
                                                               x-ref="docUpload"
                                                                name="CorporateDetailList[0].CaseDocumentsL[0].Document"
                                                               x-on:change="
                                                               if ($event.target.files.length> 0) {
                                                        let fullName = $event.target.files[0].name;
                                                        fileName = fullName.length > 10 ? fullName.substring(0, 10) + '...' : fullName;
                                                        } else {
                                                        fileName = 'No file chosen';
                                                        }
                                                        ">

                                                        <!-- Custom UI -->
                                                        <div x-on:click="$refs.docUpload.click()"
                                                             class="w-full h-10 bg-white border border-slate-200 rounded-md px-3 py-2 text-sm flex items-center justify-between cursor-pointer hover:bg-slate-50 transition-colors">

                                                            <!-- Short Display Name -->
                                                            <span class="text-slate-500 text-xs" x-text="fileName"></span>

                                                            <span class="text-[11px] text-blue-600 font-bold border border-blue-600 rounded-md px-3 py-0.5">
                                                                Choose file
                                                            </span>

                                                        </div>
                                                    </div>

                                                    
                                                
                                            
                                            </div>
                                    </div>

                                    <div class="flex gap-4 pt-6">
                                        <button type="submit" class="flex-1 h-11 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/10 transition-all text-sm">
                                            Create Case
                                        </button>
                                        <button type="reset" class="px-8 h-11 border border-slate-200 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition-all text-sm" @@click="location.href='@Url.Action("CorporateScreening", "Corporate")'">
                                            Reset Form
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <!-- CONTENT: ADD SHAREHOLDERS -->
                            <div x-show="selectedMethod === 'shareholder'" x-transition class="space-y-8">
