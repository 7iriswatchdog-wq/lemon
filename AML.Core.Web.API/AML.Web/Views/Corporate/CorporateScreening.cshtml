          const allOptions = @Html.Raw(codesJson);
        // Store ONLY values
        let selectedOptions = allOptions.map(x => x.value);
        // DOM Elements
        const triggerBtn = document.getElementById('trigger-btn');
        const triggerText = document.getElementById('trigger-text');
        const popoverContent = document.getElementById('popover-content');
        const allCheckbox = document.getElementById('corporate-all');
        const optionsContainer = document.getElementById('options-container');
        const helperText = document.getElementById('helper-text');
        if (triggerBtn && allCheckbox && optionsContainer) {
            function renderOptions() {
            optionsContainer.innerHTML = '';
            allOptions.forEach(option => {
                const div = document.createElement('div');
                div.className = 'flex items-center space-x-2';
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.value = option.value;
                checkbox.id = `corporate-${option.value.replace(/\s+/g, '-').toLowerCase()}`;
                checkbox.className =
                    'h-4 w-4 rounded border-slate-300 text-primary focus:ring-blue-500';
                checkbox.checked = selectedOptions.includes(option.value);
                checkbox.addEventListener('change', (e) => {
                    if (e.target.checked) {
                        selectedOptions.push(option.value);
                    }
                    else {
                        selectedOptions = selectedOptions.filter(x => x !== option.value);
                    }
                    updateUI();
                });
                const label = document.createElement('label');
                label.htmlFor = checkbox.id;
                label.className = 'text-sm font-medium cursor-pointer';
                label.textContent = option.text;
                div.appendChild(checkbox);
                div.appendChild(label);
                optionsContainer.appendChild(div);
            });
        }
        function updateUI() {
            const isAllSelected = selectedOptions.length === allOptions.length;
            allCheckbox.checked = isAllSelected;
            // Trigger Text
            if (isAllSelected) {
                triggerText.textContent = 'ALL';
            }
            else if (selectedOptions.length > 0) {
                triggerText.textContent = `${selectedOptions.length} option(s) selected`;
            }
            else {
                triggerText.textContent = 'Select screening options';
            }
            // Sync Checkboxes
            const inputs = optionsContainer.querySelectorAll('input[type="checkbox"]');
            inputs.forEach(input => {
                input.checked = selectedOptions.includes(input.value);
            });
            updateCodesForPost();
        }
        // ALL Checkbox
        allCheckbox.addEventListener('change', (e) => {
            if (e.target.checked) {
                selectedOptions = allOptions.map(x => x.value);
            }
            else {
                selectedOptions = [];
            }
            updateUI();
        });
                function updateCodesForPost() {
            const container = document.getElementById('codesHiddenContainer');
            container.innerHTML = '';
            allOptions.forEach((option, index) => {
                const isSelected = selectedOptions.includes(option.value);
                // CodeNames[index]
                const codeName = document.createElement('input');
                codeName.type = 'hidden';
                codeName.name = `CodeNames[${index}]`;
                codeName.value = option.value;
                container.appendChild(codeName);
                // IsChecked[index]
                const isChecked = document.createElement('input');
                isChecked.type = 'hidden';
                isChecked.name = `IsChecked[${index}]`;
                isChecked.value = isSelected;
                container.appendChild(isChecked);
            });
        }
        // Toggle Popover
        function togglePopover() {
            popoverContent.classList.toggle('hidden');
            triggerBtn.setAttribute(
                'aria-expanded',
                !popoverContent.classList.contains('hidden')
            );
        }
        function closePopover() {
            popoverContent.classList.add('hidden');
            triggerBtn.setAttribute('aria-expanded', 'false');
        }
        // Button Click
        triggerBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            togglePopover();
        });
        // Prevent closing when clicking inside
        popoverContent.addEventListener('click', (e) => e.stopPropagation());
        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!triggerBtn.contains(e.target) &&
                !popoverContent.contains(e.target)) {
                closePopover();
            }
        });
        // Initial Render
        renderOptions();
        updateUI();
        updateCodesForPost();
        }
               
        function shareholderComponent() {
            return {
                name: '',
                screeningList: [],
                addToScreeningList() {
                    if (!this.name.trim()) return;
                    this.screeningList.push({
                        id: Date.now(),
                        name: this.name,
                        type: 'Shareholder', // optional - you can change dynamically
                        initials: this.getInitials(this.name)
                    });
                    this.name = ''; // clear textbox
                },
                
                getInitials(fullName) {
                    return fullName
                        .split(' ')
                        .map(word => word[0])
                        .join('')
                        .toUpperCase()
                        .substring(0,2);
                }
            }
        }
