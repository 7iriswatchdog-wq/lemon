                                                    <option value="related_shareholder">Individual Related Parties</option>
                                                    <option value="related_corporate_shareholder">Corporate Related Parties</option>
                                                    <option value="shareholder">Individual Shareholder</option>
                                                    <option value="corporate_shareholder">Corporate Shareholder</option>
                                                    <option value="signatories">Authorized Signatory</option>
                                                    <option value="management">Senior Management</option>

