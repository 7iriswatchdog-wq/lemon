                                                <select x-model="manualForm.country" id="nationality" class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm appearance-none outline-none" asp-items="Model.Nationalities" asp-for="CorporateDetailList[0].Nationality">
                                                    <option value="">--@localizer["Select Country"]--</option>
                                                </select>
                                                <i data-lucide="chevron-down" class="w-4 h-4 absolute right-3 top-3 text-slate-400 pointer-events-none"></i>
                                            </div>
                                        </div>
                                          
                                        <div class="space-y-2">
                                            <label class="text-[13px] font-bold text-slate-700">Residence</label>
                                            <div class="relative">
                                                    <select x-model="manualForm.residence" id="residence" class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm appearance-none outline-none" asp-items="Model.Nationalities" asp-for="CorporateDetailList[0].Residence">
                                                    <option value="">Select</option>
                                                        <option value="">--@localizer["Select Country"]--</option>
