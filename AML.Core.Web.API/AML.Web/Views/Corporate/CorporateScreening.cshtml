    color: #0f172a;
    letter-spacing: -0.02em;
}
.cc-content-panel .cc-panel-desc {
    font-size: 13px;
    color: #64748b;
    margin-top: 2px;
}
.cc-info-banner {
    background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
    border: 1px solid #fde68a;
    border-radius: 10px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #92400e;
    font-weight: 500;
}
.cc-info-banner i { color: #f59e0b; flex-shrink: 0; }
.cc-content-panel input[type="text"],
.cc-content-panel input[type="email"],
.cc-content-panel input[type="number"],
