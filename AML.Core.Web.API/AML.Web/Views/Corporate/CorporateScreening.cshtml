                                                    <option value="0">--@localizer["EMPTY"]--</option>
                                                </select>
                                                <i data-lucide="chevron-down" class="w-4 h-4 absolute right-3 top-3 text-slate-400 pointer-events-none"></i>
                                                <span asp-validation-for="CorporateDetailList[0].BusinessType" class="validstyle" style="color:red"></span>
                                            </div>
                                        </div>
                                        }
                                        }
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">
                                                    Counter Party
                                                </label>

                                                <div class="relative">
                                                    <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm appearance-none outline-none" id="ddlCounterParty" asp-for="CorporateDetailList[0].CounterParty">
                                                        <option value="">Select</option>
                                                        <option value="Insurer">Insurer</option>
                                                        <option value="Bank">Bank</option>
                                                        <option value="Developer">Developer</option>
                                                    </select>
                                                    @* <i data-lucide="chevron-down" class="w-4 h-4 absolute right-4 top-3.5 text-slate-400 pointer-events-none"></i> *@
                                                </div>

                                            </div>
                                            <div class="space-y-2.5">
                                                <label class="text-[13px] font-bold text-slate-700">
                                                    Counter Party Name
                                                </label>

                                                <div class="relative">
                                                    <input type="text" placeholder="Enter Counter Party Name" asp-for="CorporateDetailList[0].CounterPartyName" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium outline-none" id="counterPartyName" min="3" max="50">
                                                    <span asp-validation-for="CorporateDetailList[0].CounterPartyName" class="validstyle" style="color:red"></span>
                                                    @* <i data-lucide="chevron-down" class="w-4 h-4 absolute right-4 top-3.5 text-slate-400 pointer-events-none"></i> *@
                                                </div>

                                            </div>
                                             @if(Model.ProductRiskCategory)
                                            {
                                            @if (Model.ProductTypeList != null && Model.ProductTypeList.Any())
                                                    {
                                        <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">Product/Service Type<span class="text-red-500">*</span></label>
                                            <div class="relative">
                                                <select x-model="manualForm.product" required class="w-full h-10 border border-slate-200 rounded-md px-3 text-sm appearance-none outline-none" asp-for="CorporateDetailList[0].ProductName" asp-items="Model.ProductTypeList" id="ddlProductType">
                                                    <option value="0">--@localizer["EMPTY"]--</option>
                                                </select>
                                                <i data-lucide="chevron-down" class="w-4 h-4 absolute right-3 top-3 text-slate-400 pointer-events-none"></i>
                                                <span asp-validation-for="CorporateDetailList[0].ProductName" class="validstyle" style="color:red"></span>
                                            </div>
                                        </div>
                                        }
                                        }
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">
                                                    Product/Service Value
