                                                            <line x1="21" y1="13" x2="23.5" y2="15.5" stroke-linecap="round"></line>

                                                        </svg>

                                                    </button>
                                                </div>
                                            <span asp-validation-for="CorporateDetailList[0].FirstName" class="validstyle" style="color:red"></span>
                                        </div>
                                            

                                             <div class="space-y-2.5 md:col-span-1">
                                            <label class="text-[13px] font-bold text-slate-700">Country of Incorporation</label>
