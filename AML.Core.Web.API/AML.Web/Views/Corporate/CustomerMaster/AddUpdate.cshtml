
@{
    ViewData["Title"] = "Customer Master";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.CustomerMaster.CustomerMasterModel
<style>
    #container {
        display: block;
        position: relative
    }

    .ui-autocomplete {
        position: absolute;
    }

        
</style>
<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />
<script type="text/javascript">
        var itemContent = [];
    $(function () {

        if ('@Model.CustomerReferenceId' != '0') {
            $('#txtCustomerID').val('@Model.CustomerReferenceId')
        }
        if ('@Model.IsDeleted' == '1') {
            $('#isDeletedc').prop('checked', true);
        }
        if ('@Model.Status' == '1') {
            $('#statuss').prop('checked', true);
        }

            $("#txtCustomerID").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Case/AutoCompleteCustomer/',
                        data: { "prefix": request.term },
                        type: "POST",
                        success: function (data) {
                            itemContent = data;
                            response($.map(data, function (item) {
                                return item.customerId;
                            }))
                        },
                        error: function (response) {
                            alert(response.responseText);
                        },
                        failure: function (response) {
                            alert(response.responseText);
                        }
                    });
                },
                appendTo: "#container",
                select: function (e, i) {
                    var code = i.item.value;
                    $("#hfCustomerID").val(code);
                },
                minLength: 3
            });
        });

        $(document).on('change', '#txtCustomerID', function () {
            $('#hfCustomerID').val($("#txtCustomerID").val());
        });
    $(document).on('change', '#isDeletedc', function () {
        var checkVal = ($('#isDeletedc').is(":checked") ? 1 : 0);
        $('#IsDeleted').val(checkVal);
    });

    $(document).on('change', '#statuss', function () {
        var checkVal = ($('#statuss').is(":checked") ? 1 : 0); 
        $('#Status').val(checkVal);
    });
    function fnSubmit() {
        $(".se-pre-con").show();
    }

</script>

<div class="card card-primary">
    <div class="card-header">
    </div>
    <!-- /.card-header -->
    <!-- form start -->
    <form role="form" asp-controller="CustomerMaster" asp-action="AddUpdate" class="form-horizontal" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="CreatedBy" />
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label for="txtCustomerID">Customer ID<span class="text-danger">*</span></label>
                        @if (Model.Id > 0)
                        {
                            <input type="text" class="form-control" id="txtCustomerID" placeholder="Customer Id" readonly>
                        }else{
                            <input type="text" class="form-control" id="txtCustomerID" placeholder="Customer Id">
                        }
                        <div id="container">
                        </div>
                        <span asp-validation-for="CustomerReferenceId" class="text-danger"></span>

                        <input type="hidden" asp-for="CustomerReferenceId" id="hfCustomerID">
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label for="txtFName">First Name <span class="text-danger">*</span></label>
                        <input type="text" asp-for="FirstName" class="form-control mandatory" id="txtFName" placeholder="First Name">
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label for="txtMiddleName">Middle Name</label>
                        <input type="text" asp-for="MiddleName" class="form-control mandatory" id="txtMName" placeholder="Middle Name">
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label for="txtLName">Last Name  <span class="text-danger">*</span></label>
                        <input type="text" asp-for="LastName" class="form-control mandatory" id="txtLName" placeholder="Last Name">
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label>Nationality <span class="text-danger">*</span></label>
                        <select id="ddlNationalities" class="form-control" asp-for="Nationality" asp-items="Model.Nationalities">
                            <option value="">--EMPTY--</option>
                        </select>
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                        <input type="hidden" asp-for="Nationality" id="hfNationality" />
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label for="dtDOB">Date of Birth <span class="text-danger">*</span></label>
                        <input type="date" asp-for="DOB" class="form-control mandatory" id="dtDOB" max="3000-12-31" placeholder="Date of Birth">
                        <span asp-validation-for="DOB" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label>Customer Type <span class="text-danger">*</span></label>
                        <select id="ddlCustType" class="form-control" asp-for="CustomerType" asp-items="Model.CustomerCategories">
                            <option value="">--EMPTY--</option>
                        </select>
                        <span asp-validation-for="CustomerType" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label>Id Type <span class="text-danger">*</span></label>
                        <select id="ddlIdType" class="form-control" asp-for="CustomerIdType" asp-items="Model.IdTypes">
                            <option value="">--EMPTY--</option>
                        </select>
                        <span asp-validation-for="CustomerIdType" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label for="txtIdNumber">Id Number <span class="text-danger">*</span></label>
                        <input type="text" asp-for="CustomerIdNumber" class="form-control" id="txtIdNumber" placeholder="Id Number">
                        <span asp-validation-for="CustomerIdNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label for="txtMobile">Mobile</label>
                        <input type="text" asp-for="Mobile" class="form-control" id="txtMobile" placeholder="Mobile">
                        <span asp-validation-for="Mobile" class="text-danger"></span>
                    </div>
                </div>
            </div>
            @if (Model.Id > 0)
            {
                <div class="row">
                    <div class="col">
                        <label for="txtCustomerFinalRiskScore">Risk Score</label>
                        <input type="text" asp-for="CustomerFinalRiskScore" class="form-control" id="txtCustomerFinalRiskScore" placeholder="Risk Score">
                        <span asp-validation-for="CustomerFinalRiskScore" class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label for="txtCustomerMatchScore">Match Score</label>
                        <input type="text" asp-for="CustomerScreenMatchScore" class="form-control" id="txtCustomerMatchScore" placeholder="Match Score">
                        <span asp-validation-for="CustomerScreenMatchScore" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="row">
                @if (Model.Id == 0)
                {
                    <div class="col">
                        <label for="txtBatchId">Batch ID</label>
                        <input type="text" asp-for="BatchId" class="form-control" id="txtBatchId" placeholder="Batch Id">
                        <span asp-validation-for="BatchId" class="text-danger"></span>
                    </div>
                    <div class="col center">
                        <center><label for="isDeleted">Is Deleted</label></center>
                        <input type="checkbox" class="form-control" id="isDeletedc">
                        <input type="hidden" asp-for="IsDeleted" />
                    </div>
                }
                <div class="col">
                    <center><label for="statuss">InActive?</label></center>
                    <input type="checkbox" class="form-control" id="statuss">
                    <input type="hidden" asp-for="Status" />
                </div>
            </div>
        </div>
        
        <!-- /.card-body -->

        <div class="card-footer">
            <button type="submit" class="btn btn-primary" onclick="fnSubmit()">Submit</button>
            <button type="button" class="btn btn-danger" onclick="location.href='/customermaster/list'">Cancel</button>
        </div>
    </form>
</div>