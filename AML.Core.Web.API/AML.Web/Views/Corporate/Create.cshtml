@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer

@{
    ViewData["Title"] = @localizer["Corporate Screening"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.Corporate.CorporateModel

<div class="card card-primary">
    <div class="px-6 py-4 border-b border-bordercolor">
        @localizer["Corporate Sanction Screening"]
    </div>
    <!-- /.card-header -->
    <!-- form start -->
    <form role="form" asp-controller="Corporate" asp-action="Create" class="form-horizontal" enctype="multipart/form-data" method="post">
        <input type="hidden" />
        <div class="p-6">
            <div class="col">
                <div class="col">
                    <div class="form-group">
                        <label for="txtCustomerID">
                            @localizer["License Number"]:</label>
                                                <input type="text" asp-for="LicenseNumber" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCustomerID" placeholder=@localizer["License Number"]>
                                                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
</div>
                    <div class="form-group">
                        <label for="txtLicenseName">
                            @localizer["Company Name"]:<span class="text - danger">*</span></label>
                                                <input type="text" asp-for="LicenseName" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtLicenseName" placeholder=@localizer["Company Name"]>
                                                <span asp-validation-for="LicenseName" class="text-danger"></span>
</div>

                    <div class="form-group">
                        <label for="txtMobileNo">
                            @localizer["Mobile Number"]:</label>
                                                <input type="text" asp-for="MobileNo" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtMobileNo" placeholder=@localizer["Mobile Number"]>
                                                <span asp-validation-for="MobileNo" class="text-danger"></span>
</div>
                    <div class="form-group">
                        <label for="">@localizer["Submit information for Sole Proprietor / Partner / Shareholder:"]</label>
          </div>
                    <div class="form-group">
                        <button type="button" id="addRow" onclick="addListRow()" class="btn btn-primary" title="@localizer["Add Shareholder"]" aria-label="@localizer["Add Shareholder"]"><i class="fas fa-plus"></i></button>
                                                <div id="cont"></div>
</div>

                </div>

            </div>
        </div>
        <!-- /.card-body -->

        <div class="card-footer">
            <button onclick="CallAPIwithList()" class="btn btn-primary" title="@localizer["Submit"]" aria-label="@localizer["Submit"]"><i class="fas fa-check"></i></button>
            <button type="button" class="btn btn-danger" onclick="location.href='@Url.Action("Create", "Corporate")'" title="@localizer["Cancel"]" aria-label="@localizer["Cancel"]"><i class="fas fa-times"></i></button>
</div>
    </form>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>



<script>
    var arrHead = new Array();
    arrHead = ['Action', 'First Name', 'Middle Name', 'Last Name'];
    contarr = []
    // first create TABLE structure with the headers.
    function createTable() {
        var empTable = document.createElement('table');
        empTable.setAttribute('id', 'empTable'); // table id.

        var tr = empTable.insertRow(-1);
        for (var h = 0; h < arrHead.length; h++) {
            var th = document.createElement('th');// create table headers
            th.innerHTML = arrHead[h];
            tr.appendChild(th);
        }

        var div = document.getElementById('cont');
        div.appendChild(empTable);  // add the TABLE to the container.
    }

    // now, add a new to the TABLE.
    function addListRow() {
        // array for header.

        var empTab = document.getElementById('empTable');

        var rowCnt = empTab.rows.length;   // table row count.
        var tr = empTab.insertRow(rowCnt); // the table row.
        tr = empTab.insertRow(rowCnt);

        for (var c = 0; c < arrHead.length; c++) {
            var td = document.createElement('td'); // table definition.
            td = tr.insertCell(c);

            if (c == 0) {      // the first column.
                // add a button in every new row in the first column.
                var button = document.createElement('input');

                // set input attributes.
                button.setAttribute('type', 'button');
                button.setAttribute('value', @localizer["Remove"]);

                // add button's 'onclick' event.
                button.setAttribute('onclick', 'removeRow(this)');

                td.appendChild(button);
            }
            else {
                // 2nd, 3rd and 4th column, will have textbox.
                var ele = document.createElement('input');
                ele.setAttribute('type', 'text');
                ele.setAttribute('value', '');

                td.appendChild(ele);
            }
        }
    }
    function isEmpty(obj) {
        return Object.keys(obj).length === 0;
    }
    // delete TABLE row function.
    function removeRow(oButton) {
        var empTab = document.getElementById('empTable');
        empTab.deleteRow(oButton.parentNode.parentNode.rowIndex); // button -> td -> tr.
    }

    function sendForScrenning(values) {
        //alert(JSON.stringify(values))
        var valuesToSend = {
            "Id": "10006",
            "CustomerId": "",
            "MatchCategory": "CORPORATE",
            "FirstName": values[0],
            "MiddleName": values[1],
            "LastName": values[2],
            "CustomerIdType": "A-717288a",
            "CustomerIdNumber": "1234",
            "Nationality": "IN",
            "DOB": "1999-09-09",
            "Mobile": "42",
            "CreatedOn": ""

        }
        $.ajax({
            url: "/api/customer",
            type: "POST",
            data: valuesToSend,
            contentType: 'application/json',
            success: function (result) {
                alert(JSON.stringify(result))
                console.log(result);
            },
            error: function (error) {
                alert(JSON.stringify(result))
                console.log(error);
            }
        });
    }

    // function to extract and submit table data.
    function CallAPIwithList() {
        var companyName = document.getElementById('txtLicenseName').value;
        if (companyName !== '') {
            var myTab = document.getElementById('empTable');
            var arrValues = new Array();
            // loop through each row of the table.
            for (row = 1; row < myTab.rows.length - 1; row++) {
                // loop through each cell in a row.
                var rowValues = {};
                for (c = 0; c < myTab.rows[row].cells.length; c++) {

                    var element = myTab.rows.item(row).cells[c];

                    if (element.childNodes[0].getAttribute('type') == 'text') {
                        rowValues[c] = element.childNodes[0].value;
                    }

                }
                //alert(JSON.stringify(rowValues));
                if (!isEmpty(rowValues))
                    sendForScrenning(rowValues);
            }

        }
        else {
            alert('Please enter Company Name')
        }

    }
</script>
<script>
    $(document).ready(function () {
        createTable();
        addListRow();
    });
</script>
