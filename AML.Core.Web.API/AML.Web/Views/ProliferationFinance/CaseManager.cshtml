@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Proliferation Finance - Case Manager";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<div class="p-8 space-y-8 max-w-[1600px] mx-auto min-h-screen text-slate-900" style="font-family: 'Inter', sans-serif;">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Proliferation Finance - Case Manager</h1>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-sm font-bold text-slate-800 tracking-tight">Case Filter</h3>
            <div class="flex items-center gap-3">
                <button onclick="resetFilters()" class="bg-blue-600 hover:bg-blue-600 text-white font-bold h-10 px-6 rounded-md text-sm transition-all shadow-sm">
                    Reset
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-6 gap-4 items-end">
            <!-- Start Date -->
            <div class="space-y-2">
                <label class="text-[12px] font-bold text-slate-500 tracking-wider">Start Date</label>
                <input type="date" id="startDate" class="h-10 w-full rounded-md border border-slate-200 px-3 text-sm focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm transition-all">
            </div>

            <!-- End Date -->
            <div class="space-y-2">
                <label class="text-[12px] font-bold text-slate-500 tracking-wider">End Date</label>
                <input type="date" id="endDate" class="h-10 w-full rounded-md border border-slate-200 px-3 text-sm focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm transition-all">
            </div>

            <!-- Datasets -->
            <div class="space-y-2">
                <label class="text-[12px] font-bold text-slate-500 tracking-wider">Datasets</label>
                <select id="customerTypeFilter" class="h-10 w-full rounded-md border border-slate-200 bg-white px-3 text-sm focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm transition-all appearance-none">
                    <option value="0">All</option>
                    <option value="Chemical">Chemical</option>
                    <option value="Non-Chemical">Non-Chemical</option>
                </select>
            </div>

            <!-- Status -->
            <div class="space-y-2">
                <label class="text-[12px] font-bold text-slate-500 tracking-wider">Status</label>
                <select id="statusFilter" class="h-10 w-full rounded-md border border-slate-200 bg-white px-3 text-sm focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm transition-all appearance-none">
                    <option value="0">All</option>
                    <option value="Pending">Pending</option>
                    <option value="True Match">True Match</option>
                    <option value="False Match">False Match</option>
                    <option value="Potential Match">Potential Match</option>
                    <option value="No Match">No Match</option>
                    <option value="Submit to Senior Management">Submit to Senior Management</option>
                    <option value="Hold">Hold</option>
                </select>
            </div>

            <!-- Buttons -->
            <div class="flex items-center gap-3">
                <!-- Apply Filter -->
                <button onclick="loadCases()" id="applyBtn"
                        class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold h-10 px-5 rounded-md text-sm transition">
                    Apply
                </button>

                <!-- Export -->
                <button onclick="ExportList(false)" id="exportBtn"
                        class="flex items-center gap-2 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold h-10 px-5 rounded-md text-sm transition">
                    <i data-lucide="download" class="h-4 w-4"></i>
                    Export
                </button>
            </div>
        </div>
    </div>

    <style>
        .dt-loader { display: inline-block; position: relative; width: 80px; height: 20px; }
        .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0, 1, 1, 0); }
        .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
        .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
        .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
        .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
        @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
        @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
        @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
    </style>

    <!-- Table Section -->
    <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
            <div class="relative flex-1 w-full">
                <i data-lucide="search" class="absolute left-3.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-slate-400"></i>
                <input type="text" id="searchInput" placeholder="Search by Search Detail" onkeyup="filterTable()"
                       class="pl-10 h-11 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/20 focus-visible:border-blue-500 shadow-sm transition-all placeholder:text-slate-500">
            </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden relative min-h-[400px]">
            <!-- Table Loader Overlay -->
            <div id="tableLoader" class="absolute inset-0 bg-white/80 backdrop-blur-[2px] z-50 flex flex-col items-center justify-center gap-4 transition-all duration-300 hidden">
                <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
                <div class="text-sm font-bold text-slate-600 animate-pulse tracking-wide">Loading Case Data...</div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left table-fixed border-collapse">
                    <thead class="text-[10px] text-slate-500 bg-white border-b border-slate-200">
                        <tr>
                            <th class="px-2 py-4 h-12">ID</th>
                            <th class="px-2 py-4 h-12">Created on</th>
                            <th class="px-2 py-4 h-12">Updated on</th>
                            <th class="px-2 py-4 h-12">Search Detail</th>
                            <th class="px-2 py-4 h-12">Datasets</th>
                            <th class="px-2 py-4 h-12">Status</th>
                            <th class="px-2 py-4 h-12">Action</th>
                        </tr>
                    </thead>
                    <tbody id="casesTableBody" class="divide-y divide-slate-100" style="font-size: 12px;">
                        <!-- Rows will be injected here via AJAX -->
                    </tbody>
                </table>
            </div>

            <!-- Consolidated Pagination Footer (Aligned with Due Diligence) -->
            <div class="flex items-center justify-between px-4 py-4 border-t border-slate-200 bg-white">
                <div class="flex items-center gap-4 text-xs font-medium text-slate-500">
                    <div class="flex items-center gap-2">
                        <select id="pageSize" onchange="changePageSize()" class="h-8 w-20 rounded-md border border-slate-200 bg-white pl-3 pr-8 text-xs font-bold text-slate-700 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all cursor-pointer">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <span>Entries per page</span>
                    </div>
                    <div class="h-4 w-px bg-slate-200"></div>
                    <div id="paginationInfo">
                        Showing <span class="font-bold text-slate-900" id="startRange">0</span> to <span class="font-bold text-slate-900" id="endRange">0</span> of <span class="font-bold text-slate-900" id="totalEntries">0</span> cases
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="changePage(-1)" id="prevBtn" class="flex items-center gap-1.5 px-4 h-8 rounded-md border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                        <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i> Previous
                    </button>
                    <button onclick="changePage(1)" id="nextBtn" class="flex items-center gap-1.5 px-4 h-8 rounded-md border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                        Next <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- View Details Modal -->
<div id="detailsModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
    <div class="bg-white rounded-xl shadow-lg w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <div>
                <h3 class="text-lg font-bold text-slate-900 tracking-tight">Case Details</h3>
                <p id="modalCaseId" class="text-sm text-slate-500 mt-0.5">ID: -</p>
            </div>
            <button type="button" onclick="closeModal()" class="text-slate-400 hover:text-slate-600 hover:bg-slate-100 p-2 rounded-full transition-colors">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>
        <!-- Body -->
        <div class="p-6 overflow-y-auto" id="modalContent">
            <!-- Content Injected here -->
        </div>
        <!-- Footer -->
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex justify-end">
            <button type="button" onclick="closeModal()" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 hover:text-slate-900 transition-colors shadow-sm">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    lucide.createIcons();

    function showLoader() {
        $('#tableLoader').removeClass('hidden').addClass('flex');
    }

    function hideLoader() {
        $('#tableLoader').addClass('hidden').removeClass('flex');
    }

    function formatDateTime(dateStr) {
        if (!dateStr) return { date: '-', time: '-' };
        const d = new Date(dateStr);
        return {
            date: d.toLocaleDateString('en-GB'),
            time: d.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
            })
        };
    }

    let allCases = [];
    let currentPage = 1;
    let pageSize = 10;
    let filteredCases = [];

    $(document).ready(function() {
        // Compute today and one year ago
        const todayLocal = new Date().toLocaleDateString('en-CA'); // yyyy-mm-dd
        const oneYearAgo = new Date();
        oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
        const oneYearAgoLocal = oneYearAgo.toLocaleDateString('en-CA'); // yyyy-mm-dd

        // Set default date range to last 1 year
        $('#startDate').val(oneYearAgoLocal);
        $('#endDate').val(todayLocal);

        // Restrict End Date to today (local time)
        const endDateInput = document.getElementById('endDate');
        if (endDateInput) {
            endDateInput.setAttribute('max', todayLocal);
        }

        // Prevent future dates
        $('#endDate').on('change', function() {
            if (this.value > todayLocal) {
                this.value = todayLocal;
                toastr.warning('End date cannot be in the future.');
            }
        });

        lucide.createIcons();
        loadCases();
    });

    function resetFilters() {
        const todayLocal = new Date().toLocaleDateString('en-CA');
        const oneYearAgo = new Date();
        oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
        const oneYearAgoLocal = oneYearAgo.toLocaleDateString('en-CA');

        $('#startDate').val(oneYearAgoLocal);
        $('#endDate').val(todayLocal);
        $('#customerTypeFilter').val('0');
        $('#statusFilter').val('0');
        $('#searchInput').val('');
        loadCases();
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        renderTable();
    }

    function loadCases() {
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();
        const customerType = $('#customerTypeFilter').val();
        const status = $('#statusFilter').val();

        showLoader();
        $.ajax({
            url: '/ProliferationFinance/GetAllCases',
            type: 'GET',
            data: { 
                startDate: startDate, 
                endDate: endDate, 
                customerType: customerType,
                status: status
            },
            success: function(response) {
                hideLoader();
                if(response.success) {
                    allCases = response.data || [];
                    filteredCases = allCases;
                    currentPage = 1;
                    renderTable();
                } else {
                    console.error("Failed to load cases: ", response.message);
                }
            },
            error: function(err) {
                hideLoader();
                console.error("Error loading cases", err);
            }
        });
    }

    function renderTable() {
        const data = filteredCases;
        const totalEntries = data.length;
        const totalPages = Math.ceil(totalEntries / pageSize) || 1;
        
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIdx = (currentPage - 1) * pageSize;
        const endIdx = Math.min(startIdx + pageSize, totalEntries);
        const pageData = data.slice(startIdx, endIdx);

        let rows = '';
        if (pageData.length === 0) {
            rows = `<tr><td colspan="10" class="h-24 text-center"><div class="text-slate-500 font-medium">No results found.</div></td></tr>`;
        } else {
            pageData.forEach((item, idx) => {
                const id           = item.id           || item.Id || 0;
                const caseRefId    = item.caseRefId    || item.CaseRefId || (id ? 'PF-' + id : '-');
                const createdDate  = item.createdOn    || item.CreatedOn;
                const updatedDate  = item.updatedOn    || item.UpdatedOn;
                const chemName     = item.chemicalName || item.ChemicalName || '-';
                const hsCode       = item.hsCode       || item.HsCode       || '-';
                const casNum       = item.casNumber    || item.CasNumber    || '-';
                const eccn         = item.eccn         || item.Eccn         || '-';
                const synonym      = item.synonymName  || item.SynonymName  || '-';
                const status       = item.status       || item.Status       || 'Pending';
                const hitDetails   = item.searchHitDetails || item.SearchHitDetails || '';

                let datasets = [];
                const hasChemical = (chemName && chemName !== '-' && chemName !== 'N/A') || 
                                    (hsCode && hsCode !== '-' && hsCode !== 'N/A') || 
                                    (casNum && casNum !== '-' && casNum !== 'N/A') || 
                                    (eccn && eccn !== '-' && eccn !== 'N/A') || 
                                    (synonym && synonym !== '-' && synonym !== 'N/A');
                const hasNonChemical = hitDetails && hitDetails.trim() !== '';

                if (hasChemical) datasets.push('Chemical');
                if (hasNonChemical) datasets.push('Non-Chemical');
                const datasetstr = datasets.length > 0 ? datasets.join(', ') : 'Chemical';

                const created = formatDateTime(createdDate);
                const updated = formatDateTime(updatedDate);

                let statusClass = 'bg-slate-100 text-slate-800';
                const s = status.toLowerCase();
                if (s.includes('pending')) statusClass = 'bg-yellow-100 text-yellow-800';
                else if (s.includes('approved') || s.includes('true match')) statusClass = 'bg-blue-100 text-blue-800';
                else if (s.includes('transfer')) statusClass = 'bg-green-100 text-green-800';
                else if (s.includes('rejected') || s.includes('false match')) statusClass = 'bg-red-100 text-red-800';

                rows += `
                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                    <td class="px-2 py-4 font-normal text-slate-700">${caseRefId}</td>
                    <td class="px-2 py-4">
                        <div class="text-xs text-slate-700">
                            <div>${created.date}</div>
                            <div class="ml-2 text-slate-400 font-normal">${created.time.replace(/\s?(AM|PM)/i, '')}</div>
                        </div>
                    </td>
                    <td class="px-2 py-4">
                        <div class="text-xs text-slate-700">
                            <div>${updated.date !== '-' ? updated.date : '-'}</div>
                            <div class="ml-2 text-slate-400 font-normal">${updated.time !== '-' ? updated.time.replace(/\s?(AM|PM)/i, '') : ''}</div>
                        </div>
                    </td>
                    <td class="px-2 py-4 text-slate-700 font-medium" 
                        title="Product: ${chemName}\nHS Code: ${hsCode}\nCAS: ${casNum}\nECCN: ${eccn}\nSynonym: ${synonym}">
                        <div class="truncate text-[12px]">
                            ${[chemName, hsCode, casNum, eccn, synonym].find(x => x && x !== '-' && x !== 'N/A') || '-'}
                        </div>
                    </td>
                    <td class="px-2 py-4">
                        <span class="px-2 py-0.5 rounded text-slate-600 text-[12px] font-bold">
                            ${datasetstr}
                        </span>
                    </td>
                    <td class="px-2 py-4 text-center">
                        <div class="flex items-center justify-center">
                            <span class="flex w-full items-center justify-center px-2 py-1 rounded-full text-[12px] font-bold ${statusClass} ring-1 ring-inset ${statusClass.replace('bg-', 'ring-').replace('100', '200')}">
                                ${status}
                            </span>
                        </div>
                    </td>
                    <td class="px-2 py-4">
                         <div class="flex items-center justify-start gap-2 underline">
                            <a href="/ProliferationFinance/Process/${id}" class="text-blue-600 hover:text-blue-700 font-bold flex items-center gap-1">
                                Process
                             </a>
                        </div>
                    </td>
                </tr>`;
            });
        }
        
        window._displayedCases = pageData;
        $('#casesTableBody').html(rows);
        
        // Update pagination UI
        $('#totalEntries').text(totalEntries);
        $('#startRange').text(totalEntries > 0 ? startIdx + 1 : 0);
        $('#endRange').text(endIdx);
        
        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', currentPage === totalPages || totalEntries === 0);
        
        lucide.createIcons();
    }

    function changePage(dir) {
        currentPage += dir;
        renderTable();
    }

    function goToPage(page) {
        currentPage = page;
        renderTable();
    }

    function filterTable() {
        const searchTerm = $('#searchInput').val().toLowerCase();
        if(!searchTerm) {
            filteredCases = allCases;
        } else {
            filteredCases = allCases.filter(item => {
                const id = (item.caseRefId || item.CaseRefId || 'PF-' + (item.id || item.Id)).toLowerCase();
                const chem = (item.chemicalName || item.ChemicalName || '').toLowerCase();
                const hs = (item.hsCode || item.HsCode || '').toLowerCase();
                const cas = (item.casNumber || item.CasNumber || '').toLowerCase();
                return id.includes(searchTerm) || chem.includes(searchTerm) || hs.includes(searchTerm) || cas.includes(searchTerm);
            });
        }
        currentPage = 1;
        renderTable();
    }
 
    function highlight(text, keyword) {
        if (!text || !keyword) return text || '';
        const esc = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp(`(${esc})`, 'gi'),
            '<mark style="background:#fef08a;color:#713f12;border-radius:3px;padding:0 2px;font-weight:700;">$1</mark>');
    }

    function viewDetails(idx) {
        const item = (window._displayedCases || allCases)[parseInt(idx)];
        if (!item) return;

        const id           = item.id           || item.Id           || '-';
        const customerType = item.customerType || item.CustomerType || '-';
        const corporateId  = item.corporateId  || item.CorporateId  || '-';
        const companyName  = item.companyName  || item.CompanyName  || '-';
        const hsCode       = item.hsCode       || item.HsCode       || '-';
        const casNumber    = item.casNumber    || item.CasNumber    || '-';
        const eccn         = item.eccn         || item.Eccn         || '-';
        const chemicalName = item.chemicalName || item.ChemicalName || '-';
        const synonymName  = item.synonymName  || item.SynonymName  || '-';

        $('#modalCaseId').text('ID: ' + id);

        let content = '';
        if (customerType === 'Non-Chemical') {
            // synonymName = search keyword, chemicalName = matched paragraph from PDF
            const highlightedParagraph = highlight(chemicalName, synonymName);
            const paragraphs = highlightedParagraph.split(/\n\n+/).map(p =>
                `<div class="bg-slate-50 p-4 rounded-lg border border-slate-100 text-sm text-slate-700 leading-relaxed mb-3">${p}</div>`
            ).join('');

            content = `
                <div class="space-y-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Customer Type</span>
                            <p class="mt-1"><span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-50 text-purple-700 ring-1 ring-purple-200">Non-Chemical</span></p>
                        </div>
                        <div>
                            <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Corporate ID</span>
                            <p class="font-semibold text-slate-900 mt-1">${corporateId}</p>
                        </div>
                        <div class="col-span-2">
                            <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Company Name</span>
                            <p class="font-bold text-slate-900 mt-1">${companyName}</p>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-sm font-bold text-slate-800">PDF Search Result</h4>
                            <span class="text-[11px] font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full ring-1 ring-blue-100">
                                Keyword: ${synonymName !== '-' ? synonymName : 'N/A'}
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-400 mb-2">Source: Scan Resolution 156 of 2025</p>
                        ${paragraphs}
                    </div>
                </div>`;
        } else {
            content = `
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Customer Type</span>
                        <p class="mt-1"><span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 ring-1 ring-blue-200">${customerType}</span></p>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Corporate ID</span>
                        <p class="font-semibold text-slate-900 mt-1">${corporateId}</p>
                    </div>
                    <div class="col-span-2">
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Company Name</span>
                        <p class="font-bold text-slate-900 mt-1">${companyName}</p>
                    </div>

                    <div class="col-span-2 pt-4 border-t border-slate-100">
                        <h4 class="text-sm font-bold text-slate-800 mb-3">Searched Chemical Profile</h4>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">HS Code</span>
                        <p class="font-medium text-slate-900 mt-1">${hsCode}</p>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">CAS Number</span>
                        <p class="font-medium text-slate-900 mt-1">${casNumber}</p>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">ECCN</span>
                        <p class="font-medium text-slate-900 mt-1">${eccn}</p>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Product Name</span>
                        <p class="font-medium text-slate-900 mt-1">${chemicalName}</p>
                    </div>
                    <div class="col-span-2">
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wide">Synonym Name</span>
                        <p class="font-medium text-slate-900 mt-1">${synonymName}</p>
                    </div>
                </div>`;
        }

        $('#modalContent').html(content);
        $('#detailsModal').removeClass('hidden');
    }

    function closeModal() {
        $('#detailsModal').addClass('hidden');
    }
</script>
