@using Microsoft.AspNetCore.Http;
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@inject IHttpContextAccessor HttpContextAccessor
@using Newtonsoft.Json;
@{
    ViewData["Title"] = "Proliferation Finance - Case Creation";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
@model AML.ViewModel.ViewModels.ProliferationFinance.ProliferationFinanceModel

<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proliferation Finance Case Creation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }
        [x-cloak] { display: none !important; }
        .scrollbar-thin::-webkit-scrollbar { width: 5px; }
        .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
        .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dt-loader { display: inline-block; position: relative; width: 80px; height: 20px; }
        .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0, 1, 1, 0); }
        .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
        .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
        .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
        .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
        @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
        @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
        @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
    </style>
</head>

<body class="bg-[#f8fafc] text-slate-900 overflow-hidden" x-data="caseCreationData()">
    <div class="flex h-screen overflow-hidden">
        <div id="loadingeffect" class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-10" style="display:none;" x-show="isLoading">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        </div>

        <div class="flex-1 flex flex-col min-w-0 bg-[#f8fafc]">
            <!-- Header -->
            <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 sticky top-0 z-40 shrink-0">
                <div class="flex items-center gap-4">
                    <button @@click="sidebarOpen = !sidebarOpen" class="p-2 hover:bg-slate-100 rounded-lg transition-colors text-slate-500">
                        <i data-lucide="panel-left-close" class="w-5 h-5"></i>
                    </button>
                    <h2 class="text-xl font-bold text-slate-900 tracking-tight">Proliferation Finance - Case Creation</h2>
                </div>
            </header>

            <!-- Page Body -->
            <main class="flex-1 overflow-hidden p-8">
                <div class="flex h-full gap-8 max-w-[1600px] mx-auto">

                    <!-- Left: Method Selection -->
                    <div class="w-full lg:w-1/4 flex flex-col h-full bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden min-w-[340px]">
                        <div class="p-8 space-y-8 flex-1 overflow-y-auto scrollbar-thin">
                        <div class="space-y-1">
                            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Case Creation</h1>
                            <p class="text-slate-500 text-sm font-medium leading-relaxed">Select an input method to get started.</p>
                        </div>

                        <div class="grid gap-3">
                            <!-- Goods Details Card (Consolidated) -->
                            <div @@click="selectedMethod = 'goods'; showResults = false"
                                 class="relative p-4 rounded-xl border-2 transition-all cursor-pointer flex items-start gap-4 group"
                                 :class="selectedMethod === 'goods' ? 'border-blue-600 bg-blue-50/30 ring-1 ring-blue-600 shadow-sm' : 'border-slate-200 bg-white hover:border-blue-200 hover:bg-slate-50'">
                                <div class="p-2 rounded-lg shrink-0 transition-colors"
                                     :class="selectedMethod === 'goods' ? 'bg-blue-100 text-blue-600' : 'bg-slate-100 text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-500'">
                                    <i data-lucide="package" class="w-5 h-5"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-bold text-sm tracking-tight" :class="selectedMethod === 'goods' ? 'text-blue-900' : 'text-slate-900'">Goods Details</h3>
                                    <p class="text-[11px] font-medium text-slate-500 mt-0.5 leading-relaxed">Search via Chemical Details or Keywords</p>
                                </div>
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-blue-600 absolute top-4 right-4" x-show="selectedMethod === 'goods'"></i>
                            </div>

                            <!-- Bulk Upload Card -->
                            <div @@click="selectedMethod = 'bulkupload'; showResults = false"
                                 class="relative p-4 rounded-xl border-2 transition-all cursor-pointer flex items-start gap-4 group"
                                 :class="selectedMethod === 'bulkupload' ? 'border-blue-600 bg-blue-50/30 ring-1 ring-blue-600 shadow-sm' : 'border-slate-200 bg-white hover:border-blue-200 hover:bg-slate-50'">
                                <div class="p-2 rounded-lg shrink-0 transition-colors"
                                     :class="selectedMethod === 'bulkupload' ? 'bg-blue-100 text-blue-600' : 'bg-slate-100 text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-500'">
                                    <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-bold text-sm tracking-tight" :class="selectedMethod === 'bulkupload' ? 'text-blue-900' : 'text-slate-900'">Bulk Upload</h3>
                                    <p class="text-[11px] font-medium text-slate-500 mt-0.5 leading-relaxed">Upload multiple cases via Excel template</p>
                                </div>
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-blue-600 absolute top-4 right-4" x-show="selectedMethod === 'bulkupload'"></i>
                            </div>

                            <!-- Goods Search Card -->
                            <div @@click="selectedMethod = 'goodssearch'; showResults = false"
                                 class="relative p-4 rounded-xl border-2 transition-all cursor-pointer flex items-start gap-4 group"
                                 :class="selectedMethod === 'goodssearch' ? 'border-blue-600 bg-blue-50/30 ring-1 ring-blue-600 shadow-sm' : 'border-slate-200 bg-white hover:border-blue-200 hover:bg-slate-50'">
                                <div class="p-2 rounded-lg shrink-0 transition-colors"
                                     :class="selectedMethod === 'goodssearch' ? 'bg-blue-100 text-blue-600' : 'bg-slate-100 text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-500'">
                                    <i data-lucide="search" class="w-5 h-5"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-bold text-sm tracking-tight" :class="selectedMethod === 'goodssearch' ? 'text-blue-900' : 'text-slate-900'">Goods Search</h3>
                                    <p class="text-[11px] font-medium text-slate-500 mt-0.5 leading-relaxed">Search UAE Control List directly</p>
                                </div>
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-blue-600 absolute top-4 right-4" x-show="selectedMethod === 'goodssearch'"></i>
                            </div>
                        </div>
                    </div>
                </div>

                    <!-- Right: Dynamic Content Area -->
                    <div class="flex-1 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                        <div class="flex-1 overflow-y-auto p-8 scrollbar-thin">

                            <!-- Creation Forms -->
                            <div x-show="!showResults" class="space-y-6">
                                <!-- FORM HEADER -->
                                <div class="pb-6 border-b mb-6">
                                    <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight" x-text="selectedMethod === 'goods' ? 'Goods Details Input' : (selectedMethod === 'bulkupload' ? 'Bulk Screening Upload' : 'Goods Search')"></h2>
                                    <p class="text-sm text-slate-500 font-medium mt-1" x-text="selectedMethod === 'goods' ? 'Enter Corporate ID and at least one chemical or keyword detail to search and create a case.' : (selectedMethod === 'bulkupload' ? 'Upload an Excel file to process multiple cases simultaneously.' : 'Search the UAE Control List for chemicals or non-chemical goods.')"></p>
                                </div>

                                <!-- GOODS DETAILS FORM (Consolidated) -->
                                <div x-show="selectedMethod === 'goods'" x-transition:enter="transition duration-300" x-transition:enter-start="opacity-0 translate-x-4" class="space-y-8">
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-10 gap-6 items-end">
                                        <!-- Corporate / Individual ID -->
                                        <div class="space-y-2 md:col-span-4">
                                            <label class="text-[13px] font-bold text-slate-700">Corporate / Individual ID <span class="text-red-500">*</span></label>
                                            <input type="text" x-model="formData.corporateId" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all" placeholder="Enter Corporate or Individual ID">
                                        </div>
                                        <!-- Fetch Button -->
                                        <div class="md:col-span-2">
                                            <button type="button" @@click="fetchCorporateDetails()" class="w-full h-11 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl transition-all shadow-sm flex items-center justify-center">
                                                Fetch Name
                                            </button>
                                        </div>
                                        <!-- Fetched Name Display -->
                                        <div class="space-y-2 md:col-span-4">
                                            <label class="text-[13px] font-bold text-slate-700">Name</label>
                                            <input type="text" x-model="formData.companyName" disabled class="w-full h-11 bg-slate-50 border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-700 cursor-not-allowed">
                                        </div>
                                    </div>

                                    <!-- Goods Search Fields (Hidden until Company Found) -->
                                    <div x-show="formData.companyName" x-transition:enter="transition ease-out duration-300 transform" x-transition:enter-start="opacity-0 translate-y-4" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-8 mt-8" style="display:none;">
                                        <div class="col-span-2 pt-4 border-t border-slate-100">
                                            <h3 class="text-sm font-bold text-slate-900 mb-4">Screening Details <span class="text-xs font-normal text-slate-500 ml-2">(Fill at least one to search)</span></h3>
                                        </div>

                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">HS Code</label>
                                                <input type="text" x-model="formData.hsCode" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all" placeholder="Enter HS Code">
                                            </div>

                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">CAS Number</label>
                                                <input type="text" x-model="formData.casNumber" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all" placeholder="Enter CAS Number">
                                            </div>

                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">ECCN</label>
                                                <input type="text" x-model="formData.eccn" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all" placeholder="Enter ECCN">
                                            </div>

                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">Product Name</label>
                                                <input type="text" x-model="formData.chemicalName" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all" placeholder="Enter Product Name">
                                            </div>

                                            <div class="space-y-2 col-span-2 md:col-span-1">
                                                <label class="text-[13px] font-bold text-slate-700">Synonym Name</label>
                                                <input type="text" x-model="formData.synonymName" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all" placeholder="Enter Synonym Name">
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="grid grid-cols-4 gap-4 mt-12 pt-8 border-t border-slate-100">
                                            <button type="button" @@click="submitSearch()" class="col-span-3 h-14 bg-blue-600 hover:bg-blue-700 text-white font-extrabold rounded-2xl shadow-xl shadow-blue-500/30 transition-all active:scale-[0.98] flex items-center justify-center gap-3">
                                                <i data-lucide="search" class="w-5 h-5"></i> Create Case
                                            </button>
                                            <button type="button" @@click="resetForm()" class="h-14 bg-white border-2 border-slate-200 text-slate-600 font-extrabold rounded-2xl hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
                                                <i data-lucide="rotate-ccw" class="w-4 h-4 text-slate-400"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>


                                <!-- GOODS SEARCH MODULE (New) -->
                                <div x-show="selectedMethod === 'goodssearch'" x-transition:enter="transition duration-300" x-transition:enter-start="opacity-0 translate-x-4" class="space-y-8" style="display:none;">
                                    <!-- Tabs -->
                                    <div class="flex items-center gap-2 p-1 bg-slate-100 rounded-xl w-fit">
                                        <button @@click="selectedSearchType = 'chemical'; showGoodsSearchResults = false" 
                                                class="px-6 py-2 rounded-lg text-xs font-bold transition-all"
                                                :class="selectedSearchType === 'chemical' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'">
                                            Chemical Search
                                        </button>
                                        <button @@click="selectedSearchType = 'nonchemical'; showGoodsSearchResults = false" 
                                                class="px-6 py-2 rounded-lg text-xs font-bold transition-all"
                                                :class="selectedSearchType === 'nonchemical' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'">
                                            Non-Chemical Search
                                        </button>
                                    </div>

                                    <!-- Chemical Search Form -->
                                    <div x-show="selectedSearchType === 'chemical'" class="space-y-6">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">HS Code</label>
                                                <input type="text" x-model="searchForm.chemical.hsCode" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all shadow-sm" placeholder="Enter HS Code">
                                            </div>
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">CAS Number</label>
                                                <input type="text" x-model="searchForm.chemical.casNumber" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all shadow-sm" placeholder="Enter CAS Number">
                                            </div>
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">ECCN</label>
                                                <input type="text" x-model="searchForm.chemical.eccn" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all shadow-sm" placeholder="Enter ECCN">
                                            </div>
                                            <div class="space-y-2">
                                                <label class="text-[13px] font-bold text-slate-700">Chemical Name</label>
                                                <input type="text" x-model="searchForm.chemical.chemicalName" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all shadow-sm" placeholder="Enter Chemical Name">
                                            </div>
                                            <div class="space-y-2 md:col-span-2">
                                                <label class="text-[13px] font-bold text-slate-700">Synonym Name</label>
                                                <input type="text" x-model="searchForm.chemical.synonymName" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all shadow-sm" placeholder="Enter Synonym Name">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Non-Chemical Search Form -->
                                    <div x-show="selectedSearchType === 'nonchemical'" class="space-y-6" style="display:none;">
                                        <div class="space-y-2">
                                            <label class="text-[13px] font-bold text-slate-700">Search Keyword</label>
                                            <input type="text" x-model="searchForm.nonchemical.keyword" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all shadow-sm" placeholder="Search across documents...">
                                        </div>
                                    </div>

                                    <!-- Search Button -->
                                    <div class="pt-4">
                                        <button type="button" @@click="searchGoods()" class="w-full md:w-fit px-12 h-12 bg-blue-600 hover:bg-blue-700 text-white font-extrabold rounded-xl shadow-lg shadow-blue-500/20 transition-all active:scale-95 flex items-center justify-center gap-2">
                                            <i data-lucide="search" class="w-4 h-4"></i> Search
                                        </button>
                                    </div>

                                    <!-- Results Area -->
                                    <div x-show="showGoodsSearchResults" x-transition class="space-y-6 pt-10 border-t border-slate-100">
                                        <div class="flex items-center justify-between">
                                            <h3 class="text-base font-bold text-slate-900 tracking-tight">Search Results</h3>
                                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest" x-text="goodsSearchResults.length + ' Matches Found'"></span>
                                        </div>

                                        <!-- Chemical Result Cards -->
                                        <template x-if="selectedSearchType === 'chemical'">
                                            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                                                <template x-for="(result, index) in goodsSearchResults" :key="index">
                                                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col group hover:shadow-md transition-all duration-300">
                                                        <div class="h-1.5 w-full bg-[#c19b48]"></div>
                                                        <div class="p-5 flex-1 space-y-4">
                                                            <div class="space-y-1">
                                                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Chemical Name</p>
                                                                <p class="text-sm font-extrabold text-slate-900 line-clamp-2 min-h-[40px]" x-text="result.chemicalName || result.ChemicalName || '-'"></p>
                                                            </div>
                                                            <div class="grid grid-cols-2 gap-4">
                                                                <div class="space-y-1">
                                                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">HS Code</p>
                                                                    <p class="text-[11px] font-bold text-slate-700" x-text="result.hsCode || result.HsCode || '-'"></p>
                                                                </div>
                                                                <div class="space-y-1">
                                                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">CAS Number</p>
                                                                    <p class="text-[11px] font-bold text-slate-700" x-text="result.casNumber || result.CasNumber || '-'"></p>
                                                                </div>
                                                                <div class="space-y-1">
                                                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">ECCN</p>
                                                                    <p class="text-[11px] font-bold text-slate-700" x-text="result.eccn || result.Eccn || '-'"></p>
                                                                </div>
                                                                <div class="space-y-1">
                                                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Synonym</p>
                                                                    <p class="text-[11px] font-bold text-slate-700 truncate" x-text="result.synonymName || result.SynonymName || '-'"></p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="flex border-t border-slate-100">
                                                            <button @@click="openModal(result)" class="flex-1 h-10 bg-slate-50 hover:bg-slate-100 text-slate-600 font-bold text-[11px] transition-colors border-r border-slate-100 uppercase tracking-wider">
                                                                View Details
                                                            </button>
                                                            <button @@click="addToCaseFromSearch(result)" class="w-12 h-10 bg-[#c19b48] hover:bg-[#a6853d] text-white flex items-center justify-center transition-colors">
                                                                <i data-lucide="plus" class="w-5 h-5"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>

                                        <!-- Non-Chemical Result Paragraphs -->
                                        <template x-if="selectedSearchType === 'nonchemical'">
                                            <div class="space-y-4">
                                                <template x-for="(para, index) in goodsSearchResults" :key="index">
                                                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm group hover:border-blue-200 transition-all relative overflow-hidden">
                                                        <div class="absolute left-0 top-0 bottom-0 w-1 bg-blue-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                                        <p class="text-sm text-slate-700 leading-relaxed italic" x-html="highlightKeyword(para, searchForm.nonchemical.keyword)"></p>
                                                        <div class="mt-4 flex justify-end">
                                                            <button @@click="addToCaseFromSearch({chemicalName: para, customerType: 'Non-Chemical'})" class="h-8 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[10px] font-bold uppercase tracking-widest shadow-lg shadow-blue-500/10 active:scale-95 transition-all flex items-center gap-2">
                                                                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add to Case
                                                            </button>
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>

                                        <!-- No results state -->
                                        <div x-show="goodsSearchResults.length === 0" class="flex flex-col items-center justify-center py-20 text-center bg-slate-50/50 rounded-3xl border border-dashed border-slate-200">
                                            <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mb-4 text-slate-300 shadow-sm">
                                                <i data-lucide="search-x" class="w-8 h-8"></i>
                                            </div>
                                            <h3 class="text-lg font-bold text-slate-900 tracking-tight">No matches found</h3>
                                            <p class="text-sm text-slate-400 mt-1 max-w-[280px] font-medium">Try different keywords or check the inputs for spelling errors.</p>
                                        </div>
                                    </div>
                                </div>


                                <!-- BULK UPLOAD FORM -->
