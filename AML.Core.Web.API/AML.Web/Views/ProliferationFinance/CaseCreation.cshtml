    <script>
        function caseCreationData() {
            return {
                sidebarOpen: true,
                selectedMethod: 'goods',
                isLoading: false,
                showResults: false,
                isModalOpen: false,
                isSuccessModalOpen: false,
                caseRefId: '',
                score: '0',
                copied: false,
                formData: {
                    customerType: 'Goods',
                    corporateId: '',
                    companyName: '',
                    hsCode: '',
                    casNumber: '',
                    eccn: '',
                    chemicalName: '',
                    synonymName: '',
                    searchKeyword: '',
                    matchedParagraph: ''
                },
                isDragging: false,
                bulkResults: null,
                selectedSearchType: 'chemical',
                showGoodsSearchResults: false,
                goodsSearchResults: [],
                searchForm: {
                    chemical: { hsCode: '', casNumber: '', eccn: '', chemicalName: '', synonymName: '' },
                    nonchemical: { keyword: '' }
                },

                resetForm() {
                    this.formData = {
                        customerType: 'Goods',
                        corporateId: this.formData.corporateId, 
                        companyName: this.formData.companyName,
                        hsCode: '',
                        casNumber: '',
                        eccn: '',
                        chemicalName: '',
                        synonymName: '',
                        searchKeyword: '',
                        matchedParagraph: ''
                    };
                    this.showResults = false;
                    this.showGoodsSearchResults = false;
                    this.searchResults = [];
                    this.goodsSearchResults = [];
                    this.nonChemicalResults = [];
                    this.selectedFile = null;
                    this.bulkResults = null;
                    this.isDragging = false;
                    this.searchForm = {
                        chemical: { hsCode: '', casNumber: '', eccn: '', chemicalName: '', synonymName: '' },
                        nonchemical: { keyword: '' }
                    };
                },

                async fetchCorporateDetails() {
                    if (!this.formData.corporateId) {
                        toastr.error('Please enter a Corporate or Individual ID.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                        return;
                    }
                    this.isLoading = true;
                    try {
                        const searchTypes = ['C', 'I'];
                        for (const type of searchTypes) {
                            const formData = new URLSearchParams();
                            formData.append('CompanyCode', this.formData.corporateId);
                            formData.append('CustomerType', type);
                            
                            let result = await fetch('/Corporate/SearchCompanyCode', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: formData
                            });
                            let data = await result.json();
                            if (data && data.length > 0) {
                                this.formData.companyName = data[0].firstName || data[0].lastName;
                                return;
                            }
                        }
                        
                        this.formData.companyName = '';
                        toastr.error('No ID was found for the entered value.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                    } catch (err) {
                        console.error(err);
                        toastr.error('Error fetching company details.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                        
                    } finally {
                        this.isLoading = false;
                    }
                },

                async submitSearch() {
                    // Validation: At least one field populated
                    const fd = this.formData;
                    if (!fd.hsCode && !fd.casNumber && !fd.eccn && !fd.chemicalName && !fd.synonymName && !fd.searchKeyword) {
                       toastr.error('Please fill at least one screening detail field.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                       
                        return;
                    }
                    if (!fd.corporateId) {
                        toastr.error('Corporate ID is required to create a case.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                        
                        return;
                    }

                    this.isLoading = true;
                    try {
                        let response = await fetch('/ProliferationFinance/SearchChemicals', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.formData)
                        });
                        
                        let data = await response.json();
                        
                        if (data && data.success) {
                            this.caseRefId = data.caseRefId;
                            this.score = data.score || '0';
                            this.isSuccessModalOpen = true;
                        } else {
                             toastr.error(data.message || 'Error creating case', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                            
                        }
                    } catch (e) {
                         console.error(e);
                          toastr.error('Server error occurred.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                         
                    } finally {
                        this.isLoading = false;
                    }
                },


                closeSuccess() {
                    this.isSuccessModalOpen = false;
                    this.resetForm();
                },

                highlightKeyword(text, keyword) {
                    if (!text || !keyword) return text || '';
                    // Escape special regex chars in keyword, then wrap matches in <mark>
                    const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const regex = new RegExp(`(${escaped})`, 'gi');
                    return text.replace(regex, '<mark style="background:#fef08a;color:#713f12;border-radius:3px;padding:0 2px;font-weight:600;">$1</mark>');
                },

                openModal(resultItem) {
                    this.selectedResult = resultItem;
                    this.isModalOpen = true;
                },

                handleFileSelect(file) {
                    if (!file) return;
                    this.selectedFile = file;
                    this.bulkResults = null;
                },

                async submitBulkUpload() {
                    if (!this.selectedFile) return;
                    
                    this.isLoading = true;
                    this.bulkResults = null;
                    
                    const formData = new FormData();
                    formData.append('file', this.selectedFile);

                    try {
                        let response = await fetch('/ProliferationFinance/BulkUploadCases', {
                            method: 'POST',
                            body: formData
                        });

                        let data = await response.json();
                        if (data && data.success) {
                            this.bulkResults = data.summary;
                            this.$nextTick(() => lucide.createIcons());
                        } else {
                             toastr.error(data.message || 'Error occurred during bulk upload', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                            
                        }
                    } catch (e) {
                        console.error(e);
                        toastr.error('Server error processing Excel file.', {
                            tapToDismiss: true,
                            showMethod: 'fadeIn',
                            showDuration: 200
                        });
                        
                    } finally {
                        this.isLoading = false;
                        // Reset file input
                        if (this.$refs.fileInput) {
                            this.$refs.fileInput.value = '';
                        }
                    }
                },

                async searchGoods() {
                    const type = this.selectedSearchType;
                    const criteria = type === 'chemical' ? this.searchForm.chemical : { chemicalName: this.searchForm.nonchemical.keyword };
                    
                    // Basic validation
                    if (type === 'chemical' && !Object.values(criteria).some(x => x)) {
                        toastr.warning('Please enter at least one search criterion.');
                        return;
                    }
                    if (type === 'nonchemical' && !criteria.chemicalName) {
                        toastr.warning('Please enter a search keyword.');
                        return;
                    }

                    this.isLoading = true;
                    this.showGoodsSearchResults = false;
                    this.goodsSearchResults = [];

                    try {
                        let response = await fetch('/ProliferationFinance/SearchChemicalsOnly', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                ...criteria,
                                customerType: type === 'chemical' ? 'Chemical' : 'Non-Chemical'
                            })
                        });
                        
                        let data = await response.json();
                        if (data && data.success) {
                            this.goodsSearchResults = data.results || [];
                            this.showGoodsSearchResults = true;
                            this.$nextTick(() => lucide.createIcons());
                        } else {
                            toastr.error(data.message || 'Error fetching search results');
                        }
                    } catch (e) {
                        console.error(e);
                        // Fallback/Demo: If endpoint doesn't exist yet, show local results if this is for UI demo
                        // toastr.error('Server error during search.');
                        
                        // NOTE: For demo purposes if endpoint is missing, we could mock it. 
                        // But I will stick to the assumed server implementation.
                    } finally {
                        this.isLoading = false;
                    }
                },

                async addToCaseFromSearch(result) {
                    if (!this.formData.corporateId) {
                        toastr.error('Please enter and fetch a Corporate/Individual ID first.');
                        // Switch back to goods tab to fill ID
                        // Or I could just scroll up.
                        return;
                    }

                    this.isLoading = true;
                    try {
                        // Prepare full search payload from result
                        const payload = {
                            corporateId: this.formData.corporateId,
                            companyName: this.formData.companyName,
                            hsCode: result.hsCode || result.HsCode || '',
                            casNumber: result.casNumber || result.CasNumber || '',
                            eccn: result.eccn || result.Eccn || '',
                            chemicalName: result.chemicalName || result.ChemicalName || '',
                            synonymName: result.synonymName || result.SynonymName || '',
                            customerType: result.customerType || (this.selectedSearchType === 'chemical' ? 'Chemical' : 'Non-Chemical')
                        };

                        let response = await fetch('/ProliferationFinance/SearchChemicals', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        
                        let data = await response.json();
                        if (data && data.success) {
                            this.caseRefId = data.caseRefId;
                            this.score = data.score || '0';
                            this.isSuccessModalOpen = true;
                        } else {
                            toastr.error(data.message || 'Error creating case');
                        }
                    } catch (e) {
                         console.error(e);
                         toastr.error('Error creating case from search result.');
                    } finally {
                        this.isLoading = false;
                    }
                }
            }
        }

        // Initialize Lucide icons
        document.addEventListener('alpine:init', () => {
             lucide.createIcons();
        });
    </script>

    <!-- MODAL: SUCCESS -->
    <div x-show="isSuccessModalOpen" x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-md transition-all duration-200"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0">
        <div @@click.away="closeSuccess()"
             class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-10 text-center relative overflow-hidden">
            <button @@click="closeSuccess()"
                    class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 transition">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <div class="absolute top-0 left-0 right-0 h-2 bg-emerald-500"></div>
            <div class="flex flex-col items-center gap-8">
                <div class="w-24 h-24 bg-emerald-50 rounded-full flex items-center justify-center ring-8 ring-emerald-50/50">
                    <i data-lucide="check-circle" class="w-12 h-12 text-emerald-500"></i>
                </div>
                <div class="space-y-3">
                    <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Case Created Successful!</h2>
                    <div class="flex items-center justify-center gap-6 py-2">
                        <div>
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Reference ID</p>
                            <p class="text-xl font-black text-blue-600" x-text="caseRefId"></p>
                        </div>
                    </div>
                    <p class="text-sm font-medium text-slate-500 leading-relaxed px-4">
                        Your case has been successfully created. <br><br>
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4 w-full pt-4">
                    <button class="h-14 border-2 border-slate-200 rounded-2xl font-extrabold text-slate-700 hover:bg-slate-50 flex items-center justify-center gap-2"
                            @@click="navigator.clipboard.writeText(caseRefId);copied=true;setTimeout(()=>copied = false, 2000);">
                        <i data-lucide="copy" class="w-4 h-4"></i>
                        <span x-text="copied ? 'Copied!' : 'Copy'"></span>
                    </button>
                    <a href="/ProliferationFinance/CaseManager"
                       class="h-14 bg-blue-600 text-white font-extrabold rounded-2xl flex items-center justify-center w-full">
                        Go to Case
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
