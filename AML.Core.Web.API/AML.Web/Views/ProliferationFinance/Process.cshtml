@model AML.ViewModel.ViewModels.ProliferationFinance.ProliferationFinanceModel
@using System.Linq
@{
    ViewData["Title"] = "Proliferation Finance - Process Case";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<body class="bg-slate-50/30 min-h-screen text-slate-900">
    <!-- Loader Overlay -->
    <div id="processLoader" class="fixed inset-0 bg-white/80 backdrop-blur-md z-[9999] flex flex-col items-center justify-center gap-6 transition-all duration-300 hidden">
        <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        <div class="flex flex-col items-center gap-2">
            <div class="text-xl font-bold text-slate-900 tracking-tight">Processing...</div>
            <div class="text-sm font-medium text-slate-500 animate-pulse">Please wait while we save your data...</div>
        </div>
    </div>
    <div class="p-4 sm:p-6 min-h-screen flex flex-col">
        <!-- Header -->
        <div class="shrink-0 pb-2">
            <h1 class="text-lg font-black text-slate-900 tracking-tight mb-2">Case Manager</h1>

            <!-- Case Details Summary -->
            <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-4 w-1 bg-blue-600 rounded-full"></div>
                    <h2 class="text-base font-bold text-slate-900 leading-none">Case Details</h2>
                </div>

                <div class="grid w-full gap-4" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));">
                    <!-- Corporate -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Corporate Id</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 truncate">@Model.CorporateId</div>
                    </div>
                    <!-- ID -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">ID</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1">PF-@Model.CaseId</div>
                    </div>

                    <!-- Created on -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Created on</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1">@Model.CreatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>

                    <!-- Updated on -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Updated on</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1">@Model.UpdatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>

                    <!-- Chemical Name -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Chemical Name</div>
                        <div class="text-[12px] font-bold text-slate-900 mt-1 truncate" title="@Model.ChemicalName">@(string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName)</div>
                    </div>

                    <!-- HS Code -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">HS Code</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.HsCode) ? "-" : Model.HsCode)</div>
                    </div>

                    <!-- CAS Number -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">CAS Number</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.CasNumber) ? "-" : Model.CasNumber)</div>
                    </div>

                    <!-- ECCN -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">ECCN</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.Eccn) ? "-" : Model.Eccn)</div>
                    </div>

                    <!-- Synonym -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Synonym</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 truncate" title="@Model.SynonymName">@(string.IsNullOrEmpty(Model.SynonymName) ? "-" : Model.SynonymName)</div>
                    </div>

                    

                    <!-- Status -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Status</div>
                        <div class="mt-1">
                            @{
                                var statusStr = Model.Status ?? "Pending";
                                var sLower = statusStr.ToLower();
                                var statusClass = "bg-slate-100 text-slate-800 ring-slate-200";
                                if (sLower.Contains("pending")) statusClass = "bg-yellow-100 text-yellow-800 ring-yellow-200";
                                else if (sLower.Contains("approved") || sLower.Contains("true match")) statusClass = "bg-blue-100 text-blue-800 ring-blue-200";
                                else if (sLower.Contains("transfer")) statusClass = "bg-green-100 text-green-800 ring-green-200";
                                else if (sLower.Contains("rejected") || sLower.Contains("false match")) statusClass = "bg-red-100 text-red-800 ring-red-200";
                            }
                            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold uppercase @statusClass ring-1 ring-inset">@Model.Status</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-1 min-h-0 py-2 overflow-hidden flex w-full">
            <!-- MAIN CONTENT COLUMN -->
            <div id="mainColumn" class="flex-1 min-w-0 flex flex-col gap-6 overflow-y-auto pr-2 custom-scrollbar">
                
                <!-- Search Results Card -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden shrink-0">
                    <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-white shrink-0">
                        <h3 class="text-[13px] font-bold text-slate-800 tracking-tight">Search Results</h3>
                    </div>

                    <div class="max-h-[400px] overflow-y-auto custom-scrollbar border-b border-slate-100">
                        <table class="w-full text-sm text-left table-fixed border-collapse">
                            <thead class="text-[12px] font-bold text-slate-500 tracking-tight bg-slate-50 sticky top-0 z-20">
                                <tr class="border-b border-slate-200">
                                    <th class="px-4 py-3">Product</th>
                                    <th class="px-4 py-3">Details</th>
                                    <th class="px-4 py-3">Search Type</th>
                                    <th class="px-4 py-3">Remarks</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-[11px]">
                                @if (Model.CustomerType == "Non-Chemical")
                                {
                                    var pdfContent = Model.ChemicalName;
                                    var paragraphs = string.IsNullOrEmpty(pdfContent) ? new string[] { } : pdfContent.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                    if (paragraphs.Length > 0)
                                    {
                                        var index = 0;
                                        foreach (var para in paragraphs)
                                        {
                                            var savedHit = Model.MongoHits?.FirstOrDefault(h => h.Snippet == para && h.SearchType == "Non-Chemical");
                                            <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="@index" data-type="Non-Chemical">
                                                <td class="px-4 py-3 align-top">
                                                    <div class="truncate text-slate-700 font-medium" title="@para">
                                                        @para
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <a href="/ProliferationFinance/Details/@Model.CaseId?type=non-chemical" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                        Details
                                                    </a>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                        <option value="">Select Action</option>
                                                        <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                        <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                        <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                        <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                    </select>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors" data-index="0">
                                            <td class="px-4 py-3 align-top text-slate-400 italic">No matches found in scan</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                        </tr>
                                    }
                                }
                                else if (Model.CustomerType == "Goods" || Model.CustomerType == "Chemical")
                                {
                                    var rowIndex = 0;
                                    <!-- 1. Database Matches -->
                                    if (Model.MatchedChemicals != null && Model.MatchedChemicals.Count > 0)
                                    {
                                        foreach (var match in Model.MatchedChemicals)
                                        {
                                            var savedHit = Model.MongoHits?.FirstOrDefault(h => h.ChemicalId == match.Id);
                                            <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="@rowIndex" data-type="Chemical">
                                                <td class="px-4 py-3 font-bold text-slate-900">
                                                    <div class="flex items-center gap-2">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                                                        <div class="truncate" title="@match.ChemicalName">
                                                            @(!string.IsNullOrEmpty(match.ChemicalName) ? match.ChemicalName : "-")
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <a href="/ProliferationFinance/Details/@Model.CaseId?chemicalId=@match.Id&type=chemical" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                        Details
                                                    </a>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                        <option value="">Select Action</option>
                                                        <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                        <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                        <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                        <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                    </select>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                                </td>
                                            </tr>
                                            rowIndex++;
                                        }
                                    }
                                    else
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors" data-index="0">
                                            <td colspan="@(Model.CustomerType == "Goods" ? 6 : 5)" class="px-4 py-3 text-slate-400 italic">No matches found in UAE Control List</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                        </tr>
                                    }

                                    <!-- 2. PDF Snippet Rows -->
                                    @if (!string.IsNullOrEmpty(Model.SearchHitDetails))
                                    {
                                        var snippets = Model.SearchHitDetails.Split(new[] { "\n\n", "---" }, StringSplitOptions.RemoveEmptyEntries);
                                        var snippetIndex = 0;
                                        foreach (var snip in snippets)
                                        {
                                            var savedHit = Model.MongoHits?.FirstOrDefault(h => h.Snippet == snip && h.Index == snippetIndex && h.SearchType == "Non-Chemical");
                                            <tr class="bg-slate-50/50 hover:bg-slate-100 transition-colors search-hit-row" data-index="@snippetIndex" data-type="Non-Chemical">
                                                <td class="px-4 py-2 border-l-2 border-blue-200">
                                                    <div class="flex items-start gap-3">
                                                        <i class="fa fa-file-pdf-o text-blue-400 mt-1"></i>
                                                        <div class="pdf-snippet text-[10px] text-slate-600 leading-relaxed italic truncate font-medium" title="@snip">
                                                            "@snip.Trim()" <span class="ml-2 text-[9px] font-bold text-blue-600 uppercase">[PDF Snippet]</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2">
                                                    <a href="/ProliferationFinance/Details/@Model.CaseId?type=non-chemical" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                        Details
                                                    </a>
                                                </td>
                                                <td class="px-4 py-2">
                                                    <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                        <option value="">Select Action</option>
                                                        <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                        <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                        <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                        <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                    </select>
                                                </td>
                                                <td class="px-4 py-2">
                                                    <textarea class="search-remarks-area h-7 w-full border border-slate-100 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all bg-white" placeholder="Snippet remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                                </td>
                                            </tr>
                                            snippetIndex++;
                                        }
                                    }
                                }
                                else
                                {
                                    <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0" data-type="Chemical">
                                        <td class="px-4 py-3 font-bold text-slate-900 truncate">
                                            @(!string.IsNullOrEmpty(Model.MatchedChemicalName) ? Model.MatchedChemicalName : (string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName))
                                        </td>
                                        <td class="px-4 py-3">
                                            <a href="/ProliferationFinance/Details/@Model.CaseId" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                Details
                                            </a>
                                        </td>
                                        <td class="px-4 py-3">
                                            <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                <option value="">Select Action</option>
                                                <option value="True Match" selected="@(Model.Status == "True Match")">True Match</option>
                                                <option value="False Match" selected="@(Model.Status == "False Match")">False Match</option>
                                                <option value="Potential Match" selected="@(Model.Status == "Potential Match")">Potential Match</option>
                                                <option value="No Match" selected="@(Model.Status == "No Match")">No Match</option>
                                            </select>
                                        </td>
                                        <td class="px-4 py-3">
                                            <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(Model.StatusReason ?? "")</textarea>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
                    <div class="px-5 py-3 border-t border-slate-100 bg-slate-50/30 flex justify-end">
                        <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] h-8 px-6 rounded-md shadow-sm transition-all tracking-tight" onclick="saveRemarks()">
                            Save Search Action
                        </button>
                    </div>
                </div>

                <!-- Case History & Comments Card (Aligned with Case/Process) -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col flex-1 min-h-[400px] mb-4">
                    <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-white shrink-0">
                        <h3 class="text-[13px] font-bold text-slate-800 tracking-tight">Case Comments</h3>
                    </div>
                    <div class="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50/20 custom-scrollbar" id="commentsContainer">
                        <div class="text-xs text-slate-400 italic">Loading comments...</div>
                    </div>
                    <div class="p-5 border-t border-slate-100 bg-white">
                        <div class="flex gap-4">
                            <textarea id="caseComment" oninput="toggleSaveButton()" class="flex-1 h-12 border border-slate-200 rounded-lg p-3 text-[11px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none resize-none placeholder:text-slate-400 font-medium" placeholder="Enter Your Comments"></textarea>
                            <button id="btnSaveComment" onclick="saveComment()" disabled class="h-12 px-8 bg-white border border-slate-200 text-slate-400 font-bold rounded-md transition-all cursor-not-allowed opacity-50">
                                Save
                            </button>
                        </div>
                        
                        <!-- Main Decision Buttons Alignment -->
                         <div class="mt-6 flex flex-col md:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-100">
                            <div class="flex items-center gap-3 w-full">
                                <button onclick="updateDecision('Submit to Senior Management')" class="h-9 px-6 rounded-md bg-white border border-slate-200 text-slate-700 text-[10px] font-bold hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm uppercase tracking-widest">
                                    <i data-lucide="send" class="h-3.5 w-3.5"></i> Submit to Senior Management
                                </button>
                                <button onclick="updateDecision('Hold')" class="h-9 px-6 rounded-md bg-white border border-slate-200 text-slate-700 text-[10px] font-bold hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm uppercase tracking-widest mr-auto">
                                    <i data-lucide="pause-circle" class="h-3.5 w-3.5"></i> Hold
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</body>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

    .dt-loader { display: inline-block; position: relative; width: 80px; height: 20px; }
    .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0, 1, 1, 0); }
    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
</style>

<script>

    function toggleSaveButton() {
        const comment = $('#caseComment').val().trim();
        const $btn = $('#btnSaveComment');
        if (comment.length > 0) {
            $btn.prop('disabled', false)
                .removeClass('text-slate-400 cursor-not-allowed opacity-50')
                .addClass('text-slate-600 hover:bg-slate-50');
        } else {
            $btn.prop('disabled', true)
                .addClass('text-slate-400 cursor-not-allowed opacity-50')
                .removeClass('text-slate-600 hover:bg-slate-50');
        }
    }

    function updateDecision(decision) {
        const comment = $('#caseComment').val();

        $.ajax({
            url: '/ProliferationFinance/UpdateStatus',
            type: 'POST',
            data: { caseId: @Model.CaseId, status: decision },
            success: function(res) {
                if (res.success) {
                    toastr.success('Case status updated to ' + decision);
                    if (comment.trim()) {
                        $.ajax({
                            url: '/ProliferationFinance/UpdateRemarks',
                            type: 'POST',
                            data: { caseId: @Model.CaseId, remarks: comment },
                            complete: function() {
                                setTimeout(() => location.reload(), 1500);
                            }
                        });
                    } else {
                        setTimeout(() => location.reload(), 1500);
                    }
                } else {
                    toastr.error(res.message || 'Error saving decision.');
                }
            },
            error: function() {
                toastr.error('Error connecting to server.');
            }
        });
    }

    function saveComment() {
        const comment = $('#caseComment').val();
        if (!comment.trim()) {
            return;
        }

        $.ajax({
            url: '/ProliferationFinance/UpdateRemarks',
            type: 'POST',
            data: { caseId: @Model.CaseId, remarks: comment },
            success: function(res) {
                if (res.success) {
                    toastr.success('Comment saved successfully');
                    $('#caseComment').val(''); // Clear the input
                    setTimeout(() => location.reload(), 1500); // Silent reload to show updated history
                } else {
                    toastr.error(res.message || 'Error saving comment.');
                }
            },
            error: function() {
                toastr.error('Error connecting to server.');
            }
        });
    }

        function uploadDocument(input) {
            if (!input.files || !input.files[0]) return;
            
            const formData = new FormData();
            formData.append('caseId', '@Model.CaseId');
            formData.append('file', input.files[0]);

            $('#loadingeffect').show();
            
            $.ajax({
                url: '/ProliferationFinance/UploadDocument',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#loadingeffect').hide();
                    if (res.success) {
                        toastr.success('Document uploaded successfully');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toastr.error('Upload failed: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    toastr.error('Error uploading document');
                }
            });
        }

        function saveRemarks() {
            const hits = [];
            $('.search-hit-row').each(function() {
                const row = $(this);
                const decision = row.find('.search-decision-select').val();
                const remark = row.find('.search-remarks-area').val();
                hits.push({
                    index: row.data('index'),
                    searchType: row.data('type') || 'Chemical',
                    decision: decision || '',
                    remarks: remark || ''
                });
            });

            $('#loadingeffect').show();
            var corporateId='@Model.CorporateId';
            var companyName='@Model.CompanyName';

            $.ajax({
                url: '/ProliferationFinance/SaveSearchHits',
                type: 'POST',
                data: JSON.stringify({
                    caseId: @Model.CaseId,
                    corporateId: corporateId,
                    FirstName:companyName,
                    hits: hits
                }),
                contentType: 'application/json',
                success: function(res) {
                    if (res.success) {
                        toastr.success('Search actions saved successfully');
                        
                        // Update Status Badge logic after save success
                        let newStatus = '';
                        const trueMatchFound = hits.some(h => h.decision === 'True Match');
                        if (trueMatchFound) {
                            newStatus = 'True Match';
                        } else if (hits.length > 0) {
                            newStatus = hits[0].decision || 'Pending';
                        }

                        if (newStatus && newStatus !== 'Pending') {
                            $.ajax({
                                url: '/ProliferationFinance/UpdateStatus',
                                type: 'POST',
                                data: { caseId: @Model.CaseId, status: newStatus },
                                success: function() {
                                    setTimeout(() => location.reload(), 1500);
                                },
                                complete: () => $('#loadingeffect').hide()
                            });
                        } else {
                            $('#loadingeffect').hide();
                            setTimeout(() => location.reload(), 1500);
                        }
                    } else {
                        $('#loadingeffect').hide();
                        toastr.error('Failed to save actions: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    toastr.error('Error saving search actions');
                }
            });
        }

    function loadComments() {
        const caseId = @Model.CaseId;
        $.ajax({
            url: '/ProliferationFinance/GetComments',
            type: 'GET',
            data: { caseId: caseId },
            success: function(res) {
                if (res.success && res.data) {
                    let html = '';
                    if (res.data.length === 0) {
                        html = '<div id="noCommentsMsg" class="text-xs text-slate-500 italic text-center py-4">No comments found for this case.</div>';
                    } else {
                        res.data.forEach(comment => {
                            const date = comment.createdOn || '-';
                            const user = comment.createdByEmail || 'User';
                            const initials = (user.charAt(0) || 'U').toUpperCase();
                            
                            html += `
                            <div class="flex gap-4 mb-4">
                                <div class="shrink-0 h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-xs">${initials}</div>
                                <div class="flex-1">
                                    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm">
                                        <p class="text-[11px] text-slate-700 leading-relaxed font-medium">${comment.comment}</p>
                                    </div>
                                    <div class="mt-2 flex items-center gap-2 text-[9px] font-bold text-slate-400 uppercase tracking-widest px-1">
                                        <span>${user}</span>
                                        <span class="h-1 w-1 rounded-full bg-slate-200"></span>
                                        <span>${date}</span>
                                    </div>
                                </div>
                            </div>`;
                        });
                    }
                    $('#commentsContainer').html(html);
                }
            }
        });
    }

    $(document).ready(function() {
        lucide.createIcons();
        loadComments();
    });
    </script>
