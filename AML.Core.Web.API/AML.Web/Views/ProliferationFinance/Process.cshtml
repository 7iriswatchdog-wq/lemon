@model AML.ViewModel.ViewModels.ProliferationFinance.ProliferationFinanceModel
@{
    ViewData["Title"] = "Proliferation Finance - Process Case";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<body class="bg-slate-50/30 min-h-screen text-slate-900">
    <div class="p-4 sm:p-6 min-h-screen flex flex-col">
        <!-- Header -->
        <div class="shrink-0 pb-2">
            <h1 class="text-lg font-black text-slate-900 tracking-tight mb-2">Case Manager</h1>

            <!-- Case Details Summary -->
            <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-4 w-1 bg-blue-600 rounded-full"></div>
                    <h2 class="text-base font-bold text-slate-900 leading-none">Case Details</h2>
                </div>

                <div class="grid w-full gap-4" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));">
                    <!-- ID -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">ID</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1">PF-@Model.CaseId</div>
                    </div>

                    <!-- Created on -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Created on</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1">@Model.CreatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>

                    <!-- Updated on -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Updated on</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1">@Model.UpdatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>

                    <!-- Chemical Name -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Chemical Name</div>
                        <div class="text-[12px] font-bold text-slate-900 mt-1 truncate" title="@Model.ChemicalName">@(string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName)</div>
                    </div>

                    <!-- HS Code -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">HS Code</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.HsCode) ? "-" : Model.HsCode)</div>
                    </div>

                    <!-- CAS Number -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">CAS Number</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.CasNumber) ? "-" : Model.CasNumber)</div>
                    </div>

                    <!-- ECCN -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">ECCN</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.Eccn) ? "-" : Model.Eccn)</div>
                    </div>

                    <!-- Synonym -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Synonym</div>
                        <div class="text-[12px] font-bold text-slate-800 mt-1 truncate" title="@Model.SynonymName">@(string.IsNullOrEmpty(Model.SynonymName) ? "-" : Model.SynonymName)</div>
                    </div>

                    <!-- Status -->
                    <div class="px-1 py-1">
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Status</div>
                        <div class="mt-1">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 ring-1 ring-blue-100 uppercase">@Model.Status</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-1 min-h-0 py-2 overflow-hidden flex w-full">
            <!-- MAIN CONTENT COLUMN -->
            <div id="mainColumn" class="flex-1 min-w-0 flex flex-col gap-6 overflow-y-auto pr-2 custom-scrollbar">
                
                <!-- Search Results Card -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden shrink-0">
                    <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-white shrink-0">
                        <h3 class="text-[13px] font-bold text-slate-800 tracking-tight">Search Results</h3>
                    </div>

                    <div class="max-h-[400px] overflow-y-auto custom-scrollbar border-b border-slate-100">
                        <table class="w-full text-sm text-left whitespace-nowrap border-collapse">
                            <thead class="text-[10px] font-bold text-slate-500 uppercase tracking-tight bg-slate-50 sticky top-0 z-20">
                                <tr class="border-b border-slate-200">
                                    @if (Model.CustomerType == "Non-Chemical")
                                    {
                                        <th class="px-4 py-3 whitespace-nowrap w-[600px]">Matched Paragraph</th>
                                    }
                                    else
                                    {
                                        <th class="px-4 py-3 min-w-[150px]">Chemical Name</th>
                                        <th class="px-4 py-3">HS Code</th>
                                        <th class="px-4 py-3">CAS Number</th>
                                        <th class="px-4 py-3">ECCN</th>
                                        <th class="px-4 py-3">Synonym Name</th>
                                        @if (Model.CustomerType == "Goods")
                                        {
                                            <th class="px-4 py-3 w-[300px]">Non-Chemical Match</th>
                                        }
                                    }
                                    <th class="px-4 py-3 text-center">Action</th>
                                    <th class="px-4 py-3 min-w-[160px]">Search Remarks</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-[11px]">
                                @if (Model.CustomerType == "Non-Chemical")
                                {
                                    var pdfContent = Model.ChemicalName;
                                    var paragraphs = string.IsNullOrEmpty(pdfContent) ? new string[] { } : pdfContent.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                    if (paragraphs.Length > 0)
                                    {
                                        var index = 0;
                                        foreach (var para in paragraphs)
                                        {
                                            <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="@index">
                                                <td class="px-4 py-3 align-top">
                                                    <div class="max-w-[600px] line-clamp-2 whitespace-normal break-normal leading-relaxed text-slate-700 font-medium" title="@para">
                                                        @para
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <a href="/ProliferationFinance/Details/@Model.CaseId" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                        Details
                                                    </a>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks..."></textarea>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0">
                                            <td class="px-4 py-3 align-top text-slate-400 italic">No matches found in scan</td>
                                            <td class="px-4 py-3 text-center text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                        </tr>
                                    }
                                }
                                else if (Model.CustomerType == "Goods")
                                {
                                    <!-- 1. Database Match Row -->
                                    <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0">
                                        <td class="px-4 py-3 font-bold text-slate-900">
                                            <div class="flex items-center gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                                @(!string.IsNullOrEmpty(Model.MatchedChemicalName) ? Model.MatchedChemicalName : (string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName))
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 text-slate-600 uppercase">@(!string.IsNullOrEmpty(Model.HsCode) ? Model.HsCode : "-")</td>
                                        <td class="px-4 py-3 text-slate-600 uppercase">@(!string.IsNullOrEmpty(Model.CasNumber) ? Model.CasNumber : "-")</td>
                                        <td class="px-4 py-3 text-slate-600 uppercase">@(!string.IsNullOrEmpty(Model.Eccn) ? Model.Eccn : "-")</td>
                                        <td class="px-4 py-3 text-slate-600 font-medium">@(!string.IsNullOrEmpty(Model.SynonymName) ? Model.SynonymName : "-")</td>
                                        <td class="px-4 py-3">
                                            @if (!string.IsNullOrEmpty(Model.SearchHitDetails))
                                            {
                                                <span class="text-slate-400 italic">See PDF rows below</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-300 italic">No matches in scan</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <a href="/ProliferationFinance/Details/@Model.CaseId" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                Details
                                            </a>
                                        </td>
                                        <td class="px-4 py-3">
                                            <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks..."></textarea>
                                        </td>
                                    </tr>

                                    <!-- 2. PDF Snippet Rows -->
                                    @if (!string.IsNullOrEmpty(Model.SearchHitDetails))
                                    {
                                        var snippets = Model.SearchHitDetails.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                        var snipIdx = 1;
                                        foreach (var snip in snippets)
                                        {
                                            <tr class="bg-slate-50/50 hover:bg-slate-100 transition-colors search-hit-row" data-index="@snipIdx">
                                                <td colspan="5" class="px-4 py-2 border-l-2 border-blue-200">
                                                    <div class="flex items-start gap-3">
                                                        <i class="fa fa-file-pdf-o text-blue-400 mt-1"></i>
                                                        <div class="pdf-snippet text-[10px] text-slate-600 leading-relaxed italic whitespace-normal font-medium line-clamp-2" title="@snip">
                                                            "@snip"
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2 text-[9px] font-bold text-blue-600 uppercase">PDF Snippet</td>
                                                <td class="px-4 py-2 text-center">-</td>
                                                <td class="px-4 py-2">
                                                    <textarea class="search-remarks-area h-7 w-full border border-slate-100 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all bg-white" placeholder="Snippet remarks..."></textarea>
                                                </td>
                                            </tr>
                                            snipIdx++;
                                        }
                                    }
                                }
                                else
                                {
                                    <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0">
                                        <td class="px-4 py-3 font-bold text-slate-900">
                                            @(!string.IsNullOrEmpty(Model.MatchedChemicalName) ? Model.MatchedChemicalName : (string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName))
                                        </td>
                                        <td class="px-4 py-3 text-slate-600 uppercase">@(string.IsNullOrEmpty(Model.HsCode) ? "-" : Model.HsCode)</td>
                                        <td class="px-4 py-3 text-slate-600 uppercase">@(string.IsNullOrEmpty(Model.CasNumber) ? "-" : Model.CasNumber)</td>
                                        <td class="px-4 py-3 text-slate-600 uppercase">@(string.IsNullOrEmpty(Model.Eccn) ? "-" : Model.Eccn)</td>
                                        <td class="px-4 py-3 text-slate-600 font-medium">@(string.IsNullOrEmpty(Model.SynonymName) ? "-" : Model.SynonymName)</td>
                                        <td class="px-4 py-3 text-center">
                                            <a href="/ProliferationFinance/Details/@Model.CaseId" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                Details
                                            </a>
                                        </td>
                                        <td class="px-4 py-3">
                                            <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks..."></textarea>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
                    <div class="px-5 py-3 border-t border-slate-100 bg-slate-50/30 flex justify-end">
                        <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] h-8 px-6 rounded-md shadow-sm transition-all tracking-tight" onclick="saveRemarks()">
                            Save Search Action
                        </button>
                    </div>
                </div>

                <!-- Case History & Comments Card (Aligned with Case/Process) -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col flex-1 min-h-[400px] mb-4">
                    <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-white shrink-0">
                        <h3 class="text-[13px] font-bold text-slate-800 tracking-tight">Case Comments</h3>
                    </div>
                    <div class="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50/20 custom-scrollbar" id="commentsContainer">
                        @if (!string.IsNullOrEmpty(Model.StatusReason))
                        {
                            <div class="flex gap-4">
                                <div class="shrink-0 h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-xs">U</div>
                                <div class="flex-1">
                                    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm">
                                        <p class="text-[11px] text-slate-700 leading-relaxed font-medium">@Model.StatusReason</p>
                                    </div>
                                    <div class="mt-2 flex items-center gap-2 text-[9px] font-bold text-slate-400 uppercase tracking-widest px-1">
                                        <span>System User</span>
                                        <span class="h-1 w-1 rounded-full bg-slate-200"></span>
                                        <span>@(Model.UpdatedOn?.ToString("dd MMM yyyy HH:mm") ?? Model.CreatedOn?.ToString("dd MMM yyyy HH:mm"))</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div id="noCommentsMsg" class="text-xs text-slate-500 italic">No comments yet</div>
                        }
                    </div>
                    <div class="p-5 border-t border-slate-100 bg-white">
                        <div class="flex gap-4">
                            <textarea id="caseComment" class="flex-1 h-12 border border-slate-200 rounded-lg p-3 text-[11px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none resize-none placeholder:text-slate-400 font-medium" placeholder="Enter Your Comments"></textarea>
                            <button onclick="saveComment()" class="h-12 px-8 bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 rounded-md transition-all">
                                Save
                            </button>
                        </div>
                        
                        <!-- Main Decision Buttons Alignment -->
                        <div class="mt-6 flex flex-col md:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-100">
                            <div class="flex items-center gap-3 w-full">
                                <button onclick="updateDecision('True Match')" class="h-9 px-6 rounded-md bg-blue-600 text-white text-[10px] font-bold hover:bg-blue-700 transition-all flex items-center gap-2 shadow-sm uppercase tracking-widest">
                                    <i data-lucide="check-circle" class="h-3.5 w-3.5"></i> True Match
                                </button>
                                <button onclick="updateDecision('False Match')" class="h-9 px-6 rounded-md bg-white border border-slate-200 text-slate-700 text-[10px] font-bold hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm uppercase tracking-widest">
                                    <i data-lucide="x-circle" class="h-3.5 w-3.5"></i> False Match
                                </button>
                                <button onclick="updateDecision('Hold')" class="h-9 px-6 rounded-md bg-white border border-slate-200 text-slate-700 text-[10px] font-bold hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm uppercase tracking-widest mr-auto">
                                    <i data-lucide="pause-circle" class="h-3.5 w-3.5"></i> Hold
                                </button>

                                <button onclick="updateDecision('Approve')" class="h-9 px-8 rounded-md bg-blue-600 text-white text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm uppercase tracking-widest">
                                    Approve
                                </button>
                                <button onclick="updateDecision('Reject')" class="h-9 px-8 rounded-md bg-red-600 text-white text-[10px] font-bold hover:bg-red-700 transition-all shadow-sm uppercase tracking-widest">
                                    Reject
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</body>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
</style>

<script>

    function updateDecision(decision) {
        const comment = $('#caseComment').val();
        if ((decision === 'True Match' || decision === 'Approve') && !comment.trim()) {
            alert('Please provide a comment for this decision.');
            return;
        }

        if (confirm(`Confirm decision: ${decision}?`)) {
            $.ajax({
                url: '/ProliferationFinance/UpdateStatus',
                type: 'POST',
                data: { caseId: @Model.CaseId, status: decision },
                success: function(res) {
                    if (res.success) {
                        if (comment.trim()) {
                            $.ajax({
                                url: '/ProliferationFinance/UpdateRemarks',
                                type: 'POST',
                                data: { caseId: @Model.CaseId, remarks: comment },
                                complete: function() {
                                    location.reload();
                                }
                            });
                        } else {
                            location.reload();
                        }
                    } else {
                        alert(res.message || 'Error saving decision.');
                    }
                }
            });
        }
    }

    function saveComment() {
        const comment = $('#caseComment').val();
        if (!comment.trim()) {
            alert('Please enter a comment.');
            return;
        }

        $.ajax({
            url: '/ProliferationFinance/UpdateRemarks',
            type: 'POST',
            data: { caseId: @Model.CaseId, remarks: comment },
            success: function(res) {
                if (res.success) {
                    alert('Comment saved successfully.');
                    location.reload();
                } else {
                    alert(res.message || 'Error saving comment.');
                }
            }
        });
    }

        function uploadDocument(input) {
            if (!input.files || !input.files[0]) return;
            
            const formData = new FormData();
            formData.append('caseId', '@Model.CaseId');
            formData.append('file', input.files[0]);

            $('#loadingeffect').show();
            
            $.ajax({
                url: '/ProliferationFinance/UploadDocument',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#loadingeffect').hide();
                    if (res.success) {
                        alert('Document uploaded successfully');
                        location.reload();
                    } else {
                        alert('Upload failed: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    alert('Error uploading document');
                }
            });
        }

        function saveRemarks() {
            const hits = [];
            $('.search-hit-row').each(function() {
                const row = $(this);
                hits.push({
                    index: row.data('index'),
                    remarks: row.find('.search-remarks-area').val()
                });
            });

            $('#loadingeffect').show();

            $.ajax({
                url: '/ProliferationFinance/SaveSearchHits',
                type: 'POST',
                data: JSON.stringify({
                    caseId: @Model.CaseId,
                    hits: hits
                }),
                contentType: 'application/json',
                success: function(res) {
                    $('#loadingeffect').hide();
                    if (res.success) {
                        alert('Search actions saved successfully');
                    } else {
                        alert('Failed to save actions: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    alert('Error saving search actions');
                }
            });
        }

        $(document).ready(function() {
            lucide.createIcons();
        });
    </script>
