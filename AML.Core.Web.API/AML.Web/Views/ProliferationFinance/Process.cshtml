                        class="h-9 px-8 text-white rounded-md bg-red-600 font-bold text-xs transition-colors hover:bg-red-700">
                    Cancel
                </button>

                <button onclick="proceedSaveRemarks()"
                        class="bg-primary hover:bg-primary-hover text-white font-bold text-xs h-9 px-8 rounded-md transition-all">
