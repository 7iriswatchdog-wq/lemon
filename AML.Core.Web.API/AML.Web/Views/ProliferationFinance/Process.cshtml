@model AML.ViewModel.ViewModels.ProliferationFinance.ProliferationFinanceModel

@{
    ViewBag.Title = "Process Case";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-[#f8fafc] p-4 lg:p-8">
    <div class="max-w-[1600px] mx-auto space-y-8">
        <!-- Loader Overlay -->
        <div id="processLoader" class="fixed inset-0 bg-white/80 backdrop-blur-md z-[9999] flex flex-col items-center justify-center gap-6 transition-all duration-300 hidden">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
            <div class="flex flex-col items-center gap-2">
                <div class="text-xl font-bold text-slate-900 tracking-tight">Saving Decisions</div>
                <div class="text-sm font-medium text-slate-500 animate-pulse">Updating search results in MongoDB...</div>
            </div>
        </div>
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-slate-200">
            <div class="space-y-1">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-200">
                        <i class="fa fa-cogs text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Process Case</h1>
                        <p class="text-slate-500 text-sm font-medium">Review and validate search results for matching items</p>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/ProliferationFinance/CaseManager" class="inline-flex items-center h-10 px-4 bg-white border border-slate-200 text-slate-600 rounded-lg text-sm font-bold hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm">
                    <i class="fa fa-arrow-left mr-2 opacity-50"></i>
                    Back to List
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Sidebar: Case Info -->
            <div class="lg:col-span-4 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50">
                        <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Case Details</h2>
                    </div>
                    <div class="p-6 space-y-6">
                        <div class="grid grid-cols-1 gap-6">
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Case Reference</label>
                                <div class="bg-slate-50 rounded-lg px-4 py-2 text-slate-700 font-bold border border-slate-100">#@Model.CaseId</div>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Product Name</label>
                                <div class="bg-blue-50/50 rounded-lg px-4 py-2 text-blue-900 font-bold border border-blue-100">@Model.ChemicalName</div>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Search Type</label>
                                <div class="flex items-center gap-2">
                                    <span class="px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md text-[10px] font-bold uppercase tracking-wider border border-slate-200">@Model.CustomerType</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content: Search Results -->
            <div class="lg:col-span-8 space-y-6">
                <!-- Data Table -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                        <h3 class="text-[13px] font-bold text-slate-800 tracking-tight">Search Results</h3>
                    </div>

                    <div class="max-h-[400px] overflow-y-auto custom-scrollbar border-b border-slate-100">
                        <table class="w-full text-sm text-left whitespace-nowrap border-collapse">
                            <thead class="text-[10px] font-bold text-slate-500 uppercase tracking-tight bg-slate-50 sticky top-0 z-20">
                                <tr class="border-b border-slate-200">
                                    @if (Model.CustomerType == "Non-Chemical")
                                    {
                                        <th class="px-4 py-3 whitespace-nowrap w-[600px]">Matched Paragraph</th>
                                    }
                                    else
                                    {
                                        <th class="px-4 py-3 min-w-[150px]">Chemical Name</th>
                                        <th class="px-4 py-3">HS Code</th>
                                        <th class="px-4 py-3">CAS Number</th>
                                        <th class="px-4 py-3">ECCN</th>
                                        <th class="px-4 py-3">Synonym Name</th>
                                        @if (Model.CustomerType == "Goods")
                                        {
                                            <th class="px-4 py-3 w-[300px]">Non-Chemical Match</th>
                                        }
                                    }
                                    <th class="px-4 py-3 text-center">More</th>
                                    <th class="px-4 py-3 text-center">Actions</th>
                                    <th class="px-4 py-3 min-w-[160px]">Search Remarks</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-[11px]">
                                @if (Model.MongoHits != null && Model.MongoHits.Count > 0)
                                {
                                    var rowIndex = 0;
                                    foreach (var hit in Model.MongoHits)
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="@rowIndex">
                                            @if (hit.SearchType == "Non-Chemical")
                                            {
                                                <td class="px-4 py-3 align-top @(Model.CustomerType != "Non-Chemical" ? "border-l-2 border-blue-200" : "")" colspan="@(Model.CustomerType != "Non-Chemical" ? 5 : 1)">
                                                    <div class="flex items-start gap-3">
                                                        @if (Model.CustomerType != "Non-Chemical")
                                                        {
                                                            <i class="fa fa-file-pdf-o text-blue-400 mt-1"></i>
                                                        }
                                                        <div class="flex-1">
                                                            <div class="mb-1 text-[9px] font-bold text-blue-500 uppercase tracking-wider">Snippet @(Model.MongoHits.Take(rowIndex + 1).Count(h => h.SearchType == "Non-Chemical")) of @(Model.MongoHits.Count(h => h.SearchType == "Non-Chemical"))</div>
                                                            <div class="pdf-snippet text-[10px] text-slate-600 leading-relaxed italic whitespace-normal font-medium line-clamp-2" title="@hit.Snippet">
                                                                "@hit.Snippet"
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                @if (Model.CustomerType != "Non-Chemical")
                                                {
                                                    <td class="px-4 py-2 text-[9px] font-bold text-blue-600 uppercase">PDF Snippet</td>
                                                }
                                            }
                                            else
                                            {
                                                <!-- Chemical Hit -->
                                                <td class="px-4 py-3 font-bold text-slate-900">
                                                    <div class="flex items-center gap-2">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                                        @(!string.IsNullOrEmpty(hit.MatchedName) ? hit.MatchedName : "-")
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-slate-600 uppercase">@(!string.IsNullOrEmpty(hit.HsCode) ? hit.HsCode : "-")</td>
                                                <td class="px-4 py-3 text-slate-600 uppercase">@(!string.IsNullOrEmpty(hit.CasNumber) ? hit.CasNumber : "-")</td>
                                                <td class="px-4 py-3 text-slate-600 uppercase">@(!string.IsNullOrEmpty(hit.Eccn) ? hit.Eccn : "-")</td>
                                                <td class="px-4 py-3 text-slate-600 font-medium">
                                                    <div class="line-clamp-2 whitespace-normal break-normal leading-relaxed min-w-[200px] max-w-[300px]" title="@hit.MatchedName">
                                                        @(!string.IsNullOrEmpty(hit.MatchedName) ? hit.MatchedName : "-")
                                                    </div>
                                                </td>
                                                @if (Model.CustomerType == "Goods")
                                                {
                                                    <td class="px-4 py-3 text-slate-300 italic">N/A</td>
                                                }
                                            }

                                            <td class="px-4 py-3 text-center">
                                                <a href="/ProliferationFinance/Details/@Model.CaseId@(hit.ChemicalId.HasValue ? "?chemicalId=" + hit.ChemicalId : "")" class="inline-flex items-center justify-center h-6 px-3 bg-slate-100 text-slate-600 rounded text-[10px] font-bold hover:bg-slate-200 transition-all border border-slate-200 active:scale-95">
                                                    Details
                                                </a>
                                            </td>
                                            <td class="px-4 py-3">
                                                <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                    <!option value="" @(string.IsNullOrEmpty(hit.Decision) ? "selected" : "")>Select Action</!option>
                                                    <!option value="True Match" @(hit.Decision == "True Match" ? "selected" : "")>True Match</!option>
                                                    <!option value="False Match" @(hit.Decision == "False Match" ? "selected" : "")>False Match</!option>
                                                </select>
                                            </td>
                                            <td class="px-4 py-3">
                                                <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@hit.Remarks</textarea>
                                            </td>
                                        </tr>
                                        rowIndex++;
                                    }
                                }
                                else
                                {
                                    <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0">
                                        <td colspan="10" class="px-4 py-3 text-center text-slate-400 italic">No search results found to display.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Actions -->
                    <div class="p-6 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
                        <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                            <i class="fa fa-info-circle text-blue-500"></i>
                            Select "Match" in details to link with case
                        </div>
                        <div class="flex items-center gap-4">
                            <button onclick="saveAndProceed()" class="inline-flex items-center justify-center h-11 px-8 bg-blue-600 text-white rounded-xl text-sm font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200 active:scale-95 group">
                                Save Search Action
                                <i class="fa fa-chevron-right ml-2 transition-transform group-hover:translate-x-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .lexend-font { font-family: 'Lexend', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
    
    .loading-shimmer {
        background: linear-gradient(90deg, #f1f5f9 25%, #f8fafc 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }
    @@keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    .dt-loader { display: inline-block; position: relative; width: 80px; height: 20px; }
    .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0, 1, 1, 0); }
    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
</style>

<script>
    function saveAndProceed() {
        const hits = [];
        $('.search-hit-row').each(function() {
            const decision = $(this).find('.search-decision-select').val();
            const remark = $(this).find('.search-remarks-area').val();
            
            if (decision || (remark && remark.trim() !== '')) {
                hits.push({
                    index: $(this).data('index'),
                    decision: decision,
                    remarks: remark ? remark.trim() : "",
                    searchType: "@Model.CustomerType"
                });
            }
        });

        if (hits.length === 0) {
            window.location.href = '/ProliferationFinance/CaseManager';
            return;
        }

        const requestData = {
            caseId: @Model.CaseId,
            hits: hits
        };

        $('#processLoader').removeClass('hidden').addClass('flex');
        
        $.ajax({
            url: '/ProliferationFinance/SaveSearchHits',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(requestData),
            success: function(response) {
                if (response.success) {
                    window.location.href = '/ProliferationFinance/CaseManager';
                } else {
                    $('#processLoader').addClass('hidden').removeClass('flex');
                    alert('Error saving decisions: ' + (response.message || 'Unknown error'));
                }
            },
            error: function() {
                $('#processLoader').addClass('hidden').removeClass('flex');
                alert('Connection error while saving decisions.');
            }
        });
    }

    $(document).ready(function() {
        // Add subtle animation to rows on load
        $('.search-hit-row').each(function(i) {
            $(this).css({
                'opacity': '0',
                'transform': 'translateY(10px)',
                'transition': 'all 0.4s ease-out ' + (i * 0.05) + 's'
            });
            
            const row = $(this);
            setTimeout(() => {
                row.css({
                    'opacity': '1',
                    'transform': 'translateY(0)'
                });
            }, 50);
        });
    });
</script>
