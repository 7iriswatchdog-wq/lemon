@model AML.ViewModel.ViewModels.ProliferationFinance.ProliferationFinanceModel
@using System.Linq
@{
    ViewData["Title"] = "Proliferation Finance - Process Case";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<body class="bg-slate-50/30 min-h-screen text-slate-900">
    <!-- Loader Overlay -->
    <div id="processLoader" class="fixed inset-0 bg-white/80 backdrop-blur-md z-[9999] flex flex-col items-center justify-center gap-6 transition-all duration-300 hidden">
        <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        <div class="flex flex-col items-center gap-2">
            <div class="text-xl font-bold text-slate-900 tracking-tight">Processing...</div>
            <div class="text-sm font-medium text-slate-500 animate-pulse">Please wait while we save your data...</div>
        </div>
    </div>
    <div id="process-container" class="p-4 sm:p-6 min-h-screen flex flex-col">
        <!-- Header -->
        <div class="shrink-0 pb-2">
            <div class="flex items-center gap-2 text-slate-500 text-xs mb-2">
                <a href="/ProliferationFinance" class="hover:text-blue-600">Proliferation Finance</a>
                <i data-lucide="chevron-right" class="h-3 w-3"></i>
                <span class="text-slate-900 font-medium">Case Manager</span>
            </div>
            <h1 class="text-lg font-black text-slate-900 tracking-tight mb-2">Case Manager</h1>

            <!-- Case Details Summary -->
            <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-2">
                        <div class="h-4 w-1 bg-blue-600 rounded-full"></div>
                        <h2 class="text-base font-bold text-slate-900 leading-none">Case Details</h2>
                    </div>
                    <div class="flex gap-4">
                        @* <a href="/ProliferationFinance/Process_PDF/@Model.CaseId" target="_blank"
                           class="h-auto p-0 text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 tracking-tight no-pdf">
                            View PDF
                        </a>
                        <span class="h-4 w-px bg-blue-300 no-pdf"></span> *@
                        <a href="/ProliferationFinance/Process_PDF/@Model.CaseId?download=true" target="_blank"
                           class="h-auto p-0 text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 tracking-tight no-pdf">
                            Download PDF
                        </a>
                    </div>
                </div>

                <div class="grid grid-cols-6 gap-6">
                    <div>
                        <div class="text-[11px] text-slate-400">Corporate Id</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1 truncate">@Model.CorporateId</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">ID</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1">PF-@Model.CaseId</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Created on</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1">@Model.CreatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Updated on</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1">@Model.UpdatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Chemical Name</div>
                        <div class="text-[12px] font-medium text-slate-900 mt-1 truncate" title="@Model.ChemicalName">@(string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">HS Code</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.HsCode) ? "-" : Model.HsCode)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">CAS Number</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.CasNumber) ? "-" : Model.CasNumber)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">ECCN</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1 uppercase">@(string.IsNullOrEmpty(Model.Eccn) ? "-" : Model.Eccn)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Synonym</div>
                        <div class="text-[12px] font-medium text-slate-800 mt-1 truncate" title="@Model.SynonymName">@(string.IsNullOrEmpty(Model.SynonymName) ? "-" : Model.SynonymName)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400">Status</div>
                        <div class="mt-1">
                            @{
                                var statusStr = Model.Status ?? "Pending";
                                var sLower = statusStr.ToLower();
                                var statusClass = "bg-slate-100 text-slate-800 ring-slate-200";
                                if (sLower.Contains("pending")) statusClass = "bg-yellow-100 text-yellow-800 ring-yellow-200";
                                else if (sLower.Contains("approved") || sLower.Contains("true match")) statusClass = "bg-blue-100 text-blue-800 ring-blue-200";
                                else if (sLower.Contains("transfer")) statusClass = "bg-green-100 text-green-800 ring-green-200";
                                else if (sLower.Contains("rejected") || sLower.Contains("false match")) statusClass = "bg-red-100 text-red-800 ring-red-200";
                            }
                            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold @statusClass ring-1 ring-inset">@Model.Status</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-1 min-h-0 py-2 overflow-hidden flex w-full">
            <!-- MAIN CONTENT COLUMN -->
            <div id="mainColumn" class="flex-1 min-w-0 flex flex-col gap-6 overflow-y-auto pr-2 custom-scrollbar">
                
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden shrink-0">
                    <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-white shrink-0">
                        <h3 class="text-base font-bold text-slate-800 tracking-tight">Search Results</h3>
                    </div>

                    <div class="max-h-[400px] overflow-y-auto custom-scrollbar border-b border-slate-100">
                        <table class="w-full text-sm text-left table-fixed border-collapse">
                            <thead class="text-[12px] font-bold text-slate-500 tracking-tight bg-slate-50 sticky top-0 z-20">
                                <tr class="border-b border-slate-200">
                                    <th class="px-4 py-3">Product</th>
                                    <th class="px-4 py-3">Details</th>
                                    <th class="px-4 py-3">Search Type</th>
                                    <th class="px-4 py-3">Remarks</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-[11px]">
                                @if (Model.CustomerType == "Non-Chemical")
                                {
                                    var pdfContent = Model.ChemicalName;
                                    var paragraphs = string.IsNullOrEmpty(pdfContent) ? new string[] { } : pdfContent.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                    if (paragraphs.Length > 0)
                                    {
                                        var index = 0;
                                        foreach (var para in paragraphs)
                                        {
                                            var savedHit = Model.MongoHits?.FirstOrDefault(h => h.Snippet == para && h.SearchType == "Non-Chemical");
                                            <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="@index" data-type="Non-Chemical">
                                                <td class="px-4 py-3 align-top">
                                                    <div class="truncate text-slate-700 font-medium" title="@para">
                                                        @para
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <a href="/ProliferationFinance/Details/@Model.CaseId?type=non-chemical" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                        Details
                                                    </a>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                        <option value="">Select Action</option>
                                                        <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                        <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                        <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                        <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                    </select>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors" data-index="0">
                                            <td class="px-4 py-3 align-top text-slate-400 italic">No matches found in scan</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td colspan="4" class="px-4 py-3 text-slate-400 italic text-center">No matches found in scan</td>
                                        </tr>
                                    }
                                }
                                else if (Model.CustomerType == "Goods" || Model.CustomerType == "Chemical")
                                {
                                    <!-- 1. Chemical Summary Row -->
                                    @if (Model.MatchedChemicals != null && Model.MatchedChemicals.Count > 0)
                                    {
                                        var savedHit = Model.MongoHits?.FirstOrDefault(h => h.SearchType == "Chemical" || h.ChemicalId > 0);
                                        <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0" data-type="Chemical">
                                            <td class="px-4 py-3 font-bold text-slate-900">
                                                <div class="truncate">Chemical Matches (@Model.MatchedChemicals.Count)</div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <a href="/ProliferationFinance/Details/@Model.CaseId?type=chemical" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                    Details
                                                </a>
                                            </td>
                                            <td class="px-4 py-3">
                                                <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                    <option value="">Select Action</option>
                                                    <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                    <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                    <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                    <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                </select>
                                            </td>
                                            <td class="px-4 py-3">
                                                <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                            </td>
                                        </tr>
                                    }
                                    else if (Model.CustomerType != "Non-Chemical")
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors">
                                            <td colspan="4" class="px-4 py-3 text-slate-400 italic text-center">No chemical matches found</td>
                                        </tr>
                                    }

                                    <!-- 2. Non-Chemical Summary Row -->
                                    @if (!string.IsNullOrEmpty(Model.SearchHitDetails))
                                    {
                                        var snippets = Model.SearchHitDetails.Split(new[] { "\n\n", "---" }, StringSplitOptions.RemoveEmptyEntries);
                                        var savedHit = Model.MongoHits?.FirstOrDefault(h => h.SearchType == "Non-Chemical" || !string.IsNullOrEmpty(h.Snippet));
                                        <tr class="bg-slate-50/50 hover:bg-slate-100 transition-colors search-hit-row" data-index="1" data-type="Non-Chemical">
                                            <td class="px-4 py-3 font-bold text-slate-900 border-l-2 border-blue-200">
                                                <div class="truncate">Non-Chemical Matches (@snippets.Length)</div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <a href="/ProliferationFinance/Details/@Model.CaseId?type=non-chemical" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                    Details
                                                </a>
                                            </td>
                                            <td class="px-4 py-3">
                                                <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                    <option value="">Select Action</option>
                                                    <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                    <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                    <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                    <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                </select>
                                            </td>
                                            <td class="px-4 py-3">
                                                <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                            </td>
                                        </tr>
                                    }
                                    else if (Model.CustomerType == "Goods")
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors">
                                            <td colspan="4" class="px-4 py-3 text-slate-400 italic text-center">No non-chemical matches found</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="bg-white hover:bg-slate-50 transition-colors search-hit-row" data-index="0" data-type="Chemical">
                                        <td class="px-4 py-3 font-bold text-slate-900 truncate">
                                            @(!string.IsNullOrEmpty(Model.MatchedChemicalName) ? Model.MatchedChemicalName : (string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName))
                                        </td>
                                        <td class="px-4 py-3">
                                            <a href="/ProliferationFinance/Details/@Model.CaseId" class="inline-flex items-center justify-center h-6 px-3 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700 transition-all shadow-sm active:scale-95">
                                                Details
                                            </a>
                                        </td>
                                        <td class="px-4 py-3">
                                            <select class="search-decision-select h-7 w-full border border-slate-200 rounded-md px-2 text-[10px] font-bold text-slate-700 bg-white focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                <option value="">Select Action</option>
                                                <option value="True Match" selected="@(Model.Status == "True Match")">True Match</option>
                                                <option value="False Match" selected="@(Model.Status == "False Match")">False Match</option>
                                                <option value="Potential Match" selected="@(Model.Status == "Potential Match")">Potential Match</option>
                                                <option value="No Match" selected="@(Model.Status == "No Match")">No Match</option>
                                            </select>
                                        </td>
                                        <td class="px-4 py-3">
                                            <textarea class="search-remarks-area h-7 w-full border border-slate-200 rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(Model.StatusReason ?? "")</textarea>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
                    <div class="px-5 py-3 border-t border-slate-100 bg-slate-50/30 flex justify-end">
                        <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] h-8 px-6 rounded-md shadow-sm transition-all tracking-tight" onclick="saveRemarks()">
                            Save Search Action
                        </button>
                    </div>
                </div>

                <!-- Case History -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col min-h-[260px] max-h-[260px]">
                    <div class="px-5 py-3 border-b shrink-0 bg-white">
                        <h3 class="text-[13px] font-bold ">Case History</h3>
                    </div>
                    <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
                        <div id="commentsContainer" class="relative border-l-2 border-slate-100 ml-2 space-y-8">
                            <!-- Timeline populated via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Case Comments & Actions (Sticky Footer Aligned with Case/Process) -->
    <div class="shrink-0 py-3 bg-white border-t border-slate-200 shadow-[0_-4px_20px_-5px_rgba(0,0,0,0.05)] z-50 mt-2">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6">
            <div class="bg-white rounded-lg border border-slate-200 p-6 space-y-6">
                <div class="space-y-4" x-data="{ comment: '' }">
                    <h3 class="text-sm font-bold text-slate-900">Case Comments</h3>
                    <div class="flex gap-4">
                        <textarea id="caseComment" 
                                  oninput="toggleSaveButton()"
                                  class="flex-1 h-[44px] py-2.5 bg-white border-slate-200 resize-none text-xs rounded-md border px-3 outline-none focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all font-medium" 
                                  placeholder="Enter Your Comments"></textarea>
                        <button id="btnSaveComment" 
                                onclick="saveComment()" 
                                disabled 
                                class="h-[44px] px-8 border-slate-200 text-slate-400 font-bold border rounded-md disabled:opacity-50 disabled:cursor-not-allowed transition-all">
                            Save
                        </button>
                    </div>
                </div>

                <!-- Main Decision Buttons Alignment -->
                <div class="flex flex-col gap-2 pt-4 border-t border-slate-50">
                    <div class="flex items-center gap-3 w-full">
                        <button type="button" onclick="updateDecision('Submit to Senior Management')"
                                class="case-action-btn h-9 px-4 border border-slate-200 rounded-md text-slate-700 font-medium hover:bg-slate-50 transition-all text-sm">
                            Submit To Senior Management
                        </button>

                        <button type="button" onclick="updateDecision('Hold')"
                                class="case-action-btn h-9 px-4 border border-slate-200 rounded-md text-slate-700 font-medium hover:bg-slate-50 transition-all text-sm">
                            Hold
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

    .dt-loader { display: inline-block; position: relative; width: 80px; height: 20px; }
    .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0, 1, 1, 0); }
    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
</style>

<script>

    function toggleSaveButton() {
        const comment = $('#caseComment').val().trim();
        const $btn = $('#btnSaveComment');
        if (comment.length > 0) {
            $btn.prop('disabled', false)
                .removeClass('text-slate-400 cursor-not-allowed opacity-50')
                .addClass('text-slate-600 hover:bg-slate-50');
        } else {
            $btn.prop('disabled', true)
                .addClass('text-slate-400 cursor-not-allowed opacity-50')
                .removeClass('text-slate-600 hover:bg-slate-50');
        }
    }

    function updateDecision(decision) {
        const comment = $('#caseComment').val();

        $.ajax({
            url: '/ProliferationFinance/UpdateStatus',
            type: 'POST',
            data: { caseId: @Model.CaseId, status: decision },
            success: function(res) {
                if (res.success) {
                    toastr.success('Case status updated to ' + decision);
                    if (comment.trim()) {
                        $.ajax({
                            url: '/ProliferationFinance/UpdateRemarks',
                            type: 'POST',
                            data: { caseId: @Model.CaseId, remarks: comment },
                            complete: function() {
                                setTimeout(() => location.reload(), 1500);
                            }
                        });
                    } else {
                        setTimeout(() => location.reload(), 1500);
                    }
                } else {
                    toastr.error(res.message || 'Error saving decision.');
                }
            },
            error: function() {
                toastr.error('Error connecting to server.');
            }
        });
    }

    function saveComment() {
        const comment = $('#caseComment').val();
        if (!comment.trim()) {
            return;
        }

        $.ajax({
            url: '/ProliferationFinance/UpdateRemarks',
            type: 'POST',
            data: { caseId: @Model.CaseId, remarks: comment },
            success: function(res) {
                if (res.success) {
                    toastr.success('Comment saved successfully');
                    $('#caseComment').val(''); // Clear the input
                    setTimeout(() => location.reload(), 1500); // Silent reload to show updated history
                } else {
                    toastr.error(res.message || 'Error saving comment.');
                }
            },
            error: function() {
                toastr.error('Error connecting to server.');
            }
        });
    }

        function uploadDocument(input) {
            if (!input.files || !input.files[0]) return;
            
            const formData = new FormData();
            formData.append('caseId', '@Model.CaseId');
            formData.append('file', input.files[0]);

            $('#loadingeffect').show();
            
            $.ajax({
                url: '/ProliferationFinance/UploadDocument',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#loadingeffect').hide();
                    if (res.success) {
                        toastr.success('Document uploaded successfully');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toastr.error('Upload failed: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    toastr.error('Error uploading document');
                }
            });
        }

        let isDropdownChanged = false;
        $(document).on('change', '.search-decision-select', function() {
            isDropdownChanged = true;
        });

        function saveRemarks() {
            if (isDropdownChanged) {
                $('#confirmModal').removeClass('hidden');
            } else {
                proceedSaveRemarks();
            }
        }

        function closeConfirmModal() {
            $('#confirmModal').addClass('hidden');
        }

        function proceedSaveRemarks() {
            closeConfirmModal();
            const hits = [];
            $('.search-hit-row').each(function() {
                const row = $(this);
                const decision = row.find('.search-decision-select').val();
                const remark = row.find('.search-remarks-area').val();
                hits.push({
                    index: row.data('index'),
                    searchType: row.data('type') || 'Chemical',
                    decision: decision || '',
                    remarks: remark || ''
                });
            });

            $('#loadingeffect').show();
            var corporateId='@Model.CorporateId';
            var companyName='@Model.CompanyName';

            $.ajax({
                url: '/ProliferationFinance/SaveSearchHits',
                type: 'POST',
                data: JSON.stringify({
                    caseId: @Model.CaseId,
                    corporateId: corporateId,
                    FirstName:companyName,
                    hits: hits
                }),
                contentType: 'application/json',
                success: function(res) {
                    if (res.success) {
                        isDropdownChanged = false; // Reset change flag
                        toastr.success('Search actions saved successfully');
                        
                        // Update Status Badge logic after save success
                        let newStatus = '';
                        const trueMatchFound = hits.some(h => h.decision === 'True Match');
                        if (trueMatchFound) {
                            newStatus = 'True Match';
                        } else if (hits.length > 0) {
                            newStatus = hits[0].decision || 'Pending';
                        }

                        if (newStatus && newStatus !== 'Pending') {
                            $.ajax({
                                url: '/ProliferationFinance/UpdateStatus',
                                type: 'POST',
                                data: { caseId: @Model.CaseId, status: newStatus },
                                success: function() {
                                    setTimeout(() => location.reload(), 1500);
                                },
                                complete: () => $('#loadingeffect').hide()
                            });
                        } else {
                            $('#loadingeffect').hide();
                            setTimeout(() => location.reload(), 1500);
                        }
                    } else {
                        $('#loadingeffect').hide();
                        toastr.error('Failed to save actions: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    toastr.error('Error saving search actions');
                }
            });
        }

    function loadComments() {
        const caseId = @Model.CaseId;
        $.ajax({
            url: '/ProliferationFinance/GetComments',
            type: 'GET',
            data: { caseId: caseId },
            success: function(res) {
                  let showVersionTypes = ["Approved", "Rejected", "Whitelisted"];
                let versionCounter = 0;
                if (res.success && res.data) {
                    let html = '';
                    if (res.data.length === 0) {
                        html = '<div id="noCommentsMsg" class="text-center py-8 text-slate-400 italic text-[11px]">No case history available</div>';
                        $('#commentsContainer').append(html);
                    } else {
                $.each(res.data, function (i, v) {

                let userName = v.createdUser || "User";
                let commentText = v.comment || "";
                let duration = v.duration || "";
                let version = v.version || (i + 1);
                            let commentType = (v.commentType || "");

                // Check allowed types
                             let displayText = "";

                    if (showVersionTypes.includes(commentType)) {
                        versionCounter++;
                        displayText = `Version ${versionCounter}`;
                    } else {
                        displayText = `Action On ${commentType}`;
                    }

                            let createdOn = v.createdOnDB ? new Date(v.createdOnDB) : null;

                    let formattedDateTime = createdOn
                        ? createdOn.toLocaleString('en-GB', {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                            second: '2-digit',
                            hour12: false
                          }).replace(',', '')
                        : "";

                let html = `
                    <div class="pl-6 relative">

                        <div class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full ring-4 ring-white bg-blue-500">
                        </div>

                        <div class="flex flex-col gap-1">

                            <div class="flex items-baseline gap-2">
                                <span class="text-xs font-bold text-slate-900">
                                                 ${displayText}
                                </span>

                                <span class="text-[11px] text-slate-500">
                                     by
                                    <span class="font-semibold text-blue-600">${userName}</span>
                                </span>
                            </div>

                            <p class="text-[11px] font-medium text-slate-700 leading-relaxed">
                                ${commentText}
                            </p>

                            <span class="text-[10px] font-bold tracking-wide text-blue-600">
                                ${formattedDateTime}
                            </span>

                        </div>

                    </div>
                `;

                $('#commentsContainer').append(html);
                
            });
                    
                }
            }
        }
        });
    }

    $(document).ready(function() {
        lucide.createIcons();
        loadComments();
    });
</script>

