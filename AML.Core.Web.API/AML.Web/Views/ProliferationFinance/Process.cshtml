@model AML.ViewModel.ViewModels.ProliferationFinance.ProliferationFinanceModel
@using System.Linq
@{
    ViewData["Title"] = "Proliferation Finance - Process Case";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<body class="bg-appbg min-h-screen text-textprimary">
    <!-- Loader Overlay -->
    <div id="processLoader" class="fixed inset-0 bg-surface/80 backdrop-blur-md z-[9999] flex-col items-center justify-center gap-6 transition-all duration-300 hidden">
        <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        <div class="flex flex-col items-center gap-2">
            <div class="text-xl font-bold text-textprimary tracking-tight">Processing...</div>
            <div class="text-sm font-medium text-textmuted animate-pulse">Please wait while we save your data...</div>
        </div>
    </div>
    <div id="process-container" class="p-4 sm:p-6 min-h-screen flex flex-col">
        <!-- Header -->
        <div class="shrink-0 pb-2">
            <div class="flex items-center gap-2 text-textmuted text-xs mb-2">
                <a href="/ProliferationFinance/CaseManager" class="hover:text-primary">Proliferation Finance</a>
                <i data-lucide="chevron-right" class="h-3 w-3"></i>
                <span class="text-textprimary font-medium">Case Manager</span>
            </div>
            <h1 class="text-lg font-black text-textprimary tracking-tight mb-2">Case Manager</h1>

            <!-- Case Details Summary -->
            <div class="bg-surface rounded-lg border border-bordercolor p-5 shadow-sm">
                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-2">
                        <div class="h-4 w-1 bg-primary rounded-full"></div>
                        <h2 class="text-base font-bold text-textprimary leading-none">Case Details</h2>
                    </div>
                    <div class="flex gap-1">
                        <a href="/ProliferationFinance/Process_PDF/@Model.CaseId?download=true" target="_blank"
                           class="h-8 w-8 flex items-center justify-center rounded-lg text-primary hover:bg-blue-50 transition-all no-pdf" title="Download PDF">
                            <i data-lucide="download" class="h-4 w-4"></i>
                        </a>
                    </div>
                </div>

                <div class="grid grid-cols-6 gap-6">
                    <div>
                        <div class="text-[11px] text-textmuted">Corporate Id</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1 truncate">@Model.CorporateId</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">ID</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1">PF-@Model.CaseId</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">Created on</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1">@Model.CreatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">Updated on</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1">@Model.UpdatedOn?.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">Chemical Name</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1 truncate" title="@Model.ChemicalName">@(string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">HS Code</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1 uppercase">@(string.IsNullOrEmpty(Model.HsCode) ? "-" : Model.HsCode)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">CAS Number</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1 uppercase">@(string.IsNullOrEmpty(Model.CasNumber) ? "-" : Model.CasNumber)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">ECCN</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1 uppercase">@(string.IsNullOrEmpty(Model.Eccn) ? "-" : Model.Eccn)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">Synonym</div>
                        <div class="text-[12px] font-medium text-textprimary mt-1 truncate" title="@Model.SynonymName">@(string.IsNullOrEmpty(Model.SynonymName) ? "-" : Model.SynonymName)</div>
                    </div>
                    <div>
                        <div class="text-[11px] text-textmuted">Status</div>
                        <div class="mt-1">
                            @{
                                var statusStr = Model.Status ?? "Pending";
                                var sLower = statusStr.ToLower();
                                var statusClass = "bg-slate-100 text-textprimary ring-slate-200";
                                if (sLower.Contains("pending")) statusClass = "bg-yellow-100 text-yellow-800 ring-yellow-200";
                                else if (sLower.Contains("approved") || sLower.Contains("true match")) statusClass = "bg-blue-100 text-blue-800 ring-blue-200";
                                else if (sLower.Contains("transfer")) statusClass = "bg-green-100 text-green-800 ring-green-200";
                                else if (sLower.Contains("rejected") || sLower.Contains("false match")) statusClass = "bg-red-100 text-red-800 ring-red-200";
                            }
                            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold @statusClass ring-1 ring-inset">@Model.Status</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-1 min-h-0 py-2 overflow-hidden flex w-full">
            <!-- MAIN CONTENT COLUMN -->
            <div id="mainColumn" class="flex-1 min-w-0 flex flex-col gap-6 overflow-y-auto pr-2 custom-scrollbar">
                
                <div class="bg-surface rounded-xl border border-bordercolor shadow-sm flex flex-col overflow-hidden shrink-0">
                    <div class="px-5 py-3 border-b border-bordercolor flex items-center justify-between bg-surface shrink-0">
                        <h3 class="text-base font-bold text-textprimary tracking-tight">Search Results</h3>
                    </div>

                    <div class="max-h-[400px] overflow-y-auto custom-scrollbar border-b border-bordercolor">
                        <table class="w-full text-sm text-left table-fixed border-collapse">
                            <thead class="text-[12px] font-bold text-textmuted tracking-tight bg-appbg sticky top-0 z-20">
                                <tr class="border-b border-bordercolor">
                                    <th class="px-4 py-3">Product</th>
                                    <th class="px-4 py-3">Details</th>
                                    <th class="px-4 py-3">Search Type</th>
                                    <th class="px-4 py-3">Remarks</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-[11px]">
                                @if (Model.CustomerType == "Non-Chemical")
                                {
                                    var pdfContent = Model.ChemicalName;
                                    var paragraphs = string.IsNullOrEmpty(pdfContent) ? new string[] { } : pdfContent.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                    if (paragraphs.Length > 0)
                                    {
                                        var index = 0;
                                        foreach (var para in paragraphs)
                                        {
                                            var savedHit = Model.MongoHits?.FirstOrDefault(h => h.Snippet == para && h.SearchType == "Non-Chemical");
                                            <tr class="bg-surface hover:bg-appbg transition-colors search-hit-row" data-index="@index" data-type="Non-Chemical">
                                                <td class="px-4 py-3 align-top">
                                                    <div class="truncate text-textlabel font-medium" title="@para">
                                                        @para
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <a href="/ProliferationFinance/Details/@Model.CaseId?type=non-chemical" class="inline-flex items-center justify-center h-6 px-3 bg-primary text-white rounded text-[10px] font-bold hover:bg-primary-hover transition-all shadow-sm active:scale-95">
                                                        Details
                                                    </a>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <select class="search-decision-select h-7 w-full border border-bordercolor rounded-md px-2 text-[10px] font-bold text-textlabel bg-surface focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                        <option value="">Select Action</option>
                                                        <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                        <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                        <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                        <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                    </select>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <textarea class="search-remarks-area h-7 w-full border border-bordercolor rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        <tr class="bg-surface hover:bg-appbg transition-colors" data-index="0">
                                            <td class="px-4 py-3 align-top text-textmuted italic">No matches found in scan</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td class="px-4 py-3 text-slate-300">-</td>
                                            <td colspan="4" class="px-4 py-3 text-textmuted italic text-center">No matches found in scan</td>
                                        </tr>
                                    }
                                }
                                else if (Model.CustomerType == "Goods" || Model.CustomerType == "Chemical" || Model.CustomerType == "Military" || Model.CustomerType == "Both")
                                {
                                    <!-- 1. Chemical Summary Row -->
                                    @if (Model.MatchedChemicals != null && Model.MatchedChemicals.Count > 0)
                                    {
                                        var savedHit = Model.MongoHits?.FirstOrDefault(h => h.SearchType == "Chemical" || h.ChemicalId > 0);
                                        <tr class="bg-surface hover:bg-appbg transition-colors search-hit-row" data-index="0" data-type="Chemical">
                                            <td class="px-4 py-3 font-bold text-textprimary">
                                                <div class="truncate">Chemical Matches (@Model.MatchedChemicals.Count)</div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <a href="/ProliferationFinance/Details/@Model.CaseId?type=chemical" class="inline-flex items-center justify-center h-6 px-3 bg-primary text-white rounded text-[10px] font-bold hover:bg-primary-hover transition-all shadow-sm active:scale-95">
                                                    Details
                                                </a>
                                            </td>
                                            <td class="px-4 py-3">
                                                <select class="search-decision-select h-7 w-full border border-bordercolor rounded-md px-2 text-[10px] font-bold text-textlabel bg-surface focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                    <option value="">Select Action</option>
                                                    <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                    <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                    <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                    <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                </select>
                                            </td>
                                            <td class="px-4 py-3">
                                                <textarea class="search-remarks-area h-7 w-full border border-bordercolor rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                            </td>
                                        </tr>
                                    }
                                    else if (Model.CustomerType != "Non-Chemical" && Model.CustomerType != "Military")
                                    {
                                        <tr class="bg-surface hover:bg-appbg transition-colors">
                                            <td colspan="4" class="px-4 py-3 text-textmuted italic text-center">No chemical matches found</td>
                                        </tr>
                                    }

                                    <!-- 2. Non-Chemical Matches Row -->
                                    @if (!string.IsNullOrEmpty(Model.SearchHitDetails) && (Model.CustomerType == "Non-Chemical" || Model.CustomerType == "Both" || Model.CustomerType == "Goods"))
                                    {
                                        var snippets = Model.SearchHitDetails.Split(new[] { "\n\n", "---" }, StringSplitOptions.RemoveEmptyEntries);
                                        var savedHit = Model.MongoHits?.FirstOrDefault(h => h.SearchType == "Non-Chemical" || h.SearchType == "Both" || (!h.SearchType.Contains("Chemical") && !string.IsNullOrEmpty(h.Snippet)));
                                        <tr class="bg-appbg hover:bg-slate-100 transition-colors search-hit-row" data-index="1" data-type="Non-Chemical">
                                            <td class="px-4 py-3 font-bold text-textprimary border-l-2 border-blue-200">
                                                <div class="truncate">Non-Chemical Matches (@(ViewBag.NonChemCount ?? 0))</div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <a href="/ProliferationFinance/Details/@Model.CaseId?type=non-chemical" class="inline-flex items-center justify-center h-6 px-3 bg-primary text-white rounded text-[10px] font-bold hover:bg-primary-hover transition-all shadow-sm active:scale-95">
                                                    Details
                                                </a>
                                            </td>
                                            <td class="px-4 py-3">
                                                <select class="search-decision-select h-7 w-full border border-bordercolor rounded-md px-2 text-[10px] font-bold text-textlabel bg-surface focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                    <option value="">Select Action</option>
                                                    <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                    <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                    <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                    <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                </select>
                                            </td>
                                            <td class="px-4 py-3">
                                                <textarea class="search-remarks-area h-7 w-full border border-bordercolor rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                            </td>
                                        </tr>
                                    }
                                    else if (Model.CustomerType == "Non-Chemical")
                                    {
                                        <tr class="bg-surface hover:bg-appbg transition-colors">
                                            <td colspan="4" class="px-4 py-3 text-textmuted italic text-center">No non-chemical matches found</td>
                                        </tr>
                                    }

                                    <!-- 3. Military Goods Matches Row -->
                                    @if (!string.IsNullOrEmpty(Model.SearchHitDetails) && (Model.CustomerType == "Military" || Model.CustomerType == "Both" || Model.CustomerType == "Goods"))
                                    {
                                        var snippets = Model.SearchHitDetails.Split(new[] { "\n\n", "---" }, StringSplitOptions.RemoveEmptyEntries);
                                        var savedHit = Model.MongoHits?.FirstOrDefault(h => h.SearchType == "Military" || h.SearchType == "Both" || (!h.SearchType.Contains("Chemical") && !string.IsNullOrEmpty(h.Snippet)));
                                        <tr class="bg-appbg hover:bg-slate-100 transition-colors search-hit-row" data-index="2" data-type="Military">
                                            <td class="px-4 py-3 font-bold text-textprimary border-l-2 border-red-200">
                                                <div class="truncate">Military Goods Matches (@(ViewBag.MilitaryCount ?? 0))</div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <a href="/ProliferationFinance/Details/@Model.CaseId?type=military" class="inline-flex items-center justify-center h-6 px-3 bg-primary text-white rounded text-[10px] font-bold hover:bg-primary-hover transition-all shadow-sm active:scale-95">
                                                    Details
                                                </a>
                                            </td>
                                            <td class="px-4 py-3">
                                                <select class="search-decision-select h-7 w-full border border-bordercolor rounded-md px-2 text-[10px] font-bold text-textlabel bg-surface focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                    <option value="">Select Action</option>
                                                    <option value="True Match" selected="@(savedHit?.Decision == "True Match")">True Match</option>
                                                    <option value="False Match" selected="@(savedHit?.Decision == "False Match")">False Match</option>
                                                    <option value="Potential Match" selected="@(savedHit?.Decision == "Potential Match")">Potential Match</option>
                                                    <option value="No Match" selected="@(savedHit?.Decision == "No Match")">No Match</option>
                                                </select>
                                            </td>
                                            <td class="px-4 py-3">
                                                <textarea class="search-remarks-area h-7 w-full border border-bordercolor rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(savedHit?.Remarks ?? "")</textarea>
                                            </td>
                                        </tr>
                                    }
                                    else if (Model.CustomerType == "Military")
                                    {
                                        <tr class="bg-surface hover:bg-appbg transition-colors">
                                            <td colspan="4" class="px-4 py-3 text-textmuted italic text-center">No military goods matches found</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="bg-surface hover:bg-appbg transition-colors search-hit-row" data-index="0" data-type="Chemical">
                                        <td class="px-4 py-3 font-bold text-textprimary truncate">
                                            @(!string.IsNullOrEmpty(Model.MatchedChemicalName) ? Model.MatchedChemicalName : (string.IsNullOrEmpty(Model.ChemicalName) ? "-" : Model.ChemicalName))
                                        </td>
                                        <td class="px-4 py-3">
                                            <a href="/ProliferationFinance/Details/@Model.CaseId" class="inline-flex items-center justify-center h-6 px-3 bg-primary text-white rounded text-[10px] font-bold hover:bg-primary-hover transition-all shadow-sm active:scale-95">
                                                Details
                                            </a>
                                        </td>
                                        <td class="px-4 py-3">
                                            <select class="search-decision-select h-7 w-full border border-bordercolor rounded-md px-2 text-[10px] font-bold text-textlabel bg-surface focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                                                <option value="">Select Action</option>
                                                <option value="True Match" selected="@(Model.Status == "True Match")">True Match</option>
                                                <option value="False Match" selected="@(Model.Status == "False Match")">False Match</option>
                                                <option value="Potential Match" selected="@(Model.Status == "Potential Match")">Potential Match</option>
                                                <option value="No Match" selected="@(Model.Status == "No Match")">No Match</option>
                                            </select>
                                        </td>
                                        <td class="px-4 py-3">
                                            <textarea class="search-remarks-area h-7 w-full border border-bordercolor rounded-md p-1.5 resize-none text-[10px] focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500/50 outline-none transition-all" placeholder="Enter matching remarks...">@(Model.StatusReason ?? "")</textarea>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
                    <div class="px-5 py-3 border-t border-bordercolor bg-appbg flex justify-end">
                        <button class="bg-primary hover:bg-primary-hover text-white font-bold text-[11px] h-8 px-6 rounded-md shadow-sm transition-all tracking-tight disabled:opacity-50 disabled:cursor-not-allowed" 
                                onclick="saveRemarks()"
                                @(Model.IsReadOnly ? "disabled" : "")>
                            Save Search Action
                        </button>
                    </div>
                </div>

                <!-- Case History -->
                <div class="bg-surface rounded-xl border border-bordercolor shadow-sm flex flex-col min-h-[260px] max-h-[260px]">
                    <div class="px-5 py-3 border-b shrink-0 bg-surface">
                        <h3 class="text-[13px] font-bold ">Case History</h3>
                    </div>
                    <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
                        <div id="commentsContainer" class="relative border-l-2 border-bordercolor ml-2 space-y-8">
                            <!-- Timeline populated via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Case Comments & Actions (Sticky Footer Aligned with Case/Process) -->
    <div class="shrink-0 py-3 bg-surface border-t border-bordercolor shadow-[0_-4px_20px_-5px_rgba(0,0,0,0.05)] z-50 mt-2">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6">
            <div class="bg-surface rounded-lg border border-bordercolor p-6 space-y-6">
                <div class="space-y-4" x-data="{ comment: '' }">
                    <h3 class="text-sm font-bold text-textprimary">Case Comments</h3>
                    <div class="flex gap-4">
                        <div class="flex-col flex-1 gap-1">
                            <textarea id="caseComment" 
                                      oninput="toggleSaveButton(); $('#caseCommentError').addClass('hidden');"
                                      @(Model.IsReadOnly ? "disabled" : "")
                                      class="w-full h-[44px] py-2.5 bg-surface border-bordercolor resize-none text-xs rounded-md border px-3 outline-none focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all font-medium disabled:bg-appbg disabled:text-textmuted" 
                                      placeholder="Enter Your Comments"></textarea>
                            <span id="caseCommentError" class="text-red-500 text-[10px] font-semibold hidden">Enter any remark</span>
                        </div>
                        <button id="btnSaveComment" 
                                onclick="saveComment()" 
                                @(Model.IsReadOnly ? "disabled" : "disabled") 
                                class="h-[44px] px-8 border-bordercolor text-textmuted font-bold border rounded-md disabled:opacity-50 disabled:cursor-not-allowed transition-all">
                            Save
                        </button>
                    </div>
                </div>

                <!-- Main Decision Buttons Alignment -->
                <div class="flex flex-col gap-2 pt-4 border-t border-slate-50">
                    <div class="flex items-center gap-3 w-full">
                        @if (Model.UserGroupName != "Senior Management")
                        {
                            <button type="button" onclick="updateDecision('Submit to Senior Management')"
                                    @(Model.IsReadOnly ? "disabled" : "")
                                    class="case-action-btn h-9 px-4 border border-bordercolor rounded-md text-textlabel font-medium hover:bg-appbg transition-all text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                                Submit To Senior Management
                            </button>
                        }

                        <button type="button" onclick="updateDecision('Hold')"
                                @(Model.IsReadOnly ? "disabled" : "")
                                class="case-action-btn h-9 px-4 border border-bordercolor rounded-md text-textlabel font-medium hover:bg-appbg transition-all text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                            Hold
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

    .dt-loader { display: inline-block; position: relative; width: 80px; height: 20px; }
    .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0, 1, 1, 0); }
    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
</style>

<script>

    function updateStatusUI(newStatus) {
        if (!newStatus) return;
        const sLower = newStatus.toLowerCase();
        let statusClass = "bg-slate-100 text-textprimary ring-slate-200";
        if (sLower.includes("pending")) statusClass = "bg-yellow-100 text-yellow-800 ring-yellow-200";
        else if (sLower.includes("approved") || sLower.includes("true match")) statusClass = "bg-blue-100 text-blue-800 ring-blue-200";
        else if (sLower.includes("transfer")) statusClass = "bg-green-100 text-green-800 ring-green-200";
        else if (sLower.includes("rejected") || sLower.includes("false match")) statusClass = "bg-red-100 text-red-800 ring-red-200";
        
        let badge = $(".grid.grid-cols-6 div:contains('Status')").parent().find("span");
        if(badge.length) {
            badge.text(newStatus);
            badge.removeClass().addClass("inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold ring-1 ring-inset " + statusClass);
        }
    }

    function refreshCaseUI(newStatus) {
        if (newStatus) updateStatusUI(newStatus);
        $('#commentsContainer').empty();
        loadComments();
    }

    function toggleSaveButton() {
        const comment = $('#caseComment').val().trim();
        const $btn = $('#btnSaveComment');
        if (comment.length > 0) {
            $btn.prop('disabled', false)
                .removeClass('text-textmuted cursor-not-allowed opacity-50')
                .addClass('text-textlabel hover:bg-appbg');
        } else {
            $btn.prop('disabled', true)
                .addClass('text-textmuted cursor-not-allowed opacity-50')
                .removeClass('text-textlabel hover:bg-appbg');
        }
    }

    function updateDecision(decision) {
        const comment = $('#caseComment').val();

        if (decision === 'Submit to Senior Management' && !comment.trim()) {
            $('#caseCommentError').removeClass('hidden');
            return;
        }

        $('#caseCommentError').addClass('hidden');

        $.ajax({
            url: '/ProliferationFinance/UpdateStatus',
            type: 'POST',
            data: { caseId: @Model.CaseId, status: decision },
            success: function(res) {
                if (res.success) {
                    toastr.success('Case status updated to ' + decision);
                    if (comment.trim()) {
                        $.ajax({
                            url: '/ProliferationFinance/UpdateRemarks',
                            type: 'POST',
                            data: { caseId: @Model.CaseId, remarks: comment },
                            complete: function() {
                                setTimeout(() => refreshCaseUI(decision), 500);
                            }
                        });
                    } else {
                        setTimeout(() => refreshCaseUI(decision), 500);
                    }
                } else {
                    toastr.error(res.message || 'Error saving decision.');
                }
            },
            error: function() {
                toastr.error('Error connecting to server.');
            }
        });
    }

    function saveComment() {
        const comment = $('#caseComment').val();
        if (!comment.trim()) {
            return;
        }

        $.ajax({
            url: '/ProliferationFinance/UpdateRemarks',
            type: 'POST',
            data: { caseId: @Model.CaseId, remarks: comment },
            success: function(res) {
                if (res.success) {
                    toastr.success('Comment saved successfully');
                    $('#caseComment').val(''); // Clear the input
                    setTimeout(() => refreshCaseUI(null), 500);
                } else {
                    toastr.error(res.message || 'Error saving comment.');
                }
            },
            error: function() {
                toastr.error('Error connecting to server.');
            }
        });
    }

        function uploadDocument(input) {
            if (!input.files || !input.files[0]) return;
            
            const formData = new FormData();
            formData.append('caseId', '@Model.CaseId');
            formData.append('file', input.files[0]);

            $('#loadingeffect').show();
            
            $.ajax({
                url: '/ProliferationFinance/UploadDocument',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#loadingeffect').hide();
                    if (res.success) {
                        toastr.success('Document uploaded successfully');
                        setTimeout(() => refreshCaseUI(null), 500);
                    } else {
                        toastr.error('Upload failed: ' + res.message);
                    }
                },
                error: function() {
                    $('#loadingeffect').hide();
                    toastr.error('Error uploading document');
                }
            });
        }

        let isDropdownChanged = false;
        $(document).on('change', '.search-decision-select', function() {
            isDropdownChanged = true;
        });

        function saveRemarks() {
            if (isDropdownChanged) {
                $('#confirmModal').removeClass('hidden').addClass('flex');
            } else {
                proceedSaveRemarks();
            }
        }

        function closeConfirmModal() {
            $('#confirmModal').addClass('hidden').removeClass('flex');
        }

        function proceedSaveRemarks() {
            closeConfirmModal();
            const hits = [];
            $('.search-hit-row').each(function() {
                const row = $(this);
                const decision = row.find('.search-decision-select').val();
                const remark = row.find('.search-remarks-area').val();
                hits.push({
                    index: row.data('index'),
                    searchType: row.data('type') || 'Chemical',
                    decision: decision || '',
                    remarks: remark || ''
                });
            });

            $('#processLoader').removeClass('hidden').addClass('flex');
            var corporateId='@Model.CorporateId';
            var companyName='@Model.CompanyName';

            $.ajax({
                url: '/ProliferationFinance/SaveSearchHits',
                type: 'POST',
                data: JSON.stringify({
                    caseId: @Model.CaseId,
                    corporateId: corporateId,
                    FirstName:companyName,
                    hits: hits
                }),
                contentType: 'application/json',
                success: function(res) {
                    if (res.success) {
                        isDropdownChanged = false; // Reset change flag
                        toastr.success('Search actions saved successfully');
                        
                        // Update Status Badge logic after save success
                        let newStatus = '';
                        const trueMatchFound = hits.some(h => h.decision === 'True Match');
                        if (trueMatchFound) {
                            newStatus = 'True Match';
                        } else if (hits.length > 0) {
                            newStatus = hits[0].decision || 'Pending';
                        }

                        if (newStatus && newStatus !== 'Pending') {
                            $.ajax({
                                url: '/ProliferationFinance/UpdateStatus',
                                type: 'POST',
                                data: { caseId: @Model.CaseId, status: newStatus },
                                success: function() {
                                    setTimeout(() => refreshCaseUI(newStatus), 500);
                                },
                                complete: () => $('#processLoader').addClass('hidden').removeClass('flex')
                            });
                        } else {
                            $('#processLoader').addClass('hidden').removeClass('flex');
                            setTimeout(() => refreshCaseUI(newStatus), 500);
                        }
                    } else {
                        $('#processLoader').addClass('hidden').removeClass('flex');
                        toastr.error('Failed to save actions: ' + res.message);
                    }
                },
                error: function() {
                    $('#processLoader').addClass('hidden').removeClass('flex');
                    toastr.error('Error saving search actions');
                }
            });
        }

    function loadComments() {
        const caseId = @Model.CaseId;
        $.ajax({
            url: '/ProliferationFinance/GetComments',
            type: 'GET',
            data: { caseId: caseId },
            success: function(res) {
                  let showVersionTypes = ["Approved", "Rejected", "Whitelisted"];
                let versionCounter = 0;
                if (res.success && res.data) {
                    let html = '';
                    if (res.data.length === 0) {
                        html = '<div id="noCommentsMsg" class="text-center py-8 text-textmuted italic text-[11px]">No case history available</div>';
                        $('#commentsContainer').append(html);
                    } else {
                $.each(res.data, function (i, v) {

                let userName = v.createdUser || "User";
                let commentText = v.comment || "";
                let duration = v.duration || "";
                let version = v.version || (i + 1);
                            let commentType = (v.commentType || "");

                // Check allowed types
                             let displayText = "";

                    if (showVersionTypes.includes(commentType)) {
                        versionCounter++;
                        displayText = `Version ${versionCounter}`;
                    } else {
                        displayText = `Action On ${commentType}`;
                    }

                            let createdOn = v.createdOnDB ? new Date(v.createdOnDB) : null;

                    let formattedDateTime = createdOn
                        ? createdOn.toLocaleString('en-GB', {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                            second: '2-digit',
                            hour12: false
                          }).replace(',', '')
                        : "";

                let html = `
                    <div class="pl-6 relative">

                        <div class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full ring-4 ring-white bg-blue-500">
                        </div>

                        <div class="flex flex-col gap-1">

                            <div class="flex items-baseline gap-2">
                                <span class="text-xs font-bold text-textprimary">
                                                 ${displayText}
                                </span>

                                <span class="text-[11px] text-textmuted">
                                     by
                                    <span class="font-semibold text-primary">${userName}</span>
                                </span>
                            </div>

                            <p class="text-[11px] font-medium text-textlabel leading-relaxed">
                                ${commentText}
                            </p>

                            <span class="text-[10px] font-bold tracking-wide text-primary">
                                ${formattedDateTime}
                            </span>

                        </div>

                    </div>
                `;

                $('#commentsContainer').append(html);
                
            });
                    
                }
            }
        }
        });
    }

    $(document).ready(function() {
        lucide.createIcons();
        loadComments();
    });

    $('.no-pdf').on('click', function() {
        $('#processLoader').removeClass('hidden').addClass('flex');
        setTimeout(function() {
            $('#processLoader').addClass('hidden').removeClass('flex');
        }, 3000);
    });
</script>


    </div> <!-- End of capture-container -->

