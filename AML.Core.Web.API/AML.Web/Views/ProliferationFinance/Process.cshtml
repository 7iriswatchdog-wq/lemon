         class="fixed inset-0 z-[10000] hidden items-center justify-center bg-black/40">

        <div class="bg-surface rounded-lg shadow-xl w-full max-w-md p-6 space-y-4">
            <h3 class="text-lg font-bold text-textprimary">
                Confirm Action
            </h3>

            <p class="text-sm text-textlabel">
                This change will affect the risk in main case. Do you want to proceed?
            </p>

            <div class="flex justify-end gap-3 pt-4">
