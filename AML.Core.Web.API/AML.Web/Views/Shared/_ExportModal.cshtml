@* Export Modal Partial *@
<div id="exportModal" class="fixed inset-0 z-[10000] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm hidden animate-in fade-in duration-300">
    <div class="bg-white rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] w-full max-w-2xl overflow-hidden border border-slate-200 transform transition-all scale-95 opacity-0 duration-300" id="exportModalContent">
        <!-- Header -->
        <div class="px-7 py-5 border-b border-slate-100 flex items-center justify-between bg-white/80 backdrop-blur-md sticky top-0 z-10">
            <div class="flex items-center gap-4">
                <div class="p-2.5 bg-blue-600 rounded-xl shadow-lg shadow-blue-200">
                    <i data-lucide="download" class="h-5 w-5 text-white"></i>
                </div>
                <div>
                    <h3 class="text-[17px] font-black text-slate-900 tracking-tight">Export Configuration</h3>
                    <p class="text-[11px] text-slate-500 font-bold uppercase tracking-widest mt-0.5 opacity-60">Optimize your data output</p>
                </div>
            </div>
            <button type="button" onclick="closeExportModal()" class="text-slate-400 hover:text-slate-900 hover:bg-slate-100 p-2 rounded-xl transition-all">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="p-7 space-y-7 max-h-[calc(90vh-140px)] overflow-y-auto custom-scrollbar">
            <!-- Format Selection -->
            <div class="space-y-4">
                <label class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] pl-1">Target Format</label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 border-slate-100 cursor-pointer hover:border-blue-100 transition-all has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/20 group">
                        <input type="radio" name="exportFormat" value="excel" checked class="sr-only">
                        <div class="flex items-center gap-3">
                            <div class="p-2 rounded-lg bg-green-50 text-green-600 group-has-[:checked]:bg-green-600 group-has-[:checked]:text-white transition-colors">
                                <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[13px] font-black text-slate-800 group-has-[:checked]:text-blue-900">Microsoft Excel</span>
                                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Spreadsheet (XLSX)</span>
                            </div>
                        </div>
                        <div class="h-5 w-5 rounded-full border-2 border-slate-200 group-has-[:checked]:border-blue-600 group-has-[:checked]:bg-blue-600 flex items-center justify-center transition-all">
                            <div class="h-2 w-2 rounded-full bg-white opacity-0 group-has-[:checked]:opacity-100"></div>
                        </div>
                    </label>
                    <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 border-slate-100 cursor-pointer hover:border-blue-100 transition-all has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/20 group">
                        <input type="radio" name="exportFormat" value="pdf" class="sr-only">
                        <div class="flex items-center gap-3">
                            <div class="p-2 rounded-lg bg-red-50 text-red-600 group-has-[:checked]:bg-red-600 group-has-[:checked]:text-white transition-colors">
                                <i data-lucide="file-text" class="h-5 w-5"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[13px] font-black text-slate-800 group-has-[:checked]:text-blue-900">PDF Document</span>
                                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Fixed Layout (A4)</span>
                            </div>
                        </div>
                        <div class="h-5 w-5 rounded-full border-2 border-slate-200 group-has-[:checked]:border-blue-600 group-has-[:checked]:bg-blue-600 flex items-center justify-center transition-all">
                            <div class="h-2 w-2 rounded-full bg-white opacity-0 group-has-[:checked]:opacity-100"></div>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Column Selection -->
            <div class="space-y-4">
                <div class="flex items-center justify-between pl-1">
                    <label class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em]">Select Columns</label>
                    <div class="flex gap-4">
                        <button type="button" onclick="toggleAllColumns(true)" class="text-[11px] font-black text-blue-600 hover:text-blue-700 uppercase tracking-wider">Select All</button>
                        <button type="button" onclick="toggleAllColumns(false)" class="text-[11px] font-black text-slate-400 hover:text-slate-600 uppercase tracking-wider">Clear</button>
                    </div>
                </div>
                
                <div class="bg-slate-50/50 rounded-2xl border border-slate-200/60 p-4">
                    <div class="max-h-[280px] overflow-y-auto pr-2 custom-scrollbar" id="columnSelectorWrapper">
                        <div class="grid grid-cols-2 gap-2" id="columnSelectorList">
                            <!-- Columns will be injected here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Orientation Selection (Visible for PDF) -->
            <div id="orientationSelection" class="space-y-4 hidden animate-in fade-in slide-in-from-top-2 duration-300">
                <label class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] pl-1">Page Layout</label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="relative flex items-center justify-center p-4 rounded-xl border border-slate-200 cursor-pointer hover:border-blue-200 transition-all has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 group">
                        <input type="radio" name="exportOrientation" value="portrait" checked class="sr-only">
                        <div class="flex flex-col items-center gap-2">
                            <i data-lucide="rectangle-vertical" class="h-5 w-5 text-slate-400 group-has-[:checked]:text-blue-600 transition-transform group-hover:scale-110"></i>
                            <span class="text-[12px] font-bold text-slate-600 group-has-[:checked]:text-blue-700 uppercase tracking-tight">Portrait</span>
                        </div>
                        <div class="absolute top-2 right-2 h-4 w-4 rounded-full border border-slate-200 group-has-[:checked]:border-blue-600 group-has-[:checked]:bg-blue-600 flex items-center justify-center transition-all opacity-0 group-has-[:checked]:opacity-100">
                            <i data-lucide="check" class="h-2.5 w-2.5 text-white"></i>
                        </div>
                    </label>
                    <label class="relative flex items-center justify-center p-4 rounded-xl border border-slate-200 cursor-pointer hover:border-blue-200 transition-all has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 group">
                        <input type="radio" name="exportOrientation" value="landscape" class="sr-only">
                        <div class="flex flex-col items-center gap-2">
                            <i data-lucide="rectangle-horizontal" class="h-5 w-5 text-slate-400 group-has-[:checked]:text-blue-600 transition-transform group-hover:scale-110"></i>
                            <span class="text-[12px] font-bold text-slate-600 group-has-[:checked]:text-blue-700 uppercase tracking-tight">Landscape</span>
                        </div>
                        <div class="absolute top-2 right-2 h-4 w-4 rounded-full border border-slate-200 group-has-[:checked]:border-blue-600 group-has-[:checked]:bg-blue-600 flex items-center justify-center transition-all opacity-0 group-has-[:checked]:opacity-100">
                            <i data-lucide="check" class="h-2.5 w-2.5 text-white"></i>
                        </div>
                    </label>
                </div>
                <div id="orientationRecommendation" class="flex items-center gap-3 text-[11px] font-bold text-blue-600 bg-blue-50/50 p-4 rounded-2xl border border-blue-100/50">
                    <div class="bg-blue-600 p-1 rounded-lg">
                        <i data-lucide="sparkles" class="h-3.5 w-3.5 text-white"></i>
                    </div>
                    <span>AI Recommended: <span id="recommendationText" class="uppercase">Portrait</span> based on selection</span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="px-7 py-5 border-t border-slate-100 bg-slate-50/50 flex items-center gap-4">
            <button type="button" onclick="closeExportModal()" class="flex-1 py-3 bg-white border border-slate-200 text-slate-600 text-[14px] font-bold rounded-2xl hover:bg-slate-50 hover:text-slate-900 transition-all">
                Maybe later
            </button>
            <button type="button" onclick="triggerExport()" class="flex-1 py-3 bg-blue-600 text-white text-[14px] font-black rounded-2xl hover:bg-blue-700 shadow-xl shadow-blue-200 transition-all flex items-center justify-center gap-3 active:scale-95">
                <!-- <i data-lucide="download-cloud" class="h-5 w-5"></i> -->
                Generate File
            </button>
        </div>
    </div>
</div>

    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
</style>

<script>
    // Prevent re-declaration if partial is loaded multiple times
    if (typeof currentExportConfig === 'undefined') {
        window.currentExportConfig = null;
    }

    function openExportModal(config) {
        window.currentExportConfig = config;
        const modal = document.getElementById('exportModal');
        const content = document.getElementById('exportModalContent');
        const list = document.getElementById('columnSelectorList');
        
        if (!list || !content || !modal) return;

        // Clear previous columns
        list.innerHTML = '';

        // Identify which set of columns to use if it's a multi-tab page
        let columnsToRender = config.columns;
        if (config.getColumnsByActiveTab) {
            columnsToRender = config.getColumnsByActiveTab();
        }

        // Adjust Width and Grid based on column count
        if (columnsToRender.length > 20) {
            content.classList.remove('max-w-2xl');
            content.classList.add('max-w-4xl');
            list.classList.remove('grid-cols-2');
            list.classList.add('grid-cols-3');
        } else {
            content.classList.remove('max-w-4xl');
            content.classList.add('max-w-2xl');
            list.classList.remove('grid-cols-3');
            list.classList.add('grid-cols-2');
        }
        
        // Group columns by tab
        const groupedColumns = columnsToRender.reduce((acc, col) => {
            const tab = col.tab || 'General';
            if (!acc[tab]) acc[tab] = [];
            acc[tab].push(col);
            return acc;
        }, {});

        Object.entries(groupedColumns).forEach(([tabName, cols]) => {
            // Add Tab Header
            const header = document.createElement('div');
            header.className = 'col-span-full mt-4 mb-2 first:mt-0';
            header.innerHTML = `
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]">${tabName}</span>
                    <div class="h-px bg-blue-100 flex-1"></div>
                </div>
            `;
            list.appendChild(header);

            // Add Columns for this tab
            cols.forEach(col => {
                const div = document.createElement('div');
                div.className = 'flex items-center gap-3 p-3 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-xl transition-all cursor-pointer group active:scale-95 bg-white/50';
                div.onclick = (e) => {
                    if(e.target.type !== 'checkbox') {
                        const cb = div.querySelector('input');
                        cb.checked = !cb.checked;
                        updateOrientationHint();
                    }
                };
                
                div.innerHTML = `
                    <div class="relative flex items-center">
                        <input type="checkbox" value="${col.id}" checked 
                            class="w-4 h-4 rounded-md border-slate-300 text-blue-600 focus:ring-blue-500/10 cursor-pointer transition-all"
                            onchange="updateOrientationHint()">
                    </div>
                    <span class="text-[12px] font-bold text-slate-600 group-hover:text-blue-600 transition-colors uppercase tracking-tight">${col.label}</span>
                `;
                list.appendChild(div);
            });
        });

        modal.classList.remove('hidden');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
        
        updateOrientationHint();
        if(window.lucide) lucide.createIcons();
    }

    function closeExportModal() {
        const modal = document.getElementById('exportModal');
        const content = document.getElementById('exportModalContent');
        
        if (!content || !modal) return;

        content.classList.add('scale-95', 'opacity-0');
        content.classList.remove('scale-100', 'opacity-100');
        
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    function toggleAllColumns(checked) {
        document.querySelectorAll('#columnSelectorList input[type="checkbox"]').forEach(i => i.checked = checked);
        updateOrientationHint();
    }

    function updateOrientationHint() {
        const selectedCount = document.querySelectorAll('#columnSelectorList input[type="checkbox"]:checked').length;
        const format = document.querySelector('input[name="exportFormat"]:checked').value;
        const selectionDiv = document.getElementById('orientationSelection');
        const recommendationText = document.getElementById('recommendationText');
        
        if (format === 'pdf') {
            selectionDiv.classList.remove('hidden');
            const recommendation = selectedCount > 7 ? 'Landscape' : 'Portrait';
            recommendationText.innerText = recommendation;
            
            // Auto-select recommendation for better UX
            const targetRadio = document.querySelector(`input[name="exportOrientation"][value="${recommendation.toLowerCase()}"]`);
            if (targetRadio) targetRadio.checked = true;
        } else {
            selectionDiv.classList.add('hidden');
        }
    }

    // Listen for format changes to update hint
    document.getElementsByName('exportFormat').forEach(radio => {
        radio.addEventListener('change', updateOrientationHint);
    });

    function triggerExport() {
        if (!currentExportConfig) return;
        
        const format = document.querySelector('input[name="exportFormat"]:checked').value;
        const selectedColumns = Array.from(document.querySelectorAll('#columnSelectorList input[type="checkbox"]:checked'))
            .map(i => i.value)
            .join(',');
            
        if (!selectedColumns) {
            Swal.fire({ icon: 'warning', title: 'Selection Required', text: 'Please select at least one column.' });
            return;
        }

        const orientation = document.querySelector('input[name="exportOrientation"]:checked').value;
        
        // Final action
        if (currentExportConfig.onExport) {
            currentExportConfig.onExport(format, selectedColumns, orientation);
        }
        
        closeExportModal();
    }
</script>
