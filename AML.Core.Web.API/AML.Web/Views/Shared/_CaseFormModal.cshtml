                    <label class="text-[13px] font-bold text-textlabel">
                        Full Name
                    </label>

                        <div class="flex gap-2 common-field">
                            <input type="text"
                                   placeholder="Enter full name"
                                   asp-for="FirstName"
                                   maxlength="100"
                                   id="fullName"
                                   class="w-full h-11 bg-surface border border-bordercolor rounded-xl px-4 text-sm font-medium
              focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all
              fullNameField" />

                       
                        
                    </div>

                    
                </div>

                    <div class="space-y-2.5 md:col-span-1 common-field">
                    <label class="text-[13px] font-bold text-textlabel" id="labelnationality"></label>
                    <div class="relative">
                            <select id="nationality"
                                    class="w-full h-11 bg-surface border border-bordercolor rounded-xl px-4 text-sm font-medium appearance-none outline-none focus:ring-2 focus:ring-blue-500/10"
                                    name="Nationality"
                                    asp-for="Nationality"
                                    disabled>
                                <option value="">Select</option>
                            </select>

                            <!-- Hidden field to submit the selected value -->
                            <input type="hidden"
                                   id="hdnNationality"
                                   name="Nationality"
                                   asp-for="Nationality" />
                       
                    </div>
                </div>
                    <div class="space-y-2 corporate-all-field">
                        <label class="text-[13px] font-bold text-textlabel">Trade Licence Number</label>
                        <input type="text" x-model="manualForm.tradeLicense" placeholder="Enter Trade Licence Number" asp-for="Tradelicense" id="tradelicense"
