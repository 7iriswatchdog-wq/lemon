                function openModalCaseVersion(modalId) {
        const modal = document.getElementById(modalId);
        const customerId = document.getElementById("customerId")?.value;
        const versionValue = document.getElementById("version")?.value;

        if (!customerId) {
            alert("Customer ID not found.");
            return;
        }

        // Current version
        const currentVersion = parseInt(versionValue) || 0;

        $.ajax({
            url: '/Case/GetCaseVersions',
            type: 'GET',
            data: {
                customerId: customerId,
                version: currentVersion
            },
            success: function (response) {

                // Check if data exists
                if (!response || !response.length) {
                    document.getElementById("caseVersionContainer").innerHTML =
                        '<div class="p-6 text-center text-sm text-textmuted">No other versions available.</div>';
                } else {

                    let html = '';
                    const total = response.length;
                    const visibleStartIndex = Math.max(0, total - 2); // show last 2 initially

                    response.forEach((item, index) => {
                        const hideInitially = index < visibleStartIndex;

                        let statusText = '-';
                        switch (item.status) {
                            case 0: statusText = 'Pending'; break;
                            case 1: statusText = 'WhiteList'; break;
                            case 2: statusText = 'Approved'; break;
                            case 3: statusText = 'Rejected'; break;
                            case 4: statusText = 'Pending with Senior Management'; break;
                            case 5: statusText = 'Auto'; break;
                            case 6: statusText = 'Scheduler Pending'; break;
                            case 7: statusText = 'OnHold'; break;
                        }

                        // Format date
                        let updatedDate = '';
                        if (item.createdOn) {
                            updatedDate = new Date(item.createdOn).toLocaleString('en-GB');
                        }

                        html += `
                            <div class="case-item ${hideInitially ? 'hidden' : ''} border border-bordercolor rounded-lg p-4 space-y-2">

                                <!-- Version -->
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio"
                                       name="caseVersion"
                                       value="${item.id}"
                                       data-customerid="${item.customerId}"
                                       data-version="${item.version}"
                                       class="caseVersionRadio" />

                                    <span class="text-sm font-bold text-textprimary">
                                        Version ${item.version}
                                    </span>
                                </label>

                                <!-- CustomerId -->
                                <div class="pl-6 text-sm text-textmuted">
                                    <span class="font-semibold">CustomerId :</span> ${item.customerId}
                                </div>

                                <!-- Status -->
                                <div class="pl-6 text-sm text-textmuted">
                                    <span class="font-semibold">Status :</span> ${statusText}
                                </div>

                                <!-- Updated -->
                                <div class="pl-6 text-xs text-textmuted">
                                    <span class="font-semibold">Updated :</span> ${updatedDate}
                                </div>
                            </div>
                        `;
                    });

                    // Footer buttons
                    html += `
                        <div class="px-6 pb-6 flex justify-between mt-4">
                            <button onclick="selectCaseVersion()"
                                    class="bg-primary text-white font-bold text-xs h-9 px-6 rounded-md">
                                Select
                            </button>

                            ${total > 2 ? `
                                <button id="btnMoreCases"
                                        onclick="showAllCaseVersions()"
                                        class="bg-primary text-white font-bold text-xs h-9 px-6 rounded-md">
                                    More
                                </button>
                            ` : ''}
                        </div>
                    `;

                    document.getElementById("caseVersionContainer").innerHTML = html;
                }

                // Show modal
                modal.classList.remove('hidden');
                modal.classList.add('flex');

                // Re-render icons
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            },
            error: function (xhr) {
                console.error("Status:", xhr.status);
                console.error("Response:", xhr.responseText);
                alert("Unable to load case versions.");
            }
        });
    }

