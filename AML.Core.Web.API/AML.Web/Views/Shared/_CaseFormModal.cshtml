            // Intercept submit button click - show confirmation popup ONLY in Edit mode

        // Use this script instead of the previous one.
    // IMPORTANT:
    // 1. Remove any other click handlers attached to #btnSubmit.
    // 2. Place this script AFTER the <form> and modal HTML.
    // 3. Keep the button type="submit" as it is.

    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("myForm");
        const btnSubmit = document.getElementById("btnSubmit");
        const modal = document.getElementById("submitConfirmationModal");
        const btnConfirmSubmit = document.getElementById("btnConfirmSubmit");
        const btnCancelSubmit = document.getElementById("btnCancelSubmit");
        const chkOthers = document.getElementById("chkOthers");
        const othersReasonContainer = document.getElementById("othersReasonContainer");
        const othersReason = document.getElementById("othersReason");
        const validationMsg = document.getElementById("reasonValidationMessage");

        let isConfirmed = false;

        if (!form || !btnSubmit || !modal) {
            console.error("Form, submit button, or modal not found.");
            return;
        }

        // ==========================================
        // INTERCEPT FORM SUBMISSION (BEST APPROACH)
        // ==========================================
        form.addEventListener("submit", function (e) {

            // If already confirmed, allow submission
            if (isConfirmed) {
                return true;
            }

            // Check mode
            const mode = document.getElementById("mode")?.value;
            console.log(mode);

            // Only show popup in Edit mode
            if (mode !== "edit") {
                isConfirmed = true;
                return true;
            }

            // Stop form submission
            e.preventDefault();
            e.stopImmediatePropagation();

            // Validate form first (jQuery Validation)
            if (typeof $ !== "undefined" &&
                $(form).valid &&
                !$(form).valid()) {
                return false;
            }

            // Reset checkbox selections
            document.querySelectorAll(".reason-checkbox").forEach(cb => {
                cb.checked = false;
            });

            // Reset others textbox
            if (othersReason) {
                othersReason.value = "";
            }

            // Hide others section
            if (othersReasonContainer) {
                othersReasonContainer.classList.add("hidden");
            }

            // Clear hidden fields
            document.getElementById("hdnSubmissionReasons").value = "";
            document.getElementById("hdnOthersReason").value = "";

            // Clear validation message
            if (validationMsg) {
                validationMsg.classList.add("hidden");
                validationMsg.textContent = "";
            }

            // Show modal
            modal.classList.remove("hidden");
            modal.style.display = "flex";

            return false;
        });

        // ==========================================
        // SHOW/HIDE OTHERS TEXTBOX
        // ==========================================
        if (chkOthers) {
            chkOthers.addEventListener("change", function () {
                if (this.checked) {
                    othersReasonContainer.classList.remove("hidden");
                    if (othersReason) {
                        othersReason.focus();
                    }
                } else {
                    othersReasonContainer.classList.add("hidden");
                    if (othersReason) {
                        othersReason.value = "";
                    }
                }
            });
        }

        // ==========================================
        // CANCEL BUTTON
        // ==========================================
        if (btnCancelSubmit) {
            btnCancelSubmit.addEventListener("click", function () {
                modal.classList.add("hidden");
                modal.style.display = "none";
            });
        }

        // ==========================================
        // CONFIRM BUTTON
        // ==========================================
        if (btnConfirmSubmit) {
            btnConfirmSubmit.addEventListener("click", function () {

                const selectedReasons = [];

                // Collect selected reasons
                document.querySelectorAll(".reason-checkbox:checked").forEach(cb => {
                    selectedReasons.push(cb.value);
                });

                // Validate at least one reason
                if (selectedReasons.length === 0) {
                    if (validationMsg) {
                        validationMsg.textContent = "Please select at least one reason.";
                        validationMsg.classList.remove("hidden");
                    } else {
                        alert("Please select at least one reason.");
                    }
                    return;
                }

                // Hide validation message
                if (validationMsg) {
                    validationMsg.classList.add("hidden");
                    validationMsg.textContent = "";
                }

                // Validate Others textbox
                const isOthersSelected = selectedReasons.includes("Others");
                const otherText = othersReason ? othersReason.value.trim() : "";

                if (isOthersSelected && otherText === "") {
                    alert("Please enter the reason for 'Others'.");
                    if (othersReason) {
                        othersReason.focus();
                    }
                    return;
                }

                // Save selected values
                document.getElementById("hdnSubmissionReasons").value =
                    selectedReasons.join(",");

                document.getElementById("hdnOthersReason").value =
                    isOthersSelected ? otherText : "";

                // Mark as confirmed
                isConfirmed = true;

                // Hide modal
                modal.classList.add("hidden");
                modal.style.display = "none";

                // Submit form programmatically
                form.submit();
            });
        }

        // ==========================================
        // CLOSE WHEN CLICKING OUTSIDE
        // ==========================================
        modal.addEventListener("click", function (e) {
            if (e.target === modal) {
                modal.classList.add("hidden");
                modal.style.display = "none";
            }
        });
    });

</script>