            customerIdBtn.disabled = flag;
            customerIdBtn.style.pointerEvents = flag ? "none" : "";
            customerIdBtn.style.opacity = flag ? "0.6" : "";
        }

        // Customer ID Type checkboxes
        document.querySelectorAll(".customer-id-checkbox").forEach(cb => {
            cb.disabled = flag;
        });

        // Passport fields
        ["passportId", "passortIssuedate", "passportExpirydate"].forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.disabled = flag;
            }
        });

        // Emirates ID fields
        ["EID_Number", "emirateIssueDate", "emirateExpiryDate"].forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.disabled = flag;
            }
        });
            // if (dobInput._flatpickr) {
            //     dobInput._flatpickr.set("clickOpens", false);
