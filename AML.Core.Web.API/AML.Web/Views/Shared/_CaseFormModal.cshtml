@model AML.ViewModel.ViewModels.CustomerCase.CaseModel

<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


<style>
    .flatpickr-wrapper {
        width: 100% !important;
    }

    .flatpickr-alt-input {
        width: 100% !important;
        display: block !important;
    }
</style>

<body class="bg-[#f8fafc] text-textprimary overflow-hidden" x-data="{
    sidebarOpen: true,
    selectedMethod: 'manual',
    isDuplicateModalOpen: false,
    isSuccessModalOpen: false,
    showTreeSheet: false,
    files: [],
    isDragging: false,
    showSuccessModal: false,
    matchParam: 70,
    hasSearched: false,
    activeShareholderTab: 'shareholder',
    searchQuery: '',
    manualForm: {
        screeningOption: '',
        companyName: '',
        country: '',
        residence: '',
        tradeLicense: '',
        regDate: '',
        expiryDate: '',
        legalStatus: '',
        businessActivities: '',
        product: '',
        deliveryChannel: '',
        cif: ''
    }
}">

<div id="caseModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">

    <div class="bg-white w-[95%] max-h-[95vh] overflow-y-auto rounded-2xl shadow-xl p-6">

        <!-- Header -->
        <div class="flex justify-between items-center border-b pb-3">
            <h2 id="modalTitle" class="text-lg font-bold"></h2>
                <div class="flex items-center gap-2">
                    <!-- View Case Version Button -->
                    <button id="caseVersionButton" style="display: none;" onclick="openModalCaseVersion('caseVersionModal')"
                            type="button"
                            class="h-8 w-8 flex items-center justify-center rounded-lg text-primary hover:bg-blue-50 transition-all no-pdf"
                            title="View Case Version">
                        <i data-lucide="git-compare" class="h-4 w-4"></i>
                    </button>

                    <!-- Close Button -->
                    <button type="button"
                            onclick="closeModal()"
                            class="h-8 w-8 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-all"
                            title="Close">
                        ✖
                    </button>
                </div>
        </div>

        <!-- FORM -->
            <form class="space-y-8" id="myForm" asp-controller="Case" asp-action="UpdateAndReplace" method="post" enctype="multipart/form-data">

                <input type="hidden" id="recordId" asp-for="Id" name="Id" />
                <input type="hidden" id="mode" asp-for="Mode" name="Mode" />
                <input type="hidden" id="customerId" asp-for="CustomerId" name="CustomerId" />
                <input type="hidden" id="actionScreen" asp-for="ActionScreen" name="ActionScreen" />
                <input type="hidden" id="lastestVersion" asp-for="LastestVersion" name="LastestVersion" />
                <input type="hidden" id="version" asp-for="Version" name="Version" />
                <input type="hidden" id="hdnSubmissionReasons" asp-for="SubmissionReasons" name="SubmissionReasons" />
                <input type="hidden" id="hdnOthersReason" asp-for="OtherReason" name="OtherReason" />
                <input type="hidden" id="hdnSelectedVersions" asp-for="SelectedVersions" name="SelectedVersions" />

                <input type="hidden" id="hdnCustomerType" asp-for="CustomerType" name="CustomerType" />

                <!-- Version Multi Select Dropdown -->
                <!-- Version Multi Select Dropdown -->
                <div id="versionDropdownContainer"
     class="space-y-2.5 md:col-span-2 edit-only max-w-xs"
     style="display: none;">

    <!-- Alpine Component Wrapper -->
    <div x-data="versionDropdownComponent()">

        <!-- Label -->
        <label class="text-[13px] font-bold text-textlabel">
            Select Risk Versions
        </label>

        <!-- Dropdown -->
        <div class="relative">

            <!-- Trigger Button -->
            <button type="button"
                    x-on:click="versionOpen = !versionOpen"
                    class="w-full h-11 bg-surface border border-bordercolor rounded-xl px-4 text-sm font-medium flex items-center justify-between hover:border-slate-300 transition-all outline-none focus:ring-2 focus:ring-blue-500/10">

                <span class="text-textprimary"
                      x-text="selectedVersionText"></span>

                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-4 h-4 text-textmuted transition-transform duration-200"
                     x-bind:class="versionOpen ? 'rotate-180' : ''"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>

            <!-- Dropdown Popup -->
            <div x-show="versionOpen"
                 x-on:click.outside="versionOpen = false"
                 x-transition
                 x-cloak
                 class="absolute z-50 w-full mt-2 bg-surface border border-bordercolor rounded-xl shadow-xl p-2 max-h-72 overflow-y-auto">

                <!-- Select All -->
                <label class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-appbg cursor-pointer">
                    <input type="checkbox"
                           id="chkAllVersions"
                           x-on:change="toggleAll($event)"
                           class="w-4 h-4 text-primary rounded border-slate-300">

                    <span class="text-sm font-semibold text-primary">
                        All
                    </span>
                </label>

                <!-- Dynamic Version Options -->
                <div id="versionCheckboxList"></div>
            </div>
        </div>

        <!-- Hidden Inputs for Form Submission -->
        <template x-for="version in selectedVersions.filter(v => v !== 'ALL')"
                  :key="version">
            <input type="hidden"
                   name="SelectedVersions"
                   x-bind:value="version" />
        </template>

        <!-- Help Text -->
        <p class="text-[11px] text-textmuted">
            Select one or more Risk versions using checkboxes.
        </p>
    </div>
</div>
            <!-- Grid Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6" x-data="{
                 idOpen: false,
                 selectedIds: [],
                 get showPassport() { return this.selectedIds.some(id => id.toLowerCase() === 'passport') },
                 get showEID() { return this.selectedIds.some(id => id.toLowerCase() === 'emirates id') },
                 get selectedText() {
                 return this.selectedIds.length>
                0 ? this.selectedIds.join(', ') : 'Select';
                }
                }" x-effect="selectedIds; $nextTick(() => initAllDatePickers())">
