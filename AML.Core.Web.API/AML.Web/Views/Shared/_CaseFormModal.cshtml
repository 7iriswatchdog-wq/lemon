                    </div>
                    <div class="space-y-2 corporate-all-field">
                        <label class="text-[13px] font-bold text-textlabel">Trade Licence Authority</label>
                        <select x-model="manualForm.tradeLicenseauthority" class="w-full h-11 bg-surface border border-bordercolor rounded-xl px-4 text-sm appearance-none outline-none" asp-for="TradeLicenseAuthority" id="tradelicenseAuthority">
                            <option value="">Select</option>
                            <option value="ABC">ABC</option>
                            <option value="DFC">DFC</option>
                        </select>

                    </div>

