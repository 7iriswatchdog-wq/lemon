        "passportId",
        "passortIssuedate",
        "passportExpirydate",
        "EID_Number",
        "emirateIssueDate",
        "emirateExpiryDate"
    ].forEach(id => {

        const el = document.getElementById(id);

        if (!el) {
            console.log(id + " not found");
            return;
        }

        el.disabled = flag;
        el.readOnly = flag;

        if (el._flatpickr) {
            el._flatpickr.set("clickOpens", !flag);

            if (el._flatpickr.altInput) {
                el._flatpickr.altInput.disabled = flag;
                el._flatpickr.altInput.readOnly = flag;
            }
        }
    });
