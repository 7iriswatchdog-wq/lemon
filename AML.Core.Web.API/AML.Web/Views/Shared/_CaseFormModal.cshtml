                    //     <span class="text-sm text-textlabel">
                    //         Version ${versionValue}
                    //     </span>
                    // `;

                    const checkbox = wrapper.querySelector("input");

                    // IMPORTANT:
                    // Single checkbox change handler
                    checkbox.addEventListener("change", function () {
                        console.log(
