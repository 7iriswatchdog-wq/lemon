                    </div>

                    <!-- Hidden input for backward compatibility if needed by server validation -->
                    <input type="hidden" name="CustomerIdType" :value="selectedIds.join(',')">
                </div>

                <!-- Passport Fields - Flattened -->
                <template x-if="showPassport" x-init="$nextTick(() => initAllDatePickers())">
