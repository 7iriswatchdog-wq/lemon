                        <script>

           function versionDropdownComponent() {
        return {
            versionOpen: false,
            selectedVersions: [],

            // Display text in dropdown
            get selectedVersionText() {
                console.log("selectedVersionText ->", this.selectedVersions);

                if (this.selectedVersions.length === 0) {
                    return "Select Versions";
                }

                if (this.selectedVersions.includes("ALL")) {
                    return "All Versions Selected";
                }

                const versionCount = this.selectedVersions.filter(v => v !== "ALL").length;
                return versionCount + " Version(s) Selected";
            },

            // Update hidden field manually
            updateHiddenField() {
                const hiddenField = document.getElementById("hdnSelectedVersions");

                if (!hiddenField) {
                    console.log("hdnSelectedVersions not found");
                    return;
                }

                const values = this.selectedVersions.filter(v => v !== "ALL");

                hiddenField.value = values.join(",");

                console.log("Hidden field updated:", hiddenField.value);

                // Trigger change event so Alpine detects update
                hiddenField.dispatchEvent(new Event("input"));
                hiddenField.dispatchEvent(new Event("change"));
            },

            // Select / Unselect All
            toggleAll(event) {
                console.log("toggleAll triggered");

                const checkboxes = document.querySelectorAll(".version-checkbox");

                if (event.target.checked) {
                    this.selectedVersions = ["ALL"];

                    checkboxes.forEach(cb => {
                        cb.checked = true;

                        const value = String(cb.value).trim();

                        if (!this.selectedVersions.includes(value)) {
                            this.selectedVersions.push(value);
                        }
                    });

                    console.log("All selected:", this.selectedVersions);
                }
                else {
                    this.selectedVersions = [];

                    checkboxes.forEach(cb => {
                        cb.checked = false;
                    });

                    console.log("All unchecked");
                }

                // Force Alpine refresh
                this.selectedVersions = [...this.selectedVersions];

                this.updateHiddenField();
            },

            // Called when individual checkbox changes
            syncAllCheckbox() {
                console.log("syncAllCheckbox triggered");

                const checkboxes = document.querySelectorAll(".version-checkbox");
                const allCheckbox = document.getElementById("chkAllVersions");

                if (!allCheckbox) {
                    console.log("All checkbox not found");
                    return;
                }

                const checkedCheckboxes = Array.from(checkboxes)
                    .filter(cb => cb.checked);

                console.log(
                    "Checked checkboxes:",
                    checkedCheckboxes.map(cb => cb.value)
                );

                // Get selected values
                this.selectedVersions = checkedCheckboxes.map(cb =>
                    String(cb.value).trim()
                );

                // If all versions selected
                if (
                    checkedCheckboxes.length === checkboxes.length &&
                    checkedCheckboxes.length > 0
                ) {
                    allCheckbox.checked = true;

                    if (!this.selectedVersions.includes("ALL")) {
                        this.selectedVersions.unshift("ALL");
                    }
                }
                else {
                    allCheckbox.checked = false;

                    this.selectedVersions = this.selectedVersions.filter(
                        v => v !== "ALL"
                    );
                }

                // Force Alpine reactivity
                this.selectedVersions = [...this.selectedVersions];

                console.log("Updated selectedVersions:", this.selectedVersions);

                this.updateHiddenField();
            }
        };
    }

    function loadVersionDropdown(customerId, currentVersion,type) {
        $.ajax({
            url: '/Case/GetRiskCaseVersions',
            type: 'GET',
            dataType: 'json',
            data: {
                customerId: customerId,
                version: currentVersion,
                type:type
