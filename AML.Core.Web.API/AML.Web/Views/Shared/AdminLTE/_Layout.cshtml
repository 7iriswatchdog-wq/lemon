    function closeOtherParents(currentId) {
        const parents = [
            { id: 'name-screening-parent-dropdown', arrow: 'dropdown-arrow-parent' },
            { id: 'pf-dropdown', arrow: 'dropdown-arrow-pf' },
            { id: 'reports-dropdown', arrow: 'dropdown-arrow-reports' },
