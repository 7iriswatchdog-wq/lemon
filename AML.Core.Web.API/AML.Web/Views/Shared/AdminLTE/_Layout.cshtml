    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-export.js"></script>

    @if (allowedModules.Contains(17))
    {
        <!-- Agentic RAG FAB & Chat -->
        <div x-data="agenticChat()" class="fixed bottom-6 right-6 z-[9999] no-pdf" x-init="init()" x-cloak>
            <!-- FAB Button -->
            <button @@click="toggleChat()" 
                    class="h-14 w-14 rounded-full bg-blue-600 text-white shadow-lg hover:bg-blue-700 transition-all flex items-center justify-center group transform hover:scale-105 active:scale-95">
                <i data-lucide="message-square" x-show="!isOpen" class="h-6 w-6"></i>
                <i data-lucide="x" x-show="isOpen" class="h-6 w-6" style="display: none;"></i>
                
                <!-- Notification Badge -->
                @*<span x-show="!isOpen" class="absolute -top-1 -right-1 h-4 w-4 bg-red-500 rounded-full border-2 border-white"></span>*@
            </button>

            <!-- Chat Popup -->
            <div x-show="isOpen" 
                 x-on:click.outside="isOpen = false"
                 style="display: none;"
                 x-transition:enter="transition ease-out duration-300 transform"
                 x-transition:enter-start="opacity-0 translate-y-4 scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 x-transition:leave="transition ease-in duration-200 transform"
                 x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 scale-95"
                 class="absolute bottom-20 right-0 w-[400px] h-[550px] bg-white rounded-2xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
                
                <!-- Header -->
                <div class="p-4 bg-blue-600 text-white flex justify-between items-center rounded-t-2xl shadow-lg border-b border-primary/20">
                    <div class="flex items-center gap-3">
                        <div class="p-2 bg-white/20 rounded-lg backdrop-blur-sm">
                            <i data-lucide="bot" class="w-5 h-5 text-white"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-lg tracking-tight">Case Assistant</h3>
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
                                <span class="text-xs text-white/80 font-medium">Online & Ready</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button @@click="resetChat" class="p-2 hover:bg-white/20 rounded-full transition-all duration-300 group" title="Reset Chat">
                            <i data-lucide="rotate-ccw" class="w-5 h-5 text-white group-hover:rotate-[-45deg] transition-transform"></i>
                        </button>
                        <button @@click="toggleChat" class="p-2 hover:bg-white/20 rounded-full transition-all duration-300" title="Close">
                            <i data-lucide="minus" class="w-5 h-5 text-white"></i>
                        </button>
                    </div>
                </div>

                <!-- Messages -->
                <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50 custom-scrollbar">
                    <template x-for="msg in messages">
                        <div :class="msg.role === 'user' ? 'flex justify-end' : 'flex justify-start'">
                            <div :class="msg.role === 'user' ? 'bg-blue-600 text-white text-xs' : 'bg-white border border-slate-200 text-slate-800 text-xs'"
                                 class="max-w-[85%] p-3 rounded-2xl shadow-sm leading-relaxed prose-chat">
                                <div x-html="renderMessage(msg.content)"></div>
                                <span x-show="msg.role === 'assistant' && msg.isComplete" class="block mt-2 text-[9px] opacity-50 font-bold uppercase tracking-wider text-slate-400">Source: Case Context</span>
                            </div>
                        </div>
                    </template>

                    <!-- Predefined Questions -->
                    <div x-show="showOptions" class="space-y-2 pt-2">
                        <template x-for="q in predefinedQuestions">
                            <button @@click="selectQuestion(q)" 
                                    class="block w-full text-left p-3 text-xs bg-white border border-blue-100 text-blue-600 rounded-xl hover:bg-blue-50 transition-all shadow-sm">
                                <span x-text="q"></span>
                            </button>
                        </template>
                        <button @@click="showInput = true; showOptions = false" 
                                class="block w-full text-left p-3 text-xs bg-slate-100 text-slate-600 rounded-xl hover:bg-slate-200 transition-all border border-transparent">
                            Other Option / Ask custom question...
                        </button>
                    </div>

                    <div x-show="isTyping" class="flex justify-start">
                        <div class="bg-white border border-slate-200 p-3 rounded-2xl shadow-sm flex gap-1">
                            <span class="h-1.5 w-1.5 bg-slate-400 rounded-full animate-bounce"></span>
                            <span class="h-1.5 w-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
                            <span class="h-1.5 w-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
                        </div>
                    </div>
                </div>

                <!-- Input Area -->
                <div x-show="showInput" x-cloak class="p-4 bg-white border-t border-slate-100">
                    <div class="relative flex items-center">
                        <input @@keydown.enter="sendMessage()" 
                               x-model="userInput"
                               type="text" 
                               placeholder="Ask about a case... (e.g. #12345)"
                               class="w-full pl-4 pr-12 py-3 bg-slate-100 border-none rounded-xl text-xs focus:ring-2 focus:ring-blue-500 transition-all outline-none">
                        <button @@click="sendMessage()" 
                                class="absolute right-2 h-8 w-8 bg-blue-600 text-white rounded-lg flex items-center justify-center hover:bg-blue-700 transition-all shadow-md">
                            <i data-lucide="send" class="h-4 w-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function agenticChat() {
                return {
                    isOpen: false,
                    isTyping: false,
                    userInput: '',
                    showInput: false,
                    showOptions: true,
                    currentCaseId: null,
                    currentModule: 'General',
                    pendingQueryType: null,
                    predefinedQuestions: [],
                    messages: [
                        { role: 'assistant', content: 'Hello! I am your Case Assistant. How can I help you today?', isComplete: true }
                    ],
                    init() {
                        this.detectModule();
                        this.extractContextId();
                        this.updateQuestions();
                        setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 100);
                    },
                    detectModule() {
                        const path = window.location.pathname.toLowerCase();
                        if (path === '/' || path.includes('/home')) this.currentModule = 'Dashboard';
                        else if (path.includes('/case/create') || path.includes('/corporate/corporatescreening')) this.currentModule = 'Screening';
                        else if (path.includes('/proliferationfinance')) this.currentModule = 'PF';
                        else if (path.includes('/report')) this.currentModule = 'Reports';
                        else if (path.includes('/adminmanagement') || path.includes('/user')) this.currentModule = 'Admin';
                        else if (path.includes('/process') || path.includes('/details')) this.currentModule = 'Process';
                        else this.currentModule = 'General';
                    },
                    updateQuestions() {
                        const mappings = {
                            'Dashboard': [
                                'How many high-risk cases are pending?',
                                'Is the daily scheduler currently running?',
                                'Show me a summary of cases by status'
                            ],
                            'Screening': [
                                'What are mandatory KYC fields?',
                                'How is risk score calculated?',
                                'Documents required for Individual screening?'
                            ],
                            'PF': [
                                'How do I review hits for a PF case?',
                                'How to escalate to Senior Management?',
                                'What does Whitelist mean?'
                            ],
                            'Reports': [
                                'How to export Case Process PDF?',
                                'Where are screening database logs?',
                                'Can I see rejected cases report?'
                            ],
                            'Admin': [
                                'How to create a new user group?',
                                'How to assign client rights?',
                                'Manage system roles and permissions'
                            ],
                            'Process': [
                                'What is the status of this case?',
                                'Is there a pending hit review?',
                                'What is the final risk score breakdown?'
                            ],
                            'General': [
                                'How to create a new case?',
                                'Help with login and permissions',
                                'What is Lemon WatchDog?'
                            ]
                        };
                        this.predefinedQuestions = mappings[this.currentModule] || mappings['General'];
                    },
                    extractContextId() {
                        // 1. Try URL (e.g. /case/Process/429)
                        const urlMatch = window.location.pathname.match(/\/(?:Process|Details)\/([A-Z0-9]+)/i);
                        if (urlMatch) {
                            this.currentCaseId = urlMatch[1];
                            return;
                        }

                        // 2. Try page elements (e.g. searching for "Customer ID" label's nearby text)
                        const possibleIds = Array.from(document.querySelectorAll('td, span, div, p'))
                            .filter(el => el.innerText && /^[A-Z]{3}[0-9]{3}$/i.test(el.innerText.trim()));
                        if (possibleIds.length > 0) {
                            this.currentCaseId = possibleIds[0].innerText.trim();
                        }
                    },
                    selectQuestion(q) {
                        let type = '';
                        if (q.includes('status')) type = 'status';
                        if (q.includes('hit')) type = 'hit';
                        if (q.includes('risk')) type = 'risk';
                        
                        this.messages.push({ role: 'user', content: q });
                        
                        if (this.currentCaseId) {
                            this.userInput = q; // For regex logic in sendMessage
                            this.sendMessage(type, true); // Added 'skipPush' flag
                            this.showInput = true;
                            this.showOptions = false;
                        } else {
                            this.messages.push({ role: 'assistant', content: "To answer that, I need a Case ID. Please provide it (e.g., #12345)." });
                            this.pendingQueryType = type;
                            this.showInput = true;
                            this.showOptions = false;
                        }
                    },
                    resetChat() {
                        this.messages = [
                            { role: 'assistant', content: 'Hello! I am your Case Assistant. How can I help you today?' }
                        ];
                        this.showOptions = true;
                        this.showInput = false;
                        this.pendingQueryType = null;
                        this.userInput = '';
                        this.currentCaseId = null; // Clear persisting context
                        this.scrollToBottom();
                    },
                    toggleChat() {
                        this.isOpen = !this.isOpen;
                        if (this.isOpen) {
                            setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 100);
                            this.scrollToBottom();
                        }
                    },
                    async sendMessage(queryType = null, skipPush = false) {
                        if (!this.userInput.trim() && !queryType) return;

                        const userMsg = this.userInput || (queryType ? `Tell me about the ${queryType}.` : "");
                        if (!skipPush) {
                            this.messages.push({ role: 'user', content: userMsg });
                        }
                        this.userInput = '';
                        this.isTyping = true;
                        this.scrollToBottom();

                        let caseIdMatch = userMsg.match(/#([A-Z0-9]+)/i) || userMsg.match(/\b([A-Z]*[0-9][A-Z0-9]*)\b/i);
                        let typeToUse = queryType || this.pendingQueryType;
                        let caseId = caseIdMatch ? caseIdMatch[1] : (typeToUse ? this.currentCaseId : null);

                        if (caseIdMatch) this.currentCaseId = caseId;

                        // Prepare History (only role and content)
                        const history = (this.messages || [])
                            .filter(m => m.isComplete && m.content)
                            .slice(-6)
                            .map(m => ({ role: m.role, content: m.content }));

                        try {
                            const url = isGeneral 
                                ? `/api/Chat/stream/general?prompt=${encodeURIComponent(userMsg)}&module=${this.currentModule}`
                                : (typeToUse 
                                    ? `/api/Chat/stream/${caseId}?queryType=${typeToUse}` 
                                    : `/api/Chat/stream/${caseId}`);
                                    
                            const response = await fetch(url, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(history)
                            });
                                
                                if (!response.ok) throw new Error("Network response was not ok");
                                
                                const reader = response.body.getReader();
                                const decoder = new TextDecoder();
                                
                                // Add initial empty assistant message
                                const assistantMsgIndex = this.messages.push({ 
                                    role: 'assistant', 
                                    content: '', 
                                    isComplete: false 
                                }) - 1;
                                
                                this.isTyping = false; // Hide bounce once streaming starts

                                while (true) {
                                    const { value, done } = await reader.read();
                                    if (done) break;
                                    
                                    const chunk = decoder.decode(value);
                                    const lines = chunk.split('\n');
                                    
                                    for (const line of lines) {
                                        if (line.startsWith('data: ')) {
                                            try {
                                                const data = JSON.parse(line.substring(6));
                                                this.messages[assistantMsgIndex].content += data.t;
                                                this.scrollToBottom();
                                            } catch (e) { console.error("JSON parse error in stream", e); }
                                        }
                                    }
                                }
                                this.messages[assistantMsgIndex].isComplete = true;
                                this.pendingQueryType = null;
                            } catch (e) {
                                this.isTyping = false;
                                this.messages.push({ role: 'assistant', content: "I'm having trouble connecting to the data source right now.", isComplete: true });
                            }
                        } else {
                            setTimeout(() => {
                                this.messages.push({ role: 'assistant', content: "I need a Case ID (e.g., #12345) to provide specific details.", isComplete: true });
                                this.isTyping = false;
                                this.scrollToBottom();
                            }, 500);
                        }
                        
                        this.isTyping = false;
                        this.scrollToBottom();
                        setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);
                    },
                    renderMessage(content) {
                        if (!content) return "";
                        // Configure marked to handle single line breaks
                        marked.setOptions({
                            breaks: true,
                            gfm: true
                        });
                        return marked.parse(content);
                    },
                    scrollToBottom() {
                        setTimeout(() => {
                            const container = document.getElementById('chatMessages');
                            if (container) container.scrollTop = container.scrollHeight;
                        }, 100);
                    }
                }
            }
        </script>
    }
  </body>
