    @await Component.InvokeAsync("NToastNotify")
    <script>
        // Mirror Startup.cs ToastrOptions for inline toastr.X() calls in views.
        // 2026-05-03 update: previous "persist forever" config caused toasts to stack
        // up when actions fired in quick succession (e.g. adding 5 related parties → 5
        // overlapping pills). Now: short auto-dismiss + close button + extended time
        // when the user hovers, so they stay long enough to read but don't pile up.
        if (typeof toastr !== 'undefined') {
            toastr.options = Object.assign(toastr.options || {}, {
                timeOut: 4000,
                extendedTimeOut: 2000,
                closeButton: true,
                tapToDismiss: true,
                progressBar: true,
                preventDuplicates: true,
                newestOnTop: true,
                positionClass: 'toast-bottom-right'
            });
        }
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-export.js"></script>

    @if (allowedModules.Contains(17) && (ViewBag.HideChatbot == null || (bool)ViewBag.HideChatbot == false))
    {
