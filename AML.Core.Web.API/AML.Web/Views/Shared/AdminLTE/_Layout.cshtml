            <style>
                .msg-user-bubble, 
                .msg-user-bubble *, 
                .msg-user-bubble p, 
                .msg-user-bubble span, 
                .msg-user-bubble strong,
                .msg-user-bubble li,
                div.bg-blue-600,
                div.bg-blue-600 *,
                div.bg-blue-600 p,
                div.bg-blue-600 span,
                div.bg-blue-600 strong,
                div.bg-blue-600 li,
                div[class*="max-w-"].msg-user-bubble > div:not(.cr-header) > p,
                div[class*="max-w-"].bg-blue-600 > div:not(.cr-header) > p {
                    color: #ffffff !important;
                }
            </style>
            <!-- FAB Button -->
            <button @@click.stop="toggleChat()" 
                    class="relative h-14 w-14 rounded-full bg-blue-600 text-white shadow-lg hover:bg-blue-700 transition-all flex items-center justify-center group transform hover:scale-105 active:scale-95">
                <i data-lucide="message-square" x-show="!isOpen" class="h-6 w-6"></i>
                <i data-lucide="x" x-show="isOpen" class="h-6 w-6" style="display: none;"></i>
                <!-- #22 Notification Badge: shows when a new AI reply arrived while closed -->
                <span x-show="hasUnread && !isOpen"
                      class="absolute -top-1 -right-1 h-4 w-4 bg-red-500 rounded-full border-2 border-white animate-bounce"></span>
            </button>

            <!-- Backdrop for Expanded Modal -->
            <div x-show="isOpen && isExpanded" 
                 class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[99998]"
