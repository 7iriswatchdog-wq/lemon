    </div>

</aside>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- MAIN CONTENT                                            -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="main-area">

    <!-- Top Bar -->
    <header class="topbar">
        <div class="topbar-left">
            <div class="tb-crumbs">
                <a asp-controller="Home" asp-action="Index">Searchin</a>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                <span class="crumb-active">@ViewContext.RouteData.Values["Controller"]</span>
                @if (ViewContext.RouteData.Values["Action"]?.ToString() != "Index")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    <span class="crumb-active">@ViewContext.RouteData.Values["Action"]</span>
                }
            </div>

            <div class="topbar-search">
                <svg class="s-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="Search cases, customers…">
                <span class="s-hint">⌘K</span>
            </div>
        </div>

        <div class="topbar-right">
            <!-- Help -->
            <button class="tb-btn" title="Help & Resources">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </button>

            <!-- Notifications -->
            <div style="position:relative;" id="notifWrapper">
                <button class="tb-btn" onclick="document.getElementById('notifPanel').classList.toggle('hidden')" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    <span class="badge" id="notifBadge"></span>
                </button>
                <div id="notifPanel" class="hidden notif-dropdown">
                    <div style="padding:14px 18px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
                        <span style="font-size:13px;font-weight:700;color:#0f172a;">Notifications</span>
                        <span style="font-size:10px;color:#6366f1;font-weight:700;background:#eef2ff;padding:2px 7px;border-radius:6px;letter-spacing:0.04em;">2 NEW</span>
                    </div>
                    <div style="max-height:300px;overflow-y:auto;padding:6px;">
                        <div style="padding:10px 12px;display:flex;gap:10px;border-radius:10px;cursor:pointer;transition:background 0.1s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                            <div style="width:32px;height:32px;border-radius:8px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            </div>
                            <div style="min-width:0;">
                                <p style="font-size:12.5px;font-weight:600;color:#1e293b;margin:0;">PEP match detected</p>
                                <p style="font-size:11.5px;color:#64748b;margin:2px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Case #SC-821 — review required</p>
                            </div>
                            <span style="font-size:10px;color:#94a3b8;white-space:nowrap;margin-left:auto;">2m</span>
                        </div>
                    </div>
                    <a href="#" style="display:block;padding:10px;text-align:center;font-size:12px;font-weight:600;color:#6366f1;text-decoration:none;border-top:1px solid #f1f5f9;">View all</a>
                </div>
            </div>

            <div class="tb-sep"></div>

            <!-- Profile -->
            <div class="tb-profile">
                <div class="tb-profile-info">
                    <div class="tb-profile-name">@userName</div>
                    <div class="tb-profile-role">@clientname</div>
                </div>
                <div class="tb-avatar">@initials</div>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <div style="flex:1;overflow-y:auto;padding:0;">
        <div id="new" class="custom-container page-enter">
            <div class="wrapper">
                <div class="loader text-center" id="AjaxLoader" style="display:none;">
                    <div style="display:flex;align-items:center;justify-content:center;gap:6px;padding:32px 0;">
                        <div style="width:6px;height:6px;background:#6366f1;border-radius:50%;animation:bounce 1.4s ease-in-out infinite;animation-delay:0ms;"></div>
                        <div style="width:6px;height:6px;background:#6366f1;border-radius:50%;animation:bounce 1.4s ease-in-out infinite;animation-delay:150ms;"></div>
                        <div style="width:6px;height:6px;background:#6366f1;border-radius:50%;animation:bounce 1.4s ease-in-out infinite;animation-delay:300ms;"></div>
                    </div>
                </div>
                <div class="se-pre-con"></div>
                @RenderBody()
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- SCRIPTS                                                 -->
<!-- ═══════════════════════════════════════════════════════ -->
<script src="~/plugins/jquery/jquery.min.js"></script>
<script>
(function() {
    // ── Section toggle ──
    window.toggleSec = function(el) {
        el.classList.toggle('open');
        var body = el.nextElementSibling;
        if (body && body.classList.contains('sec-body')) {
            body.classList.toggle('open');
        }
    };

    // ── Expand toggle (Case Creation sub-items) ──
    window.toggleExp = function(el) {
        el.classList.toggle('open');
        var kids = el.nextElementSibling;
        if (kids && kids.classList.contains('nk')) {
            kids.classList.toggle('open');
        }
    };
})();

// ── jQuery compatibility for legacy pages ──
jQuery(document).ready(function(){
    jQuery(".nav.nav-pills.nav-sidebar .dropdown .dropdown-content").css("display", "none");
    jQuery(".nav-link.dropbtn").parent().removeClass("show-submenu");
    jQuery(".nav-link.dropbtn").click(function() {
        if (jQuery(this).parent().hasClass("show-submenu")) {
            jQuery(this).parent().removeClass("show-submenu");
        } else {
            jQuery(".nav-link.dropbtn").parent().removeClass("show-submenu");
            jQuery(this).parent().addClass("show-submenu");
        }
    });
});

// ── Close notification panel on outside click ──
document.addEventListener('click', function(e) {
    var wrapper = document.getElementById('notifWrapper');
    var panel = document.getElementById('notifPanel');
    if (wrapper && panel && !wrapper.contains(e.target)) {
        panel.classList.add('hidden');
    }
});
</script>

@RenderSection("Scripts", required: false)
@await Component.InvokeAsync("NToastNotify")
</body>
</html>
