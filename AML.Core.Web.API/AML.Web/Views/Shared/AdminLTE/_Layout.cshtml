        .toast-error   { background-color: #dc2626 !important; color: #fff !important; }
        .toast-warning { background-color: #d97706 !important; color: #fff !important; }
        .toast-info    { background-color: #2563eb !important; color: #fff !important; }
    </style>
    @* Pinned to a known-stable version so the icon set (file-up, scan, search, folders, ...) is deterministic;
       lucide@latest can sporadically rename icons and break pages relying on specific names. *@
    <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.js"></script>
    @* Belt-and-braces visibility guard for converted lucide icons.
       Some page-level CSS or a stale build can leave the converted SVG with
       no explicit width/height, making it collapse to 0×0 inside a flex
       button. These rules guarantee any unsized .lucide SVG falls back to
       a usable size and inherits the current text color. *@
    <style>
        svg.lucide { display: inline-block; vertical-align: middle; flex-shrink: 0; }
        svg.lucide:not([width]) { width: 1em; }
        svg.lucide:not([height]) { height: 1em; }
        /* If author forgot a w-? / h-? class on the parent and SVG attrs are stripped */
        svg.lucide[width="24"][height="24"] { min-width: 1em; min-height: 1em; }
        svg.lucide path,
        svg.lucide circle,
        svg.lucide line,
        svg.lucide rect,
        svg.lucide polyline,
        svg.lucide polygon,
        svg.lucide ellipse {
            stroke: currentColor;
            fill: none;
        }
    </style>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    @* ----------------------------------------------------------------
       Global lucide auto-render.
       Several pages use Alpine/jQuery to mutate the DOM and inject
       <i data-lucide="..."> elements after the initial createIcons()
       call. Without an observer those icons stay as empty <i> tags.
       The runner also tolerates the lucide CDN script loading late
       (e.g. incognito, slow CDN) by polling until window.lucide is
       available, then doing one initial conversion plus installing
       a MutationObserver for future DOM changes. requestAnimationFrame
       debounces bursts (Alpine x-for fills, modal opens, etc.).
    ---------------------------------------------------------------- *@
    <script>
      (function () {
        var pending = false;
        function run() {
          if (typeof lucide === 'undefined' || !lucide.createIcons) return;
          if (pending) return;
          pending = true;
          requestAnimationFrame(function () {
            pending = false;
            try { lucide.createIcons(); } catch (e) { /* swallow */ }
          });
        }

        function install() {
          // Convert anything already in the DOM.
          run();
          // Re-convert whenever new <i data-lucide="*"> nodes are added
          // or an existing one gets its data-lucide value changed
          // (Alpine :data-lucide="…").
          var observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
              var m = mutations[i];
              if (m.type === 'attributes' && m.attributeName === 'data-lucide') { run(); return; }
              if (m.type === 'childList' && m.addedNodes && m.addedNodes.length) {
                for (var j = 0; j < m.addedNodes.length; j++) {
                  var n = m.addedNodes[j];
                  if (n.nodeType !== 1) continue;
                  if (n.matches && n.matches('i[data-lucide]')) { run(); return; }
                  if (n.querySelector && n.querySelector('i[data-lucide]')) { run(); return; }
                }
              }
            }
          });
          observer.observe(document.documentElement, {
            childList: true, subtree: true,
            attributes: true, attributeFilter: ['data-lucide']
          });
        }

        function waitForLucide() {
          if (typeof lucide !== 'undefined' && lucide.createIcons) {
            install();
            // Belt-and-braces re-runs to catch icons inserted by deferred
            // Alpine or jQuery initialisers that beat our observer.
            document.addEventListener('DOMContentLoaded', run, { once: true });
            window.addEventListener('load', run, { once: true });
            setTimeout(run, 250);
            setTimeout(run, 1000);
            return;
          }
          setTimeout(waitForLucide, 50);
        }
        waitForLucide();
      })();
    </script>

