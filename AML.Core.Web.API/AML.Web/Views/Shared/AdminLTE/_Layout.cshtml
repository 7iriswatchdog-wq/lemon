    .donut-chart {
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: conic-gradient(
                #2563EB 0% 65%,
                #AD87FF 65% 80%,
                #38BDF8 80% 100%
            );
            position: relative;
        }

        .donut-hole {
            position: absolute;
            width: 60%;
            height: 60%;
            background-color: white;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .percentage {
            position: absolute;
            background-color: white;
            padding: 4px 8px;
            border-radius: 9999px;
            font-weight: bold;
            font-size: 1.25rem;
        }

        .percent-20 {
            top: 15%;
            right: -20%;
        }

        .percent-65 {
            bottom: -15%;
            left: 50%;
            transform: translateX(-50%);
        }

