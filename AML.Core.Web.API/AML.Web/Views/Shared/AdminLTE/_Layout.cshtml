            { id: 'um-dropdown', arrow: 'dropdown-arrow-9' },
            { id: 'cm-dropdown', arrow: 'dropdown-arrow-10' }
        ];

        parents.forEach(p => {
            if (p.id !== currentId) {
                const drop = document.getElementById(p.id);
                const arrow = document.getElementById(p.arrow);
                if (drop) {
                    drop.classList.add('hidden');
                    // Collapse children too
                    const children = drop.querySelectorAll('ul');
                    children.forEach(child => child.classList.add('hidden'));
                    const childArrows = drop.querySelectorAll('.rotate-180');
                    childArrows.forEach(ca => ca.classList.remove('rotate-180'));
                }
                if (arrow) arrow.classList.remove('rotate-180');
            }
        });
    }

