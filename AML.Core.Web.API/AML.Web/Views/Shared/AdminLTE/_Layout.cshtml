      function helper(name){
            if(list.length==0){
                handlesmalldevices();
            }
            const ind=list.indexOf(name);

            if(ind==-1){
                    list.push(name);
            }
             else {
                list.splice(ind,1)
            }
            if(list.length==0){
                handlesmalldevices();
            }
            console.log(list);
      }

