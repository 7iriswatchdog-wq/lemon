                                <div class="flex justify-between items-center mt-2 border-t border-slate-100 pt-2" x-show="msg.role === 'assistant' && msg.isComplete">
                                    <!-- #21 Dynamic source label -->
                                    <span class="text-[9px] opacity-50 font-bold uppercase tracking-wider text-slate-400"
                                          x-text="currentCaseId ? 'Source: Case Context' : 'Source: Module Knowledge'"></span>
                                    <button @@click="copyToClipboard(msg.content, $event)" class="p-1 hover:bg-slate-100 rounded text-slate-400 hover:text-blue-600 transition-all opacity-0 group-hover:opacity-100" title="Copy to clipboard">
                                        <i data-lucide="copy" class="w-3 h-3"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div x-show="isTyping" class="flex flex-col gap-2">
                        <div class="flex justify-start">
                            <div class="bg-white border border-slate-200 px-3 py-2 rounded-2xl shadow-sm flex items-center gap-2">
                                <div class="flex gap-1">
                                    <span class="h-1 w-1 bg-blue-500 rounded-full animate-bounce"></span>
                                    <span class="h-1 w-1 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
                                    <span class="h-1 w-1 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
                                </div>
                                <span class="text-[10px] text-slate-400 font-medium italic" x-text="thinkingText"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Predefined Questions -->
                    <div x-show="!isTyping && !isStreaming && !awaitingCaseSearch && predefinedQuestions && predefinedQuestions.length > 0 && messages.length > 0 && messages[messages.length - 1].role === 'assistant' && messages[messages.length - 1].isComplete" class="space-y-2 pt-2 border-t border-slate-100 mt-2">
                        <template x-for="q in predefinedQuestions" :key="q">
                            <button @@click="selectQuestion(q)" 
                                    class="block w-full text-left p-3 text-xs bg-white border border-blue-100 text-blue-600 rounded-xl hover:bg-blue-50 transition-all shadow-sm">
                                <span x-text="q"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <!-- Input Area -->
                <div x-show="showInput" x-cloak class="p-4 bg-white border-t border-slate-100">
                    <div class="relative flex items-center gap-2">
                        <input @@keydown.enter="sendMessage()" 
                               x-model="userInput"
                               type="text" 
                               :placeholder="getPlaceholder()"
                               class="w-full pl-4 pr-12 py-3 bg-slate-100 border-none rounded-xl text-xs focus:ring-2 focus:ring-blue-500 transition-all outline-none">
                        <!-- #19 Stop streaming button -->
                        <button x-show="isStreaming" @@click="stopStream()"
                                class="absolute right-12 h-8 w-8 bg-red-500 text-white rounded-lg flex items-center justify-center hover:bg-red-600 transition-all shadow-md"
                                title="Stop">
                            <i data-lucide="square" class="h-3 w-3"></i>
                        </button>
                        <button @@click="sendMessage()" 
                                :disabled="isStreaming"
                                class="absolute right-2 h-8 w-8 bg-blue-600 text-white rounded-lg flex items-center justify-center hover:bg-blue-700 transition-all shadow-md disabled:opacity-40">
                            <i data-lucide="send" class="h-4 w-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function agenticChat() {
                return {
                    isOpen: false,
                    isTyping: false,
                    isStreaming: false,       // #19 — true while SSE stream is active
                    isExpanded: false,        // #13 — expand toggle
                    hasUnread: false,         // #22 — unread badge
                    currentAbortController: null, // #19 — AbortController for stream
                    userInput: '',
                    showInput: false,
                    showOptions: true,
                    currentCaseId: null,
                    currentConversationId: sessionStorage.getItem('lemonActiveConvId') ? parseInt(sessionStorage.getItem('lemonActiveConvId')) : null,
                    currentModule: 'General',
                    viewMode: 'chat', 
                    thinkingText: 'Thinking...',
                    thinkingInterval: null,
                    deleteConfirmId: null,
                    currentTitle: sessionStorage.getItem('lemonActiveConvTitle') || 'New Conversation',
                    predefinedQuestions: [],
                    awaitingCaseSearch: false,
                    pendingCaseQuery: null,
                    manualCaseInput: '',
                    savedHistory: JSON.parse(localStorage.getItem('lemonHistory') || '[]'),
                    messages: JSON.parse(sessionStorage.getItem('lemonActiveChat') || '[{"role": "assistant", "content": "Hello! I am your Case Assistant. How can I help you today?", "isComplete": true}]'),
                    init() {
                        this.detectModule();
                        this.extractContextId();
                        if (!this.currentCaseId && sessionStorage.getItem('lemonActiveCaseId')) {
                            this.currentCaseId = sessionStorage.getItem('lemonActiveCaseId');
                        }
                        this.updateQuestions();
                        this.showInput = true;
                        this.scrollToBottom();
                        setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 100);
                    },
                    saveToStorage() {
                        sessionStorage.setItem('lemonActiveChat', JSON.stringify(this.messages));
                        sessionStorage.setItem('lemonActiveConvTitle', this.currentTitle);
                        if (this.currentConversationId) {
                            sessionStorage.setItem('lemonActiveConvId', this.currentConversationId.toString());
                        } else {
                            sessionStorage.removeItem('lemonActiveConvId');
                        }
                        if (this.currentCaseId) {
                            sessionStorage.setItem('lemonActiveCaseId', this.currentCaseId);
                        } else {
                            sessionStorage.removeItem('lemonActiveCaseId');
                        }
                    },
                    toggleChat() {
                        this.isOpen = !this.isOpen;
                        if (this.isOpen) {
                            this.hasUnread = false; // #22 clear badge on open
                            setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 100);
                            this.scrollToBottom();
                        }
                    },
                    toggleHistory() {
                        this.viewMode = this.viewMode === 'chat' ? 'history' : 'chat';
                        this.deleteConfirmId = null;
                        if (this.viewMode === 'history') {
                             setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);
                        }
                        this.scrollToBottom();
                    },
                    detectModule() {
                        const path = window.location.pathname.toLowerCase();
                        if (path === '/' || path.includes('/home') || path.includes('/dashboard')) this.currentModule = 'Dashboard';
                        else if (path.includes('/proliferationfinance')) this.currentModule = 'PF Creation';
                        else if (path.includes('/case/create') || path.includes('/corporate/corporatescreening')) this.currentModule = 'Case Creation';
                        else if (path.includes('/case')) this.currentModule = 'Due Diligence';
                        else if (path.includes('/report') || path.includes('/completedcaseindex')) this.currentModule = 'Reports';
                        else if (path.includes('/adminmanagement') || path.includes('/user') || path.includes('/admin')) this.currentModule = 'Admin';
                        else if (path.includes('/process') || path.includes('/details')) this.currentModule = 'Process';
                        // #7/#8/#9 — previously missing modules
                        else if (path.includes('/amltracker')) this.currentModule = 'AmlTracker';
                        else if (path.includes('/stm')) this.currentModule = 'STM';
                        else if (path.includes('/compliancehub')) this.currentModule = 'ComplianceHub';
                        else if (path.includes('/sanctionscreening')) this.currentModule = 'SanctionScreening';
                        else this.currentModule = 'General';
                    },
                    getPlaceholder() {
                        if (this.currentModule === 'Dashboard') return "Ask about global stats...";
                        if (this.currentModule === 'Process') return "Ask about this case...";
                        return "Ask a question... (e.g. #12345)";
                    },
                    updateQuestions() {
                        const mappings = {
                            'Dashboard':          ['How many high-risk cases are pending?', 'Show me status breakdown for today', 'What is the current customer count?'],
                            'Due Diligence':      ['What is the status of the case?', 'What should I do next?', 'What was the case history?'],
                            'Case Creation':      ['Mandatory fields guide', 'Individual vs. Corporate differences', 'How to upload OCR/Bulk?'],
                            'PF Creation':        ['How to search by goods?', 'What is a Dual-Use item?', 'How to review hits for chemicals?'],
                            'Reports':            ['How to export Completed Cases?', 'Show me case status distribution', 'Can I search by date range?'],
                            'Admin':              ['How to create a new user group?', 'Help with client permissions', 'Configure screening thresholds'],
                            'Process':            ['What is the status of the case?', 'What should I do next?', 'What was the case history?'],
                            // #7/#8/#9 — new modules
                            'AmlTracker':         ['What cases are in my queue?', 'How does SLA tracking work?', 'How do I assign a case?'],
                            'SanctionScreening':  ['What lists are screened?', 'What does the match score mean?', 'How is this different from full case creation?'],
                            'ComplianceHub':      ['What regulations are available?', 'How do I search policy documents?', 'How do I access FATF guidance?'],
                            'STM':                ['How are suspicious transactions flagged?', 'What is an STR?', 'How do rule thresholds work?'],
                            'General':            ['How to get started?', 'Help with login and sessions', 'Contact system administrator']
                        };
                        this.predefinedQuestions = mappings[this.currentModule] || mappings['General'];
                    },

                    extractContextId() {
                        // Match patterns like /case/Process/12345 or /Process/12345 or /Details/12345
                        const urlMatch = window.location.pathname.match(/\/(?:case\/)?(?:Process|Details)\/([A-Z0-9]+)/i);
                        if (urlMatch) { 
                            this.currentCaseId = urlMatch[1]; 
                        } else {
                            this.currentCaseId = null;
                        }
                    },

                    loadConversation(item) {
                        if (this.messages.length > 1) this.archiveCurrentChat();
                        this.messages = JSON.parse(JSON.stringify(item.messages));
                        this.currentTitle = item.title;
                        this.currentConversationId = item.id;
                        this.currentCaseId = item.caseId;
                        this.viewMode = 'chat';
                        this.showInput = true;
                        this.showOptions = false;
                        this.saveToStorage();
                        this.scrollToBottom();
                    },
                    archiveCurrentChat() {
                        if (this.messages.length <= 1) return;
                        const convId = this.currentConversationId || Date.now();
                        this.currentConversationId = convId;
                        const conversation = {
                            id: convId,
                            title: this.currentTitle,
                            caseId: this.currentCaseId,
                            messages: JSON.parse(JSON.stringify(this.messages)),
                            timestamp: new Date().toISOString()
                        };
                        this.savedHistory = this.savedHistory.filter(h => h.id !== convId);
                        this.savedHistory.unshift(conversation);
                        localStorage.setItem('lemonHistory', JSON.stringify(this.savedHistory.slice(0, 50)));
                        this.saveToStorage();
                    },
                    deleteConversation(id) {
                        this.savedHistory = this.savedHistory.filter(c => c.id !== id);
                        localStorage.setItem('lemonHistory', JSON.stringify(this.savedHistory));
                        this.deleteConfirmId = null;
                        setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);
                    },
                    copyToClipboard(text, event) {
                        navigator.clipboard.writeText(text).then(() => {
                            const btn = event.currentTarget;
                            const original = btn.innerHTML;
                            btn.innerHTML = '<i data-lucide="check" class="w-3 h-3 text-green-500"></i>';
                            if(window.lucide) lucide.createIcons();
                            setTimeout(() => { 
                                btn.innerHTML = original; 
                                if(window.lucide) lucide.createIcons();
                            }, 2000);
                        });
                    },
                    selectQuestion(q) {
                        this.messages.push({ role: 'user', content: q, isComplete: true });
                        // Remove the selected question so the rest remain as tail questions
                        this.predefinedQuestions = this.predefinedQuestions.filter(x => x !== q);
                        // #20 — route predefined questions through the SSE stream (same as custom)
                        this.userInput = q;
                        this.sendMessage(null, true);
                        this.saveToStorage();
                    },

                    resetChat() {
                        this.archiveCurrentChat();
                        this.messages = [
                            { role: 'assistant', content: 'Hello! I am your Case Assistant. How can I help you today?', isComplete: true }
                        ];
                        this.currentTitle = 'New Conversation';
                        this.currentConversationId = null;
                        sessionStorage.removeItem('lemonActiveConvId');
                        sessionStorage.removeItem('lemonActiveConvTitle');
                        this.currentCaseId = null;
                        this.updateQuestions();
                        this.showInput = true;
                        this.viewMode = 'chat';
                        this.saveToStorage();
                        this.extractContextId();
                        this.scrollToBottom();
                    },
                    async sendMessage(queryType = null, skipPush = false) {
                        if (!this.userInput.trim() && !queryType) return;

                        const isFirstMessage = this.messages.length <= 1;
                        const userMsg = this.userInput || (queryType ? `Tell me about the ${queryType}.` : "");
                        if (!skipPush) {
                            this.messages.push({ role: 'user', content: userMsg, isComplete: true });
                            this.saveToStorage();
                        }
                        this.userInput = '';

                        // FUZZY SEARCH INTERCEPT
                        if (this.awaitingCaseSearch) {
                            this.isTyping = true;
                            this.stopThinkingAnimation();
                            this.startThinkingAnimation(["Searching for cases...", "Querying database...", "Filtering matches..."]);
                            try {
                                const searchUrl = `/api/Chat/search-cases?query=${encodeURIComponent(userMsg)}`;
                                const res = await fetch(searchUrl);
                                const cases = await res.json();
                                this.stopThinkingAnimation();
                                this.isTyping = false;

                                if (!cases || cases.length === 0) {
                                    this.messages.push({
                                        role: 'assistant',
                                        content: 'No matching cases found in the system database. Please try another name or enter the Case ID manually.',
                                        isComplete: true,
                                        cases: []
                                    });
                                } else if (cases.length === 1) {
                                    const c = cases[0];
                                    this.currentCaseId = c.caseId;
                                    this.awaitingCaseSearch = false;
                                    this.messages.push({
                                        role: 'assistant',
                                        content: `Found exactly one match: **${c.customerName}** (Case ID: **${c.caseId}**, Status: **${c.status}**). Case selected automatically.`,
                                        isComplete: true
                                    });
                                    // Trigger the original pending query
                                    this.userInput = this.pendingCaseQuery || 'What is the status of the case?';
                                    this.pendingCaseQuery = null;
                                    await this.sendMessage(null, true);
                                } else {
                                    // Multiple cases found
                                    this.awaitingCaseSearch = false;
                                    this.messages.push({
                                        role: 'assistant',
                                        content: `I found ${cases.length} cases matching **"${userMsg}"**. Please select the correct case from the options below:`,
                                        isComplete: true,
                                        cases: cases
                                    });
                                }
                            } catch (err) {
                                this.stopThinkingAnimation();
                                this.isTyping = false;
                                this.messages.push({
                                    role: 'assistant',
                                    content: 'An error occurred while searching for the case. Please try again.',
                                    isComplete: true
                                });
                            }
                            this.saveToStorage();
                            this.scrollToBottom();
                            setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);
                            return;
                        }

                        const msgLower = userMsg.toLowerCase();
                        const isCaseQuery = msgLower.includes("status of the case") || 
                                            msgLower.includes("what should i do next") || 
                                            msgLower.includes("what was the case history") || 
                                            userMsg === 'What is the status of the case?' ||
                                            userMsg === 'What should I do next?' ||
                                            userMsg === 'What was the case history?';

                        let caseIdMatch = userMsg.match(/#([A-Z0-9]+)/i) || userMsg.match(/\b([A-Z]*[0-9][A-Z0-9]*)\b/i);

                        if (isCaseQuery && !this.currentCaseId && !caseIdMatch) {
                            this.pendingCaseQuery = userMsg;
                            this.awaitingCaseSearch = true;
                            this.messages.push({
                                role: 'assistant',
                                content: 'Please enter the Customer Name or Case ID to search for the case.',
                                isComplete: true
                            });
                            this.saveToStorage();
                            this.scrollToBottom();
                            setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);
                            return;
                        }

                        this.isTyping = true;
                        this.showOptions = false;
                        // DYNAMIC THINKING TEXT (GEMINI STYLE)
                        let logicChain = ["Thinking..."];
                        const msgLowerAgain = userMsg.toLowerCase();
                        
                        if (this.currentModule === 'Dashboard') 
                            logicChain = ["Calculating system-wide metrics...", "Analyzing active vs blocked counts...", "Structuring totals..."];
                        else if (this.currentModule === 'Admin') 
                            logicChain = ["Scanning SQL Client registry...", "Analyzing organization status...", "Preparing client summary..."];
                        else if (this.currentModule === 'PF Creation') 
                            logicChain = ["Connecting to MongoDB Ledger...", "Analyzing UAE Cabinet Decision 156...", "Checking HS/CAS Match results...", "Structuring hits..."];
                        else if (msgLower.includes('#') || msgLower.includes('status') || msgLower.includes('case')) 
                            logicChain = ["Searching SQL Case Archive...", "Retrieving match history...", "Interpreting risk score...", "Structuring case summary..."];
                        else if (this.currentModule === 'Due Diligence') 
                            logicChain = ["Analyzing risk profile...", "Validating mandatory fields...", "Checking sanction history...", "Structuring Due Diligence result..."];
                        else 
                            logicChain = ["Processing your request...", "Analyzing context...", "Generating result..."];

                        this.startThinkingAnimation(logicChain);
                        this.scrollToBottom();

                        caseIdMatch = userMsg.match(/#([A-Z0-9]+)/i) || userMsg.match(/\b([A-Z]*[0-9][A-Z0-9]*)\b/i);
                        let typeToUse = queryType || this.pendingQueryType;
                        let caseId = caseIdMatch ? caseIdMatch[1] : (typeToUse ? this.currentCaseId : (this.currentCaseId || null));

                        if (caseIdMatch) {
                            this.currentCaseId = caseId;
                            this.pendingQueryType = null; // Clear it once used
                        }

                        // For predefined questions, use the extracted caseId or prompt the user
                        if (queryType === 'predefined') {
                            caseId = caseId || 'undefined';
                        }

                        const isGeneral = !caseId || caseId === 'undefined';

                        // Prepare History (only role and content) — #23 window from config default 10
                        const historyWindow = 10;
                        const history = (this.messages || [])
                            .filter(m => m.isComplete && m.content)
                            .slice(-historyWindow)
                            .map(m => ({ role: m.role, content: m.content }));

                        try {
                            // #19 — abort previous stream before starting a new one
                            if (this.currentAbortController) this.currentAbortController.abort();
                            this.currentAbortController = new AbortController();

                            const url = isGeneral
                                ? `/api/Chat/stream/general?prompt=${encodeURIComponent(userMsg)}&module=${this.currentModule}&isNewChat=${isFirstMessage}`
                                : `/api/Chat/stream/${caseId}?queryType=${encodeURIComponent(typeToUse || '')}&isNewChat=${isFirstMessage}&prompt=${encodeURIComponent(userMsg)}`;

                            const response = await fetch(url, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(history),
                                signal: this.currentAbortController.signal
                            });

                            if (!response.ok) {
                                this.stopThinkingAnimation();
                                throw new Error('Network error');
                            }

                            const reader = response.body.getReader();
                            const decoder = new TextDecoder();
                            const assistantMsgIndex = this.messages.push({ role: 'assistant', content: '', isComplete: false }) - 1;
                            this.isTyping = false;
                            this.isStreaming = true; // #19
                            this.stopThinkingAnimation();

                            while (true) {
                                const { value, done } = await reader.read();
                                if (done) break;
                                const chunk = decoder.decode(value);
                                chunk.split('\n').forEach(line => {
                                    if (line.startsWith('data: ')) {
                                        try {
                                            const data = JSON.parse(line.substring(6));
                                            if (data.t.startsWith('[TITLE]: ')) {
                                                this.currentTitle = data.t.substring(9);
                                            } else {
                                                this.messages[assistantMsgIndex].content += data.t;
                                                this.scrollToBottom();
                                            }
                                        } catch (e) { }
                                    }
                                });
                            }
                            this.messages[assistantMsgIndex].isComplete = true;
                            this.isStreaming = false; // #19
                            // #22 — mark unread if panel is closed
                            if (!this.isOpen) this.hasUnread = true;
                            this.saveToStorage();
                            this.archiveCurrentChat();
                        } catch (e) {
                            this.isTyping = false;
                            this.isStreaming = false;
                            if (e.name !== 'AbortError') {
                                this.messages.push({ role: 'assistant', content: 'Error connecting to AI service.', isComplete: true });
                            }
                        }

                        this.isTyping = false;
                        this.scrollToBottom();
                        setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);

                    },
                    selectCaseFromList(c) {
                        this.currentCaseId = c.caseId;
                        this.messages.push({
                            role: 'user',
                            content: `Selected case: **${c.customerName}** (ID: **${c.caseId}**)`,
                            isComplete: true
                        });
                        this.messages.push({
                            role: 'assistant',
                            content: `Case **${c.caseId}** selected. Proceeding to answer: *"${this.pendingCaseQuery || 'What is the status of the case?'}"*`,
                            isComplete: true
                        });
                        const lastAsst = [...this.messages].reverse().find(m => m.role === 'assistant' && m.cases);
                        if (lastAsst) {
                            delete lastAsst.cases;
                        }
                        this.userInput = this.pendingCaseQuery || 'What is the status of the case?';
                        this.pendingCaseQuery = null;
                        this.sendMessage(null, true);
                    },
                    submitManualCaseId() {
                        const val = this.manualCaseInput.trim();
                        if (!val) return;
                        this.currentCaseId = val;
                        this.manualCaseInput = '';
                        this.messages.push({
                            role: 'user',
                            content: `Selected case ID manually: **${val}**`,
                            isComplete: true
                        });
                        this.messages.push({
                            role: 'assistant',
                            content: `Case **${val}** selected. Proceeding to answer: *"${this.pendingCaseQuery || 'What is the status of the case?'}"*`,
                            isComplete: true
                        });
                        const lastAsst = [...this.messages].reverse().find(m => m.role === 'assistant' && m.cases);
                        if (lastAsst) {
                            delete lastAsst.cases;
                        }
                        this.userInput = this.pendingCaseQuery || 'What is the status of the case?';
                        this.pendingCaseQuery = null;
                        this.sendMessage(null, true);
                    },
                    renderMessage(content) {
                        if (!content) return "";
                        // Configure marked to handle single line breaks
                        marked.setOptions({
                            breaks: true,
                            gfm: true
                        });
                        return marked.parse(content);
                    },
                    scrollToBottom() {
                        setTimeout(() => {
                            const container = document.getElementById('chatMessages');
                            if (container) container.scrollTop = container.scrollHeight;
                        }, 100);
                    },
                    startThinkingAnimation(steps) {
                        this.stopThinkingAnimation();
                        let i = 0;
                        this.thinkingText = steps[0];
                        this.thinkingInterval = setInterval(() => {
                            i = (i + 1) % steps.length;
                            this.thinkingText = steps[i];
                        }, 1800);
                    },
                    stopThinkingAnimation() {
                        if (this.thinkingInterval) {
                            clearInterval(this.thinkingInterval);
                            this.thinkingInterval = null;
                        }
                    },
                    // #19 — stop the current stream
                    stopStream() {
                        if (this.currentAbortController) {
                            this.currentAbortController.abort();
                            this.currentAbortController = null;
                        }
                        this.isStreaming = false;
                        this.isTyping = false;
                        this.stopThinkingAnimation();
                        // Mark last assistant message as complete
                        const last = this.messages[this.messages.length - 1];
                        if (last && last.role === 'assistant' && !last.isComplete) {
                            last.content += ' *(stopped)*';
                            last.isComplete = true;
                        }
                        this.saveToStorage();
                    },
                    // #17 — clear all localStorage history
                    clearAllHistory() {
                        this.savedHistory = [];
                        localStorage.removeItem('lemonHistory');
                    },
                    // #15 — first user message snippet for history list
                    getHistorySnippet(item) {
                        const first = (item.messages || []).find(m => m.role === 'user');
                        return first ? first.content.substring(0, 60) + (first.content.length > 60 ? '...' : '') : '';
                    },
                    getGroupedHistory() {
                        if (!this.savedHistory || this.savedHistory.length === 0) return [];
                        const groups = {};
                        const sorted = [...this.savedHistory].sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));

                        sorted.forEach(item => {
                            const date = new Date(item.timestamp);
                            const today = new Date();
                            // #16 — fix: create a NEW date for yesterday to avoid mutating today
                            const yesterday = new Date();
                            yesterday.setDate(yesterday.getDate() - 1);
                            let label = 'Earlier';

                            if (date.toDateString() === today.toDateString()) label = 'Today';
                            else if (date.toDateString() === yesterday.toDateString()) label = 'Yesterday';

                            if (!groups[label]) groups[label] = { label, items: [] };
                            groups[label].items.push(item);
                        });
                        return Object.values(groups);
                    },
                    formatDateShort(ts) {
                        if(!ts) return "";
                        const date = new Date(ts);
                        return date.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    }
                }
            }
        </script>
    }
  </body>
</html>







