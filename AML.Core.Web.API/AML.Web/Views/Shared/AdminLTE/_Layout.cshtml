            position: absolute;
            background-color: white;
            padding: 4px 8px;
            border-radius: 9999px;
            font-weight: bold;
            font-size: 1.25rem;
        }

        .percent-20 {
            top: 15%;
            right: -20%;
        }

        .percent-65 {
            bottom: -15%;
            left: 50%;
            transform: translateX(-50%);
        }

        .percent-15 {
            top: 10%;
            left: -20%;
