                 x-transition:leave-end="opacity-0 translate-y-4 scale-95"
                 :class="isExpanded ? 'fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[80vh] md:w-[850px] md:h-[85vh] z-[99999]' : 'absolute bottom-20 right-0 w-[400px] h-[550px] z-[9999]'"
