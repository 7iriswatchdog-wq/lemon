@using AML.Web.Helpers;
@using Newtonsoft.Json;
@using System;
@using System.Collections.Generic;
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using static AML.Web.Helpers.NavigationIndicatorHelper;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext.Session.GetString("SessUsername");
    var userModules = HttpContextAccessor.HttpContext.Session.GetString("SessModules");
    var clientname = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
    var clientdescription = HttpContextAccessor.HttpContext.Session.GetString("SessDescription");
    var clientId = HttpContextAccessor.HttpContext.Session.GetString("SessClientId");
    var logo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
    var email = HttpContextAccessor.HttpContext.Session.GetString("SessEmail");
    var allowedModules = new HashSet<int>();
    if (!string.IsNullOrWhiteSpace(userModules))
    {
        try
        {
            var modules = JsonConvert.DeserializeObject<List<dynamic>>(userModules) ?? new List<dynamic>();
            foreach (var module in modules)
            {
                if (module == null)
                {
                    continue;
                }

                if (int.TryParse(Convert.ToString(module.Menu_Id), out int menuId))
                {
                    allowedModules.Add(menuId);
                }
            }
        }
        catch
        {
            allowedModules.Clear();
        }
    }
    var hasExplicitModuleRights = allowedModules.Count > 0;
    Func<int, bool> canAccess = menuId => !hasExplicitModuleRights || allowedModules.Contains(menuId);

    /* ── Active state detection ── */
    var dashboardActive = Url.MakeActiveClass("Home", "Index") == "active";
    var individualActive = Url.MakeActiveClass("Case", "Create") == "active";
    var corporateActive = Url.MakeActiveClass("Corporate", "CorporateScreening") == "active";
    var duediligenceActive = Url.MakeActiveClass("Case", "Index") == "active";
    var completedActive = Url.MakeActiveClass("Case", "CompletedCaseIndex") == "active";
    var pfCaseCreationActive = Url.MakeActiveClass("ProliferationFinance", "CaseCreation") == "active";
    var pfCaseManagerActive = Url.MakeActiveClass("ProliferationFinance", "CaseManager") == "active";
    var adminActive = Url.MakeActiveClass("AdminManagement", "Index") == "active";

    /* Reports active states */
    var caseReportActive = Url.MakeActiveClass("Report", "CaseReport") == "active";
    var sanctionLogsActive = Url.MakeActiveClass("Report", "SanctionLogs") == "active";
    var screeningLogsActive = Url.MakeActiveClass("Report", "GetClientSearchLog") == "active";
    var auditTrailActive = Url.MakeActiveClass("Report", "UserPasswordLogs") == "active";

    var caseCreationOpen = individualActive || corporateActive;
    var screeningOpen = caseCreationOpen || duediligenceActive || completedActive;
    var proliferationOpen = pfCaseCreationActive || pfCaseManagerActive;
    var insightsOpen = ViewContext.RouteData.Values["Controller"]?.ToString() == "Insights";
    var commandCenterOpen = ViewContext.RouteData.Values["Controller"]?.ToString() == "CommandCenter";
    var intelligenceOpen = ViewContext.RouteData.Values["Controller"]?.ToString() == "Intelligence";
    var governanceOpen = ViewContext.RouteData.Values["Controller"]?.ToString() == "Governance";

    var reportsOpen = caseReportActive || sanctionLogsActive || screeningLogsActive || auditTrailActive || insightsOpen;

    var canSeeScreening = canAccess(1) || canAccess(3);
    var canSeeProliferation = !hasExplicitModuleRights || allowedModules.Contains(14) || allowedModules.Contains(4);
    var canSeeAdmin = canAccess(8);

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var initials = !string.IsNullOrEmpty(userName) ? userName.Substring(0, Math.Min(2, userName.Length)).ToUpper() : "U";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>searchin — Screening Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="~/css/lemon-design-system.css" rel="stylesheet">
    <!-- TODO: Remove TailwindCSS CDN when all views are migrated to design system classes -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio,line-clamp,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --sb-collapsed: 72px;
            --sb-expanded: 280px;
            --sb-gap: 12px;
            --sb-radius: 20px;
            --sb-bg: linear-gradient(180deg, #1c1c36 0%, #161630 100%);
            --ease: cubic-bezier(0.4, 0, 0.2, 1);
        }

        *, *::before, *::after {
            font-family: var(--sans);
            margin: 0; padding: 0; box-sizing: border-box;
        }

        /* ═══════════════════════════════════════ */
        /* BODY                                     */
        /* ═══════════════════════════════════════ */
        body {
            background: var(--g-50);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            font-family: var(--sans);
            font-size: 0.9375rem;
            color: var(--g-700);
            line-height: 1.55;
            letter-spacing: -0.01em;
        }

        /* ═══════════════════════════════════════ */
        /* FLOATING SIDEBAR — hover-expand          */
        /* ═══════════════════════════════════════ */
        .sidebar {
            position: fixed;
            left: var(--sb-gap);
            top: var(--sb-gap);
            bottom: var(--sb-gap);
            width: var(--sb-collapsed);
            z-index: 100;
            background: var(--sb-bg);
            border-radius: var(--sb-radius);
            border: 1px solid rgba(255,255,255,0.06);
            box-shadow:
                0 20px 60px rgba(0,0,0,0.25),
                0 4px 16px rgba(0,0,0,0.15),
                inset 0 1px 0 rgba(255,255,255,0.05);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: width 0.35s var(--ease);
        }
        .sidebar:hover {
            width: var(--sb-expanded);
        }

        /* hide text when collapsed, show on expand */
        .sidebar .lbl {
            opacity: 0;
            width: 0;
            min-width: 0;
            transform: translateX(-6px);
            transition: opacity 0.15s ease, transform 0.15s ease, width 0.3s var(--ease);
            white-space: nowrap;
            overflow: hidden;
            pointer-events: none;
        }
        .sidebar:hover .lbl {
            opacity: 1;
            width: auto;
            transform: translateX(0);
            transition: opacity 0.2s ease 0.1s, transform 0.2s ease 0.1s, width 0.3s var(--ease);
            pointer-events: auto;
        }

        /* ── Header ── */
        .sb-head {
            padding: 18px 16px 14px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
            transition: padding 0.35s var(--ease);
        }
        .sidebar:not(:hover) .sb-head {
            padding: 18px 0 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .sb-brand {
            display: flex; align-items: center; gap: 12px;
            height: 48px;
            text-decoration: none;
            transition: all 0.3s var(--ease);
            overflow: hidden;
            width: 100%;
        }
        .sidebar:not(:hover) .sb-brand {
            justify-content: flex-start;
            padding-left: 14px;
            width: 100%;
        }
        .sb-icon {
            width: 38px; height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 14px rgba(99,102,241,0.35);
            flex-shrink: 0;
        }
        .sb-icon svg { width: 20px; height: 20px; }
        .sb-brand-text .sb-title { font-size: 1rem; font-weight: 700; color: var(--g-0); letter-spacing: -0.03em; }
        .sb-brand-text .sb-tag { font-size: 10px; font-weight: 700; color: #8b5cf6; text-transform: uppercase; letter-spacing: 0.12em; }

        /* Search — hidden when collapsed */
        .sb-search {
            position: relative;
            margin-top: 14px;
            height: 0;
            opacity: 0;
            overflow: hidden;
            transition: height 0.25s var(--ease), opacity 0.2s ease, margin 0.25s var(--ease);
        }
        .sidebar:hover .sb-search {
            height: 40px;
            opacity: 1;
            margin-top: 14px;
        }
        .sb-search input {
            width: 100%; padding: 9px 12px 9px 36px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.04);
            color: #cbd5e1; font-size: 13px; font-family: inherit;
            outline: none; transition: all 0.2s ease;
        }
        .sb-search input::placeholder { color: rgba(148,163,184,0.35); }
        .sb-search input:focus {
            border-color: rgba(139,92,246,0.35);
            background: rgba(255,255,255,0.06);
            box-shadow: 0 0 0 3px rgba(139,92,246,0.1);
        }
        .sb-search .s-ic {
            position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
            width: 15px; height: 15px; color: rgba(148,163,184,0.3);
        }
        .sb-search .s-key {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            font-size: 10px; color: rgba(148,163,184,0.25);
            background: rgba(255,255,255,0.05); padding: 2px 7px;
            border-radius: 5px; border: 1px solid rgba(255,255,255,0.05);
        }

        /* ── Nav ── */
        .sb-nav {
            flex: 1; overflow-y: auto; overflow-x: hidden;
            padding: 8px 8px;
            transition: padding 0.35s var(--ease);
        }
        .sidebar:not(:hover) .sb-nav { padding: 8px 6px; }
        .sb-nav::-webkit-scrollbar { width: 3px; }
        .sb-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 3px; }

        /* Section label — shrinks to thin line when collapsed */
        .sec-lbl {
            padding: 16px 12px 6px;
            font-size: 10px; font-weight: 700;
            letter-spacing: 0.1em; text-transform: uppercase;
            color: rgba(148,163,184,0.4);
            display: flex; align-items: center; justify-content: space-between;
            cursor: pointer; user-select: none;
            white-space: nowrap; overflow: hidden;
            position: relative;
            transition: padding 0.35s var(--ease), height 0.35s var(--ease);
        }
        .sidebar:not(:hover) .sec-lbl {
            padding: 0; height: 1px;
            margin: 6px 12px;
            background: rgba(255,255,255,0.04);
            overflow: hidden;
            pointer-events: none;
        }
        .sidebar:not(:hover) .sec-lbl * { opacity: 0; }
        .sec-lbl .sec-text { opacity: 0; transition: opacity 0.15s ease; }
        .sidebar:hover .sec-lbl .sec-text { opacity: 1; transition: opacity 0.2s ease 0.1s; }
        .sec-lbl .sec-chev {
            width: 14px; height: 14px; flex-shrink: 0;
            color: rgba(148,163,184,0.25);
            transition: transform 0.3s ease, opacity 0.15s ease;
            opacity: 0;
        }
        .sidebar:hover .sec-lbl .sec-chev { opacity: 1; transition: opacity 0.2s ease 0.1s; }
        .sec-lbl.open .sec-chev { transform: rotate(180deg); color: rgba(139,92,246,0.5); }

        /* Section body */
        .sec-body { transition: max-height 0.35s var(--ease); overflow: hidden; }
        .sec-body.open { max-height: 500px; }
        .sec-body:not(.open) { max-height: 0; }
        .sidebar:not(:hover) .sec-body { max-height: 500px !important; }

        /* Nav item */
        .ni {
            display: flex; align-items: center; gap: 11px;
            padding: 9px 12px; margin: 1px 0;
            border-radius: 10px;
            color: rgba(226,232,240,0.5); font-size: 13.5px; font-weight: 500;
            cursor: pointer; transition: all 0.2s var(--ease);
            text-decoration: none; white-space: nowrap; overflow: hidden;
        }
        .ni:hover { background: rgba(255,255,255,0.04); color: #e2e8f0; text-decoration: none; }
        .ni.active {
            background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(139,92,246,0.12));
            color: #a5b4fc; font-weight: 600;
        }
        .ni svg.ic { width: 20px; height: 20px; flex-shrink: 0; stroke-width: 1.7; min-width: 20px; }
        .sidebar:not(:hover) .ni {
            justify-content: center;
            gap: 0;
            padding: 10px 0;
            margin: 1px 0;
        }

        /* Expand toggle */
        .ne {
            display: flex; align-items: center; justify-content: space-between;
            padding: 9px 12px; margin: 1px 0;
            border-radius: 10px;
            color: rgba(226,232,240,0.5); font-size: 13.5px; font-weight: 500;
            cursor: pointer; transition: all 0.2s var(--ease);
            white-space: nowrap; overflow: hidden;
        }
        .ne:hover { background: rgba(255,255,255,0.04); color: #e2e8f0; }
        .ne.open { color: #a5b4fc; }
        .ne .left { display: flex; align-items: center; gap: 11px; }
        .ne .chev { width: 13px; height: 13px; color: rgba(148,163,184,0.3); transition: transform 0.25s ease; flex-shrink: 0; }
        .ne.open .chev { transform: rotate(180deg); color: #8b5cf6; }
        .ne svg.ic { width: 20px; height: 20px; flex-shrink: 0; stroke-width: 1.7; min-width: 20px; }
        .sidebar:not(:hover) .ne {
            justify-content: center;
            gap: 0;
            padding: 10px 0;
            margin: 1px 0;
        }
        .sidebar:not(:hover) .ne .left { gap: 0; }
        .sidebar:not(:hover) .ne .chev { display: none; }

        /* Children — hidden when collapsed */
        .nk { max-height: 0; overflow: hidden; transition: max-height 0.3s var(--ease); }
        .nk.open { max-height: 200px; }
        .sidebar:not(:hover) .nk { max-height: 0 !important; }
        .nc {
            display: flex; align-items: center; gap: 9px;
            padding: 7px 12px 7px 44px; border-radius: 8px;
            color: rgba(148,163,184,0.5); font-size: 12.8px; font-weight: 450;
            cursor: pointer; transition: all 0.12s ease;
            text-decoration: none; white-space: nowrap;
        }
        .nc::before {
            content: ''; width: 5px; height: 5px; border-radius: 50%;
            background: currentColor; opacity: 0.35; flex-shrink: 0;
        }
        .nc:hover { color: #a5b4fc; background: rgba(255,255,255,0.03); text-decoration: none; }
        .nc.active { color: #a5b4fc; font-weight: 600; }
        .nc.active::before { opacity: 1; background: #8b5cf6; }

        /* Coming soon pill */
        .cs-pill {
            margin: 4px 10px 6px 44px; padding: 5px 10px;
            background: rgba(255,255,255,0.03);
            border: 1px dashed rgba(255,255,255,0.07);
            border-radius: 6px; font-size: 11px;
            color: rgba(148,163,184,0.3); font-style: italic;
            white-space: nowrap;
        }
        .sidebar:not(:hover) .cs-pill { display: none; }
        .new-b {
            font-size: 8px; font-weight: 700;
            background: linear-gradient(135deg, #10b981, #059669);
            color: white; padding: 2px 6px; border-radius: 4px;
            text-transform: uppercase; letter-spacing: 0.05em; margin-left: 4px;
        }
        .sidebar:not(:hover) .new-b { display: none; }

        /* ── Footer ── */
        .sb-foot {
            border-top: 1px solid rgba(255,255,255,0.04);
            padding: 12px;
            display: flex; align-items: center; justify-content: space-between;
            gap: 10px;
            flex-shrink: 0;
            transition: padding 0.35s var(--ease);
        }
        .sidebar:not(:hover) .sb-foot {
            flex-direction: column;
            align-items: center;
            padding: 12px 0;
            gap: 0;
        }
        .sb-fu { display: flex; align-items: center; gap: 10px; }
        .sidebar:not(:hover) .sb-fu {
            justify-content: center;
        }
        .sidebar:not(:hover) .sb-foot .lbl { display: none; }
        .sb-av {
            width: 34px; height: 34px; border-radius: 10px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 12px; font-weight: 700;
            box-shadow: 0 2px 10px rgba(99,102,241,0.3);
            flex-shrink: 0;
        }
        .sb-signout {
            display: flex; align-items: center; gap: 8px;
            padding: 7px 10px; margin-top: 4px;
            border-radius: 8px;
            color: rgba(148,163,184,0.35);
            text-decoration: none;
            font-size: 12.5px; font-weight: 500;
            transition: all 0.15s ease;
        }
        .sb-signout:hover { background: rgba(248,113,113,0.08); color: #f87171; text-decoration: none; }
        .sidebar:not(:hover) .sb-signout { display: none; }

        /* ═══════════════════════════════════════ */
        /* MAIN CONTENT AREA                        */
        /* ═══════════════════════════════════════ */
        .main-area {
            margin-left: calc(var(--sb-collapsed) + var(--sb-gap) * 2 + 4px);
            display: flex; flex-direction: column;
            min-height: 100vh;
        }

        /* ── Top Bar ── */
        .topbar {
            position: sticky; top: 0; z-index: 90;
            height: 56px;
            background: #fff;
            border-bottom: 1px solid #f1f5f9;
            padding: 0 28px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .topbar::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 35%, #06b6d4 70%, #10b981 100%);
            opacity: 0.85;
        }

        .topbar-left { display: flex; align-items: center; gap: 20px; height: 100%; }

        .tb-crumbs {
            display: flex; align-items: center; gap: 6px;
            font-size: 13px; color: #94a3b8; font-weight: 500;
        }
        .tb-crumbs svg { width: 14px; height: 14px; opacity: 0.35; }
        .tb-crumbs .crumb-active { color: #0f172a; font-weight: 700; }
        .tb-crumbs a { color: inherit; text-decoration: none; transition: color 0.15s; }
        .tb-crumbs a:hover { color: #6366f1; }

        .topbar-search {
            position: relative;
            height: 36px;
        }
        .topbar-search input {
            width: 260px; height: 100%;
            padding: 0 32px 0 34px;
            border-radius: 10px;
            border: 1px solid #eef2ff;
            background: #f8fafc;
            font-size: 13px;
            color: #1e293b;
            outline: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .topbar-search input:focus {
            width: 340px;
            background: #fff;
            border-color: #c7d2fe;
            box-shadow: 0 4px 16px rgba(99,102,241,0.08);
        }
        .topbar-search input::placeholder { color: #94a3b8; font-weight: 400; }
        .topbar-search .s-ic {
            position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
            color: #94a3b8; width: 15px; height: 15px; pointer-events: none;
        }
        .topbar-search .s-hint {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            font-size: 10px; color: #c1c8d4;
            background: #f1f5f9; padding: 1px 5px; border-radius: 4px;
            pointer-events: none; line-height: 1.4;
        }

        .topbar-right { display: flex; align-items: center; gap: 6px; height: 100%; }

        .tb-btn {
            width: 36px; height: 36px;
            border-radius: 10px; border: none;
            background: transparent;
            color: #64748b;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            position: relative;
        }
        .tb-btn:hover { background: #f1f5f9; color: #334155; }
        .tb-btn svg { width: 18px; height: 18px; }
        .tb-btn .badge {
            position: absolute; top: 6px; right: 6px;
            width: 7px; height: 7px;
            background: #ef4444; border-radius: 50%;
            border: 1.5px solid #fff;
        }

        .tb-sep { width: 1px; height: 24px; background: #f1f5f9; margin: 0 6px; }

        .tb-profile {
            display: flex; align-items: center; gap: 10px;
            padding: 4px 6px 4px 12px;
            border-radius: 12px;
            cursor: pointer;
            transition: background 0.15s;
        }
        .tb-profile:hover { background: #f8fafc; }
        .tb-profile-info { text-align: right; }
        .tb-profile-name { font-size: 13px; font-weight: 700; color: #0f172a; line-height: 1.2; }
        .tb-profile-role { font-size: 10.5px; color: #94a3b8; font-weight: 500; line-height: 1.2; }
        .tb-avatar {
            width: 34px; height: 34px; border-radius: 10px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 12px; font-weight: 700;
            flex-shrink: 0;
        }

        /* Notification dropdown */
        .notif-dropdown {
            position: absolute; right: 0; top: calc(100% + 8px);
            width: 360px; background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 16px 48px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.04);
            z-index: 200; overflow: hidden;
            animation: pageEnter 0.15s ease-out;
        }

        @@media (max-width: 640px) {
            .topbar-search { display: none !important; }
            .tb-profile-info { display: none !important; }
        }
        @@media (max-width: 768px) {
            .topbar { padding: 0 16px; }
        }

        .dropdown-item { display: flex; justify-content: flex-start; }
        .dashboard-card { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; }
        .dashboard-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); }

        @@keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        /* Page entrance animation */
        @@keyframes pageEnter {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .page-enter { animation: pageEnter 0.4s cubic-bezier(0.16,1,0.3,1) both; }
    </style>
</head>

<body>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- FLOATING SIDEBAR — hover to expand                     -->
<!-- ═══════════════════════════════════════════════════════ -->
<aside class="sidebar" id="sidebar">

    <!-- Header: Logo -->
    <div class="sb-head">
        <a asp-controller="Home" asp-action="Index" class="sb-brand" style="height:auto;">
            <div style="color: white; height: 44px; display: flex; align-items: center; transform-origin: left center;">
                @await Html.PartialAsync("AdminLTE/_searchinLogo")
            </div>
        </a>
        <div class="sb-search">
