<script>
        let groupCurrentPage = 1;
        let groupTotalPages = 1;
        let groupPageSize = 10;
        let sortColumnGroup = 'Code';
        let sortDirectionGroup = 'asc';
        $(document).ready(function () {
            showUserGroupLoader2();
            fetchGroupData();
        });

        $('#userGroupRowsPerPage').on('change', function () {
            groupPageSize = parseInt($(this).val()) || 10;
            groupCurrentPage = 1;
            showUserGroupLoader(); // SHOW loader
            fetchGroupData();
        });

        $('#userGroupSearchBox').on('input', function () {
            groupCurrentPage = 1;
            showUserGroupLoader2(); // SHOW loader
            fetchGroupData();
        });

        $('.userGroup-pagination-controls').on('click', 'button', function () {
            const pg = parseInt($(this).data('page'));
            if (!isNaN(pg) && pg >= 1 && pg <= groupTotalPages) {
                groupCurrentPage = pg;
                showUserGroupLoader2(); // SHOW loader
                fetchGroupData();
            }
        });
        $('#example thead').on('click', 'th', function () {
            const index = $(this).index();
            if (index > 2) return; // Sort only first 3 columns

            const columnNames = ['Code', 'Name', 'Description'];
            const selectedColumn = columnNames[index];

            if (sortColumnGroup === selectedColumn) {
                sortDirectionGroup = sortDirectionGroup === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumnGroup = selectedColumn;
                sortDirectionGroup = 'asc';
            }

            // Update visual indicators
            $('#example thead th').removeClass('active asc desc');
            $(this).addClass(`active ${sortDirectionGroup}`);

            groupCurrentPage = 1;
            showUserGroupLoader2();
            fetchGroupData();
        });
        const columnIndexMap = {
            'Code': 0,
            'Name': 1,
            'Description': 2
        };
        function fetchGroupData() {
            const searchValue = $('#userGroupSearchBox').val() || '';
            const start = (groupCurrentPage - 1) * groupPageSize;
            const clientId = $('#clientId').val() || 0;

            const formData = {
                draw: 1,
                start: start,
                length: groupPageSize,
                'search.value': searchValue,
                'order[0].column': columnIndexMap[sortColumnGroup],
                'order[0].dir': sortDirectionGroup.toLowerCase(),
                'columns[0].data': 'Code',
                'columns[1].data': 'Name',
                'columns[2].data': 'Description',
                Id: clientId
            };

            $.ajax({
                url: '/usergroup/custompagination',
                type: 'POST',
                dataType: 'json',
                data: formData,
                success: function (resp) {
                    const rows = resp.data || [];
                    const totalRecords = resp.recordsFiltered || 0;
                    groupTotalPages = Math.max(1, Math.ceil(totalRecords / groupPageSize));
                    renderGroupTable(rows);
                    renderGroupPager();
                    hideUserGroupLoader();
                    hideUserGroupLoader2();
                },
                error: function (xhr) {
                    console.error('UserGroup table error:', xhr.statusText);
                }
            });
        }

        function renderGroupTable(rows) {
            const $tbody = $('#example tbody');
            $tbody.empty();

            if (!rows.length) {
                $tbody.append(`<tr><td colspan="5" class="text-center">No records found</td></tr>`);
                return;
            }

            rows.forEach(row => {
                const html = `
                    <tr>
                        <td class="px-6 py-4 text-left text-sm text-gray-900">${row.code}</td>
                        <td class="px-6 py-4 text-left text-sm text-gray-900">${row.name}</td>
                        <td class="px-6 py-4 text-left text-sm text-gray-900">${row.description}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">
                            <a class="sas-button bg-color-4 pt-2 action-icons" href="/usergroup/edit/${row.id}" onclick="showUserGroupLoader()">
                                 <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M4.16536 16.667H15.832C16.053 16.667 16.265 16.7548 16.4213 16.9111C16.5776 17.0673 16.6654 17.2793 16.6654 17.5003C16.6654 17.7213 16.5776 17.9333 16.4213 18.0896C16.265 18.2459 16.053 18.3337 15.832 18.3337H4.16536C3.94435 18.3337 3.73239 18.2459 3.57611 18.0896C3.41983 17.9333 3.33203 17.7213 3.33203 17.5003C3.33203 17.2793 3.41983 17.0673 3.57611 16.9111C3.73239 16.7548 3.94435 16.667 4.16536 16.667ZM3.33203 12.5003L11.6654 4.16699L14.1654 6.66699L5.83203 15.0003H3.33203V12.5003ZM12.4987 3.33366L14.1654 1.66699L16.6654 4.16699L14.9979 5.83449L12.4987 3.33366Z" fill="#64748B"/>
    </svg>
                            </a>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-900">
                            <a class="sas-button bg-color-4 pt-2 action-icons" href="/UserGroup/GroupRight/${row.id}" onclick="showUserGroupLoader()">
                                <img class="w-8 h-8" src="/img/userright.png" />
                            </a>
                        </td>
                    </tr>`;
                $tbody.append(html);
            });
        }

        function renderGroupPager() {
            const $pager = $('.userGroup-pagination-controls').empty();
            if (groupTotalPages <= 1) return;

            const btn = (label, pg, disabled, active = false) =>
                `<button class="px-3 py-1 border rounded ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'} ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}" data-page="${pg}" ${disabled ? 'disabled' : ''}>${label}</button>`;

            $pager.append(btn('First', 1, groupCurrentPage === 1));
            $pager.append(btn('Prev', groupCurrentPage - 1, groupCurrentPage === 1));

            const maxVisible = 5;
            let start = Math.max(1, groupCurrentPage - Math.floor(maxVisible / 2));
            let end = Math.min(groupTotalPages, start + maxVisible - 1);
            if (end - start < maxVisible) start = Math.max(1, end - maxVisible + 1);

            for (let i = start; i <= end; i++) {
                $pager.append(btn(i, i, false, i === groupCurrentPage));
            }

            $pager.append(btn('Next', groupCurrentPage + 1, groupCurrentPage === groupTotalPages));
            $pager.append(btn('Last', groupTotalPages, groupCurrentPage === groupTotalPages));
        }

        function DeleteData(id) {
            if (confirm("Are you sure you want to delete this group?")) {
                $.ajax({
                    url: '/usergroup/delete/' + id,
                    type: 'DELETE',
                    success: function () {
                        fetchGroupData();
                    }
                });
            }
        }
        function showUserGroupLoader() {
            $('#loadingRiskCategory').removeClass('hidden').addClass('flex');
        }

        function hideUserGroupLoader() {
            $('#loadingRiskCategory').addClass('hidden').removeClass('flex');
        }
        function showUserGroupLoader2() {
            $('#loadingRiskCategory2').removeClass('hidden').addClass('flex');
        }
        function hideUserGroupLoader2() {
            $('#loadingRiskCategory2').addClass('hidden').removeClass('flex');
        }
</script>

