    <script>
    $(document).ready(function () {
        $('form').submit(function (event) {
            event.preventDefault();

            // Show loader and disable submit
            $("#loadingRiskCategory").css("display", "flex");
            $('#btnSave').prop("disabled", true).addClass("opacity-50 cursor-not-allowed");

            var FunctionalityIds = [];
            $("input:checkbox[name='FunctionalityIds']:checked").each(function () {
                FunctionalityIds.push($(this).val());
            });

            var usergrouprights = {
                UserGroupId: $('#txtUserGroup').val(),
                FunctionalityIds: FunctionalityIds
            };
            $.ajax({
                type: 'POST',
                url: '/usergroup/GroupRight',
                data: usergrouprights,
                dataType: 'json',
                    success: function (data) {
                        // Redirect after success
                        window.location.href = '/AdminManagement/Details/@ViewBag.ClientId';
                    },
                error: function () {
                    alert("Error while saving. Please try again.");
                    $("#loadingRiskCategory").fadeOut();
                    $('#btnSave').prop("disabled", false).removeClass("opacity-50 cursor-not-allowed");
                }
            });
        });

        // Cancel button handler (also shows loader before redirecting)
        $('.cancel-button').on('click', function () {
            $("#loadingRiskCategory").css("display", "flex");
            setTimeout(function () {
                window.location.href = '/AdminManagement/Details/@ViewBag.ClientId';
            }, 500); // Delay just to show the loader effect
        });
    });

    // Checkbox logic remains unchanged
    $('li :checkbox').on('click', function () {
        var $chk = $(this),
            $li = $chk.closest('li'),
            $ul, $parent;
        if ($li.has('ul')) {
            $li.find(':checkbox').not(this).prop('checked', this.checked);
        }
        do {
            $ul = $li.parent();
            $parent = $ul.siblings('div.form-group').find(':checkbox');
            if ($chk.is(':checked')) {
                $parent.prop('checked', $ul.has(':checkbox:not(:checked)').length == 0);
            } else {
                $parent.prop('checked', false);
            }
            $chk = $parent;
            $li = $chk.closest('li');
        } while ($ul.is(':not(.someclass)'));
    });
    </script>

