            function handleCancel() {
            // Show loader
                             $('#loadingCaseDetails').removeClass('hidden');

            // Optional: disable button
            // const btns = document.querySelectorAll("button");
            // btns.forEach(btn => btn.disabled = true);

            // Wait briefly to show loader, then navigate
            setTimeout(function () {
                location.href = '/AdminManagement/Details/@Model.ClientId';
            }, 300); // Delay 300ms just to show animation
        }

        function fnSubmit() {

    let isValid = true;

    $('#userGroupForm [required]').each(function () {

        let value = $(this).val();

        if (!value || value.trim() === '') {

            $(this).addClass('border-red-500');
            $(this).focus();

            isValid = false;
            return false; // stop loop
        }
        else {
            $(this).removeClass('border-red-500');
        }

    });

    if (!isValid) {
        toastr.error("Please fill all mandatory fields");
        return;
    }

    // show loader
                    $('#loadingCaseDetails').removeClass('hidden');

    // submit form
    $('#userGroupForm').submit();
}
    </script>
