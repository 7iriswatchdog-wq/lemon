@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "CodesMaster";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");

    var isCreateMode = Context.Request.RouteValues.Values.Contains("Create");
    var disableAttr = isCreateMode ? "" : "disabled";
}

@model AML.ViewModel.ViewModels.CodesMaster.CodesTableModel


<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }</style>
<!-- RIGHT SIDE -->
<div class="max-w-screen h-full items-center ">
    @* <div class="flex flex-row items-center justify-between w-full p-5">
        <div>
            <h2 class="text-2xl font-bold">Codes Master</h2>
        </div>
        <div class="hidden md:block"><img src="@Clientlogo" alt="Client Logo" width="50px" /></div>

    </div> *@
    <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-surface">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                Codes Master
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>

    <div class="h-screen bg-gray-50 items-center ">
        <div class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4 mx-auto">
            <!-- NAME SCREENING -->
            <div class="w-full bg-surface rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
                <div id="loadingeffect" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
                    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
                </div>
                <!-- Form Card -->
                <h1 class="text-lg md:text-xl font-semibold text-gray-900 mb-8">@(isCreateMode ? "Add Code" : "Edit Code")</h1>

                <form asp-controller="CodesMaster" method="post" enctype="multipart/form-data" class="space-y-8" onsubmit="fnSubmit()">
                    <input type="hidden" asp-for="ccActiveYn" />

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                        <div>
                            <label asp-for="ccCode" class="block mb-2 text-sm font-medium text-gray-800">Code <span class="text-red-500">*</span></label>
                            <input asp-for="ccCode" class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-1 focus:ring-blue-500" placeholder="Enter code" disabled="@(disableAttr == "disabled")" />
                            <span asp-validation-for="ccCode" class="text-red-600 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ccType" class="block mb-2 text-sm font-medium text-gray-800">Type <span class="text-red-500">*</span></label>
                            <input asp-for="ccType" class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-1 focus:ring-blue-500" placeholder="Enter type" disabled="@(disableAttr == "disabled")" />
                            <span asp-validation-for="ccType" class="text-red-600 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ccName" class="block mb-2 text-sm font-medium text-gray-800">Name <span class="text-red-500">*</span></label>
                            <input asp-for="ccName" class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-1 focus:ring-blue-500" placeholder="Enter name" />
                            <span asp-validation-for="ccName" class="text-red-600 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ccDetails" class="block mb-2 text-sm font-medium text-gray-800">Details</label>
                            <input asp-for="ccDetails" class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-1 focus:ring-blue-500" placeholder="Enter details" />
                            <span asp-validation-for="ccDetails" class="text-red-600 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ccFlexi1" class="block mb-2 text-sm font-medium text-gray-800">Flexi1</label>
                            <input asp-for="ccFlexi1" class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-1 focus:ring-blue-500" placeholder="Enter Flexi1" />
                            <span asp-validation-for="ccFlexi1" class="text-red-600 text-sm mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ccFlexi2" class="block mb-2 text-sm font-medium text-gray-800">Flexi2</label>
                            <input asp-for="ccFlexi2" class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-1 focus:ring-blue-500" placeholder="Enter Flexi2" />
                            <span asp-validation-for="ccFlexi2" class="text-red-600 text-sm mt-1 block"></span>
                        </div>

                        <div class="flex items-center space-x-2 col-span-full mt-2">
                            <input type="checkbox" asp-for="ccActiveYn" class="w-4 h-4 text-primary border-gray-300 rounded" />
                            <label asp-for="ccActiveYn" class="text-sm text-gray-700">Active</label>
                        </div>
                    </div>
                    @* <div class="flex flex-col md:flex-row justify-center mt-10 gap-4">
                        <button type="submit"
                                class="px-6 py-2 bg-[#2563EB] text-white rounded-md hover:bg-primary-hover"
                                onclick="fnSubmit()">
                            Submit
                        </button>
                        <a asp-controller="Department" asp-action="Index" onclick="showLoadingAndRedirect(event, this)"
                           class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100 text-center transition duration-200">
                            Cancel
                        </a>
                    </div> 
                    
                    *@

                    <div class="flex flex-col md:flex-row justify-center mt-10 gap-4">
                        @if (isCreateMode)
                        {
                            <button type="submit" formaction="@Url.Action("Create", "CodesMaster")"
                                    class="px-6 md:px-8 py-2.5 bg-blue-700 text-white rounded-md hover:bg-blue-800 flex items-center justify-center gap-2 text-sm font-medium">
                                <i class="fas fa-plus"></i> Create
                            </button>
                        }
                        else
                        {
                            <button type="submit" formaction="@Url.Action("Update", "CodesMaster")"
                                    class="px-6 md:px-8 py-2.5 bg-blue-700 text-white rounded-md hover:bg-blue-800 flex items-center justify-center gap-2 text-sm font-medium">
                                <i class="fas fa-save"></i> Update
                            </button>
                        }

                        <button type="button"
                                id="btnCancel"
                                data-url="@Url.Action("Index", "CodesMaster")"
                                class="px-6 md:px-8 py-2.5 bg-surface border border-gray-400
                        text-gray-800 rounded-md hover:bg-gray-200
                        flex items-center justify-center gap-2 text-sm font-medium">
                            <i class="fas fa-times"></i> Cancel
                        </button>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@* <script>
    $(document).ready(function () {

        $('form').on('submit', function () {
            e.preventDefault();
            $('#loadingeffect').show();
        });
    });
</script> *@
<script>
    function fnSubmit() {
        $("#loadingeffect").show();
    }
</script>
<script>
        document.getElementById("btnCancel").addEventListener("click", function () {
        document.getElementById("loadingeffect").style.display = "flex";

        const url = this.getAttribute("data-url");

        setTimeout(() => {
            window.location.href = url;
        }, 200);
    });

</script>

