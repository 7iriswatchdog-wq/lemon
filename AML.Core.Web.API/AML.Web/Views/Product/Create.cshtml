<script>
    $(window).reload(function () {
        $("#riskTable").datatable();
    });
</script>

<script>
    function validateFormBeforeSubmit() {
        // Clear previous validations
        $('.is-invalid').removeClass('is-invalid');
        $('.error-text').remove();

        let isValid = true;

        // Validate Product Code
        const productCode = $('#dtCustomerCode').val().trim();
        if (!productCode) {
            showError('dtCustomerCode', 'Product Code is required');
            isValid = false;
        } else if (productCode.length > 25) {
            showError('dtCustomerCode', 'Max 25 characters allowed');
            isValid = false;
        }

        // Validate Product Name
        const productName = $('#dtCustomerName').val().trim();
        if (!productName) {
            showError('dtCustomerName', 'Product Name is required');
            isValid = false;
        } else if (productName.length > 200) {
            showError('dtCustomerName', 'Max 200 characters allowed');
            isValid = false;
        }

        // Validate Date of Assessment
        const assessmentDate = $('#txtDateofAssessment').val();
        if (!assessmentDate) {
            showError('txtDateofAssessment', 'Date is required');
            isValid = false;
        } else {
            const selectedDate = new Date(assessmentDate);
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (selectedDate > today) {
                showError('txtDateofAssessment', 'Date cannot be in the future');
                isValid = false;
            }
        }

        // If valid, show loader and submit
        if (isValid) {
            $('#loader').show();
            fnSubmit();
        } else {
            // Scroll to first error
            $('html, body').animate({
                scrollTop: $('.is-invalid').first().offset().top - 100
            }, 500);
        }

        return isValid;
    }

    // Helper function to show error messages
    function showError(fieldId, message) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + fieldId).after(`<span class="error-text" style="color: red; font-size: 0.85rem;">${message}</span>`);
    }

    // Clear errors when user starts typing
    $('#dtCustomerCode, #dtCustomerName, #txtDateofAssessment').on('input', function () {
        $(this).removeClass('is-invalid');
        $(this).next('.error-text').remove();
    });


    var OverRideVariables = [];
    var b = $('#RiskSubTable tr').length;
    for (i = 0; i <= b; i++) {
        OverRideVariables[i] = false
    }

    function ItemChange(a, data) {

        if (!$("#ddlItem_" + a + " option:selected").val()) return;

        var score = $("#ddlItem_" + a + " option:selected").val()?.split("|");
        var selectedVal = score[0];
        var overrideScore = score[1];
        var selectedItemId = score[2];

        $('#RiskItemTxt_' + a).val($("#ddlItem_" + a + " option:selected").text());
        $('#RiskItem_' + a).val(selectedVal);
        $('#RiskItemId_' + a).val(selectedItemId);

        const btn = $('#clrScore_' + a);
        btn.removeClass('green-score yellow-score red-score gray-score pulse-button');

        if (selectedVal == '1') {
            console.log("Iam here" + a)
            btn.addClass('green-score').text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);
            OverRideVariables[a] = false;
        } else if (selectedVal == '2') {
            btn.addClass('yellow-score').text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);
            OverRideVariables[a] = false;
        } else if (selectedVal == '3') {
            btn.addClass('red-score').text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);
            if (overrideScore == '3') {
                btn.addClass('pulse-button');
                OverRideVariables[a] = true;
            } else {
                OverRideVariables[a] = false;
            }
        } else if (selectedVal == '0') {
            btn.addClass('gray-score').text('0');
            $('#clrScorehdn_' + a).val('0');
            OverRideVariables[a] = false;
        } else {
            OverRideVariables[a] = false;
        }

        calculateTotal();
    }


    function calculateTotal() {
        var total = 0;
        var i = 0;
        var riskStatus = '@localizer["Low Risk"]';



        $(".riskscorehdn").each(function () {
            //alert($(this).val());
            total = parseInt(total) + parseInt($(this).val());
            if ($(this).val() != 0) {
                i++;
            }
        });
        $('#btntotalscore').text(total);
        $('#btntotal').text(i);

        $('#btnAsPerRiskScore').show();

        var highscoreVal = (i * 3);
        var mediumScoreVal = (i * 2.24);
        var lowScoreVal = (i * 1.49);

        $('#lowTxt').text(lowScoreVal.toFixed(2));
        $('#mediumTxt').text(mediumScoreVal.toFixed(2));
        $('#highTxt').text(highscoreVal.toFixed(2));

        if (total <= highscoreVal) {
            riskStatus = '@localizer["High Risk"]';
            $('#btntotalscoretop').removeClass();
            $('#btntotalscoretop').addClass('btn btn-danger form-control br-50 low').css('background-color', '#dc3545');;
            $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - High"]');
            $('#btnAsPerRiskScore').removeClass();
            $('#btnAsPerRiskScore').addClass('btn btn-danger form-control br-50 risk-button low').css('background-color', '#dc3545');;
        }
        if (total <= mediumScoreVal) {
            riskStatus = '@localizer["Medium Risk"]';
            $('#btntotalscoretop').removeClass();
            $('#btntotalscoretop').addClass('btn btn-warning form-control br-50 low').css('background-color', '#ffc107 ');;
            $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Medium"]');
            $('#btnAsPerRiskScore').removeClass();
            $('#btnAsPerRiskScore').addClass('btn btn-warning form-control br-50 risk-button low').css('background-color', '#ffc107 ');;
        }
        if (total <= lowScoreVal) {
            riskStatus = '@localizer["Low Risk"]';
            $('#btntotalscoretop').removeClass();
            $('#btntotalscoretop').addClass('btn btn-info form-control br-50 low').css('background-color', '#28a745');;
            $('#btnAsPerRiskScore').text('@localizer["As Per Risk Score - Low"]');
            $('#btnAsPerRiskScore').removeClass();
            $('#btnAsPerRiskScore').addClass('btn btn-info form-control br-50 risk-button low').css('background-color', '#28a745');;
        }



        //Set Risk score witout override
        $('#riskScoreBeforeOverrideTxt').val(riskStatus);

        var OverRides = "false";

        for (x = 0; x <= b; x++) {

            OverRides = OverRides + "||" + OverRideVariables[x];
            if (OverRides.includes("true")) {
                riskStatus = '@localizer["High Risk"]';
                $('#btntotalscoretop').removeClass();
                $('#btntotalscoretop').addClass('btn btn-danger form-control br-50');
            }
        }
        //Set final risk score
        $('#finalRiskScoreTxt').val(riskStatus);

        $('#btntotalscoretop').text(riskStatus);

        $('#riskScoreSumTxt').val(total);
        $('#riskScoreCountTxt').val(i);




    }
    function fnSubmit() {
        $(".se-pre-con").show();
    }

</script>