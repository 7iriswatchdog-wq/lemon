    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }

        .green-score {
            background-color: #28a745 !important;
            color: black;
        }

        .yellow-score {
            background-color: #ffc107 !important;
            color: black;
        }

        .red-score {
            background-color: #dc3545 !important;
            color: black;
        }

        .gray-score {
            /* background-color: aliceblue !important; */
            background-color: #e5e7eb !important;
            color: black;
        }

        #lowTxt {
            background-color: #28a745 !important;
        }

        #mediumTxt {
            background-color: #ffc107 !important;
        }

        #highTxt {
            background-color: #dc3545 !important;
        }
        /* Optional: Pulse animation for override */
        .pulse-button {
            animation: pulse 1.2s infinite;
        }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.7);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(255, 0, 0, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 0, 0, 0);
            }
        }
    </style>

