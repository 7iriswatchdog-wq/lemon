        function addRow(ele, elementName, value) {
            var rowIndex = $('#rowIndex2').val();
            if (elementName == 'ProdRiskScore') {
                ele.setAttribute('max', 3);
                ele.setAttribute('min', 0);

                ele.setAttribute('type', 'number');
                ele.setAttribute('name', 'AddedProdRiskItems[' + rowIndex + '].' + elementName);
                ele.setAttribute('id', 'AddedProdRiskItems[' + rowIndex + '].' + elementName);
                if (elementName == 'ProdRiskScore') {
                    ele.setAttribute('onchange', 'riskScoreOnChange(' + rowIndex + ')');
                }
                // else if (elementName == 'OverrideScore') {
                //    ele.setAttribute('disabled', 'true');
                //}
            }
            else {
                ele.setAttribute('type', 'text');
                ele.setAttribute('class', 'form-control');
                ele.setAttribute('value', value);
                ele.setAttribute('name', 'AddedProdRiskItems[' + rowIndex + '].' + elementName);
                ele.setAttribute('id', 'AddedProdRiskItems[' + rowIndex + '].' + elementName);
                ele.setAttribute('maxlength', 500);
                ele.setAttribute('onkeypress', "alphaNumericCheck(event)");
            }
            return ele;
        }

        function getRiskTypeCategory2() {
        $.ajax({

                url: '/product/GetProdRiskCategoryTypes',
            type: 'GET',
            dataType: 'json',
            beforeSend: function () {
                // Show image container
                $(".se-pre-con").show();
                $(".card-header").fadeOut()
            },


            success: function (data) {
                console.log(data);
                var item = '';
                    $('#ddlProdRiskTypeCategory2').empty();
                item += "<option value='0'>--@localizer["Select"]--</option>";
                $.each(data, function (i, riskCategoryTypes) {
                    item += "<option value='" + riskCategoryTypes.value + "'>" + riskCategoryTypes.text + "</option>";
                });
                    $('#ddlProdRiskTypeCategory2').html(item);
            },
            error: function (request, error) {
                alert("Request: " + JSON.stringify(request));
            },
            complete: function (data) {
                $('#loader').hide();
                $(".se-pre-con").fadeOut();
                $(".card-header").show()
            }

        });
    }

        function LoadRiskTypeCategoryTable() {
                        $('#loader').show();
            var table = $('#availableRiskTypeCategory').DataTable({
                "serverSide": true,
                // "processing": true,
                "filter": false,
                "iDisplayLength": 10,
                "destroy": true,
                ajax: {
                    url: '/product/CustomPaginationProductRiskTypeCategory',
                    type: 'POST',
                    dataSrc: function (json) {
                        $('#loader').hide(); // Hide when data is received
                        return json.data;
                    },
                    error: function (xhr, error, thrown) {
                        $('#loader').hide(); // Hide on error too
                        console.error('Error loading data:', error);
                    }

                },
                columns: [
                    {
