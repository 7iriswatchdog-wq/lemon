                        if (!ele.classList || !ele.classList.contains('dynamic-select')) {
                            ele.classList = ele.classList || [];
                            ele.classList.add('dynamic-select', 'form-control');
                            // fallback if classList not present (very unlikely)
                            if (!ele.classList) ele.setAttribute('class', 'form-control dynamic-select');
                        }
                        td.appendChild(ele);
                    } else {
                        ele.setAttribute('type', 'hidden');
                        ele.setAttribute('class', 'form-control');
                        ele.setAttribute('value', false);
                        ele.setAttribute('name', 'AddedProdRiskTypeCategory[' + $('#rowIndex1').val() + '].isDeletedInUI');
                        ele.setAttribute('id', 'AddedProdRiskTypeCategory[' + $('#rowIndex1').val() + '].isDeletedInUI');
