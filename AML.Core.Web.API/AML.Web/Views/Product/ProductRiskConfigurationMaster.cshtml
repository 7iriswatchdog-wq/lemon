        }

        function riskScoreOnChange (rowIndex) {
            var riskScore = document.getElementById('AddedProdRiskItems[' + rowIndex + '].ProdRiskScore').value;
        if (riskScore == 3) {
                document.getElementById('AddedProdRiskItems[' + rowIndex + '].OverrideScore').removeAttribute('disabled');
            document.getElementById('AddedProdRiskItems[' + rowIndex + '].OverrideScore').setAttribute('enabled', 'true');
        } else {
            document.getElementById('AddedProdRiskItems[' + rowIndex + '].OverrideScore').removeAttribute('enabled');
            document.getElementById('AddedProdRiskItems[' + rowIndex + '].OverrideScore').value = 0;
            document.getElementById('AddedProdRiskItems[' + rowIndex + '].OverrideScore').setAttribute('disabled', 'true');
        }
    }

        function tableRiskScoreOnChange(rowIndex) {
            var riskScore = document.getElementById('AvailableProdRiskItems[' + rowIndex + '].ProdRiskScore').value;
            if (riskScore == 3) {
                document.getElementById('AvailableProdRiskItems[' + rowIndex + '].OverrideScore').removeAttribute('disabled');
                document.getElementById('AvailableProdRiskItems[' + rowIndex + '].OverrideScore').setAttribute('enabled', 'true');
            } else {
                document.getElementById('AvailableProdRiskItems[' + rowIndex + '].OverrideScore').removeAttribute('enabled');
                document.getElementById('AvailableProdRiskItems[' + rowIndex + '].OverrideScore').value = 0;
                document.getElementById('AvailableProdRiskItems[' + rowIndex + '].OverrideScore').setAttribute('disabled', 'true');
            }
        }

        function removeRow(e) {

            e.closest('tr').style.display = 'none';//hide the div
            e.closest('tr').querySelectorAll('input[type=hidden]')[1].value = true;


        }

