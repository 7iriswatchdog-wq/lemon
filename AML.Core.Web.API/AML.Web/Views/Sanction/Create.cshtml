
@{
    ViewData["Title"] = "Central Bank Watch";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.Sanction.SanctionWatchModel

<div class="card card-primary">
    <div class="px-6 py-4 border-b border-bordercolor">
        <h3 class="card-title">Add new</h3>
    </div>
    <form role="form" asp-controller="Sanction" asp-action="Create" class="form-horizontal" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedBy" />
        <div class="p-6">
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="dtDOB">Date of Birth</label>
                        <input type="date" asp-for="DOB"  class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtDOB" max="3000-12-31" placeholder="Date of Birth">
                        <span asp-validation-for="DOB" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="dtReActiveDate">Re Active Date</label>
                        <input type="date" asp-for="ReActiveDate"  class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtReActiveDate" max="3000-12-31" placeholder="Re Active Date">
                        <span asp-validation-for="ReActiveDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="txtFName">First Name</label>
                        <input type="text" asp-for="FirstName" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtFName" placeholder="First Name">
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="txtMiddleName">Middle Name</label>
                        <input type="text" asp-for="MiddleName" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtDescription" placeholder="Middle Name">
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="txtLName">Last Name</label>
                        <input type="text" asp-for="LastName" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtLName" placeholder="Last Name">
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="txtPassportNo">Passport No</label>
                        <input type="text" asp-for="PassportNo" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtPassportNo" placeholder="Passport No">
                        <span asp-validation-for="PassportNo" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Nationality</label>
                        <select id="ddlNationalities" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="CountryId" asp-items="Model.Nationalities">
                            <option value="0">--EMPTY--</option>
                        </select>
                        <span asp-validation-for="CountryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Source</label>
                        <select id="ddlSource" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="Source">
                            <option value="0">--EMPTY--</option>
                            <option value="Central Bank Watch List">Central Bank Watch List</option>
                            <option value="Black List">Black List</option>
                            <option value="White List">White List</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Narration</label>
                        <textarea id="txtNarration" asp-for="Narration" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" rows="2" placeholder="Narration"></textarea>
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Remarks</label>
                        <textarea id="txtRemarks" asp-for="Remarks" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" rows="2" placeholder="Remarks"></textarea>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="blockUser" name="blockUser">
                            <label class="form-check-label" for="blockUser">Block User</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <!-- /.card-body -->

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="button" class="btn btn-danger" onclick="location.href='@Url.Action("WatchList", "Sanction")'">Cancel</button>
            </div>
</form>
</div>

