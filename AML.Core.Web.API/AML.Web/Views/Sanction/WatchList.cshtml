@{
    ViewData["Title"] = "Central Bank Watch List";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
<script src="~/plugins/jquery/jquery.min.js"></script>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">List</h3>
                        <a href="@Url.Action("Create", "Sanction")" type="button" class="btn btn-info btn-sm float-right">Add New</a>
                    </div>
                    <div class="card-body">
                        <div style="width: 100%; padding-left: -10px;">
                            <div class="table-responsive">
                                <table id="tblwatchList" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Customer Name</th>
                                            <th>Passport No</th>
                                            <th>Nationality</th>
                                            <th>Date of Birth</th>
                                            <th>Entry Date</th>
                                            <th>Re Active Date</th>
                                            <th>Status</th>
                                            <th>Narration</th>
                                            <th>Source</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">
    var table;
    $(document).ready(function () {
        table = $('#tblwatchList').DataTable({
            "serverSide": true,
            "processing": true,
            ajax: {
                url: '/Sanction/custompagination',
                type: 'POST'
            },
            columns: [
                { data: "firstName" },
                { data: "passportNo" },
                { data: "nationality" },
                { data: "dob" },
                { data: "createdOn" },
                { data: "reActiveDate" },
                { data: "status" },
                { data: "narration" },
                { data: "source" },
                { data: "remarks" },
            ]
        });
    });
</script>