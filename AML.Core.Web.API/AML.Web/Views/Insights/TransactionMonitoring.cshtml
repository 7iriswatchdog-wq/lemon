@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Transaction Monitoring — Searchin Insights";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
    [x-cloak]{display:none!important}
    .si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}
    .si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}
    .si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}
    .si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
    .si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;box-shadow:0 1px 3px rgba(0,0,0,.04);transition:all .2s;position:relative;overflow:hidden}
    .si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
    .si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}
    .si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}
    .si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}
    .si-kpi-pct{font-size:11px;color:#94a3b8;margin-top:6px}
    .si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}
    .si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
    .si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}
    .si-filter-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;margin-bottom:24px;overflow:hidden}
    .si-filter-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;cursor:pointer;border-bottom:1px solid #f1f5f9}.si-filter-header:hover{background:#fafbfc}
    .si-filter-title{font-size:13px;font-weight:700;color:#334155;display:flex;align-items:center;gap:8px}
    .si-filter-body{padding:20px 24px}.si-filter-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px 20px}
    .si-filter-group label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin-bottom:6px}
    .si-filter-group input,.si-filter-group select{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;color:#334155;background:#fafbfc}
    .si-filter-group input:focus,.si-filter-group select:focus{outline:none;border-color:#6366f1}
    .si-filter-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}
    .si-btn-primary{padding:9px 24px;border-radius:10px;font-size:13px;font-weight:600;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;border:none;cursor:pointer}
    .si-btn-secondary{padding:9px 24px;border-radius:10px;font-size:13px;font-weight:600;background:#fff;color:#64748b;border:1.5px solid #e2e8f0;cursor:pointer}
    .si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}
    .si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}
    .si-table-title{font-size:15px;font-weight:700;color:#0f172a}
    .si-table-tools{display:flex;align-items:center;gap:10px}
    .si-search-box{position:relative}.si-search-box input{width:260px;padding:8px 12px 8px 36px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;background:#fafbfc}
    .si-search-box i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:14px}
    .si-export-btn{display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:10px;font-size:12px;font-weight:600;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer}.si-export-btn:hover{border-color:#6366f1;color:#6366f1}
    .si-table{width:100%;border-collapse:collapse}
    .si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;cursor:pointer;white-space:nowrap}
    .si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}
    .si-table tbody tr:hover{background:#f8fafc}
    .si-table tbody tr.row-high-risk{background:#fef2f2}.si-table tbody tr.row-high-risk:hover{background:#fee2e2}
    .si-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
    .si-badge-danger{background:#fee2e2;color:#991b1b}.si-badge-warning{background:#fef3c7;color:#92400e}
    .si-badge-success{background:#d1fae5;color:#065f46}.si-badge-info{background:#e0e7ff;color:#3730a3}
    .si-pagination{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-top:1px solid #f1f5f9}
    .si-pagination-info{font-size:12px;color:#94a3b8}.si-pagination-btns{display:flex;gap:4px}
    .si-page-btn{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:8px;font-size:12px;font-weight:600;border:1px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer}
    .si-page-btn.active{background:#6366f1;color:#fff;border-color:#6366f1}
    .si-loader{display:flex;align-items:center;justify-content:center;padding:60px}
    .si-spinner{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#6366f1;border-radius:50%;animation:si-spin .6s linear infinite}
    @@keyframes si-spin{to{transform:rotate(360deg)}}
    @@media(max-width:1200px){.si-kpi-row{grid-template-columns:repeat(2,1fr)}.si-filter-grid{grid-template-columns:repeat(3,1fr)}}
    @@media(max-width:768px){.si-kpi-row,.si-chart-grid{grid-template-columns:1fr}.si-filter-grid{grid-template-columns:1fr}}
</style>
<div class="si-page" x-data="transMonitoring()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Transaction Monitoring</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/Insights">Insights</a> / Transaction Monitoring</div></div><div><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#6366f1;--kpi-bg:#eef2ff"><div class="si-kpi-icon"><i class="fa-solid fa-money-bill-transfer"></i></div><div class="si-kpi-value" x-text="fmt(summary.total)"></div><div class="si-kpi-label">Total Transactions</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-coins"></i></div><div class="si-kpi-value" x-text="fmtCurr(summary.total_value)"></div><div class="si-kpi-label">Total Value</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div><div class="si-kpi-value" x-text="summary.high_risk_pct+'%'"></div><div class="si-kpi-label">High Risk %</div></div>
            <div class="si-kpi" style="--kpi-color:#f59e0b;--kpi-bg:#fef3c7"><div class="si-kpi-icon"><i class="fa-solid fa-chart-line"></i></div><div class="si-kpi-value" x-text="summary.avg_score"></div><div class="si-kpi-label">Avg Score</div></div>
        </div>
        <div class="si-chart-grid">
            <div class="si-chart-card"><div class="si-chart-title">Volume Over Time</div><div style="height:280px"><canvas id="volumeChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Top Countries by Transaction Count</div><div style="height:280px"><canvas id="countryChart"></canvas></div></div>
        </div>
        <div class="si-filter-card">
            <div class="si-filter-header" @@click="filterOpen=!filterOpen"><div class="si-filter-title"><i class="fa-solid fa-sliders" style="color:#6366f1"></i> Filters</div><i class="fa-solid" :class="filterOpen?'fa-chevron-up':'fa-chevron-down'" style="color:#94a3b8;font-size:12px"></i></div>
            <div class="si-filter-body" x-show="filterOpen" x-transition>
                <div class="si-filter-grid">
                    <div class="si-filter-group"><label>Start Date</label><input type="date" x-model="filters.dateFrom"/></div>
                    <div class="si-filter-group"><label>End Date</label><input type="date" x-model="filters.dateTo"/></div>
                    <div class="si-filter-group"><label>Transaction Type</label><select x-model="filters.tranType"><option value="">All</option><option value="CREDIT">Credit</option><option value="DEBIT">Debit</option><option value="TRANSFER">Transfer</option></select></div>
                    <div class="si-filter-group"><label>High Risk Only</label><select x-model="filters.highRiskOnly"><option value="">All</option><option value="1">High Risk Only</option></select></div>
                    <div class="si-filter-group"><label>Min Amount</label><input type="number" x-model="filters.amountMin" placeholder="0"/></div>
                </div>
                <div class="si-filter-actions"><button class="si-btn-secondary" @@click="resetFilters()">Reset</button><button class="si-btn-primary" @@click="loadData()">Apply</button></div>
            </div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header">
                <div class="si-table-title">Transactions <span style="font-size:12px;font-weight:500;color:#94a3b8;margin-left:8px" x-text="'('+totalRecords+')'"></span></div>
                <div class="si-table-tools">
                    <div class="si-search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Search..." x-model="searchQuery" @@input.debounce.300ms="paginate()"/></div>
                    <button class="si-export-btn" @@click="exportData('pdf')"><i class="fa-solid fa-file-pdf"></i> PDF</button>
                    <button class="si-export-btn" @@click="exportData('xlsx')"><i class="fa-solid fa-file-excel"></i> Excel</button>
                </div>
            </div>
            <div class="si-loader" x-show="loading"><div class="si-spinner"></div></div>
            <div x-show="!loading" style="overflow-x:auto">
                <table class="si-table">
                    <thead><tr>
                        <th @@click="sort('TranRefno')">Ref#</th><th @@click="sort('TranDate')">Date</th><th @@click="sort('TranType')">Type</th>
                        <th @@click="sort('RemitterName')">Remitter</th><th>Remitter Country</th>
                        <th @@click="sort('BeneficiaryName')">Beneficiary</th><th>Beneficiary Country</th>
                        <th @@click="sort('Amount')">Amount</th><th>Currency</th>
                        <th @@click="sort('TransactionScore')">Score</th><th>Risk</th><th>Status</th>
                    </tr></thead>
                    <tbody>
                        <template x-for="row in displayRows" :key="row.id||row.TranRefno">
                            <tr :class="(row.IsHighRiskCountry==='Yes'||row.IsHighRiskCustomer==='Yes')?'row-high-risk':''">
                                <td x-text="row.TranRefno||'—'" style="font-weight:600;color:#6366f1"></td>
                                <td x-text="formatDate(row.TranDate)" style="font-size:12px"></td>
                                <td><span class="si-badge si-badge-info" x-text="row.TranType||'—'"></span></td>
                                <td x-text="row.RemitterName||'—'" style="font-weight:600"></td>
                                <td x-text="row.RemitterCountry||'—'" style="font-size:12px"></td>
                                <td x-text="row.BeneficiaryName||'—'" style="font-weight:600"></td>
                                <td x-text="row.BeneficiaryCountry||'—'" style="font-size:12px"></td>
                                <td x-text="fmtCurr(row.Amount)" style="font-weight:700"></td>
                                <td x-text="row.Currency||'AED'" style="font-size:12px"></td>
                                <td><span style="font-weight:700" :style="'color:'+(row.TransactionScore>=70?'#ef4444':row.TransactionScore>=40?'#f59e0b':'#22c55e')" x-text="row.TransactionScore||'0'"></span></td>
                                <td>
                                    <template x-if="row.IsHighRiskCountry==='Yes'||row.IsHighRiskCustomer==='Yes'"><span class="si-badge si-badge-danger"><i class="fa-solid fa-triangle-exclamation"></i> High</span></template>
                                    <template x-if="row.IsHighRiskCountry!=='Yes'&&row.IsHighRiskCustomer!=='Yes'"><span class="si-badge si-badge-success">Normal</span></template>
                                </td>
                                <td><span class="si-badge" :class="row.tms_status==='Flagged'?'si-badge-danger':row.tms_status==='Pending'?'si-badge-warning':'si-badge-success'" x-text="row.tms_status||'Pending'"></span></td>
                            </tr>
                        </template>
                        <tr x-show="displayRows.length===0&&!loading"><td colspan="12" style="text-align:center;padding:40px;color:#94a3b8"><i class="fa-solid fa-inbox" style="font-size:32px;display:block;margin-bottom:8px"></i>No transactions found.</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="si-pagination" x-show="displayRows.length>0">
                <div class="si-pagination-info">Showing <span x-text="((currentPage-1)*pageSize)+1"></span> to <span x-text="Math.min(currentPage*pageSize,totalRecords)"></span> of <span x-text="totalRecords"></span></div>
                <div style="display:flex;align-items:center;gap:12px">
                    <select x-model="pageSize" @@change="currentPage=1;paginate()" style="padding:6px 10px;border:1px solid #e2e8f0;border-radius:8px;font-size:12px"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                    <div class="si-pagination-btns"><button class="si-page-btn" :disabled="currentPage<=1" @@click="currentPage--;paginate()"><i class="fa-solid fa-chevron-left"></i></button><template x-for="p in paginationPages" :key="p"><button class="si-page-btn" :class="{'active':p===currentPage}" @@click="currentPage=p;paginate()" x-text="p"></button></template><button class="si-page-btn" :disabled="currentPage>=totalPages" @@click="currentPage++;paginate()"><i class="fa-solid fa-chevron-right"></i></button></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function transMonitoring(){return{loading:false,filterOpen:true,allRows:[],filteredRows:[],displayRows:[],summary:{total:0,total_value:0,high_risk_pct:0,avg_score:0},totalRecords:0,currentPage:1,pageSize:25,searchQuery:'',sortCol:'TranDate',sortDir:'desc',volChart:null,cntChart:null,
filters:{dateFrom:new Date(new Date().setDate(new Date().getDate()-30)).toISOString().split('T')[0],dateTo:new Date().toISOString().split('T')[0],tranType:'',highRiskOnly:'',amountMin:''},
get totalPages(){return Math.ceil(this.totalRecords/this.pageSize)||1},
get paginationPages(){let p=[],s=Math.max(1,this.currentPage-2),e=Math.min(this.totalPages,s+4);s=Math.max(1,e-4);for(let i=s;i<=e;i++)p.push(i);return p},
init(){this.loadData()},
async loadData(){this.loading=true;try{const fd=new URLSearchParams();fd.append('dateFrom',this.filters.dateFrom);fd.append('dateTo',this.filters.dateTo);
const r=await fetch('/TransactionMonitor/GetTransactionList',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:fd});
if(r.ok){const d=await r.json();this.allRows=(d.data||d||[]).map(t=>({id:t.id,TranRefno:t.tranRefno||t.TranRefno||'',TranDate:t.tranDate||t.TranDate||'',TranType:t.tranType||t.TranType||'',RemitterName:t.remitterName||t.RemitterName||'',RemitterCountry:t.remitterCountry||t.RemitterCountry||'',BeneficiaryName:t.beneficiaryName||t.BeneficiaryName||'',BeneficiaryCountry:t.beneficiaryCountry||t.BeneficiaryCountry||'',Amount:parseFloat(t.amount||t.Amount||0),Currency:t.currency||t.Currency||'AED',TransactionScore:parseInt(t.transactionScore||t.TransactionScore||0),IsHighRiskCountry:t.isHighRiskCountry||t.IsHighRiskCountry||'No',IsHighRiskCustomer:t.isHighRiskCustomer||t.IsHighRiskCustomer||'No',tms_status:t.statusLabel||t.tms_status||'Pending'}))}
else{this.allRows=[]}this.applyFilters();this.renderCharts()}catch(e){console.error(e);this.allRows=[]}finally{this.loading=false}},
applyFilters(){let rows=[...this.allRows];if(this.filters.tranType)rows=rows.filter(r=>r.TranType===this.filters.tranType);
if(this.filters.highRiskOnly==='1')rows=rows.filter(r=>r.IsHighRiskCountry==='Yes'||r.IsHighRiskCustomer==='Yes');
if(this.filters.amountMin)rows=rows.filter(r=>r.Amount>=parseFloat(this.filters.amountMin));
this.filteredRows=rows;this.computeSummary();this.currentPage=1;this.paginate()},
paginate(){let rows=[...this.filteredRows];if(this.searchQuery){const q=this.searchQuery.toLowerCase();rows=rows.filter(r=>(r.RemitterName||'').toLowerCase().includes(q)||(r.BeneficiaryName||'').toLowerCase().includes(q)||(r.TranRefno||'').toLowerCase().includes(q))}
this.totalRecords=rows.length;const s=(this.currentPage-1)*this.pageSize;this.displayRows=rows.slice(s,s+parseInt(this.pageSize))},
computeSummary(){const d=this.filteredRows;const hr=d.filter(r=>r.IsHighRiskCountry==='Yes'||r.IsHighRiskCustomer==='Yes').length;
const scores=d.map(r=>r.TransactionScore).filter(s=>s>0);
this.summary={total:d.length,total_value:d.reduce((s,r)=>s+r.Amount,0),high_risk_pct:d.length?Math.round(hr/d.length*100):0,avg_score:scores.length?Math.round(scores.reduce((a,b)=>a+b,0)/scores.length):0}},
renderCharts(){if(this.volChart)this.volChart.destroy();const c1=document.getElementById('volumeChart');
if(c1){const dm={};this.filteredRows.forEach(r=>{const d=(r.TranDate||'').substring(0,10);if(d)dm[d]=(dm[d]||0)+1});const sorted=Object.entries(dm).sort((a,b)=>a[0].localeCompare(b[0])).slice(-30);
this.volChart=new Chart(c1.getContext('2d'),{type:'line',data:{labels:sorted.map(s=>s[0].substring(5)),datasets:[{label:'Transactions',data:sorted.map(s=>s[1]),borderColor:'#6366f1',backgroundColor:'rgba(99,102,241,0.1)',fill:true,tension:.4,pointRadius:2}]},
options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false},ticks:{maxTicksLimit:10,font:{size:10}}}}}})}
if(this.cntChart)this.cntChart.destroy();const c2=document.getElementById('countryChart');
if(c2){const cm={};this.filteredRows.forEach(r=>{if(r.RemitterCountry)cm[r.RemitterCountry]=(cm[r.RemitterCountry]||0)+1;if(r.BeneficiaryCountry)cm[r.BeneficiaryCountry]=(cm[r.BeneficiaryCountry]||0)+1});
const sorted=Object.entries(cm).sort((a,b)=>b[1]-a[1]).slice(0,10);
this.cntChart=new Chart(c2.getContext('2d'),{type:'bar',data:{labels:sorted.map(s=>s[0]),datasets:[{label:'Transactions',data:sorted.map(s=>s[1]),backgroundColor:'#06b6d4',borderRadius:6,barPercentage:.5}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,grid:{color:'#f1f5f9'}},y:{grid:{display:false},ticks:{font:{size:11}}}}}})}},
sort(col){if(this.sortCol===col)this.sortDir=this.sortDir==='asc'?'desc':'asc';else{this.sortCol=col;this.sortDir='asc'}
this.filteredRows.sort((a,b)=>{let va=a[col]??'',vb=b[col]??'';if(typeof va==='number')return this.sortDir==='asc'?va-vb:vb-va;return this.sortDir==='asc'?String(va).localeCompare(String(vb)):String(vb).localeCompare(String(va))});this.paginate()},
resetFilters(){this.filters.dateFrom=new Date(new Date().setDate(new Date().getDate()-30)).toISOString().split('T')[0];this.filters.dateTo=new Date().toISOString().split('T')[0];this.filters.tranType='';this.filters.highRiskOnly='';this.filters.amountMin='';this.searchQuery='';this.loadData()},
formatDate(d){if(!d)return'—';try{return new Date(d).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}catch{return d}},
fmt(n){return(n||0).toLocaleString()},fmtCurr(n){return(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})},
exportData(f){window.location.href=`/TransactionMonitor/Export?dateFrom=${this.filters.dateFrom}&dateTo=${this.filters.dateTo}&isPDF=${f==='pdf'}`}}}
</script>
