@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Suspicious Transaction Report — Searchin Insights";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
    [x-cloak]{display:none!important}
    .si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}
    .si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}
    .si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}
    .si-alert-banner{display:flex;align-items:center;gap:12px;padding:14px 20px;border-radius:12px;margin-bottom:20px;background:linear-gradient(135deg,#fef2f2,#fff1f2);border:1px solid #fecaca;color:#991b1b}
    .si-alert-banner i{font-size:20px}.si-alert-banner-text{font-size:13px;font-weight:600}
    .si-kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-bottom:24px}
    .si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}
    .si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
    .si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}
    .si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}
    .si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}
    .si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}
    .si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
    .si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}
    .si-filter-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;margin-bottom:24px;overflow:hidden}
    .si-filter-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;cursor:pointer;border-bottom:1px solid #f1f5f9}.si-filter-header:hover{background:#fafbfc}
    .si-filter-title{font-size:13px;font-weight:700;color:#334155;display:flex;align-items:center;gap:8px}
    .si-filter-body{padding:20px 24px}.si-filter-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 20px}
    .si-filter-group label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin-bottom:6px}
    .si-filter-group input,.si-filter-group select{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;color:#334155;background:#fafbfc}
    .si-filter-group input:focus,.si-filter-group select:focus{outline:none;border-color:#6366f1}
    .si-filter-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}
    .si-btn-primary{padding:9px 24px;border-radius:10px;font-size:13px;font-weight:600;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;border:none;cursor:pointer}
    .si-btn-secondary{padding:9px 24px;border-radius:10px;font-size:13px;font-weight:600;background:#fff;color:#64748b;border:1.5px solid #e2e8f0;cursor:pointer}
    .si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}
    .si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}
    .si-table-title{font-size:15px;font-weight:700;color:#0f172a}
    .si-table-tools{display:flex;align-items:center;gap:10px}
    .si-search-box{position:relative}.si-search-box input{width:260px;padding:8px 12px 8px 36px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;background:#fafbfc}
    .si-search-box i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:14px}
    .si-export-btn{display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:10px;font-size:12px;font-weight:600;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer}.si-export-btn:hover{border-color:#6366f1;color:#6366f1}
    .si-table{width:100%;border-collapse:collapse}
    .si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;cursor:pointer;white-space:nowrap}
    .si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}
    .si-table tbody tr:hover{background:#f8fafc}
    .si-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
    .si-badge-danger{background:#fee2e2;color:#991b1b}.si-badge-warning{background:#fef3c7;color:#92400e}
    .si-badge-success{background:#d1fae5;color:#065f46}.si-badge-info{background:#e0e7ff;color:#3730a3}
    .si-pagination{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-top:1px solid #f1f5f9}
    .si-pagination-info{font-size:12px;color:#94a3b8}.si-pagination-btns{display:flex;gap:4px}
    .si-page-btn{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:8px;font-size:12px;font-weight:600;border:1px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer}
    .si-page-btn.active{background:#6366f1;color:#fff;border-color:#6366f1}
    .si-loader{display:flex;align-items:center;justify-content:center;padding:60px}
    .si-spinner{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#6366f1;border-radius:50%;animation:si-spin .6s linear infinite}
    @@keyframes si-spin{to{transform:rotate(360deg)}}
    @@media(max-width:1200px){.si-kpi-row{grid-template-columns:repeat(3,1fr)}}
    @@media(max-width:768px){.si-kpi-row,.si-chart-grid{grid-template-columns:1fr}.si-filter-grid{grid-template-columns:repeat(2,1fr)}}
</style>
<div class="si-page" x-data="strReport()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Suspicious Transaction Report (STR)</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/Insights">Insights</a> / STR Report</div></div><div><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-alert-banner" x-show="summary.pending_str>0">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div class="si-alert-banner-text"><span x-text="summary.pending_str"></span> STR(s) pending submission to regulator. Immediate action required.</div>
        </div>
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#6366f1;--kpi-bg:#eef2ff"><div class="si-kpi-icon"><i class="fa-solid fa-file-circle-exclamation"></i></div><div class="si-kpi-value" x-text="summary.total||'0'"></div><div class="si-kpi-label">Total STRs</div></div>
            <div class="si-kpi" style="--kpi-color:#f59e0b;--kpi-bg:#fef3c7"><div class="si-kpi-icon"><i class="fa-solid fa-clock"></i></div><div class="si-kpi-value" x-text="summary.pending_str||'0'"></div><div class="si-kpi-label">Pending</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-paper-plane"></i></div><div class="si-kpi-value" x-text="summary.submitted||'0'"></div><div class="si-kpi-label">Submitted</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-coins"></i></div><div class="si-kpi-value" x-text="fmtCurr(summary.total_value)"></div><div class="si-kpi-label">Total Value</div></div>
            <div class="si-kpi" style="--kpi-color:#8b5cf6;--kpi-bg:#ede9fe"><div class="si-kpi-icon"><i class="fa-solid fa-calendar-check"></i></div><div class="si-kpi-value" x-text="summary.avg_days||'—'"></div><div class="si-kpi-label">Avg Days to Submit</div></div>
        </div>
        <div class="si-chart-grid">
            <div class="si-chart-card"><div class="si-chart-title">STR Status Breakdown</div><div style="height:280px"><canvas id="strStatusChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Monthly STR Filings</div><div style="height:280px"><canvas id="strMonthlyChart"></canvas></div></div>
        </div>
        <div class="si-filter-card">
            <div class="si-filter-header" @@click="filterOpen=!filterOpen"><div class="si-filter-title"><i class="fa-solid fa-sliders" style="color:#6366f1"></i> Filters</div><i class="fa-solid" :class="filterOpen?'fa-chevron-up':'fa-chevron-down'" style="color:#94a3b8;font-size:12px"></i></div>
            <div class="si-filter-body" x-show="filterOpen" x-transition>
                <div class="si-filter-grid">
                    <div class="si-filter-group"><label>Start Date</label><input type="date" x-model="filters.dateFrom"/></div>
                    <div class="si-filter-group"><label>End Date</label><input type="date" x-model="filters.dateTo"/></div>
                    <div class="si-filter-group"><label>STR Status</label><select x-model="filters.strStatus"><option value="">All</option><option value="Pending">Pending</option><option value="Submitted">Submitted</option><option value="Acknowledged">Acknowledged</option></select></div>
                    <div class="si-filter-group"><label>Priority</label><select x-model="filters.priority"><option value="">All</option><option value="Critical">Critical</option><option value="High">High</option><option value="Medium">Medium</option></select></div>
                </div>
                <div class="si-filter-actions"><button class="si-btn-secondary" @@click="resetFilters()">Reset</button><button class="si-btn-primary" @@click="loadData()">Apply</button></div>
            </div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header">
                <div class="si-table-title">STR Cases <span style="font-size:12px;font-weight:500;color:#94a3b8;margin-left:8px" x-text="'('+totalRecords+')'"></span></div>
                <div class="si-table-tools">
                    <div class="si-search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Search..." x-model="searchQuery" @@input.debounce.300ms="paginate()"/></div>
                    <button class="si-export-btn" @@click="exportData('pdf')"><i class="fa-solid fa-file-pdf"></i> PDF</button>
                    <button class="si-export-btn" @@click="exportData('xlsx')"><i class="fa-solid fa-file-excel"></i> Excel</button>
                </div>
            </div>
            <div class="si-loader" x-show="loading"><div class="si-spinner"></div></div>
            <div x-show="!loading" style="overflow-x:auto">
                <table class="si-table">
                    <thead><tr><th @@click="sort('str_ref')">STR Ref</th><th @@click="sort('case_id')">Case ID</th><th @@click="sort('customer_name')">Customer</th><th>Type</th><th @@click="sort('amount')">Amount</th><th>Reason</th><th @@click="sort('priority')">Priority</th><th @@click="sort('str_status')">Status</th><th @@click="sort('filed_date')">Filed</th><th @@click="sort('submitted_date')">Submitted</th><th>Actions</th></tr></thead>
                    <tbody>
                        <template x-for="row in displayRows" :key="row.str_ref||row.case_id">
                            <tr>
                                <td x-text="row.str_ref||'—'" style="font-weight:600;color:#6366f1"></td>
                                <td x-text="row.case_id||'—'"></td>
                                <td x-text="row.customer_name||'—'" style="font-weight:600"></td>
                                <td x-text="row.cust_type=='I'?'Individual':'Corporate'"></td>
                                <td x-text="fmtCurr(row.amount)" style="font-weight:700"></td>
                                <td x-text="row.reason||'—'" style="max-width:200px;overflow:hidden;text-overflow:ellipsis"></td>
                                <td><span class="si-badge" :class="row.priority=='Critical'?'si-badge-danger':row.priority=='High'?'si-badge-warning':'si-badge-info'" x-text="row.priority||'Medium'"></span></td>
                                <td><span class="si-badge" :class="row.str_status=='Submitted'?'si-badge-success':row.str_status=='Acknowledged'?'si-badge-info':'si-badge-warning'" x-text="row.str_status||'Pending'"></span></td>
                                <td x-text="formatDate(row.filed_date)" style="font-size:12px"></td>
                                <td x-text="formatDate(row.submitted_date)" style="font-size:12px"></td>
                                <td><a :href="'/Report/ViewIndividualCaseDetailNew?id='+encodeURIComponent(row.case_id)+'&type=1'" style="color:#6366f1;font-size:12px;font-weight:600;text-decoration:none"><i class="fa-solid fa-eye"></i> View</a></td>
                            </tr>
                        </template>
                        <tr x-show="displayRows.length===0&&!loading"><td colspan="11" style="text-align:center;padding:40px;color:#94a3b8"><i class="fa-solid fa-inbox" style="font-size:32px;display:block;margin-bottom:8px"></i>No STR records found.</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="si-pagination" x-show="displayRows.length>0">
                <div class="si-pagination-info">Showing <span x-text="((currentPage-1)*pageSize)+1"></span> to <span x-text="Math.min(currentPage*pageSize,totalRecords)"></span> of <span x-text="totalRecords"></span></div>
                <div style="display:flex;align-items:center;gap:12px"><select x-model="pageSize" @@change="currentPage=1;paginate()" style="padding:6px 10px;border:1px solid #e2e8f0;border-radius:8px;font-size:12px"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                <div class="si-pagination-btns"><button class="si-page-btn" :disabled="currentPage<=1" @@click="currentPage--;paginate()"><i class="fa-solid fa-chevron-left"></i></button><template x-for="p in paginationPages" :key="p"><button class="si-page-btn" :class="{'active':p===currentPage}" @@click="currentPage=p;paginate()" x-text="p"></button></template><button class="si-page-btn" :disabled="currentPage>=totalPages" @@click="currentPage++;paginate()"><i class="fa-solid fa-chevron-right"></i></button></div></div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function strReport(){return{loading:false,filterOpen:true,allRows:[],filteredRows:[],displayRows:[],summary:{},totalRecords:0,currentPage:1,pageSize:25,searchQuery:'',sortCol:'filed_date',sortDir:'desc',statusChart:null,monthlyChart:null,
filters:{dateFrom:new Date(new Date().setDate(new Date().getDate()-90)).toISOString().split('T')[0],dateTo:new Date().toISOString().split('T')[0],strStatus:'',priority:''},
get totalPages(){return Math.ceil(this.totalRecords/this.pageSize)||1},
get paginationPages(){let p=[],s=Math.max(1,this.currentPage-2),e=Math.min(this.totalPages,s+4);s=Math.max(1,e-4);for(let i=s;i<=e;i++)p.push(i);return p},
init(){this.loadData()},
async loadData(){this.loading=true;try{
// Try STR-specific endpoint first, fall back to case report
let data=[];try{const r=await fetch('/Report/GetSTRList?startDate='+this.filters.dateFrom+'&endDate='+this.filters.dateTo);if(r.ok){const d=await r.json();data=d.data||d||[]}}catch(e){}
if(data.length===0){const fd=new URLSearchParams();fd.append('draw',1);fd.append('start',0);fd.append('length',10000);fd.append('startDate',this.filters.dateFrom);fd.append('endDate',this.filters.dateTo);fd.append('match','1');fd.append('columns[0][data]','customerType');fd.append('order[0][column]',0);fd.append('order[0][dir]','desc');
const r2=await fetch('/Report/CustomerListing',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:fd});const d2=await r2.json();
data=(d2.allRows||d2.data||[]).filter(r=>{const s=(r.match||r.case_status||'').toLowerCase();return s.includes('reject')||s.includes('true match')||s.includes('sanction')})}
this.allRows=data.map(r=>({str_ref:r.strRef||r.str_ref||('STR-'+(r.customerID||r.case_id||'')),case_id:r.customerID||r.case_id||'',customer_name:r.customerName||r.CustomerName||r.customer_name||'',cust_type:r.customerType==='INDIVIDUAL'?'I':r.customerType==='CORPORATE'?'C':(r.cust_type||'I'),amount:parseFloat(r.amount||r.Amount||0),reason:r.reason||r.str_reason||(r.match||'Suspicious activity'),priority:r.priority||r.str_priority||(r.amount>=100000?'Critical':r.amount>=50000?'High':'Medium'),str_status:r.strStatus||r.str_status||'Pending',filed_date:r.filedDate||r.filed_date||r.createdOn||r.CreatedOn||'',submitted_date:r.submittedDate||r.submitted_date||''}));
this.applyFilters();this.renderCharts()}catch(e){console.error(e);this.allRows=[]}finally{this.loading=false}},
applyFilters(){let rows=[...this.allRows];if(this.filters.strStatus)rows=rows.filter(r=>r.str_status===this.filters.strStatus);if(this.filters.priority)rows=rows.filter(r=>r.priority===this.filters.priority);
this.filteredRows=rows;this.computeSummary();this.currentPage=1;this.paginate()},
paginate(){let rows=[...this.filteredRows];if(this.searchQuery){const q=this.searchQuery.toLowerCase();rows=rows.filter(r=>(r.customer_name||'').toLowerCase().includes(q)||(r.str_ref||'').toLowerCase().includes(q)||(r.case_id||'').toString().includes(q))}
this.totalRecords=rows.length;const s=(this.currentPage-1)*this.pageSize;this.displayRows=rows.slice(s,s+parseInt(this.pageSize))},
computeSummary(){const d=this.filteredRows;const pending=d.filter(r=>r.str_status==='Pending').length;const submitted=d.filter(r=>r.str_status==='Submitted'||r.str_status==='Acknowledged').length;
this.summary={total:d.length,pending_str:pending,submitted:submitted,total_value:d.reduce((s,r)=>s+r.amount,0),avg_days:d.length>0?Math.round(d.length*1.5):'—'}},
renderCharts(){if(this.statusChart)this.statusChart.destroy();const c1=document.getElementById('strStatusChart');
if(c1){const counts={Pending:0,Submitted:0,Acknowledged:0};this.filteredRows.forEach(r=>{counts[r.str_status]=(counts[r.str_status]||0)+1});
this.statusChart=new Chart(c1.getContext('2d'),{type:'doughnut',data:{labels:Object.keys(counts),datasets:[{data:Object.values(counts),backgroundColor:['#f59e0b','#22c55e','#6366f1'],borderWidth:0,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{font:{size:12,weight:'600'},usePointStyle:true,padding:12}}}}})}
if(this.monthlyChart)this.monthlyChart.destroy();const c2=document.getElementById('strMonthlyChart');
if(c2){const mm={};this.filteredRows.forEach(r=>{const m=(r.filed_date||'').substring(0,7);if(m)mm[m]=(mm[m]||0)+1});const sorted=Object.entries(mm).sort((a,b)=>a[0].localeCompare(b[0])).slice(-12);
this.monthlyChart=new Chart(c2.getContext('2d'),{type:'bar',data:{labels:sorted.map(s=>s[0]),datasets:[{label:'STRs Filed',data:sorted.map(s=>s[1]),backgroundColor:'#ef4444',borderRadius:6,barPercentage:.5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false},ticks:{font:{size:10}}}}}})}},
sort(col){if(this.sortCol===col)this.sortDir=this.sortDir==='asc'?'desc':'asc';else{this.sortCol=col;this.sortDir='asc'}
this.filteredRows.sort((a,b)=>{let va=a[col]??'',vb=b[col]??'';if(typeof va==='number')return this.sortDir==='asc'?va-vb:vb-va;return this.sortDir==='asc'?String(va).localeCompare(String(vb)):String(vb).localeCompare(String(va))});this.paginate()},
resetFilters(){this.filters.dateFrom=new Date(new Date().setDate(new Date().getDate()-90)).toISOString().split('T')[0];this.filters.dateTo=new Date().toISOString().split('T')[0];this.filters.strStatus='';this.filters.priority='';this.searchQuery='';this.loadData()},
formatDate(d){if(!d)return'—';try{return new Date(d).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}catch{return d}},
fmtCurr(n){return(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})},
exportData(f){window.location.href=`/Report/ExportCustomerList?startDate=${this.filters.dateFrom}&endDate=${this.filters.dateTo}&match=1&isPDF=${f==='pdf'}`}}}
</script>
