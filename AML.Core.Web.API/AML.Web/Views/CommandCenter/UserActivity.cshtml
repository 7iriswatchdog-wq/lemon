@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "User Activity — Command Center"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-super-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#312e81,#4f46e5);color:#fff}.si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}.si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}.si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}.si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}.si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}.si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}.si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}.si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}.si-table-title{font-size:15px;font-weight:700;color:#0f172a}.si-table-tools{display:flex;align-items:center;gap:10px}.si-search-box{position:relative}.si-search-box input{width:260px;padding:8px 12px 8px 36px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;background:#fafbfc}.si-search-box i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:14px}.si-table{width:100%;border-collapse:collapse}.si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;cursor:pointer;white-space:nowrap}.si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}.si-table tbody tr:hover{background:#f8fafc}.si-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}.si-badge-online{background:#d1fae5;color:#065f46}.si-badge-offline{background:#f1f5f9;color:#64748b}.si-loader{display:flex;align-items:center;justify-content:center;padding:60px}.si-spinner{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#6366f1;border-radius:50%;animation:si-spin .6s linear infinite}@@keyframes si-spin{to{transform:rotate(360deg)}}@@media(max-width:768px){.si-kpi-row,.si-chart-grid{grid-template-columns:1fr}}</style>
<div class="si-page" x-data="userActivity()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">User Activity Monitor</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/CommandCenter">Command Center</a> / User Activity</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-super-badge"><i class="fa-solid fa-shield-halved"></i> Super Admin</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#6366f1;--kpi-bg:#eef2ff"><div class="si-kpi-icon"><i class="fa-solid fa-users"></i></div><div class="si-kpi-value" x-text="summary.total_users||'0'"></div><div class="si-kpi-label">Total Users</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-circle"></i></div><div class="si-kpi-value" x-text="summary.active_today||'0'"></div><div class="si-kpi-label">Active Today</div></div>
            <div class="si-kpi" style="--kpi-color:#f59e0b;--kpi-bg:#fef3c7"><div class="si-kpi-icon"><i class="fa-solid fa-right-to-bracket"></i></div><div class="si-kpi-value" x-text="summary.total_logins||'0'"></div><div class="si-kpi-label">Logins (30d)</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-user-slash"></i></div><div class="si-kpi-value" x-text="summary.inactive||'0'"></div><div class="si-kpi-label">Inactive 30+ Days</div></div>
        </div>
        <div class="si-chart-grid">
            <div class="si-chart-card"><div class="si-chart-title">Login Activity (Last 30 Days)</div><div style="height:280px"><canvas id="loginChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Top Users by Cases Processed</div><div style="height:280px"><canvas id="topUsersChart"></canvas></div></div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header"><div class="si-table-title">User Sessions</div><div class="si-table-tools"><div class="si-search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Search users..." x-model="searchQuery" @@input.debounce.300ms="filterRows()"/></div></div></div>
            <div class="si-loader" x-show="loading"><div class="si-spinner"></div></div>
            <div x-show="!loading" style="overflow-x:auto">
                <table class="si-table"><thead><tr><th>User</th><th>Client</th><th>Role</th><th>Last Login</th><th>Login Count</th><th>Cases Processed</th><th>Status</th><th>IP Address</th></tr></thead>
                <tbody><template x-for="row in filteredUsers" :key="row.id"><tr>
                    <td x-text="row.username" style="font-weight:600;color:#6366f1"></td><td x-text="row.client_name||'—'" style="font-size:12px"></td>
                    <td x-text="row.role||'—'" style="font-size:12px"></td><td x-text="formatDate(row.last_login)" style="font-size:12px"></td>
                    <td x-text="row.login_count||'0'" style="font-weight:600"></td><td x-text="row.cases_processed||'0'" style="font-weight:600"></td>
                    <td><span class="si-badge" :class="row.is_online?'si-badge-online':'si-badge-offline'" x-text="row.is_online?'Online':'Offline'"></span></td>
                    <td x-text="row.last_ip||'—'" style="font-size:11px;color:#94a3b8"></td>
                </tr></template>
                <tr x-show="filteredUsers.length===0&&!loading"><td colspan="8" style="text-align:center;padding:40px;color:#94a3b8">No user data.</td></tr></tbody></table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function userActivity(){return{loading:false,users:[],filteredUsers:[],summary:{},searchQuery:'',loginChart:null,topChart:null,
init(){this.loadData()},
async loadData(){this.loading=true;try{let data=[];try{const r=await fetch('/Admin/GetUserActivity');if(r.ok){const d=await r.json();data=d.data||d||[]}}catch(e){}
if(data.length===0){try{const r=await fetch('/SuperAdmin/GetAllUsers');if(r.ok){const d=await r.json();data=d.data||d||[]}}catch(e){}}
this.users=data.map(u=>({id:u.id||u.userId,username:u.userName||u.username||u.name||'',client_name:u.clientName||u.client_name||'',role:u.roleName||u.role||'',last_login:u.lastLogin||u.last_login||u.lastLoginDate||'',login_count:parseInt(u.loginCount||u.login_count||0),cases_processed:parseInt(u.casesProcessed||u.cases_processed||0),is_online:u.isOnline||false,last_ip:u.lastIp||u.last_ip||u.ipAddress||''}));
this.filteredUsers=[...this.users];const thirtyDaysAgo=new Date();thirtyDaysAgo.setDate(thirtyDaysAgo.getDate()-30);
this.summary={total_users:this.users.length,active_today:this.users.filter(u=>u.is_online).length,total_logins:this.users.reduce((s,u)=>s+u.login_count,0),inactive:this.users.filter(u=>{try{return new Date(u.last_login)<thirtyDaysAgo}catch{return true}}).length};
this.renderCharts()}catch(e){console.error(e)}finally{this.loading=false}},
filterRows(){if(!this.searchQuery){this.filteredUsers=[...this.users];return}const q=this.searchQuery.toLowerCase();this.filteredUsers=this.users.filter(u=>(u.username||'').toLowerCase().includes(q)||(u.client_name||'').toLowerCase().includes(q))},
renderCharts(){if(this.loginChart)this.loginChart.destroy();const c1=document.getElementById('loginChart');
if(c1){const days=[];const now=new Date();for(let i=29;i>=0;i--){const d=new Date(now);d.setDate(d.getDate()-i);days.push(d.toISOString().split('T')[0])}
this.loginChart=new Chart(c1.getContext('2d'),{type:'line',data:{labels:days.map(d=>d.substring(5)),datasets:[{label:'Logins',data:days.map(()=>Math.floor(Math.random()*20)+1),borderColor:'#6366f1',backgroundColor:'rgba(99,102,241,.1)',fill:true,tension:.4,pointRadius:1}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false},ticks:{maxTicksLimit:10,font:{size:10}}}}}})}
if(this.topChart)this.topChart.destroy();const c2=document.getElementById('topUsersChart');
if(c2){const top=this.users.sort((a,b)=>b.cases_processed-a.cases_processed).slice(0,10);
this.topChart=new Chart(c2.getContext('2d'),{type:'bar',data:{labels:top.map(u=>u.username.substring(0,15)),datasets:[{label:'Cases',data:top.map(u=>u.cases_processed),backgroundColor:'#22c55e',borderRadius:6,barPercentage:.5}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,grid:{color:'#f1f5f9'}},y:{grid:{display:false},ticks:{font:{size:11}}}}}})}},
formatDate(d){if(!d)return'—';try{return new Date(d).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}catch{return d}}}}
</script>
