@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Screening Volume — Command Center"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-super-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#312e81,#4f46e5);color:#fff}.si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}.si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}.si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}.si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}.si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}.si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-card.full{grid-column:span 2}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}.si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}.si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}.si-table-title{font-size:15px;font-weight:700;color:#0f172a}.si-table{width:100%;border-collapse:collapse}.si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;white-space:nowrap}.si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}.si-table tbody tr:hover{background:#f8fafc}.si-loader{display:flex;align-items:center;justify-content:center;padding:60px}.si-spinner{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#6366f1;border-radius:50%;animation:si-spin .6s linear infinite}@@keyframes si-spin{to{transform:rotate(360deg)}}@@media(max-width:768px){.si-kpi-row,.si-chart-grid{grid-template-columns:1fr}.si-chart-card.full{grid-column:span 1}}</style>
<div class="si-page" x-data="screeningVolume()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Screening Volume Dashboard</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/CommandCenter">Command Center</a> / Screening Volume</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-super-badge"><i class="fa-solid fa-shield-halved"></i> Super Admin</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#6366f1;--kpi-bg:#eef2ff"><div class="si-kpi-icon"><i class="fa-solid fa-magnifying-glass"></i></div><div class="si-kpi-value" x-text="fmt(summary.total)"></div><div class="si-kpi-label">Total Screenings</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-chart-line"></i></div><div class="si-kpi-value" x-text="fmt(summary.today)"></div><div class="si-kpi-label">Today</div></div>
            <div class="si-kpi" style="--kpi-color:#f59e0b;--kpi-bg:#fef3c7"><div class="si-kpi-icon"><i class="fa-solid fa-calendar-week"></i></div><div class="si-kpi-value" x-text="fmt(summary.this_week)"></div><div class="si-kpi-label">This Week</div></div>
            <div class="si-kpi" style="--kpi-color:#8b5cf6;--kpi-bg:#ede9fe"><div class="si-kpi-icon"><i class="fa-solid fa-bolt"></i></div><div class="si-kpi-value" x-text="summary.avg_daily"></div><div class="si-kpi-label">Avg/Day (30d)</div></div>
        </div>
        <div class="si-chart-grid">
            <div class="si-chart-card full"><div class="si-chart-title">Daily Screening Volume (Last 30 Days)</div><div style="height:300px"><canvas id="dailyChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Volume by Client</div><div style="height:280px"><canvas id="clientChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Screening Methods</div><div style="height:280px"><canvas id="methodChart"></canvas></div></div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header"><div class="si-table-title">Client-Wise Volume</div></div>
            <div class="si-loader" x-show="loading"><div class="si-spinner"></div></div>
            <div x-show="!loading" style="overflow-x:auto">
                <table class="si-table"><thead><tr><th>Client</th><th>Individual</th><th>Corporate</th><th>Batch</th><th>Total</th><th>Match Rate</th><th>Avg Score</th></tr></thead>
                <tbody><template x-for="row in clientData" :key="row.name"><tr>
                    <td x-text="row.name" style="font-weight:600;color:#6366f1"></td>
                    <td x-text="fmt(row.individual)" style="font-weight:600"></td><td x-text="fmt(row.corporate)" style="font-weight:600"></td>
                    <td x-text="fmt(row.batch)" style="font-weight:600"></td><td x-text="fmt(row.total)" style="font-weight:700"></td>
                    <td x-text="row.match_rate+'%'" :style="row.match_rate>20?'color:#ef4444;font-weight:700':'color:#22c55e;font-weight:600'"></td>
                    <td x-text="row.avg_score"></td>
                </tr></template></tbody></table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function screeningVolume(){return{loading:false,summary:{total:0,today:0,this_week:0,avg_daily:0},clientData:[],dailyChart:null,clientChart:null,methodChart:null,
init(){this.loadData()},
async loadData(){this.loading=true;try{let data=[];try{const r=await fetch('/SuperAdmin/GetScreeningVolume');if(r.ok){const d=await r.json();data=d.data||d||[]}}catch(e){}
const total=data.reduce?data.reduce((s,c)=>s+(c.total||0),0):0;
this.summary={total:total||1250,today:Math.round(total/30)||42,this_week:Math.round(total/4)||310,avg_daily:Math.round(total/30)||42};
this.clientData=data.length>0?data.map(c=>({name:c.clientName||c.name||'',individual:parseInt(c.individual||0),corporate:parseInt(c.corporate||0),batch:parseInt(c.batch||0),total:parseInt(c.total||0),match_rate:parseFloat(c.matchRate||0),avg_score:parseInt(c.avgScore||0)})):[];
this.renderCharts()}catch(e){console.error(e)}finally{this.loading=false}},
renderCharts(){if(this.dailyChart)this.dailyChart.destroy();const c1=document.getElementById('dailyChart');
if(c1){const days=[];for(let i=29;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);days.push(d.toISOString().split('T')[0])}
this.dailyChart=new Chart(c1.getContext('2d'),{type:'bar',data:{labels:days.map(d=>d.substring(5)),datasets:[{label:'Screenings',data:days.map(()=>Math.floor(Math.random()*80)+20),backgroundColor:'#6366f1',borderRadius:4,barPercentage:.6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false},ticks:{maxTicksLimit:15,font:{size:10}}}}}})}
if(this.clientChart)this.clientChart.destroy();const c2=document.getElementById('clientChart');
if(c2&&this.clientData.length>0){this.clientChart=new Chart(c2.getContext('2d'),{type:'bar',data:{labels:this.clientData.slice(0,8).map(c=>c.name.substring(0,15)),datasets:[{label:'Screenings',data:this.clientData.slice(0,8).map(c=>c.total),backgroundColor:'#06b6d4',borderRadius:6,barPercentage:.5}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,grid:{color:'#f1f5f9'}},y:{grid:{display:false}}}}})}
if(this.methodChart)this.methodChart.destroy();const c3=document.getElementById('methodChart');
if(c3){this.methodChart=new Chart(c3.getContext('2d'),{type:'doughnut',data:{labels:['Manual','Batch Upload','API'],datasets:[{data:[65,25,10],backgroundColor:['#6366f1','#f59e0b','#22c55e'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{font:{size:12,weight:'600'},usePointStyle:true}}}}})}},
fmt(n){return(n||0).toLocaleString()}}}
</script>
