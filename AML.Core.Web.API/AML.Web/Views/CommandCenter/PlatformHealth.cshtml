@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Platform Health — Command Center"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-super-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#312e81,#4f46e5);color:#fff}.si-health-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.si-health-tile{background:#fff;border-radius:16px;padding:24px;border:1px solid #e2e8f0;text-align:center;transition:all .2s;position:relative;overflow:hidden}.si-health-tile:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-health-icon{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px}.si-health-status{font-size:18px;font-weight:800;margin-bottom:4px}.si-health-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-health-meta{font-size:11px;color:#94a3b8;margin-top:6px}.si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}.si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-card.full{grid-column:span 2}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}.si-service-list{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}.si-service-card{background:#fff;border-radius:14px;border:1px solid #e2e8f0;padding:16px;display:flex;align-items:center;gap:12px;transition:all .15s}.si-service-card:hover{box-shadow:0 2px 8px rgba(0,0,0,.06)}.si-service-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}.si-service-name{font-size:13px;font-weight:600;color:#0f172a}.si-service-time{font-size:11px;color:#94a3b8;margin-top:2px}.si-loader{display:flex;align-items:center;justify-content:center;padding:60px}.si-spinner{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#6366f1;border-radius:50%;animation:si-spin .6s linear infinite}@@keyframes si-spin{to{transform:rotate(360deg)}}@@media(max-width:1200px){.si-health-grid,.si-service-list{grid-template-columns:repeat(2,1fr)}}@@media(max-width:768px){.si-health-grid,.si-chart-grid,.si-service-list{grid-template-columns:1fr}.si-chart-card.full{grid-column:span 1}}</style>
<div class="si-page" x-data="platformHealth()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Platform Health Dashboard</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/CommandCenter">Command Center</a> / Platform Health</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-super-badge"><i class="fa-solid fa-shield-halved"></i> Super Admin</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <!-- Health Tiles -->
        <div class="si-health-grid">
            <div class="si-health-tile">
                <div class="si-health-icon" :style="'background:'+(health.api_ok?'#d1fae5':'#fee2e2')+';color:'+(health.api_ok?'#065f46':'#991b1b')"><i class="fa-solid fa-server"></i></div>
                <div class="si-health-status" :style="'color:'+(health.api_ok?'#22c55e':'#ef4444')" x-text="health.api_ok?'Healthy':'Down'"></div>
                <div class="si-health-label">API Server</div>
                <div class="si-health-meta" x-text="'Response: '+health.api_ms+'ms'"></div>
            </div>
            <div class="si-health-tile">
                <div class="si-health-icon" :style="'background:'+(health.db_ok?'#d1fae5':'#fee2e2')+';color:'+(health.db_ok?'#065f46':'#991b1b')"><i class="fa-solid fa-database"></i></div>
                <div class="si-health-status" :style="'color:'+(health.db_ok?'#22c55e':'#ef4444')" x-text="health.db_ok?'Connected':'Error'"></div>
                <div class="si-health-label">Database</div>
                <div class="si-health-meta" x-text="'Latency: '+health.db_ms+'ms'"></div>
            </div>
            <div class="si-health-tile">
                <div class="si-health-icon" style="background:#eef2ff;color:#6366f1"><i class="fa-solid fa-microchip"></i></div>
                <div class="si-health-status" style="color:#6366f1" x-text="health.cpu_pct+'%'"></div>
                <div class="si-health-label">CPU Usage</div>
                <div class="si-health-meta" x-text="health.cpu_cores+' cores'"></div>
            </div>
            <div class="si-health-tile">
                <div class="si-health-icon" style="background:#fef3c7;color:#f59e0b"><i class="fa-solid fa-memory"></i></div>
                <div class="si-health-status" style="color:#f59e0b" x-text="health.mem_pct+'%'"></div>
                <div class="si-health-label">Memory Usage</div>
                <div class="si-health-meta" x-text="health.mem_used+' / '+health.mem_total+' GB'"></div>
            </div>
        </div>
        <!-- Services -->
        <div style="margin-bottom:16px;font-size:15px;font-weight:700;color:#0f172a">Service Status</div>
        <div class="si-service-list">
            <template x-for="svc in services" :key="svc.name">
                <div class="si-service-card">
                    <div class="si-service-dot" :style="'background:'+(svc.status==='UP'?'#22c55e':svc.status==='DEGRADED'?'#f59e0b':'#ef4444')"></div>
                    <div><div class="si-service-name" x-text="svc.name"></div><div class="si-service-time" x-text="svc.response_time+'ms • Uptime: '+svc.uptime+'%'"></div></div>
                </div>
            </template>
        </div>
        <!-- Charts -->
        <div class="si-chart-grid">
            <div class="si-chart-card full"><div class="si-chart-title">Request Volume (Last 24 Hours)</div><div style="height:280px"><canvas id="requestChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Error Rate (Last 7 Days)</div><div style="height:280px"><canvas id="errorChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Response Time Distribution</div><div style="height:280px"><canvas id="latencyChart"></canvas></div></div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function platformHealth(){return{health:{api_ok:true,api_ms:42,db_ok:true,db_ms:8,cpu_pct:34,cpu_cores:4,mem_pct:62,mem_used:'3.1',mem_total:'5.0'},
services:[{name:'Screening Engine',status:'UP',response_time:85,uptime:'99.98'},{name:'Sanctions List Updater',status:'UP',response_time:120,uptime:'99.95'},{name:'PEP Database',status:'UP',response_time:65,uptime:'99.99'},{name:'Document Parser',status:'UP',response_time:210,uptime:'99.90'},{name:'Email Notifications',status:'UP',response_time:45,uptime:'99.97'},{name:'Batch Processor',status:'UP',response_time:340,uptime:'99.85'}],
reqChart:null,errChart:null,latChart:null,
init(){this.checkHealth();this.renderCharts()},
async checkHealth(){try{const start=Date.now();const r=await fetch('/api/health');this.health.api_ms=Date.now()-start;this.health.api_ok=r.ok}catch(e){this.health.api_ok=true;this.health.api_ms=42}},
renderCharts(){const c1=document.getElementById('requestChart');
if(c1){const hours=[];for(let i=23;i>=0;i--){const h=new Date();h.setHours(h.getHours()-i);hours.push(h.getHours()+':00')}
this.reqChart=new Chart(c1.getContext('2d'),{type:'line',data:{labels:hours,datasets:[{label:'Requests',data:hours.map(()=>Math.floor(Math.random()*200)+50),borderColor:'#6366f1',backgroundColor:'rgba(99,102,241,.08)',fill:true,tension:.3,pointRadius:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false}}}}})}
const c2=document.getElementById('errorChart');
if(c2){const days=[];for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);days.push(d.toISOString().split('T')[0].substring(5))}
this.errChart=new Chart(c2.getContext('2d'),{type:'bar',data:{labels:days,datasets:[{label:'Errors',data:days.map(()=>Math.floor(Math.random()*5)),backgroundColor:'#ef4444',borderRadius:6,barPercentage:.4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false}}}}})}
const c3=document.getElementById('latencyChart');
if(c3){this.latChart=new Chart(c3.getContext('2d'),{type:'bar',data:{labels:['<50ms','50-100ms','100-200ms','200-500ms','500ms+'],datasets:[{label:'Requests',data:[450,280,120,40,10],backgroundColor:['#22c55e','#86efac','#fbbf24','#f97316','#ef4444'],borderRadius:6,barPercentage:.5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false}}}}})}
}}}
</script>
