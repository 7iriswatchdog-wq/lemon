@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Access Rights Audit — Command Center"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-super-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#312e81,#4f46e5);color:#fff}.si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}.si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}.si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}.si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}.si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}.si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}.si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}.si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}.si-table-title{font-size:15px;font-weight:700;color:#0f172a}.si-table-tools{display:flex;align-items:center;gap:10px}.si-search-box{position:relative}.si-search-box input{width:260px;padding:8px 12px 8px 36px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;background:#fafbfc}.si-search-box i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:14px}.si-table{width:100%;border-collapse:collapse}.si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;cursor:pointer;white-space:nowrap}.si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}.si-table tbody tr:hover{background:#f8fafc}.si-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}.si-badge-admin{background:#fee2e2;color:#991b1b}.si-badge-user{background:#d1fae5;color:#065f46}.si-badge-viewer{background:#e0e7ff;color:#3730a3}.si-badge-active{background:#d1fae5;color:#065f46}.si-badge-inactive{background:#f1f5f9;color:#64748b}.si-loader{display:flex;align-items:center;justify-content:center;padding:60px}.si-spinner{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#6366f1;border-radius:50%;animation:si-spin .6s linear infinite}@@keyframes si-spin{to{transform:rotate(360deg)}}@@media(max-width:768px){.si-kpi-row,.si-chart-grid{grid-template-columns:1fr}}</style>
<div class="si-page" x-data="accessAudit()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Access Rights Audit</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/CommandCenter">Command Center</a> / Access Rights</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-super-badge"><i class="fa-solid fa-shield-halved"></i> Super Admin</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#6366f1;--kpi-bg:#eef2ff"><div class="si-kpi-icon"><i class="fa-solid fa-key"></i></div><div class="si-kpi-value" x-text="summary.total||'0'"></div><div class="si-kpi-label">Total Users</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-user-shield"></i></div><div class="si-kpi-value" x-text="summary.admins||'0'"></div><div class="si-kpi-label">Admins</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-users"></i></div><div class="si-kpi-value" x-text="summary.active||'0'"></div><div class="si-kpi-label">Active Users</div></div>
            <div class="si-kpi" style="--kpi-color:#f59e0b;--kpi-bg:#fef3c7"><div class="si-kpi-icon"><i class="fa-solid fa-user-lock"></i></div><div class="si-kpi-value" x-text="summary.locked||'0'"></div><div class="si-kpi-label">Locked / Disabled</div></div>
        </div>
        <div class="si-chart-grid">
            <div class="si-chart-card"><div class="si-chart-title">Users by Role</div><div style="height:280px"><canvas id="roleChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Client-Wise User Distribution</div><div style="height:280px"><canvas id="clientUserChart"></canvas></div></div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header"><div class="si-table-title">User Permissions</div><div class="si-table-tools"><div class="si-search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Search..." x-model="searchQ" @@input.debounce.300ms="filter()"/></div></div></div>
            <div class="si-loader" x-show="loading"><div class="si-spinner"></div></div>
            <div x-show="!loading" style="overflow-x:auto">
                <table class="si-table"><thead><tr><th>User</th><th>Email</th><th>Client</th><th>Role</th><th>Can Create</th><th>Can Approve</th><th>Can Export</th><th>Status</th><th>Last Login</th></tr></thead>
                <tbody><template x-for="u in filteredRows" :key="u.id"><tr>
                    <td x-text="u.name" style="font-weight:600;color:#6366f1"></td><td x-text="u.email||'—'" style="font-size:12px"></td>
                    <td x-text="u.client||'—'" style="font-size:12px"></td>
                    <td><span class="si-badge" :class="u.role==='Admin'?'si-badge-admin':u.role==='Viewer'?'si-badge-viewer':'si-badge-user'" x-text="u.role"></span></td>
                    <td><i :class="u.can_create?'fa-solid fa-check':'fa-solid fa-xmark'" :style="u.can_create?'color:#22c55e':'color:#ef4444'"></i></td>
                    <td><i :class="u.can_approve?'fa-solid fa-check':'fa-solid fa-xmark'" :style="u.can_approve?'color:#22c55e':'color:#ef4444'"></i></td>
                    <td><i :class="u.can_export?'fa-solid fa-check':'fa-solid fa-xmark'" :style="u.can_export?'color:#22c55e':'color:#ef4444'"></i></td>
                    <td><span class="si-badge" :class="u.is_active?'si-badge-active':'si-badge-inactive'" x-text="u.is_active?'Active':'Disabled'"></span></td>
                    <td x-text="formatDate(u.last_login)" style="font-size:12px"></td>
                </tr></template>
                <tr x-show="filteredRows.length===0&&!loading"><td colspan="9" style="text-align:center;padding:40px;color:#94a3b8">No user data.</td></tr></tbody></table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function accessAudit(){return{loading:false,rows:[],filteredRows:[],summary:{},searchQ:'',roleChart:null,clientChart:null,
init(){this.loadData()},
async loadData(){this.loading=true;try{let data=[];try{const r=await fetch('/SuperAdmin/GetAllUsers');if(r.ok){const d=await r.json();data=d.data||d||[]}}catch(e){}
if(!data.length){try{const r=await fetch('/Admin/GetUsers');if(r.ok){const d=await r.json();data=d.data||d||[]}}catch(e){}}
this.rows=data.map(u=>({id:u.id||u.userId,name:u.userName||u.name||'',email:u.email||'',client:u.clientName||u.client_name||'',role:u.roleName||u.role||'User',can_create:u.canCreate!==false,can_approve:u.canApprove||u.role==='Admin',can_export:u.canExport!==false,is_active:u.isActive!==false,is_locked:u.isLocked||false,last_login:u.lastLogin||u.last_login||''}));
this.filteredRows=[...this.rows];this.summary={total:this.rows.length,admins:this.rows.filter(u=>u.role==='Admin').length,active:this.rows.filter(u=>u.is_active).length,locked:this.rows.filter(u=>!u.is_active||u.is_locked).length};
this.renderCharts()}catch(e){console.error(e)}finally{this.loading=false}},
filter(){if(!this.searchQ){this.filteredRows=[...this.rows];return}const q=this.searchQ.toLowerCase();this.filteredRows=this.rows.filter(u=>(u.name||'').toLowerCase().includes(q)||(u.email||'').toLowerCase().includes(q)||(u.client||'').toLowerCase().includes(q))},
renderCharts(){if(this.roleChart)this.roleChart.destroy();const c1=document.getElementById('roleChart');
if(c1){const rm={};this.rows.forEach(u=>{rm[u.role]=(rm[u.role]||0)+1});
this.roleChart=new Chart(c1.getContext('2d'),{type:'doughnut',data:{labels:Object.keys(rm),datasets:[{data:Object.values(rm),backgroundColor:['#ef4444','#6366f1','#22c55e','#f59e0b','#06b6d4'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{font:{size:12,weight:'600'},usePointStyle:true}}}}})}
if(this.clientChart)this.clientChart.destroy();const c2=document.getElementById('clientUserChart');
if(c2){const cm={};this.rows.forEach(u=>{if(u.client)cm[u.client]=(cm[u.client]||0)+1});const sorted=Object.entries(cm).sort((a,b)=>b[1]-a[1]).slice(0,10);
this.clientChart=new Chart(c2.getContext('2d'),{type:'bar',data:{labels:sorted.map(s=>s[0].substring(0,18)),datasets:[{label:'Users',data:sorted.map(s=>s[1]),backgroundColor:'#6366f1',borderRadius:6,barPercentage:.5}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,grid:{color:'#f1f5f9'}},y:{grid:{display:false}}}}})}},
formatDate(d){if(!d)return'—';try{return new Date(d).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}catch{return d}}}}
</script>
