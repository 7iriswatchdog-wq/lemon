               function fillDropdown(id, data, selectedValue = null) {

        console.log(`Filling dropdown: ${id}`);
        console.log("Data:", data);
        console.log("Selected Value:", selectedValue);

        const dropdown = document.getElementById(id);
        dropdown.innerHTML = '<option value="">Select</option>';

        if (!data) return;

        data.forEach(item => {

            const option = document.createElement("option");

            // ✅ HANDLE STRING OR OBJECT
            if (typeof item === "string") {
                option.value = item;
                option.text = item;
            } else {
                option.value = item.value || item.text;
                option.text = item.text;
            }

            // ✅ SET SELECTED VALUE
            if (selectedValue && option.value == selectedValue) {
                option.selected = true;
            }

            dropdown.appendChild(option);
        });
    }

        function setIfVisible(id, value) {
        const el = document.getElementById(id);

        if (el && el.offsetParent !== null) { // ✅ visible check
            el.value = value || "";
        }
    }

        function fillIfVisible(id, dataList, selectedValue) {
        const el = document.getElementById(id);

        if (!el) return;

        // check visibility (important)
        const isVisible = el.offsetParent !== null;

            console.log(isVisible);

        if (isVisible) {
            fillDropdown(id, dataList, selectedValue);
        }
    }

