    <script>
    lucide.createIcons();
    let filteredCases = [];
    let originalCases = [];
    let currentPage = 1;
    let size = 10;
    let totalRecords = 0;
    let draw = 1;

    /* ---------------------- Column Filters Logic ---------------------- */
    function applyColumnFilters() {
        const activeFilters = $('#casesTable').data('excel-filters') || {};
        
        filteredCases = originalCases.filter(item => {
            for (const colIdxKey in activeFilters) {
                const colIdx = parseInt(colIdxKey);
                const allowedValues = activeFilters[colIdx];
                
                let itemVal = '';
                switch (colIdx) {
                    case 0: // Customer ID
                        itemVal = item.customerId || 'N/A';
                        break;
                    case 1: // Created On
                        const createdObj = formatDateTime(item.createdOn);
                        itemVal = `${createdObj?.date || ''} ${createdObj?.time || ''}`.trim() || 'N/A';
                        break;
                    case 2: // Updated On
                        const updatedObj = formatDateTime(item.updatedOnDB);
                        itemVal = updatedObj ? `${updatedObj.date || ''} ${updatedObj.time || ''}`.trim() : 'N/A';
                        break;
                    case 3: // Customer Type
                        itemVal = item.customerType || 'N/A';
                        break;
                    case 4: // Customer Name
                        itemVal = item.customerName || 'N/A';
                        break;
                    case 5: // Datasets
                        itemVal = item.caseChangeStatus || 'N/A';
                        break;
                    case 6: // Screening Score
                        itemVal = item.matchScore?.toString() || 'N/A';
                        break;
                    case 7: // Risk Rating
                        itemVal = item.riskScore
                            ? (
                                item.riskScore.toLowerCase().includes("high") &&
                                item.riskOverride?.toLowerCase() === "override"
                            )
                                ? "High(O)"
                                : item.riskScore.replace(" Risk", "").replace("High (O)", "High(O)")
                            : "Unclassified";
                        break;
                    case 8: // User
                        itemVal = item.createdUser || 'N/A';
                        break;
                    case 9: // Status
                        itemVal = formatCaseStatus(item.casestatus) || 'N/A';
                        itemVal = $('<div>').html(itemVal).text().replace(/\s+/g, ' ').trim();
                        break;
                }
                
                if (allowedValues && !allowedValues.has(itemVal.replace(/\s+/g, ' ').trim())) {
                    return false;
                }
            }
            return true;
        });

        // Update counts dynamically
        const start = filteredCases.length === 0 ? 0 : 1;
        const end = filteredCases.length;
        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalCases').text(filteredCases.length);
        $('#prevBtn').prop('disabled', true);
        $('#nextBtn').prop('disabled', true);

        renderTable();
    }
    /* ---------------------- Helpers ---------------------- */
    function formatDate(dateString) {
        if (!dateString) return { date: '', time: '' };
        const date = new Date(dateString);
        return {
            date: date.toLocaleDateString('en-GB'),
            time: date.toLocaleTimeString('en-GB', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            })
        };
    }
