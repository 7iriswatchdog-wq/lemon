    // Portal the corporate-badge breakdown tooltip to <body> so it escapes the
    // table's overflow-hidden / overflow-x-auto clipping and shows in full.
    (function () {
        let activeTip = null;
        let activeTrig = null;
        let hideT = null;

        function placeTip(trigger) {
            // Look up the tooltip — first hover it's still a DOM child; afterwards
            // it lives on document.body, so we cache the reference on the trigger.
            let tip = trigger._corpTip || trigger.querySelector(':scope > .corp-tip-content');
            if (!tip) return;
            trigger._corpTip = tip;

            if (activeTip && activeTip !== tip) hideTip(true);
            clearTimeout(hideT);

            if (tip.parentElement !== document.body) {
                document.body.appendChild(tip);
                tip.style.position = 'fixed';
                tip.style.zIndex = '99999';
            }
            tip.style.display = 'flex';
            tip.classList.remove('hidden');

            const rect = trigger.getBoundingClientRect();
            const tipRect = tip.getBoundingClientRect();
            const margin = 8;
            let left = rect.right - tipRect.width;
            if (left < margin) left = margin;
            if (left + tipRect.width > window.innerWidth - margin) {
                left = window.innerWidth - tipRect.width - margin;
            }
            let top = rect.bottom + 4;
            if (top + tipRect.height > window.innerHeight - margin) {
                top = rect.top - tipRect.height - 4;
            }
            tip.style.top = top + 'px';
            tip.style.left = left + 'px';

            activeTip = tip;
            activeTrig = trigger;
        }

        function hideTip(immediate) {
            const doHide = () => {
                if (!activeTip) return;
                activeTip.classList.add('hidden');
                activeTip.style.display = 'none';
                activeTip = null;
                activeTrig = null;
            };
            if (immediate) doHide();
            else hideT = setTimeout(doHide, 120);
        }

        document.addEventListener('mouseover', function (e) {
            const trigger = e.target.closest('.corp-tip-trigger');
            if (trigger) placeTip(trigger);
        });

        document.addEventListener('mouseout', function (e) {
            if (!activeTrig) return;
            const next = e.relatedTarget;
            if (next && (activeTrig.contains(next) || (activeTip && activeTip.contains(next)))) return;
            hideTip(false);
        });

        window.addEventListener('scroll', () => hideTip(true), true);
        window.addEventListener('resize', () => hideTip(true));
    })();

             function setDateIfVisible(id, value) {
            const el = document.getElementById(id);

            if (!el) return;

            // Handle default/invalid dates
            if (!value || value === "01/01/0001" || value === "0001-01-01") {
                if (el._flatpickr) {
                    el._flatpickr.clear();
                } else {
                    el.value = "";
                }
                return;
            }

            if (el._flatpickr) {
                el._flatpickr.setDate(value, true);
            } else {
                el.value = value;
            }
        }
