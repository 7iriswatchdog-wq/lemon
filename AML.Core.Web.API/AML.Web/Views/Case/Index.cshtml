        function loadCases(page = 1) {
        $('#loadingCaseDetails').removeClass('hidden');
        let searchValue = $('#searchInput').val() || '';
        $.ajax({
                url: '/case/custompagination',
            type: 'POST',
            data: {
                draw: draw,
                start: (page - 1) * size,
                length: size,
                searchValue: searchValue,
                search: { value: searchValue },
                startDate: formatDate($('#startDate').val()),
                endDate: formatDate($('#endDate').val()),
                cust_type: $('#customertype').val(),
                createdBy: $('#user').val(),
                matchScore: $('#screeningScore').val(),
                caseStatus: $('#caseStatus').val(),
                caseStatusChange: $('#caseStatusChange').val(),
                riskLevel: $('#riskScore').val(),
                includingDuplicate :$('#includingDuplicate').val()
            },
            success: function (res) {
                console.log("Raw Response from server:", res);
                if (res.data && res.data.length > 0) {
                    console.log("First record keys:", Object.keys(res.data[0]));
                    console.log("First record stringified:", JSON.stringify(res.data[0]));
                }
                originalCases = (res.data || []).map(r => ({
                    id: r.id,
                    customerId: r.customerId,
                    customerName: `${r.firstName || ''} ${r.middleName || ''} ${r.lastName || ''}`.trim(),
                    customerType: r.customerType === 'I'
                        ? 'Individual'
                        : r.customerType === 'C'
                            ? 'Corporate'
                            : r.customerType === 'S'
                                ? 'Shareholder'
                                : '',
                    cifNo: r.customerId,
                    caseChangeStatus: r.caseChangeStatus || '',
                    matchScore: (r.matchScore === 0 || r.matchScore === "0") ? 0 : (r.matchScore || ''),
                    createdOn: r.createdOn,
                    updatedOnDB: r.updatedOnDB,
                    createdUser: r.createdUser,
                    casestatus: r.caseStatus || '',
                        status:r.status || '',
                    riskScore: r.customerType === 'I'
                        ? r.individual_final_risk_score || ''
                        : r.corporate_final_risk_score || '',
                    riskSum: r.customerType === 'I'
                        ? r.individual_final_risk_sum || ''
                        : r.corporate_final_risk_sum || '',
                    riskOverride: r.customerType === 'I'
                        ? r.individual_Risk_Override || ''
                        : r.corporate_Risk_Override || '',
                    type: r.type || r.Type || '',
                    isDuplicate: r.isDuplicate || 0,
                    replaceFlag:r.replaceFlag || 0,
                    version:r.version || 0
                }));
                /* -----------------------------
                   ⭐ FRONTEND FILTER FOR High(O)
                ----------------------------- */
                    // let selectedRisk = $('#riskScore option:selected').text().trim();
                    // console.log(selectedRisk);
                    // if (selectedRisk === "High(O)") {
                    //     filteredCases = filteredCases.filter(x =>
                    //         x.riskScore?.toLowerCase().includes("high") &&
                    //         x.riskOverride?.toLowerCase() === "override"
                    //     );
                    // }
                totalRecords = res.recordsFiltered || 0;
                currentPage = page;
                applyColumnFilters();
                draw++;
            },
            complete: function () {
                $('#loadingCaseDetails').addClass('hidden');
            },
            error: function () {
                alert('Error loading data');
            }
        });
    }
        function formatDate(value) {
        if (!value) return null;
        // ✅ Already in yyyy-MM-dd
        if (value.includes('-') && value.split('-')[0].length === 4) {
            return value;
        }
        // ✅ Convert dd/MM/yyyy → yyyy-MM-dd
        if (value.includes('/')) {
            let parts = value.split('/');
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }
        return null;
    }
    
