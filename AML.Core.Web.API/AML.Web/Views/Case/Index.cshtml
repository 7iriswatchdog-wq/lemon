                else if (input.id === "caseStatus") {
                    input.value = "10";
                }
                else if (["screeningScore","caseStatusChange","riskScore"].includes(input.id)) {
                    input.value = "";
                }
                else {
                    input.value = "";
                }
            });
        });
        // Show selected field
        if (selectedValue) {
            document.getElementById(selectedValue + "Field").classList.remove("hidden");
        }
    }
    
    function getStatusBadge(status) {
        let styles = "";
        switch ((status || '').toLowerCase()) {
            case 'Approved': styles = "bg-blue-50 text-primary border-blue-100"; break;
            case 'onhold': styles = "bg-orange-500 text-white border-orange-600"; break;
            case 'waitlist': styles = "bg-indigo-600 text-white border-indigo-700"; break;
            case 'white': styles = "bg-indigo-600 text-white border-indigo-700"; break;
            case 'Rejected': styles = "bg-red-50 text-red-600 border-red-100"; break;
            case 'transferred': styles = "bg-green-50 text-green-600 border-green-100"; break;
            default: styles = "bg-appbg text-textmuted border-bordercolor";
        }
        return `<span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium ${styles}">${status || ''}</span>`;
    }
        function formatCaseStatus(statusText) {
        if (!statusText) return '';
        function getStatusClass(text) {
            const t = text.toLowerCase().trim();
            if (t.includes('pending')) return 'bg-yellow-100 text-yellow-800';
            if (t.includes('hold')) return 'bg-orange-500 text-white';
            if (t.includes('approved')) return 'bg-green-700 text-white';
            if (t.includes('white')) return 'bg-indigo-600 text-white';
            if (t.includes('wait')) return 'bg-indigo-600 text-white';
            if (t.includes('auto')) return 'bg-green-100 text-green-800';
            if (t.includes('transfer')) return 'bg-green-100 text-green-800';
            if (t.includes('rejected')) return 'bg-red-100 text-red-800';
            return 'bg-slate-100 text-textprimary';
        }
        // ✅ Corporate case
        if (statusText.includes('| Shareholders:')) {
            const [corpStatus, shInfo] = statusText.split('|');
            const total = shInfo.match(/Total\s(\d+)/)?.[1] || 0;
            const approved = shInfo.match(/Approved\s(\d+)/)?.[1] || 0;
            const auto = shInfo.match(/Auto\s(\d+)/)?.[1] || 0;
            const pending = shInfo.match(/Pending\s(\d+)/)?.[1] || 0;
            const rejected = shInfo.match(/Rejected\s(\d+)/)?.[1] || 0;
            const onhold = shInfo.match(/OnHold\s(\d+)/)?.[1] || 0;
            const whitelist = shInfo.match(/Whitelist\s(\d+)/)?.[1] || 0;
            const statusClass = getStatusClass(corpStatus);
            // ✅ Build tooltip dynamically (hide 0 values)
            const tooltipItems = [];
            if (+auto > 0) {
                tooltipItems.push(`<span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">A:${auto}</span>`);
            }
            if (+approved > 0) {
                tooltipItems.push(`<span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-green-700 text-white">AP:${approved}</span>`);
            }
            if (+pending > 0) {
                tooltipItems.push(`<span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">P:${pending}</span>`);
            }
            if (+rejected > 0) {
                tooltipItems.push(`<span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">R:${rejected}</span>`);
            }
            if (+onhold > 0) {
                tooltipItems.push(`<span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-orange-500 text-white">OH:${onhold}</span>`);
            }
            if (+whitelist > 0) {
                tooltipItems.push(`<span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-indigo-600 text-white">W:${whitelist}</span>`);
            }
            const showTooltip = tooltipItems.length > 0;
            return `
                <div class="space-y-1 text-left">
                    <div class="flex w-full items-center justify-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold ${statusClass}">
                        ${corpStatus.trim()}
                        ${showTooltip ? `
