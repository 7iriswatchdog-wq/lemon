        <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
    </div>
    <style>
        .dt-loader {
            position: relative;
            width: 80px;
            height: 20px;
        }
            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0,1,1,0);
            }
                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }
                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }
                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }
                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }
        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }
            100% {
                transform: scale(1);
            }
        }
        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(24px);
            }
        }
        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }
            100% {
                transform: scale(0);
            }
        }
        #caseDetailsTbl, #caseDetailsTbl th, #caseDetailsTbl td {
            border: none !important;
            border-radius: 0 !important;
        }
        th.sortable {
            cursor: pointer;
            position: relative;
            padding-right: 20px;
        }
            th.sortable::after {
                content: "▲\A▼";
                white-space: pre;
                font-size: 10px;
                position: absolute;
                right: 6px;
                top: 50%;
                transform: translateY(-50%);
                color: #bbb;
                line-height: 1;
                text-align: center;
            }
            th.sortable.active.asc::after {
                content: "▲";
                color: #000;
            }
            th.sortable.active.desc::after {
                content: '\A▼';
                color: #000;
            }

        /* Premium clickable row styles */
        #casesTableBody tr {
            cursor: pointer;
            transition: all .2s cubic-bezier(.25,.8,.25,1);
            position: relative;
        }
        #casesTableBody tr:hover {
            background: linear-gradient(90deg, #eff6ff 0%, #f8fafc 100%) !important;
            transform: translateX(3px);
            box-shadow: 0 2px 12px rgba(59,130,246,.08), inset 4px 0 0 #3b82f6;
        }
        #casesTableBody tr:hover td {
            color: #1e293b !important;
        }
        #casesTableBody tr:hover td:first-child {
            color: #3b82f6 !important;
            font-weight: 700;
        }
        /* Arrow indicator on hover */
        #casesTableBody tr .row-arrow {
            opacity: 0;
            transform: translateX(-8px);
            transition: all .2s ease;
            color: #3b82f6;
        }
        #casesTableBody tr:hover .row-arrow {
            opacity: 1;
            transform: translateX(0);
        }
        /* Active press effect */
        #casesTableBody tr:active {
            transform: translateX(1px) scale(.998);
            box-shadow: 0 1px 4px rgba(59,130,246,.06), inset 4px 0 0 #2563eb;
        }
    </style>
</head>
