    function getRiskScoreClass(riskScore) {
             const score = (riskScore || '').toLowerCase().trim();
        if (score.includes('low')) return 'text-green-500';
        if (score.includes('medium')) return 'text-yellow-400';
        if (score.includes('high')) return 'text-red-500';
        if (!score || score === 'unclassified') return 'text-slate-400';
            return 'text-black';
    }
      function formatDateTime(dateStr) {
        if (!dateStr) return { date: '-', time: '-' };
        const d = new Date(dateStr);
        return {
            date: d.toLocaleDateString('en-GB'), // 20/02/2026
            time: d.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',   // ✅ added
                hour12: true
            }) // 06:43:15 PM
        };
    }
   
