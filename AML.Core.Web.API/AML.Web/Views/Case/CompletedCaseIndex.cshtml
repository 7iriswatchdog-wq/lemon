    /* ---------------------- SEARCH TRIGGER ---------------------- */

    function searchCases() {
        loadCases(1);
    }

    /* ---------------------- Load Data From Backend ---------------------- */

    function loadCases(page = 1) {

        $('#loadingCaseDetails').removeClass('hidden');

        let searchValue = $('#searchInput').val() || '';

        $.ajax({
            url: '/case/completedcasescustompagination',
            type: 'POST',
            data: {
                draw: draw,
                start: (page - 1) * size,
                length: size,

                // ⭐ Search Value
                searchValue: searchValue,
                search: { value: searchValue },

                // ⭐ Filters
                    startDate: formatDate($('#startDate').val()),
                    endDate: formatDate($('#endDate').val()),
                cust_type: $('#customertype').val(),
                createdBy:$('#user').val(),
                matchScore:$('#screeningScore').val(),
                caseStatus:$('#caseStatus').val(),
                caseStatusChange:$('#caseStatusChange').val(),
                riskLevel:$('#riskScore').val()
            },

            success: function (res) {

                console.log(res);
                filteredCases = (res.data || []).map(r => ({
                    id: r.id,
                    customerId: r.customerId,
                    customerName: `${r.firstName || ''} ${r.middleName || ''} ${r.lastName || ''}`.trim(),
                    customerType: r.customerType === 'I'
                        ? 'Individual'
                        : r.customerType === 'C'
                            ? 'Corporate'
                            : r.customerType === 'S'
                                ? 'Shareholder'
                                : '',
                    cifNo: r.customerId,
                    caseChangeStatus: r.caseChangeStatus || '',
                    matchScore:r.matchScore || '',
                    createdOn: r.createdOn,
                    updatedOnDB:r.updatedOnDB,
                    createdUser:r.createdUser,
                    status: r.caseStatus || '',
                    riskScore: r.customerType === 'I'
                        ? r.individual_final_risk_score || ''
                        : r.corporate_final_risk_score || '',
                    riskSum: r.customerType === 'I'
                        ? r.individual_final_risk_sum || ''
                        : r.corporate_final_risk_sum || '',
                    riskOverride:r.customerType === 'I'
                                    ? r.individual_Risk_Override || ''
                                        : r.corporate_Risk_Override || '',
                    type:r.type || ''
                }));

                totalRecords = res.recordsFiltered || 0;
                currentPage = page;

                renderTable();
                updatePagination();

                draw++;
            },

            complete: function () {
                $('#loadingCaseDetails').addClass('hidden');
            },

            error: function () {
                alert('Error loading data');
            }
        });
    }

        function formatDate(value) {
            if (!value) return null;

            // ✅ Already in yyyy-MM-dd
            if (value.includes('-') && value.split('-')[0].length === 4) {
                return value;
            }

            // ✅ Convert dd/MM/yyyy → yyyy-MM-dd
            if (value.includes('/')) {
                let parts = value.split('/');
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }

            return null;
        }
    /* ---------------------- Render Table ---------------------- */

        function renderTable() {
        const tbody = document.getElementById('casesTableBody');

        if (!filteredCases.length) {
            tbody.innerHTML = `
            <tr>
                <td colspan="10" class="h-24 text-center">
                    <div class="text-slate-500">No results found.</div>
                </td>
            </tr>`;
            return;
        }

        tbody.innerHTML = filteredCases.map(caseItem => {
            const created = formatDateTime(caseItem.createdOn);
            const updated = formatDateTime(caseItem.updatedOnDB);

            // -------------------------------
            // Parse main and shareholder statuses
            // -------------------------------
            let baseStatus = "Pending"; // default
            let showRevert = false;

            if (caseItem.status) {
                const statusLower = caseItem.status.toLowerCase();

                // Main status check
                if (statusLower.startsWith("approved")) baseStatus = "Approved";
                else if (statusLower.startsWith("rejected")) baseStatus = "Rejected";
                else if (statusLower.startsWith("pending")) baseStatus = "Pending";
                else if (statusLower.startsWith("auto")) baseStatus = "Auto";

                // If main is approved/rejected → show Revert
                if (baseStatus === "Approved" || baseStatus === "Rejected") {
                    showRevert = true;
                }

                // Check shareholders if exist
                // Matches "Approved 1" or "Rejected 1" in the shareholders part
                const shareholderMatch = caseItem.status.match(/shareholders:\s*.*$/i);
                if (shareholderMatch) {
                    const shText = shareholderMatch[0].toLowerCase();
                    const approvedMatch = shText.match(/approved\s+(\d+)/i);
                    const rejectedMatch = shText.match(/rejected\s+(\d+)/i);
                    if ((approvedMatch && parseInt(approvedMatch[1]) > 0) ||
                        (rejectedMatch && parseInt(rejectedMatch[1]) > 0)) {
                        showRevert = true;
                    }
                }
            }

            let rowType = baseStatus.includes("Pending") ? 3 : 1;
            let buttonsHtml = "";

            const type = (caseItem.type || "").toLowerCase();
            let viewUrl =
                (type === "individual" || type === "corporate")
                    ? `/report/ViewIndividualCaseDetail?id=${caseItem.customerId}&type=${rowType}`
                    : `/report/ViewShareholderCaseDetails?id=${caseItem.customerId}&type=${rowType}`;

            let changeButton = "";
            if (showRevert) {
                const rollbackType =
                    caseItem.isWhiteListed === 'YES' ? 4 :
                    baseStatus === "Approved" ? 0 : 1;

                changeButton = `
                    <a onclick="rollbackCase('${caseItem.customerId}', '${rollbackType}'); return false;"
                       class="text-orange-600 font-bold text-xs hover:underline cursor-pointer">
                        Revert
                    </a>`;
            }

            // Buttons HTML
            buttonsHtml = `
                <div class="flex items-center gap-4">
                    <a href="${viewUrl}" class="text-blue-600 font-bold text-xs hover:underline">View</a>
                    ${changeButton}
                </div>
            `;

            return `
            <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50">
                <td class="px-2 py-4 font-medium text-slate-600">${caseItem.customerId}</td>
                <td class="px-2 py-4">
                    <div class="text-xs text-slate-700">
                        <div>${created?.date || '-'}</div>
                        <div class="ml-2">${created?.time ? created.time.replace(/\s?(AM|PM)/i, '') : ''}</div>
                    </div>
                </td>
                <td class="px-2 py-4">
                    ${updated ? `
                        <div class="text-xs text-slate-700">
                            <div>${updated?.date || '-'}</div>
                            <div class="ml-2">${updated?.time ? updated.time.replace(/\s?(AM|PM)/i, '') : ''}</div>
                        </div>` : ''}
                </td>
                <td class="px-2 py-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="${caseItem.customerType === 'Individual' ? 'user' : 'building-2'}" class="h-4 w-4 text-slate-400"></i>
                        ${caseItem.customerType}
                    </div>
                </td>
                <td class="px-2 py-4">${caseItem.customerName}</td>
                <td class="px-2 py-4">${caseItem.caseChangeStatus}</td>
                <td class="px-2 py-4 ${
                    caseItem.matchScore < 70 ? 'text-green-600 font-semibold' :
                    caseItem.matchScore < 85 ? 'text-orange-500 font-semibold' :
                    'text-red-600 font-semibold'
                }">${caseItem.matchScore}</td>
                            <td class="px-2 py-4">
                                <span class="font-bold ${
                                    getRiskScoreClass(caseItem.riskScore)
                                }">
                                    ${
                                    caseItem.riskScore
                                        ? (
                                            caseItem.riskScore.toLowerCase().includes("high") &&
                                            caseItem.riskOverride?.toLowerCase() === "override"
                                        )
                                            ? "High(O)"
                                            : caseItem.riskScore.replace(" Risk", "").replace("High (O)", "High(O)")
                                        : ""
                                }
                                </span>
                           </td>
                <td class="px-2 py-4">${caseItem.createdUser}</td>
                <td class="px-2 py-4">${formatCaseStatus(caseItem.status)}</td>
                <td class="px-4 py-3 text-center">${buttonsHtml}</td>
            </tr>`;
        }).join('');

        lucide.createIcons();
    }
        

