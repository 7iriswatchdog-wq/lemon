        function Colunmfilterfunction() {

        const selectedValue = document.getElementById("columnFilter").value;

        // const fields = [
        //     "CaseStatusChangeReasonField",
        //     "ScreeningScoreField",
        //     "UserField",
        //     "StatusField",
        //     "RiskLevelField"
        // ];

        const fields = [
            "ScreeningScoreField",
            "UserField",
            "StatusField",
            "RiskLevelField"
        ];

        // Hide and clear all fields
        fields.forEach(fieldId => {

            const field = document.getElementById(fieldId);

            field.classList.add("hidden");

            const inputs = field.querySelectorAll("input, select");

            inputs.forEach(input => {

                if (input.id === "user") {
                    input.value = "0";
                }
                else if (input.id === "caseStatus") {
                    input.value = "10";
                }
                else if (["screeningScore","caseStatusChange","riskScore"].includes(input.id)) {
                    input.value = "";
                }
                else {
                    input.value = "";
                }

            });

        });

        // Show selected field
        if (selectedValue) {
            document.getElementById(selectedValue + "Field").classList.remove("hidden");
        }
    }

    function getStatusBadge(status) {
        let styles = "";

        switch ((status || '').toLowerCase()) {
            case 'approved': styles = "bg-blue-50 text-blue-600 border-blue-100"; break;
            case 'onhold': styles = "bg-amber-50 text-amber-600 border-amber-100"; break;
            case 'rejected': styles = "bg-red-50 text-red-600 border-red-100"; break;
            case 'transferred': styles = "bg-green-50 text-green-600 border-green-100"; break;
            default: styles = "bg-slate-50 text-slate-500 border-slate-100";
        }

        return `<span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium ${styles}">${status || ''}</span>`;
    }

     function formatCaseStatus(statusText) {
        if (!statusText) return '';

        function getStatusClass(text) {
            const t = text.toLowerCase().trim();

            if (t.includes('pending')) return 'bg-yellow-100 text-yellow-800';
            if (t.includes('approved')) return 'bg-green-700 text-white';     // dark green
            if (t.includes('auto')) return 'bg-green-100 text-green-800'; 
            // if (t.includes('approved')) return 'bg-blue-100 text-blue-800';
            // //if (t.includes('auto')) return 'bg-blue-100 text-blue-800';
            // if (t.includes('auto')) return 'bg-orange-100 text-orange-800';
            if (t.includes('transfer')) return 'bg-green-100 text-green-800';
            if (t.includes('rejected')) return 'bg-red-100 text-red-800';

            return 'bg-slate-100 text-slate-800';
        }

        // Corporate case
        if (statusText.includes('| Shareholders:')) {

            const [corpStatus, shInfo] = statusText.split('|');

            const total = shInfo.match(/Total\s(\d+)/)?.[1] || 0;
            const approved = shInfo.match(/Approved\s(\d+)/)?.[1] || 0;
            const pending = shInfo.match(/Pending\s(\d+)/)?.[1] || 0;
            const rejected = shInfo.match(/Rejected\s(\d+)/)?.[1] || 0;

            const statusClass = getStatusClass(corpStatus);

            return `
                <div class="space-y-1 text-left">
                    <div class="flex w-full items-center justify-center px-3 py-1.5 rounded-full text-xs font-semibold ${statusClass}">
                        ${corpStatus.trim()}
                    <div class="relative group">
