    function rollbackCase(customerId, type) {
        rollbackCustomerId = customerId;
        rollbackType = type;

        $('#rollbackCustomerId').text(customerId);

        $('#rollbackModal')
            .removeClass('hidden')
            .addClass('flex');
    }

        function closeRollbackModal() {
        rollbackCustomerId = null;
        rollbackType = null;

        $('#rollbackModal')
            .addClass('hidden')
            .removeClass('flex');
    }
        $('#confirmRollbackBtn').on('click', function () {

        if (!rollbackCustomerId || rollbackType === null) return;

        $('#loadingCaseDetails').removeClass('hidden');

        $.ajax({
            type: "POST",
            url: "/Report/rollbackCase",
            data: {
                id: rollbackCustomerId,
                type: rollbackType
            },
            success: function () {
                console.log('Case rolled back successfully');
                closeRollbackModal();
                loadCases(currentPage); // stay on same page
            },
            error: function (err) {
                console.error('Rollback failed', err);
                closeRollbackModal();
            },
            complete: function () {
                $('#loadingCaseDetails').addClass('hidden');
            }
        });
    });

    

