        function resetFieldValues(){

        const fields = document.querySelectorAll("input, select");

        fields.forEach(field => {

            if (field.id === "user") {
                field.value = "0";
            }
            else if (field.id === "caseStatus") {
                field.value = "10";
            }
            else if (["screeningScore","caseStatusChange","riskScore"].includes(field.id)) {
                field.value = "";
            }

        });

    }
    function applyFilters() {
        alert("Filters Applied");
