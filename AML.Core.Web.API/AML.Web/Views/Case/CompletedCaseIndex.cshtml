            document.getElementById("user"),
            document.getElementById("caseStatus"),
            document.getElementById("riskScore")
        ];

        const applyBtn = document.getElementById("applyBtn");
        const exportBtn = document.getElementById("exportBtn");
            const searchBtn = document.getElementById("searchButton");

        let hasValue = false;

        fields.forEach(field => {
            if (!field) return;

            if (field.tagName === "SELECT") {
                if (field.value !== "" && field.value !== "0" && field.value !== "10") {
                    hasValue = true;
                }
            } else {
                if (field.value.trim() !== "") {
                    hasValue = true;
                }
            }
        });

        applyBtn.disabled = !hasValue;
        exportBtn.disabled = !hasValue;
                searchBtn.disabled = !hasValue;

        if (!hasValue) {
            applyBtn.classList.add("opacity-50","cursor-not-allowed");
            exportBtn.classList.add("opacity-50","cursor-not-allowed");
            searchBtn.classList.add("opacity-50","cursor-not-allowed");
        } else {
            applyBtn.classList.remove("opacity-50","cursor-not-allowed");
                exportBtn.classList.remove("opacity-50","cursor-not-allowed");
                    searchBtn.classList.remove("opacity-50","cursor-not-allowed");
        }
    }
        document.querySelectorAll("input, select").forEach(el => {
        el.addEventListener("change", checkFilterValues);
        el.addEventListener("input", checkFilterValues);
    });

        document.addEventListener("DOMContentLoaded", function () {

            function initDatePicker(selector, defaultDate, isEndDate = false) {
                return flatpickr(selector, {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d/m/Y",
                    defaultDate: defaultDate,
                    allowInput: true,

                    // ✅ Conditional logic
                    // ...(isEndDate
                    //     ? { minDate: "today" }   // End Date → no past dates
                    //     : { maxDate: "today" }   // Start Date → no future dates
                    // )
                });
            }

            // ✅ Start Date → 1 year back, max today
            const startPicker = initDatePicker("#startDate", new Date().fp_incr(-365));

            // ✅ End Date → today, min today
            const endPicker = initDatePicker("#endDate", new Date(), true);

        });
          </script>

