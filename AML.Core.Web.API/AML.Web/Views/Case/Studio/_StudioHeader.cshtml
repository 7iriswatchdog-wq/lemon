<div class="studio-header">
    <div class="header-title">Case Creation Studio</div>
    
    <div class="h-8 w-px bg-slate-200"></div>
    
    <div class="flex gap-3">
        <button class="btn-studio btn-studio-ghost" @@click="openBulkUpload()">
            <i data-lucide="file-up" class="w-4 h-4 text-emerald-500"></i> Bulk Upload
        </button>
        <button class="btn-studio btn-studio-ghost" @@click="openOCR()">
            <i data-lucide="scan" class="w-4 h-4 text-purple-500"></i> OCR Upload
        </button>
    </div>

    <!-- Fetch Searchbar -->
    <div class="relative flex-1 max-w-2xl mx-auto flex gap-3">
        <div class="relative flex-1 group">
            <input type="text" 
                   x-model="fetchQuery" 
                   @@input.debounce.400ms="searchFetch()" 
                   @@keyup.enter="if(fetchResults.length === 1 && !isHistoryMode) { confirmFetch(fetchQuery); fetchResults = []; }"
                   placeholder="Search existing customers..." 
                   class="cc-input h-11 pl-4 pr-4 bg-slate-50 focus:bg-white transition-all shadow-sm">

            <div class="absolute right-4 top-1/2 -translate-y-1/2 flex items-center gap-2" x-show="fetchQuery">
                <button @@click="fetchQuery = ''; fetchResults = []" class="p-1 hover:bg-slate-200 rounded-full text-slate-400 transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Results Dropdown -->
            <div x-show="fetchResults.length > 0" 
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-y-2 scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 @@click.away="fetchResults = []"
                 class="fetch-results-dropdown">
                <div class="p-4 bg-slate-50/50 border-b border-slate-100 flex items-center justify-between">
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]" x-text="isHistoryMode ? 'Recent Searches' : 'Search Results'"></span>
                    <!-- <span class="text-[10px] font-bold text-blue-500" x-show="!isHistoryMode">Press enter to fetch full hierarchy</span> -->
                    <i data-lucide="history" class="w-3 h-3 text-slate-300" x-show="isHistoryMode"></i>
                </div>
                <div class="custom-scrollbar max-h-[400px] overflow-y-auto">
                    <template x-for="item in fetchResults" :key="item.Id || item.CIF || item.customerId">
                        <div @@click="addExistingEntity(item); fetchResults = []" 
                             class="p-4 hover:bg-blue-50 cursor-pointer border-b border-slate-50 flex items-center justify-between group transition-all">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 text-blue-500 flex items-center justify-center shadow-sm group-hover:scale-110 group-hover:border-blue-200 transition-all">
                                    <i data-lucide="user" class="w-6 h-6" x-show="((item.customerType || item.CustomerType || item.type || item.Type) !== 'C')"></i>
                                    <i data-lucide="building" class="w-6 h-6" x-show="((item.customerType || item.CustomerType || item.type || item.Type) === 'C')"></i>
                                </div>
                                <div>
                                    <div class="text-sm font-bold text-slate-800" x-text="getDisplayName(item)"></div>
                                    <div class="flex items-center gap-3 mt-1">
                                        <span class="text-xs text-slate-500 font-medium" x-text="getCaseID(item)"></span>
                                        <div class="w-1 h-1 rounded-full bg-slate-300"></div>
                                        <span class="text-xs text-slate-400" x-text="getDisplayNationality(item)"></span>
                                    </div>
                                </div>
                            </div>
                            <!-- <button class="btn-studio btn-studio-primary w-10 h-10 p-0 rounded-xl opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all flex items-center justify-center">
                                <i data-lucide="plus" class="w-5 h-5 text-white"></i>
                            </button> -->
                        </div>
                    </template>
                </div>
            </div>
        </div>
        <button class="btn-studio btn-studio-primary px-6 h-11" @@click="confirmFetch(fetchQuery)">
            <i data-lucide="search" class="w-4 h-4"></i> Fetch
        </button>
    </div>

    <!-- Drafts Management & Autosave Indicator -->
    <div class="flex items-center gap-3">
        <!-- Drafts Menu Button -->
        <button class="btn-studio btn-studio-ghost relative flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 shadow-sm transition-all"
                @@click="isDraftManagerOpen = true; loadDraftSummaries();">
            <i data-lucide="folders" class="w-4 h-4 text-blue-500"></i>
            <span>Drafts</span>
            <span class="flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-blue-50 border border-blue-200 text-[10px] font-black text-blue-600"
                  x-text="savedDrafts.length" x-show="savedDrafts.length > 0"></span>
        </button>

        <!-- Autosave Indicator -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-100 text-xs font-medium transition-all"
             x-show="treeNodes.length > 0"
             x-transition>
            <template x-if="isDraftSaving">
                <div class="flex items-center gap-2 text-amber-500 font-bold">
                    <div class="animate-spin h-3 w-3 border-2 border-amber-500/30 border-t-amber-500 rounded-full"></div>
                    <span x-text="'Saving ' + activeDraftName + '...'"></span>
                </div>
            </template>
            <!-- <template x-if="!isDraftSaving && lastDraftSaved">
                <div class="flex items-center gap-2 text-slate-600">
                    <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-500"></i>
                    <span class="font-bold text-slate-700" x-text="activeDraftName"></span>
                    <span class="text-slate-400" x-text="'(Saved ' + lastDraftSaved + ')'"></span>
                </div>
            </template> -->
        </div>
    </div>

    <button class="btn-studio btn-studio-primary px-8 h-11 min-w-[160px] flex items-center justify-center transition-all" 
            @@click="saveCase()"
            :disabled="isLoading || treeNodes.length === 0 || isLinking || isConnectMode"
            :class="{ 'opacity-50 cursor-not-allowed': isLoading || treeNodes.length === 0 || isLinking || isConnectMode }">
        <template x-if="!isLoading">
            <div class="flex items-center gap-2">
                Create Cases <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </div>
        </template>
        <template x-if="isLoading">
            <div class="flex items-center gap-2">
                <div class="animate-spin h-4 w-4 border-2 border-white/30 border-t-white rounded-full"></div>
                <span>Processing...</span>
            </div>
        </template>
    </button>
</div>
