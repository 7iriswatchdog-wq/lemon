<div id="studio-canvas" @@dragover.prevent @@drop="handleDrop($event)" class="flex-1"></div>
<div id="marquee-rect" class="selection-rect"></div>
<div id="selection-box" class="selection-bounding-box"></div>

<!-- Connection Preview Line -->
<svg x-show="isLinking" class="absolute inset-0 pointer-events-none z-[1000]" style="width: 100%; height: 100%;">
    <line :x1="linkSourcePos.x" :y1="linkSourcePos.y" :x2="linkMousePos.x" :y2="linkMousePos.y" 
          stroke="#3B82F6" stroke-width="2" stroke-dasharray="6,4" />
    <circle :cx="linkMousePos.x" :cy="linkMousePos.y" r="5" fill="#3B82F6" class="animate-pulse" />
</svg>

<!-- Overlays -->
<div x-show="hoveredNodeId && activeTool !== 'connect'" class="quick-actions" :style="`left: ${nodeMenuPos.x}px; top: ${nodeMenuPos.y}px;`" @@mouseenter="clearTimeout(hoverTimer)" @@mouseleave="hoveredNodeId = null">
    <button class="action-btn !p-1" @@click="quickAdd('C', hoveredNodeId)" title="Add Corporate Shareholder">
        <div class="avatar-short shadow-sm corp !w-6 !h-6 !text-[7px] !border-[1.5px]" style="border-radius: 6px;">CSH</div>
    </button>
    <button class="action-btn !p-1" @@click="quickAdd('I', hoveredNodeId)" title="Add Individual Shareholder">
        <div class="avatar-short shadow-sm !w-6 !h-6 !text-[7px] !border-[1.5px]" style="border-radius: 6px;">ISH</div>
    </button>
    <div class="w-px h-3 bg-slate-200 self-center mx-1"></div>
    <button class="action-btn text-blue-600" @@click="startConnection(hoveredNodeId)" title="Link Entity"><i data-lucide="git-branch-plus" class="w-3.5 h-3.5"></i></button>
    <button class="action-btn text-amber-500" @@click="checkDuplicates(hoveredNodeId)" title="Check Duplicates">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 28 24" stroke="currentColor" stroke-width="2">
            <circle cx="8" cy="10" r="4"></circle>
            <line x1="11" y1="13" x2="13.5" y2="15.5" stroke-linecap="round"></line>
            <circle cx="18" cy="10" r="4"></circle>
            <line x1="21" y1="13" x2="23.5" y2="15.5" stroke-linecap="round"></line>
        </svg>
    </button>
    <div class="w-px h-3 bg-slate-200 self-center mx-1"></div>
    <button class="action-btn text-red-500" @@click="deleteHoveredNode()" title="Delete Entity"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
</div>

<div x-show="selectedEdgeId" class="quick-actions !p-2 flex flex-col gap-2" :style="`left: ${edgeMenuPos.x}px; top: ${edgeMenuPos.y}px; min-width: 180px;`" @@click.away="selectedEdgeId = null">
    <div class="px-1 text-[10px] font-black uppercase text-slate-400 border-b border-slate-100 pb-1 flex justify-between items-center">
        <span>Connection</span>
        <div class="flex gap-1">
            <button class="text-blue-600 hover:bg-blue-50 p-1 rounded" @@click="reconnectEdge()" title="Move / Reconnect"><i data-lucide="move" class="w-3.5 h-3.5"></i></button>
            <button class="text-red-500 hover:bg-red-50 p-1 rounded" @@click="deleteSelectedEdge()" title="Delete Connection"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
        </div>
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-[10px] font-bold text-slate-500">Relationship Type</label>
        <select class="w-full h-8 bg-slate-50 border border-slate-200 rounded-lg px-2 text-[11px] font-medium outline-none focus:ring-2 focus:ring-blue-500/20"
                x-model="activeEdgeRelationship" @@change="updateEdgeRelationship($event.target.value)">
            <option value="individual_shareholder" x-show="activeEdgeToType === 'I'">Individual Shareholder (ISH)</option>
            <option value="corporate_shareholder" x-show="activeEdgeToType === 'C'">Corporate Shareholder (CSH)</option>
            <option value="related_individual_shareholder" x-show="activeEdgeToType === 'I'">Individual Related Party (IRP)</option>
            <option value="related_corporate_shareholder" x-show="activeEdgeToType === 'C'">Corporate Related Party (CRP)</option>
            <option value="authorized_signatory" x-show="activeEdgeToType === 'I'">Authorized Signatory (AS)</option>
            <option value="senior_management" x-show="activeEdgeToType === 'I'">Senior Management (SM)</option>
        </select>
    </div>
</div>

<!-- Grouping Menu (Selection only) -->
<div id="selection-menu" 
     x-show="selectedNodes.length > 1" 
     class="quick-actions fixed transform -translate-x-1/2 z-[2000]">
    <div class="px-3 py-1 text-[10px] font-black uppercase text-slate-400 border-b border-slate-50 flex items-center justify-between gap-4">
        <span>Selection</span>
        <span class="bg-blue-100 text-blue-600 px-1.5 rounded-full" x-text="selectedNodes.length"></span>
    </div>
    <div class="flex items-center">
        <button class="action-btn text-blue-600" @@click="groupEntities()" title="Create Group"><i data-lucide="layers" class="w-4 h-4"></i></button>
        <div class="w-px h-4 bg-slate-100 mx-1"></div>
        <button class="action-btn text-red-500" @@click="deleteGroupNodes()" title="Delete Selection"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
    </div>
</div>

</template>


