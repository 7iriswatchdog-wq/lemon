<div id="studio-sheet" :class="{ 'open': showSheet }" x-init="$watch('showSheet', value => { if(value) $nextTick(() => lucide.createIcons()); })">
    <!-- Header -->
    <div class="p-3 border-b flex justify-between items-center bg-white sticky top-0 z-[1010]">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm border transition-all duration-500"
                 :class="formData.isBulkMode ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : (formData.isOCRMode ? 'bg-purple-50 text-purple-600 border-purple-100' : 'bg-blue-50 text-blue-600 border-blue-100')">
                <i :data-lucide="formData.isBulkMode ? 'file-up' : (formData.isOCRMode ? 'scan' : getIconForType(selectedNode))" class="w-4.5 h-4.5"></i>
            </div>
            <div>
                <h3 class="text-[15px] font-extrabold m-0 text-slate-800 tracking-tight" 
                    x-text="formData.isBulkMode ? 'Bulk Entity Import' : (formData.isOCRMode ? 'Document OCR Extraction' : (formData.name || selectedNode?.label || 'Entity Details'))"></h3>
            </div>
        </div>
        
        <div class="flex items-center gap-2">
            <!-- Action Icons Grouped Near Close -->
            <div class="flex items-center gap-1.5 mr-2" x-show="!formData.isBulkMode && !formData.isOCRMode">
                <!-- Type Converter Toggle -->
                <div x-show="selectedNode && !selectedNode.isRoot && (formData.relationship.includes('shareholder'))" 
                     class="flex p-1 bg-slate-100 rounded-xl border border-slate-200 shadow-inner mr-1 items-center">
                    <button @@click="if(formData.type !== 'I') switchNodeType()" 
                            :class="formData.type === 'I' ? 'bg-white shadow-sm text-blue-600' : 'text-slate-400 hover:text-slate-600'"
                            class="w-7 h-6 rounded-lg text-[9px] font-black uppercase tracking-wider transition-all flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
                            title="Individual" :disabled="isReadOnly">
                        <i data-lucide="user" class="w-3.5 h-3.5"></i>
                    </button>
                    <button @@click="if(formData.type !== 'C') switchNodeType()" 
                            :class="formData.type === 'C' ? 'bg-white shadow-sm text-blue-600' : 'text-slate-400 hover:text-slate-600'"
                            class="w-7 h-6 rounded-lg text-[9px] font-black uppercase tracking-wider transition-all flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
                            title="Corporate" :disabled="isReadOnly">
                        <i data-lucide="building" class="w-3.5 h-3.5"></i>
                    </button>
                </div>

                <!-- Status Badges -->
                <div class="flex items-center gap-2">
                    <!-- Case ID Badge -->
                    <div x-show="formData.caseId && !formData.caseId.startsWith('S_')" 
                         class="h-9 px-3 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center shadow-sm"
                         title="Case Reference ID">
                        <span class="text-[11px] font-black text-blue-700 tracking-tighter" x-text="formData.caseId"></span>
                    </div>

                    <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shadow-sm"
                         :title="formData.shareholderType || getTypeLabel(formData.type)">
                         <i :data-lucide="formData.type === 'I' ? 'user' : 'building-2'" class="w-5 h-5"></i>
                    </div>

                    <div x-show="selectedNode?.isRoot" 
                         class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-sm border border-blue-500/50"
                         title="Main Entity">
                         <i data-lucide="crown" class="w-5 h-5"></i>
                    </div>

                    <div x-show="selectedNode?.isDuplicate" 
                         class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center shadow-sm border border-amber-400/50"
                         title="Duplicate Found">
                         <i data-lucide="copy" class="w-5 h-5"></i>
                    </div>

                    <div x-show="isReadOnly"
                          class="w-9 h-9 rounded-xl bg-rose-500 text-white flex items-center justify-center shadow-sm"
                          title="Read-Only Mode">
                        <i data-lucide="lock" class="w-5 h-5"></i>
                    </div>

                    <!-- Multi-Group Badges (Compact) -->
                    <template x-if="formData.groupId && (Array.isArray(formData.groupId) ? formData.groupId.length > 0 : true) && getCompactGroupRange(formData.groupId) !== ''">
                        <div class="h-9 px-3 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center shadow-sm cursor-default group"
                             :title="'Groups: ' + (Array.isArray(formData.groupId) ? formData.groupId.map(gid => groups.find(g => g.id === gid)?.label).join(', ') : (groups.find(g => g.id === formData.groupId)?.label || ''))">
                            <i data-lucide="layers-3" class="w-3.5 h-3.5 text-emerald-600 mr-1.5 transition-transform"></i>
                            <span class="text-[10px] font-black text-emerald-700 tracking-tighter" x-text="getCompactGroupRange(formData.groupId)"></span>
                        </div>
                    </template>

                    <!-- Promote Action -->
                    <button x-show="selectedNode && !selectedNode.isRoot" 
                            @@click="promoteNode(selectedNode.id)" 
                            class="w-9 h-9 rounded-xl bg-indigo-500 text-white flex items-center justify-center shadow-sm hover:bg-indigo-600 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                            title="Promote to Main Entity" :disabled="isReadOnly">
                        <i data-lucide="arrow-up" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <button @@click="closeSheet()" class="btn-studio btn-studio-ghost w-9 h-9 p-0 rounded-xl transition-all hover:bg-slate-100 active:scale-95 group">
                <i data-lucide="x" class="w-4 h-4 group-hover:rotate-90 transition-transform duration-300"></i>
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="px-4 border-b flex gap-4 bg-slate-50/40 sticky top-[73px] z-[1005]" x-show="!formData.isBulkMode && !formData.isOCRMode">
        <template x-for="tab in [
            { id: 'identity', label: 'Identity', icon: 'fingerprint' },
            { id: 'attachments', label: 'Attachments', icon: 'paperclip' },
            { id: 'groups', label: 'Groups', icon: 'layout-grid' },
            { id: 'relations', label: 'Relations', icon: 'git-branch' }
        ]">
            <button @@click="activeTab = tab.id" 
                    :class="activeTab === tab.id ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-400 hover:text-slate-600'"
                    class="py-2 border-b-2 font-bold text-[10px] uppercase tracking-wider flex items-center gap-2 transition-all">
                <i :data-lucide="tab.icon" class="w-3.5 h-3.5"></i>
                <span x-text="tab.label"></span>
            </button>
        </template>
    </div>

    <div x-ref="propertySheet" class="flex-1 overflow-y-auto custom-scrollbar bg-white">
        <div class="p-4 space-y-4">
        <!-- Identity Section -->
        <fieldset :disabled="isReadOnly" class="border-none p-0">
        <div x-show="!formData.isBulkMode && !formData.isOCRMode && activeTab === 'identity'" class="space-y-4">
            <!-- Warning Box -->
            <!-- <div class="mx-2 mt-1 p-3 bg-amber-50 border border-amber-100 rounded-xl flex items-center gap-2.5 shadow-sm">
                <div class="w-6 h-6 rounded-full bg-white flex items-center justify-center text-amber-500 shadow-sm border border-amber-50">
                    <i data-lucide="info" class="w-3 h-3"></i>
                </div>
                <p class="text-[11px] font-bold text-amber-800 m-0">Fields marked with <span class="text-rose-500">*</span> are mandatory</p>
            </div> -->

            <!-- Unified Related Party Role Toggle -->
            <!-- <div x-show="selectedNode && !selectedNode.isRoot" class="px-4 animate-in fade-in slide-in-from-top-2 duration-500">
                <div class="relative" x-data="{ open: false }">
                    <button type="button" @@click="open = !open" @@click.outside="open = false"
                            class="w-full h-11 px-4 bg-[#F8FAFC] border border-slate-200 rounded-xl flex items-center justify-between group hover:border-blue-400 hover:bg-white transition-all shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(37,99,235,0.4)]"></div>
                            <div class="flex flex-col items-start">
                                <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1">Relationship</span>
                                <span class="text-[13px] font-extrabold text-slate-800" x-text="getRelationshipLabel(formData.relationship)"></span>
                            </div>
                        </div>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-all duration-300" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" 
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="absolute z-[2000] w-full mt-2 bg-white border border-slate-200 rounded-xl shadow-2xl overflow-hidden py-1">
                        <template x-for="role in RelatedPartyRoles">
                            <button type="button" 
                                    @@click="setRelatedPartyRole(role.id); open = false"
                                    class="w-full px-4 py-2.5 text-left hover:bg-blue-50/80 transition-all flex items-center justify-between group border-b border-slate-50 last:border-0"
                                    :class="formData.relationship === role.id ? 'bg-blue-50/50' : ''">
                                <div class="flex items-center gap-3">
                                    <div class="w-1.5 h-1.5 rounded-full transition-all duration-300" :class="formData.relationship === role.id ? 'bg-blue-600 scale-125 shadow-[0_0_8px_rgba(37,99,235,0.4)]' : 'bg-slate-200 group-hover:bg-blue-400'"></div>
                                    <span class="text-[12px] font-extrabold" :class="formData.relationship === role.id ? 'text-blue-700' : 'text-slate-600 group-hover:text-blue-700'" x-text="role.label"></span>
                                </div>
                                <i x-show="formData.relationship === role.id" data-lucide="check" class="w-3.5 h-3.5 text-blue-600"></i>
                            </button>
                        </template>
                    </div>
                </div>
            </div> -->

            <!-- Role-Based Dynamic Forms -->
            <div class="px-4 pb-4">
                <!-- Root Entities (Main) or Fetched or Nodes with Children -->
                <div x-show="shouldShowMainForm(selectedNode)">
                    <div x-show="formData.type === 'I' || (formData.type !== 'C' && formData.type !== 'Corporate')">
                        <partial name="Studio/Forms/_MainIndividual" />
                    </div>
                    <div x-show="formData.type === 'C' || formData.type === 'Corporate'">
                        <partial name="Studio/Forms/_MainCorporate" />
                    </div>
                </div>

                <!-- Related Parties (Non-Root, Non-Fetched, No Children) -->
                <div x-show="!shouldShowMainForm(selectedNode) && formData.relationship !== 'root'">
                    <!-- Individual Related Parties -->
                    <div x-show="formData.relationship === 'related_individual_shareholder'">
                        <partial name="Studio/Forms/_IndividualRelatedParty" />
                    </div>
                    
                    <!-- Corporate Related Parties -->
                    <div x-show="formData.relationship === 'related_corporate_shareholder'">
                        <partial name="Studio/Forms/_CorporateRelatedParty" />
                    </div>

                    <!-- Individual Shareholder (Catch-all for individuals) -->
                    <div x-show="formData.relationship === 'individual_shareholder' || (formData.type === 'I' && !['related_individual_shareholder', 'authorized_signatory', 'senior_management'].includes(formData.relationship))">
                        <partial name="Studio/Forms/_IndividualShareholder" />
                    </div>

                    <!-- Corporate Shareholder (Catch-all for corporates) -->
                    <div x-show="formData.relationship === 'corporate_shareholder' || (formData.type === 'C' && !['related_corporate_shareholder'].includes(formData.relationship))">
                        <partial name="Studio/Forms/_CorporateShareholder" />
                    </div>

                    <!-- Authorized Signatory -->
                    <div x-show="formData.relationship === 'authorized_signatory'">
                        <partial name="Studio/Forms/_AuthorizedSignatory" />
                    </div>

                    <!-- Senior Management -->
                    <div x-show="formData.relationship === 'senior_management'">
                        <partial name="Studio/Forms/_SeniorManagement" />
                    </div>
                </div>
            </div>
        <!-- Identity Section End -->
        </div>
        </fieldset>
        <div x-show="activeTab === 'attachments'" class="animate-in fade-in duration-300">
            <div class="px-4 space-y-4">
                <!-- Upload Zone (Hidden in Read-Only) -->
                <fieldset :disabled="isReadOnly" class="border-none p-0">
                <div x-show="!isReadOnly" 
                     class="p-4 bg-slate-50 border-2 border-dashed border-slate-200 rounded-xl flex flex-col items-center justify-center gap-2 group hover:border-blue-400 hover:bg-blue-50 transition-all cursor-pointer relative"
                     @@click="$refs.fileInput.click()">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm group-hover:scale-110 transition-all">
                        <i data-lucide="upload-cloud" class="w-5 h-5 text-slate-400 group-hover:text-blue-600"></i>
                    </div>
                    <div class="text-center">
                        <p class="text-[12px] font-bold text-slate-700">Drop files here or click</p>
                        <p class="text-[10px] text-slate-400">PDF, PNG, JPG (Max 10MB)</p>
                    </div>
                </div>
                </fieldset>

                <!-- Empty State for Read-Only -->
                <div x-show="isReadOnly && formData.attachments.length === 0" 
                     class="py-12 flex flex-col items-center justify-center text-center opacity-40">
                    <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                        <i data-lucide="paperclip" class="w-8 h-8 text-slate-400"></i>
                    </div>
                    <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">No Attachments</p>
                    <p class="text-[10px] font-bold text-slate-400 mt-1">This entity has no files uploaded.</p>
                </div>

                <div class="space-y-2">
                    <template x-for="(file, index) in formData.attachments" :key="index">
                        <div class="flex items-center justify-between p-2.5 bg-white border border-slate-100 rounded-lg hover:border-slate-200 transition-all group">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-slate-50 rounded-md flex items-center justify-center">
                                    <i data-lucide="file-text" class="w-4 h-4 text-slate-400"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-[12px] font-bold text-slate-700 truncate max-w-[150px]" x-text="file.name || file.Name"></p>
                                    <p class="text-[10px] text-slate-400" x-text="formatSize(file.size || file.Size)"></p>
                                </div>
                            </div>
                            
                            <div class="flex items-center gap-1">
                                <!-- Actions for Read-Only -->
                                <template x-if="isReadOnly">
                                    <div class="flex items-center gap-1">
                                        <button type="button" @@click="viewFile(file)" 
                                                class="p-1.5 text-blue-500 hover:bg-blue-50 rounded-md transition-all" title="View">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </button>
                                        <button type="button" @@click="downloadFile(file)" 
                                                class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-md transition-all" title="Download">
                                            <i data-lucide="download" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </template>
                                
                                <!-- Remove button for Edit Mode -->
                                <template x-if="!isReadOnly">
                                    <button type="button" @@click="removeAttachment(index)" 
                                            class="p-1.5 text-slate-400 hover:text-rose-500 hover:bg-rose-50 rounded-md transition-all">
                                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
                <input type="file" x-ref="fileInput" class="hidden" multiple @@change="handleFileUpload($event)">
            </div>
        </div>

        <!-- Groups Tab -->
        <div x-show="activeTab === 'groups' && !formData.isBulkMode && !formData.isOCRMode" 
             class="animate-in fade-in duration-300"
             x-init="$watch('activeTab', value => { if(value === 'groups') $nextTick(() => lucide.createIcons()) })">
            <div class="px-4">

                <!-- Empty state -->
                <template x-if="!formData.groupId || (Array.isArray(formData.groupId) ? formData.groupId.length === 0 : false)">
                    <div class="py-10 flex flex-col items-center text-center opacity-50">
                        <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mb-3">
                            <i data-lucide="layers-3" class="w-6 h-6 text-slate-300"></i>
                        </div>
                        <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">No Groups</p>
                        <p class="text-[10px] font-bold text-slate-400 mt-1">This entity is not part of any group</p>
                    </div>
                </template>

                <!-- Group membership cards -->
                <template x-if="formData.groupId && (Array.isArray(formData.groupId) ? formData.groupId.length > 0 : !!formData.groupId)">
                    <div class="space-y-2">
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Member of</p>
                        <template x-for="gid in (Array.isArray(formData.groupId) ? formData.groupId : [formData.groupId])" :key="gid">
                            <div x-data="{ group: groups.find(g => g.id === gid) }" x-show="group">
                                <div class="flex items-center justify-between p-3 rounded-xl border border-emerald-100 bg-emerald-50/30 hover:border-emerald-200 transition-all">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center">
                                            <span class="text-[10px] font-black text-emerald-700" x-text="'G' + (groups.findIndex(g => g.id === gid) + 1)"></span>
                                        </div>
                                        <div>
                                            <p class="text-[12px] font-black text-slate-700" x-text="group?.label"></p>
                                            <p class="text-[9px] text-slate-400 font-bold uppercase" 
                                               x-text="(group?.nodeIds?.length || 0) + ' members · ' + (group?.risk || 'Unclassified')"></p>
                                        </div>
                                    </div>
                                    <button @@click="openGroupSettings(gid)"
                                            class="w-8 h-8 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-400 hover:text-blue-600 hover:border-blue-200 transition-all"
                                            title="Open Group Settings">
                                        <i data-lucide="settings-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>

                <!-- All available groups (membership toggles) -->
                <div x-show="groups.length > 0">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2 mt-4">All Canvas Groups</p>
                    <div class="space-y-1.5">
                        <template x-for="group in groups" :key="group.id">
                            <label class="flex items-center justify-between px-3 py-2.5 rounded-xl border border-slate-100 hover:border-blue-200 hover:bg-blue-50/20 transition-all cursor-pointer">
                                <div class="flex items-center gap-3">
                                    <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center">
                                        <span class="text-[9px] font-black text-slate-600" x-text="'G' + (groups.findIndex(g => g.id === group.id) + 1)"></span>
                                    </div>
                                    <div>
                                        <p class="text-[11px] font-bold text-slate-700" x-text="group.label"></p>
                                        <p class="text-[9px] text-slate-400 font-bold uppercase" x-text="group.nodeIds.length + ' members'"></p>
                                    </div>
                                </div>
                                <div class="relative inline-flex items-center">
                                    <input type="checkbox" 
                                           :checked="formData.groupId && (Array.isArray(formData.groupId) ? formData.groupId.includes(group.id) : formData.groupId === group.id)"
                                           @@change="toggleGroupMembership(group.id)"
                                           class="sr-only peer">
                                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                                </div>
                            </label>
                        </template>
                    </div>
                </div>

            </div>
        </div>

        <!-- Relations Tab -->
        <div x-show="activeTab === 'relations' && !formData.isBulkMode && !formData.isOCRMode" 
             class="animate-in fade-in duration-300"
             x-init="$watch('activeTab', value => { if(value === 'relations') $nextTick(() => lucide.createIcons()) })">
            <div class="px-4">
                <template x-if="!selectedNode || edges.get().filter(e => e.from.toString() === selectedNode.id.toString() || e.to.toString() === selectedNode.id.toString()).length === 0">
                    <div class="py-10 flex flex-col items-center text-center opacity-50">
                        <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mb-3">
                            <i data-lucide="git-branch" class="w-6 h-6 text-slate-300"></i>
                        </div>
                        <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">No Relations</p>
                        <p class="text-[10px] font-bold text-slate-400 mt-1">This entity has no active connections</p>
                    </div>
                </template>

                <template x-if="selectedNode && edges.get().filter(e => e.from.toString() === selectedNode.id.toString() || e.to.toString() === selectedNode.id.toString()).length > 0">
                    <div class="space-y-4 mt-2">
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Entity Relationships</p>
                        <template x-for="edge in edges.get().filter(e => e.from.toString() === selectedNode.id.toString() || e.to.toString() === selectedNode.id.toString())" :key="edge.id">
                            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-3">
                                <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="w-6 h-6 rounded bg-blue-100 text-blue-600 flex items-center justify-center text-[10px] font-black"
                                             x-text="edge.from.toString() === selectedNode.id.toString() ? 'OUT' : 'IN'"></div>
                                        <span class="text-[12px] font-bold text-slate-700" 
                                              x-text="nodes.get(edge.from.toString() === selectedNode.id.toString() ? edge.to : edge.from)?.label || 'Entity'"></span>
                                    </div>
                                    <button @@click="deleteSpecificEdge(edge.id)" class="text-rose-500 hover:bg-rose-50 p-1 rounded transition-all" title="Delete Connection">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="space-y-1" :class="{'col-span-2': !(edge.relationship === 'individual_shareholder' || edge.relationship === 'corporate_shareholder')}">
                                        <label class="text-[10px] font-bold text-slate-500">Relationship</label>
                                        <select class="w-full h-9 bg-white border border-slate-200 rounded-lg px-2 text-[11px] font-medium outline-none"
                                                x-model="edge.relationship" @@change="updateEdgeData(edge.id, { relationship: $event.target.value, label: getRelationshipShortform($event.target.value) })">
                                            <option value="individual_shareholder">Individual Shareholder (ISH)</option>
                                            <option value="corporate_shareholder">Corporate Shareholder (CSH)</option>
                                            <option value="related_individual_shareholder">Individual Related Party (IRP)</option>
                                            <option value="related_corporate_shareholder">Corporate Related Party (CRP)</option>
                                            <option value="authorized_signatory">Authorized Signatory (AS)</option>
                                            <option value="senior_management">Senior Management (SM)</option>
                                        </select>
                                    </div>
                                    <div class="space-y-1" x-show="edge.relationship === 'individual_shareholder' || edge.relationship === 'corporate_shareholder'">
                                        <label class="text-[10px] font-bold text-slate-500">Share %</label>
                                        <input type="number" class="w-full h-9 bg-white border border-slate-200 rounded-lg px-2 text-[11px] font-medium outline-none"
                                               x-model="edge.share" @@input="updateEdgeData(edge.id, { share: parseFloat($event.target.value) })" placeholder="e.g. 50">
                                    </div>
                                    <div class="space-y-1 col-span-2">
                                        <label class="text-[10px] font-bold text-slate-500">Designation</label>
                                        <input type="text" class="w-full h-9 bg-white border border-slate-200 rounded-lg px-2 text-[11px] font-medium outline-none"
                                               x-model="edge.designation" @@input="updateEdgeData(edge.id, { designation: $event.target.value })" placeholder="e.g. Director / CEO">
                                    </div>
                                    <div class="space-y-1 col-span-2">
                                        <label class="text-[10px] font-bold text-slate-500">Remarks</label>
                                        <input type="text" class="w-full h-9 bg-white border border-slate-200 rounded-lg px-2 text-[11px] font-medium outline-none"
                                               x-model="edge.remarks" @@input="updateEdgeData(edge.id, { remarks: $event.target.value })" placeholder="Enter remarks">
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>
            </div>
        </div>


        <!-- Bulk Section -->
        <fieldset :disabled="isReadOnly" class="border-none p-0">
        <div x-show="formData.isBulkMode" class="px-4 pb-4 animate-in fade-in duration-500">
            <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-lg flex items-center justify-center">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h4 class="text-[13px] font-bold text-slate-800">Batch Import</h4>
                        <p class="text-[11px] text-slate-500">Structured data template</p>
                    </div>
                </div>

                <div class="p-6 border-2 border-dashed border-slate-200 rounded-xl bg-white text-center space-y-2 hover:border-emerald-400 hover:bg-emerald-50/10 transition-all cursor-pointer group" 
                     @@click="$refs.bulkInput.click()">
                    <i data-lucide="upload" class="w-5 h-5 mx-auto text-slate-300 group-hover:text-emerald-500 mb-1"></i>
                    <p class="text-[11px] font-bold text-slate-600">Browse or Drag Template</p>
                    <p class="text-[9px] text-slate-400">.xlsx, .csv (Max 5MB)</p>
                    <input type="file" x-ref="bulkInput" class="hidden" @@change="handleBulkFileUpload($event)">
                </div>

                <div class="mt-4 pt-4 border-t border-slate-200 flex items-center justify-between">
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Template</span>
                    <a href="/Risk/DownloadCustomerUploadSample" class="text-[11px] font-bold text-blue-600 hover:underline flex items-center gap-1">
                        <i data-lucide="download" class="w-3 h-3"></i> Download
                    </a>
                </div>
            </div>
        </div>

        <!-- OCR Section -->
        <div x-show="formData.isOCRMode" class="px-4 pb-4 animate-in fade-in duration-500 space-y-4">
            <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-8 h-8 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center">
                        <i data-lucide="scan-eye" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h4 class="text-[13px] font-bold text-slate-800">Smart Extraction</h4>
                        <p class="text-[11px] text-slate-500">AI-powered entity detection</p>
                    </div>
                </div>

                <div class="flex gap-1.5 p-1 bg-slate-200/50 rounded-lg mb-4">
                    <button @@click="formData.type = 'I'" :class="formData.type === 'I' ? 'bg-white shadow-sm text-blue-600' : 'text-slate-500'" class="flex-1 py-1.5 rounded text-[10px] font-bold uppercase transition-all">IND</button>
                    <button @@click="formData.type = 'C'" :class="formData.type === 'C' ? 'bg-white shadow-sm text-blue-600' : 'text-slate-500'" class="flex-1 py-1.5 rounded text-[10px] font-bold uppercase transition-all">CORP</button>
                </div>

                <div class="p-6 border-2 border-dashed border-slate-200 rounded-xl bg-white text-center space-y-2 hover:border-purple-400 hover:bg-purple-50/10 transition-all cursor-pointer group"
                     @@click="$refs.ocrInput.click()">
                    <i data-lucide="scan" class="w-5 h-5 mx-auto text-slate-300 group-hover:text-purple-500 mb-1"></i>
                    <p class="text-[11px] font-bold text-slate-600" x-text="formData.type === 'I' ? 'Upload ID / Passport' : 'Upload Documents'"></p>
                    <p class="text-[9px] text-slate-400">AI will auto-extract fields</p>
                    <input type="file" x-ref="ocrInput" class="hidden" @@change="handleOCRUpload($event)">
                </div>
            </div>

            <div x-show="formData.ocrResults?.length > 0" class="space-y-2">
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Detected Entities</p>
                <div class="grid gap-2">
                    <template x-for="item in formData.ocrResults" :key="item.id">
                        <div class="p-3 bg-white border border-slate-200 rounded-lg flex items-center gap-3 hover:border-blue-300 transition-all group">
                            <div class="w-8 h-8 rounded bg-slate-50 text-slate-400 flex items-center justify-center">
                                <i :data-lucide="item.type === 'C' ? 'building' : 'user'" class="w-4 h-4"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-[12px] font-bold text-slate-800 truncate" x-text="item.name"></p>
                                <div class="flex items-center gap-2 mt-1">
                                    <div class="flex-1 h-1 bg-slate-100 rounded-full overflow-hidden">
                                        <div class="h-full bg-emerald-500" :style="'width: ' + item.confidence + '%'"></div>
                                    </div>
                                    <span class="text-[9px] font-bold text-slate-400 whitespace-nowrap" x-text="item.confidence + '%'"></span>
                                </div>
                            </div>
                            <button @@click="addOCRNode(item)" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition-all">
                                <i data-lucide="plus-circle" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </template>
                </div>
                
                <button class="w-full h-9 mt-2 bg-slate-800 text-white rounded-lg text-[11px] font-bold flex items-center justify-center gap-2 hover:bg-slate-900 transition-all" @@click="addAllOCR()">
                    <i data-lucide="layers" class="w-3.5 h-3.5"></i> Import All
                </button>
            </div>
        </div>
        </fieldset>
    </div>
    </div>

    <!-- Footer -->
    <div class="p-4 border-t bg-white/90 backdrop-blur-md sticky bottom-0 z-[1010] flex items-center gap-3">
        <template x-if="!isReadOnly">
            <div class="flex gap-3">
                <button class="btn-studio btn-studio-primary flex-1 h-10 text-[13px] tracking-tight shadow-md flex items-center justify-center gap-2" @@click="updateNode()">
                    <i data-lucide="check" class="w-4 h-4"></i> Save Details
                </button>
                <button class="btn-studio btn-studio-ghost text-rose-500 w-10 h-10 p-0 rounded-xl hover:bg-rose-50 hover:border-rose-100 flex items-center justify-center" @@click="deleteNode()" title="Delete Node">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </div>
        </template>
        <template x-if="isReadOnly">
            <div class="flex flex-1 gap-3">
                <button class="btn-studio btn-studio-primary flex-1 h-10 text-[13px] tracking-tight flex items-center justify-center gap-2 opacity-50 cursor-not-allowed" disabled>
                    <i data-lucide="lock" class="w-4 h-4"></i> Locked
                </button>
                <button class="btn-studio btn-studio-ghost text-slate-300 w-10 h-10 p-0 rounded-xl flex items-center justify-center cursor-not-allowed border border-slate-100" disabled title="Delete Node (Locked)">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </div>
        </template>
        
        <!-- Navigation Buttons (Scroll Up / Scroll Down) -->
        <div class="flex gap-2 border-l border-slate-200 pl-3">
            <button type="button" 
                    @@click="$refs.propertySheet.scrollBy({ top: -300, behavior: 'smooth' })" 
                    class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-slate-100 hover:text-slate-700 hover:border-slate-300 active:scale-95 transition-all"
                    title="Scroll Up">
                <i data-lucide="chevron-up" class="w-4.5 h-4.5"></i>
            </button>
            <button type="button" 
                    @@click="$refs.propertySheet.scrollBy({ top: 300, behavior: 'smooth' })" 
                    class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-slate-100 hover:text-slate-700 hover:border-slate-300 active:scale-95 transition-all"
                    title="Scroll Down">
                <i data-lucide="chevron-down" class="w-4.5 h-4.5"></i>
            </button>
        </div>
    </div>
</div>
