<div id="studio-sidebar">
    <div class="p-8 border-b border-slate-50 bg-slate-50/30">
        <div class="section-divider">Entity Tree</div>
        <div class="flex gap-2">
            <div class="relative flex-1 items-center">
                <input type="text" x-model="searchQuery" placeholder="Find nodes..." 
                       class="cc-input h-11 pl-12 text-xs shadow-sm bg-white">
            </div>
            <button class="btn-studio btn-studio-ghost w-11 h-11 p-0 flex items-center justify-center transition-all active:scale-95" @@click="applySearch()">
                <i data-lucide="search" class="w-6 h-6 text-slate-500"></i>
            </button>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto custom-scrollbar tree-view no-scrollbar">
        <template x-for="(node, index) in treeNodes" :key="node.treeKey || node.id">
            <div class="tree-item group cursor-pointer" 
                 draggable="true"
                 @@dragstart="dragStartTree($event, node.id)"
                 @@dragover.prevent="dragOverTree($event, node.id)"
                 @@dragleave="dragLeaveTree($event)"
                 @@drop="dropTree($event, node.id)"
                 :class="{ 
                    'active': selectedNodes.includes(node.id.toString()), 
                    'is-last-child': isLastChild(index),
                    'highlight-match': node.isMatch
                 }" 
                 :data-depth="node.depth"
                 @@click="centerNode(node.id, $event, false)">
                
                <!-- 1. Indentation Spacer -->
                <div class="flex-shrink-0" :style="`width: ${node.depth * 16}px`" x-show="node.depth > 0"></div>
                
                <!-- 2. Expansion Toggle (Fixed Width) -->
                <div class="w-8 flex-shrink-0 flex items-center justify-center cursor-pointer group/toggle" 
                     @@click.stop="toggleCollapse(node.id, $event)">
                    <template x-if="edges.get().some(e => e.from === node.id)">
                        <div class="w-5 h-5 rounded flex items-center justify-center hover:bg-slate-200 transition-colors">
                            <i :data-lucide="collapsedNodes.includes(node.id.toString()) ? 'chevron-right' : 'chevron-down'" 
                               class="w-3 h-3 text-slate-500"></i>
                        </div>
                    </template>
                </div>

                <!-- 3. Icon Container -->
                <div class="flex items-center gap-1.5 flex-shrink-0">
                    <!-- Main Entity Icon -->
                    <div x-show="node.depth === 0 && (node.isRoot || node.isMainEntity)"
                         class="w-8 h-8 rounded-lg flex items-center justify-center transition-all duration-300 bg-blue-50 text-blue-600 shadow-sm">
                        <i :data-lucide="getIconForType(node)" class="w-4 h-4"></i>
                    </div>
                    
                    <!-- Relationship Badge -->
                    <div x-show="node.depth > 0 && node.relationship && node.relationship !== 'root'"
                         class="w-8 h-8 rounded-lg flex items-center justify-center text-[9px] font-black border transition-all duration-300"
                         :class="getSidebarBadgeClass(node.relationship)">
                        <span x-text="getRelationshipShortform(node.relationship)"></span>
                    </div>
                </div>
                
                <!-- 4. Label & Type -->
                <div class="flex-1 flex flex-col min-w-0 ml-3">
                    <div class="flex items-center gap-2">
                        <span class="tree-item-label truncate font-black" x-text="node.name || node.label.split('\n')[0]" :title="node.name || node.label.split('\n')[0]"></span>
                    </div>
                    <div class="flex items-center gap-1.5 mt-1">
                        <span class="text-[9px] text-slate-400 font-bold uppercase tracking-tight truncate leading-none" 
                              x-text="node.displayTypeLabel || node.shareholderType || getTypeLabel(node.type)" :title="node.displayTypeLabel || node.shareholderType || getTypeLabel(node.type)"></span>
                        
                        <!-- Case ID Badge (Compact) -->
                        <span x-show="node.caseId" 
                              class="px-1.5 py-0.5 rounded bg-blue-50 text-[9px] font-black text-blue-600 border border-blue-100/50 truncate" 
                              x-text="node.caseId" :title="node.caseId"></span>
                    </div>
                    <!-- Multi-Group Indicators (Compact) -->
                    <template x-if="node.groupId && node.groupId.length > 0">
                        <span class="px-1.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-[9px] font-black border border-emerald-100 w-fit" 
                              x-text="getCompactGroupRange(node.groupId)"></span>
                    </template>
                </div>

                <!-- 5. Actions & Drag Handle -->
                <div class="flex items-center gap-1 pr-2 opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 mr-1" x-show="node.isScreened" title="Screened"></div>
                    <div class="w-2 h-2 rounded-full bg-amber-500 mr-1" x-show="node.isDuplicate" title="Duplicate Found"></div>
                    
                    <button class="w-7 h-7 flex items-center justify-center rounded-md hover:bg-slate-100 text-slate-400">
                        <i data-lucide="grip-vertical" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            </div>
        </template>
        
        <div x-show="treeNodes.length === 0" class="flex flex-col items-center justify-center py-20 px-8 text-center opacity-40">
            <i data-lucide="layout-template" class="w-12 h-12 mb-4"></i>
            <div class="text-xs font-black uppercase tracking-widest">No nodes found</div>
            <div class="text-[10px] font-bold mt-2">Start by adding a node from the toolbar</div>
        </div>
    </div>
</div>
