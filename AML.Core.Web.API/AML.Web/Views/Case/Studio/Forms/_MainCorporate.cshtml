<div class="space-y-4">
    <div class="grid grid-cols-3 gap-4">
        <!-- Company Full Name Row -->
        <div class="col-span-3">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Company Full Name <span class="text-rose-500">*</span></label>
            <div class="flex gap-2 mt-1">
                <input type="text" class="h-11 flex-1 bg-white border border-slate-200 rounded-xl px-4 text-[13px] font-medium outline-none focus:ring-2 focus:ring-blue-500/10 focus:border-blue-500 transition-all" 
                       :class="{ 'border-rose-500': errors.includes('name') }" 
                       x-model="formData.name" @@input="updateActiveNodeLabel()" placeholder="Enter full name">
                <button type="button" @@click="checkDuplicates(selectedNode.id)" 
                        class="w-11 h-11 bg-slate-900 text-white rounded-xl flex items-center justify-center hover:bg-black transition-all active:scale-95 shadow-sm border border-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 28 24" stroke="currentColor" stroke-width="2">
                    <circle cx="8" cy="10" r="4"></circle>
                    <line x1="11" y1="13" x2="13.5" y2="15.5" stroke-linecap="round"></line>
                    <circle cx="18" cy="10" r="4"></circle>
                    <line x1="21" y1="13" x2="23.5" y2="15.5" stroke-linecap="round"></line>
                </svg>
                </button>
            </div>
        </div>

        <!-- Incorporation, Residence, Trade License No -->
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Country of Incorporation <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('nationality') }"
                    x-model="formData.nationality">
                <option value="">--Select Country--</option>
                <template x-for="nat in studioLists.Nationalities">
                    <option :value="nat.Value || nat.value" x-text="nat.Text || nat.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Residence <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('residence') }"
                    x-model="formData.residence">
                <option value="">--Select Country--</option>
                <template x-for="nat in studioLists.Nationalities">
                    <option :value="nat.Value || nat.value" x-text="nat.Text || nat.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Trade Licence Number</label>
            <input type="text" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] font-medium outline-none transition-all" x-model="formData.tradeLicence" placeholder="Enter Trade Licence Number">
        </div>

        <!-- Trade License Authority, Reg Date, Expiry Date -->
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Trade Licence Authority</label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" x-model="formData.tradeLicenseAuthority">
                <option value="">Select</option>
                <template x-for="item in studioLists.TradeLicenseAuthority">
                    <option :value="item.Value || item.value" x-text="item.Text || item.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Date of Registration</label>
            <input type="text" id="reg-date-picker-main" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] cursor-pointer outline-none transition-all" 
                   x-model="formData.registrationDate" placeholder="DD/MM/YYYY" readonly>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Date of Expiry</label>
            <input type="text" id="exp-date-picker-main" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] cursor-pointer outline-none transition-all" 
                   x-model="formData.expiryDate" placeholder="DD/MM/YYYY" readonly>
        </div>

        <!-- Legal Status, Business Activities, Counter Party -->
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Legal Status <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('entityTypeTxt') }"
                    x-model="formData.entityTypeTxt">
                <option value="">--Select--</option>
                <template x-for="item in studioLists.EntityType">
                    <option :value="item.Value || item.value" x-text="item.Text || item.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Business Activities <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('businessType') }"
                    x-model="formData.businessType">
                <option value="">--Select--</option>
                <template x-for="item in studioLists.BusinessTypeList">
                    <option :value="item.Value || item.value" x-text="item.Text || item.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Counter Party</label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" x-model="formData.counterParty">
                <option value="">Select</option>
                <template x-for="cp in studioLists.CounterParties">
                    <option :value="cp.Value || cp.value" x-text="cp.Text || cp.text"></option>
                </template>
            </select>
        </div>

        <!-- Counter Party Name, Product Type, Product Value -->
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Counter Party Name</label>
            <input type="text" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] font-medium outline-none transition-all" x-model="formData.counterPartyName" placeholder="Enter Counter Party Name">
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Product/Service Type <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('productType') }"
                    x-model="formData.productType">
                <option value="">--Select--</option>
                <template x-for="p in studioLists.Products">
                    <option :value="p.Value || p.value" x-text="p.Text || p.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Product/Service Value</label>
            <input type="text" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] font-medium outline-none transition-all" x-model="formData.productValue" placeholder="Enter Product Value">
        </div>

        <!-- Delivery Channel, Payment Mode, CIF No -->
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Delivery Channel <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('deliveryChannel') }"
                    x-model="formData.deliveryChannel">
                <option value="">--Select--</option>
                <template x-for="d in studioLists.DeliveryChannels">
                    <option :value="d.Value || d.value" x-text="d.Text || d.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Mode of Payment <span class="text-rose-500">*</span></label>
            <select class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] outline-none transition-all" 
                    :class="{ 'border-rose-500': errors.includes('paymentMode') }"
                    x-model="formData.paymentMode">
                <option value="">--Select--</option>
                <template x-for="pm in studioLists.PaymentModes">
                    <option :value="pm.Value || pm.value" x-text="pm.Text || pm.text"></option>
                </template>
            </select>
        </div>
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Customer CIF No</label>
            <input type="text" class="w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-[13px] font-medium outline-none transition-all" x-model="formData.cif" placeholder="Enter Customer CIF No">
        </div>

        <!-- Product Ref No, Match Parameter -->
        <div class="space-y-1">
            <label class="text-[11px] font-bold text-slate-600 ml-1">Product Ref No</label>
            <input type="text" class="h-11 w-full bg-white border border-slate-200 rounded-xl px-4 text-[13px] font-medium outline-none transition-all" x-model="formData.productRefNo" placeholder="Enter Product Ref No">
        </div>
        <div class="space-y-3">
            <div class="flex justify-between items-center px-1">
                <label class="text-[11px] font-bold text-slate-600">Match Parameter</label>
                <span class="text-[11px] font-black text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded" x-text="formData.matchParameter + '%'"></span>
            </div>
            <div class="relative flex items-center h-5">
                <input type="range" x-model="formData.matchParameter" min="50" max="100" class="w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-600 bg-slate-200"
                       :style="`background: linear-gradient(to right, #2563eb ${((formData.matchParameter-50)/(100-50))*100}%, #e2e8f0 ${((formData.matchParameter-50)/(100-50))*100}%)`">
            </div>
        </div>
    </div>
</div>
