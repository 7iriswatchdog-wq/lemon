@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Shareholder Case Process Report";
    Layout = null; 
    var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName") ?? "AML Systems";
    var clientLogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

@model AML.ViewModel.ViewModels.CaseProcess.CaseProcessModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Manager - Case Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #f8fafc;
        }
        @@media print {
            .no-print { display: none !important; }
        }
        .flex { display: flex !important; }
        .grid { display: grid !important; }
        tr { 
            page-break-inside: avoid !important; 
            break-inside: avoid !important;
        }
    </style>
</head>
<body class="text-slate-900 text-[9px] bg-slate-50">

    <div class="no-print flex items-center justify-end gap-2 my-4 max-w-[1024px] mx-auto px-2">
        <button onclick="downloadPageAsPDF('#pdf-container', 'Shareholder_Case_Report_@Model.Case.Id' + '.pdf')"
            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-[9px] font-bold rounded-lg shadow transition-all active:scale-95 cursor-pointer">
            Download PDF
        </button>
        <button onclick="window.print()"
            class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[9px] font-bold rounded-lg shadow transition-all active:scale-95">
            Print
        </button>
        <a href="/case/Shareholder/@Model.Case.Id"
            class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[9px] font-bold rounded-lg shadow transition-all active:scale-95">
            Back
        </a>
    </div>

    <div id="pdf-container" class="max-w-[1024px] mx-auto flex flex-col gap-6 px-2">
        <div class="shrink-0 py-6 mb-2 border-b border-slate-200">
            <div class="flex justify-between items-end">
                <div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Shareholder Case Manager</h1>
                    <div class="mt-2 flex items-center gap-4">
                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                            Official Audit Document
                        </div>
                        <div class="text-[10px] text-slate-400">
                            Generated on @DateTime.UtcNow.AddHours(4).ToString("dd/MM/yyyy HH:mm") GST
                        </div>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-[10px] text-slate-400 font-bold tracking-widest uppercase">Case ID</div>
                    <div class="text-xl font-black text-slate-900">#@Model.Case.Id</div>
                </div>
            </div>
        </div>

        <!-- Case Details Summary -->
        <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
            <div class="flex justify-between items-start mb-5">
                <div class="flex items-center gap-2">
                    <div class="h-4 w-1 bg-blue-600 rounded-full"></div>
                    <h2 class="text-base font-bold text-slate-900 leading-none">Case Details</h2>
                </div>
                <div class="flex gap-4">
                    <!-- <span class="text-[11px] font-bold text-blue-600 flex items-center gap-1 tracking-tight">View PDF</span>
                    <span class="h-4 w-px bg-blue-300"></span> -->
                    <span class="text-[11px] font-bold text-blue-600 flex items-center gap-1 tracking-tight">Download PDF</span>
                    <span class="h-4 w-px bg-blue-300"></span>
                    <span class="text-[11px] font-bold text-blue-600 tracking-tight">Upload Document</span>
                    <span class="h-4 w-px bg-blue-300"></span>
                    <span class="text-[11px] font-bold text-blue-600 flex items-center gap-1 tracking-tight">View Details <span class="text-[10px]">→</span></span>
                </div>
            </div>
            <div class="grid grid-cols-4 gap-x-8 gap-y-6">
                <div class="flex flex-col"><span class="text-slate-400">Customer ID</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.CustomerId</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Date</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.CreatedOnText</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Screening Options</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.ScreeningOptions</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Customer Name</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.FirstName @Model.Case.LastName</span></div>
                
                <div class="flex flex-col"><span class="text-slate-400">Category</span><span class="text-[12px] font-medium text-slate-900">@(Model.Case.CustomerType == "I" ? "Individual" : "Corporate")</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Nationality</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.Nationality</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Date of Birth</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.DOB</span></div>
                <div class="flex flex-col"><span class="text-slate-400">ID Type</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.CustomerIdType</span></div>

                <div class="flex flex-col"><span class="text-slate-400">ID Number</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.CustomerIdNumber</span></div>
                <div class="flex flex-col"><span class="text-slate-400">CIF No</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.CIFNumber</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Match Parameter</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.Threshold</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Gender</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.Gender</span></div>

                <div class="flex flex-col"><span class="text-slate-400">ID Issue Date</span><span class="text-[12px] font-medium text-slate-900">@(Model.Case.IdIssueDate?.ToString("dd/MM/yyyy") ?? "NA")</span></div>
                <div class="flex flex-col"><span class="text-slate-400">ID Expiry Date</span><span class="text-[12px] font-medium text-slate-900">@(Model.Case.IdExpiryDate?.ToString("dd/MM/yyyy") ?? "NA")</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Employer</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.Employer</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Employer Industry</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.EmployerIndustry</span></div>

                <div class="flex flex-col"><span class="text-slate-400">Employer Sector</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.EmployerSector</span></div>
                <div class="flex flex-col"><span class="text-slate-400">Golden Visa</span><span class="text-[12px] font-medium text-slate-900">@Model.Case.GoldenVisa</span></div>
            </div>
        </div>

        <!-- Search Results Section -->
        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <h3 class="px-5 py-3 border-b border-slate-100 bg-slate-50 font-bold text-sm">Search Results</h3>
            <div class="overflow-x-auto min-h-[100px]">
                @if (Model.DataList != null && Model.DataList.Any())
                {
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500">
                            <tr>
                                <th class="px-4 py-3 border-b">Name</th>
                                <th class="px-4 py-3 border-b">Score</th>
                                <th class="px-4 py-3 border-b">Nationality</th>
                                <th class="px-4 py-3 border-b">DOB</th>
                                <th class="px-4 py-3 border-b">Datasets</th>
                                <th class="px-4 py-3 border-b">Details</th>
                                <th class="px-4 py-3 border-b">Search Type</th>
                                <th class="px-4 py-3 border-b">Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="text-[11px] text-slate-700">
                            @foreach (var item in Model.DataList)
                            {
                                <tr class="border-b border-slate-100 last:border-0 italic">
                                    <td class="px-4 py-3 font-bold not-italic">@item.matchname</td>
                                    <td class="px-4 py-3 not-italic">@item.matchscore</td>
                                    <td class="px-4 py-3 not-italic">@item.matchnationality</td>
                                    <td class="px-4 py-3 not-italic">@item.matchdob</td>
                                    <td class="px-4 py-3 not-italic">
                                        @{ var dsArr = item.matchdatasets?.Split(','); }
                                        @if (dsArr != null) { foreach (var ds in dsArr) { <div class="mb-0.5">@ds.Trim()</div> } }
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="h-6 px-2 border border-slate-200 text-slate-400 text-[8px] font-bold rounded flex items-center justify-center bg-white shadow-sm">Details</div>
                                    </td>
                                    <td class="px-4 py-3">@(item.searchTypes != null ? string.Join(", ", item.searchTypes) : "")</td>
                                    <td class="px-4 py-3">@item.remarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="flex items-center justify-center h-24 text-slate-400 text-sm font-semibold">
                        No search results found
                    </div>
                }
            </div>
        </div>

        <!-- Case History Section -->
        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <h3 class="px-5 py-3 border-b border-slate-100 bg-slate-50 font-bold text-sm">Case History</h3>
            <div class="p-5 min-h-[100px]">
                @if (Model.CaseComments != null && Model.CaseComments.Any())
                {
                    <div class="space-y-4">
                        @foreach (var history in Model.CaseComments)
                        {
                            <div class="p-4 bg-white rounded-lg border border-slate-200 shadow-sm">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-[10px] font-bold text-blue-600">@history.CreatedUser</span>
                                    <span class="text-[9px] text-slate-400 font-medium">@history.CreatedOn.AddHours(4).ToString("dd/MM/yyyy HH:mm:ss") GST</span>
                                </div>
                                <div class="text-[10px] font-black text-slate-900 mb-2 border-b border-slate-100 pb-1">@history.MatchCategory</div>
                                <p class="text-[10px] text-slate-600 leading-relaxed font-medium">@history.Comments</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex items-center justify-center h-24 text-slate-400 italic text-sm font-medium">
                        No comments yet
                    </div>
                }
            </div>
        </div>

        <!-- Static Footer Section -->
        <div class="bg-white rounded-lg border border-slate-200 p-6 space-y-6 mt-4">
            <h3 class="text-sm font-bold text-slate-900 border-b pb-2">Case Comments</h3>
            
            <div class="flex gap-4 items-center">
                <div class="flex-1 min-h-[44px] py-2.5 bg-slate-50 border border-slate-200 text-xs rounded-md px-3 text-slate-400 italic">
                    Enter Your Comments
                </div>
                <div class="h-[44px] px-8 border border-slate-200 text-slate-400 font-bold bg-slate-50 rounded-md flex items-center justify-center">
                    Save
                </div>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="h-9 px-4 border border-slate-200 text-slate-900 text-[10px] font-bold rounded-md flex items-center bg-white shadow-sm">
                        Submit To Senior Management
                    </div>
                    <div class="h-9 px-4 border border-slate-200 text-slate-900 text-[10px] font-bold rounded-md flex items-center bg-white shadow-sm">
                        Whitelist
                    </div>
                    <div class="h-9 px-4 border border-slate-200 text-slate-900 text-[10px] font-bold rounded-md flex items-center bg-white shadow-sm">
                        Transfer
                    </div>
                    <div class="h-9 px-4 border border-slate-200 text-slate-900 text-[10px] font-bold rounded-md flex items-center bg-white shadow-sm">
                        Hold
                    </div>
                    <div class="h-9 px-8 bg-blue-600 text-white text-[10px] font-bold rounded-md flex items-center shadow-md">
                        Approve
                    </div>
                    <div class="h-9 px-8 bg-red-600 text-white text-[10px] font-bold rounded-md flex items-center shadow-md">
                        Reject
                    </div>
                </div>
                @* <div class="flex items-center gap-3">
                    
                </div> *@
            </div>
        </div>
    </div>

    <script src="~/lib/html2pdf/html2pdf.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/pdf-export.js"></script>

    <script>
        $(document).ready(function() {
            if (typeof lucide !== 'undefined') lucide.createIcons();
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('download') === 'true') {
                setTimeout(() => {
                    downloadPageAsPDF('#pdf-container', 'Shareholder_Case_Report_@Model.Case.Id' + '.pdf');
                }, 1000);
            }
        });
    </script>
</body>
</html>