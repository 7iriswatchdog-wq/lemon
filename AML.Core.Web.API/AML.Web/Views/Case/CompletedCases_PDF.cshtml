@using AML.ViewModel.ViewModels.CustomerCase
@using Microsoft.AspNetCore.Http
@model List<CaseModel>
@{
    Layout = null;
    var companyName = Context.Session.GetString("SessCompanyName") ?? "AML Systems";
    var auditDate = DateTime.UtcNow.AddHours(4).ToString("dd MMM yyyy, HH:mm") + " GST";
}

@functions {
    public struct StatusInfo
    {
        public string MainStatus;
        public List<(string Label, string Color, string Count)> Shareholders;
    }

    public StatusInfo ParseStatus(string statusText)
    {
        if (string.IsNullOrEmpty(statusText)) return new StatusInfo { MainStatus = "-" };

        if (!statusText.Contains("| Shareholders:"))
        {
            return new StatusInfo { MainStatus = statusText.Trim(), Shareholders = new List<(string, string, string)>() };
        }

        var parts = statusText.Split('|');
        var main = parts[0].Trim();
        var shPart = parts[1];

        var info = new StatusInfo { MainStatus = main, Shareholders = new List<(string, string, string)>() };

        var patterns = new[] { "Total", "Approved", "Auto", "Pending", "Rejected", "OnHold", "Waitlist", "Whitelist" };
        var counts = new Dictionary<string, string>();

        foreach (var p in patterns)
        {
            var match = System.Text.RegularExpressions.Regex.Match(shPart, p + @"\s+(\d+)");
            if (match.Success && int.Parse(match.Groups[1].Value) > 0)
            {
                counts[p] = match.Groups[1].Value;
            }
        }

        if (counts.ContainsKey("Auto")) info.Shareholders.Add(("A", "bg-green-100 text-green-800", counts["Auto"]));
        if (counts.ContainsKey("Approved")) info.Shareholders.Add(("AP", "bg-green-700 text-white", counts["Approved"]));
        if (counts.ContainsKey("Pending")) info.Shareholders.Add(("P", "bg-yellow-100 text-yellow-800", counts["Pending"]));
        if (counts.ContainsKey("Rejected")) info.Shareholders.Add(("R", "bg-red-100 text-red-800", counts["Rejected"]));
        if (counts.ContainsKey("OnHold")) info.Shareholders.Add(("OH", "bg-orange-500 text-white", counts["OnHold"]));
        if (counts.ContainsKey("Waitlist")) info.Shareholders.Add(("W", "bg-indigo-600 text-white", counts["Waitlist"]));
        if (counts.ContainsKey("Whitelist")) info.Shareholders.Add(("WL", "bg-indigo-600 text-white", counts["Whitelist"]));

        return info;
    }

    public string GetStatusClass(string text)
    {
        var t = text.ToLower().Trim();
        if (t.Contains("approved")) return "bg-green-700 text-white";
        if (t.Contains("pending")) return "bg-yellow-100 text-yellow-800";
        if (t.Contains("hold")) return "bg-orange-500 text-white";
        if (t.Contains("white")) return "bg-indigo-600 text-white";
        if (t.Contains("wait")) return "bg-indigo-600 text-white";
        if (t.Contains("auto")) return "bg-green-100 text-green-800";
        if (t.Contains("transfer")) return "bg-green-100 text-green-800";
        if (t.Contains("rejected")) return "bg-red-100 text-red-800";
        return "bg-slate-100 text-slate-800";
    }

    public string GetRiskClass(string risk)
    {
        if (string.IsNullOrEmpty(risk) || risk.Equals("Unclassified", StringComparison.OrdinalIgnoreCase))
            return "text-slate-400";
        var r = risk.ToLower();
        if (r.Contains("high")) return "text-red-700";
        if (r.Contains("medium")) return "text-amber-700";
        if (r.Contains("low")) return "text-emerald-700";
        return "text-slate-400";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completed Cases Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @@media print {
            .no-print { display: none !important; }
            tr { page-break-inside: avoid !important; break-inside: avoid !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 text-[9px] p-8">
    <div id="pdf-container" class="max-w-[1280px] mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <!-- Header -->
        <div class="flex justify-between items-start border-b border-slate-200 pb-6 mb-8">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 uppercase">Completed Cases Report</h1>
                <p class="text-slate-500 font-medium mt-1 uppercase tracking-widest text-[8px]">Closed and Finalized Cases</p>
                <div class="mt-4 text-[8px] text-slate-400 space-y-0.5 font-bold uppercase tracking-tight">
                    <p>Extraction Date: @auditDate</p>
                </div>
            </div>
            <div class="text-right">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Company</div>
                <div class="text-lg font-black text-blue-600">@companyName</div>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b-2 border-slate-200 text-slate-500 uppercase tracking-wider font-bold text-[8px]">
                        <th class="px-2 py-4 h-12">Customer ID</th>
                        <th class="px-2 py-4 h-12">Created On</th>
                        <th class="px-2 py-4 h-12">Updated On</th>
                        <th class="px-2 py-4 h-12">Customer Type</th>
                        <th class="px-2 py-4 h-12">Customer Name</th>
                        <th class="px-2 py-4 h-12">Datasets</th>
                        <th class="px-2 py-4 h-12">Screening Score</th>
                        <th class="px-2 py-4 h-12 text-center">Risk Rating</th>
                        <th class="px-2 py-4 h-12">User</th>
                        <th class="px-2 py-4 h-12 text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var statusInfo = ParseStatus(item.CaseStatus);
                            var riskText = item.Individual_final_risk_score ?? item.corporate_final_risk_score;
                            var riskDisplay = string.IsNullOrEmpty(riskText) ? "Unclassified" : riskText;
                            var riskOverride = item.Individual_Risk_Override ?? item.Corporate_Risk_Override;
                            var riskClass = GetRiskClass(riskText);
                            var scoreColor = item.MatchScore < 70 ? "text-green-600" : item.MatchScore < 85 ? "text-orange-500" : "text-red-600";
                            
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-2 py-4 font-bold text-slate-900 border-l-2 border-slate-100 uppercase">@item.CustomerId</td>
                                
                                <td class="px-2 py-4 text-slate-700">
                                    <div class="font-medium">@item.CreatedOn.ToString("dd MMM yyyy")</div>
                                    <div class="text-slate-400 text-[7.5px]">@item.CreatedOn.ToString("HH:mm:ss tt")</div>
                                </td>

                                <td class="px-2 py-4 text-slate-700">
                                    @{
                                        var updateDateStr = !string.IsNullOrEmpty(item.UpdatedOn) ? item.UpdatedOn : item.UpdatedOnDB;
                                    }
                                    @if(!string.IsNullOrEmpty(updateDateStr))
                                    {
                                        if(DateTime.TryParse(updateDateStr, out DateTime dtUpdate) && dtUpdate != DateTime.MinValue) {
                                            <div class="font-medium">@dtUpdate.ToString("dd MMM yyyy")</div>
                                            <div class="text-slate-400 text-[7.5px]">@dtUpdate.ToString("HH:mm:ss tt")</div>
                                        } else {
                                            <div class="font-medium">@updateDateStr</div>
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td class="px-2 py-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-2 py-0.5 rounded-full text-[8px] font-bold @(item.CustomerType == "I" || item.CustomerType == "Individual" ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                                            @(item.CustomerType == "I" || item.CustomerType == "Individual" ? "Individual" : "Corporate")
                                        </span>
                                    </div>
                                </td>

                                <td class="px-2 py-4 font-bold text-slate-800 break-words max-w-[150px]">@(item.FirstName + " " + item.LastName)</td>

                                <td class="px-2 py-4 text-slate-500 whitespace-normal break-words max-w-[120px] leading-relaxed italic">@item.CaseChangeStatus</td>

                                <td class="px-2 py-4 font-black @scoreColor">@item.MatchScore</td>

                                <td class="px-2 py-4 text-center">
                                    <span class="font-bold @riskClass uppercase tracking-tight">
                                        @if (!string.IsNullOrEmpty(riskText) &&
                                             ((item.CustomerType == "Individual" && item.Individual_Risk_Override?.ToLower() == "override") ||
                                              (item.CustomerType != "Individual" && item.Corporate_Risk_Override?.ToLower() == "override")))
                                        {
                                            <span>@(riskDisplay.Replace(" Risk", ""))(O)</span>
                                        }
                                        else
                                        {
                                            <span>@riskDisplay.Replace(" Risk", "")</span>
                                        }
                                    </span>
                                </td>

                                <td class="px-2 py-4 text-slate-600 whitespace-nowrap">@item.CreatedUser</td>

                                <td class="px-2 py-4 min-w-[120px]">
                                    <div class="flex flex-col items-center gap-1.5">
                                        <span class="inline-flex w-full items-center justify-center px-2 py-1.5 rounded-full text-[8px] font-black @GetStatusClass(statusInfo.MainStatus) border border-slate-200/50 uppercase tracking-tighter shadow-sm">
                                            @statusInfo.MainStatus
                                        </span>
                                        @if (statusInfo.Shareholders.Any())
                                        {
                                            <div class="flex flex-wrap justify-center gap-1">
                                                @foreach (var sh in statusInfo.Shareholders)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded-full text-[7px] font-bold @sh.Color border border-slate-200/10">@sh.Label:@sh.Count</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="px-2 py-12 text-center text-slate-400 italic font-medium">No completed case records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="mt-12 pt-6 border-t border-slate-100 text-center text-slate-400">
            <p class="text-[8px] font-bold tracking-widest uppercase">
                CONFIDENTIAL AUDIT LOG - @companyName &copy; @DateTime.Now.Year
                <br />
                Computer generated report; hence no signature is required.
            </p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="/js/pdf-export.js"></script>
    <script>
        window.onload = function() {
            setTimeout(() => {
                downloadPageAsPDF('#pdf-container', 'Completed_Cases_Report_@DateTime.Now.ToString("yyyyMMdd")' + '.pdf', '@(ViewBag.Orientation ?? "portrait")');
            }, 1000);
        };
    </script>
</body>
</html>
