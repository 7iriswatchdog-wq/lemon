@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = localizer["Manage Case"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.CaseProcess.CaseProcessModel
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<script src="~/plugins/jquery/jquery.min.js"></script>

<div class="custom-container">

   

    <div class="sas-breadcrumbs pb-3">
        <ul class="mb-0 pl-0 d-flex">
            <li><a href="#">Home</a></li>/
            <li><a href="#">Manage Case</a></li>
        </ul>
    </div>

    @*<div class="sas-card rounded-card mb-2">
    <div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0">Manage Case</h6>
    </div>
    <hr />
    <div class="row justify-content-end">
    <div class="d-flex justify-content-between align-items-center">
    <a asp-controller="Case" asp-action="Index"> <button type="button" id="btnBack" class="sas-button p-8-25 color-white bg-color-2" align="right">Back</button></a>
    </div>
    <br />*@
    <div class="sas-card rounded-card br-50  mt-2 mb-2">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><b>Manage Case</b></h4>
            <div class="menu-icon">
                <i class="lni lni-microsoft"></i>
            </div>
        </div>
    </div>







    <div class="sas-card rounded-card mb-2">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Manage Case</h6>

            <div class="row justify-content-end">

                <a asp-controller="Case" asp-action="Index"> <button type="button" id="btnBack" class="sas-button p-8-25 color-white bg-color-2" align="right">Back</button></a>
            </div>
        </div>
        <hr />
        <div class="row  mb-2">

            <div class="col-md-4"><b>@localizer["Customer Id"]:</b> @(Model.Case.CustomerId)</div>
            <div class="col-md-4"><b>@localizer["Customer Name"]:</b> @(Model.Case.FirstName + " " + Model.Case.MiddleName + " " + Model.Case.LastName)</div>
            @{
                if (Model.Case.Status == 6)
                {
                    <div class="col-md-4"><b>@localizer["Status"]:</b> Case &nbsp; Created  &nbsp; From  &nbsp;  Daily  &nbsp; Scheduler</div>
                }
                else
                {
                    <div class="col-md-4"><b>@localizer["Status"]:</b> @(Convert.ToString((AML.Core.DataContract.Enum.CaseStatus)Model.Case.Status))</div>
                }
            }

        </div>

        <input id="hdnStatus" type="hidden" name="CaseId" value="@(Model.Case.Status)" />
        <!-- /.card-header -->
        <!-- form start -->

        <form role="form" id="frmDocument" class="form-horizontal" enctype="multipart/form-data" method="post">

            <input id="hdnCaseId" type="hidden" name="CaseId" value="@Model.Case.Id" />

            <h2>@localizer["Case"]: @Model.Case.Id</h2>
            <div class="row mb-2">

                <div class="col-md-4"><b>@localizer["Fullname"]:</b> @(Model.Case.FirstName + " " + Model.Case.MiddleName + " " + Model.Case.LastName)</div>


                @{
                    if (Model.Case.Status == 6)
                    {
                        <div class="col-md-4"><b>@localizer["Status"]:</b> Case &nbsp; Created  &nbsp; From  &nbsp;  Daily  &nbsp; Scheduler</div>
                    }
                    else
                    {
                        <div class="col-md-4"><b>@localizer["Status"]:</b> @(Convert.ToString((AML.Core.DataContract.Enum.CaseStatus)Model.Case.Status))</div>
                    }
                }
                <div class="col-md-4"><b>@localizer["Match score"]:</b> @(Model.Case.MatchScore)%</div>
            </div>
            @*<div class="row">
            <div class="col"><b>@localizer["Risk score"]:</b> @Model.Case.RiskScore</div>
            <div class="col"><b>@localizer["Match score"]:</b> @(Model.Case.MatchScore)%</div>
            <div class="col"><b>@localizer["Source"]:</b> @(Model.Case.Source)</div>
            <div class="col"><b>@localizer["Source Id"]:</b> @(Model.Case.SourceUniqueId)</div>
            <div class="col"><b>@localizer["Id Type"]:</b> @(Model.Case.CustomerIdType)</div>
            <div class="col"><b>@localizer["Id Number"]:</b> @(Model.Case.CustomerIdNumber)</div>
            </div>
            <hr />*@
            <div class="row mb-2">
                <div class="col-md-4" style="display:none;"><b>@localizer["Risk score"]:</b> @Model.Case.RiskScore</div>

                <div class="col-md-4"><b>@localizer["Nationality"]:</b> @(Model.Case.Nationality)</div>
                @if (Model.Case.DOB == "1/1/0001 12:00:00 AM")
                {
                    <div class="col"><b>@localizer["DOB"]:</b> </div>
                }
                else
                {
                    bool parseSucessfull = DateTime.TryParse(Model.Case.DOB, out DateTime parsedDate);
                    <div class="col"><b>@localizer["DOB"]:</b> @(parseSucessfull ? parsedDate.ToString("dd/MM/yyyy") : "")</div>
                }
                <div class="col-md-4"><b>@localizer["Source"]:</b> @(Model.Case.Source)</div>
            </div>
            <div class="row">

                <div class="col-md-4"><b>@localizer["Source Id"]:</b> @(Model.Case.SourceUniqueId)</div>

                @if (!string.IsNullOrWhiteSpace(Model.Case.PassportId))
                {
                    <div class="col-md-4"><b>Passport No:</b> @(Model.Case.PassportId)</div>
                    <div class="col-md-4"><b>Passport Issue:</b> @(string.IsNullOrWhiteSpace(Model.Case.PassportIssueDate) ? (string)"-" : Model.Case.PassportIssueDate)</div>
                    <div class="col-md-4"><b>Passport Expiry:</b> @(string.IsNullOrWhiteSpace(Model.Case.PassportExpiryDate) ? (string)"-" : Model.Case.PassportExpiryDate)</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Case.EmiratesIdNumber))
                {
                    <div class="col-md-4"><b>Emirates ID:</b> @(Model.Case.EmiratesIdNumber)</div>
                    <div class="col-md-4"><b>EID Issue:</b> @(string.IsNullOrWhiteSpace(Model.Case.EmiratesIdIssueDate) ? (string)"-" : Model.Case.EmiratesIdIssueDate)</div>
                    <div class="col-md-4"><b>EID Expiry:</b> @(string.IsNullOrWhiteSpace(Model.Case.EmiratesIdExpiryDate) ? (string)"-" : Model.Case.EmiratesIdExpiryDate)</div>
                }

                @if (string.IsNullOrWhiteSpace(Model.Case.PassportId) && string.IsNullOrWhiteSpace(Model.Case.EmiratesIdNumber) && !string.IsNullOrWhiteSpace(Model.Case.CustomerIdType))
                {
                    <div class="col-md-4"><b>@localizer["Id Type"]:</b> @(Model.Case.CustomerIdType)</div>
                    <div class="col-md-4"><b>@localizer["Id Number"]:</b> @(Model.Case.CustomerIdNumber)</div>
                }
            </div>
            <div class="row">

                <div class="col-md-4"><b>@localizer["Trade License"]:</b> @(Model.Case.Tradelicense)</div>

            </div>
            <hr />
            <div class="row" style="display:none;">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>@localizer["Document Categories"]</label>
                        <select id="ddlCategories" class="form-control br-50" name="DocumentCategory" asp-items="Model.DocumentCategories">
                            <option value="0">--@localizer["EMPTY"]--</option>
                        </select>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label>@localizer["Document Types"]</label>
                        <select id="ddlType" class="form-control br-50" name="DocumentType" asp-items="Model.DocumentTypes">
                            <option value="0">--@localizer["EMPTY"]--</option>
                        </select>
                    </div>
                </div>
            </div>
            @foreach (var item in @Model.CaseDocuments)
            {

                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label for="txDocNo">@localizer["Document No"]</label>
                            <input type="text" class="form-control br-50" id="txtDocNo" asp-for="@item.DocumentName" name="DocumentName" placeholder=@localizer["Document No"]>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label for="txIssuedDate">@localizer["Issued Date"]</label>
                            <input type="date" class="form-control br-50" id="txtIssuedDate" asp-for="@item.IssuedDateOnDB" name="IssuedDate" max="3000-12-31" placeholder=@localizer["Document Issued Date"]>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label for="txtExpiryDate">@localizer["Expiry Date"]</label>

                            <input type="date" class="form-control br-50" id="txtExpiryDate" name="ExpiryDate" asp-for="@item.ExpiryDateOnDB" max="4444-12-31" placeholder=@localizer["Document Expiry Date"]>

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label for="txtDetails">@localizer["Document Details"]</label>
                            <textarea rows="3" class="form-control br-50" id="txtDetails" name="DocumentDetails" style="height: 40px;" placeholder=@localizer["Document Details"]></textarea>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label for="txtRemarks">@localizer["Remarks"]</label>
                            <textarea rows="3" class="form-control br-50" id="txtRemarks" name="Remarks" style="height: 40px;" placeholder=@localizer["Remarks"]></textarea>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="txtFile">@localizer["Document"]</label>
                            <input type="file" name="Document" class="form-control br-50" id="txtFile" placeholder=@localizer["Document Expiry Date"]>
                        </div>
                    </div>
                </div>
            }
            <div class="row justify-content-end">
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Button trigger modal -->
                    <button type="button" class="sas-button p-8-25 color-white bg-color-2" data-toggle="modal" data-target="#docModal">
                        @localizer["View Uploaded Documents"]
                    </button>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <button type="submit" id="docSubmit" class="sas-button p-8-25 color-white bg-color-1 ml-3">@localizer["Save the Document"]</button>
                    @*<button type="button" class="btn btn-danger" onclick="clearDocuemnt();">New Document</button>*@
                </div>
            </div>


        </form>

    </div>


    <div class="sas-card rounded-card mb-2">
        <form role="form" id="frmCmment" class="form-horizontal" enctype="multipart/form-data" method="post">

            <input type="hidden" name="CaseId" value="@Model.Case.Id" />
            <div style="overflow: scroll;overflow-x:hidden; height:auto; max-height: 400px; ">
                <h3>@localizer["Case Comments"]</h3>

                <div class="col-md-12">
                    @*//  The time line*@

                    <div id="Comments">
                        @*   //    Timeline time label*@
                        <div class="time-label">
                            @* //   <span class="bg-red">10 Feb. 2014</span>*@
                        </div>
                        @*//  Timeline-label*@
                        <div class="comment-section timeline">
                        </div>
                    </div>
                    <div id="nocomment"><label>No comments yet</label></div>
                </div>
            </div>
            <br />
            <div class="form-group" style="width:94%;">
                <div class="row justify-content-between">
                    <div class="col-md-10">

                        @*<input type="text" id="txtCaseComment" name="Comment" class="form-control">*@
                        <textarea id="txtCaseComment" name="Comment" class="form-control br-50" placeholder="Enter Your Comments" rows="2"></textarea>
                    </div>

                    <div class="col-md-2 mt-3">
                        @*<div class="row justify-content-end">*@
                        <span class="input-group-btn">
                            &nbsp;&nbsp;<button type="submit" class="sas-button p-8-25 color-white bg-color-1 mr-3">Send <i class="fa fa-paper-plane ml-2" aria-hidden="true"></i></button>
                        </span>
                    </div>
                </div>
            </div>

        </form>
    </div>

    <div class="sas-card rounded-card mb-2">
        <div class="mb-2">
            <h3>@localizer["Case Action"]</h3>
        </div>
        <form role="form" id="frmCloseCase" class="form-horizontal" enctype="multipart/form-data" method="post">
            <input type="hidden" name="CaseId" value="@Model.Case.Id" />

            <input type="hidden" id="hdnAction" name="Action" value="" />
            <input type="hidden" id="hdnRemark" name="Comment" value="" />
            <input type="hidden" id="hdnAction" name="Action" value="" />

            <div class="row" style="display:none">
                <div class="col-6">
                    <div class="form-group">
                        <label for="txtDescription">@localizer["Remarks"]</label>
<textarea rows="3" class="form-control br-50" id="txtCaseActionRemarks" name="Comment" placeholder=@localizer["Remarks"]></textarea>
                    </div>
                </div>
            </div>
            @*<input type="submit" name="Approve" class="btn btn-success" value=@localizer["Approve Case"] />*@
            <input type="submit" name="Approve" class="sas-button p-8-25 color-white bg-color-1 ml-2" value=@localizer["Approve"] />

            @*<input type="submit" name="Reject" class="btn btn-danger" value=@localizer["Reject Case"] />*@
            <input type="submit" name="Reject" class="sas-button p-8-25 color-white bg-color-3 ml-3" value=@localizer["Reject"] />

            @*onclick="location.href='@Url.Action("Reject", "Case")'" />*@
            @*<input type="submit" name="Whitelist" class="btn btn-success" value=@localizer["Whitelist Case"] />*@
            <input type="submit" name="Whitelist" class="sas-button p-8-25 color-white bg-color-1 ml-3" value=@localizer["Whitelist"] />
            @{
                if (@Model.Users.Count() != 0)
                {
                    <input type="button" name="Transfer" class="sas-button p-8-25 color-white bg-color-1 ml-3" value=@localizer["Transfer Case"] data-toggle="modal" data-target="#assignModal" />
                }
            }

        </form>
    </div>

    <div class="sas-card rounded-card mb-2">
        <h3>@localizer["API Result"]</h3>
        @if (@Model.DataList != null)
        {
            <div class="table-responsive">
                <table id="APITable" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
                    <thead>
                        <tr>
                            <th>@localizer["Type"]</th>
                            <th>@localizer["Category"]</th>
                            <th>@localizer["Name"]</th>
                            <th>@localizer["Score"]</th>
                            <th>@localizer["Nationality"]</th>
                            <th>@localizer["Id No"]</th>
                            <th>@localizer["DOB"]</th>
                            <th>@localizer["Details"]</th>
                            <th>@localizer["Download"]</th>
                            @*<th style=" @(@Model.Case.Source != "KYC6" ? "display:none" : "height:auto")">@localizer["Details"]</th>
                        <th style=" @(@Model.Case.Source != "KYC6" ? "display:none" : "height:auto")">@localizer["Download"]</th>*@
                            @*<th style=" @(@Model.Case.Source != "WC" ? "display:none" : "height:auto")">@localizer["Download"]</th>*@
                            <th>@localizer["Remarks"]</th>
                        </tr>
                    </thead>
                    <tbody>

                        @for (int itemIndex = 0; itemIndex < @Model.DataList.Count(); itemIndex++)
                        {
                            <tr>
                                <td>@Model.DataList[itemIndex].matchtype</td>
                                <td>@Model.DataList[itemIndex].matchcategory</td>
                                <td>@Model.DataList[itemIndex].matchname</td>
                                <td>@Model.DataList[itemIndex].matchscore</td>
                                <td>@Model.DataList[itemIndex].matchnationality</td>
                                <td>@Model.DataList[itemIndex].matchidno</td>
                                <td>@Model.DataList[itemIndex].matchdob</td>
                                @*<td style=" @(Model.DataList[itemIndex].matchtype != "KYC6" ? "display:none" : "height:auto")">
                        <input type="button" value="Details" onclick="location.href='@Url.Action("GetDetailsApi", "Case", new { Id = @Model.DataList[itemIndex].matchuid, Category = @Model.DataList[itemIndex].matchcategory })'" />
                        </td>
                        <td style=" @(Model.DataList[itemIndex].matchtype != "KYC6" ? "display:none" : "height:auto")">
                        <input type="button" value="Download" onclick="location.href='@Url.Action("CallApi", "Case", new { Id = @Model.DataList[itemIndex].matchuid, Category = @Model.DataList[itemIndex].matchcategory })'" />
                        </td>*@
                                @if (@Model.DataList[itemIndex].matchtype == "KYC6")
                                {
                                    <td style="height:auto">
                                        <input type="button" value="Details" onclick="location.href='@Url.Action("GetDetailsApi", "Case", new { Id = @Model.DataList[itemIndex].matchuid, Category = @Model.DataList[itemIndex].matchcategory, CaseId =Model.Case.Id })'" style="padding: 5px 10px !important;" />
                                    </td>
                                    <td style="height:auto">
                                        <input type="button" value="Download" id="download" onclick="location.href='@Url.Action("CallApi", "Case", new { Id = @Model.DataList[itemIndex].matchuid, Category = @Model.DataList[itemIndex].matchcategory})'" />
                                    </td>
                                }
                                else
                                {
                                    <td style="height:auto">
                                        <input type="button" value="Details" onclick="location.href='@Url.Action("GetDetails", "Case", new {caseId = Model.Case.Id, index = itemIndex})'" />
                                    </td>
                                    <td style="height:auto">
                                        <input type="button" value="Download" id="download" onclick="location.href='@Url.Action("DownloadPdf", "Case", new {caseId= Model.Case.Id, index = itemIndex })'" />
                                    </td>
                                }
                                <td>
                                    <textarea rows="2" asp-for="@Model.DataList[itemIndex].remarks" class="form-control" placeholder=@localizer["Remarks"]></textarea>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
                <input type="submit" value="Save Remarks" class="sas-button p-8-25 mr-2 color-white bg-color-2" onclick="saveRemarks(@Model.Case.Id)" />
            </div>
        }
    </div>
    <div class="card-footer">
    </div>
</div>

<!-- Modal -->
<!-- Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" role="dialog" aria-labelledby="docModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form role="form" id="frmTransferCase" class="form-horizontal" enctype="multipart/form-data" method="post">
                <div class="modal-header">
                    <h2>Transfer</h2>

                    <input type="hidden" name="CaseId" value="@Model.Case.Id" />
                    <input type="hidden" id="hdnTransferUserTransfer" name="TransferUser" value="" />
                    <input type="hidden" id="hdnRemarkTransfer" name="Comment" value="" />

                </div>
                <div class="modal-body">
                    <div class="col-4">
                        <div class="form-group">
                            <label>Transfer To (Officer)</label>
                            <select id="ddlUsers" class="form-control" name="UserId" asp-items="Model.Users">
                                <option value="0">--EMPTY--</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" id="btnTransfer" class="btn btn-primary">Transfer Case</button>
                </div>
            </form>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@localizer["Close"]</button>
            </div>
        </div>
    </div>


</div>

<!-- Modal -->
<div class="modal fade" id="docModal" tabindex="-1" role="dialog" aria-labelledby="docModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="docModalLabel">@localizer["Documents"]</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <ul>
                    @foreach (var item in Model.CaseDocuments)
                    {
                        <li><a href='/Case/DownloadCaseDocument?filePath=@item.DocumentFullPath&fileName=@item.DocumentFileName' download='@item.DocumentFileName'>@item.DocumentFileName</a></li>
                    }
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@localizer["Close"]</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var comments = [];
    $('#Comments').hide();
    $('#nocomment').show();

    $(document).ready(
        function () {
            $('#docSubmit').attr('disabled', true);
            $('input:file').change(function () {
                if ($(this).val()) {
                    $('#docSubmit').removeAttr('disabled');
                }
                else {
                    $('#docSubmit').attr('disabled', true);
                }
            });
        });

    $(document).ready(function () {

        if ($('#hdnStatus').val() == '2' || $('#hdnStatus').val() == '3') {
            $('#txtCaseActionRemarks').attr('disabled', 'disabled');
            $("input[type=submit]").attr('disabled', 'disabled');
            $('#ddlUsers').attr('disabled', 'disabled');
            $("#btnTransfer").attr('disabled', 'disabled');
        }

        $.ajax({
            url: '/case/comment/' + $('#hdnCaseId').val() + '?' + new Date().getTime(),
            type: 'get',
            success: function (response) {
                comments = response;
                buildComments();
            }
        });
    });


    $('#frmDocument').submit(function (e) {
        e.preventDefault();
        var formdata = new FormData();
        formdata.append('CaseId', $('#hdnCaseId').val());
        formdata.append('DocumentName', $('#txtDocNo').val());
        formdata.append('DocumentCategory', $('#ddlCategories').val());
        formdata.append('DocumentType', $('#ddlType').val());
        formdata.append('Document', $('#txtFile')[0].files[0]);
        formdata.append('Remarks', $('#txtRemarks').val());
        formdata.append('DocumentDetails', $('#txtDetails').val());
        formdata.append('IssuedDate', $('#txtIssuedDate').val());
        formdata.append('ExpiryDate', $('#txtExpiryDate').val());
        $.ajax({
            url: '/case/document',
            type: 'post',
            data: formdata,
            contentType: false,
            processData: false,
            success: function () {
                clearDocuemnt();
                toastr.success('Document Updated');
                location.reload();
            }
        });
    });
    function saveRemarks(id) {
        var model = new Array();
        $("#APITable TBODY TR").each(function (index) {
            var row = $(this);
            var result = {};
            result.matchuid = row.find("TD").eq(0).html();
            result.matchtype = row.find("TD").eq(1).html();
            result.matchcategory = row.find("TD").eq(2).html();
            result.matchname = row.find("TD").eq(3).html();
            result.matchcore = row.find("TD").eq(4).html();
            result.matchnationality = row.find("TD").eq(5).html();
            result.matchidno = row.find("TD").eq(6).html();
            result.matchdob = row.find("TD").eq(7).html();
            result.remarks = document.getElementById(`DataList_${index}__remarks`).value
            model.push(result);
        });


        $.ajax({
            url: '/case/saveRemark',
            type: 'post',
            //  contentType: 'application/json'
            data:
            {
                id: id,
                model: model
            },


            //     dataType: "json",
            success: function (response) {
                toastr.success(response);
            }
        });
    }

    $('#frmCmment').submit(function (e) {
        if ($('#txtCaseComment').val() == '') {
            alert("Enter any remark");
            return false;
        }
        e.preventDefault();
        $.ajax({
            url: '/case/comment',
            type: 'post',
            data: $('#frmCmment').serialize(),
            success: function (response) {
                comments = response;
                $('.commment-list').remove();
                buildComments();
            }
        });
    });
    $('#frmCloseCase').submit(function (e) {
        e.preventDefault();
        $('#hdnRemark').val($('#txtCaseActionRemarks').val());
        var val = $("input[type=submit][clicked=true]").val();
        if (val == 'Approve') {
            $('#hdnAction').val(2);
        } else if (val == 'Whitelist') {
            $('#hdnAction').val(1);
        }
        else if (val == 'Reject') {
            $('#hdnAction').val(3);
        }
        else if (val == 'Transfer Case') {
            $('#hdnTransferUser').val($("#ddlUsers option:selected").text());
            $('#hdnAction').val(4);
        }
        $.ajax({
            url: '/case/close',
            type: 'post',
            data: $('#frmCloseCase').serialize(),
            success: function (response) {
                $('#txtCaseActionRemarks').val('');
                $('#txtCaseActionRemarks').attr('disabled', 'disabled');
                $("input[type=submit]").attr('disabled', 'disabled');
                $('#ddlUsers').attr('disabled', 'disabled');
                $("#btnTransfer").attr('disabled', 'disabled');

                toastr.success(response);
                setTimeout(function () { location.href = '/case'; }, 3000);
                location.href = '/case';

            }
        });
    });

    $("#frmCloseCase input[type=submit]").click(function () {
        $("input[type=submit]", $(this).parents("form")).removeAttr("clicked");
        $(this).attr("clicked", "true");
    });

    $('#frmTransferCase').submit(function (e) {
        e.preventDefault();
        // location.href = "/case/assign";
        $('#hdnTransferUserTransfer').val($("#ddlUsers option:selected").text());
        $('#hdnRemarkTransfer').val($('#txtCaseActionRemarks').val());
        //$('#hdnRemarkTransfer').val($('#txtCaseComment').val());
        $.ajax({
            url: '/case/assign',
            type: 'post',
            data: $('#frmTransferCase').serialize(),
            success: function () {
                $('#ddlUsers').val(0);
                toastr.success('Case Transferred');
                setTimeout(function () { location.href = '/case'; }, 3000);
                location.href = '/case';
            }
        });
    });


    function buildComments() {
        if (comments.length) {
            $('#Comments').show();
            $('#nocomment').hide();
            var template = '<div class="commment-list"><i class="fas fa-user bg-green"></i><div class="timeline-item"><span class="time" ><i class="fas fa-clock"></i> <label class="time-ago"></label></span >' +
                '<h3 class="timeline-header no-border"><a class="a-user" href="#"></a>&nbsp;&nbsp;<label class="case-comment"></label></h3></div></div>';
            $("#Comments").find('div.comment-section').prepend(template);
            $.each(comments, function (i, v) {
                //if (i == 0) {
                //    setDataOnRow($("#Comments").find('div.timeline-item'), v, i);
                //} else {
                //var clonnedRow = $($("#Comments").find('div.timeline-item').first()).clone();
                setDataOnRow($(template), v, i);
                //if (i == 0) {
                //
                //}
            });
            $('#txtCaseComment').val('');
            //$($("#Comments").find('div.commment-list').last()).remove();
            //$($("#Comments").find('div.commment-list').parent()).append('<div><i class= "fas fa-clock bg-gray" ></i></div>')
            $($("#Comments").find('div.commment-list').last()).remove();
            $($("#Comments").find('i').last()).remove();
            $($("#Comments").find('div.commment-list').parent()).append('<div><i class= "fas fa-clock bg-gray" ></i></div>');
        }
    }

    function setDataOnRow(rowObject, v, i) {
        $(rowObject).find(".a-user").html(v.createdUser);
        $(rowObject).find(".time-ago").html(v.duration);
        $(rowObject).find(".case-comment").html(v.comment);
        $("#Comments").find('div.comment-section').prepend(rowObject);
    }
    function clearDocuemnt() {
        $('#frmDocument').find("input[type=text], textarea").val("");
        $('#frmDocument').find("input[type=file]").val(null);
        $('#frmDocument').find("select").val(0);
    }



</script>