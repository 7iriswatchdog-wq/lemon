@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = localizer["Case Details"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");

    var matchData = Model.DataList[Model.Index];
    var apiResult = Model.apiResultModels[0];
    string matchName = matchData.matchname;
    string matchType = matchData.matchtype;
    string matchIdNo = Convert.ToString(matchData.matchidno);
    string matchDob = Convert.ToString(matchData.matchdob);
    string matchNat = Convert.ToString(matchData.matchnationality);
    string remarks = Convert.ToString(matchData.remarks);
    string auditDate = DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss") + " UTC";
    string creationDate = Model.Case.CreatedOn?.ToString("dd-MM-yyyy HH:mm:ss") ?? "";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Loader -->
<div id="loadingdetails" style="display:flex;position:fixed;inset:0;background:rgba(255,255,255,.92);align-items:center;justify-content:center;z-index:9999;">
    <div class="kld"><div></div><div></div><div></div><div></div></div>
</div>

<style>
    html, body { font-family: 'Inter', Arial, sans-serif; background: #f5f5f5; color: #000; }
    
    .kld { display: inline-block; position: relative; width: 60px; height: 13px }
    .kld div { position: absolute; top: 1px; width: 11px; height: 11px; border-radius: 50%; background: #1a56db; animation-timing-function: cubic-bezier(0, 1, 1, 0) }
    .kld div:nth-child(1) { left: 6px; animation: k1 .6s infinite }
    .kld div:nth-child(2) { left: 6px; animation: k2 .6s infinite }
    .kld div:nth-child(3) { left: 26px; animation: k2 .6s infinite }
    .kld div:nth-child(4) { left: 46px; animation: k3 .6s infinite }
    @@keyframes k1 { 0% { transform: scale(0) } 100% { transform: scale(1) } }
    @@keyframes k3 { 0% { transform: scale(1) } 100% { transform: scale(0) } }
    @@keyframes k2 { 0% { transform: translate(0, 0) } 100% { transform: translate(19px, 0) } }

    .doc { 
        max-width: 900px; 
        margin: 0 auto; 
        padding: 0 40px 60px; 
        background: #fff; 
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-top: 24px;
        border-radius: 8px;
    }

    .topbar { 
        display: flex; 
        justify-content: flex-end; 
        gap: 8px; 
        padding: 20px 0; 
        margin-bottom: 10px;
    }

    .ph { 
        display: flex; 
        gap: 25px; 
        align-items: flex-start; 
        margin-bottom: 25px;
    }
    .ph-photo { 
        width: 100px; 
        height: 100px; 
        background: #fdfdfd; 
        border: 1px solid #eee;
        flex-shrink: 0; 
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94A3B8;
        border-radius: 50%;
    }
    .ph-info { flex: 1; }
    .ph-name { 
        font-size: 24px; 
        font-weight: 700; 
        color: #0F172A; 
        display: flex; 
        align-items: center; 
        gap: 12px;
        margin-bottom: 4px;
    }
    .ph-type { font-size: 15px; color: #64748B; font-weight: 500; }

    .pill { 
        display: inline-block; 
        padding: 2px 12px; 
        border-radius: 99px; 
        font-size: 11px; 
        font-weight: 700; 
        background: #3b82f6; 
        color: #fff;
        text-transform: uppercase;
    }
    .pill-red { background: #ef4444; }

    .sec-hdr { font-size: 16px; font-weight: 700; color: #000; margin: 30px 0 6px; text-transform: uppercase; letter-spacing: 0.025em; }
    .sec-line { border: 0; border-top: 2px solid #3b82f6; margin: 0 0 15px; opacity: 1; }

    .pd-table { width: 100%; border-collapse: collapse; }
    .pd-table td { padding: 8px 0; vertical-align: top; font-size: 14px; border-bottom: 1px solid #F1F5F9; }
    .pd-table tr:last-child td { border-bottom: none; }
    .pd-group { font-weight: 700; color: #0F172A; width: 180px; }
    .pd-field { color: #64748B; width: 160px; font-weight: 500; }
    .pd-val { color: #0F172A; font-weight: 500; }

    .grid-row { display: grid; grid-template-columns: 180px 1fr; gap: 10px; padding: 8px 0; font-size: 14px; border-bottom: 1px solid #F1F5F9; }
    .grid-row:last-child { border-bottom: none; }
    .grid-lbl { color: #64748B; font-weight: 500; }
    .grid-val { color: #0F172A; font-weight: 500; }

    .tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
    .tag-item { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; padding: 2px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; }

    .comp-table { width: 100%; border-collapse: collapse; margin-top: 10px; background: #F8FAFC; border-radius: 8px; overflow: hidden; }
    .comp-table th { background: #E2E8F0; padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; }
    .comp-table td { padding: 12px; font-size: 14px; color: #334155; border-bottom: 1px solid #E2E8F0; }
    .comp-table tr:last-child td { border-bottom: none; }
    .comp-val-match { color: #B91C1C; font-weight: 700; }
</style>

<div class="doc">
    <div class="topbar">
        <a asp-controller="Case" asp-action="process" asp-route-CaseId="@Model.Case.Id" class="details-back-btn">
            <button type="button" class="h-9 px-4 border rounded-md bg-white hover:bg-gray-50 transition-colors">
                <i class="fa fa-arrow-left mr-2"></i> Back
            </button>
        </a>
    </div>

    <!-- Profile Header -->
    <div class="ph">
        <div class="ph-photo">
            <i class="fa fa-user-circle fa-4x"></i>
        </div>
        <div class="ph-info">
            <div class="ph-name">
                @matchName
                <span class="pill">@matchType</span>
            </div>
            <div class="ph-type">Sanctions Match Report</div>
        </div>
    </div>

    <!-- Audit Stamp -->
    <div class="sec-hdr">Audit Stamp</div>
    <hr class="sec-line"/>
    <div class="grid-row">
        <span class="grid-lbl">Extraction Date:</span>
        <span class="grid-val">@auditDate</span>
    </div>

    <div class="grid-row">
        <span class="grid-lbl">Creation Date:</span>
        <span class="grid-val">@creationDate</span>
    </div>

    <!-- Match Key Details -->
    <div class="sec-hdr">Match Key Details</div>
    <hr class="sec-line"/>
    <table class="pd-table">
        <tr>
            <td class="pd-group">Core Identifiers</td>
            <td class="pd-field">Code / ID Number:</td>
            <td class="pd-val">@(string.IsNullOrEmpty(matchIdNo) ? "-" : matchIdNo)</td>
        </tr>
        <tr>
            <td></td>
            <td class="pd-field">Date Of Birth:</td>
            <td class="pd-val">@(string.IsNullOrEmpty(matchDob) ? "-" : matchDob)</td>
        </tr>
        <tr>
            <td></td>
            <td class="pd-field">Nationality:</td>
            <td class="pd-val">@(string.IsNullOrEmpty(matchNat) ? "-" : matchNat)</td>
        </tr>
        <tr>
            <td class="pd-group">System Metadata</td>
            <td class="pd-field">API Data ID (Uid):</td>
            <td class="pd-val">@apiResult.matchuid</td>
        </tr>
        <tr>
            <td></td>
            <td class="pd-field">API Ref Number:</td>
            <td class="pd-val">@apiResult.matchidnumber</td>
        </tr>
        <tr>
            <td class="pd-group">Analysis</td>
            <td class="pd-field">Remarks:</td>
            <td class="pd-val">@(string.IsNullOrEmpty(remarks) ? "-" : remarks)</td>
        </tr>
    </table>

    <!-- Aliases Section -->
    <div class="sec-hdr">Known Aliases</div>
    <hr class="sec-line"/>
    @if (apiResult.alias != null && apiResult.alias.Count > 0)
    {
        <div class="tag-list">
            @foreach (var item in apiResult.alias)
            {
                <span class="tag-item">@item</span>
            }
        </div>
    }
    else
    {
        <div style="font-size:14px; color:#64748B; font-style:italic;">No aliases recorded for this match.</div>
    }

    <!-- Comparison Section -->
    <div class="sec-hdr">Data Comparison</div>
    <hr class="sec-line"/>
    <div style="font-size: 14px; color: #64748B; margin-bottom: 12px;">Comparison between the matched sanction record and the provided client profile.</div>
    <table class="comp-table">
        <thead>
            <tr>
                <th>Field</th>
                <th>Screening Output</th>
                <th>Screening Input</th>
                @* <th>Sanction Record (Matched)</th>
                <th>Client Profile (Case Input)</th> *@
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="font-weight: 600;">ID Number</td>
                <td>@Model.Case.Id</td>
                <td class="comp-val-match">@matchIdNo</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Name</td>
                <td>@Model.Case.FirstName @Model.Case.MiddleName @Model.Case.LastName</td>
                <td class="comp-val-match">@matchName</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Date of Birth</td>
                <td>@(Model.Case.DOB == "1/1/0001 12:00:00 AM" ? "-" : Model.Case.DOB)</td>
                <td>@(string.IsNullOrEmpty(matchDob) ? "-" : matchDob)</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Nationality</td>
                <td>@(string.IsNullOrEmpty(Model.Case.Nationality) ? "-" : Model.Case.Nationality)</td>
                <td>@(string.IsNullOrEmpty(matchNat) ? "-" : matchNat)</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Id Number</td>
                <td>@(string.IsNullOrEmpty(matchIdNo) ? "-" : matchIdNo)</td>
                <td>@(string.IsNullOrEmpty(Model.Case.CustomerIdNumber) ? "-" : Model.Case.CustomerIdNumber)</td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function () {
        $("#loadingdetails").show();
    });

    $(window).on("load", function () {
        $("#loadingdetails").fadeOut("slow");
    });

    $('.details-back-btn').on('click', function () {
        $('#loadingdetails').show();
    });
</script>