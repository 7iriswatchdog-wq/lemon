         onclick="closeModalOnBackdrop(event, 'caseVersionModal')">

        <div class="bg-surface rounded-lg shadow-xl max-h-[80vh] overflow-y-auto m-4 w-full max-w-4xl"
             onclick="event.stopPropagation()">

            <!-- Header -->
            <div class="px-6 py-4 border-b border-bordercolor flex justify-between items-center">
                <h3 class="text-base font-bold text-textprimary">Case Versions</h3>

                <button onclick="closeModal('caseVersionModal')"
                        class="h-9 px-6 text-white rounded-md bg-red-600">
                    Close
                </button>
            </div>

            <!-- Body -->
            <div class="p-6 space-y-4">

                @{
                    var cases = Model.CustomerCaseData;
                    int casetotal = cases != null ? cases.Count : 0;

                    int casevisibleStartIndex = Math.Max(0, casetotal - 2); // show last 2
                }

                @if (cases != null && cases.Count > 0)
                {
                    for (int i = 0; i < casetotal; i++)
                    {
                        var item = cases[i];
                        bool hideInitially = i < casevisibleStartIndex;

                        DateTime dt;
                        var formattedDate = DateTime.TryParse(item.UpdatedOn, out dt)
                        ? dt.ToString("dd/MM/yyyy HH:mm:ss")
                        : item.UpdatedOn;

                        string statusText =
                        item.Status == 0 ? "Pending" :
                        item.Status == 1 ? "WhiteList" :
                        item.Status == 2 ? "Approved" :
                        item.Status == 3 ? "Rejected" :
                        item.Status == 4 ? "Pending with Senior Management" :
                        item.Status == 5 ? "Auto" :
                        item.Status == 6 ? "Scheduler Pending" :
                        item.Status == 7 ? "OnHold" : "-";

                        <div class="case-item @(hideInitially ? "hidden" : "") border border-bordercolor rounded-lg p-4 space-y-2">

                            <!-- Version -->
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio"
                                       name="caseVersion"
                                       value="@item.CustomerId"
                                       data-version="@item.Version"
                                       class="caseVersionRadio" />

                                <span class="text-sm font-bold text-textprimary">
                                    Version @item.Version
                                </span>
                            </label>

                            <!-- CustomerId -->
                            <div class="pl-6 text-sm text-textmuted">
                                <span class="font-semibold">CustomerId :</span> @item.CustomerId
                            </div>

                            <!-- Status -->
                            <div class="pl-6 text-sm text-textmuted">
                                <span class="font-semibold">Status :</span> @statusText
                            </div>

                            <!-- Updated -->
                            <div class="pl-6 text-xs text-textmuted">
                                <span class="font-semibold">Updated :</span>
                                @item.CreatedOn.ToString("dd/MM/yyyy HH:mm:ss")
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-sm text-textmuted">
                        No other versions available.
                    </div>
                }

            </div>

            <!-- Footer -->
            <div class="px-6 pb-6 flex justify-between">

                <button onclick="selectCaseVersion()"
                        class="bg-primary text-white font-bold text-xs h-9 px-6 rounded-md">
                    Select
