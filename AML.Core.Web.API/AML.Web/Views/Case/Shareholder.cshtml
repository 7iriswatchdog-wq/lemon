@model AML.ViewModel.ViewModels.CaseProcess.CaseProcessModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Manager - Case Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/plugins/jquery/jquery.min.js"></script>
       <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        /* Modal backdrop */
        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.5);
        }

        /* Transition for column width */
        .column-transition {
            transition: width 300ms, opacity 300ms;
        }
    </style>
    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }</style>
</head>
<body class="bg-slate-50/30 min-h-screen text-slate-900">

    <div class="p-4 sm:p-6 min-h-screen flex flex-col">
        <div id="loadingeffect" class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        </div>
    
    <div class="shrink-0 pb-4">
            <div class="flex items-center justify-between mb-2">
    <h1 class="text-lg font-black text-slate-900 tracking-tight uppercase mb-3">
       Shareholder Case Manager
    </h1>
                <a href="@(ViewBag.ReturnUrl ?? ("/case/Process/" + TempData["CorporateCaseId"]))"
                   class="bg-white border border-slate-200 shadow-sm hover:bg-slate-50 text-slate-700 font-bold h-10 px-5 rounded-md flex items-center gap-2 transition-colors text-sm">
                    Back
                </a>

            </div>

    <!-- Case Details Summary -->
    <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">

        <!-- Header -->
        <div class="flex justify-between items-start mb-5">
            <div class="flex items-center gap-2">
                <div class="h-4 w-1 bg-blue-600 rounded-full"></div>
                <h2 class="text-base font-bold text-slate-900 leading-none">
                    Case Details
                </h2>
            </div>

            <div class="flex gap-4">
                <a href="/case/Shareholder_PDF/@Model.Case.Id?download=true" target="_blank"
                   class="text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 tracking-tight">
                    Download PDF
                </a>
                <span class="h-4 w-px bg-blue-300"></span>
                <button onclick="document.getElementById('uploadModal').style.display = 'flex'"
                        class="text-[11px] font-bold text-blue-600 hover:text-blue-700 tracking-tight">
                    Upload Document
                </button>
            </div>
        </div>

        <!-- ROW 1 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mb-6">
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Customer ID</span>
                <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.CustomerId</span>
            </div>

            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Creation Date</span>
                <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.CreatedOnText</span>
            </div>
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Screening Options</span>
                <span id="screeningShort" class="text-sm font-bold text-slate-900 tracking-tight">@Model.Case.ScreeningOptions</span>
                <span id="screeningFull"
                                    class="absolute left-0 top-full mt-1 hidden
                        bg-white border shadow-md rounded-md
                        p-2 text-xs text-slate-700 z-50
                        whitespace-normal max-w-lg">
                                @(Model.Case.ScreeningOptions)
                            </span>
            </div>

           

            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Customer Name</span>
                <span class="text-[13px] font-medium text-slate-900 tracking-tight" truncate"
                      title="@($"{Model.Case.FirstName} {Model.Case.LastName}")">
                    @Model.Case.FirstName @Model.Case.LastName
                </span>
            </div>

           
        </div>

        <!-- ROW 2 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mb-6">
             <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Category</span>
                @if(Model.Case.CustomerType == "I")
                {
                <span class="text-[13px] font-medium text-slate-900 " >
                    Individual
                            </span>
                        }
                        else
                        {
                            <span class="text-[13px] font-medium text-slate-900">
                                Corporate
                            </span>
                        }
                    </div>
             <div class="flex flex-col space-y-1">
                  @if(Model.Case.CustomerType == "I")
                  {
                     <span class="text-[12px]  text-slate-400  tracking-tight">Nationality</span>
                  }
                  else
                  {
                     <span class="text-[12px]  text-slate-400  tracking-tight">Country Of Incorporation</span>
                  }
                  <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.Nationality</span>
            </div>
            <div class="flex flex-col space-y-1">
                 @if(Model.Case.CustomerType == "I")
                  {
                    <span class="text-[12px]  text-slate-400  tracking-tight">Date of Birth</span>
                  }
                  else
                  {
                    <span class="text-[12px]  text-slate-400  tracking-tight">Date of Registration</span>
                  }
                 <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.DOB</span>
            </div>

            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">ID Type</span>
                <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.CustomerIdType</span>
            </div>

           
           
            
        </div>

        <!-- ROW 3 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6">
             <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">ID Number</span>
                <span class="text-[13px] font-medium text-slate-900  truncate">@Model.Case.CustomerIdNumber</span>
            </div>
              <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Gender</span>
                <span class="text-[13px] font-medium text-slate-900 ">@Model.Case.Gender</span>
            </div>
            
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-slate-400  tracking-tight">ID Issue Date</span>
                            <span class="text-[13px] font-medium text-slate-900 tracking-tight">@(Model.Case.IdIssueDate?.ToString("dd/MM/yyyy") ?? "NA")</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-slate-400  tracking-tight">ID Expiry Date</span>
                            <span class="text-[13px] font-medium text-slate-900 tracking-tight">@(Model.Case.IdExpiryDate?.ToString("dd/MM/yyyy") ?? "NA")</span>
                        </div>

                    

            

            
        </div>

        <!-- DOCUMENTS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mt-6">
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Customer CIF No</span>
                <span class="text-[13px] text-slate-900 tracking-tight">@Model.Case.CIFNumber</span>
            </div>
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Match Parameter</span>
                <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.Threshold</span>
            </div>
                    @if(Model.Case.CustomerType == "I")
                    {
                      <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-slate-400  tracking-tight">Employer</span>
                            <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.Employer</span>
                      </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-slate-400  tracking-tight">Employer Industry</span>
                            <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.EmployerIndustry</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-slate-400  tracking-tight">Employer Sector</span>
                            <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.EmployerSector</span>
                        </div>
                      <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-slate-400  tracking-tight">Golden Visa</span>
                            <span class="text-[13px] font-medium text-slate-900 tracking-tight">@Model.Case.GoldenVisa</span>
                      </div>  
                    }
            
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mt-6">
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-slate-400  tracking-tight">Uploaded Documents</span>
                @foreach (var item in Model.CaseDocuments)
                {
                    var shortName = item.DocumentFileName?.Length > 12
                        ? item.DocumentFileName.Substring(0, 12) + "..."
                        : item.DocumentFileName;

                    <a href="/Case/DownloadCaseDocument?filePath=@item.DocumentFullPath&fileName=@item.DocumentFileName"
                       title="@item.DocumentFileName"
                       class="text-blue-600 text-xs font-semibold hover:underline">
                        @shortName
                    </a>
                }
            </div>
        </div>

    </div>
</div>
