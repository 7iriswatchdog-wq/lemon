                         // =====================================================================
                        // RUN COMPARISON
                        // =====================================================================
                        let _comparisonResults = {}; // uid → comparison object
                        let _caseData = null;
                        let _customerType = null;
                        let _currentCompareIdx = 0;
                        let _allCompareUids = [];

                        function _getCaseData() {
                            if (_caseData) return _caseData;
                            try { _caseData = JSON.parse(document.getElementById('caseCompareData').textContent); }
                            catch (e) { _caseData = {}; }
                            return _caseData;
                        }

                        // Normalise a name string: lowercase, collapse spaces, sort words for order-insensitive compare
                        function _normName(s) {
                            if (!s) return '';
                            return s.toLowerCase().replace(/[^a-z0-9 ]/g, '').trim().split(/\s+/).sort().join(' ');
                        }
                        function _normStr(s) { return (s || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
                        function _normDate(s) {
                            if (!s) return '';
                            // Try to extract YYYY-MM-DD or DD/MM/YYYY from various formats
                            const m = (s + '').match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
                            if (m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
                            const m2 = (s + '').match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
                            if (m2) return `${m2[3]}-${m2[2].padStart(2,'0')}-${m2[1].padStart(2,'0')}`;
                            // "26 Dec 1955" style
                            const months = {jan:'01',feb:'02',mar:'03',apr:'04',may:'05',jun:'06',jul:'07',aug:'08',sep:'09',oct:'10',nov:'11',dec:'12'};
                            const m3 = (s + '').match(/(\d{1,2})\s+([a-zA-Z]{3})\s+(\d{4})/);
                            if (m3) return `${m3[3]}-${months[m3[2].toLowerCase()]||'00'}-${m3[1].padStart(2,'0')}`;
                            return _normStr(s);
                        }
                        function _nameMatch(a, b) {
                            if (!a || !b) return false;
                            return _normName(a) === _normName(b);
                        }
                        function _strMatch(a, b) {
                            if (!a || !b) return false;
                            return _normStr(a) === _normStr(b);
                        }
                        function _dateMatch(a, b) {
                            if (!a || !b) return false;
                            return _normDate(a) === _normDate(b);
                        }
                        function _containsInList(caseVal, list) {
                            if (!caseVal || !list || !list.length) return false;
                            const cn = _normName(caseVal);
                            const cs = _normStr(caseVal);
                            return list.some(item => _normName(item) === cn || _normStr(item) === cs);
                        }
                        // Check if caseVal matches apiVal when apiVal may be a comma-separated list
                        function _multiContains(caseVal, apiVal) {
                            if (!caseVal || !apiVal) return false;
                            if (_normStr(caseVal) === _normStr(apiVal)) return true;
                            if (_normName(caseVal) === _normName(apiVal)) return true;
                            const parts = apiVal.split(',').map(p => p.trim()).filter(Boolean);
                            return parts.some(p => _normStr(p) === _normStr(caseVal) || _normName(p) === _normName(caseVal));
                        }

                        // Extract entity fields from a C6 bulk API result item.
                        // Actual response shape (personal/bulkid):
                        //   { id: 4848490, forename, middlename, surname, gender,
                        //     nationality: { nationality: "SUDAN" },
                        //     addresses: [{ country: { name: "SUDAN" } }],
                        //     identifiers: [], linkedBusinesses: [], aliases: [...] }
                        function _extractEntityFields(entity, isIndividual) {
                            if (!entity) return {};
                            if (isIndividual) {
                                // C6 uses forename/middlename/surname (all lowercase)
                                const forename = entity.forename || entity.firstName || entity.Forename || '';
                                const mid      = entity.middlename || entity.middleName || entity.Middlename || '';
                                const sur      = entity.surname || entity.lastName || entity.Surname || '';
                                const fullName = [forename, mid, sur].filter(Boolean).join(' ');

                                // nationality object: { nationality: "SUDAN" }
                                const natObj = entity.nationality || {};
                                const nat = natObj.nationality || natObj.name || natObj.Name || (typeof natObj === 'string' ? natObj : '');

                                const dob = entity.dateOfBirth || entity.DateOfBirth || entity.yearOfBirth || entity.YearOfBirth || '';
                                const gender = entity.gender || entity.Gender || '';

                                // identifiers: [{ category, value }]
                                const identifiers = (entity.identifiers || entity.Identifiers || [])
                                    .map(i => (i.value || i.Value || '').toString()).filter(Boolean);

                                // linkedBusinesses: [{ businessName/name }]
                                const linkedBizNames = (entity.linkedBusinesses || entity.LinkedBusinesses || [])
                                    .map(b => b.businessName || b.BusinessName || b.name || b.Name || '').filter(Boolean);

                                // addresses[].country.name — also check address4 which sometimes holds country
                                const addresses = (entity.addresses || entity.Addresses || []).map(a => {
                                    const c = a.country || a.Country;
                                    return (c ? (c.name || c.Name || '') : '') || a.address4 || a.Address4 || '';
                                }).filter(Boolean);

                                // Also include nationalitiesIsoCodes if present (from raw field)
                                const natCodes = (entity.nationalitiesIsoCodes || []);

                                return { fullName, nationality: nat, natCodes, dob, gender, identifiers, linkedBizNames, addresses };
                            } else {
                                // Corporate bulk response: flat object with businessName at top level.
                                // aliases[*].businessName holds alternative/previous names.
                                // linkedBusinesses[*].businessName holds linked entities.
                                // businessTypes is only in the nested `raw` string — parse it out if needed.
                                const bizName = entity.businessName || entity.BusinessName || entity.name || entity.Name || '';

                                // All names the entity is known by (primary + aliases)
                                const aliasNames = (entity.aliases || [])
                                    .map(a => a.businessName || a.BusinessName || a.alias || a.name || '').filter(Boolean);

                                const identifiers = (entity.identifiers || entity.Identifiers || [])
                                    .map(i => (i.value || i.Value || '').toString()).filter(Boolean);

                                // linkedBusinesses uses `businessName` in the flat response
                                const linkedBizNames = (entity.linkedBusinesses || entity.businessLinks || entity.LinkedBusinesses || [])
                                    .map(b => b.businessName || b.BusinessName || b.name || b.Name || '').filter(Boolean);

                                const addresses = (entity.addresses || entity.Addresses || []).map(a => {
                                    const c = a.country || a.Country;
                                    return (c ? (c.name || c.Name || '') : '') || a.address4 || a.Address4 || '';
                                }).filter(Boolean);

                                // businessTypes is on the flat response when present; also try to get from raw string
                                let bizTypes = (entity.businessTypes || entity.BusinessTypes || []);
                                if (!bizTypes.length && entity.raw) {
                                    try {
                                        const rawObj = JSON.parse(entity.raw);
                                        bizTypes = rawObj.businessTypes || rawObj.activities || [];
                                    } catch (_) {}
                                }

                                return { fullName: bizName, aliasNames, identifiers, linkedBizNames, addresses, bizTypes };
                            }
                        }

                        // Calculate score for individual
                        function _scoreIndividual(caseD, entity) {
                            const ef = _extractEntityFields(entity, true);
                            const nameM = caseD.fullName ? _nameMatch(caseD.fullName, ef.fullName) : null;
                            const dobM  = caseD.dob      ? _dateMatch(caseD.dob, ef.dob) : null;
                            const idM   = caseD.idNumber  ? _containsInList(caseD.idNumber, ef.identifiers) : null;
                            const empM  = caseD.employerName ? (_containsInList(caseD.employerName, ef.linkedBizNames) || _multiContains(caseD.employerName, ef.linkedBizNames.join(', '))) : null;
                            const cpM   = caseD.counterPartyName ? (_containsInList(caseD.counterPartyName, ef.linkedBizNames) || _multiContains(caseD.counterPartyName, ef.linkedBizNames.join(', '))) : null;

                            // Rule: if Name OR Date of Birth OR Employer Name matches → 100%
                            let base;
                            if (nameM === true || dobM === true || empM === true) {
                                base = 100;
                            } else {
                                const primaries = [nameM, dobM, idM, empM, cpM].filter(v => v !== null);
                                base = primaries.length > 0
                                    ? Math.round((primaries.filter(Boolean).length / primaries.length) * 100)
                                    : 0;
                            }

                            // Secondary deductions (-2% each mismatch where both sides have a value)
                            let deduct = 0;
                            if (caseD.nationality && (ef.nationality || ef.natCodes.length)) {
                                const cn = _normStr(caseD.nationality);
                                const natMatch = _strMatch(caseD.nationality, ef.nationality)
                                    || ef.natCodes.some(c => _normStr(c) === cn);
                                if (!natMatch) deduct += 2;
                            }
                            if (caseD.residenceCountry && ef.addresses.length && !ef.addresses.some(a => _strMatch(caseD.residenceCountry, a))) deduct += 2;
                            if (caseD.sowsofCountry && ef.addresses.length && !ef.addresses.some(a => _strMatch(caseD.sowsofCountry, a))) deduct += 2;
                            if (caseD.gender && ef.gender && !_strMatch(caseD.gender, ef.gender)) deduct += 2;

                            return { score: Math.max(0, Math.round(base - deduct)), entityFields: ef, matches: { nameM, dobM, idM, empM, cpM } };
                        }

                        // Calculate score for corporate
                        function _scoreCorporate(caseD, entity) {
                            const ef = _extractEntityFields(entity, false);

                            // Name match: check primary name AND all aliases (previous names / spelling variations)
                            let nameM = null;
                            if (caseD.fullName) {
                                nameM = _nameMatch(caseD.fullName, ef.fullName)
                                    || (ef.aliasNames || []).some(a => _nameMatch(caseD.fullName, a));
                            }

                            // Trade license: compare against all identifiers (IMO, OFAC ID, etc.)
                            const tlM = caseD.tradeLicenseNumber
                                ? _containsInList(caseD.tradeLicenseNumber, ef.identifiers)
                                : null;

                            // Counter party: compare against linked businesses
                            const cpM = caseD.counterPartyName
                                ? _containsInList(caseD.counterPartyName, ef.linkedBizNames)
                                : null;

                            // Any one primary field matching = 100%
                            const anyPrimaryMatch = (nameM === true || tlM === true || cpM === true);
                            let base = anyPrimaryMatch ? 100 : 0;

                            // Secondary deductions (-2% each where both sides have values and don't match)
                            let deduct = 0;
                            if (caseD.nationality && ef.addresses.length && !ef.addresses.some(a => _strMatch(caseD.nationality, a))) deduct += 2;
                            if (caseD.residence && ef.addresses.length && !ef.addresses.some(a => _strMatch(caseD.residence, a))) deduct += 2;
                            if (caseD.tradeLicenseAuthority && ef.identifiers.length && tlM === false) deduct += 2;
                            if (caseD.businessType && ef.bizTypes.length && !ef.bizTypes.some(bt => _strMatch(caseD.businessType, bt))) deduct += 2;

                            return { score: Math.max(0, Math.round(base - deduct)), entityFields: ef, matches: { nameM, tlM, cpM } };
                        }

                        // Build per-uid comparison row data
                        function _buildComparison(uid, entity, caseD, isIndividual) {
                            const scored = isIndividual ? _scoreIndividual(caseD, entity) : _scoreCorporate(caseD, entity);
                            const ef = scored.entityFields;
                            const rows = isIndividual ? [
                                { field: 'Full Name',          caseVal: caseD.fullName,           apiVal: ef.fullName,                       primary: true,   match: scored.matches.nameM },
                                { field: 'Nationality',        caseVal: caseD.nationality,         apiVal: [ef.nationality, ...ef.natCodes].filter(Boolean).join(' / '),  primary: false },
                                { field: 'Date of Birth',      caseVal: caseD.dob,                 apiVal: ef.dob,                            primary: true,   match: scored.matches.dobM },
                                { field: 'Gender',             caseVal: caseD.gender,              apiVal: ef.gender,                         primary: false },
                                { field: 'Residence Country',  caseVal: caseD.residenceCountry,    apiVal: ef.addresses.join(', '),           primary: false },
                                { field: 'SOW/SOF Country',    caseVal: caseD.sowsofCountry,       apiVal: ef.addresses.join(', '),           primary: false },
                                { field: 'ID Number',          caseVal: caseD.idNumber,            apiVal: ef.identifiers.join(', '),         primary: true,   match: scored.matches.idM },
                                { field: 'Employer Name',      caseVal: caseD.employerName,        apiVal: ef.linkedBizNames.join(', '),      primary: true,   match: scored.matches.empM },
                                { field: 'Employer Industry',  caseVal: caseD.employerIndustry,    apiVal: '',                                primary: false },
                                { field: 'Employer Sector',    caseVal: caseD.employerSector,      apiVal: '',                                primary: false },
                                { field: 'Counter Party',      caseVal: caseD.counterParty,        apiVal: '',                                primary: false },
                                { field: 'Counter Party Name', caseVal: caseD.counterPartyName,    apiVal: ef.linkedBizNames.join(', '),      primary: true,   match: scored.matches.cpM },
                                { field: 'Product/Svc Type',   caseVal: caseD.productServiceType,  apiVal: '',                                primary: false },
                                { field: 'Delivery Channel',   caseVal: caseD.deliveryChannel,     apiVal: '',                                primary: false },
                                { field: 'Golden Visa',        caseVal: caseD.goldenVisa,           apiVal: '',                                primary: false },
                                { field: 'Product Ref No',     caseVal: caseD.productRefNo,         apiVal: '',                                primary: false },
                            ] : [
                                { field: 'Company Name',            caseVal: caseD.fullName,              apiVal: ef.fullName,                     primary: true,  match: scored.matches.nameM },
                                { field: 'Country of Incorporation',caseVal: caseD.nationality,           apiVal: ef.addresses.join(', '),         primary: false },
                                { field: 'Residence',               caseVal: caseD.residence,             apiVal: ef.addresses.join(', '),         primary: false },
                                { field: 'Trade License Number',    caseVal: caseD.tradeLicenseNumber,    apiVal: ef.identifiers.join(', '),       primary: true,  match: scored.matches.tlM },
                                { field: 'Trade License Authority', caseVal: caseD.tradeLicenseAuthority, apiVal: '',                              primary: false },
                                { field: 'Business Activity',       caseVal: caseD.businessType,          apiVal: (ef.bizTypes||[]).concat(ef.linkedBizNames.length ? [] : []).join(', '), primary: false },
                                { field: 'Counter Party Name',      caseVal: caseD.counterPartyName,      apiVal: ef.linkedBizNames.join(', '),    primary: true,  match: scored.matches.cpM },
                                { field: 'Counter Party',           caseVal: caseD.counterParty,           apiVal: '',                              primary: false },
                                { field: 'Product/Svc Type',        caseVal: caseD.productServiceType,     apiVal: '',                              primary: false },
                                { field: 'Delivery Channel',        caseVal: caseD.deliveryChannel,        apiVal: '',                              primary: false },
                                { field: 'Product Ref No',          caseVal: caseD.productRefNo,            apiVal: '',                              primary: false },
                            ];
                            return { score: scored.score, rows, entity };
                        }

                        function _statusBadge(row) {
                            if (!row.caseVal && !row.apiVal) return '<span class="px-1.5 py-0.5 rounded text-[10px] bg-gray-100 text-gray-400">N/A</span>';
                            if (!row.apiVal) return '<span class="px-1.5 py-0.5 rounded text-[10px] bg-gray-100 text-gray-400">N/A</span>';
                            if (!row.caseVal) return '<span class="px-1.5 py-0.5 rounded text-[10px] bg-gray-100 text-gray-400">N/A</span>';
                            // Determine match: pre-computed true wins; pre-computed false can still be
                            // overridden if display strings match (handles comma-list vs joined-string cases).
                            let isMatch;
                            if (row.match === true) {
                                isMatch = true;
                            } else if (row.match === false) {
                                isMatch = _multiContains(row.caseVal, row.apiVal);
                            } else {
                                // null or undefined: compute on the fly
                                isMatch = _multiContains(row.caseVal, row.apiVal) || _nameMatch(row.caseVal, row.apiVal);
                            }
                            if (isMatch)
                                return '<span class="px-1.5 py-0.5 rounded text-[10px] bg-green-100 text-green-700 font-semibold">MATCH ✓</span>';
                            return '<span class="px-1.5 py-0.5 rounded text-[10px] bg-red-100 text-red-600 font-semibold">MISMATCH ✗</span>';
                        }

                        function _scoreColor(score) {
                            if (score >= 80) return 'text-green-600';
                            if (score >= 50) return 'text-amber-500';
                            return 'text-red-500';
                        }

                        async function runComparison() {
                            const caseD = _getCaseData();
                            const rows = Array.from(document.querySelectorAll('#searchResultsBody tr[data-matchuid]'));
                            const ids = rows.map(r => r.dataset.matchuid).filter(Boolean);
                            if (!ids.length) { alert('No search result IDs available.'); return; }

                            const btn = document.getElementById('btnRunComparison');
                            document.getElementById('btnRunComparisonText').textContent = 'Running…';
                            btn.disabled = true;

                            try {
                                const resp = await fetch('/case/RunComparison/' + caseD.caseId, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ ids })
                                });
                                const result = await resp.json();
                                if (!result.success) { alert('Comparison error: ' + result.error); return; }

                                _customerType = result.customerType;
                                const isIndividual = _customerType === 'I';
                                _comparisonResults = {};

                                // Parse the raw C6 JSON string directly to avoid serialization issues
                                let parsedC6;
                                try { parsedC6 = JSON.parse(result.rawData); } catch(e) { parsedC6 = {}; }
                                const dataArr = Array.isArray(parsedC6.results) ? parsedC6.results
                                    : Array.isArray(parsedC6) ? parsedC6
                                    : Object.values(parsedC6 || {});

                                console.log('[RunComparison] Row matchuids:', ids);
                                console.log('[RunComparison] API returned', dataArr.length, 'entities');

                                dataArr.forEach(item => {
                                    // qrCode is on the flat entity AND inside the raw JSON string
                                    const uid = (item.qrCode || item.id || item.Id || item.uid || '').toString();
                                    console.log('[RunComparison] entity uid:', uid, '| qrCode:', item.qrCode, '| id:', item.id);
                                    if (uid) _comparisonResults[uid] = _buildComparison(uid, item, caseD, isIndividual);
                                });

                                // Only show View buttons for rows that have a matching result
                                let matchedCount = 0;
                                rows.forEach(row => {
                                    const uid = row.dataset.matchuid;
                                    const viewBtn = row.querySelector('.compare-view-btn');
                                    const comp = _comparisonResults[uid];
                                    if (viewBtn && comp) {
                                        viewBtn.classList.remove('hidden');
                                        viewBtn.textContent = 'View (' + comp.score + '%)';
                                        viewBtn.className = viewBtn.className.replace(/text-primary|text-green-600|text-red-500|text-amber-500/g, '') + ' ' + _scoreColor(comp.score);
                                        matchedCount++;
                                    }
                                });

                                console.log('[RunComparison] Matched', matchedCount, 'of', rows.length, 'rows');

                                if (matchedCount === 0 && dataArr.length > 0) {
                                    console.warn('[RunComparison] UID mismatch: API returned entities but none matched row matchuids. Check browser console.');
                                    alert('Comparison data received but could not match entities to rows. Check browser console (F12) for details.');
                                } else if (dataArr.length === 0) {
                                    alert('No comparison data returned from the screening service for these IDs.');
                                }

                                if (matchedCount > 0) {
                                    document.getElementById('btnComparisonSummary').style.display = '';
                                }
                                document.getElementById('btnRunComparisonText').textContent = 'Re-run';
                            } catch (e) {
                                alert('Error calling comparison API: ' + e.message);
                                console.error('[RunComparison] exception:', e);
                            } finally {
                                btn.disabled = false;
                            }
                        }

                        function _renderCompareDetail(uid, name) {
                            const comp = _comparisonResults[uid];
                            if (!comp) return;
                            document.getElementById('cdm-name').textContent = name || uid;
                            const scoreEl = document.getElementById('cdm-score');
                            scoreEl.textContent = comp.score + '%';
                            scoreEl.className = 'text-[22px] font-black leading-none mt-0.5 ' + _scoreColor(comp.score);

                            const tbody = document.getElementById('cdm-tbody');
                            tbody.innerHTML = '';
                            comp.rows.forEach(row => {
                                const tr = document.createElement('tr');
                                tr.className = 'hover:bg-appbg transition-colors';
                                tr.innerHTML = `
                                    <td class="px-4 py-3 font-semibold text-textlabel whitespace-nowrap text-[11px]">
                                        ${row.primary ? '<span class="inline-block w-1.5 h-1.5 rounded-full bg-primary mr-1.5 align-middle"></span>' : '<span class="inline-block w-1.5 h-1.5 mr-1.5 align-middle"></span>'}${row.field}
                                    </td>
                                    <td class="px-4 py-3 text-textprimary text-[12px]">${row.caseVal || '<span class="text-textmuted italic text-[11px]">—</span>'}</td>
                                    <td class="px-4 py-3 text-textprimary text-[12px]">${row.apiVal || '<span class="text-textmuted italic text-[11px]">—</span>'}</td>
                                    <td class="px-4 py-3 text-center">${_statusBadge(row)}</td>
                                `;
                                tbody.appendChild(tr);
                            });

                            // Update nav
                            const navEl = document.getElementById('cdm-nav');
                            const idx = _allCompareUids.indexOf(uid);
                            _currentCompareIdx = idx;
                            if (_allCompareUids.length > 1) {
                                navEl.classList.remove('hidden');
                                document.getElementById('cdm-nav-label').textContent = (idx + 1) + ' / ' + _allCompareUids.length;
                                document.getElementById('cdm-prev').disabled = idx <= 0;
                                document.getElementById('cdm-next').disabled = idx >= _allCompareUids.length - 1;
                            } else {
                                navEl.classList.add('hidden');
                            }
                        }

                        function openCompareDetailModal(uid, name, idx) {
                            if (!_comparisonResults[uid]) { alert('Run Comparison first to view details.'); return; }
                            // Build ordered uid list from the table rows
                            _allCompareUids = Array.from(document.querySelectorAll('#searchResultsBody tr[data-matchuid]'))
                                .map(r => r.dataset.matchuid).filter(u => _comparisonResults[u]);
                            _renderCompareDetail(uid, name);
                            document.getElementById('compareDetailModal').style.display = 'flex';
                        }

                        function navigateCompare(dir) {
                            const newIdx = _currentCompareIdx + dir;
                            if (newIdx < 0 || newIdx >= _allCompareUids.length) return;
                            const uid = _allCompareUids[newIdx];
                            const row = document.querySelector(`#searchResultsBody tr[data-matchuid="${uid}"]`);
                            const name = row ? row.querySelector('td:nth-child(3)')?.textContent?.trim() : uid;
                            _renderCompareDetail(uid, name);
                        }

                        function openCompareSummaryModal() {
                            if (!Object.keys(_comparisonResults).length) { alert('Run Comparison first.'); return; }
                            const isIndividual = _customerType === 'I';

                            // Build dynamic headers based on first result's rows
                            const firstComp = Object.values(_comparisonResults)[0];
                            const fieldNames = firstComp.rows.map(r => r.field);

                            const thead = document.getElementById('csm-thead-row');
                            thead.innerHTML = '<th class="px-3 py-2.5 text-left min-w-[160px]">Match Name</th><th class="px-3 py-2.5 text-center min-w-[70px]">Score</th>'
                                + fieldNames.map(f => `<th class="px-3 py-2.5 text-center min-w-[90px] whitespace-nowrap">${f}</th>`).join('');

                            const tbody = document.getElementById('csm-tbody');
                            tbody.innerHTML = '';

                            // Walk all rows in the DataList order
                            document.querySelectorAll('#searchResultsBody tr[data-matchuid]').forEach(tr => {
                                const uid = tr.dataset.matchuid;
                                const name = tr.querySelector('td:nth-child(3)')?.textContent?.trim() || uid;
                                const comp = _comparisonResults[uid];
                                if (!comp) return;
                                const row = document.createElement('tr');
                                row.className = 'hover:bg-appbg transition-colors';
                                let cells = `<td class="px-3 py-2.5 font-semibold text-textprimary whitespace-nowrap">${name}</td>`;
                                cells += `<td class="px-3 py-2.5 text-center font-bold ${_scoreColor(comp.score)}">${comp.score}%</td>`;
                                comp.rows.forEach(r => { cells += `<td class="px-3 py-2.5 text-center">${_statusBadge(r)}</td>`; });
                                row.innerHTML = cells;
                                tbody.appendChild(row);
                            });

                            document.getElementById('compareSummaryModal').style.display = 'flex';
                        }

                        // Position the dropdown when opening
        function toggleSearchPopover(index) {
            const trigger = document.getElementById(`search-trigger-${index}`);
            const popover = document.getElementById(`search-popover-${index}`);

            if (!trigger || !popover) return;

            // Hide all other popovers
            document.querySelectorAll('[id^="search-popover-"]').forEach(p => {
                if (p !== popover) p.classList.add('hidden');
            });

            // Toggle current popover
            if (popover.classList.contains('hidden')) {
                // Move popover to body once to escape table stacking/overflow contexts
                if (popover.parentElement !== document.body) {
                    document.body.appendChild(popover);
                }

                const rect = trigger.getBoundingClientRect();
                const popoverWidth = 220;
                const margin = 8;
                // fixed positioning is viewport-relative — do NOT add window.scrollY/X
                let left = rect.left;
                // Clamp so it stays within viewport horizontally
                const maxLeft = window.innerWidth - popoverWidth - margin;
                if (left > maxLeft) left = Math.max(margin, maxLeft);
                if (left < margin) left = margin;

                popover.style.top = `${rect.bottom + 4}px`;
                popover.style.left = `${left}px`;
                popover.style.width = `${popoverWidth}px`;

                popover.classList.remove('hidden');
            } else {
                popover.classList.add('hidden');
            }
        }

        // Close any open Search Type popover on outside click, scroll or resize
        document.addEventListener('click', function (e) {
            if (e.target.closest('[id^="search-trigger-"]') || e.target.closest('[id^="search-popover-"]')) return;
            document.querySelectorAll('[id^="search-popover-"]').forEach(p => p.classList.add('hidden'));
        });
        window.addEventListener('scroll', function () {
            document.querySelectorAll('[id^="search-popover-"]').forEach(p => p.classList.add('hidden'));
        }, true);
        window.addEventListener('resize', function () {
            document.querySelectorAll('[id^="search-popover-"]').forEach(p => p.classList.add('hidden'));
        });
               </script>

