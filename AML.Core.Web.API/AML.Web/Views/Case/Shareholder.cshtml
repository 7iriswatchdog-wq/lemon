                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            @RenderShareholderTree(allShareholders, parent.CustomerId, mainCustomerId, Model.Case?.CustomerType, 1, isLast, new List<bool> { true }, renderedIds)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="p-4 text-center text-xs text-textmuted italic">No shareholders found</div>
                                }
