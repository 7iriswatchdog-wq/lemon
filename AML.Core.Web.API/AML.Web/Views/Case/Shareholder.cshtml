            const fullText = shortEl.innerText;
            const items = fullText.split(",");
            // If content is small → no tooltip, no trimming
            if (items.length <= maxItems) {
                return;
            }
            // Trim text
            const shortText = items.slice(0, maxItems).join(", ") + " etc…";
            shortEl.innerText = shortText;
            shortEl.classList.add("cursor-pointer");
            // Enable hover tooltip ONLY when trimmed
            shortEl.parentElement.addEventListener("mouseenter", () => {
                fullEl.classList.remove("hidden");
            });
            shortEl.parentElement.addEventListener("mouseleave", () => {
                fullEl.classList.add("hidden");
            });
        }
