<script>

                                $(document).ready(function () {

            const kyc6Options = [
                "Domestic PEP","Foreign PEP","REL","RRE","INS",
                "DD","GRI","SOE","UAE Sanction","UN Sanction",
                "Other Sanctions","VHNWI","None"
            ];

            const otherOptions = [
                "UAE Sanction","UN Sanction","Other Sanctions","None"
            ];

            let activeSearchRowIndex = null;
            let activeMatchType = null;
            let lockedKyc6Row = null;

            function initSearchTypeDropdown(rowIndex, matchType) {

                const trigger = $(`#search-trigger-${rowIndex}`);
                if (!trigger.length) return;

                const text = $(`#search-text-${rowIndex}`);
                const popover = $(`#search-popover-${rowIndex}`);
                const allCheckbox = $(`#search-all-${rowIndex}`);
                const optionsContainer = $(`#search-options-${rowIndex}`);
                const hiddenContainer = $(`#search-hidden-${rowIndex}`);
                const hiddenInput = $(`#searchTypesValue-${rowIndex}`);

                const normalizedMatchType = (matchType || "").trim().toUpperCase();

                const searchTypeOptions =
                    normalizedMatchType === "KYC6"
                        ? kyc6Options
                        : otherOptions;

                // ----------------------------
                // Parse selected values from hidden input
                let selected = [];
                const val = hiddenInput.val();

                if (val && val.trim() !== "" && val !== "null" && val !== "[]") {
                    try {
                        if (val.trim().startsWith("[")) {
                            selected = JSON.parse(val);
                        } else {
                            selected = val.split(",").map(x => x.trim());
                        }
                    } catch {
                        selected = [];
                    }
                }

                // ----------------------------
                // LOCK ROWS ON PAGE LOAD
                if (selected.length > 0) {
                    if (normalizedMatchType === "KYC6") {
                        lockedKyc6Row = rowIndex;
                    } else {
                        activeSearchRowIndex = rowIndex;
                        activeMatchType = normalizedMatchType;
                    }
                }

                // Populate dropdown
                optionsContainer.empty();
                searchTypeOptions.forEach(opt => {
                    const checked = selected.some(x => x.toLowerCase() === opt.toLowerCase()) ? "checked" : "";
                    optionsContainer.append(`
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="search-option" value="${opt}" ${checked}>
                            <label class="text-xs">${opt}</label>
                        </div>
                    `);
                });

                // ----------------------------
                function updateUI() {
                    if (selected.length === 0)
                        text.text("Select");
                    else if (selected.length === searchTypeOptions.length)
                        text.text("ALL");
                    else
                        text.text(selected.length + " selected");

                    hiddenContainer.empty();
                    selected.forEach(val => {
                        hiddenContainer.append(
                            `<input type="hidden" name="SearchTypes[${rowIndex}]" value="${val}">`
                        );
                    });
                    hiddenInput.val(selected.join(","));

                    // Trigger change for Alpine or other bindings
                    hiddenInput[0].dispatchEvent(new Event("change"));
                }

                // ----------------------------
                function updateRowDisableState() {
                    $("[id^='search-trigger-']").each(function () {
                        const idx = $(this).attr("id").split("-").pop();
                        const rowMatchType = ($(this).data("matchtype") || "").toString().trim().toUpperCase();
                        let disable = false;

                        // Lock KYC6 rows
                        if (lockedKyc6Row !== null && rowMatchType === "KYC6" && idx != lockedKyc6Row) {
                            disable = true;
                        }

                        // Lock Non-KYC6 rows
                        if (activeSearchRowIndex !== null && activeMatchType !== "KYC6" && rowMatchType !== "KYC6" && idx != activeSearchRowIndex) {
                            disable = true;
                        }

                        $(this)
                            .prop("disabled", disable)
                            .toggleClass("opacity-50 cursor-not-allowed", disable);
                    });
                }

                // ----------------------------
                // Checkbox change
                optionsContainer.find(".search-option").on("change", function () {
                    const val = $(this).val();

                    if ($(this).is(":checked")) {
                        if (!selected.includes(val)) selected.push(val);
                    } else {
                        selected = selected.filter(x => x !== val);
                    }

                    // Update locks dynamically
                    if (selected.length > 0) {
                        if (normalizedMatchType === "KYC6") {
                            lockedKyc6Row = rowIndex;
                        } else {
                            activeSearchRowIndex = rowIndex;
                            activeMatchType = normalizedMatchType;
                        }
                    } else {
                        if (normalizedMatchType === "KYC6") {
                            lockedKyc6Row = null;
                        } else {
                            activeSearchRowIndex = null;
                            activeMatchType = null;
                        }
                    }

                    allCheckbox.prop(
                        "checked",
                        selected.length === searchTypeOptions.length
                    );

                    updateRowDisableState();
                    updateUI();
                });

                // ALL checkbox
                allCheckbox.on("change", function () {
                    if ($(this).is(":checked"))
                        selected = [...searchTypeOptions];
                    else
                        selected = [];

                    optionsContainer.find(".search-option").each(function () {
                        $(this).prop("checked", selected.includes($(this).val()));
                    });

                    // Update locks dynamically
                    if (selected.length > 0) {
                        if (normalizedMatchType === "KYC6") {
                            lockedKyc6Row = rowIndex;
                        } else {
                            activeSearchRowIndex = rowIndex;
                            activeMatchType = normalizedMatchType;
                        }
                    } else {
                        if (normalizedMatchType === "KYC6") {
                            lockedKyc6Row = null;
                        } else {
                            activeSearchRowIndex = null;
                            activeMatchType = null;
                        }
                    }

                    updateRowDisableState();
                    updateUI();
                });

                // Dropdown toggle — delegate to toggleSearchPopover so popover is
                // portaled to <body> and positioned within viewport (avoids overlap with
                // the right Case Risk Assessment panel).
                trigger.on("click", function (e) {
                    if ($(this).prop("disabled")) return;
                    e.stopPropagation();
                    toggleSearchPopover(rowIndex);
                });

                // Close dropdown outside click
                $(document).on("click", function (e) {
                    if (!popover.is(e.target) && popover.has(e.target).length === 0 && !trigger.is(e.target)) {
                        popover.addClass("hidden");
                    }
                });

                // Set initial UI
                allCheckbox.prop("checked", selected.length === searchTypeOptions.length);
                updateRowDisableState();
                updateUI();
            }

            // ----------------------------
            // Razor initialization
            @if (Model.DataList != null && Model.DataList.Any())
            {
                        for (int i = 0; i < Model.DataList.Count; i++)
                        {
                                    var matchType = Model.DataList[i].matchtype ?? "";
                                    <text>initSearchTypeDropdown(@i, "@matchType");</text>
                        }
            }

            // ----------------------------
            // Pagination (optional)
            const searchResultsBody = document.getElementById("searchResultsBody");

            if (searchResultsBody) {
                const rows = Array.from(searchResultsBody.querySelectorAll("tr"));
                const rowsPerPage = 10;

                if (rows.length > rowsPerPage) {
                    const paginationControls = document.createElement("div");
                    paginationControls.className =
                        "flex justify-end gap-2 p-3 border-t border-bordercolor bg-appbg";
                    searchResultsBody.parentElement.parentElement.parentElement.appendChild(paginationControls);

                    let currentPage = 1;
                    const totalPages = Math.ceil(rows.length / rowsPerPage);

                    function showPage(page) {
                        currentPage = page;
                        rows.forEach((row, index) => {
                            row.style.display =
                                (index >= (page - 1) * rowsPerPage &&
                                 index < page * rowsPerPage) ? '' : 'none';
                        });
                        renderControls();
                    }

                    function renderControls() {
                        paginationControls.innerHTML = '';
                        const prevBtn = document.createElement("button");
                        prevBtn.innerText = "Prev";
                        prevBtn.disabled = currentPage === 1;
                        prevBtn.onclick = (e) => { e.preventDefault(); showPage(currentPage - 1); };
                        paginationControls.appendChild(prevBtn);

                        const pageInfo = document.createElement("span");
                        pageInfo.innerText = `Page ${currentPage} of ${totalPages}`;
                        paginationControls.appendChild(pageInfo);

                        const nextBtn = document.createElement("button");
                        nextBtn.innerText = "Next";
                        nextBtn.disabled = currentPage === totalPages;
                        nextBtn.onclick = (e) => { e.preventDefault(); showPage(currentPage + 1); };
                        paginationControls.appendChild(nextBtn);
                    }

                    showPage(1);
                }
            }
        });
</script>
