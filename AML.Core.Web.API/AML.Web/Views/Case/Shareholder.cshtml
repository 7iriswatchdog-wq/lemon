                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.Employer</span>
                      </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">Employer Industry</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.EmployerIndustry</span>
                        </div>
