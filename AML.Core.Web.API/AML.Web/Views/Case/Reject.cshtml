@{
    ViewData["Title"] = " Case View";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<script src="~/plugins/jquery/jquery.min.js"></script>
<style>
    div {
        margin-bottom: 10px;
    }

    label {
        display: inline-block;
        width: 150px;
    }

    input {
        padding: 5px 10px;
    }
</style>
<div class="card card-primary">
    <div class="card-body">
        <h3>Part 1   Report Details</h3>
        <div class="row">
            <label class="col-sm-4" for="txtreportType">    1.1  Report Type </label>
            <input type="text" class="col-sm-8" id="txtreportType" title="This field is mandatory" placeholder="Report Type">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtSTRRef">    1.2  STR Reference No  </label>
            <input type="text" class="col-sm-8" id="txtSTRRef" placeholder="STR Reference No">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtFIURef">    1.3  FIU Reference No  </label>
            <input type="text" class="col-sm-8" id="txtFIURef" placeholder="FIU Reference No">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtSubDate">   1.4  Submission Date  </label>
            <input type="text" class="col-sm-8" id="txtSubDate" placeholder="Submission Date">
        </div>
        <h3>Part 2   Information on Reporting Entity/Person</h3>
        <h4>2.1.A   Reporting Entity Details</h4>
        <div class="row">
            <label class="col-sm-4" for="txtBusType">Business Type  </label>
            <input type="text" class="col-sm-8" id="txtBusType" title="This field is mandatory" placeholder="Business Type">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtRepEntName">Name of Reporting Entity </label>
            <input type="text" class="col-sm-8" id="txtRepEntName" placeholder="Name of Reporting Entity">
        </div>
        <h4>2.1.B   Particulars of the money Laundering Reporting Officer/ Contact Person</h4>
        <div class="row">
            <label class="col-sm-4" for="txtOfficerName">   Name </label>
            <input type="text" class="col-sm-8" id="txtOfficerName" placeholder="Name of Reporting Officer">
        </div>
        <h3>Part 3  Information on Suspicion</h3>
        <h4>3.1   Indicators</h4>
        <div class="row">
            <label class="col-sm-4" for="txtINTTYPOFF1">IN/TYP/OFF 1 </label>
            <input style="display:inline-block" type="text" class="col-sm-8" id="txtINTTYPOFF1" placeholder="IN/TYP/OFF 1">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtINTTYPOFF2">IN/TYP/OFF 2 </label>
            <input type="text" class="col-sm-8" id="txtINTTYPOFF2" placeholder="IN/TYP/OFF 2">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtINTTYPOFF3">IN/TYP/OFF 3 </label>
            <input type="text" class="col-sm-8" id="txtINTTYPOFF3" placeholder="IN/TYP/OFF 3">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtINTTYPOFF4">IN/TYP/OFF 4 </label>
            <input type="text" class="col-sm-8" id="txtINTTYPOFF4" placeholder="IN/TYP/OFF 4">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtINTTYPOFF5">IN/TYP/OFF 5 </label>
            <input type="text" class="col-sm-8" id="txtINTTYPOFF5" placeholder="IN/TYP/OFF 5">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtINTTYPOFF6">IN/TYP/OFF 6 </label>
            <input type="text" class="col-sm-8" id="txtINTTYPOFF6" placeholder="IN/TYP/OFF 6">
        </div>
        <p><b>Please provide details for "Others"</b></p>
        <textarea rows="2" class="col-sm-8" id="txtRemarks" name="Details" placeholder="Details"></textarea>
        <h4>3.2  Description of Suspicious Activity</h4>
        <p>Critical Section</p>
        <p>
            <b>
                DESCRIBE CLEARLY AND COMPLETELY THE FACTS OR UNUSUAL CIRCUMSTANCES THAT LED TO THE SUSPICION OF MONEY LAUNDERING
                FINANCING.THIS SECTION IS CRITICAL IN DETERMINING IF THE DESCRIBED CONDUCT AND ITS POSSIBLE CRIMINAL
                NATURE ARE CLEARLY UNDERSTOOD
            </b>
        </p>
        <p>
            If this field does not provide sufficient space,please report a hort summary alongside a document attachment to the
            report providing details of the suspicious activity
        </p>

        <textarea rows="6" class="col-sm-8" id="txtDescSuspAct" name="Description" placeholder="Description of suspicious activity"></textarea>

        <h3>Part 4  Description of Action Taken</h3>
        <p>
            <b>
                4.1     What Action was or will be taken as a result of this Suspicious Transaction(s). Pleaae also state if the suspect  made
                any voluntary statement as to the origin or source of the proceeds,kindly enclose copy of the statement,if any.
            </b>
        </p>
        <p>
            If this field does not provide sufficient space,pleaae report a short summary alongside a document attachment to the report
            "action taken" on the suspicious activity
        </p>

        <textarea rows="6" class="col-sm-8" id="txtActionTaken" name="AcitionTaken" placeholder="Description of action taken"></textarea>
        <h3>Part 5      Transaction Details</h3>
        <div class="row">
            <label class="col-sm-4" for="txtTrsnNo">5.1 Transaction No </label>
            <input type="text" class="col-sm-8" id="txtTrsnNo" placeholder="Transaction No.">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtIntRefNo">5.2 Internal Reference Number </label>
            <input type="text" class="col-sm-8" id="txtIntRefNo" placeholder="Internal Reference No.">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTypeofTrsn">5.3 Type of Transaction </label>
            <input type="text" class="col-sm-8" id="txtIntRefNo" placeholder="Type of Transaction">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtDateTrsnDet">5.4    Date Transaction detected </label>
            <input type="text" class="col-sm-8" id="txtDateTrsnDet" placeholder="Date Transaction detected">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtCurType">5.5    Currency Type </label>
            <input type="text" class="col-sm-8" id="txtCurType" placeholder="Currency Type">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtExchRate">5.6   Exchange Rate </label>
            <input type="text" class="col-sm-8" id="txtExchRate" placeholder="Exchange Rate">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtSuspctAmt">5.7  Suspected Amount </label>
            <input type="text" class="col-sm-8" id="txtSuspctAmt" placeholder="Suspected Amount">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTransExcBy">5.8     Transaction Executed By </label>
            <input type="text" class="col-sm-8" id="txtTransExcBy" placeholder="Transaction Executed By">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTransApprBy">5.9    Transaction Approved By </label>
            <input type="text" class="col-sm-8" id="txtTransApprBy" placeholder="Transaction Executed By">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtBrExcTrans">5.10    Branch Executing Transaction </label>
            <input type="text" class="col-sm-8" id="txtBrExcTrans" placeholder="Branch Executing Transaction">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTransPrps">5.11 Purpose of Transaction </label>
            <input type="text" class="col-sm-8" id="txtTransPrps" placeholder="Purpose of Transaction">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTransCom">5.12  Transaction Comments </label>
            <input type="text" class="col-sm-8" id="txtTransCom" placeholder="Transaction Comments">
        </div>

        <h3>Part 6  Account Details</h3>
        <div class="row">
            <label class="col-sm-4" for="txtTrsnNo">6.1 Transaction No </label>
            <input type="text" class="col-sm-8" id="txtTrsnNo" placeholder="Transaction No.">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtAccNo">6.2  Account No </label>
            <input type="text" class="col-sm-8" id="txtAccNo" placeholder="Account No.">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtAccType">6.3    Account Type </label>
            <input type="text" class="col-sm-8" id="txtAccType" placeholder="Account Type">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtAccCur">6.4     Account Currency </label>
            <input type="text" class="col-sm-8" id="txtAccCur" placeholder="Account Currency">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtAmt">6.5    Amount </label>
            <input type="text" class="col-sm-8" id="txtAmt" placeholder="Amount">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtExchRate">6.6   Exchange Rate </label>
            <input type="text" class="col-sm-8" id="txtExchRate" placeholder="Exchange Rate">
        </div>
        <h3>Part 7  INVOLVED PARTY</h3>
        <div class="row">
            <label class="col-sm-4" for="txtInvTrnsNo">7.1  TRANSACTION NO </label>
            <input type="text" class="col-sm-8" id="txtInvTrnsNo" placeholder="Transaction No">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtType">7.2   Type </label>
            <input type="text" class="col-sm-8" id="txType" placeholder="Type">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtProf">7.3   Profession </label>
            <input type="text" class="col-sm-8" id="txtProf" placeholder="Profession">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtCountry">7.4    Country </label>
            <input type="text" class="col-sm-8" id="txtCountry" placeholder="Country">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtCity">7.5   City </label>
            <input type="text" class="col-sm-8" id="txtCity" placeholder="City">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTelNum">7.6   Tel. Number </label>
            <input type="text" class="col-sm-8" id="txtTelNum" placeholder="Tel. Number">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtBankName">7.7   Bank Name </label>
            <input type="text" class="col-sm-8" id="txtBankName" placeholder="Bank Name">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtAccNum">7.8    Account Number </label>
            <input type="text" class="col-sm-8" id="txtAccNum" placeholder="Account Number">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtIBAN">7.9   IBAN </label>
            <input type="text" class="col-sm-8" id="txtIBAN" placeholder="IBAN">
        </div>
        <h3>Part 8  Person Details</h3>
        <div class="row">
            <label class="col-sm-4" for="txtTransNo">Transaction No. </label>
            <input type="text" class="col-sm-8" id="txtTransNo" placeholder="Transaction No.">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtRole">Role </label>
            <input type="text" class="col-sm-8" id="txtRole" placeholder="Role">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtFundType">Funds Type </label>
            <input type="text" class="col-sm-8" id="txtFundType" placeholder="Funds Type">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtPerCountry">Country </label>
            <input type="text" class="col-sm-8" id="txtPerCountry" placeholder="Country">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtGender">Gender </label>
            <input type="text" class="col-sm-8" id="txtGender" placeholder="Gender">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtFirstName">First Name </label>
            <input type="text" class="col-sm-8" id="txtFirstName" placeholder="First Name">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtLasttName">Last Name </label>
            <input type="text" class="col-sm-8" id="txtLastName" placeholder="Last Name">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtStreetAddr">Street Address </label>
            <input type="text" class="col-sm-8" id="txtStreetAddr" placeholder="Street Address">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtCity">City </label>
            <input type="text" class="col-sm-8" id="txtCity" placeholder="City">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtCountry">Country </label>
            <input type="text" class="col-sm-8" id="txtCountry" placeholder="Country">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtTelNum">Telephone Number </label>
            <input type="text" class="col-sm-8" id="txtTelNum" placeholder="Telephone Number">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtDOB">Date of Birth </label>
            <input type="text" class="col-sm-8" id="txtDOB" placeholder="Date of Birth">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtNationality">Nationality </label>
            <input type="text" class="col-sm-8" id="txtNationality" placeholder="Nationality">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtResidence">Residence </label>
            <input type="text" class="col-sm-8" id="txtResidence" placeholder="Residence">
        </div>
        <div class="row">
            <label class="col-sm-4" for="txtIdentifier">Identifier </label>
            <input type="text" class="col-sm-8" id="txtIdentifier" placeholder="Identifier">
        </div>
        <input type="button" value="Print" onclick="window.print()" />
    </div>
    <div class="card-footer">

    </div>
</div>
