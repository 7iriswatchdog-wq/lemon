@{
    ViewData["Title"] = " Case View";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<script src="~/plugins/jquery/jquery.min.js"></script>

<div class="bg-surface rounded-lg border border-bordercolor p-6 shadow-none max-w-4xl mx-auto my-6">
    <div class="">
        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 1   Report Details</h3>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtreportType">    1.1  Report Type </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtreportType" title="This field is mandatory" placeholder="Report Type">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtSTRRef">    1.2  STR Reference No  </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtSTRRef" placeholder="STR Reference No">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtFIURef">    1.3  FIU Reference No  </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtFIURef" placeholder="FIU Reference No">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtSubDate">   1.4  Submission Date  </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtSubDate" placeholder="Submission Date">
        </div>
        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 2   Information on Reporting Entity/Person</h3>
        <h4 class="text-[14px] font-bold text-textprimary mt-6 mb-3">2.1.A   Reporting Entity Details</h4>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtBusType">Business Type  </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtBusType" title="This field is mandatory" placeholder="Business Type">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtRepEntName">Name of Reporting Entity </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtRepEntName" placeholder="Name of Reporting Entity">
        </div>
        <h4 class="text-[14px] font-bold text-textprimary mt-6 mb-3">2.1.B   Particulars of the money Laundering Reporting Officer/ Contact Person</h4>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtOfficerName">   Name </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtOfficerName" placeholder="Name of Reporting Officer">
        </div>
        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 3  Information on Suspicion</h3>
        <h4 class="text-[14px] font-bold text-textprimary mt-6 mb-3">3.1   Indicators</h4>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtINTTYPOFF1">IN/TYP/OFF 1 </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtINTTYPOFF1" placeholder="IN/TYP/OFF 1">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtINTTYPOFF2">IN/TYP/OFF 2 </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtINTTYPOFF2" placeholder="IN/TYP/OFF 2">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtINTTYPOFF3">IN/TYP/OFF 3 </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtINTTYPOFF3" placeholder="IN/TYP/OFF 3">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtINTTYPOFF4">IN/TYP/OFF 4 </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtINTTYPOFF4" placeholder="IN/TYP/OFF 4">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtINTTYPOFF5">IN/TYP/OFF 5 </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtINTTYPOFF5" placeholder="IN/TYP/OFF 5">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtINTTYPOFF6">IN/TYP/OFF 6 </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtINTTYPOFF6" placeholder="IN/TYP/OFF 6">
        </div>
        <p><b>Please provide details for "Others"</b></p>
        <textarea rows="2" class="w-full rounded-lg border border-bordercolor px-3 py-2 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtRemarks" name="Details" placeholder="Details"></textarea>
        <h4 class="text-[14px] font-bold text-textprimary mt-6 mb-3">3.2  Description of Suspicious Activity</h4>
        <p>Critical Section</p>
        <p>
            <b>
                DESCRIBE CLEARLY AND COMPLETELY THE FACTS OR UNUSUAL CIRCUMSTANCES THAT LED TO THE SUSPICION OF MONEY LAUNDERING
                FINANCING.THIS SECTION IS CRITICAL IN DETERMINING IF THE DESCRIBED CONDUCT AND ITS POSSIBLE CRIMINAL
                NATURE ARE CLEARLY UNDERSTOOD
            </b>
        </p>
        <p>
            If this field does not provide sufficient space,please report a hort summary alongside a document attachment to the
            report providing details of the suspicious activity
        </p>

        <textarea rows="6" class="w-full rounded-lg border border-bordercolor px-3 py-2 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtDescSuspAct" name="Description" placeholder="Description of suspicious activity"></textarea>

        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 4  Description of Action Taken</h3>
        <p>
            <b>
                4.1     What Action was or will be taken as a result of this Suspicious Transaction(s). Pleaae also state if the suspect  made
                any voluntary statement as to the origin or source of the proceeds,kindly enclose copy of the statement,if any.
            </b>
        </p>
        <p>
            If this field does not provide sufficient space,pleaae report a short summary alongside a document attachment to the report
            "action taken" on the suspicious activity
        </p>

        <textarea rows="6" class="w-full rounded-lg border border-bordercolor px-3 py-2 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtActionTaken" name="AcitionTaken" placeholder="Description of action taken"></textarea>
        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 5      Transaction Details</h3>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTrsnNo">5.1 Transaction No </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTrsnNo" placeholder="Transaction No.">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtIntRefNo">5.2 Internal Reference Number </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtIntRefNo" placeholder="Internal Reference No.">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTypeofTrsn">5.3 Type of Transaction </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtIntRefNo" placeholder="Type of Transaction">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtDateTrsnDet">5.4    Date Transaction detected </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtDateTrsnDet" placeholder="Date Transaction detected">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtCurType">5.5    Currency Type </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtCurType" placeholder="Currency Type">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtExchRate">5.6   Exchange Rate </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtExchRate" placeholder="Exchange Rate">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtSuspctAmt">5.7  Suspected Amount </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtSuspctAmt" placeholder="Suspected Amount">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTransExcBy">5.8     Transaction Executed By </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTransExcBy" placeholder="Transaction Executed By">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTransApprBy">5.9    Transaction Approved By </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTransApprBy" placeholder="Transaction Executed By">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtBrExcTrans">5.10    Branch Executing Transaction </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtBrExcTrans" placeholder="Branch Executing Transaction">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTransPrps">5.11 Purpose of Transaction </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTransPrps" placeholder="Purpose of Transaction">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTransCom">5.12  Transaction Comments </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTransCom" placeholder="Transaction Comments">
        </div>

        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 6  Account Details</h3>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTrsnNo">6.1 Transaction No </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTrsnNo" placeholder="Transaction No.">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtAccNo">6.2  Account No </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtAccNo" placeholder="Account No.">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtAccType">6.3    Account Type </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtAccType" placeholder="Account Type">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtAccCur">6.4     Account Currency </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtAccCur" placeholder="Account Currency">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtAmt">6.5    Amount </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtAmt" placeholder="Amount">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtExchRate">6.6   Exchange Rate </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtExchRate" placeholder="Exchange Rate">
        </div>
        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 7  INVOLVED PARTY</h3>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtInvTrnsNo">7.1  TRANSACTION NO </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtInvTrnsNo" placeholder="Transaction No">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtType">7.2   Type </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txType" placeholder="Type">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtProf">7.3   Profession </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtProf" placeholder="Profession">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtCountry">7.4    Country </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtCountry" placeholder="Country">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtCity">7.5   City </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtCity" placeholder="City">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTelNum">7.6   Tel. Number </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTelNum" placeholder="Tel. Number">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtBankName">7.7   Bank Name </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtBankName" placeholder="Bank Name">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtAccNum">7.8    Account Number </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtAccNum" placeholder="Account Number">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtIBAN">7.9   IBAN </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtIBAN" placeholder="IBAN">
        </div>
        <h3 class="text-lg font-semibold text-textprimary tracking-tight mt-8 mb-4 border-b border-bordercolor pb-2">Part 8  Person Details</h3>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTransNo">Transaction No. </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTransNo" placeholder="Transaction No.">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtRole">Role </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtRole" placeholder="Role">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtFundType">Funds Type </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtFundType" placeholder="Funds Type">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtPerCountry">Country </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtPerCountry" placeholder="Country">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtGender">Gender </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtGender" placeholder="Gender">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtFirstName">First Name </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtFirstName" placeholder="First Name">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtLasttName">Last Name </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtLastName" placeholder="Last Name">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtStreetAddr">Street Address </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtStreetAddr" placeholder="Street Address">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtCity">City </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtCity" placeholder="City">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtCountry">Country </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtCountry" placeholder="Country">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtTelNum">Telephone Number </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtTelNum" placeholder="Telephone Number">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtDOB">Date of Birth </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtDOB" placeholder="Date of Birth">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtNationality">Nationality </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtNationality" placeholder="Nationality">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtResidence">Residence </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtResidence" placeholder="Residence">
        </div>
        <div class="space-y-1 mb-4">
            <label class="text-[13px] font-medium text-textlabel" for="txtIdentifier">Identifier </label>
            <input type="text" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors" id="txtIdentifier" placeholder="Identifier">
        </div>
        <button type="button" class="h-12 px-6 rounded-lg bg-primary hover:bg-primary-hover text-white font-medium text-[14px] transition-colors shadow-none" onclick="window.print()">Print Report</button>
    </div>
    <div class="mt-8 border-t border-bordercolor pt-4 flex justify-end">

    </div>
</div>
