    <!-- Evidence -->
    @if (hasArticles)
    {
        <div class="sec-hdr" style="margin-top:28px;">Evidence</div>
        <hr class="sec-line"/>
        <div class="ds-subtitle">
            Evidence
            <span class="ds-badge-cnt">@artCount</span>
        </div>
        @foreach (var art in articles)
        {
            evNum++;
                DateTime dt;
                string artCapt = DateTime.TryParse(art.DateCollected, out dt)
                ? dt.ToString("dd/MM/yyyy")
                : "";
            //string artCapt   = Convert.ToString(art.DateCollected.toString("dd/mm/yyyy"))??"";
            string artPub    = Convert.ToString(art.DatePublished)??"";
            string artTitle  = art.EvidenceId ?? (art.Snippet != null ? Convert.ToString(art.Snippet.Title) : "");
            
            // If evidenceId is present in relEntries, we might want to prioritize it or use it as Title
            // In the JSON, articles have originalURL, snippet (title, summary), dateCollected.
            // The RelEntries events have evidenceIds which link to articles.
            
            string artUrl    = Convert.ToString(art.OriginalURL)??"";
            string artSumm   = art.Snippet!=null?(Convert.ToString(art.Snippet.Summary)??""):"";
            string artCred   = Convert.ToString(art.CredibilityScore)??"";
            string artCatRaw = (art.Categories!=null&&art.Categories.Count>0)?(Convert.ToString(art.Categories[0].Name)??""):"";
            string artCode   = dsCode(artCatRaw);
            string artBadge  = artCode=="REL"?"pill-rel":artCode=="SAN"?"pill-san":artCode=="PEP"?"pill-pep":artCode=="ID"?"pill-id":artCode=="AM"?"pill-am":"pill-gray";

            <div style="margin-bottom:35px;">
                @if(!string.IsNullOrEmpty(artCapt)){<div class="grid-row"><span class="grid-lbl">Captured</span><span class="grid-val">@artCapt</span></div>}
                @if(!string.IsNullOrEmpty(artPub)){<div class="grid-row"><span class="grid-lbl">Published</span><span class="grid-val">@artPub</span></div>}
                @if(!string.IsNullOrEmpty(artTitle)){<div class="grid-row"><span class="grid-lbl">Title</span><span class="grid-val">@artTitle</span></div>}
                @if(!string.IsNullOrEmpty(artUrl)){<div class="grid-row"><span class="grid-lbl">Source</span><span class="grid-val"><a href="@artUrl" target="_blank" class="cp-link">&copy; @artUrl</a></span></div>}
                @if(!string.IsNullOrEmpty(artCode) || (art.Datasets != null && art.Datasets.Count > 0)){
                    <div class="grid-row"><span class="grid-lbl">Datasets</span><span class="grid-val">
                        @if(art.Datasets != null && art.Datasets.Count > 0) { 
                            @foreach(var d in art.Datasets) { 
                                string dlc = d == "ID" ? "pill-id" : d == "REL" ? "pill-rel" : d == "SAN" ? "pill-san" : d == "PEP" ? "pill-pep" : d == "AM" ? "pill-am" : "pill-gray";
                                <span class="pill @dlc" style="margin-right:4px;">@d</span> 
                            }
                        } else { <span class="pill @artBadge">@artCode</span> }
                    </span></div>
                }
                @if(!string.IsNullOrEmpty(artSumm)){<div class="grid-row"><span class="grid-lbl">Summary</span><span class="grid-val cp-text">@artSumm</span></div>}
                @if(!string.IsNullOrEmpty(artCred)){
                    string credInfo = artCred == "High" ? "The information was published by an official government or institutional source" : (artCred == "Medium" ? "The information was published by a reputable media source with evidence of official action" : "");
                    <div class="grid-row"><span class="cp-cred-lbl" style="font-weight:700;">@artCred Credibility Score</span><span class="grid-val cp-text">@credInfo</span></div>
                }
            </div>
        }
    }

    <!-- Notes -->
    @if (notes!=null && notes.Count>0)
    {
        <div class="sec-hdr" style="margin-top:28px;">Notes</div>
        <hr class="sec-line"/>
        @foreach (var note in notes)
        {
            string noteSrc  = note.DataSource!=null?(Convert.ToString(note.DataSource.Name)??""):"";
            string noteTxt  = Convert.ToString(note.Text)??"";
            string noteCred = ""; try{noteCred=Convert.ToString(note.CredibilityScore)??"";}catch{}
            <div style="margin-bottom:15px;">
                @if(!string.IsNullOrEmpty(noteSrc)){<div class="grid-row"><span class="grid-lbl">Source</span><span class="grid-val">@noteSrc</span></div>}
                @if(!string.IsNullOrEmpty(noteTxt)){<div class="grid-row"><span class="grid-lbl">Summary</span><span class="grid-val cp-text">@noteTxt</span></div>}
                @if(!string.IsNullOrEmpty(noteCred)){
                    string credInfo = noteCred == "High" ? "The information was published by an official government or institutional source" : (noteCred == "Medium" ? "The information was published by a reputable media source with evidence of official action" : "");
                    <div class="grid-row"><span class="cp-cred-lbl" style="font-weight:700;">@noteCred Credibility Score</span><span class="grid-val cp-text">@credInfo</span></div>
                }
            </div>
        }
    }

    <!-- Linked Entities -->
    @if ((pu.LinkedBusinesses!=null&&pu.LinkedBusinesses.Count>0)||(pu.LinkedPersons!=null&&pu.LinkedPersons.Count>0))
    {
        <div class="sec-hdr" style="margin-top:28px;">Linked Entities</div>
        <hr class="sec-line"/>
        @if (pu.LinkedBusinesses!=null && pu.LinkedBusinesses.Count>0)
        {
            <table class="pd-table"><tr><td class="pd-group">Businesses</td><td colspan="2"></td></tr>
            @foreach(var b2 in pu.LinkedBusinesses){<tr><td></td><td class="pd-field">@b2.BusinessName</td><td class="pd-val">@b2.Association</td></tr>}
            </table>
        }
        @if (pu.LinkedPersons!=null && pu.LinkedPersons.Count>0)
        {
            <table class="pd-table" style="margin-top:8px;"><tr><td class="pd-group">Persons</td><td colspan="2"></td></tr>
            @foreach(var p2 in pu.LinkedPersons){<tr><td></td><td class="pd-field">@p2.Name</td><td class="pd-val">@p2.Association</td></tr>}
            </table>
        }
    }

    }
    else
    {
        <div style="padding:40px;text-align:center;color:#9ca3af;font-size:13px;">No profile data available.</div>
    }
</div>

