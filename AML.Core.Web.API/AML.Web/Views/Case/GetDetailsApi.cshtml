                                                                                           </td>
                    <td>-</td>
                        
                </tr>
                <tr>
                    <td style="font-weight: 600;">Nationality</td>
                    <td>@(string.IsNullOrEmpty(ViewBag.user.Case.Nationality) ? "-" : ViewBag.user.Case.Nationality)</td>
                    <td>
                            @(
                                                pu.Nationality == null ||
                                                string.IsNullOrEmpty(pu.Nationality.NationalityText ?? pu.Nationality.Name)
                                                ? "-"
                                                : (pu.Nationality.NationalityText ?? pu.Nationality.Name)
