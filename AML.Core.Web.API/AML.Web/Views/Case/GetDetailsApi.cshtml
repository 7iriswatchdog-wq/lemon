        else
        {
           var caseData = ViewBag.business?.Case;
           DateTime Corpdob = DateTime.MinValue;
            var CorpdobValue = caseData.DOB;

            bool isCorpValid = CorpdobValue != null && DateTime.TryParse(CorpdobValue.ToString(), out Corpdob);
                    
            <div class="sec-hdr">Data Comparison</div>
            <hr class="sec-line" />
            <div style="font-size: 14px; color: #64748B; margin-bottom: 12px;">Comparison between the matched sanction record and the provided client profile.</div>
            <table class="comp-table">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th>Screening Input</th>
                        <th>Screening Output</th>
                        @* <th>Sanction Record (Matched)</th>
                <th>Client Profile (Case Input)</th> *@
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="font-weight: 600;">Name</td>
                        <td>
            @(caseData == null
                ? "-"
                : string.Join(" ", new[] {
                    caseData.FirstName,
                    caseData.MiddleName,
                    caseData.LastName
                }.Where(x => !string.IsNullOrWhiteSpace(x))))
            </td>
                        <td class="comp-val-match">@(Convert.ToString(pu.BusinessName) ?? "")</td>
                        
                            
                    </tr>
                    <tr>
                        <td style="font-weight: 600;">Date of Registration</td>
                         <td>
                           

                                 @(isCorpValid && Corpdob != DateTime.MinValue
                                                ? Corpdob.ToString("dd/MM/yyyy")
                                                : "-")
                        </td>
                        <td>-</td>
                       
                    </tr>
                    <tr>
                        <td style="font-weight: 600;">Country of Incorporation</td>
