                            @(caseData == null || string.IsNullOrEmpty(caseData.Nationality)
                                ? "-"
                                : caseData.Nationality)
                        </td>
                        <td>-</td>
                        
                    </tr>
                    <tr>
                                        <td style="font-weight: 600;">Trade Licence Number</td>
                                         <td>
                            @(caseData == null || string.IsNullOrEmpty(caseData.CustomerIdNumber)
