        function saveRemarks(id,customerid,type) {

            console.log("saveremarks",id);
           $('#loadingeffect').show();
               var model = new Array();
                           let riskUpdated = false;
               $("#APITable TBODY TR").each(function (index) {
                   var row = $(this);
                   var result = {};
                   result.matchtype = row.find("TD").eq(0).html();
                   result.matchcategory = row.find("TD").eq(1).html();
                   result.matchname = row.find("TD").eq(2).text().trim();
                   result.matchcore = row.find("TD").eq(3).text().trim();
                   result.matchnationality = row.find("TD").eq(4).text().trim();
                   result.matchidno = row.find("TD").eq(5).html();
                   result.matchdob = row.find("TD").eq(6).html();
                   result.remarks = document.getElementById(`DataList_${index}__remarks`).value || "";
                   result.searchTypes = [];

                $(`#search-hidden-${index} input[type='hidden']`).each(function () {
                    result.searchTypes.push($(this).val());
                });
                        result.riskAssessments = [];

                $(".risk-type-id").each(function (i) {

                    const riskTypeId = $(this).val();
                            const riskTypeText = $(this)
                .closest(".flex")
                .find(".risk-type-label")
                .data("risk-type-text");
                    const selectedItemId = $("#RiskItemId_" + i).val();
                    const itemScore = $("#RiskItem_" + i).val();
                    const itemText = $("#RiskItemTxt_" + i).val();

                    if (selectedItemId && selectedItemId !== "0") {

                        //alert("true");
                                    riskUpdated = true;
                        result.riskAssessments.push({
                            RiskTypeId: parseInt(riskTypeId),
                            RiskTypeText: riskTypeText || "",
                            SelectedItemId: parseInt(selectedItemId),
                            ItemScore: parseInt(itemScore || 0),
                            ItemText: itemText || ""
                        });
                    }
                });
                   model.push(result);
               });


               $.ajax({
                   url: '/case/saveRemark',
                   type: 'post',
                   contentType: 'application/json',
                   data:JSON.stringify({
                        id: id,
                        customerid: customerid,
                        type: type,
                        model: model
                    }),
                success: function (response) {
                    let commentMessage = "Remarks Has Been Update In The Search Result";
                    let searchTypeUpdated = false;
                    let searchRemarksUpdated = false;

                    // Check if search types were updated
                    $("#APITable TBODY TR").each(function (index) {
                        if ($(`#search-hidden-${index} input[type='hidden']`).length > 0) {
                            searchTypeUpdated = true;
                        }
                    });

                    // Check if remarks were updated
                    $("#APITable TBODY TR").each(function (index) {
                        if (document.getElementById(`DataList_${index}__remarks`).value !== "") {
                            searchRemarksUpdated = true;
                        }
                    });

                    // Set appropriate message
                    if (searchTypeUpdated && searchRemarksUpdated) {
                        commentMessage = "Both Search Type and Search Remarks Has Been Update In The Search Result";
                    } else if (searchTypeUpdated) {
                        commentMessage = "Search Type Has Been Update In The Search Result";
                    } else if (searchRemarksUpdated) {
                        commentMessage = "Search Remarks Has Been Update In The Search Result";
                    }

                    if (riskUpdated) {
                        insertUploadComment(commentMessage, "Search Result");
                        insertUploadComment("Risk Parameters Has been Updated", "Risk Assessment(By Search Results)");
                    } else {
                        insertUploadComment(commentMessage, "Search Result");
                    }

                    $('#loadingeffect').hide();
                    toastr.success(response);
                    location.reload();
                }
               });
           }

