                    let currentFullscreen = null;
               function updateScoreBadgeSize(isFullscreen) {
                document.querySelectorAll('.score-badge').forEach(badge => {
                    badge.classList.remove('w-12', 'h-6', 'w-9', 'h-7');

                    if (isFullscreen) {
                            badge.classList.add('w-9', 'h-7');
                    } else {
                        badge.classList.add('w-12', 'h-6');
                    }
                });
            }
                        function updateDobLabel(isFullscreen) {
                document.querySelectorAll('.dob-label').forEach(label => {
                    label.textContent = isFullscreen ? 'Date of Birth' : 'DOB';
                });
            }

            function toggleFullscreen(side) {

                const leftCol = document.getElementById('leftColumn');
                const rightCol = document.getElementById('rightColumn');

                const resetLayout = () => {
                    leftCol.classList.remove('hidden');
                    rightCol.classList.remove('hidden');

                    leftCol.classList.remove('basis-full');
                    rightCol.classList.remove('basis-full');

                    leftCol.classList.add('basis-[65%]');
                    rightCol.classList.add('basis-[35%]');

                        updateScoreBadgeSize(false);
                };

                // Exit fullscreen
                if (currentFullscreen === side) {
                    currentFullscreen = null;
                    resetLayout();
                        updateDobLabel(false);
                    return;
                }

                currentFullscreen = side;

