                <script>
                $(document).ready(function () {

            const searchTypeOptions = [
                "Domestic PEP","Foreign PEP","REL","RRE","INS",
                "DD","GRI","SOE","UAE Sanction","UN Sanction",
                "Other Sanctions","VHNWI"
            ];

            let activeSearchRowIndex = null;
            @if(Model.DataList != null && Model.DataList.Any())
                {
                    @for (int i = 0; i < Model.DataList.Count; i++)
                    {
                        <text>initSearchTypeDropdown(@i);</text>
                    }
                }

            function initSearchTypeDropdown(rowIndex) {

                const trigger = $(`#search-trigger-${rowIndex}`);
                const text = $(`#search-text-${rowIndex}`);
                const popover = $(`#search-popover-${rowIndex}`);
                const allCheckbox = $(`#search-all-${rowIndex}`);
                const optionsContainer = $(`#search-options-${rowIndex}`);
                const hiddenContainer = $(`#search-hidden-${rowIndex}`);
                const hiddenInput = $(`#searchTypesValue-${rowIndex}`);

                // Parse existing value (JSON)
                let selected = [];
                try {
                    const val = hiddenInput.val();
                    selected = val ? JSON.parse(val) : [];
                } catch (e) {
                    selected = [];
                }

                // Render checkboxes
                optionsContainer.empty();
                searchTypeOptions.forEach(opt => {
                    const checked = selected.includes(opt) ? "checked" : "";
                    const checkboxHtml = `
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="search-option" value="${opt}" ${checked}>
                            <label class="text-xs">${opt}</label>
                        </div>
                    `;
                    optionsContainer.append(checkboxHtml);
                });

                // Update button text and hidden inputs
                function updateUI() {
                    // Update text
                    if (selected.length === 0) {
                        text.text("Select");
                    } else if (selected.length === searchTypeOptions.length) {
                        text.text("ALL");
                    } else {
                        text.text(selected.length + " selected");
                    }

                    // Update hidden inputs for form
                    hiddenContainer.empty();
                    selected.forEach(val => {
                        const input = `<input type="hidden" name="SearchTypes[${rowIndex}]" value="${val}">`;
                        hiddenContainer.append(input);
                    });
                }

                // Update row disable state
                function updateRowDisableState() {
                    $("[id^='search-trigger-']").each(function () {
                        const idx = $(this).attr("id").split("-").pop();
                        const disable = activeSearchRowIndex !== null && idx != activeSearchRowIndex;
                        $(this).prop("disabled", disable)
                               .toggleClass("opacity-50 cursor-not-allowed", disable);
                    });
                }

                // Checkbox change
                optionsContainer.find(".search-option").on("change", function () {
                    const val = $(this).val();
                    if ($(this).is(":checked")) {
                        if (!selected.includes(val)) selected.push(val);
                    } else {
                        selected = selected.filter(x => x !== val);
                    }

                    // Row locking
                    activeSearchRowIndex = selected.length ? rowIndex : null;

                    // Sync ALL checkbox
                    allCheckbox.prop("checked", selected.length === searchTypeOptions.length);

                    updateRowDisableState();
                    updateUI();
                });

                // ALL checkbox
                allCheckbox.on("change", function () {
                    if ($(this).is(":checked")) {
                        selected = [...searchTypeOptions];
                    } else {
                        selected = [];
                    }

                    optionsContainer.find(".search-option").each(function () {
                        $(this).prop("checked", selected.includes($(this).val()));
                    });

                    activeSearchRowIndex = selected.length ? rowIndex : null;

                    updateRowDisableState();
                    updateUI();
                });

                // Dropdown toggle
                trigger.on("click", function (e) {
                    if ($(this).prop("disabled")) return;
                    e.stopPropagation();
                    popover.toggleClass("hidden");
                });

                // Close dropdown on outside click
                $(document).on("click", function (e) {
                    if (!popover.is(e.target) && popover.has(e.target).length === 0 &&
                        !trigger.is(e.target)) {
                        popover.addClass("hidden");
                    }
                });

                // Initialize ALL checkbox
                allCheckbox.prop("checked", selected.length === searchTypeOptions.length);
                if (selected.length) activeSearchRowIndex = rowIndex;

                updateRowDisableState();
                updateUI();
            }

            // Pagination logic for API Table
            const searchResultsBody = document.getElementById("searchResultsBody");
            if (searchResultsBody) {
                const rows = Array.from(searchResultsBody.querySelectorAll("tr"));
                const rowsPerPage = 10;
                if (rows.length > rowsPerPage) {
                    const paginationControls = document.createElement("div");
                    paginationControls.className = "flex justify-end gap-2 p-3 border-t border-slate-200 bg-slate-50";
                    searchResultsBody.parentElement.parentElement.appendChild(paginationControls);

                    let currentPage = 1;
                    const totalPages = Math.ceil(rows.length / rowsPerPage);

                    function showPage(page) {
                        currentPage = page;
                        rows.forEach((row, index) => {
                            row.style.display = (index >= (page - 1) * rowsPerPage && index < page * rowsPerPage) ? '' : 'none';
                        });
                        renderControls();
                    }

                    function renderControls() {
                        paginationControls.innerHTML = '';
                        
                        const prevBtn = document.createElement("button");
                        prevBtn.innerText = "Prev";
                        prevBtn.className = `px-3 py-1 text-xs border rounded transition-colors ${currentPage === 1 ? 'text-slate-400 bg-slate-100 cursor-not-allowed border-slate-200' : 'text-slate-700 bg-white hover:bg-slate-50 border-slate-300'}`;
                        prevBtn.disabled = currentPage === 1;
                        prevBtn.onclick = (e) => { e.preventDefault(); showPage(currentPage - 1); };
                        paginationControls.appendChild(prevBtn);
                        
                        const pageInfo = document.createElement("span");
                        pageInfo.innerText = `Page ${currentPage} of ${totalPages}`;
                        pageInfo.className = "px-3 py-1 text-xs font-medium text-slate-600 flex items-center";
                        paginationControls.appendChild(pageInfo);

                        const nextBtn = document.createElement("button");
                        nextBtn.innerText = "Next";
                        nextBtn.className = `px-3 py-1 text-xs border rounded transition-colors ${currentPage === totalPages ? 'text-slate-400 bg-slate-100 cursor-not-allowed border-slate-200' : 'text-slate-700 bg-white hover:bg-slate-50 border-slate-300'}`;
                        nextBtn.disabled = currentPage === totalPages;
                        nextBtn.onclick = (e) => { e.preventDefault(); showPage(currentPage + 1); };
                        paginationControls.appendChild(nextBtn);
                    }

                    showPage(1);
                }
            }

        });
    </script>

   
    
