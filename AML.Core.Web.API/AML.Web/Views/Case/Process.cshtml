            function displayShortFileName(input) {

    if (input.files.length === 0) {
        document.getElementById("fileNameDisplay").innerText = "No file chosen";
        return;
    }

    let fullName = input.files[0].name;

    // Split name and extension
    let extension = fullName.split('.').pop();
    let nameWithoutExt = fullName.substring(0, fullName.lastIndexOf('.'));

    // Show first 5 characters only
    let shortName = nameWithoutExt.length > 10
        ? nameWithoutExt.substring(0, 10) + "..."
        : nameWithoutExt;

    document.getElementById("fileNameDisplay").innerText =
        shortName + "." + extension;
}


