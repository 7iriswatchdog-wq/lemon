@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = localizer["Manage Case"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
    var controllerName = "Risk";
    var actionName = "Create";

    if (Model?.Case?.CustomerType == "I")
    {
        controllerName = "Risk";
        actionName = "Create";
    }
    else if (Model?.Case?.CustomerType == "C")
    {
        controllerName = "Risk";
        actionName = "RiskAssessmentForCorpCustomer";
    }
  
    bool hasSearchResults = Model.DataList != null && Model.DataList.Any();
    bool hasWebResults = Model.WebDataList != null && Model.WebDataList.Any(); // Adjust property name

    string defaultTab = hasSearchResults ? "search" : (hasWebResults ? "web" : "search");

}

@model AML.ViewModel.ViewModels.CaseProcess.CaseProcessModel
<!DOCTYPE html>
<html lang="en">

<head>
