    <div id="versionModal"
     class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop"
     onclick="closeModalOnBackdrop(event, 'versionModal')">

    <div class="bg-white rounded-lg shadow-xl max-h-[80vh] overflow-y-auto m-4"
         onclick="event.stopPropagation()">

        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-100 min-h-[64px] flex items-center">
    <div class="flex items-center justify-between gap-10 w-full">
        <h3 class="text-base font-bold text-slate-900 leading-none">
            View Version
        </h3>

        <button onclick="closeModal('versionModal')"
                class="h-9 px-8 text-white rounded-md bg-red-600">
            Close
        </button>
    </div>
</div>

        <!-- Versions -->
        <div class="p-6 space-y-4" id="versionContainer">

            @{
                var versions = Model.RiskVersionData;
                int total = versions != null ? versions.Count : 0;

                // oldest version is hidden
                bool hasDisplayableVersions = total > 1;
            }

            @if (hasDisplayableVersions)
            {
                int startIndex = 1; // skip oldest
                int visibleStartIndex = Math.Max(startIndex, total - 2);

                for (int i = startIndex; i < total; i++)
                {
                    var version = versions[i];
                    bool hideInitially = i < visibleStartIndex;

                    string dotClass =
                        version.FinalScore == "High Risk" ? "bg-red-600" :
                        version.FinalScore == "Low Risk" ? "bg-emerald-600" :
                        "bg-amber-500";

                    <div class="version-item @(hideInitially ? "hidden" : "") border border-slate-200 rounded-lg p-4 space-y-2">

                        <!-- Version -->
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio"
                                   name="version"
                                   value="@version.CustomerCode"
                                   data-id="@version.Id"
                                   data-type="@Model.Case.CustomerType"
                                   data-index="@i"
                                   data-total="@total"
                                   class="versionRadio"
                                   @(i == total - 1 ? "checked" : "") />

                            <span class="text-sm font-bold text-slate-900">
                                Version @i
                            </span>
                        </label>

                        <!-- Risk Score -->
                        <div class="flex items-center gap-2 pl-6">
                            <span class="text-xs font-semibold text-slate-500">Risk Score :</span>
                            <span class="h-3 w-3 rounded-full @dotClass"></span>
                            <span class="text-sm font-semibold text-slate-800">
                                @version.FinalScore
                            </span>
                        </div>

                        <!-- Time Stamp -->
                        <div class="flex items-center gap-2 pl-6 text-xs text-slate-500">
                            <span class="font-semibold">Time Stamp :</span>
                            <span>@version.DateofAssessment.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="flex items-center justify-center min-h-[200px] text-sm text-slate-500">
                    No versions available.
                </div>  
            }

        </div>

        <!-- Footer Buttons -->
        @if (hasDisplayableVersions)
        {
            <div class="px-6 pb-6 flex justify-between">
                <button onclick="saveVersion()"
                        class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs h-9 px-6 rounded-md">
                    Save
                </button>

                <button id="btnMore"
                        onclick="showAllVersions()"
                        class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs h-9 px-6 rounded-md">
                    More
                </button>
            </div>
        }

    </div>
</div>


