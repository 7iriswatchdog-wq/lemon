                            </div>

                            <div class="flex items-center py-2 px-4 border-b border-bordercolor bg-surface">
                                <div class="flex-none w-[24px]"></div>
                                <div class="flex-1 grid grid-cols-17 gap-2">
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted  tracking-wider pl-2">ID</div>
                                    <div class="col-span-4 text-[10px] font-bold text-textmuted  tracking-wider">Name</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted  tracking-wider">Group Label</div>
                                    <div class="col-span-3 text-[10px] font-bold text-textmuted  tracking-wider">Shareholder Type</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted  tracking-wider">Flag Type</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted  tracking-wider">Status</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted  tracking-wider text-right pr-2">Link</div>
                                </div>
                            </div>

                            <div class="py-1 flex-1 overflow-y-auto custom-scrollbar">
                                @{
                                     var mainCustomerId = Model.Case?.CustomerId;
                                     var allShareholders = (Model.ShareholdersData ?? new List<AML.ViewModel.ViewModels.CustomerCase.CaseModel>())
                                         .GroupBy(s => s.CustomerId)
                                         .Select(g => {
                                             var first = g.First();
                                             var mergedParentIds = g
                                                 .Where(x => !string.IsNullOrEmpty(x.ParentId))
                                                 .SelectMany(x => x.ParentId.Split(',').Select(p => p.Trim()))
                                                 .Where(p => !string.IsNullOrEmpty(p))
                                                 .Distinct()
                                                 .ToList();
                                             if (mergedParentIds.Any()) first.ParentId = string.Join(",", mergedParentIds);
                                             return first;
                                         })
                                         .ToList();
                                     var roots = new List<AML.ViewModel.ViewModels.CustomerCase.CaseModel>();
                                     
                                     if (!string.IsNullOrEmpty(mainCustomerId))
                                     {
                                         // 1. Direct children of the main entity
                                         var children = allShareholders.Where(s => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, mainCustomerId)).ToList();
                                         roots.AddRange(children);
 
                                         // 1.5 Immediate parent of the main entity
                                         if (!string.IsNullOrEmpty(Model.Case?.ParentId))
                                         {
                                             var parentNode = allShareholders.FirstOrDefault(s => s.CustomerId == Model.Case.ParentId);
                                             if (parentNode != null)
                                             {
                                                 roots.Add(parentNode);
                                             }
                                         }
 
                                         // 2. Members of the same group — use Model.Case.GroupId directly
                                         // (mainNode lookup fails because the current entity is not in allShareholders)
                                         var caseGroupId = Model.Case?.GroupId;
                                         if (!string.IsNullOrEmpty(caseGroupId))
                                         {
                                             var mainGroups = caseGroupId.Split(',').Select(g => g.Trim()).Where(g => !string.IsNullOrEmpty(g)).ToList();
                                             var groupMembers = allShareholders.Where(s => 
                                                 s.CustomerId != mainCustomerId && 
                                                 !AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, mainCustomerId) &&
                                                 !string.IsNullOrEmpty(s.GroupId) &&
                                                 s.GroupId.Split(',').Select(g => g.Trim()).Any(g => mainGroups.Contains(g))
                                             ).ToList();
                                             roots.AddRange(groupMembers);
                                         }
                                     }
 
                                     // Deduplicate and sort (children first)
                                     roots = roots.GroupBy(r => r.CustomerId).Select(g => g.First())
                                                  .OrderBy(r => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(r.ParentId, mainCustomerId) ? 0 : 1)
                                                  .ToList();
 
                                     var renderedIds = new HashSet<string>();
                                     // CRITICAL: Explicitly exclude the main entity from the Related Parties list
                                     if (!string.IsNullOrEmpty(mainCustomerId)) renderedIds.Add(mainCustomerId);
                                 }

                                 <!-- DIAGNOSTIC LOG:
                                      MainCustomerId: @mainCustomerId
                                      CaseGroupId: @Model.Case?.GroupId
                                      allShareholders count: @allShareholders.Count
                                      allShareholders: @string.Join(" | ", allShareholders.Select(s => $"{s.FirstName} (ID: {s.CustomerId}, Parent: {s.ParentId}, Flag: {s.FlagType}, Group: {s.GroupId})"))
                                      roots count: @roots.Count
                                      roots list: @string.Join(", ", roots.Select(r => $"{r.FirstName} ({r.CustomerId})"))
                                 -->

                                @if (roots.Any())
                                {
                                    for (int i = 0; i < roots.Count; i++)
                                    {
                                        var parent = roots[i];
                                        var isLast = i == roots.Count - 1;
                                        var hasChildren = allShareholders.Any(s => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, parent.CustomerId) && !renderedIds.Contains(s.CustomerId));
                                        
                                        <div class="relative">
                                            <div class="flex items-center py-2 hover:bg-appbg transition-colors group border-b border-bordercolor">

                                                <div class="flex-none flex items-center relative h-full w-[24px]">
                                                    <div class="relative z-10 pl-2">
                                                        @if (hasChildren)
                                                        {
                                                            <button class="h-4 w-4 rounded-[4px] bg-surface border border-slate-300 flex items-center justify-center text-textmuted hover:text-primary hover:border-primary transition-all shadow-sm">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <div class="h-2 w-2 rounded-full bg-slate-300 ml-1"></div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="flex-1 grid grid-cols-17 gap-2 items-center pl-2">
                                                    <div class="col-span-2 text-xs font-bold text-textlabel">@parent.CustomerId</div>
                                                    <div class="col-span-4 text-xs font-semibold text-textprimary flex gap-2" title="FirstName: @parent.FirstName, LastName: @parent.LastName">
                                                        @parent.FirstName @parent.LastName
                                                        @if (parent.IsDuplicate == 1)
                                                        {
                                                            <span>
                                                                <i data-lucide="copy" class="w-4 h-4 text-red-600"></i>
                                                            </span>
                                                        }
                                                        @if (parent.ReplaceFlag == 1)
                                                        {
                                                           <span>
                                                               <i class='w-4 h-4 text-blue-600' data-lucide='refresh-cw' title='Replaced'></i>
                                                           </span>
                                                         
                                                        }
                                                    </div>
                                                    @{
                                                        // Group Label: prefer GroupEntityof if it's a human label (not a NAT-prefixed entity ID)
                                                        var parentGroupIdVal = (!string.IsNullOrEmpty(parent.GroupEntityof) && !parent.GroupEntityof.StartsWith("NAT"))
                                                            ? parent.GroupEntityof 
                                                            : (string.IsNullOrEmpty(parent.GroupId) ? "-" : parent.GroupId);
                                                        if (parentGroupIdVal.Contains(","))
                                                        {
                                                            var pGroups = parentGroupIdVal.Split(',').Select(x => x.Trim()).Distinct();
                                                            if (!string.IsNullOrEmpty(Model.Case?.GroupEntityof))
                                                            {
                                                                var cGroups = Model.Case.GroupEntityof.Split(',').Select(x => x.Trim());
                                                                var shared = pGroups.Intersect(cGroups).ToList();
                                                                if (shared.Any()) pGroups = shared;
                                                            }
                                                            parentGroupIdVal = string.Join(", ", pGroups);
                                                        }
                                                        // Flag label: prefer Relationship over FlagType if present
                                                        var parentFlagLabelValue = AML.Web.Helpers.CaseStudioTypeHelper.GetRelationshipForParent(parent.ParentId, parent.Relationship, mainCustomerId);
                                                        if (string.IsNullOrEmpty(parentFlagLabelValue) || parentFlagLabelValue == "Related Party" || parentFlagLabelValue == "root")
                                                        {
                                                            parentFlagLabelValue = parent.FlagType;
                                                        }
                                                        var parentFlagLabel = GetFlagTypeLabel(parentFlagLabelValue);
                                                    }
                                                    <div class="col-span-2 text-[11px] font-medium text-textmuted truncate" title="@parentGroupIdVal">
                                                        @parentGroupIdVal
                                                    </div>
                                                    <div class="col-span-3 text-[11px] font-medium text-textmuted truncate">@GetDynamicType(parent, allShareholders, mainCustomerId, Model.Case?.CustomerType, mainCustomerId)</div>
                                                    <div class="col-span-2 text-[11px] font-bold text-textlabel truncate" title="@parentFlagLabel">@parentFlagLabel</div>
                                                    <div class="col-span-2 text-[11px] truncate">
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold"
                                                              data-status="@parent.CaseStatus">
                                                            @parent.CaseStatus
                                                        </span>
                                                    </div>
                                                    <div class="col-span-2 text-right pr-2 text-primary text-[11px] font-bold">
                                                        @if (parent.Type == "Individual" || parent.Type == "Corporate")
                                                        {

                                                            @if (parent.Status == 5 || parent.Status == 0 || parent.Status == 6 ||  parent.Status == 7)
                                                            {
                                                               <a href="/case/Process/@parent.Id" class="hover:underline">Process</a>
                                                            }
                                                            else
                                                            {
                                                                        <a href="/report/ViewIndividualCaseDetail?id=@parent.CustomerId&version=@parent.Version&type=1" class="hover:underline">View</a>
                                                            }
                                                        }else{

                                                             @if (parent.Status == 5 || parent.Status == 0 || parent.Status == 6 || parent.Status == 7)
                                                             {
                                                                  <a href="/case/Shareholder/@parent.Id" class="hover:underline">Process</a>
                                                             }
                                                             else
                                                             {
                                                                  <a href="/report/ViewShareholderCaseDetails?id=@parent.CustomerId&version=@parent.Version&type=1" class="hover:underline">View</a>
                                                             }


                                                            
                                                        }
                                                        
                                                    </div>
                                                </div>
                                            </div>

                                            @RenderShareholderTree(allShareholders, parent.CustomerId, mainCustomerId, Model.Case?.CustomerType, 1, isLast, new List<bool> { true }, renderedIds)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="p-4 text-center text-xs text-textmuted italic">No shareholders found</div>
                                }
                            </div>
                        </div>
                    }


