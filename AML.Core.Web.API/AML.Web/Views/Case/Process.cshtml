                <!-- modals moved to end of body -->

                <!-- Shareholders Detail & Case History -->
                <div class="flex-2 min-w-0 min-h-0 flex flex-col gap-6">
                    @functions {
                        public string GetDynamicType(AML.ViewModel.ViewModels.CustomerCase.CaseModel child, IEnumerable<AML.ViewModel.ViewModels.CustomerCase.CaseModel> allShareholders, string currentCaseId, string currentCaseType, string parentCustomerId = null)
                        {
                            return AML.Web.Helpers.CaseStudioTypeHelper.GetDynamicType(child, allShareholders, currentCaseId, currentCaseType, parentCustomerId);
                        }

                        public string GetFlagTypeLabel(string flag) {
                            return AML.Web.Helpers.CaseStudioTypeHelper.GetFlagTypeLabel(flag);
                        }

                        public IHtmlContent RenderShareholderTree(IEnumerable<AML.ViewModel.ViewModels.CustomerCase.CaseModel> shareholders, string parentCustomerId, string currentCaseId, string currentCaseType, int level = 0, bool isLastChild = false, List<bool> parentHasNextSibling = null, HashSet<string> renderedIds = null)
                        {
                            if (renderedIds == null) renderedIds = new HashSet<string>();
                            if (parentHasNextSibling == null) parentHasNextSibling = new List<bool>();
                            
                            var currentPath = new HashSet<string>(renderedIds);
                            // Mark parent as rendered if it's the root call
                            if (level == 1 && !currentPath.Contains(parentCustomerId)) currentPath.Add(parentCustomerId);

                            // 1. Get Direct Children
                             var children = shareholders.Where(s => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, parentCustomerId) && !currentPath.Contains(s.CustomerId)).ToList();
                             var allRelatedRaw = children;
                             var allRelated = allRelatedRaw
                                  .OrderBy(s => children.Contains(s) ? 0 : 1) // Direct children first
                                  .ThenBy(s => allRelatedRaw.Any(other => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, other.CustomerId)) ? 1 : 0) // Parents before children
                                  .ToList();
                             
                             if (!allRelated.Any()) return HtmlString.Empty;
 
                             var html = new System.Text.StringBuilder();
                             html.Append("<div class='relative'>");
 
                             for (int i = 0; i < allRelated.Count; i++)
                             {
                                 var child = allRelated[i];
                                 if (currentPath.Contains(child.CustomerId)) continue;
 
                                 var currentIsLast = i == allRelated.Count - 1;
                                 var hasSubRelations = shareholders.Any(s => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, child.CustomerId) && !currentPath.Contains(s.CustomerId));

                                var ChildName = string.Join(" ",
                                    new[] { child.FirstName, child.LastName }
                                    .Where(x => !string.IsNullOrWhiteSpace(x))
                                );
                                
                                // Current level parentHasNextSibling array
                                var currentSiblingArr = new List<bool>(parentHasNextSibling);
                                if (level > 0)
                                {
                                    currentSiblingArr.Add(!isLastChild);
                                }

                                var status = (AML.Core.DataContract.Enum.CaseStatus)child.Status;

                                html.Append($@"
                                <div class='relative'>
                                    <div class='flex items-center py-2 hover:bg-appbg transition-colors group border-b border-bordercolor'>
                                        
                                        <!-- Tree Indentation & Lines -->
                                        <div class='flex-none flex items-center relative h-full' style='width: {(level * 20) + 24}px; padding-left: {level * 20}px;'>");

                                // Vertical lines from parents
                                for (int idx = 0; idx < currentSiblingArr.Count; idx++)
                                {
                                    if (currentSiblingArr[idx])
                                    {
                                        html.Append($@"<div class='absolute top-0 bottom-0 w-px bg-slate-200' style='left: {(idx * 20) + 10}px;'></div>");
                                    }
                                }

                                // Current level connector
                                if (level > 0)
                                {
                                    var topClass = currentIsLast ? "top-0 h-1/2" : "top-0 bottom-0";
                                    html.Append($@"
                                        <div class='absolute w-px bg-slate-200 {topClass}' style='left: {(level * 20) - 10}px;'></div>
                                        <div class='absolute h-px bg-slate-200' style='left: {(level * 20) - 10}px; width: 10px; top: 50%;'></div>
                                    ");
                                }

                                // Dot/Icon
                                html.Append("<div class='relative z-10 pl-2'>");
                                if (hasSubRelations)
                                {
                                     html.Append($@"<button class='h-4 w-4 rounded-[4px] bg-surface border border-slate-300 flex items-center justify-center text-textmuted hover:text-primary hover:border-primary transition-all shadow-sm'>
                                                        <svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>
                                                    </button>");
                                }
                                else
                                {
                                     html.Append($@"<div class='h-2 w-2 rounded-full bg-slate-300 ml-1'></div>");
                                }
                                html.Append("</div></div>");


                                 // Content Columns
                                 html.Append("<div class='flex-1 grid grid-cols-17 gap-2 items-center pl-2'>");
                                 html.Append($@"<div class='col-span-2 text-xs font-bold text-textlabel'>{child.CustomerId}</div>");
                                 html.Append($@"<div class='col-span-4 text-xs font-semibold text-textprimary flex items-center gap-2' title='FirstName: {child.FirstName}, LastName: {child.LastName}'>");
                                 html.Append($"{child.FirstName} {child.LastName}");
                                 
                                 if (child.IsDuplicate == 1)
                                 {
                                     html.Append("<i data-lucide='copy' class='w-4 h-4 text-red-600' title='Duplicate'></i>");
                                 }
                                 if (child.ReplaceFlag == 1)
                                 {
                                   html.Append("<i class='w-4 h-4 text-blue-600' data-lucide='refresh-cw' title='Replaced'></i>");
                                 }
                                 html.Append("</div>");
                                 // Group Label: prefer GroupEntityof (human label), fall back to truncated GroupId
                                 var childGroupIdVal = !string.IsNullOrEmpty(child.GroupEntityof) && !child.GroupEntityof.StartsWith("NAT") 
                                     ? child.GroupEntityof 
                                     : (string.IsNullOrEmpty(child.GroupId) ? "-" : child.GroupId);
                                 html.Append($@"<div class='col-span-2 text-[11px] font-medium text-textmuted truncate' title='{childGroupIdVal}'>{childGroupIdVal}</div>");
                                 
                                 var displayType = GetDynamicType(child, shareholders, currentCaseId, currentCaseType, parentCustomerId);
                                 html.Append($@"<div class='col-span-3 text-[11px] font-medium text-textmuted truncate'>{displayType}</div>");
                                 
                                 // Flag label: prefer Relationship over FlagType if present
                                 var flagLabelValue = AML.Web.Helpers.CaseStudioTypeHelper.GetRelationshipForParent(child.ParentId, child.Relationship, parentCustomerId);
                                 if (string.IsNullOrEmpty(flagLabelValue) || flagLabelValue == "Related Party" || flagLabelValue == "root")
                                 {
                                     flagLabelValue = child.FlagType;
                                 }
                                 var flagLabel = GetFlagTypeLabel(flagLabelValue);
                                 html.Append($@"<div class='col-span-2 text-[11px] font-bold text-textlabel truncate' title='{flagLabel}'>{flagLabel}</div>");
                                 html.Append($@"<div class='col-span-2 text-[11px] truncate'>
                                                    <span class='px-2 py-0.5 rounded text-[10px] font-semibold' data-status='{child.CaseStatus}'>
                                                        {child.CaseStatus}
                                                    </span>
                                                </div>");
                                 html.Append("<div class='col-span-2 text-right pr-2 text-primary text-[11px] font-bold'>");
                                @if (child.Type == "Individual" || child.Type == "Corporate")
                                {
                                if (child.Status == 5 || child.Status == 0 || child.Status == 6 || child.Status == 7)
                                    html.Append($"<a  href='/case/Process/{child.Id}' class='hover:underline'>Process</a>");
                                else
                                    html.Append($"<a  href='/report/ViewIndividualCaseDetail?id={child.CustomerId}&version={child.Version}&type=1' class='hover:underline'>View</a>");

                               
                                }else{
                                       
                                            if (child.Status == 5 || child.Status == 0 || child.Status == 6 || child.Status == 7)
                                                html.Append($"<a  href='/case/Shareholder/{child.Id}' class='hover:underline'>Process</a>");
                                            else
                                                html.Append($"<a  href='/report/ViewShareholderCaseDetails?id={child.CustomerId}&version={child.Version}&type=1' class='hover:underline'>View</a>");

                                            
                                }
                                        html.Append("</div></div></div>");
                                
                                // Recursive call
                                var nextPath = new HashSet<string>(currentPath);
                                nextPath.Add(child.CustomerId);
                                html.Append(RenderShareholderTree(shareholders, child.CustomerId, currentCaseId, currentCaseType, level + 1, currentIsLast, currentSiblingArr, nextPath).ToString());
                                html.Append("</div>");
                            }

                            html.Append("</div>");
                            return new HtmlString(html.ToString());
                        }
                    }

                    @if (Model.ShareholdersData != null && Model.ShareholdersData.Any())
                    {
                        <div id="shareholdersSection" class="bg-surface rounded-lg border border-bordercolor shadow-sm overflow-hidden flex flex-col min-h-[350px] flex-1">
                            <div class="px-4 py-3 border-b border-bordercolor bg-appbg flex items-center justify-between shrink-0">
                                <h3 class="text-sm font-bold text-textprimary">Related Parties Detail</h3>
                                @* <div class="flex items-center gap-2">
                                    <button class="h-6 w-6 text-textmuted hover:text-primary flex items-center justify-center transition-colors" onclick="toggleFullscreen('right')">
                                        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.14645 11.1464C1.95118 11.3417 1.95118 11.6583 2.14645 11.8536C2.34171 12.0488 2.65829 12.0488 2.85355 11.8536L6.5 8.20711V11.5C6.5 11.7761 6.72386 12 7 12C7.27614 12 7.5 11.7761 7.5 11.5V6.5C7.5 6.22386 7.27614 6 7 6H2C1.72386 6 1.5 6.22386 1.5 6.5C1.5 6.77614 1.72386 7 2 7H5.29289L2.14645 10.1464C2.14645 10.1464 2.14645 11.1464 2.14645 11.1464ZM8.85355 3.85355C9.04882 3.65829 9.04882 3.34171 8.85355 3.14645C8.65829 2.95118 8.34171 2.95118 8.14645 3.14645L4.5 6.79289V3.5C4.5 3.22386 4.27614 3 4 3C3.72386 3 3.5 3.22386 3.5 3.5V8.5C3.5 8.77614 3.72386 9 4 9H9C9.27614 9 9.5 8.77614 9.5 8.5C9.5 8.22386 9.27614 8 9 8H5.70711L8.85355 4.85355C8.85355 4.85355 8.85355 3.85355 8.85355 3.85355Z" fill="currentColor" fillRule="evenodd" clipRule="evenodd"></path></svg>
                                    </button>
