        function applyRiskSelections(riskDetails) {

                // console.log(riskDetails);

                if (!riskDetails) return;

                // Support both Individual & Corporate keys
                let riskData = riskDetails.riskTypeCategoryDTO || [];

                            let reportData = riskDetails.reportDataDTO || [];


                let rating =
                    riskDetails.riskAssessmentRating ||
                    riskDetails.finalRiskScore ||
                    "";
                                    let type = riskDetails.type || "0";
                                    $('#type').val(type);
                let counter = 0;

                for (let i = 0; i < riskData.length; i++) {

                    let category = riskData[i];

                    for (let j = 0; j < category.riskTypes.length; j++) {

                        let riskType = category.riskTypes[j];

                        let dropdown = $(`#ddlItem_${counter}`);
                        let scoreCircle = $(`#clrScore_${counter}`);
                        let scoreHidden = $(`#clrScorehdn_${counter}`);

                        if (!dropdown.length) {
                            counter++;
                            continue;
                        }

                        // ⭐ CASE 1 → itemTxt NOT AVAILABLE → RESET
                        if (!riskType.itemTxt || riskType.itemTxt.trim() === "") {

                            dropdown.val("0").trigger("change");
                                
                            scoreCircle.text("0");

                            scoreCircle.removeClass().addClass(
                                "score-badge text-[10px] font-semibold inline-flex items-center justify-center w-10 h-6 rounded-full bg-slate-200 text-white"
                            );

                            scoreHidden.val("0");

                            counter++;
                            continue;
                        }

                        // ⭐ CASE 2 → Assign Value
                        let optionValue = dropdown.find("option").filter(function () {

                            return $(this).text().trim().toLowerCase() ===
                                riskType.itemTxt.trim().toLowerCase();

                        }).val();

                        if (optionValue) {

                            // Let ItemChange() calculate score
                            dropdown.val(optionValue).trigger("change");

                        }
                        else {

                            dropdown.val("0").trigger("change");

                            scoreCircle.text("0");

                            scoreCircle.removeClass().addClass(
                                "score-badge text-[10px] font-semibold inline-flex items-center justify-center w-10 h-6 rounded-full bg-slate-200 text-white"
                            );

                            scoreHidden.val("0");
                        }

                        counter++;
                    }
                }

                /* ================================
                   APPLY FINAL RISK RATING BADGE
                ================================= */



            let badge = $("#riskRatingBadge");

            if (!badge.length) return;

            badge.removeClass(
                "bg-green-500 bg-yellow-400 bg-red-500 text-white"
            );

            badge.addClass("px-3 py-1 rounded-full text-xs font-bold text-white");
                       

            // Check if any individual risk parameter has override score 3
                       let hasHighOverride = reportData.some(riskType =>
                Number(riskType.over_ride_Score) === 3
            );

            console.log("Has Override 3:", hasHighOverride);
            console.log("rating:", rating);

            // Apply final badge status and color using the robust updateRiskBadge function
            let displayRating = rating;
            if (rating.toLowerCase().includes("high") && hasHighOverride && !rating.toLowerCase().includes("(o)")) {
                displayRating = "High Risk (O)";
            }
            
            updateRiskBadge(displayRating);
            }

