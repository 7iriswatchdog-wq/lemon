               </form>
                    @{
                        bool disableButtons = Model.IsReadOnly;
                        bool hasPendingShareholders = false;
                        bool hasDualGoodsMatch = false;
                        bool hasMilitaryGoodsMatch = false;

                        // Check Shareholders (Only block if direct/indirect descendants of the main entity are pending, not group members)
                        if (Model.ShareholdersData != null && Model.ShareholdersData.Any() && !string.IsNullOrEmpty(Model.Case?.CustomerId))
                        {
                            var mainCustId = Model.Case.CustomerId;
                            var allNodesList = Model.ShareholdersData;
                            
                            // Recursive helper to check if a node is direct/indirect descendant of the main entity
                            Func<AML.ViewModel.ViewModels.CustomerCase.CaseModel, bool> isDescendant = null;
                            isDescendant = (node) => {
                                if (node == null || string.IsNullOrEmpty(node.ParentId)) return false;
                                if (AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(node.ParentId, mainCustId)) return true;
                                var parents = allNodesList.Where(n => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(node.ParentId, n.CustomerId) && n.CustomerId != node.CustomerId).ToList();
                                return parents.Any(p => isDescendant(p));
                            };

                            hasPendingShareholders = allNodesList.Any(s => 
                                (AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, mainCustId) || isDescendant(s)) && 
                                (s.Status == 0 || s.Status == 5 || s.Status == 6)
                            );
                        }

                        // Check Dual Goods
                        hasDualGoodsMatch = Model.DualGoodsMatchStatus == "Pending" || Model.DualGoodsMatchStatus == "Potential Match";

                        // Check Military Goods
                        hasMilitaryGoodsMatch = Model.MilitaryGoodsMatchStatus == "Pending" || Model.MilitaryGoodsMatchStatus == "Potential Match";

                        // Disable button if any condition is true
                        if (hasPendingShareholders || hasDualGoodsMatch || hasMilitaryGoodsMatch) 
                        {
                            disableButtons = true;
                        }

                        bool finalDisableButtons = disableButtons;
                        bool isSearchResultsSaved =
                            Model.DataList == null ||
                            !Model.DataList.Any() ||
                            Model.DataList.Any(x =>
                                x.searchTypes != null &&
                                x.searchTypes.Any(s => !string.IsNullOrWhiteSpace(s))
                            );
                        var riskversions = Model.RiskVersionData;
                        int risktotal = riskversions != null ? riskversions.Count : 0;

                        // Enable buttons when Version 2 or higher exists
                        bool isRiskAssessmentSaved = risktotal >= 2;

                        bool isAdditionalValidationPassed =
                        isSearchResultsSaved || isRiskAssessmentSaved;

                        if (!isAdditionalValidationPassed)
                        {
                            finalDisableButtons = true;
                        }
                    }
