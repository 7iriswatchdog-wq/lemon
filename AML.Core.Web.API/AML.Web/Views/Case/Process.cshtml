        <script>

            const webSearchTypes = [
                          "Domestic PEP","Foreign PEP","REL","RRE","INS",
                              "DD","GRI","SOE","UAE Sanction","UN Sanction",
                              "Other Sanctions","VHNWI","None"
                      ];

            document.addEventListener("DOMContentLoaded", () => {

                const totalRows =
                    document.querySelectorAll('[id^="web-search-trigger-"]').length;

                for (let i = 0; i < totalRows; i++) {
                    initializeWebSearchTypes(i);
                }

            });
                        function initializeWebSearchTypes(index) {

                const optionsContainer =
                    document.getElementById(`web-search-options-${index}`);

                if (!optionsContainer)
                    return;

                optionsContainer.innerHTML = "";

                webSearchTypes.forEach(type => {

                    optionsContainer.insertAdjacentHTML(
                        "beforeend",
                        `
                        <label class="flex items-center gap-2 text-xs">
                            <input type="checkbox"
                                   value="${type}"
                                   class="web-search-option-${index}">
                            ${type}
                        </label>
                        `
                    );
                });
            }
                                    function toggleWebSearchPopover(index) {

                const trigger =
                    document.getElementById(`web-search-trigger-${index}`);

                const popover =
                    document.getElementById(`web-search-popover-${index}`);

                if (!trigger || !popover)
                    return;

                // Close other dropdowns
                document
                    .querySelectorAll("[id^='web-search-popover-']")
                    .forEach(x => {
                        if (x !== popover)
                            x.classList.add("hidden");
                    });

                const rect = trigger.getBoundingClientRect();

                popover.style.top =
