    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        /* Modal backdrop */
        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.5);
        }

        /* Transition for column width */
       /*  .column-transition {
            transition: width 300ms, opacity 300ms;
        } */
        .column-transition {
            transition: flex-basis 0.25s ease, opacity 0.25s ease;
        }
        @@keyframes blinkRisk {
            0%

        {
            opacity: 1;
        }

        50% {
            opacity: 0.2;
        }

        100% {
            opacity: 1;
        }

        }

        .blink-risk {
            animation: blinkRisk 1s infinite;
        }

        .grid-cols-15 {
            grid-template-columns: repeat(15, minmax(0, 1fr));
        }

        .grid-cols-17 {
            grid-template-columns: repeat(17, minmax(0, 1fr));
        }
    </style>
    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }

        /* Premium clickable search result rows */
        #searchResultsBody tr {
            cursor: pointer;
            transition: all .2s cubic-bezier(.25,.8,.25,1);
            position: relative;
        }
        #searchResultsBody tr:hover {
            background: linear-gradient(90deg, #eff6ff 0%, #f8fafc 100%) !important;
            transform: translateX(3px);
            box-shadow: 0 2px 12px rgba(59,130,246,.08), inset 4px 0 0 #3b82f6;
        }
        #searchResultsBody tr:hover td {
            color: #1e293b !important;
        }
        #searchResultsBody tr:hover td:first-child {
            color: #3b82f6 !important;
        }
        #searchResultsBody tr .sr-arrow {
            opacity: 0;
            transform: translateX(-8px);
            transition: all .2s ease;
            color: #3b82f6;
        }
        #searchResultsBody tr:hover .sr-arrow {
            opacity: 1;
            transform: translateX(0);
        }
        #searchResultsBody tr:active {
            transform: translateX(1px) scale(.998);
        }

        input[type="number"] {
            -moz-appearance: textfield; /* Firefox */
            appearance: textfield; /* Standard */
        }

            input[type="number"]::-webkit-inner-spin-button,
            input[type="number"]::-webkit-outer-spin-button {
                -webkit-appearance: none; /* Chrome, Edge, Safari */
                margin: 0;
            }
        </style>
</head>

