            // Optional loader
            $('.se-pre-con').fadeIn("fast");

            $.ajax({
                url: '/risk/saveversion',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),

                        success: function (res) {

                            console.log("Returned Data => ", res);

