                                 document.addEventListener("DOMContentLoaded", function () {

                    const allOptions = @Html.Raw(codesJson);

                    // Manual Form Dropdown
                    initScreeningDropdown({
                        options: allOptions,
                        triggerBtnId: "trigger-btn",
                        triggerTextId: "trigger-text",
                        popoverContentId: "popover-content",
                        allCheckboxId: "corporate-all",
                        optionsContainerId: "options-container",
                        hiddenContainerId: "codesHiddenContainer",
                        postPrefix: ""
                    });

                    // OCR Form Dropdown
                    initScreeningDropdown({
                        options: allOptions,
                        triggerBtnId: "trigger-btn-OCR",
                        triggerTextId: "trigger-text-OCR",
                        popoverContentId: "popover-content-OCR",
                        allCheckboxId: "corporate-all-OCR",
                        optionsContainerId: "options-container-OCR",
                        hiddenContainerId: "codesHiddenOCRContainer",
                        postPrefix: "OCR"
                    });

                });

                function initScreeningDropdown(config) {

                    const allOptions = config.options;
                    let selectedOptions = allOptions.map(x => x.value);

                    const triggerBtn = document.getElementById(config.triggerBtnId);
                    const triggerText = document.getElementById(config.triggerTextId);
                    const popoverContent = document.getElementById(config.popoverContentId);
                    const allCheckbox = document.getElementById(config.allCheckboxId);
                    const optionsContainer = document.getElementById(config.optionsContainerId);
                    const hiddenContainer = document.getElementById(config.hiddenContainerId);

                    if (!triggerBtn || !popoverContent || !optionsContainer || !hiddenContainer || !allCheckbox)
                        return;

                    /* -------------------------
                       Render Options
                    --------------------------*/
                    function renderOptions() {

                        optionsContainer.innerHTML = '';

                        allOptions.forEach(option => {

                            const div = document.createElement('div');
                            div.className = 'flex items-center space-x-2';

                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.value = option.value;
                            checkbox.className = 'h-4 w-4 rounded border-slate-300 text-blue-600';
                            checkbox.checked = selectedOptions.includes(option.value);

                            checkbox.addEventListener('change', (e) => {
                                if (e.target.checked) {
                                    if (!selectedOptions.includes(option.value)) {
                                        selectedOptions.push(option.value);
                                    }
                                } else {
                                    selectedOptions = selectedOptions.filter(x => x !== option.value);
                                }

                                // Update ALL checkbox when individual changes
                                allCheckbox.checked = selectedOptions.length === allOptions.length;

                                updateUI();
                            });

                            const label = document.createElement('label');
                            label.className = 'text-sm font-medium cursor-pointer';
                            label.textContent = option.text;

                            div.appendChild(checkbox);
                            div.appendChild(label);
                            optionsContainer.appendChild(div);
                        });
                    }

                    /* -------------------------
                       Update UI
                    --------------------------*/
                    function updateUI() {

                        const isAllSelected = selectedOptions.length === allOptions.length;
                        allCheckbox.checked = isAllSelected;

                        if (isAllSelected) {
                            triggerText.textContent = 'ALL';
                        } else if (selectedOptions.length > 0) {
                            triggerText.textContent = `${selectedOptions.length} option(s) selected`;
                        } else {
                            triggerText.textContent = 'Select screening options';
                        }

                        updateCodesForPost();
                    }

                    /* -------------------------
                       Hidden Inputs for POST
                    --------------------------*/
                    function updateCodesForPost() {

                        hiddenContainer.innerHTML = '';

                        const prefix = config.postPrefix ? config.postPrefix + "." : "";

                        allOptions.forEach((option, index) => {

                            const isSelected = selectedOptions.includes(option.value);

                            // CodeNames
                            const codeName = document.createElement('input');
                            codeName.type = 'hidden';
                            codeName.name = `${prefix}CodeNames[${index}]`;
                            codeName.value = option.value;
                            hiddenContainer.appendChild(codeName);

                            // IsChecked
                            const isChecked = document.createElement('input');
                            isChecked.type = 'hidden';
                            isChecked.name = `${prefix}IsChecked[${index}]`;
                            isChecked.value = isSelected;
                            hiddenContainer.appendChild(isChecked);
                        });
                    }

                    /* -------------------------
                       ALL Checkbox Logic
                    --------------------------*/
                    allCheckbox.addEventListener('change', (e) => {

                        if (e.target.checked) {
                            selectedOptions = allOptions.map(x => x.value);
                        } else {
                            selectedOptions = [];
                        }

                        // Update each checkbox visually
                        optionsContainer.querySelectorAll("input[type='checkbox']").forEach(cb => {
                            cb.checked = selectedOptions.includes(cb.value);
                        });

                        updateUI();
                    });

                    /* -------------------------
                       Toggle Popover
                    --------------------------*/
                    triggerBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        popoverContent.classList.toggle('hidden');
                    });

                    /* -------------------------
                       Close on Outside Click
                    --------------------------*/
                    if (!popoverContent.dataset.listenerAttached) {

                        document.addEventListener('click', (e) => {

                            if (!triggerBtn.contains(e.target) &&
                                !popoverContent.contains(e.target)) {

                                popoverContent.classList.add('hidden');
                            }
                        });

                        popoverContent.dataset.listenerAttached = "true";
                    }

                    // Initial Load
                    renderOptions();
                    updateUI();
                }




        

                        function DownloadSample() {

                var type = $('#typeid').val();

                fetch('/ClientCase/DownloadCustomerUploadSample?type=' + type)
                    .then(response => {

                        if (!response.ok) throw new Error("Download failed");

                        let fileName = "Download.xlsx";

                        const disposition = response.headers.get('Content-Disposition');

                        if (disposition) {

                            // FIRST try filename*
                            const fileNameStarMatch = disposition.match(/filename\*=UTF-8''([^;]+)/);

                            if (fileNameStarMatch && fileNameStarMatch[1]) {
                                fileName = decodeURIComponent(fileNameStarMatch[1]);
                            }
                            else {

                                // fallback to filename
                                const fileNameMatch = disposition.match(/filename="?([^"]+)"?/);

                                if (fileNameMatch && fileNameMatch[1]) {
                                    fileName = fileNameMatch[1];
                                }
                            }
                        }

                        return response.blob().then(blob => ({ blob, fileName }));
                    })
                    .then(({ blob, fileName }) => {

                        const link = document.createElement('a');
                        link.href = window.URL.createObjectURL(blob);
                        link.download = fileName;

                        document.body.appendChild(link);
                        link.click();
                        link.remove();

                        window.URL.revokeObjectURL(link.href);
                    })
                    .catch(err => {
                        console.error(err);
                        alert("Download failed");
                    });
            }

                         
