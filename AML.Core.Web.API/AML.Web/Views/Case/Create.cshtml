<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Individual Case Creation - Search</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Group Details Modal -->
        <div x-show="showGroupDetailsModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <!-- Backdrop -->
            <div x-show="showGroupDetailsModal" x-transition.opacity class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="showGroupDetailsModal = false"></div>
            
            <!-- Modal Content -->
            <div x-show="showGroupDetailsModal"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95 translate-y-4"
                 x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                 x-transition:leave-end="opacity-0 scale-95 translate-y-4"
                 class="relative bg-white rounded-2xl shadow-xl w-full max-w-3xl overflow-hidden flex flex-col max-h-[85vh]">
                 
                 <!-- Header -->
                <div class="px-6 py-4 border-b border-bordercolor flex items-center justify-between bg-slate-50">
                    <div>
                        <h3 class="text-lg font-bold text-textprimary">Group Details</h3>
                        <p class="text-sm text-textsecondary" x-text="selectedGroupName"></p>
                    </div>
                    <button type="button" @@click="showGroupDetailsModal = false" class="w-8 h-8 flex items-center justify-center rounded-lg text-textmuted hover:bg-slate-200 transition-colors">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <!-- Body: Member List & Add Member -->
                <div class="p-6 overflow-y-auto flex-1 space-y-6">
                    <!-- Add Member -->
                    <div class="flex items-start gap-3">
                        <div class="flex-1">
                            <label class="block text-[13px] font-medium text-textlabel mb-1">Case ID</label>
                            <input type="text" x-model="newMemberId" @@input.debounce.500ms="lookupNewMemberName()" placeholder="Enter Case ID..." class="w-full h-10 border border-bordercolor rounded-lg px-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                            <div x-show="newMemberError" x-text="newMemberError" class="text-xs text-red-500 mt-1"></div>
                        </div>
                        <div class="flex-1">
                            <label class="block text-[13px] font-medium text-textlabel mb-1">Name</label>
                            <input type="text" x-model="newMemberName" readonly placeholder="Auto-populated..." class="w-full h-10 bg-slate-50 border border-bordercolor rounded-lg px-3 text-sm text-gray-500 outline-none cursor-not-allowed">
                        </div>
                        <div class="pt-6">
                            <button type="button" :disabled="!newMemberId || !newMemberName" @@click="addGroupMember()" class="h-10 px-4 bg-primary text-white text-sm font-bold rounded-lg hover:bg-primary-hover flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                                <i data-lucide="plus" class="w-4 h-4"></i> Add Member
                            </button>
                        </div>
                    </div>

                    <!-- Members Table -->
                    <div class="border border-bordercolor rounded-xl overflow-hidden">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-bordercolor">
                                    <th class="px-4 py-3 text-xs font-bold text-textlabel uppercase">Case ID</th>
                                    <th class="px-4 py-3 text-xs font-bold text-textlabel uppercase">Name</th>
                                    <th class="px-4 py-3 text-xs font-bold text-textlabel uppercase">Risk Level</th>
                                    <th class="px-4 py-3 text-xs font-bold text-textlabel uppercase text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="member in selectedGroupMembers" :key="member.id">
                                    <tr class="border-b border-bordercolor hover:bg-slate-50">
                                        <td class="px-4 py-3 text-sm text-textprimary" x-text="member.customerId || member.id"></td>
                                        <td class="px-4 py-3 text-sm font-medium text-textprimary" x-text="member.firstName || member.groupEntityof"></td>
                                        <td class="px-4 py-3 text-sm">
                                            <span class="px-2 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600" x-text="member.groupRisk || 'Unclassified'"></span>
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            <!-- Process -->
                                            <a :href="'/case/Process/' + member.id" 
                                               x-show="pendingRemoveMemberId !== member.id"
                                               class="inline-block text-primary hover:text-primary-hover p-1 rounded hover:bg-blue-50 transition-colors mr-1" title="Process Case">
                                                <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                                            </a>
                                            <!-- Trash (default) -->
                                            <button type="button"
                                                x-show="pendingRemoveMemberId !== member.id"
                                                @@click="pendingRemoveMemberId = member.id"
                                                class="text-red-500 hover:text-red-700 p-1 rounded hover:bg-red-50 transition-colors" title="Remove Member">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                            <!-- Inline confirm: tick + cross -->
                                            <span x-show="pendingRemoveMemberId === member.id" class="inline-flex items-center gap-1">
                                                <button type="button"
                                                    @@click="removeGroupMember(member.customerId)"
                                                    class="w-7 h-7 flex items-center justify-center rounded-lg bg-green-500 hover:bg-green-600 text-white transition-colors" title="Confirm Remove">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                                </button>
                                                <button type="button"
                                                    @@click="pendingRemoveMemberId = null"
                                                    class="w-7 h-7 flex items-center justify-center rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 transition-colors" title="Cancel">
                                                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                                </button>
                                            </span>
                                        </td>
                                    </tr>
                                </template>
                                <tr x-show="selectedGroupMembers.length === 0">
                                    <td colspan="4" class="px-4 py-8 text-center text-textmuted text-sm">No members found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
