                                                      init() {
                                        // listen for dropdown change
                                        window.addEventListener('tab-changed', (e) => {
                                            if (!e.detail) return;
                                            this.updateFormsType(e.detail);
                                        });
                                    },
                                // Add a new form
                                addForm() {
                                    if (this.forms.length >= this.maxForms) {
                                        toastr.error("Only 5 forms allowed");
                                        return;
                                    }
                                    this.forms.push({ 
