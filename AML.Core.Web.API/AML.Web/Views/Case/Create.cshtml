                        async function deletePendingCompany(companyCode) {

                // if (!confirm("Are you sure you want to delete this company and its shareholders?")) {
                //     return;
                // }

                try {

                    let response = await fetch(`/corporate/DeletePendingShareholders?companyCode=${companyCode}`, {
                        method: 'POST'
                    });

                    let result = await response.json();

                    if (result.success) {

                        // Remove from global data
                        window.pendingShareholderData =
                            window.pendingShareholderData.filter(x => x.companyCode !== companyCode);

                        let remainingCompanies = [...new Set(window.pendingShareholderData.map(x => x.companyCode))];

                        if (remainingCompanies.length === 0) {

                            // Close modal
                            $('#rollbackModal').addClass('hidden').removeClass('flex');

                        } else {

                            // Rebuild modal list
                            let html = "";

                            remainingCompanies.forEach(code => {

                                html += `
                                            <label class="flex items-center gap-3 px-4 py-3 hover:bg-blue-50 text-sm">

                                    <div class="flex items-center gap-3 cursor-pointer">

                                        <input type="radio"
                                               name="pendingCompany"
                                               value="${code}"
                                               class="w-4 h-4 text-primary border-slate-300">

                                        <span class="font-medium text-textlabel">
                                            ${code}
                                        </span>

                                    </div>

                                    <button onclick="deletePendingCompany('${code}')"
                                        class="ml-auto text-red-500 hover:text-red-700 text-lg font-bold leading-none">
                                        ×
                                    </button>

                                </label>`;
                            });

                            document.getElementById("pendingCompanyList").innerHTML = html;
                        }

                    }

                } catch (e) {
                    console.error(e);
                }

            }
