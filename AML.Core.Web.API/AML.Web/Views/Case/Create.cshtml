            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
