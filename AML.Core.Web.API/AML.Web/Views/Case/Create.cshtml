                                      function shareholderTree() {

                                return {

                                    items: [],
                                    // 2026-05-03: org-chart visualisation toggle. Defaults to true so users
                                    // see the new visual chart when they open the side-sheet; they can flip
                                    // to the list view when they need to drag-and-drop reorder.
                                    chartMode: true,

                                    syncFromStore() {

                                        this.items = JSON.parse(
                                            JSON.stringify(Alpine.store('screeningStore').screeningList || [])
                                        );
                                    },

                                    init() {

                                        this.syncFromStore();

                                        this.$nextTick(() => {
                                            this.initSortable();
                                        });

                                        window.addEventListener('store-updated', () => {
                                            this.syncFromStore();
                                        });
                                    },

                                    // ⭐ Org-chart HTML builder (read-only visualisation).
                                    // Converts the flat items array into nested boxes-with-connectors HTML
                                    // via a recursive renderer. Returns a single HTML string that gets
                                    // injected into the page via x-html. Intentionally produces NO Alpine
                                    // directives in the output — it's a static visual snapshot, no events.
                                    // For drag-drop / delete / edit, users switch back to the list view.
                                    buildOrgChartHtml() {
                                        const list = this.items || [];

                                        // Pull the case's main party (customer code/name) from the hidden
                                        // inputs filled by the companySearch() form. The side-sheet lives
                                        // outside that Alpine scope so we can't bind directly — the inputs
                                        // are the source of truth either way.
                                        const customerCode = (document.getElementById('CompanyCodeHidden')?.value || '').trim();
                                        const customerName = (document.getElementById('CompanyNameHidden')?.value || '').trim();
                                        const hasMainParty = !!(customerCode || customerName);

                                        if (!list.length && !hasMainParty) {
                                            return '<div class="org-empty">No shareholders yet — add some on the left to see the chart.</div>';
                                        }

                                        // Group items by parentId for fast child lookup.
                                        const byParent = {};
                                        list.forEach(item => {
                                            const pid = item.parentId == null ? '__root__' : item.parentId;
                                            (byParent[pid] = byParent[pid] || []).push(item);
                                        });

                                        // Same labels + slug as the list-view badge — keeps the two views consistent.
                                        const typeLabel = {
                                            shareholder: 'Individual Shareholder',
                                            corporate_shareholder: 'Corporate Shareholder',
                                            signatories: 'Authorized Signatory',
                                            management: 'Senior Management',
                                            related_shareholder: 'Related Party (Indiv.)',
                                            related_corporate_shareholder: 'Related Party (Corp.)',
                                            director: 'Director',
                                            beneficial_owner: 'Beneficial Owner'
                                        };

                                        const escape = (s) => String(s == null ? '' : s)
                                            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                                            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

                                        const initials = (item) => {
                                            if (item.initials) return escape(item.initials);
                                            const n = (item.name || '').trim();
                                            if (!n) return '?';
                                            const parts = n.split(/\s+/);
                                            return escape(((parts[0]||'')[0] || '') + ((parts[1]||'')[0] || '')).toUpperCase();
                                        };

                                        const renderNode = (item) => {
                                            const children = byParent[item.id] || [];
                                            const childHtml = children.length
                                                ? `<div class="org-children">${children.map(renderNode).join('')}</div>`
                                                : '';
                                            const label = typeLabel[item.type] || item.type || 'Related Party';
                                            const rel   = item.relationship ? `<div class="org-rel">${escape(item.relationship)}</div>` : '';
                                            const dup   = (item.isDuplicate == 1) ? '<span class="org-dup" title="Duplicate detected">⚠</span>' : '';
                                            return `
                                                <div class="org-node" data-rel-type="${escape(item.type || '')}">
                                                    <div class="org-card">
                                                        <div class="org-avatar">${initials(item)}</div>
                                                        <div class="org-body">
                                                            <div class="org-name">${escape(item.name || '(unnamed)')} ${dup}</div>
                                                            <div class="org-badge">${escape(label)}</div>
                                                            ${rel}
                                                            <div class="org-displayid">${escape(item.displayId || '')}</div>
                                                        </div>
                                                    </div>
                                                    ${childHtml}
                                                </div>
                                            `;
                                        };

                                        const roots = byParent['__root__'] || [];

                                        // Render the synthetic main-party node at the top with all
                                        // root shareholders nested as its children. Visually anchors
                                        // every related party to the actual customer of the case.
                                        if (hasMainParty) {
                                            const mainName = customerName || customerCode;
                                            const mainInit = initials({ name: mainName });
                                            const childrenHtml = roots.length
                                                ? `<div class="org-children">${roots.map(renderNode).join('')}</div>`
                                                : '';
                                            return `
                                                <div class="org-chart">
                                                    <div class="org-node org-node-main" data-rel-type="main_party">
                                                        <div class="org-card org-card-main">
                                                            <div class="org-avatar org-avatar-main">${mainInit}</div>
                                                            <div class="org-body">
                                                                <div class="org-name">${escape(mainName)}</div>
                                                                <div class="org-badge org-badge-main">Main Party</div>
                                                                ${customerCode ? `<div class="org-displayid">${escape(customerCode)}</div>` : ''}
                                                            </div>
                                                        </div>
                                                        ${childrenHtml}
                                                    </div>
                                                </div>
                                            `;
                                        }

                                        // Fallback: no main party (shouldn't normally happen on this page,
                                        // but keep the chart usable for edge cases / standalone testing).
                                        return `<div class="org-chart">${roots.map(renderNode).join('')}</div>`;
                                    },


                                    // ⭐ Numbering + Tree Build
                                    flattenedItems() {

                                        let list = this.items || [];

                                        function build(parentId = null, prefix = "", depth = 0) {

                                            let children = list.filter(x => x.parentId === parentId);

                                            return children.flatMap((item, index) => {

                                                let number = prefix
                                                    ? `${prefix}.${index + 1}`
                                                    : `${index + 1}`;

                                                return [
                                                    { ...item, depth, displayId: number },
                                                    ...build(item.id, number, depth + 1)
                                                ];
                                            });
                                        }

                                        return build();
                                    },


                                    // ⭐ Drag Logic
                                    initSortable() {

                                        let self = this;
                                        let container = document.getElementById("shareholderTreeContainer");

                                        if (!container) return;

                                        new Sortable(container, {

                                            animation: 150,
                                            handle: ".drag-handle",

                                                        onEnd(evt) {

                                    if (!evt.item || !evt.item.dataset.id) return;

                                    let movedId = Number(evt.item.dataset.id);
                                    let prev = evt.item.previousElementSibling;

                                    let newParentId = null;
                                    let store = Alpine.store('screeningStore');

                                    if (prev && prev.dataset.id) {
                                        let prevId = Number(prev.dataset.id);
                                        let prevItem = self.items.find(x => x.id === prevId);

                                        if (prevItem) {
                                            // Count underscores to limit nesting depth to 7
                                            let underscoreCount = (prevItem.type.match(/_/g) || []).length;

                                            // If above item has room for more underscores, become its child
                                            if (underscoreCount < 7) {
                                                newParentId = prevItem.id;
                                            } else {
                                                // Otherwise become its sibling
                                                newParentId = prevItem.parentId;
                                            }
                                        }
                                    }

                                    let moved = store.screeningList.find(x => x.id === movedId);
                                    if (!moved) return;

                                    // Helper to get base type (Corp or Ind)
                                    const getBase = (type) => {
                                        return type.endsWith("Corp") ? "Corp" : "Ind";
                                    };

                                    moved.parentId = newParentId;

                                    // Recursive function to update types of moved item and all its descendants
                                    const updateHierarchyTypes = (item, pId) => {
                                        let parent = store.screeningList.find(x => x.id === pId);
                                        let itemBase = getBase(item.type);
                                        
                                        if (parent) {
                                            item.type = parent.type + "_" + itemBase;
                                        } else {
                                            let rootPrefix = item.type.split('_')[0] || "Individual";
                                            item.type = rootPrefix + "_" + itemBase;
                                        }

                                        // Update children
                                        store.screeningList.filter(x => x.parentId === item.id).forEach(child => {
                                            updateHierarchyTypes(child, item.id);
                                        });
                                    };

                                    updateHierarchyTypes(moved, newParentId);

                                    store.screeningList = [...store.screeningList];
                                    window.dispatchEvent(new Event('store-updated'));
                                    }

                                            // onEnd(evt) {

                                            //     if (!evt.item || !evt.item.dataset.id) return;

                                            //     let movedId = Number(evt.item.dataset.id);
                                            //     let prev = evt.item.previousElementSibling;

                                            //     let newParentId = null;

