                        function setDateInput(form, inputId, dateValue) {
                const input = form.querySelector(`#${inputId}`);
                if (!input) return;

                if (!dateValue) {
                    if (input._flatpickr) input._flatpickr.clear();
                    else input.value = "";
                    return;
                }

                console.log(`Setting date for ${inputId}:`, dateValue);

                // If flatpickr is attached, use its API so the visible altInput updates
                if (input._flatpickr) {
                    input._flatpickr.setDate(dateValue, true, "Y-m-d");
                    console.log(`Successfully set ${inputId} via flatpickr to`, dateValue);
                    return;
                }

                // Fallback for plain inputs
                let parsedDate = new Date(dateValue);
                if (!isNaN(parsedDate.getTime())) {
                    const year = parsedDate.getFullYear();
                    const month = String(parsedDate.getMonth() + 1).padStart(2, "0");
                    const day = String(parsedDate.getDate()).padStart(2, "0");
                    input.value = `${year}-${month}-${day}`;
                    console.log(`Successfully set ${inputId} to ${input.value}`);
                } else {
                    input.value = "";
                    console.warn(`Invalid date format for ${inputId}:`, dateValue);
                }
            }

            // Set a date field — scoped to myOCRForm or myForm to avoid duplicate-ID conflicts
            function setFlatpickrDate(selector, dateValue) {
                const scopeIds = ["myOCRForm", "myForm"];
                let el = null;
                
                for (let id of scopeIds) {
                    const scope = document.getElementById(id);
                    if (scope) {
                        el = scope.querySelector(selector);
                        if (el) {
                            console.log(`[OCR] Using scope ${id} for selector ${selector}`);
                            break;
                        }
                    }
                }

                if (!el) {
                    // Global fallback
                    el = document.querySelector(selector);
                }

                if (!el) { 
                    console.warn('setFlatpickrDate: element not found for selector', selector); 
                    return; 
                }

                if (!dateValue) { 
                    try { if (el._flatpickr) el._flatpickr.clear(); else el.value = ""; } catch(e) {} 
                    return; 
                }

                if (el._flatpickr && typeof el._flatpickr.setDate === 'function') {
                    try {
                        // Use the API with a slight delay to ensure the calendar is fully initialized if needed
                        el._flatpickr.setDate(dateValue, false, "Y-m-d"); 
                        console.log(`setFlatpickrDate: set ${selector} →`, dateValue);
                    } catch(e) {
                        // Fallback: set value directly on the alt input if flatpickr internal render fails (e.g. index error)
                        if (el._flatpickr.altInput) el._flatpickr.altInput.value = dateValue;
                        else el.value = dateValue;
                        console.warn(`setFlatpickrDate fallback for ${selector} due to internal error:`, e.message);
                    }
                } else {
                    el.value = dateValue;
                    console.log(`setFlatpickrDate (plain): set ${selector} →`, dateValue);
                }
            }


                        function clearOCRForm() {
                const form = document.querySelector("#myOCRForm");
                if (!form) return;

                // --- Reset native form ---
                form.reset();

                // --- Identify screening elements ---
                const optionsContainer = form.querySelector("#options-container-OCR");
                const allCheckbox = form.querySelector("#corporate-all-OCR");

                // --- Force clear ALL inputs manually, excluding screening options ---
                form.querySelectorAll("input, select, textarea").forEach(el => {

                    // Skip OCR screening checkboxes
                    if (
                        el === allCheckbox ||                   // "ALL" checkbox
                        (optionsContainer && optionsContainer.contains(el)) // dropdown checkboxes
                    ) {
                        return; // do not clear
                    }

                    // if (el.type === "checkbox" || el.type === "radio") {
                    //     el.checked = false; // Only clears non-screening checkboxes
                    // }
                    else if (el.type === "file") {
                        el.value = "";
                    }
                    else {
                        el.value = "";
                    }
                });

                // --- Clear validation messages (optional) ---
                form.querySelectorAll("span[data-valmsg-for]").forEach(span => {
                    span.textContent = "";
                    span.classList.remove("field-validation-error");
                });

                // --- Remove invalid styling ---
                form.querySelectorAll(".is-invalid").forEach(el => {
                    el.classList.remove("is-invalid");
                });

                // --- Reset threshold slider (Alpine bound) ---
                const threshold = form.querySelector("#threshold");
                if (threshold) threshold.value = 70;
            }



