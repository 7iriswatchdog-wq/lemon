                        function setShareholderViewFlag() {
                localStorage.setItem("hideBackButton", "true");
            }
            
        </script>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('groupEntities', () => ({
            groupsData: [],
            filteredGroups: [],
            groupSearchQuery: '',
            showCreateGroupForm: false,
            newGroupName: '',
            newGroupIds: [{id: '', name: '', loading: false}],
            isSubmittingGroup: false
        }));
    });

    window.addEventListener('load-group-entities', function(e) {
        fetch('/case/GetAllGroupEntities')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.dispatchEvent(new CustomEvent('update-groups-data', { detail: data.data }));
                }
            })
            .catch(err => console.error(err));
    });

    function fetchEntityName(index, id) {
        if (!id || id.length < 3) return;
        
        const alpineData = document.querySelector('body')._x_dataStack[0];
        alpineData.newGroupIds[index].loading = true;

        fetch(`/case/GetCustomerNameById?customerId=${id}`)
            .then(res => res.json())
            .then(data => {
                alpineData.newGroupIds[index].loading = false;
                if (data.success) {
                    alpineData.newGroupIds[index].name = data.name;
                } else {
                    alpineData.newGroupIds[index].name = 'Not Found';
                }
            })
            .catch(err => {
                alpineData.newGroupIds[index].loading = false;
                alpineData.newGroupIds[index].name = 'Error fetching name';
            });
    }

    function fetchGroupMembers(groupId) {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        alpineProxy.selectedGroupMembers = []; // Clear
        const gid = groupId || alpineProxy.selectedGroupId;
        fetch(`/case/GetGroupMembers?groupId=${encodeURIComponent(gid)}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alpineProxy.selectedGroupMembers = data.data;
                } else {
                    console.warn('GetGroupMembers failed:', data);
                }
            })
            .catch(err => console.error(err));
    }

    function addGroupMember() {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        if (!alpineProxy.newMemberId) return;
        
        const payload = {
            GroupId: alpineProxy.selectedGroupId,
            CustomerId: alpineProxy.newMemberId
        };

        fetch('/case/AddGroupMember', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alpineProxy.newMemberId = '';
                alpineProxy.newMemberName = '';
                alpineProxy.newMemberError = '';
                fetchGroupMembers(alpineProxy.selectedGroupId);
                window.dispatchEvent(new Event('load-group-entities'));
            } else {
                console.error('AddGroupMember:', data.message);
            }
        })
        .catch(err => console.error('Server error', err));
    }

    function lookupNewMemberName() {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        if (!alpineProxy.newMemberId) {
            alpineProxy.newMemberName = '';
            alpineProxy.newMemberError = '';
            return;
        }

        fetch(`/case/GetCustomerNameById?customerId=${encodeURIComponent(alpineProxy.newMemberId)}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alpineProxy.newMemberName = data.name;
                    alpineProxy.newMemberError = '';
                } else {
                    alpineProxy.newMemberName = '';
                    alpineProxy.newMemberError = 'Case ID not found';
                }
            })
            .catch(err => {
                alpineProxy.newMemberName = '';
                alpineProxy.newMemberError = 'Error fetching name';
            });
    }

    function removeGroupMember(customerId) {
        const alpineProxy = Alpine.$data(document.querySelector('body'));
        
        const payload = {
            GroupId: alpineProxy.selectedGroupId,
            CustomerId: customerId.toString()
        };

        fetch('/case/RemoveGroupMember', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            alpineProxy.pendingRemoveMemberId = null;
            if (data.success) {
                fetchGroupMembers(alpineProxy.selectedGroupId);
                window.dispatchEvent(new Event('load-group-entities'));
            } else {
                console.error('RemoveGroupMember:', data.message);
            }
        })
        .catch(err => console.error('Server error', err));
    }
    function submitGroupEntity() {
        const alpineData = document.querySelector('body')._x_dataStack[0];
        alpineData.isSubmittingGroup = true;

        const payload = {
            groupName: alpineData.newGroupName,
            customerIds: alpineData.newGroupIds.filter(e => e.id && e.name && e.name !== 'Not Found').map(e => e.id)
        };

        fetch('/case/CreateGroupEntity', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            alpineData.isSubmittingGroup = false;
            if (data.success) {
                // reset form
                alpineData.newGroupName = '';
                alpineData.newGroupIds = [{id: '', name: '', loading: false}];
                alpineData.showCreateGroupForm = false;
                // reload list
                window.dispatchEvent(new Event('load-group-entities'));
                window.dispatchEvent(new CustomEvent('show-success-modal', { detail: { refId: data.groupName, isGroup: true } }));
            } else {
                alert(data.message || 'Error creating group');
            }
        })
        .catch(err => {
            alpineData.isSubmittingGroup = false;
            alert('Server error occurred');
        });
    }
</script>
</body>
</html>
