    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        .flatpickr-wrapper {
            width: 100% !important;
        }

        .flatpickr-alt-input {
            width: 100% !important;
            display: block !important;
        }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
