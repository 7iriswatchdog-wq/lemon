                    document.addEventListener('alpine:init', () => {

                Alpine.store('screening', {
                    selectedMethod: 'manual'   // default selection
                });

            });

                        $(function () {

                initCaseFormValidation("#myForm");
                initCaseFormValidation("#myOCRForm");

            });


            function initCaseFormValidation(formSelector) {

                const $form = $(formSelector);

                $form.off("submit.customValidation")
                    .on("submit.customValidation", function (e) {

                        console.log("Validation running for:", formSelector);

                        // Clear previous errors inside current form ONLY
                        $form.find("span[data-valmsg-for]").text('').removeClass('field-validation-error');
                        $form.find(".is-invalid").removeClass('is-invalid');

                        let isValid = true;
                        let $firstErrorElement = null;

                        // Get values from CURRENT form only
                        const fullName = ($form.find("#fullName").val() || "").trim();
                        const occupation = ($form.find("#ddlOccupation").val() || "").trim();
                        const producttype = ($form.find("#ddlProductType").val() || "").trim();
                        const deliverychannel = ($form.find("#ddlDeliveryChannel").val() || "").trim();
                        const modeofpayment = ($form.find("#ddlModeofpayment").val() || "").trim();
                        const residentStatus = ($form.find("#ddlResidenceStatus").val() || "").trim();

                        function markInvalid(valFor, selector, message) {

                            $form.find(`span[data-valmsg-for='${valFor}']`)
                                .text(message)
                                .addClass('field-validation-error');

                            const $element = $form.find(selector);
                            $element.addClass('is-invalid');

                            if (!$firstErrorElement) $firstErrorElement = $element;

                            isValid = false;
                        }

                        // Required validations
                        if (fullName === "")
                            markInvalid("FirstName", "#fullName", "Full Name is required.");

                        if (!occupation || occupation === "0")
                            markInvalid("OccupatinTypeTxt", "#ddlOccupation", "Occupation Type is required.");

                        if (!producttype || producttype === "0")
                            markInvalid("ProductName", "#ddlProductType", "Product Type is required.");

                        if (!deliverychannel || deliverychannel === "0")
                            markInvalid("DeliveryChannelName", "#ddlDeliveryChannel", "Delivery Channel is required.");

                        if (!modeofpayment || modeofpayment === "0")
                            markInvalid("Modeofpayment", "#ddlModeofpayment", "Mode Of Payment is required.");

                        if (!residentStatus || residentStatus === "0")
                            markInvalid("ResidenceStatus", "#ddlResidenceStatus", "Resident Status is required.");

                        // Emirates validation
                        if (!validateIdNumber($form, true)) {

                            toastr.clear();
                            toastr.error("Emirates ID must start with 784.");

                            isValid = false;
                        }

                        // Scroll to error
                        if (!isValid) {

                            if ($firstErrorElement) {

                                $("html, body").animate({
                                    scrollTop: $firstErrorElement.offset().top - 150
                                }, 400);

                                $firstErrorElement.focus();
                            }

                            e.preventDefault();
                            return false;
                        }

                        // Loader
                        $('#loadingeffect').show();
                        $form.find('#btn-ld').prop('disabled', true);

                        const thresholdValue = $form.find("#threshold").val();

                        $form.off("submit.customValidation");

                        setTimeout(() => {
                            $form.find('#btn-ld').prop('disabled', false);
                            $form.find("#threshold").val(thresholdValue);
                        }, 2000);

                    });
            }
                        function validateIdNumber($form, isSubmit = false) {

                const $idType = $form.find("#ddlIdType");
                const $idNumber = $form.find("#txtIdNumber");

                if (!$idType.length || !$idNumber.length) return true;

                const idType = ($idType.val() || "").trim();
                const idNumber = ($idNumber.val() || "").trim();

                $idNumber.removeClass("is-invalid");
                $form.find("span[data-valmsg-for='CustomerIdNumber']")
                    .text("")
                    .removeClass("field-validation-error");

                if (idType === "Emirates ID" && idNumber !== "") {

                    if (!idNumber.startsWith("784")) {

                        $idNumber.addClass("is-invalid");

                        $form.find("span[data-valmsg-for='CustomerIdNumber']")
                            .text("Emirates ID must start with 784.")
                            .addClass("field-validation-error");

                        return false;
                    }
                }

                return true;
            }


