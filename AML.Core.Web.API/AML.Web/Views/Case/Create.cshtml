                                                                        <!-- Hidden inputs for form submission -->
                                                                        <input type="file" :name="'CaseDocumentsL[' + index + '].Document'" x-ref="hiddenInput" style="display:none">
                                                                    </div>
                                                                </template>
                                                            </div>
                                                            
                                                            <!-- Sync hidden inputs with file objects -->
                                                            <div x-init="$watch('manualDocs', () => {
                                                                $nextTick(() => {
                                                                    const containers = $el.parentElement.querySelectorAll('input[type=file][style*=\'display:none\']');
                                                                    manualDocs.forEach((file, i) => {
                                                                        if (containers[i]) {
                                                                            const dataTransfer = new DataTransfer();
                                                                            dataTransfer.items.add(file);
                                                                            containers[i].files = dataTransfer.files;
                                                                        }
                                                                    });
                                                                });
                                                            })"></div>
                                                        </div>
                                                            <span class="text-[11px] text-primary font-bold border border-blue-600 rounded-md px-3 py-0.5">
