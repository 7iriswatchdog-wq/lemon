                        function clearOCRForm() {
                const form = document.querySelector("#myOCRForm");
                if (!form) return;

                // --- Reset native form ---
                form.reset();

                // --- Identify screening elements ---
                const optionsContainer = form.querySelector("#options-container-OCR");
                const allCheckbox = form.querySelector("#corporate-all-OCR");

                // --- Force clear ALL inputs manually, excluding screening options ---
                form.querySelectorAll("input, select, textarea").forEach(el => {

                    // Skip OCR screening checkboxes
                    if (
                        el === allCheckbox ||                   // "ALL" checkbox
                        (optionsContainer && optionsContainer.contains(el)) // dropdown checkboxes
                    ) {
                        return; // do not clear
                    }

                    // if (el.type === "checkbox" || el.type === "radio") {
                    //     el.checked = false; // Only clears non-screening checkboxes
                    // }
                    else if (el.type === "file") {
                        el.value = "";
                    }
                    else {
                        el.value = "";
                    }
                });

                // --- Clear validation messages (optional) ---
                form.querySelectorAll("span[data-valmsg-for]").forEach(span => {
                    span.textContent = "";
                    span.classList.remove("field-validation-error");
                });

                // --- Remove invalid styling ---
                form.querySelectorAll(".is-invalid").forEach(el => {
                    el.classList.remove("is-invalid");
                });

                // --- Reset threshold slider (Alpine bound) ---
                const threshold = form.querySelector("#threshold");
                if (threshold) threshold.value = 70;
            }



