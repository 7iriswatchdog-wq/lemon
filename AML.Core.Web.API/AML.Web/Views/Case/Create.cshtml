/* ═══════════════════════════════════════════════
   PREMIUM CASE CREATION STYLES
   ═══════════════════════════════════════════════ */

/* Page header bar */
.cc-header {
    height: 56px;
    background: #ffffff;
    border-bottom: 1px solid #e8ecf1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    position: sticky;
    top: 0;
    z-index: 40;
    flex-shrink: 0;
}
.cc-header h2 {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.01em;
}
.cc-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 50%, transparent 100%);
    opacity: 0.6;
}

/* Left sidebar panel */
.cc-sidebar {
    background: #ffffff;
    border: 1px solid #e8ecf1;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 1px 2px rgba(0,0,0,.02);
}
.cc-sidebar h1 {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}
.cc-sidebar .cc-subtitle {
    font-size: 12.5px;
    color: #64748b;
    margin-top: 2px;
}
.cc-sidebar .cc-method-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    margin-bottom: 8px;
}

/* Method cards */
.cc-method-card {
    border-radius: 12px;
    border: 1.5px solid #e8ecf1;
    padding: 14px 16px;
    height: auto;
    min-height: 72px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    background: #fff;
}
.cc-method-card:hover {
    border-color: #bfdbfe;
    background: #f8faff;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(59,130,246,.08);
}
.cc-method-card.active {
    border-color: #2563eb;
    background: linear-gradient(135deg, #eff6ff 0%, #f0f4ff 100%);
    box-shadow: 0 0 0 3px rgba(37,99,235,.08), 0 2px 8px rgba(37,99,235,.1);
}
.cc-method-card .cc-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
}
.cc-method-card .cc-icon.default {
    background: #f1f5f9;
    color: #64748b;
}
.cc-method-card:hover .cc-icon.default {
    background: #eff6ff;
    color: #3b82f6;
}
.cc-method-card.active .cc-icon {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #fff;
    box-shadow: 0 2px 6px rgba(37,99,235,.3);
}
.cc-method-card h3 {
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.01em;
}
.cc-method-card p {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 1px;
    line-height: 1.4;
}
.cc-method-card .cc-check {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #2563eb;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Right content panel */
.cc-content-panel {
    background: #ffffff;
    border: 1px solid #e8ecf1;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(0,0,0,.04);
}
.cc-content-panel h2 {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
}
.cc-content-panel .cc-panel-desc {
    font-size: 13px;
    color: #64748b;
    margin-top: 2px;
}

/* Info banner */
.cc-info-banner {
    background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
    border: 1px solid #fde68a;
    border-radius: 10px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #92400e;
    font-weight: 500;
}
.cc-info-banner svg, .cc-info-banner i {
    color: #f59e0b;
    flex-shrink: 0;
}

/* Form styling */
.cc-form-group {
    margin-bottom: 16px;
}
.cc-form-group label, .cc-label {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    margin-bottom: 6px;
    display: block;
    letter-spacing: 0.01em;
}
.cc-form-group label .required, .cc-label .required {
    color: #ef4444;
    margin-left: 2px;
}
.cc-input, .cc-select {
    height: 42px;
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 13px;
    color: #1e293b;
    background: #f8fafc;
    transition: all 0.2s;
    outline: none;
}
.cc-input:focus, .cc-select:focus {
    border-color: #3b82f6;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59,130,246,.08);
}
.cc-input::placeholder {
    color: #94a3b8;
}

/* Section divider */
.cc-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
    margin: 24px 0;
}

/* Primary action button */
.cc-btn-primary {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    height: 42px;
    padding: 0 24px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 1px 3px rgba(37,99,235,.2);
}
.cc-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(37,99,235,.3);
}

/* Global form overrides for the content panel */
.cc-content-panel input[type="text"],
.cc-content-panel input[type="email"],
.cc-content-panel input[type="number"],
.cc-content-panel input[type="date"],
.cc-content-panel select,
.cc-content-panel .trigger-btn {
    border-radius: 10px !important;
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
    font-size: 13px !important;
    transition: all 0.2s !important;
}
.cc-content-panel input[type="text"]:focus,
.cc-content-panel input[type="email"]:focus,
.cc-content-panel input[type="number"]:focus,
.cc-content-panel select:focus {
    border-color: #3b82f6 !important;
    background: #fff !important;
    box-shadow: 0 0 0 3px rgba(59,130,246,.08) !important;
}
.cc-content-panel label {
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #475569 !important;
}

    </style>
    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        .flatpickr-wrapper {
            width: 100% !important;
        }

        .flatpickr-alt-input {
            width: 100% !important;
            display: block !important;
        }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }</style>
</head>

