                                                // Match ISO3 against value directly, or against embedded ISO3 in text
                                                if (optVal === nationalityCode || optText === nationalityCode) {
                                                    natSelect.value = opt.value;
                                                    matched = true;
                                                    break;
                                                }
                                            }

                                            if (!matched) {
                                                // Fallback: partial text match (e.g., "IND" inside "INDIA")
                                                for (let opt of natSelect.options) {
