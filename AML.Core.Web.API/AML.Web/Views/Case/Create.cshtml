@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Newtonsoft.Json;
@{
	ViewData["Title"] = @localizer["Customer Screening"];
	Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";

}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
	var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
	var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
	var userModules = HttpContextAccessor.HttpContext.Session.GetString("SessModules");
	 var allowedModules = new List<int>();
    if (!string.IsNullOrEmpty(userModules))
    {
        var modules = JsonConvert.DeserializeObject<List<dynamic>>(userModules);
        allowedModules = modules.Select(m => (int)m.Menu_Id).ToList();
    }
    var codesList = Model.CodesTable
        .Select(x => new
        {
            value = x.Value,
            text = x.Text
        }).ToList();

    var codesJson = JsonConvert.SerializeObject(codesList);
}
@model AML.ViewModel.ViewModels.CustomerCase.CaseModel



<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Individual Case Creation - WatchDog</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        [x-cloak] {
            display: none !important;
        }

        .scrollbar-thin::-webkit-scrollbar {
            width: 5px;
        }

        .scrollbar-thin::-webkit-scrollbar-track {
            background: transparent;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .validstyle{
            color:red;
            font-size:small;
        }

    </style>
    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }</style>
</head>

<body class="bg-[#f8fafc] text-slate-900 overflow-hidden" x-data="{
