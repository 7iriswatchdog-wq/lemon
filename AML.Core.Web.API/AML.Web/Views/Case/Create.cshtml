                                                    ? 'Individual Related Parties'
                                                    : form.type === 'related_corporate_shareholder'
                                                    ? 'Corporate Related Parties'
                                                    : form.type === 'signatories'
                                                    ? 'Authorized Signatory'
                                                    : 'Senior Management';

