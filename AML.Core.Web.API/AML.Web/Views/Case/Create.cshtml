                                                                <template x-for="(file, index) in manualDocs" :key="file.name + file.size">
                                                                    <div class="flex items-center justify-between p-2.5 bg-appbg border border-bordercolor rounded-xl group hover:border-blue-200 hover:bg-surface transition-all">
                                                                        <div class="flex items-center gap-3 min-w-0">
