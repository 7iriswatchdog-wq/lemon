                                // Add a new form
                                addForm() {
                                    if (this.forms.length >= this.maxForms) {
                                        toastr.error("Only 5 forms allowed");
                                        return;
                                    }
                                    this.forms.push({ type: this.activeShareholderTab });
                                    this.$nextTick(() => {
                                                                initAllDatePickers(); // 🔥 reinitialize new inputs
                                    });
                                },

                                // Remove a form
                                removeForm(index) {
                                    this.forms.splice(index, 1);
                                },

                                // Update all forms type when tab changes
                                updateFormsType(newType) {
                                    this.activeShareholderTab = newType;
                                    this.forms.forEach(f => f.type = newType); // update all existing forms
                                },

                                // Submit forms to the server
                                async submitForms() {
                                    const payload = [];
                                    const formData = new FormData();
                                    const CompanyCode = $('#CompanyCodeInput').val() || "";
                                    const CompanyName = $('#CompanyNameHidden').val() || "";
                                    const Thershold = parseInt($('#Thershold').val() || 0);

                                    // Prepare payload only from filled forms
                                                           this.forms.forEach((form,index) => {

                            if (!form.name || form.name.trim() === "") return;

                                        const typeValue = form.type === 'shareholder'
                                        ? 'Individual_Ind'
                                        : form.type === 'corporate_shareholder'
                                        ? 'Individual_Corp'
                                        : form.type === 'related_shareholder'
                                        ? 'Individual_Ind'
                                        : form.type === 'related_corporate_shareholder'
                                        ? 'Individual_Corp'
                                        : form.type === 'signatories'
                                        ? 'Individual_Ind'
                                        : 'Individual_Ind';

                                                    const flagType = form.type === 'shareholder'
                                                    ? 'Individual Sharholder'
                                                    : form.type === 'corporate_shareholder'
                                                    ? 'Corporate Shareholder'
                                                    : form.type === 'related_shareholder'
                                                    ? 'Individual Related Parties'
                                                    : form.type === 'related_corporate_shareholder'
                                                    ? 'Corporate Related Parties'
                                                    : form.type === 'signatories'
                                                    ? 'Authorized Signatory'
                                                    : 'Senior Management';

                            const obj = {
                                Name: form.name,
                                Share: parseInt(form.share || 0),
                                Designation: form.designation || "",
                                Nationality: form.nationality || "",
                                Residence: form.residence || "",
                                TradeLicence: form.tradeLicence || "",
                                RegistrationDate: form.registrationDate || "",
                                IdType: form.idType || "",
                                IdNumber: form.idNumber || "",
                                IssueDate: form.issueDate || "",
                                IdExpiry: form.idExpiry || "",
                                Cif: form.cif || "",
                                Type: typeValue,
                                CompanyCode: CompanyCode,
                                CompanyName: CompanyName,
                                Thershold: Thershold,
                                Employer: form.employername || "",
                                GoldenVisa: form.goldenvisa || "",
                                EmployerIndustry:form.employerindustry || "",
                                EmployerSector:form.employersector || "",
                                SOWSOFCountry:form.sowsofcountry || "",
                                TradeLicenseAuthority:form.tradeLicenceAuthority || "",
                                TradeLicenseSector:form.tradeLicenceSector  || "",
                                Gender:form.gender || "",
                                Relationship:form.relationship || "",
                                FlagType:flagType,
                                CustType:"I",
                                ClientID: 0,
                                UserId: 0,

                            };

                            payload.push(obj);

                            if (form.document) {
                                formData.append("Documents", form.document);
                            }
                        });

                        // THIS LINE WAS MISSING
                        formData.append("data", JSON.stringify(payload));



                                    if (payload.length === 0) {
                                        toastr.warning("No shareholder details to save");
                                        return;
                                    }

                                    try {
                                        // Send payload to server
                                    const res = await fetch('/Corporate/SaveShareholders', {
                                    method: 'POST',
                                    body: formData
                                });

                                        if (!res.ok) throw new Error("Save failed");

                                        toastr.success("Saved Successfully");

                                        // Refresh pending shareholders via event
                                        //window.dispatchEvent(new Event('load-pending-shareholders'));
                                                    window.dispatchEvent(new CustomEvent('load-pending-shareholders', {
                                                    detail: { skipModal: true }
                                                }));

                                        // Optionally, clear forms after submit
                                                               this.forms.forEach((form, index) => {
                                                // reset fields
                                                for (let key in form) {
                                                    if (key !== 'type') form[key] = null;
                                                }

                                                // reset displayed file name
                                                form.fileName = 'No file chosen';

                                                // reset file input
                                                const fileInput = this.$refs['docUpload_' + index];
                                                if (fileInput) fileInput.value = '';
                                            });

                                            // Reset forms array
                                            this.forms = [{ type: this.activeShareholderTab }];

                                    } catch (err) {
                                        console.error("Error saving shareholders:", err);
                                        toastr.error("Failed to save shareholders");
                                    }
                                }
                            };
                        }

                                      function shareholderTree() {

                                return {

                                    items: [],

                                    syncFromStore() {

                                        this.items = JSON.parse(
                                            JSON.stringify(Alpine.store('screeningStore').screeningList || [])
                                        );
                                    },

                                    init() {

                                        this.syncFromStore();

                                        this.$nextTick(() => {
                                            this.initSortable();
                                        });

                                        window.addEventListener('store-updated', () => {
                                            this.syncFromStore();
                                        });
                                    },


                                    // ⭐ Numbering + Tree Build
                                    flattenedItems() {

                                        let list = this.items || [];

                                        function build(parentId = null, prefix = "", depth = 0) {

                                            let children = list.filter(x => x.parentId === parentId);

                                            return children.flatMap((item, index) => {

                                                let number = prefix
                                                    ? `${prefix}.${index + 1}`
                                                    : `${index + 1}`;

                                                return [
                                                    { ...item, depth, displayId: number },
                                                    ...build(item.id, number, depth + 1)
                                                ];
                                            });
                                        }

                                        return build();
                                    },


                                    // ⭐ Drag Logic
                                    initSortable() {

                                        let self = this;
                                        let container = document.getElementById("shareholderTreeContainer");

                                        if (!container) return;

                                        new Sortable(container, {

                                            animation: 150,
                                            handle: ".drag-handle",

                                                        onEnd(evt) {

                                    if (!evt.item || !evt.item.dataset.id) return;

                                    let movedId = Number(evt.item.dataset.id);
                                    let prev = evt.item.previousElementSibling;

                                    let newParentId = null;
                                    let parentType = null;

                                    if (prev && prev.dataset.id) {

                                        let prevId = Number(prev.dataset.id);
                                        let prevItem = self.items.find(x => x.id === prevId);

                                        if (prevItem) {

                                            if (prevItem.type === "Individual_Corp") {

                                                newParentId = prevItem.id;
                                                parentType = prevItem.type;

                                            } else {

                                                newParentId = prevItem.parentId ?? null;

                                                let parent = self.items.find(x => x.id === newParentId);
                                                parentType = parent ? parent.type : null;
                                            }
                                        }
                                    }

                                    let store = Alpine.store('screeningStore');
                                    let moved = store.screeningList.find(x => x.id === movedId);

                                    if (!moved) return;

                                    // update parent
                                    moved.parentId = newParentId;

                                    // ⭐ CHANGE FORM TYPE IF UNDER CORPORATE
                                    if (parentType === "Individual_Corp") {

    // If dropped under corporate, convert Individual to Corporate child
                            if (moved.type === "Individual_Ind") {
                                moved.type = "Individual_Corp_Ind";
                            }

                        } else {

                            // If moved outside corporate, convert back only if it was corporate child
                            if (moved.type === "Individual_Corp_Ind") {
                                moved.type = "Individual_Ind";
                            }

                        }
                                    store.screeningList = [...store.screeningList];

                                        window.dispatchEvent(new Event('store-updated'));
                                    }

                                            // onEnd(evt) {

