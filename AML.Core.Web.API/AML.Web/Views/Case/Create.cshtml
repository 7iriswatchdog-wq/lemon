                        function initDatePicker(selector, defaultDate, options = {}) {

                const elements = document.querySelectorAll(selector);

                elements.forEach(el => {

                    // ✅ prevent duplicate initialization
                    if (el._flatpickr) return;

                    flatpickr(el, {
                        dateFormat: "Y-m-d",
                        altInput: true,
                        altFormat: "d/m/Y",
                        altInputClass: "block w-full h-11 bg-surface border border-bordercolor rounded-xl px-4 text-sm font-medium",
                        allowInput: true,
                        defaultDate: defaultDate,
                        ...options,

                        // ✅ Attach events AFTER input is created
                        onReady: function (selectedDates, dateStr, instance) {

                            const input = instance.altInput;

                            // Restrict keys
                            input.addEventListener("keydown", function (e) {
                                const allowedKeys = ["Backspace", "Delete", "ArrowLeft", "ArrowRight", "Tab"];

                                if (
                                    allowedKeys.includes(e.key) ||
                                    (e.key >= "0" && e.key <= "9")
                                ) return;

                                e.preventDefault();
                            });

                            // Auto format
                            input.addEventListener("input", function () {
                                let value = input.value.replace(/\D/g, '');

                                if (value.length > 8) value = value.substring(0, 8);

                                let formatted = '';
                                if (value.length > 0) formatted += value.substring(0, 2);
                                if (value.length >= 3) formatted += '/' + value.substring(2, 4);
                                if (value.length >= 5) formatted += '/' + value.substring(4, 8);

                                input.value = formatted;
                            });
                        },

                        // ✅ Sync with Alpine (IMPORTANT)
                        onChange: function (selectedDates, dateStr, instance) {
                            if (el._x_model) {
                                el._x_model.set(dateStr);
                            }
                        },

                        // ✅ Final validation
                        onClose: function (selectedDates, dateStr, instance) {

                            if (selectedDates.length > 0) return;

                            let val = instance.altInput.value;
                            if (!val) return;

                            let regex = /^\d{2}\/\d{2}\/\d{4}$/;

                            if (!regex.test(val)) {
                                instance.clear();
                                return;
                            }

                            let parts = val.split('/');
                            let dd = parseInt(parts[0], 10);
                            let mm = parseInt(parts[1], 10);
                            let yyyy = parseInt(parts[2], 10);

                            let date = new Date(yyyy, mm - 1, dd);

                            if (
                                date.getFullYear() !== yyyy ||
                                date.getMonth() !== mm - 1 ||
                                date.getDate() !== dd
                            ) {
                                instance.clear();
                                return;
                            }

                            instance.setDate(`${yyyy}-${parts[1]}-${parts[0]}`, true);
                        }
                    });

                });
            }

