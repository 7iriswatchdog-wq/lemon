@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Newtonsoft.Json;
@{
	ViewData["Title"] = @localizer["Customer Screening"];
	Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";

}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
	var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
	var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
	var userModules = HttpContextAccessor.HttpContext.Session.GetString("SessModules");
	 var allowedModules = new List<int>();
    if (!string.IsNullOrEmpty(userModules))
    {
        var modules = JsonConvert.DeserializeObject<List<dynamic>>(userModules);
        allowedModules = modules.Select(m => (int)m.Menu_Id).ToList();
    }
    var codesList = Model.CodesTable
        .Select(x => new
        {
            value = x.Value,
            text = x.Text
        }).ToList();

    var codesJson = JsonConvert.SerializeObject(codesList);
}
@model AML.ViewModel.ViewModels.CustomerCase.CaseModel



<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
