                                                                    <div x-data="{ 
                                                        manualDocs: [],
                                                        addFiles(files) {
                                                            Array.from(files).forEach(file => {
                                                                if (!this.manualDocs.some(f => f.name === file.name && f.size === file.size)) {
                                                                    this.manualDocs.push(file);
                                                                }
                                                            });
                                                        },
                                                        removeFile(index) {
                                                            this.manualDocs = this.manualDocs.filter((_, i) => i !== index);
                                                        }
                                                    }" class="space-y-3">
