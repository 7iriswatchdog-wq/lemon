                        function setDateInput(form, inputId, dateValue) {
                const input = form.querySelector(`#${inputId}`);
                if (!input) return;

                if (!dateValue) {
                    if (input._flatpickr) input._flatpickr.clear();
                    else input.value = "";
                    return;
                }

                console.log(`Setting date for ${inputId}:`, dateValue);

                // If flatpickr is attached, use its API so the visible altInput updates
                if (input._flatpickr) {
                    input._flatpickr.setDate(dateValue, true, "Y-m-d");
                    console.log(`Successfully set ${inputId} via flatpickr to`, dateValue);
                    return;
                }

                // Fallback for plain inputs
                let parsedDate = new Date(dateValue);
                if (!isNaN(parsedDate.getTime())) {
                    const year = parsedDate.getFullYear();
                    const month = String(parsedDate.getMonth() + 1).padStart(2, "0");
                    const day = String(parsedDate.getDate()).padStart(2, "0");
                    input.value = `${year}-${month}-${day}`;
                    console.log(`Successfully set ${inputId} to ${input.value}`);
                } else {
                    input.value = "";
                    console.warn(`Invalid date format for ${inputId}:`, dateValue);
                }
            }

            // Directly look up the flatpickr instance by selector and call setDate
            function setFlatpickrDateFromForm(form, selector, dateValue) {
                    const el = form.querySelector(selector);
                    if (!el) return;

                    if (!dateValue) {
                        if (el._flatpickr) el._flatpickr.clear();
                        return;
                    }

                    const formattedDate = normalizeDate(dateValue);

                    if (el._flatpickr) {
                        el._flatpickr.setDate(formattedDate, true);
                    } else {
                        el.value = formattedDate; // fallback
                    }
                }
function normalizeDate(dateStr) {
    if (!dateStr) return null;

    if (dateStr.includes('-')) return dateStr;

    if (dateStr.includes('/')) {
        let [dd, mm, yyyy] = dateStr.split('/');
        return `${yyyy}-${mm}-${dd}`;
    }

    return dateStr;
}
