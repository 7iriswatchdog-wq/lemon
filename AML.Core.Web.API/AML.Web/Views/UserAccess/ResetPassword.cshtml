<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lemon - Reset Password </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen">
    <div class="flex min-h-screen">
        <!-- Left Section -->
        <div class="hidden lg:flex lg:w-1/2 bg-[#2563EB] flex-col items-center justify-between p-8">
            <!-- Logo -->
            <div class="w-full">
                <div class="flex items-center text-white">
                    <img src="~/img/logo.svg" alt="WatchDog Logo" class="h-7" />

                </div>
            </div>

            <!-- Center Content -->
            <div class="text-center text-white">
                <img src="~/img/image1.svg" alt="Reset Password Illustration" style=" max-height: 448px; width: auto; height: auto;" class=" mx-auto mb-8" />
                <h2 class="text-2xl font-bold mb-4">Customizable Multipurpose Dashboard</h2>
                <p class="text-sm text-white/80">Everything you need in an easily customizable dashboard.</p>
            </div>

            <!-- Dots -->
            <div class="flex gap-2 justify-center w-full">
                <!-- <div class="w-2 h-2 rounded-full bg-white"></div>
                <div class="w-2 h-2 rounded-full bg-white/50"></div>
                <div class="w-2 h-2 rounded-full bg-white/50"></div> -->
            </div>
        </div>

        <!-- Right Section -->
        <div class="w-full lg:w-1/2 flex flex-col justify-between p-8 lg:p-12">
            <div></div>
            <div class="max-w-md mx-auto w-full">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Reset your password</h1>
                <p class="text-[#64748B] text-sm mb-8 max-w-sm font-light">
                    Please enter a new password for your account .
                </p>


                <form asp-controller="UserAccess" asp-action="ResetPassword" class="space-y-4" enctype="multipart/form-data" method="post">
                    <div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <input type="password"
                                   class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" id="new" asp-for="NewPassword" placeholder="New password" />
                        </div>
                    </div>

                    <div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <input type="password"
                                   asp-for="RepeatPassword" placeholder="Repeat password" id="repeat"
                                   class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                        </div>
                    </div>
                    @* <br /> *@
                    <span asp-validation-for="NewPassword" class="text-red-500 py-2"></span>
                    <br />
                    <span asp-validation-for="RepeatPassword" class="text-red-500 py-2"></span>
                    <button type="submit"
                            class="w-full bg-[#2563EB] text-white py-2 px-4 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Submit
                    </button>
                </form>

                <div class="mt-4 text-center">
                    <a href="/auth/login" class="text-[#2563EB] hover:underline">Back to Login</a>
                </div>

                @* @if (!string.IsNullOrEmpty(Convert.ToString(ViewData["Error"])))
                {
                    <label class="text-danger">Invalid Username!</label>
                }
                else if (!string.IsNullOrEmpty(Convert.ToString(ViewData["Success"])))
                {
                    <label class="text-success">@Convert.ToString(ViewData["Success"])</label>
                } *@
            </div>

            <!-- Footer -->
            <div class="text-center text-sm text-gray-600 mt-8">
                Please contact
                <a href="mailto:Support@nationalcompliance.ae" class="text-[#2563EB] underline">
                    support@nationalcompliance.ae
                </a>
                or your<br />Account Manager in case of support.
            </div>
        </div>
    </div>
</body>
</html>
<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>


