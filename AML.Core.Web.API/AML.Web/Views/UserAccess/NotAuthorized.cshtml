@{
    ViewData["Title"] = "Not Authorized";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<div class="w-full h-full p-6 flex items-center justify-center min-h-[60vh]">
    <div class="bg-white rounded-lg border border-red-200 shadow-sm p-8 max-w-lg w-full text-center">
        <!-- Icon -->
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-6">
            <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        </div>

        <!-- Content -->
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Access Denied</h2>
        <p class="text-gray-500 mb-8">
            You do not have the required permissions to access this page or perform this action. Please contact your system administrator if you believe this is an error.
        </p>

        <!-- Actions -->
        <div class="flex justify-center space-x-4">
            <button onclick="window.history.back()" class="px-6 py-[10px] bg-white border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-200">
                Go Back
            </button>
            <a href="/Home/Index" class="px-6 py-[10px] bg-[#2563EB] border border-transparent text-white font-medium rounded-lg hover:bg-[#1D4ED8] transition-colors focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2">
                Return to Dashboard
            </a>
        </div>
    </div>
</div>