@{
    ViewData["Title"] = "Forgot";
    Layout = null;
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var clientId = HttpContextAccessor.HttpContext.Session.GetString("SessClientId");
    var logo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.User.UserModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>searchin — Reset Password</title>
    <meta name="description" content="Reset your password for searchin — AML compliance screening, risk scoring, and reporting platform.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ── Reset ───────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background: #f8fafc;
            overflow-x: hidden;
        }

        /* ── Layout ──────────────────────────────────────── */
        .login-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ══════════════════════════════════════════════════
           LEFT PANEL (Shared with Login)
           ══════════════════════════════════════════════════ */
        .left-panel {
            position: relative;
            width: 50%;
            background: linear-gradient(160deg, #0a0f1e 0%, #0f2038 40%, #0c3558 80%, #0a1628 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 44px 48px;
            overflow: hidden;
        }

        #particleCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .left-panel .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }
        .glow-1 { width: 400px; height: 400px; top: -5%; right: -10%; background: rgba(56, 189, 248, 0.08); }
        .glow-2 { width: 300px; height: 300px; bottom: 10%; left: -5%; background: rgba(99, 102, 241, 0.07); }
        .glow-3 { width: 250px; height: 250px; top: 40%; right: 20%; background: rgba(14, 165, 233, 0.05); }

        .left-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .brand-name {
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #38bdf8, #6366f1);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.25);
            display: none; /* Hidden for searchin rebrand layout */
        }
        .brand-icon svg { width: 18px; height: 18px; color: white; display: none; }

        .hero-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            animation: fadeSlideUp 0.8s 0.15s ease-out both;
        }
        .hero-title {
            font-size: 46px;
            font-weight: 900;
            line-height: 1.05;
            color: #ffffff;
            letter-spacing: -2px;
            margin-bottom: 16px;
        }
        .hero-title .accent {
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #a78bfa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-subtitle {
            font-size: 15px;
            font-weight: 400;
            color: rgba(203, 213, 225, 0.7);
            line-height: 1.65;
            max-width: 360px;
        }

        .features {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: auto;
            padding-top: 28px;
            animation: fadeSlideUp 0.8s 0.45s ease-out both;
        }
        .feature-badge {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 100px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            color: rgba(226, 232, 240, 0.85);
            font-size: 12.5px;
            font-weight: 500;
        }
        .feature-badge svg { width: 15px; height: 15px; color: #38bdf8; }

        /* ══════════════════════════════════════════════════
           RIGHT PANEL
           ══════════════════════════════════════════════════ */
        .right-panel {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #ffffff;
            position: relative;
            overflow: hidden;
        }

        .right-panel .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.4;
        }
        .glow-right-1 { width: 300px; height: 300px; top: -10%; right: -5%; background: rgba(56, 189, 248, 0.08); }
        .glow-right-2 { width: 250px; height: 250px; bottom: -5%; left: 0%; background: rgba(99, 102, 241, 0.05); }

        .form-container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
            animation: fadeSlideUp 0.6s ease-out both;
        }

        .form-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 24px;
            padding: 48px 40px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
        }

        .form-header { margin-bottom: 32px; }
        .form-title {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }
        .form-subtitle {
            font-size: 14px;
            color: #64748b;
            line-height: 1.5;
        }

        .form-group { position: relative; margin-bottom: 22px; }
        .input-wrapper { position: relative; }
        
        .form-input {
            width: 100%;
            padding: 16px 14px 8px 44px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: #1e293b;
            background: #ffffff;
            transition: all 0.25s ease;
            outline: none;
        }
        .form-input::placeholder { color: transparent; }
        .form-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
        }
        .form-input.error {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
        }

        .floating-label {
            position: absolute;
            left: 44px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: #94a3b8;
            pointer-events: none;
            transition: all 0.2s ease;
            padding: 0 4px;
        }
        .form-input:focus ~ .floating-label,
        .form-input:not(:placeholder-shown) ~ .floating-label {
            top: 2px;
            left: 38px;
            font-size: 10.5px;
            font-weight: 600;
            color: #3b82f6;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }
        .input-icon svg { width: 17px; height: 17px; }

        .submit-btn {
            width: 100%;
            padding: 13px 24px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            color: #ffffff;
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%);
            cursor: pointer;
            transition: all 0.35s ease;
            margin-top: 10px;
        }
        .submit-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 30px -5px rgba(37, 99, 235, 0.4);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 24px;
            font-size: 14px;
            font-weight: 500;
            color: #3b82f6;
            text-decoration: none;
        }
        .back-link:hover { color: #1d4ed8; text-decoration: underline; }

        .trust-footer {
            margin-top: 32px;
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
        }

        .field-error {
            display: none;
            font-size: 11.5px;
            color: #ef4444;
            margin-top: 5px;
            padding-left: 4px;
        }
        .field-error.visible { display: block; }

        .shake-it { animation: shake 0.4s ease-out; }
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-5px); }
            40% { transform: translateX(5px); }
            60% { transform: translateX(-3px); }
            80% { transform: translateX(3px); }
        }
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 960px) {
            .left-panel { display: none; }
            .right-panel { width: 100%; background: #f8fafc; }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- ══ LEFT PANEL ══ -->
        <div class="left-panel" aria-hidden="true">
            <canvas id="particleCanvas"></canvas>
            <div class="glow glow-1"></div>
            <div class="glow glow-2"></div>
            <div class="glow glow-3"></div>

            <div class="left-content">
                <div class="brand-name">
                    <div style="color: white; height: 34px; display: flex; align-items: center; transform: scale(0.85); transform-origin: left center;">
                        @await Html.PartialAsync("AdminLTE/_searchinLogo")
                    </div>
                </div>

                <div class="hero-section">
                    <h1 class="hero-title">
                        Reset.<br>
                        <span class="accent">Restore.</span>
                    </h1>
                    <p class="hero-subtitle">
                        Forgot your credentials? No problem. Follow the secure automated process to regain access to your AML compliance workspace.
                    </p>
                </div>

                <div class="features">
                    <div class="feature-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Secure Reset
                    </div>
                </div>
            </div>
        </div>

        <!-- ══ RIGHT PANEL ══ -->
        <div class="right-panel">
            <div class="glow glow-right-1"></div>
            <div class="glow glow-right-2"></div>

            <div class="form-container">
                <div class="form-card">
                    <div class="form-header">
                        <h2 class="form-title">Forgot Password?</h2>
                        <p class="form-subtitle">Enter your company and username to receive a secure recovery link.</p>
                    </div>

                    <form asp-controller="UserAccess" asp-action="Forgot" method="post" id="forgotForm" novalidate>
                        <div class="form-group anim-1">
                            <div class="input-wrapper">
                                <input type="text" class="form-input" id="ClientName" asp-for="ClientName" placeholder=" " required>
                                <label class="floating-label" for="ClientName">Company</label>
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                </span>
                            </div>
                            <div class="field-error" id="error-company">Company name is required</div>
                        </div>

                        <div class="form-group anim-2">
                            <div class="input-wrapper">
                                <input type="text" class="form-input" id="UserName" asp-for="UserName" placeholder=" " required>
                                <label class="floating-label" for="UserName">Username</label>
                                <span class="input-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </span>
                            </div>
                            <div class="field-error" id="error-username">Username is required</div>
                        </div>

                        <button type="submit" class="submit-btn" id="requestReset">
                            Request Recovery Link
                        </button>
                    </form>

                    <a href="/auth/login" class="back-link">Back to Sign In</a>
                </div>

                <div class="trust-footer">
                    <p>Protected by searchin Security</p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script>
        (function() {
            'use strict';

            // ── Particle Network (Simplified for consistency) ──
            const canvas = document.getElementById('particleCanvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let particles = [];
                const PARTICLE_COUNT = 50;
                function resize() {
                    canvas.width = canvas.parentElement.offsetWidth;
                    canvas.height = canvas.parentElement.offsetHeight;
                }
                resize();
                window.addEventListener('resize', resize);

                class Particle {
                    constructor() { this.reset(); }
                    reset() {
                        this.x = Math.random() * canvas.width;
                        this.y = Math.random() * canvas.height;
                        this.vx = (Math.random() - 0.5) * 0.3;
                        this.vy = (Math.random() - 0.5) * 0.3;
                        this.alpha = Math.random() * 0.3 + 0.1;
                    }
                    update() {
                        this.x += this.vx; this.y += this.vy;
                        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
                        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
                    }
                    draw() {
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, 1.2, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(56, 189, 248, ${this.alpha})`;
                        ctx.fill();
                    }
                }
                for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());
                function animate() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    particles.forEach(p => { p.update(); p.draw(); });
                    requestAnimationFrame(animate);
                }
                animate();
            }

            // ── Validation Logic ──
            function validateField(id, errorId) {
                const el = document.getElementById(id);
                const err = document.getElementById(errorId);
                if (!el.value.trim()) {
                    el.classList.add('error');
                    err.classList.add('visible');
                    return false;
                }
                el.classList.remove('error');
                err.classList.remove('visible');
                return true;
            }

            $('#requestReset').on('click', function(e) {
                e.preventDefault();
                const v1 = validateField('ClientName', 'error-company');
                const v2 = validateField('UserName', 'error-username');
                if (!v1 || !v2) {
                    $('#forgotForm').addClass('shake-it');
                    setTimeout(() => $('#forgotForm').removeClass('shake-it'), 400);
                    return;
                }
                $(this).text('Sending...').css('opacity', '0.7');
                $('#forgotForm').submit();
            });
        })();
    </script>
</body>
</html>
