@{
    ViewData["Title"] = "Forgot";
    Layout = null;
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var clientId = HttpContextAccessor.HttpContext.Session.GetString("SessClientId");
    var logo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.User.UserModel


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lemon - Reset Password </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen">
    <div class="flex min-h-screen">
        <!-- Left Section -->
        <div class="hidden lg:flex lg:w-1/2 bg-[#2563EB] flex-col items-center justify-between p-8">
            <!-- Logo -->
            <div class="w-full">
                <div class="flex items-center text-white">
                    <img src="~/img/logo.svg" alt="WatchDog Logo" class="h-7" />

                </div>
            </div>

            <!-- Center Content -->
            <div class="text-center text-white">
                <img src="~/img/image1.svg" alt="Reset Password Illustration" style=" max-height: 448px; width: auto; height: auto;" class=" mx-auto mb-8" />
                <h2 class="text-2xl font-bold mb-4">Customizable Multipurpose Dashboard</h2>
                <p class="text-sm text-white/80">Everything you need in an easily customizable dashboard.</p>
            </div>

            <!-- Dots -->
            <div class="flex gap-2 justify-center w-full">
                <!-- <div class="w-2 h-2 rounded-full bg-white"></div>
                <div class="w-2 h-2 rounded-full bg-white/50"></div>
                <div class="w-2 h-2 rounded-full bg-white/50"></div> -->
            </div>
        </div>

        <!-- Right Section -->
        <div class="w-full lg:w-1/2 flex flex-col justify-between p-8 lg:p-12">
            <div></div>
            <div class="max-w-md mx-auto w-full">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Reset your password</h1>
                <p class="text-[#64748B] text-sm mb-8 max-w-sm font-light">
                    Enter the email address associated with your account and we will send you a link to reset your password.
                </p>

                <form asp-controller="UserAccess" asp-action="Forgot" class="space-y-4" enctype="multipart/form-data" method="post">
                    <div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 24 24" fill="none">
                                    <path d="M19 21V19C19 17.9391 18.5786 16.9217 17.8284 16.1716C17.0783 15.4214 16.0609 15 15 15H9C7.93913 15 6.92172 15.4214 6.17157 16.1716C5.42143 16.9217 5 17.9391 5 19V21" stroke="currentColor" stroke-width="2" />
                                    <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="2" />
                                </svg>
                            </div>
                            <input type="text"
                                   placeholder="Company Name"
                                   class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" id="Clientname" asp-for="ClientName" />
                        </div>
                    </div>

                    <div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 24 24" fill="none">
                                    <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" />
                                    <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="2" />
                                </svg>
                            </div>
                            <input type="text"
                                   placeholder="Username" id="Username" asp-for="UserName"
                                   class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full bg-[#2563EB] text-white py-2 px-4 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Submit
                    </button>
                </form>

                <div class="mt-4 text-center">
                    <a href="/auth/login" class="text-[#2563EB] hover:underline">Back to Sign In</a>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center text-sm text-gray-600 mt-8">
                Please contact
                <a href="mailto:Support@nationalcompliance.ae" class="text-[#2563EB] underline">
                    support@nationalcompliance.ae
                </a>
                or your<br />Account Manager in case of support.
            </div>
        </div>
    </div>
</body>
</html>
<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>




