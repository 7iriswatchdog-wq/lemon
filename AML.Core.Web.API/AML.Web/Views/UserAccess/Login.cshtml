@{
    ViewData["Title"] = "Login";
    Layout = null;
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var clientId = HttpContextAccessor.HttpContext.Session.GetString("SessClientId");
    var logo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.User.UserModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>searchin — Sign In</title>
    <meta name="description" content="Sign in to searchin — AML compliance screening, risk scoring, and reporting platform.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ── Reset ───────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background: #f8fafc;
            overflow-x: hidden;
        }

        /* ── Layout ──────────────────────────────────────── */
        .login-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ══════════════════════════════════════════════════
           LEFT PANEL
           ══════════════════════════════════════════════════ */
        .left-panel {
            position: relative;
            width: 50%;
            background: linear-gradient(160deg, #0a0f1e 0%, #0f2038 40%, #0c3558 80%, #0a1628 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 44px 48px;
            overflow: hidden;
        }

        /* Particle canvas */
        #particleCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        /* Radial glow accents */
        .left-panel .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }
        .glow-1 { width: 400px; height: 400px; top: -5%; right: -10%; background: rgba(56, 189, 248, 0.08); }
        .glow-2 { width: 300px; height: 300px; bottom: 10%; left: -5%; background: rgba(99, 102, 241, 0.07); }
        .glow-3 { width: 250px; height: 250px; top: 40%; right: 20%; background: rgba(14, 165, 233, 0.05); }

        .left-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        /* Brand */
        .brand {
            animation: fadeSlideDown 0.7s ease-out both;
        }
        .brand-name {
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #38bdf8, #6366f1);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.25);
        }
        .brand-icon svg { width: 18px; height: 18px; color: white; }

        /* Hero */
        .hero-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            animation: fadeSlideUp 0.8s 0.15s ease-out both;
        }
        .hero-title {
            font-size: 46px;
            font-weight: 900;
            line-height: 1.05;
            color: #ffffff;
            letter-spacing: -2px;
            margin-bottom: 16px;
        }
        .hero-title .accent {
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #a78bfa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-subtitle {
            font-size: 15px;
            font-weight: 400;
            color: rgba(203, 213, 225, 0.7);
            line-height: 1.65;
            max-width: 360px;
        }



        /* Feature badges */
        .features {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: auto;
            padding-top: 28px;
            animation: fadeSlideUp 0.8s 0.45s ease-out both;
        }
        .feature-badge {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 100px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            color: rgba(226, 232, 240, 0.85);
            font-size: 12.5px;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .feature-badge:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(56, 189, 248, 0.25);
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(56, 189, 248, 0.1);
        }
        .feature-badge svg { width: 15px; height: 15px; color: #38bdf8; flex-shrink: 0; }

        /* ══════════════════════════════════════════════════
           RIGHT PANEL
           ══════════════════════════════════════════════════ */
        .right-panel {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #ffffff;
            position: relative;
            overflow: hidden;
        }

        /* Decorative accents for right panel */
        .right-panel .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.4;
        }
        .glow-right-1 { width: 300px; height: 300px; top: -10%; right: -5%; background: rgba(56, 189, 248, 0.08); }
        .glow-right-2 { width: 250px; height: 250px; bottom: -5%; left: 0%; background: rgba(99, 102, 241, 0.05); }

        .form-container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
            animation: fadeSlideUp 0.6s ease-out both;
        }

        /* Mobile brand */
        .mobile-brand {
            display: none;
            text-align: center;
            margin-bottom: 28px;
        }
        .mobile-brand .brand-name {
            justify-content: center;
            color: #0f172a;
        }

        .form-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 24px;
            padding: 48px 40px;
            box-shadow: 
                0 4px 6px -1px rgba(0, 0, 0, 0.05),
                0 10px 15px -3px rgba(0, 0, 0, 0.03),
                0 20px 25px -5px rgba(0, 0, 0, 0.02);
            animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        /* Header with secure badge */
        .form-header {
            margin-bottom: 32px;
        }
        .form-title-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }
        .form-title {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
        }
        .secure-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 600;
            color: #16a34a;
        }
        .secure-badge svg { width: 12px; height: 12px; }
        .form-subtitle {
            font-size: 14px;
            color: #64748b;
            font-weight: 400;
        }

        /* Tab content */
        .tab-content { display: block; }

        /* Form fields – floating labels */
        .form-group {
            position: relative;
            margin-bottom: 22px;
        }
        .form-group.anim-1 { animation: fadeSlideUp 0.5s 0.15s ease-out both; }
        .form-group.anim-2 { animation: fadeSlideUp 0.5s 0.25s ease-out both; }
        .form-group.anim-3 { animation: fadeSlideUp 0.5s 0.35s ease-out both; }

        .input-wrapper { position: relative; }

        .form-input {
            width: 100%;
            padding: 16px 14px 8px 44px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 400;
            color: #1e293b;
            background: #ffffff;
            transition: all 0.25s ease;
            outline: none;
        }
        .form-input::placeholder { color: transparent; }
        .form-input:hover { border-color: #cbd5e1; }
        .form-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
        }
        .form-input.error {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
        }

        .floating-label {
            position: absolute;
            left: 44px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: #94a3b8;
            pointer-events: none;
            transition: all 0.2s ease;
            background: #ffffff;
            padding: 0 4px;
        }
        .form-input:focus ~ .floating-label,
        .form-input:not(:placeholder-shown) ~ .floating-label {
            top: 2px;
            left: 38px;
            font-size: 10.5px;
            font-weight: 600;
            color: #3b82f6;
            letter-spacing: 0.03em;
        }
        .form-input.error:focus ~ .floating-label,
        .form-input.error:not(:placeholder-shown) ~ .floating-label {
            color: #ef4444;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            transition: color 0.25s;
            pointer-events: none;
        }
        .input-icon svg { width: 17px; height: 17px; }
        .form-input:focus ~ .input-icon { color: #3b82f6; }
        .form-input.error ~ .input-icon { color: #ef4444; }

        /* Inline error message */
        .field-error {
            display: none;
            font-size: 11.5px;
            font-weight: 500;
            color: #ef4444;
            margin-top: 5px;
            padding-left: 4px;
            animation: fadeSlideUp 0.2s ease-out;
        }
        .field-error.visible { display: block; }

        /* Password extras */
        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b8;
            padding: 4px;
            display: flex;
            align-items: center;
            transition: color 0.2s;
        }
        .toggle-password:hover { color: #64748b; }
        .toggle-password svg { width: 17px; height: 17px; }



        .caps-warning {
            display: none;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 500;
            color: #f59e0b;
            margin-top: 6px;
        }
        .caps-warning.visible { display: flex; }
        .caps-warning svg { width: 13px; height: 13px; }

        /* Options row */
        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
            animation: fadeSlideUp 0.5s 0.4s ease-out both;
        }
        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        .custom-checkbox {
            width: 17px; height: 17px;
            border-radius: 5px;
            border: 1.5px solid #d1d5db;
            background: #fff;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
            cursor: pointer;
            flex-shrink: 0;
        }
        .custom-checkbox.checked {
            background: #2563eb;
            border-color: #2563eb;
        }
        .custom-checkbox svg { width: 11px; height: 11px; color: white; opacity: 0; transition: opacity 0.15s; }
        .custom-checkbox.checked svg { opacity: 1; }
        .remember-me span { font-size: 13px; color: #64748b; }
        .forgot-link {
            font-size: 13px;
            font-weight: 500;
            color: #3b82f6;
            text-decoration: none;
            transition: color 0.2s;
        }
        .forgot-link:hover { color: #1d4ed8; }

        /* Submit button */
        .submit-btn {
            width: 100%;
            padding: 13px 24px;
            border: none;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 14.5px;
            font-weight: 600;
            color: #ffffff;
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%);
            background-size: 200% 200%;
            cursor: pointer;
            transition: all 0.35s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            animation: fadeSlideUp 0.5s 0.5s ease-out both;
        }
        .submit-btn .btn-arrow {
            transition: transform 0.3s ease;
            display: flex;
        }
        .submit-btn .btn-arrow svg { width: 16px; height: 16px; }
        .submit-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 30px -5px rgba(37, 99, 235, 0.45);
            background-position: 100% 100%;
        }
        .submit-btn:hover .btn-arrow { transform: translateX(4px); }
        .submit-btn:active { transform: translateY(0); box-shadow: 0 4px 12px -3px rgba(37, 99, 235, 0.3); }
        .submit-btn.loading { pointer-events: none; opacity: 0.85; }
        .submit-btn .spinner {
            display: none;
            width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }
        .submit-btn.loading .btn-text,
        .submit-btn.loading .btn-arrow { display: none; }
        .submit-btn.loading .spinner { display: block; }



        /* Trust footer */
        .trust-footer {
            margin-top: 32px;
            text-align: center;
            animation: fadeSlideUp 0.5s 0.6s ease-out both;
        }
        .trust-protected {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 12px;
            color: #94a3b8;
            font-weight: 500;
            margin-bottom: 12px;
        }
        .trust-protected svg { width: 14px; height: 14px; color: #94a3b8; }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 16px;
        }
        .footer-link {
            font-size: 12px;
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s;
            font-weight: 400;
        }
        .footer-link:hover { color: #3b82f6; }

        /* Error / Success */
        .error-msg {
            margin-top: 16px;
            padding: 11px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 500;
            animation: shake 0.4s ease-out;
        }
        .error-msg.error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
        .error-msg.success { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }

        .shake-it { animation: shake 0.4s ease-out; }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-5px); }
            40% { transform: translateX(5px); }
            60% { transform: translateX(-3px); }
            80% { transform: translateX(3px); }
        }

        /* Loading overlay (hidden by default) */
        .se-pre-con1 { display: none; }

        /* ── Animations ──────────────────────────────────── */
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes fadeSlideDown {
            from { opacity: 0; transform: translateY(-16px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* Focus-visible for keyboard nav */
        *:focus-visible {
            outline: 2px solid #3b82f6;
            outline-offset: 2px;
        }
        .form-input:focus-visible { outline: none; /* uses box-shadow instead */ }

        /* ── Responsive ──────────────────────────────────── */
        @@media (max-width: 960px) {
            .left-panel { display: none; }
            .right-panel {
                width: 100%;
                padding: 32px 20px;
                background: linear-gradient(180deg, #f8fafc, #fff);
            }
            .mobile-brand { display: block; }
        }
        @@media (max-width: 480px) {
            .form-title { font-size: 22px; }
            .form-container { max-width: 100%; }

        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- ══ LEFT PANEL ══ -->
        <div class="left-panel" aria-hidden="true">
            <canvas id="particleCanvas"></canvas>
            <div class="glow glow-1"></div>
            <div class="glow glow-2"></div>
            <div class="glow glow-3"></div>

            <div class="left-content">
                <div class="brand">
                    <div class="brand-name">
                        <div style="color: white; height: 54px; display: flex; align-items: center; transform: scale(1.1); transform-origin: left center;">
                            @await Html.PartialAsync("AdminLTE/_searchinLogo")
                        </div>
                    </div>
                </div>

                <div class="hero-section">
                    <h1 class="hero-title">
                        Screen. Score.<br>
                        <span class="accent">Comply.</span>
                    </h1>
                    <p class="hero-subtitle">
                        Intelligent AML compliance screening, risk scoring, and reporting — built for speed, accuracy, and regulatory confidence.
                    </p>

                </div>

                <div class="features">
                    <div class="feature-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        Real-time Screening
                    </div>
                    <div class="feature-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        Risk Scoring
                    </div>
                    <div class="feature-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                            <polyline points="10 9 9 9 8 9"/>
                        </svg>
                        Compliance Reporting
                    </div>
                </div>
            </div>
        </div>

        <!-- ══ RIGHT PANEL ══ -->
        <div class="right-panel">
            <div class="glow glow-right-1"></div>
            <div class="glow glow-right-2"></div>

            <div class="form-container">
                <div class="mobile-brand">
                    <div class="brand-name">
                        <div style="color: #0f172a; height: 50px; display: flex; align-items: center; justify-content: center; transform: scale(1.05);">
                            @await Html.PartialAsync("AdminLTE/_searchinLogo")
                        </div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="form-header">
                        <div class="form-title-row">
                            <h2 class="form-title">Welcome back</h2>
                            <span class="secure-badge" aria-label="Secure connection">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                                Secure
                            </span>
                        </div>
                        <p class="form-subtitle">Sign in to your account to continue</p>
                    </div>

                    <!-- ── SIGN IN TAB ── -->
                    <div class="tab-content active" id="tab-signin" role="tabpanel" aria-labelledby="tab-btn-signin">
                        <form asp-controller="UserAccess" asp-action="Login" enctype="multipart/form-data" method="post" id="loginForm" novalidate>
                            <div class="form-group anim-1">
                                <div class="input-wrapper">
                                    <input type="text" class="form-input" id="ClientName" asp-for="ClientName" placeholder=" " autocomplete="organization" aria-label="Company name" required>
                                    <label class="floating-label" for="ClientName">Company</label>
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                        </svg>
                                    </span>
                                </div>
                                <div class="field-error" id="error-company">Company name is required</div>
                            </div>

                            <div class="form-group anim-2">
                                <div class="input-wrapper">
                                    <input type="text" class="form-input" id="UserName" asp-for="UserName" placeholder=" " autocomplete="username" aria-label="Username" required>
                                    <label class="floating-label" for="UserName">Username</label>
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                        </svg>
                                    </span>
                                </div>
                                <div class="field-error" id="error-username">Username is required</div>
                            </div>

                            <div class="form-group anim-3">
                                <div class="input-wrapper">
                                    <input type="password" class="form-input" id="password" asp-for="Password" placeholder=" " autocomplete="current-password" aria-label="Password" style="padding-right: 44px;" required>
                                    <label class="floating-label" for="password">Password</label>
                                    <span class="input-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                                        </svg>
                                    </span>
                                    <button type="button" class="toggle-password" onclick="togglePassword();" aria-label="Toggle password visibility">
                                        <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                        </svg>
                                        <svg id="eyeOffIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                                            <line x1="1" y1="1" x2="23" y2="23"/>
                                        </svg>
                                    </button>
                                </div>
                                <div class="field-error" id="error-password">Password is required</div>
                            </div>

                            <div class="form-options">
                                <label class="remember-me" id="rememberToggle" tabindex="0" role="checkbox" aria-checked="false" aria-label="Remember me">
                                    <div class="custom-checkbox" id="checkboxVisual">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                    </div>
                                    <input type="checkbox" id="rememberMe" style="display:none;">
                                    <span>Remember me</span>
                                </label>
                                <a href="/auth/Forgot" class="forgot-link">Forgot password?</a>
                            </div>

                            <button type="submit" class="submit-btn" id="signin" aria-label="Sign in">
                                <span class="btn-text">Sign In</span>
                                <span class="btn-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
                                <div class="spinner"></div>
                            </button>
                        </form>

                        @if (!string.IsNullOrEmpty(Convert.ToString(ViewData["Error"])))
                        {
                            <div class="error-msg error" role="alert">Wrong username, password and/or company name.</div>
                        }
                        @if (!string.IsNullOrEmpty(Convert.ToString(ViewData["Success"])))
                        {
                            <div class="error-msg success" role="status">@ViewData["Success"]</div>
                        }
                    </div>
                </div>

                <div class="trust-footer">
                    <div class="trust-protected">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Protected by searchin Security
                    </div>
                    <div class="footer-links">
                        <a href="#" class="footer-link">Help Center</a>
                        <a href="#" class="footer-link">Privacy Policy</a>
                        <a href="#" class="footer-link">Terms</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="se-pre-con1" style="display:none"></div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
    (function() {
        'use strict';

        // ── Particle Network ────────────────────────────
        const canvas = document.getElementById('particleCanvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let particles = [];
            const PARTICLE_COUNT = 60;
            const MAX_DIST = 140;

            function resize() {
                canvas.width = canvas.parentElement.offsetWidth;
                canvas.height = canvas.parentElement.offsetHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            class Particle {
                constructor() { this.reset(); }
                reset() {
                    this.x = Math.random() * canvas.width;
                    this.y = Math.random() * canvas.height;
                    this.vx = (Math.random() - 0.5) * 0.35;
                    this.vy = (Math.random() - 0.5) * 0.35;
                    this.r = Math.random() * 1.8 + 0.5;
                    this.alpha = Math.random() * 0.4 + 0.15;
                }
                update() {
                    this.x += this.vx;
                    this.y += this.vy;
                    if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
                    if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
                }
                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(56, 189, 248, ${this.alpha})`;
                    ctx.fill();
                }
            }

            for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (let i = 0; i < particles.length; i++) {
                    particles[i].update();
                    particles[i].draw();
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x;
                        const dy = particles[i].y - particles[j].y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < MAX_DIST) {
                            ctx.beginPath();
                            ctx.moveTo(particles[i].x, particles[i].y);
                            ctx.lineTo(particles[j].x, particles[j].y);
                            ctx.strokeStyle = `rgba(56, 189, 248, ${0.08 * (1 - dist / MAX_DIST)})`;
                            ctx.lineWidth = 0.6;
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(animate);
            }
            animate();
        }



        // ── Toggle Password ─────────────────────────────
        window.togglePassword = function() {
            const pw = document.getElementById('password');
            const isHidden = pw.type === 'password';
            pw.type = isHidden ? 'text' : 'password';
            document.getElementById('eyeIcon').style.display = isHidden ? 'none' : 'block';
            document.getElementById('eyeOffIcon').style.display = isHidden ? 'block' : 'none';
        };

        // ── Custom Checkbox ─────────────────────────────
        const rememberToggle = document.getElementById('rememberToggle');
        const rememberMe = document.getElementById('rememberMe');
        const checkboxVisual = document.getElementById('checkboxVisual');
        if (rememberToggle) {
            rememberToggle.addEventListener('click', function(e) {
                e.preventDefault();
                rememberMe.checked = !rememberMe.checked;
                checkboxVisual.classList.toggle('checked', rememberMe.checked);
                this.setAttribute('aria-checked', rememberMe.checked);
            });
            rememberToggle.addEventListener('keydown', function(e) {
                if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); this.click(); }
            });
        }



        // ── Caps Lock Warning ───────────────────────────
        const passwordInput = document.getElementById('password');
        if (passwordInput) {
            passwordInput.addEventListener('keyup', function(e) {
                const capsOn = e.getModifierState && e.getModifierState('CapsLock');
                document.getElementById('capsWarning').classList.toggle('visible', capsOn);
            });
        }

        // ── Inline Validation ───────────────────────────
        function validateField(input, errorId) {
            const err = document.getElementById(errorId);
            if (!input.value.trim()) {
                input.classList.add('error');
                err.classList.add('visible');
                return false;
            } else {
                input.classList.remove('error');
                err.classList.remove('visible');
                return true;
            }
        }

        document.querySelectorAll('#loginForm .form-input').forEach(input => {
            input.addEventListener('blur', function() {
                if (this.id === 'ClientName') validateField(this, 'error-company');
                if (this.id === 'UserName') validateField(this, 'error-username');
                if (this.id === 'password') validateField(this, 'error-password');
            });
            input.addEventListener('input', function() {
                if (this.classList.contains('error')) {
                    if (this.id === 'ClientName') validateField(this, 'error-company');
                    if (this.id === 'UserName') validateField(this, 'error-username');
                    if (this.id === 'password') validateField(this, 'error-password');
                }
            });
        });

        // ── Focus icon color ────────────────────────────
        document.querySelectorAll('.form-input').forEach(input => {
            const icon = input.closest('.input-wrapper').querySelector('.input-icon');
            if (icon) {
                input.addEventListener('focus', () => icon.style.color = input.classList.contains('error') ? '#ef4444' : '#3b82f6');
                input.addEventListener('blur', () => icon.style.color = '#94a3b8');
            }
        });

        // ── Form Submit ─────────────────────────────────
        $('#signin').on('click', function(e) {
            e.preventDefault();
            const c = validateField(document.getElementById('ClientName'), 'error-company');
            const u = validateField(document.getElementById('UserName'), 'error-username');
            const p = validateField(document.getElementById('password'), 'error-password');

            if (!c || !u || !p) {
                document.querySelector('#loginForm').classList.add('shake-it');
                setTimeout(() => document.querySelector('#loginForm').classList.remove('shake-it'), 500);
                return;
            }

            $(this).addClass('loading');
            $('#loginForm').submit();
        });


    })();
    </script>
</body>
</html>
