@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{

    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.UserAccess.ChangePasswordModel
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }</style>

<!-- RIGHT SIDE -->
<div class="max-w-screen h-full items-center ">

    <!-- RIGHT SIDE NAV -->
    @* <nav class="border-b">
        <div class="flex flex-row items-center justify-between w-full h-full md:p-5 p-5">
            <div>
                <h2 class="text-2xl font-bold">Update Password</h2>
            </div>
            <div class="md:block hidden">
                <img src="/img/1747840934621Watchdogimg.jpg" alt="Client Logo" width="50px">
            </div>
        </div>
    </nav> *@
    <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-white">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                Update Password
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>
    <div class="h-screen bg-gray-50 items-center  ">
        <div class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4 mx-auto">
            <!-- NAME SCREENING -->
            <div class="w-full bg-white rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
                <div id="loadingeffect" class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
                    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
                </div>
                <div class="flex justify-center items-center mb-4">
                    <h6 class="text-lg font-semibold">
                        Provide the details to change your password
                    </h6>
                </div>

                <form asp-controller="UserAccess" asp-action="UpdatePassword"
                      method="post" enctype="multipart/form-data" class="space-y-6">

                    <input type="hidden" asp-for="Id" />

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                        <!-- Old Password -->
                        <div>
                            <input type="password"
                                   asp-for="OldPassword"
                                   placeholder="Old Password"
                                   class="w-full rounded-md border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-blue-500" />
                            <span asp-validation-for="OldPassword" class="text-red-500 text-sm"></span>
                        </div>

                        <!-- New Password -->
                        <div>
                            <input type="password"
                                   asp-for="NewPassword"
                                   placeholder="New Password"
                                   class="w-full rounded-md border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-blue-500" />
                            <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
                        </div>

                        <!-- Repeat Password -->
                        <div>
                            <input type="password"
                                   asp-for="RepeatPassword"
                                   placeholder="Re-Type Password"
                                   class="w-full rounded-md border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-blue-500" />
                            <span asp-validation-for="RepeatPassword" class="text-red-500 text-sm"></span>
                        </div>

                    </div>

                    <div class="flex justify-center mt-10">
                        <button type="button"
                                class="px-6 py-2 bg-[#2563EB] text-white rounded-md hover:bg-blue-700" onclick="fnSubmit()">
                            Submit
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

</div>
<script>
    function fnSubmit() {
            document.getElementById("loadingeffect").style.display = "flex";

            // Optionally disable button
            const btn = document.querySelector('button[onclick="fnSubmit()"]');
            btn.disabled = true;
            btn.classList.add("opacity-50", "cursor-not-allowed");

            // Submit form manually
            document.querySelector('form').submit();
        }
    @* function fnSubmit() {
        $("#loadingeffect").show();
    } *@
</script>

