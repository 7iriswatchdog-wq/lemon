@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Update Password";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.UserAccess.ChangePasswordModel

<div class="w-full h-full p-6">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Update Password</h2>
            <p class="text-sm text-gray-500 mt-1">Provide your current and new password details to securely update your account access.</p>
        </div>

        <!-- Main Form Card -->
        <div class="bg-white rounded-lg border border-gray-300 shadow-sm p-6">
            <form id="updatePasswordForm" asp-controller="UserAccess" asp-action="UpdatePassword" method="post" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" asp-for="Id" />

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    
                    <!-- Old Password -->
                    <div class="flex flex-col">
                        <label for="old" class="text-[13px] font-medium text-[#374151] mb-1">Old Password</label>
                        <div class="relative flex items-center">
                            <input type="password" id="old" asp-for="OldPassword" class="w-full h-[48px] pl-[12px] pr-[40px] bg-[#FFFFFF] border border-[#D1D5DB] rounded-[8px] focus:outline-none focus:border-[#2563EB] focus:ring-[3px] focus:ring-[#2563EB]/12 transition-shadow" required />
                            <button type="button" class="absolute right-[12px] text-gray-400 hover:text-gray-600 focus:outline-none" onclick="togglePassword('old', 'slashLineOld');" tabindex="-1">
                                <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    <line id="slashLineOld" x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" style="display: none;"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="OldPassword" class="text-[12px] text-[#DC2626] mt-1"></span>
                    </div>

                    <!-- New Password -->
                    <div class="flex flex-col">
                        <label for="new" class="text-[13px] font-medium text-[#374151] mb-1">New Password</label>
                        <div class="relative flex items-center">
                            <input type="password" id="new" asp-for="NewPassword" class="w-full h-[48px] pl-[12px] pr-[40px] bg-[#FFFFFF] border border-[#D1D5DB] rounded-[8px] focus:outline-none focus:border-[#2563EB] focus:ring-[3px] focus:ring-[#2563EB]/12 transition-shadow" required />
                            <button type="button" class="absolute right-[12px] text-gray-400 hover:text-gray-600 focus:outline-none" onclick="togglePassword('new', 'slashLineNew');" tabindex="-1">
                                <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    <line id="slashLineNew" x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" style="display: none;"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-[12px] text-[#DC2626] mt-1"></span>
                    </div>

                    <!-- Repeat Password -->
                    <div class="flex flex-col">
                        <label for="repeat" class="text-[13px] font-medium text-[#374151] mb-1">Repeat Password</label>
                        <div class="relative flex items-center">
                            <input type="password" id="repeat" asp-for="RepeatPassword" class="w-full h-[48px] pl-[12px] pr-[40px] bg-[#FFFFFF] border border-[#D1D5DB] rounded-[8px] focus:outline-none focus:border-[#2563EB] focus:ring-[3px] focus:ring-[#2563EB]/12 transition-shadow" required />
                            <button type="button" class="absolute right-[12px] text-gray-400 hover:text-gray-600 focus:outline-none" onclick="togglePassword('repeat', 'slashLineRepeat');" tabindex="-1">
                                <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    <line id="slashLineRepeat" x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" style="display: none;"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="RepeatPassword" class="text-[12px] text-[#DC2626] mt-1"></span>
                    </div>

                </div>

                <div class="flex justify-end mt-8 border-t border-gray-200 pt-6">
                    <button type="button" onclick="fnSubmit()" id="submitBtn" class="bg-[#2563EB] text-white px-6 py-[10px] rounded-lg hover:bg-[#1D4ED8] transition-colors font-medium focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2">
                        Submit Update
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    function togglePassword(inputId, lineId) {
        const passwordInput = document.getElementById(inputId);
        const slashLine = document.getElementById(lineId);

        const isHidden = passwordInput.type === "password";
        passwordInput.type = isHidden ? "text" : "password";

        slashLine.style.display = isHidden ? "block" : "none";
    }

    function fnSubmit() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.classList.add("opacity-50", "cursor-not-allowed");
        btn.innerText = "Submitting...";

        document.getElementById('updatePasswordForm').submit();
    }
</script>