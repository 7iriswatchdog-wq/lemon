@using MongoDB.Driver.Linq;
@using Newtonsoft.Json;
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = @localizer["Notepad"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var userName = HttpContextAccessor.HttpContext.Session.GetString("SessUsername");
}

@section Styles {
    <style>
        [x-cloak] { display: none !important; }
        body { background: #f8fafc !important; font-family: 'Inter', system-ui, -apple-system, sans-serif; }

        /* Dashboard-matching card system */
        .np-shell { padding: 20px 28px; }
        .np-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 1px 2px rgba(15,23,42,.04); transition: box-shadow .2s, border-color .2s; }
        .np-card:hover { box-shadow: 0 4px 12px rgba(15,23,42,.06); border-color: #cbd5e1; }

        /* KPI stat cards */
        .np-kpi { padding: 18px 22px; position: relative; overflow: hidden; }
        .np-kpi::after { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; border-radius: 0 4px 4px 0; }
        .np-kpi.kpi-blue::after { background: #3b82f6; }
        .np-kpi.kpi-green::after { background: #10b981; }
        .np-kpi.kpi-amber::after { background: #f59e0b; }
        .np-kpi-label { font-size: 13px; color: #64748b; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; }
        .np-kpi-num { font-size: 28px; font-weight: 800; color: #0f172a; line-height: 1.1; margin-top: 4px; font-variant-numeric: tabular-nums; }
        .np-kpi-sub { font-size: 13px; color: #94a3b8; margin-top: 4px; }

        /* Section header */
        .np-section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; }
        .np-section-title { font-size: 15px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 8px; }
        .np-section-badge { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 10px; background: #f1f5f9; color: #64748b; }

        /* Table */
        .table-container { height: calc(100vh - 320px); overflow-x: auto; overflow-y: auto; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
        .sticky-col { position: sticky; left: 0; z-index: 10; }
        .sticky-header { position: sticky; top: 0; z-index: 20; }

        .np-tbl { width: 100%; border-collapse: separate; border-spacing: 0; }
        .np-tbl thead th { font-size: 12px !important; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; padding: 12px 16px; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; background: #fafbfc; z-index: 1; white-space: nowrap; }
        .np-tbl tbody tr { transition: all .15s; }
        .np-tbl tbody tr:nth-child(even) { background: #fafbfc; }
        .np-tbl tbody tr:hover { background: #f1f5f9; }
        .np-tbl tbody td { font-size: 13px !important; padding: 10px 16px; color: #475569; white-space: nowrap; border-bottom: 1px solid #f1f5f9; }

        input:focus, select:focus { outline: none !important; border-color: #3b82f6 !important; box-shadow: 0 0 0 3px rgba(59,130,246,.1) !important; }

        /* Flatpickr */
        .flatpickr-input[readonly] { background-color: white !important; cursor: pointer !important; }
        .flatpickr-calendar { font-family: inherit !important; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1) !important; border: 1px solid #e2e8f0 !important; }

        /* Action buttons */
        .np-btn { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 18px; border-radius: 10px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; transition: all .15s; }
        .np-btn-primary { background: #3b82f6; color: #fff; box-shadow: 0 2px 8px rgba(59,130,246,.18); }
        .np-btn-primary:hover { background: #2563eb; }
        .np-btn-success { background: #10b981; color: #fff; box-shadow: 0 2px 8px rgba(16,185,129,.18); }
        .np-btn-success:hover { background: #059669; }
        .np-btn-ghost { background: #fff; color: #475569; border: 1px solid #e2e8f0; }
        .np-btn-ghost:hover { background: #f8fafc; border-color: #cbd5e1; }
        .np-btn-icon { width: 40px; padding: 0; justify-content: center; }

        /* Clickable row */
        .clickable-row { cursor: pointer; }
        .clickable-row:hover td { color: #1e293b; }

        /* Custom notification */
        .np-notify-wrap { position: fixed; top: 20px; right: 20px; z-index: 99999; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
        .np-toast { pointer-events: auto; min-width: 320px; max-width: 420px; padding: 14px 44px 14px 18px; border-radius: 12px; font-size: 13px; font-weight: 600; color: #fff; display: flex; align-items: center; gap: 12px; box-shadow: 0 8px 30px rgba(0,0,0,.15), 0 2px 8px rgba(0,0,0,.08); backdrop-filter: blur(12px); animation: np-slide-in .35s cubic-bezier(.21,1.02,.73,1); position: relative; line-height: 1.4; }
        .np-toast.np-exit { animation: np-slide-out .3s ease forwards; }
        .np-toast.np-success { background: linear-gradient(135deg, #059669, #10b981); }
        .np-toast.np-error { background: linear-gradient(135deg, #dc2626, #ef4444); }
        .np-toast.np-info { background: linear-gradient(135deg, #2563eb, #3b82f6); }
        .np-toast.np-warning { background: linear-gradient(135deg, #d97706, #f59e0b); }
        .np-toast-icon { width: 22px; height: 22px; border-radius: 6px; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .np-toast-close { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; border: none; background: rgba(255,255,255,.15); border-radius: 6px; color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s; font-size: 14px; line-height: 1; }
        .np-toast-close:hover { background: rgba(255,255,255,.3); }
        @@keyframes np-slide-in { from { transform: translateX(100%) scale(.9); opacity: 0; } to { transform: translateX(0) scale(1); opacity: 1; } }
        @@keyframes np-slide-out { to { transform: translateX(120%); opacity: 0; } }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
}

<div class="np-notify-wrap" id="npNotifyWrap"></div>
<div class="min-h-screen text-slate-900" x-data="trackerApp()" x-init="init()">
    <div class="np-shell" style="display:flex;flex-direction:column;gap:20px">

        <!-- ═══ HEADER BAR (matches dashboard) ═══ -->
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <div style="display:flex;align-items:center;gap:14px">
                <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#3b82f6,#6366f1);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(59,130,246,.25)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8Z"/><path d="M15 3v5a2 2 0 0 0 2 2h5"/></svg>
                </div>
                <div>
                    <h1 style="font-size:22px;font-weight:800;color:#0f172a;line-height:1.2;letter-spacing:-.02em">AML Tracker</h1>
                    <p style="font-size:13px;color:#94a3b8;font-weight:500">Compliance Notepad</p>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <div style="position:relative">
                    <input type="text" x-model="searchQuery" @@keyup.enter="performSearch()" placeholder="Search records..." style="width:220px;height:40px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:0 14px 0 38px;font-size:13px;font-weight:600;color:#0f172a">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5" style="position:absolute;left:12px;top:12px"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <button @@click="performSearch()" class="np-btn np-btn-primary">Search</button>
                <button @@click="resetFilters()" class="np-btn np-btn-ghost">Reset</button>
                <div style="width:1px;height:28px;background:#e2e8f0;margin:0 4px"></div>
                <button @@click="addNewRow()" title="Add Record" class="np-btn np-btn-primary np-btn-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 4v16m8-8H4"/></svg>
                </button>
                <button @@click="saveAll()" title="Save All" class="np-btn np-btn-success np-btn-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                </button>
                <button @@click="exportToExcel()" class="np-btn np-btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Export
                </button>
            </div>
        </div>

        <!-- ═══ KPI STAT CARDS ═══ -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
            <div class="np-card np-kpi kpi-blue">
                <div class="np-kpi-label">📋 Total Records</div>
                <div class="np-kpi-num" x-text="rows.length">0</div>
                <div class="np-kpi-sub">All tracker entries</div>
            </div>
            <div class="np-card np-kpi kpi-green">
                <div class="np-kpi-label">✓ Saved</div>
                <div class="np-kpi-num" x-text="rows.filter(r => !r.isNew).length">0</div>
                <div class="np-kpi-sub">Committed records</div>
            </div>
            <div class="np-card np-kpi kpi-amber">
                <div class="np-kpi-label">⚡ New / Editing</div>
                <div class="np-kpi-num" x-text="rows.filter(r => r.isNew || r.isEditing).length">0</div>
                <div class="np-kpi-sub">Pending save</div>
            </div>
        </div>

        <!-- ═══ TABLE CARD ═══ -->
        <div class="np-card" style="overflow:hidden">
            <div class="np-section-header">
                <div class="np-section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>
                    Tracker Records
                </div>
                <div class="np-section-badge" x-text="rows.length + ' total'">0 total</div>
            </div>
            <div class="table-container custom-scrollbar">
                <table class="np-tbl">
                    <thead>
                        <tr>
                            <th style="text-align:center;width:48px">#</th>
                            <th style="min-width:120px">Date of Receipt</th>
                            <th style="min-width:90px;text-align:center">Actions</th>
                            <th style="min-width:250px">Case Type</th>
                            <th style="min-width:140px">Cust Type</th>
                            <th style="min-width:170px">WDS Cust ID</th>
                            <th style="min-width:200px">Unit Ref / Unique Ref</th>
                            <th style="min-width:200px">Customer Name</th>
                            <th style="min-width:280px">KYC Comments</th>
                            <th style="min-width:170px">Buyer/Seller/Dev</th>
                            <th style="min-width:110px">Created By</th>
                            <th style="min-width:110px">Created On</th>
                            <th style="min-width:110px">Updated By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(row, index) in rows" :key="row.id || 'new-' + index">
                            <tr :class="row.isNew ? 'bg-blue-50/40' : ''" style="transition:all .15s">
                                <td style="text-align:center;font-weight:700;color:#94a3b8" x-text="index + 1"></td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="font-weight:500;color:#475569" x-text="formatDate(row.date_of_receipt)"></span></template>
                                    <template x-if="row.isEditing"><input type="text" x-init="initDatePicker($el, row)" :value="formatDate(row.date_of_receipt)" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 10px;font-size:12px" readonly></template>
                                </td>
                                <td style="text-align:center">
                                    <div style="display:flex;align-items:center;justify-content:center;gap:4px">
                                        <template x-if="!row.isEditing">
                                            <button @@click="editRow(row)" style="padding:5px;border-radius:6px;border:none;background:transparent;cursor:pointer;color:#94a3b8" onmouseover="this.style.background='#f1f5f9';this.style.color='#1e293b'" onmouseout="this.style.background='transparent';this.style.color='#94a3b8'">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                            </button>
                                        </template>
                                        <template x-if="row.isEditing">
                                            <button @@click="saveRow(row)" style="padding:5px;border-radius:6px;border:none;background:#3b82f6;color:#fff;cursor:pointer" :disabled="row.isSaving">
                                                <svg x-show="!row.isSaving" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
                                                <svg x-show="row.isSaving" style="animation:spin 1s linear infinite" width="14" height="14" viewBox="0 0 24 24"><circle opacity=".25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path opacity=".75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                            </button>
                                        </template>
                                        <button @@click="confirmDelete(row.id)" style="padding:5px;border-radius:6px;border:none;background:transparent;cursor:pointer;color:#94a3b8" onmouseover="this.style.background='#fef2f2';this.style.color='#ef4444'" onmouseout="this.style.background='transparent';this.style.color='#94a3b8'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="color:#475569;max-width:220px;overflow:hidden;text-overflow:ellipsis;display:block" :title="row.case_type" x-text="row.case_type"></span></template>
                                    <template x-if="row.isEditing"><select x-model="row.case_type" @@change="onCaseTypeChange(row)" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 8px;font-size:12px"><option value="">--Select--</option><option value="New Unprocessed Main Party Cases – None of EID / PP / TL Available">New Unprocessed Main Party Cases</option><option value="Unprocessed and incomplete repeat case (pending KYC documents, screening done and RA pending)">Unprocessed repeat case</option><option value="Others">Others</option></select></template>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="color:#475569" x-text="row.cust_type || '-'"></span></template>
                                    <template x-if="row.isEditing"><input type="text" x-model="row.cust_type" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 10px;font-size:12px"></template>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="font-family:monospace;color:#64748b" x-text="row.wds_cust_id || '-'"></span></template>
                                    <template x-if="row.isEditing"><input type="text" x-model="row.wds_cust_id" :disabled="row.isWdsLocked" :style="row.isWdsLocked ? 'background:#f8fafc' : ''" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 10px;font-size:12px"></template>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="color:#475569" x-text="row.unit_ref_no || '-'"></span></template>
                                    <template x-if="row.isEditing"><input type="text" x-model="row.unit_ref_no" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 10px;font-size:12px"></template>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="font-weight:700;color:#0f172a" x-text="row.customer_name"></span></template>
                                    <template x-if="row.isEditing"><input type="text" x-model="row.customer_name" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 10px;font-size:12px"></template>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="color:#64748b;font-style:italic;max-width:260px;overflow:hidden;text-overflow:ellipsis;display:block" :title="row.comment_kyc" x-text="row.comment_kyc || '-'"></span></template>
                                    <template x-if="row.isEditing"><input type="text" x-model="row.comment_kyc" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 10px;font-size:12px"></template>
                                </td>
                                <td>
                                    <template x-if="!row.isEditing"><span style="color:#475569" x-text="row.cust_type_realestate || '-'"></span></template>
                                    <template x-if="row.isEditing"><select x-model="row.cust_type_realestate" style="width:100%;height:32px;border-radius:8px;border:1px solid #e2e8f0;padding:0 8px;font-size:12px"><option value="">--Select--</option><option value="Buyer">Buyer</option><option value="Seller">Seller</option><option value="Developer">Developer</option></select></template>
                                </td>
                                <td style="color:#94a3b8" x-text="row.createdByName || '-'"></td>
                                <td style="color:#94a3b8" x-text="formatDate(row.created_on)"></td>
                                <td style="color:#94a3b8" x-text="row.updatedByName || '-'"></td>
                            </tr>
                        </template>
                        <template x-if="rows.length === 0">
                            <tr>
                                <td colspan="13" style="padding:60px 20px;text-align:center">
                                    <div style="display:flex;flex-direction:column;align-items:center">
                                        <div style="width:64px;height:64px;background:#f1f5f9;border-radius:16px;display:flex;align-items:center;justify-content:center;margin-bottom:16px">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
                                        </div>
                                        <h3 style="font-size:16px;font-weight:800;color:#0f172a;margin-bottom:4px">No Tracker Records</h3>
                                        <p style="font-size:13px;color:#94a3b8;max-width:300px">Click "Add Record" to start tracking AML compliance entries.</p>
                                        <button @@click="addNewRow()" class="np-btn np-btn-primary" style="margin-top:16px">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 4v16m8-8H4"/></svg>
                                            Add First Record
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═══ FOOTER ═══ -->
        <div style="display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#94a3b8;font-weight:600">
            <div x-text="'Showing ' + rows.length + ' total records'"></div>
            <div style="display:flex;align-items:center;gap:16px">
                <div style="display:flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;background:#3b82f6"></span>New Records</div>
                <div style="display:flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;background:#cbd5e1"></span>Saved Records</div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div x-show="showDeleteModal" x-cloak style="position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.4);backdrop-filter:blur(4px)" x-transition.opacity>
        <div style="background:#fff;border-radius:16px;box-shadow:0 24px 48px rgba(0,0,0,.15);max-width:380px;width:100%;padding:32px;text-align:center" @@click.away="showDeleteModal = false">
            <div style="width:56px;height:56px;background:#fef2f2;color:#ef4444;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v2m3 3h8"/></svg>
            </div>
            <h3 style="font-size:18px;font-weight:800;color:#0f172a;margin-bottom:6px">Delete Record?</h3>
            <p style="font-size:13px;color:#94a3b8;margin-bottom:24px">This action cannot be undone.</p>
            <div style="display:flex;gap:10px">
                <button @@click="showDeleteModal = false" class="np-btn np-btn-ghost" style="flex:1;justify-content:center">Cancel</button>
                <button @@click="executeDelete()" style="flex:1;height:40px;background:#ef4444;color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 2px 8px rgba(239,68,68,.2)">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        // ═══ Custom notification system (replaces broken toastr) ═══
        const toastr = {
            _icons: {
                success: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>',
                error: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>',
                info: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>',
                warning: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4M12 17h.01"/></svg>'
            },
            _show(msg, type) {
                const wrap = document.getElementById('npNotifyWrap');
                const el = document.createElement('div');
                el.className = `np-toast np-${type}`;
                el.innerHTML = `
                    <div class="np-toast-icon">${this._icons[type] || ''}</div>
                    <span>${msg}</span>
                    <button class="np-toast-close" onclick="this.parentElement.classList.add('np-exit'); setTimeout(() => this.parentElement.remove(), 300)">&times;</button>
                `;
                wrap.appendChild(el);
            },
            success(msg) { this._show(msg, 'success'); },
            error(msg) { this._show(msg, 'error'); },
            info(msg) { this._show(msg, 'info'); },
            warning(msg) { this._show(msg, 'warning'); }
        };

        function trackerApp() {
            return {
                rows: [],
                searchQuery: '',
                showDeleteModal: false,
                idToDelete: null,
                caseTypes: [
                    "New Unprocessed Main Party Cases – None of EID / PP / TL Available",
                    "Unprocessed and incomplete repeat case (pending KYC documents, screening done and RA pending)",
                    "Others"
                ],

                async init() {
                    await this.loadData();
                },

                async loadData() {
                    try {
                        const response = await fetch(`/notepadv2/search?search=${encodeURIComponent(this.searchQuery)}&page=1`);
                        const result = await response.json();
                        this.rows = result.data.map(r => ({
                            ...r,
                            case_type: (r.case_type || '').trim(),
                            cust_type_realestate: (r.cust_type_realestate || '').trim(),
                            isEditing: false,
                            isSaving: false,
                            isNew: false,
                            isWdsLocked: (r.case_type || '').trim() === "New Unprocessed Main Party Cases – None of EID / PP / TL Available"
                        }));
                    } catch (error) {
                        toastr.error("Failed to load data");
                    }
                },

                formatDate(date) {
                    if (!date) return '-';
                    const d = new Date(date);
                    if (isNaN(d.getTime())) return '-';
                    const day = String(d.getDate()).padStart(2, '0');
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const year = d.getFullYear();
                    return `${day}/${month}/${year}`;
                },

                initDatePicker(el, row) {
                    flatpickr(el, {
                        dateFormat: "d/m/Y",
                        defaultDate: row.date_of_receipt ? new Date(row.date_of_receipt) : new Date(),
                        onChange: (selectedDates, dateStr) => {
                            // Store in ISO format for backend
                            const d = selectedDates[0];
                            row.date_of_receipt = d.toISOString().split('T')[0];
                        }
                    });
                },

                performSearch() {
                    this.loadData();
                },

                resetFilters() {
                    this.searchQuery = '';
                    this.loadData();
                },

                addNewRow() {
                    const newRow = {
                        id: 0,
                        date_of_receipt: new Date().toISOString().split('T')[0],
                        case_type: '',
                        cust_type: '',
                        wds_cust_id: '',
                        unit_ref_no: '',
                        customer_name: '',
                        comment_kyc: '',
                        cust_type_realestate: '',
                        isEditing: true,
                        isSaving: false,
                        isNew: true,
                        isWdsLocked: false
                    };
                    this.rows.unshift(newRow);
                },

                onCaseTypeChange(row) {
                    const type = (row.case_type || '').trim();
                    row.isWdsLocked = type === "New Unprocessed Main Party Cases – None of EID / PP / TL Available";
                    if (row.isWdsLocked) {
                        row.wds_cust_id = 'NA'; 
                    }
                },

                editRow(row) {
                    // Ensure date is in a format that flatpickr can handle if needed
                    // Alpine's x-model should work fine, but we toggle state here
                    this.rows.forEach(r => { if(r.id !== row.id) r.isEditing = false; }); // Optional: only one row at a time
                    row.isEditing = true;
                },

                async exportToExcel() {
                    try {
                        toastr.info("Generating Excel...");
                        window.location.href = `/notepadv2/Export?search=${encodeURIComponent(this.searchQuery)}`;
                    } catch (error) {
                        toastr.error("Export failed");
                    }
                },

                async saveAll() {
                    const modifiedRows = this.rows.filter(r => r.isEditing || r.id === 0);
                    if (modifiedRows.length === 0) {
                        toastr.info("No changes to save");
                        return;
                    }

                    let successCount = 0;
                    for (const row of modifiedRows) {
                        if (!row.customer_name) {
                            toastr.warning(`Skipping record: Customer Name is required`);
                            continue;
                        }
                        
                        row.isSaving = true;
                        const endpoint = row.id === 0 ? '/notepadv2/Create' : '/notepadv2/Update';
                        
                        try {
                            const response = await fetch(endpoint, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(row)
                            });
                            const result = await response.json();
                            if (result.success) successCount++;
                        } catch (e) {
                            console.error(e);
                        } finally {
                            row.isSaving = false;
                        }
                    }

                    if (successCount > 0) {
                        toastr.success(`${successCount} records saved successfully`);
                        await this.loadData();
                    } else if (modifiedRows.length > 0) {
                        toastr.error("Failed to save records");
                    }
                },

                async saveRow(row) {
                    if (!row.customer_name) {
                        toastr.error("Customer Name is required");
                        return;
                    }

                    row.isSaving = true;
                    const endpoint = row.id === 0 ? '/notepadv2/Create' : '/notepadv2/Update';
                    
                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(row)
                        });

                        const result = await response.json();
                        if (result.success) {
                            toastr.success(row.id === 0 ? "Record created" : "Record updated");
                            await this.loadData();
                        } else {
                            toastr.error("Action failed");
                        }
                    } catch (error) {
                        toastr.error("Network error");
                    } finally {
                        row.isSaving = false;
                    }
                },

                confirmDelete(id) {
                    if (id === 0) {
                        this.rows = this.rows.filter(r => r.id !== 0);
                        return;
                    }
                    this.idToDelete = id;
                    this.showDeleteModal = true;
                },

                async executeDelete() {
                    if (!this.idToDelete) return;
                    
                    try {
                        const response = await fetch(`/notepadv2/Delete?id=${this.idToDelete}`, {
                            method: 'POST'
                        });
                        const result = await response.json();

                        if (result.success) {
                            toastr.success("Record deleted");
                            this.rows = this.rows.filter(r => r.id !== this.idToDelete);
                            this.showDeleteModal = false;
                        } else {
                            toastr.error("Deletion failed");
                        }
                    } catch (error) {
                        toastr.error("Network error");
                    } finally {
                        this.idToDelete = null;
                    }
                }
            }
        }
    </script>
}