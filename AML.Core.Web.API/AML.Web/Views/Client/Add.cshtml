        <script>
            function fnSubmit() {
                $(".se-pre-con").show();
            }
            function AddRight(){

            }
            $('#frmDocument').submit(function (e) {

                    e.preventDefault();

                    $('#loader').show();

                    let isValid = true;

                    const requiredFields = [
                        { id: '#txtClientName', name: 'Client Name' },
                        { id: '#txtPrefix', name: 'Prefix' },
                        { id: '#txtDescription', name: 'Description' },
                        { id: '#txtC6Username', name: 'C6 Username' },
                        { id: '#txtC6BaseUrl', name: 'C6 Base API Url' },
                        { id: '#txtThreshold', name: 'Threshold' },
                        { id: '#txtComplem', name: 'Compliance Officer Email' }
                    ];

                    for (let i = 0; i < requiredFields.length; i++) {

                        let field = requiredFields[i];
                        let val = $(field.id).val();

                        if (!val || val.trim() === '') {

                            $(field.id).addClass('border-red-500').focus();

                            toastr.error(field.name + " is required");

                            isValid = false;
                            break;
                        }
                        else {
                            $(field.id).removeClass('border-red-500');
                        }
                    }

                    if (!isValid) {
                        $('#loader').hide();
                        return false;
                    }

                    // File validation only in create mode
                    if ($('#hdnClientId').val() == 0 && $('#txtFile')[0].files.length === 0) {

                        $('#txtFile').addClass('border-red-500').focus();
                        toastr.error("Please upload document");

                        $('#loader').hide();
                        return false;
                    }

                    var formdata = new FormData();

                    formdata.append('ClientId', $('#hdnClientId').val());
                    formdata.append('ClientName', $('#txtClientName').val());
                    formdata.append('Prefix', $('#txtPrefix').val());
                    formdata.append('Description', $('#txtDescription').val());
                    formdata.append('Document', $('#txtFile')[0].files[0]);
                    formdata.append('C6Username', $('#txtC6Username').val());
                    formdata.append('C6BaseUrl', $('#txtC6BaseUrl').val());
                    formdata.append('Threshold', $('#txtThreshold').val());
                    formdata.append('Complem', $('#txtComplem').val());
                    formdata.append('ApplicationStartDate', $('#Appstartdt').val());
                    formdata.append('ApplicationEndDate', $('#Appenddt').val());
                    formdata.append('SearchCount', $('#searchcount').val());

                    $.ajax({
                        url: '/client/create',
                        type: 'post',
                        data: formdata,
                        contentType: false,
                        processData: false,

                        success: function (res) {

                            $('#loader').hide();
                            console.log(res);
                            clearDocuemnt();
                            if(res.success == true){
                                toastr.success(res.message);
                                 setTimeout(function () {
                                window.location.href = "/AdminManagement";
                            }, 1200);
                            }else{
                                toastr.error(res.message);
                            }

                           
                        },

                        error: function () {
                            $('#loader').hide();
                            toastr.error("Something went wrong");
                        }
                    });

                });
            function clearDocuemnt() {
                $('#frmDocument').find("input[type=text], textarea").val("");
                $('#frmDocument').find("input[type=file]").val(null);
                $('#frmDocument').find("input[type=date]").val("");
                $('#frmDocument').find("select").val(0);
            }
                        document.getElementById("txtThreshold").addEventListener("input", function () {
