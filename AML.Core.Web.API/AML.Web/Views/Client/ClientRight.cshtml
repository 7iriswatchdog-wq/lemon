@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Client Rights";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

@model AML.ViewModel.ViewModels.Common.MenuModel
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<style>
    /* ul li {
        list-style-type: none;
    }

    ul {
        display: inline-block;
    } */

    .page {
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border-bottom: 1px solid #dee2e6;
    }

    .heading, .menu-icon, .md.block {
        min-width: 0; /* allows shrinking */
        flex-shrink: 1; /* enables shrinking */
    }

    .heading {
        font-size: 1.25rem;
    }

    .card1 {
        max-width: 100%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
        box-shadow: 0 0 #0000, /* fallback ring-offset-shadow */
        0 0 #0000, /* fallback ring-shadow */
        0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .go {
        background-color: rgb(37,99,235);
        border-radius: 8px;
        padding: 8px 20px;
        color: white;
    }

    .clear {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    .flex-box1 {
        display: flex;
        width: 90%;
        justify-content: space-between !important;
        flex-wrap: wrap;
    }

    .flex-box {
        width: 40%;
        display: flex;
        flex-wrap: wrap;
        margin: 10px 0px;
    }

        .flex-box > .flex-item {
            flex: 1 1 250px;
            text-align: center;
        }

    .flex-row {
        display: flex;
        gap: 20px; /* spacing between the two columns */
    }

    .menu-column {
        display: flex;
        flex-wrap: wrap;
        gap: 20px; /* spacing between items */
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .menu-column li {
            width: calc(50% - 10px); /* two items per row with gap */
        }

    @@media (max-width: 768px) {
        .page {
            width: 80vw;
        }
    }
</style>

<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>
<script src="~/plugins/jquery/jquery.min.js"></script>
<div class="page bg-gray-50">
    <div class="custom-container">


        @*<div class="page-heading ">
        <div class="sas-card rounded-card br-10 mb-2 bg-blue head-section">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0 heading"><b>Rights</b></h4>
                <div class="menu-icon">
                    <i class="lni lni-microsoft"></i>
                </div>
            </div>
            <div class="md:block">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>*@
    </div>
    <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-white">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                Rights
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>
    <div class="sas-card rounded-card mb-2 bg-blue card1 relative">
        <div id="loader" class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        </div>
        <form role="form" asp-controller="UserGroup" asp-action="GroupRight" class="form-horizontal" enctype="multipart/form-data" method="post">
            <div class="flex lg:flex-row flex-col items-center justify-between mb-6">
                <h6 class="text-xl font-semibold text-gray-900 mb-4">@Model?.ClientName</h6>
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <button type="submit" id="btnSave" class="px-6 py-2 bg-[#2563EB] text-white rounded-md hover:bg-blue-700" onclick="$('#loader').show();">Save</button>
                    <button type="button" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100 text-center transition duration-200" onclick="$('#loader').show(); location.href='/AdminManagement/Index'">Cancel</button>
                </div>
            </div>

            @* <div class="d-flex justify-content-between align-items-center flex-box1">
                <h6 class="mb-0 flex-item"><label><b>@Model.ClientName</b></label></h6>
                <div class="float-right flex-tem">
                    <button type="submit" id="btnSave" class="sas-button p-8-25 color-white bg-color-2 go" onclick="$('#loader').show();">Save</button>
                    <button type="button" class="sas-button p-8-25 bg-color-3 ml-3 clear" onclick="$('#loader').show(); location.href='@Url.Action("Index", "Client")'">Cancel</button>
                </div>
            </div> *@
            <div class="card-body">
                <div>
                    <input type="hidden" asp-for="ClientId" id="txtClientId" />
                    @if (Model != null)
                    {
                        <div class="">
                            <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 list-none p-0">
                                @for (int i = 0; i < Model.MenuModels.Count(); i++)
                                {

                                    <li>
                                        <div class="form-group clearfix">
                                            <div class="icheck-primary d-inline">
                                                <input name="MenuId" id="@Model.MenuModels[i].Menu_Name@i" type="checkbox" value="@Model.MenuModels[i].Menu_Id" checked="@Model.MenuModels[i].isChecked" />
                                                <label for="@Model.MenuModels[i].Menu_Name@i">@Model.MenuModels[i].Menu_Name</label>
                                                <br>
                                            </div>
                                        </div>
                                    </li>

                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

        </form>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('form').submit(function (event) {
            console.log("Im clicked");
            var MenuIds = [];
            $("input:checkbox[name='MenuId']:checked").each(function () {
                MenuIds.push($(this).val());
            });
            var clientRights = { ClientId: $('#txtClientId').val(), MenuIds: MenuIds };
            $.ajax({
                type: 'POST',
                url: '/client/ClientRight',
                data: clientRights,
                dataType: 'json'
            }).done(function (data) {
                $('#loader').hide();
                toastr.success('Client rights updated successfully');
                setTimeout(() => {
                    window.location.href = '/AdminManagement/Index';
                }, 1500);
            }
            );

            event.preventDefault();
        });
    });
</script>














