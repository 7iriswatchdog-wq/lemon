@{
    ViewData["Title"] = "Bulk Upload Logs";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
<script src="~/plugins/jquery/jquery.min.js"></script>
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.js"></script>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Logs</h3>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-4">
                                    <label>Date From</label>
                                    <input type="date" id="txtFromDate" class="form-control" max="3000-12-31" placeholder="Date From" />
                                </div>
                                <div class="col-sm-4">
                                    <label>Date To</label>
                                    <input type="date" id="txtToDate" class="form-control" max="3000-12-31" placeholder="Date To" />
                                </div>
                                <div class="col-sm-1"style="padding-top: 32px;">
                                    <button type="submit" id ="btnLog"class="btn btn-primary float-right">Search</button>
                                </div>
                            </div>
                        </form>
                        <br />
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div style="width: 100%; padding-left: -10px;">
                                            <div class="table-responsive">
                                                <table id="etlLogs" class="table table-striped table-hover dt-responsive display nowrap" cellspacing="0">
                                                    <thead>
                                                        <tr>
                                                            <th>Total Rows</th>
                                                            <th>Rows Recorded</th>
                                                            <th>File Name</th>
                                                            <th>Upload Time</th>
                                                            <th>User</th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">
    var table;
    $(document).ready(function () {
        $('form').submit(function (event) {
            $.fn.dataTable.ext.legacy.ajax;
            table = $('#etlLogs').DataTable({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "destroy": true,
                ajax: {
                    url: '/etl/custompagination',
                    type: 'POST',
                    "data": function (d) {
                        d.fromdate = $('#txtFromDate').val();
                        d.todate = $('#txtToDate').val();
                    }
                },
                columns: [
                    { data: "totalRows" },
                    { data: "rowsRecorded" },
                    { data: "fileName" },
                    { data: "addedOn" },
                    { data: "addedUser" },
                ]
            });
            event.preventDefault();
        });
    });
</script>















