@{
    ViewData["Title"] = "Bulk Upload Logs";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
<script src="~/plugins/jquery/jquery.min.js"></script>
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
    body { font-family: 'Inter', sans-serif !important; }
</style>
<section class="content">
    <div id="loader" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-50 hidden">
        <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
    </div>
    <style>
        .dt-loader { position: relative; width: 80px; height: 20px; }
        .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0,1,1,0); }
        .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
        .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
        .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
        .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
        @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
        @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
        @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }
    </style>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="bg-surface rounded-xl border border-bordercolor shadow-none mb-4">
                    <div class="px-6 py-4 border-b border-bordercolor">
                        <h3 class="card-title">Logs</h3>
                    </div>
                    <div class="p-6">
                        <form>
                            <div class="row">
                                <div class="col-sm-4">
                                    <label>Date From</label>
                                    <input type="date" id="txtFromDate" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" max="3000-12-31" placeholder="Date From" />
                                </div>
                                <div class="col-sm-4">
                                    <label>Date To</label>
                                    <input type="date" id="txtToDate" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" max="3000-12-31" placeholder="Date To" />
                                </div>
                                <div class="col-sm-2 flex items-end gap-2" style="padding-top: 32px;">
                                    <button type="submit" id="btnLog" class="btn btn-primary">Search</button>
                                    
                                    <div class="relative inline-block text-left group">
                                        <button type="button" class="flex items-center gap-2 border border-bordercolor bg-surface hover:bg-appbg text-textlabel font-semibold h-[38px] px-4 rounded-md text-sm transition focus:outline-none shadow-sm">
                                            <i data-lucide="download" class="h-4 w-4"></i>
                                            Export
                                            <i data-lucide="chevron-down" class="h-4 w-4"></i>
                                        </button>
                                        <div class="absolute right-0 z-10 mt-2 w-40 origin-top-right rounded-md bg-surface shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200" role="menu" aria-orientation="vertical">
                                            <div class="py-1" role="none">
                                                <button type="button" onclick="ExportList(true);" class="w-full text-left block px-4 py-2 text-sm text-textlabel hover:bg-slate-100 transition flex items-center gap-2" role="menuitem">
                                                    Export PDF
                                                </button>
                                                <button type="button" onclick="ExportList(false);" class="w-full text-left block px-4 py-2 text-sm text-textlabel hover:bg-slate-100 transition flex items-center gap-2" role="menuitem">
                                                    Export CSV
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <br />
                        <div class="row">
                            <div class="col-12">
                                <div class="bg-surface rounded-xl border border-bordercolor shadow-none mb-4">
                                    <div class="p-6">
                                        <div style="width: 100%; padding-left: -10px;">
                                            <div class="table-responsive">
                                                <table id="etlLogs" class="w-full text-sm text-left" cellspacing="0">
                                                    <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                                                        <tr>
                                                            <th>Total Rows</th>
                                                            <th>Rows Recorded</th>
                                                            <th>File Name</th>
                                                            <th>Upload Time</th>
                                                            <th>User</th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    <iframe id="pdfExportFrame" style="position: absolute; left: -9999px; visibility: hidden; width: 1024px; height: 100%;"></iframe>
</section>
<script type="text/javascript">
    var table;
    $(document).ready(function () {
        lucide.createIcons();
        $('form').submit(function (event) {
            $.fn.dataTable.ext.legacy.ajax;
            table = $('#etlLogs').DataTable({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                //"orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "bSort": false,
                "destroy": true,
                ajax: {
                    url: '/etl/custompagination',
                    type: 'POST',
                    "data": function (d) {
                        d.fromdate = $('#txtFromDate').val();
                        d.todate = $('#txtToDate').val();
                    }
                },
                columns: [
                    { data: "totalRows" },
                    { data: "rowsRecorded" },
                    { data: "fileName" },
                    { data: "addedOn" },
                    { data: "addedUser" },
                ]
            });
            event.preventDefault();
        });
    });

    function ExportList(isPDF) {
        const fromDate = $('#txtFromDate').val();
        const toDate = $('#txtToDate').val();
        const searchValue = $('.dataTables_filter input').val() || '';

        if (isPDF) {
            $('#loader').removeClass('hidden').addClass('flex');
            const url = `/Etl/BulkUploadLogs_PDF?fromdate=${fromDate}&todate=${toDate}&searchValue=${searchValue}`;
            $('#pdfExportFrame').attr('src', url);
        } else {
            const url = `/Etl/BulkUploadLogs_CSV?fromdate=${fromDate}&todate=${toDate}&searchValue=${searchValue}`;
            window.location.href = url;
        }
    }
</script>















