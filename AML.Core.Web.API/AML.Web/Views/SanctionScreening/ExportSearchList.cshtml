@model List<AML.ViewModel.ViewModels.Sanction.ApiResultModel>

<div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
        <thead>
            <tr>
                <th>#</th>
                <th>NAME</th>
                <th>SCORE</th>
                <th>UID</th>
                <th>CATEGORY</th>
                <th>TYPE</th>
                <th>NATIONALITY</th>
                <th>ID NUMBER</th>
                <th>DOB</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
            <tr>
                <td>@(i+1)</td>
                <td>@Model[i].matchname</td>
                <td>@Model[i].matchscore</td>
                <td>@Model[i].matchuid</td>
                <td>@Model[i].matchcategory</td>
                <td>@Model[i].matchtype</td>
                <td>@Model[i].matchnationality</td>
                <td>@Model[i].matchidnumber</td>
                <td>@Model[i].matchdob</td>
            </tr>
            }

        </tbody>
    </table>
</div>