        function exportToCSV() {
            let data = [];
            let headers = [];
            let fileName = '';

            if (activeTable === 'table1') {
                data = filteredData1;
                headers = ['Type', 'Category', 'Name', 'Nationality', 'DOB', 'Score', 'Id No'];
                fileName = 'SearchResults.csv';
            } else if (activeTable === 'table2') {
                data = filteredData2;
                headers = ['Searched On', 'Customer Type', 'Customer Name', 'Nationality', 'DOB', 'Searched By'];
                fileName = 'SearchLogs.csv';
            } else {
                data = filteredData3;
                headers = ['Customer Id', 'Created On', 'Updated On', 'Customer Type', 'Customer Name', 'Case Status', 'Screening Score', 'Risk Rating', 'User', 'Status'];
                fileName = 'CaseLogs.csv';
            }

            if(data.length === 0) return;

            let csvContent = "data:text/csv;charset=utf-8," + headers.join(",") + "\n";
            data.forEach(row => {
                let rowData = [];
                if (activeTable === 'table1') {
                    rowData = [row.matchtype, row.matchcategory, row.matchname, row.matchnationality, formatDateTime1(row.matchdob), row.matchscore, row.matchidnumber];
                } else if (activeTable === 'table2') {
                    rowData = [formatDateString(row.CreatedOn), row.CustomerType, row.CustomerName, row.Nationality, row.dob, row.CreatedUser];
                } else {
                    rowData = [row.CustomerId, formatDateString(row.CreatedOn), formatDateString(row.UpdatedOnDB), row.CustomerType, `${row.FirstName || ''} ${row.LastName || ''}`.trim(), row.CaseChangeStatus, row.MatchScore, row.riskScore, row.CreatedUser, row.CaseStatus];
                }
                
                rowData = rowData.map(v => v ? '"' + String(v).replace(/"/g, '""') + '"' : '');
                csvContent += rowData.join(",") + "\n";
            });

            var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", fileName);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

