                                            hidden group-hover:flex gap-2
                                            bg-white p-2 rounded-lg shadow-lg border z-50">

                                                <span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                       A:${auto}
