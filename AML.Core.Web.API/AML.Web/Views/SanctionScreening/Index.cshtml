<script type="text/javascript">
           document.getElementById("sanctionScreening").addEventListener("submit", function (e) {

        let name = document.getElementById("name").value.trim();
        let customerType = document.getElementById("customertype").value;

        let isValid = true;

            document.getElementById("nameError").classList.add("invisible");
    document.getElementById("typeError").classList.add("invisible");

        if (!name) {
                document.getElementById("nameError").classList.remove("invisible");
            isValid = false;
        }

        if (!customerType || customerType === "0") {
                document.getElementById("typeError").classList.remove("invisible");
            isValid = false;
        }

        // ❌ STOP completely if invalid
        if (!isValid) {
            e.preventDefault();
            e.stopImmediatePropagation(); // 🔥 important
            return;
        }

        // ✅ Only runs when valid
        $('#loadingCaseDetails').removeClass('hidden').addClass('flex');
    });
     lucide.createIcons();
              

        let rawData1 = @Html.Raw(JsonConvert.SerializeObject(Model.DataList ?? new List<ApiResultModel>()));

        console.log("rawData1",rawData1);
        let rawData2 = @Html.Raw(JsonConvert.SerializeObject(Model.SearchLogs ?? new List<SanctionScreeningLogModel>()));
        console.log("rawData2",rawData2);
        let rawData3 = @Html.Raw(JsonConvert.SerializeObject(Model.CaseLogs ?? new List<CaseModel>()));
console.log("rawData3",rawData3);

        let filteredData1 = [];
        let filteredData2 = [];
            let filteredData3 = [];

        let currentPage = 1;
        let size = 10;

        let activeTable = 'table1';
        let sortCol = -1;
        let sortAsc = true;

        $(document).ready(function () {
            const savedSize = localStorage.getItem('pageSize');
            if (savedSize) {
                size = parseInt(savedSize);
                $('#pageSize').val(savedSize);
            }

            // Clear search fields if data is populated
            if (rawData1.length > 0) {
                $('#name').val('');
                $('#nationality').val('');
                $('#customertype').val('0');
                if (document.querySelector("#DOB") && document.querySelector("#DOB")._flatpickr) {
                    document.querySelector("#DOB")._flatpickr.clear();
                } else {
                    $('#DOB').val('');
                }
            }

            loadData1();
        });

        // function showLoader() {
        //     $('#loadingCaseDetails').removeClass('hidden').addClass('flex');
        // }

        function clearFilters() {
            $('#name').val('');
            $('#nationality').val('');
            $('#customertype').val('0');
            if (document.querySelector("#DOB") && document.querySelector("#DOB")._flatpickr) {
                document.querySelector("#DOB")._flatpickr.clear();
            } else {
                $('#DOB').val('');
            }
            $('#searchInput').val('');

            // Clear local data
            rawData1 = [];
            rawData2 = [];
            rawData3 = [];
            filteredData1 = [];
            filteredData2 = [];
            filteredData3 = [];

            // Reset to Search Results tab
            const btn1 = document.querySelectorAll('.nav-btn')[0];
            if(btn1) showTable('table1', btn1);

            currentPage = 1;
                const noDataRow = `<tr>
        <td colspan="9" class="h-24 text-center">
            <div class="text-slate-500">No results found.</div>
        </td>
    </tr>`;
                $('#table1Body').html(noDataRow);
                $('#table2Body').html(noDataRow);
                $('#table3Body').html(noDataRow);
            updatePagination(0);
        }

        /* Table 1 Data */
        function loadData1() {
            activeTable = 'table1';
            let searchVal = $('#searchInput').val()?.toLowerCase() || '';

            filteredData1 = rawData1.filter(x =>
                !searchVal ||
                (x.matchname && x.matchname.toLowerCase().includes(searchVal)) ||
                (x.matchtype && x.matchtype.toLowerCase().includes(searchVal)) ||
                (x.matchnationality && x.matchnationality.toLowerCase().includes(searchVal)) ||
                (x.matchidnumber && String(x.matchidnumber).toLowerCase().includes(searchVal)) ||
                (x.matchcategory && x.matchcategory.toLowerCase().includes(searchVal))
            );

            if (sortCol >= 0) {
                filteredData1.sort((a,b) => {
                    let v1 = sortCol === 0 ? a.matchname : sortCol === 1 ? a.matchtype : a.matchtype;
                    let v2 = sortCol === 0 ? b.matchname : sortCol === 1 ? b.matchtype : b.matchtype;
                    return sortAsc ? String(v1).localeCompare(String(v2)) : String(v2).localeCompare(String(v1));
                });
            }

            renderTable();
        }

        /* Table 2 Data */
        function loadData2() {
            activeTable = 'table2';
            let searchVal = $('#searchInput').val()?.toLowerCase() || '';

            filteredData2 = rawData2.filter(x =>
                !searchVal ||
                (x.CustomerName && String(x.CustomerName).toLowerCase().includes(searchVal)) ||
                (x.Nationality && String(x.Nationality).toLowerCase().includes(searchVal)) ||
                (x.CustomerType && String(x.CustomerType).toLowerCase().includes(searchVal))
            );

            if (sortCol >= 0) {
                filteredData2.sort((a,b) => {
                    let keys = ['slno','customerId','firstName','nationality','dob','isMatched','source','uid','createdOnDB'];
                    let v1 = a[keys[sortCol]];
                    let v2 = b[keys[sortCol]];
                    return sortAsc ? String(v1).localeCompare(String(v2)) : String(v2).localeCompare(String(v1));
                });
            }

            renderTable();
        }
            function loadData3() {
                activeTable = 'table3';
                let searchVal = $('#searchInput').val()?.toLowerCase() || '';

                filteredData3 = rawData3.filter(x =>
                    !searchVal ||
                    (x.CustomerId && String(x.CustomerId).toLowerCase().includes(searchVal)) ||
                    (x.FirstName && String(x.FirstName).toLowerCase().includes(searchVal)) ||
                    (x.LastName && String(x.LastName).toLowerCase().includes(searchVal)) ||
