@using AML.ViewModel.ViewModels.Sanction
@using AML.ViewModel.ViewModels.CustomerCase
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Customer Upload (Bulk Upload Listing)";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = Context.Session.GetString("SessLogoUrl");
    var companyName = Context.Session.GetString("SessCompanyName");
    var clientId = Context.Session.GetString("SessClientId");
    var currentUserName = Context.Session.GetString("SessUsername");
}

@model AML.ViewModel.ViewModels.Sanction.ScreeningSearchModel

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Upload - Search</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .screening-overlay {
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
        }

        .screening-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 28px 36px 24px;
            min-width: 320px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            font-family: 'Inter', sans-serif;
        }

        .screening-radar {
            position: relative;
            width: 92px;
            height: 92px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 6px;
        }

            .screening-radar .radar-ring {
                position: absolute;
                inset: 0;
                border-radius: 50%;
                border: 2px solid #2563eb;
                opacity: 0;
                animation: screening-pulse 1.4s ease-out infinite;
            }

                .screening-radar .radar-ring.delay-1 {
                    animation-delay: 0.45s;
                }

                .screening-radar .radar-ring.delay-2 {
                    animation-delay: 0.9s;
                }

            .screening-radar .radar-core {
                position: relative;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: #2563eb;
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 6px 16px rgba(37, 99, 235, 0.45);
                animation: screening-bob 1.2s ease-in-out infinite;
            }

        .screening-title {
            font-size: 16px;
            font-weight: 600;
            color: #0f172a;
        }

        .screening-subtitle {
            font-size: 13px;
            color: #475569;
            min-height: 18px;
            transition: opacity 0.2s ease;
        }

        .screening-progress {
            margin-top: 6px;
            width: 240px;
            height: 4px;
            background: #e2e8f0;
            border-radius: 999px;
            overflow: hidden;
        }

            .screening-progress > span {
                display: block;
                height: 100%;
                width: 40%;
                background: linear-gradient(90deg, transparent, #2563eb 50%, transparent);
                border-radius: 999px;
                animation: screening-slide 1.1s linear infinite;
            }

        @@keyframes screening-pulse {
            0% {
                transform: scale(0.55);
                opacity: 0.8;
            }
            80% {
                opacity: 0;
            }
            100% {
                transform: scale(1.4);
                opacity: 0;
            }
        }

        @@keyframes screening-bob {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.06);
            }
        }

        @@keyframes screening-slide {
            0% {
                transform: translateX(-120%);
            }
            100% {
                transform: translateX(320%);
            }
        }

        th.sortable {
            cursor: pointer;
            position: relative;
            padding-right: 20px;
        }

            th.sortable::after {
                content: "▲\A▼";
                white-space: pre;
                font-size: 10px;
                position: absolute;
                right: 6px;
                top: 50%;
                transform: translateY(-50%);
                color: #bbb;
                line-height: 1;
                text-align: center;
            }

            th.sortable.active.asc::after {
                content: "▲";
                color: #000;
            }

            th.sortable.active.desc::after {
                content: '\A▼';
                color: #000;
            }

        .flatpickr-wrapper {
            width: 100% !important;
        }

        .flatpickr-alt-input {
            width: 100% !important;
            display: block !important;
        }
    </style>
</head>

<body class="bg-appbg min-h-screen text-textprimary">

    <div class="p-8 space-y-8 max-w-[1600px] mx-auto">
        <div class="flex items-center gap-2 text-textmuted text-xs mb-2">
            <span class="text-textprimary font-medium">Reports</span>
            <i data-lucide="chevron-right" class="h-3 w-3"></i>
            <span class="text-textprimary font-medium">UAEIEC UN NAS Match</span>
        </div>

        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-textprimary tracking-tight">UAEIEC UN NAS Match</h1>
            </div>
            @* <div class="text-sm md:text-base text-right flex items-center gap-3">
                <img  alt="Client Logo" width="50" class="rounded-sm shadow-sm border border-bordercolor" />
            </div> *@
        </div>

        <!-- Form for API Submission -->
        <form id="sanctionScreening" role="form" asp-action="SearchList" asp-controller="SanctionScreening" class="form-horizontal" enctype="multipart/form-data" method="post">
            
            
            <!-- Filters Section -->
            <div class="bg-surface rounded-xl border border-bordercolor p-5 shadow-sm">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-lg font-semibold text-textprimary tracking-tight">Search</h3>
                    <button type="button" onclick="clearFilters()" id="resetBtn" class="bg-surface hover:bg-appbg border border-bordercolor text-textlabel font-medium h-12 px-6 rounded-lg text-[14px] transition-colors">
                        Reset
                    </button>
                </div>
 
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <!-- Customer -->
                    <div class="space-y-1">
                        <label class="text-[13px] font-medium text-textlabel">Name <span class="text-danger">*</span></label>
                        <input type="text" id="name" placeholder="Customer" asp-for="Name" class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors">
                        <span id="nameError" class="text-danger text-[12px] h-4 block invisible">Name is required</span>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[13px] font-medium text-textlabel">Nationality</label>
                        <select id="nationality" asp-items="@Model.Nationalities" asp-for="Nationality"
                                class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors">
                            <option value="">--SELECT--</option>
                        </select>
                        <span id="Nationalityerror" class="text-danger text-[12px] h-4 block invisible"></span>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[13px] font-medium text-textlabel">Date Of Birth</label>
                        <input type="text" id="DOB" name="dob"
                               placeholder="dd/MM/yyyy"
                               class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors">
                        <span id="formattedEndDate" hidden></span>
                        <span id="doberror" class="text-danger text-[12px] h-4 block invisible"></span>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[13px] font-medium text-textlabel">Customer Type <span class="text-danger">*</span></label>
                        <select id="customertype" asp-items="@Model.CustomerCategories" asp-for="customerType"
                                class="h-12 w-full rounded-lg border border-bordercolor px-3 text-[14px] focus:border-primary focus:ring focus:ring-primary-light transition-colors">
                            <option value="0">--SELECT--</option>
                        </select>
                        <span id="typeError" class="text-danger text-[12px] h-4 block invisible">Customer Type is required</span>
                    </div>
                </div>

                <div class="mt-5 flex items-center justify-end gap-3 w-full">
                    <!-- Submit Form button representing existing API behavior -->
                    <button type="submit" id="btnSearch" onclick="showLoader()" class="flex items-center gap-2 bg-primary hover:bg-primary-hover text-white font-medium h-12 px-6 rounded-lg text-[14px] transition-colors shadow-none">
                        Search
                    </button>
                </div>
            </div>
        </form>
        <input id="hdnBatchId" type="hidden" />

        <!-- Table UI -->
        <div class="space-y-4">

            <div class="flex items-center gap-4 border-b border-bordercolor pb-2">
                <button type="button" onclick="showTable('table1', this)" class="nav-btn font-semibold text-sm pb-2 border-b-2 border-blue-600 text-primary">Search Results</button>
                <button type="button" onclick="showTable('table2', this)" class="nav-btn font-semibold text-sm pb-2 border-b-2 border-transparent text-textmuted hover:text-textlabel">Search History</button>
                <button type="button" onclick="showTable('table3', this)" class="nav-btn font-semibold text-sm pb-2 border-b-2 border-transparent text-textmuted hover:text-textlabel">Existing Case Match</button>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
                <!-- Search -->
                <div class="relative flex-1 w-full">
                    <i data-lucide="search" class="absolute left-3.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-textmuted"></i>
                    <input type="text" id="searchInput" placeholder="Search by Customer Name/ID" onkeyup="filterTableActive()"
                           class="pl-10 h-12 w-full rounded-lg border border-bordercolor bg-surface px-3 py-2 text-[14px] focus:outline-none focus:border-primary focus:ring focus:ring-primary-light shadow-none transition-colors placeholder:text-textmuted">
                </div>
                <iframe id="pdfFrame" style="position: fixed; top: 0; left: -9999px; width: 1200px; height: 100vh; border: none; opacity: 0; pointer-events: none;"></iframe>
                
                <!-- Standardized Export Button -->
                <button type="button" onclick="showExportOptions()" class="flex items-center gap-2 border border-bordercolor bg-surface hover:bg-appbg text-textlabel font-medium h-12 px-5 rounded-lg text-[14px] transition-colors focus:outline-none shadow-none">
                    <i data-lucide="download" class="h-4 w-4"></i>
                    Export
                </button>
            </div>

            <div class="bg-surface rounded-lg border border-bordercolor shadow-none overflow-hidden">
                <!-- Table 1: File Details -->
                <div id="table1-container" class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap dataTable">
                        <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                            <tr>
                                <th class="px-4 py-3 font-medium">Searched On</th>
                                <th class="px-4 py-3 font-medium text-right">Datasets</th>
                                <th class="px-4 py-3 font-medium">Customer Type</th>
                                <th class="px-4 py-3 font-medium">Customer Name</th>
                                <th class="px-4 py-3 font-medium">Nationality</th>
                                <th class="px-4 py-3 font-medium">DOB</th>
                                <th class="px-4 py-3 font-medium text-right">Score</th>
                                <th class="px-4 py-3 font-medium">Searched By</th>
                            </tr>
                        </thead>
                        <tbody id="table1Body" class="divide-y divide-bordercolor" style="font-size: 14px;">
                        </tbody>
                    </table>
                </div>

                <!-- Table 2: Customer Details -->
                <div id="table2-container" class="overflow-x-auto hidden">
                    <table class="w-full text-sm text-left whitespace-nowrap dataTable">
                        <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                            <tr>
                                <th class="px-4 py-3 font-medium">Searched On</th>
                                <th class="px-4 py-3 font-medium text-right">Datasets</th>
                                <th class="px-4 py-3 font-medium">Customer Type</th>
                                <th class="px-4 py-3 font-medium">Customer Name</th>
                                <th class="px-4 py-3 font-medium">Nationality</th>
                                <th class="px-4 py-3 font-medium">DOB</th>
                                <th class="px-4 py-3 font-medium text-right">Score</th>
                                <th class="px-4 py-3 font-medium">Searched By</th>
                            </tr>
                        </thead>
                        <tbody id="table2Body" class="divide-y divide-bordercolor" style="font-size: 14px;">
                        </tbody>
                    </table>
                </div>
                <div id="table3-container" class="overflow-x-auto hidden">
                    <table class="w-full text-sm text-left whitespace-nowrap dataTable">
                        <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                            <tr>
                                <th class="px-4 py-3 font-medium">Customer Id</th>
                                <th class="px-4 py-3 font-medium">Created On</th>
                                <th class="px-4 py-3 font-medium">Updated On</th>
                                <th class="px-4 py-3 font-medium">Customer Type</th>
                                <th class="px-4 py-3 font-medium">Customer Name</th>
                                <th class="px-4 py-3 font-medium text-right">Datasets</th>
                                <th class="px-4 py-3 font-medium text-right">Screening Score</th>
                                <th class="px-4 py-3 font-medium text-center">Risk Rating</th>
                                <th class="px-4 py-3 font-medium">User</th>
                                <th class="px-4 py-3 font-medium text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="table3Body" class="divide-y divide-bordercolor" style="font-size: 14px;">
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="flex items-center justify-between px-4 py-4 border-t border-bordercolor bg-surface">
                    <div class="flex items-center gap-2 text-sm">
                        <select id="pageSize" class="h-8 rounded-md border border-bordercolor bg-surface px-2 pr-7 text-[14px]" onchange="changePageSize()">
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <label class="text-textmuted font-medium">Entries per page</label>
                    </div>
                    <div class="text-[14px] text-textmuted">
                        Showing <span id="showingStart" class="font-medium text-textprimary">0</span> to <span id="showingEnd" class="font-medium text-textprimary">0</span> of <span id="totalCases" class="font-medium text-textprimary">0</span> cases
                    </div>
                    <div class="flex items-center space-x-2">
                        <button id="prevBtn" onclick="previousPage()" title="Previous page" aria-label="Previous page" class="h-8 w-8 flex items-center justify-center text-[14px] font-medium border border-bordercolor bg-surface rounded-md text-textlabel disabled:opacity-50 disabled:cursor-not-allowed hover:bg-appbg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                        </button>
                        <button id="nextBtn" onclick="nextPage()" title="Next page" aria-label="Next page" class="h-8 w-8 flex items-center justify-center text-[14px] font-medium border border-bordercolor bg-surface rounded-md text-textlabel disabled:opacity-50 disabled:cursor-not-allowed hover:bg-appbg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="loadingCaseDetails"
         class="screening-overlay fixed inset-0 flex items-center justify-center z-[9999] hidden"
         role="status" aria-live="polite">
        <div class="screening-card">
            <div class="screening-radar" aria-hidden="true">
                <div class="radar-ring"></div>
                <div class="radar-ring delay-1"></div>
                <div class="radar-ring delay-2"></div>
                <div class="radar-core">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-3.5-3.5"></path>
                    </svg>
                </div>
            </div>
            <div class="screening-title">Screening in progress</div>
            <div class="screening-subtitle" id="screeningSubtitle">Checking sanctions watchlists…</div>
            <div class="screening-progress" aria-hidden="true"><span></span></div>
        </div>
    </div>
    <script>
        (function () {
            var messages = [
                'Checking sanctions watchlists…',
                'Scanning PEP databases…',
                'Reviewing adverse media…',
                'Matching identities…',
                'Compiling results…'
            ];
            var sub = document.getElementById('screeningSubtitle');
            var overlay = document.getElementById('loadingCaseDetails');
            if (!sub || !overlay) return;
            var i = 0;
            setInterval(function () {
                if (overlay.classList.contains('hidden')) return;
                i = (i + 1) % messages.length;
                sub.style.opacity = '0';
                setTimeout(function () {
                    sub.textContent = messages[i];
                    sub.style.opacity = '1';
                }, 180);
            }, 1300);
        })();
    </script>
</body>
</html>
<script type="text/javascript">
           document.getElementById("sanctionScreening").addEventListener("submit", function (e) {

        let name = document.getElementById("name").value.trim();
        let customerType = document.getElementById("customertype").value;

        let isValid = true;

            document.getElementById("nameError").classList.add("invisible");
    document.getElementById("typeError").classList.add("invisible");

        if (!name) {
                document.getElementById("nameError").classList.remove("invisible");
            isValid = false;
        }

        if (!customerType || customerType === "0") {
                document.getElementById("typeError").classList.remove("invisible");
            isValid = false;
        }

        // ❌ STOP completely if invalid
        if (!isValid) {
            e.preventDefault();
            e.stopImmediatePropagation(); // 🔥 important
            return;
        }

        // ✅ Only runs when valid
        $('#loadingCaseDetails').removeClass('hidden').addClass('flex');
    });
     lucide.createIcons();
              

        let rawData1 = @Html.Raw(JsonConvert.SerializeObject(Model.DataList ?? new List<ApiResultModel>()));

        console.log("rawData1",rawData1);
        let rawData2 = @Html.Raw(JsonConvert.SerializeObject(Model.SearchLogs ?? new List<SanctionScreeningLogModel>()));
        console.log("rawData2",rawData2);
        let rawData3 = @Html.Raw(JsonConvert.SerializeObject(Model.CaseLogs ?? new List<CaseModel>()));
console.log("rawData3",rawData3);

        let filteredData1 = [];
        let filteredData2 = [];
        let filteredData3 = [];

        const currentUserName = '@currentUserName';

        let currentPage = 1;
        let size = 10;

        let activeTable = 'table1';
        let sortCol = -1;
        let sortAsc = true;

        $(document).ready(function () {
            const savedSize = localStorage.getItem('pageSize');
            if (savedSize) {
                size = parseInt(savedSize);
                $('#pageSize').val(savedSize);
            }

            // Clear search fields if data is populated
            if (rawData1.length > 0) {
                $('#name').val('');
                $('#nationality').val('');
                $('#customertype').val('0');
                if (document.querySelector("#DOB") && document.querySelector("#DOB")._flatpickr) {
                    document.querySelector("#DOB")._flatpickr.clear();
                } else {
                    $('#DOB').val('');
                }
            }

            loadData1();
        });

        function showLoader() {
            $('#loadingCaseDetails').removeClass('hidden').addClass('flex');
        }

        function hideLoader() {
            $('#loadingCaseDetails').addClass('hidden').removeClass('flex');
        }

        function clearFilters() {
            $('#name').val('');
            $('#nationality').val('');
            $('#customertype').val('0');
            if (document.querySelector("#DOB") && document.querySelector("#DOB")._flatpickr) {
                document.querySelector("#DOB")._flatpickr.clear();
            } else {
                $('#DOB').val('');
            }
            $('#searchInput').val('');

            // Clear local data
            rawData1 = [];
            rawData2 = [];
            rawData3 = [];
            filteredData1 = [];
            filteredData2 = [];
            filteredData3 = [];

            // Reset to Search Results tab
            const btn1 = document.querySelectorAll('.nav-btn')[0];
            if(btn1) showTable('table1', btn1);

            currentPage = 1;
                const noDataRow = `<tr>
        <td colspan="9" class="h-24 text-center">
            <div class="text-textmuted">No results found.</div>
        </td>
    </tr>`;
                $('#table1Body').html(noDataRow);
                $('#table2Body').html(noDataRow);
                $('#table3Body').html(noDataRow);
            updatePagination(0);
        }

        /* Table 1 Data */
        function loadData1() {
            activeTable = 'table1';
            let searchVal = $('#searchInput').val()?.toLowerCase() || '';

            filteredData1 = rawData1.filter(x =>
                !searchVal ||
                (x.matchname && x.matchname.toLowerCase().includes(searchVal)) ||
                (x.matchtype && x.matchtype.toLowerCase().includes(searchVal)) ||
                (x.matchnationality && x.matchnationality.toLowerCase().includes(searchVal)) ||
                (x.matchidnumber && String(x.matchidnumber).toLowerCase().includes(searchVal)) ||
                (x.matchcategory && x.matchcategory.toLowerCase().includes(searchVal))
            );

            if (sortCol >= 0) {
                filteredData1.sort((a,b) => {
                    let v1 = sortCol === 0 ? a.matchname : sortCol === 1 ? a.matchtype : a.matchtype;
                    let v2 = sortCol === 0 ? b.matchname : sortCol === 1 ? b.matchtype : b.matchtype;
                    return sortAsc ? String(v1).localeCompare(String(v2)) : String(v2).localeCompare(String(v1));
                });
            }

            renderTable();
        }

        /* Table 2 Data */
        function loadData2() {
            activeTable = 'table2';
            let searchVal = $('#searchInput').val()?.toLowerCase() || '';

            filteredData2 = rawData2.filter(x =>
                !searchVal ||
                (x.CustomerName && String(x.CustomerName).toLowerCase().includes(searchVal)) ||
                (x.Nationality && String(x.Nationality).toLowerCase().includes(searchVal)) ||
                (x.CustomerType && String(x.CustomerType).toLowerCase().includes(searchVal))
            );

            if (sortCol >= 0) {
                filteredData2.sort((a,b) => {
                    let keys = ['slno','customerId','firstName','nationality','dob','isMatched','source','uid','createdOnDB'];
                    let v1 = a[keys[sortCol]];
                    let v2 = b[keys[sortCol]];
                    return sortAsc ? String(v1).localeCompare(String(v2)) : String(v2).localeCompare(String(v1));
                });
            }

            renderTable();
        }
            function loadData3() {
                activeTable = 'table3';
                let searchVal = $('#searchInput').val()?.toLowerCase() || '';

                filteredData3 = rawData3.filter(x =>
                    !searchVal ||
                    (x.CustomerId && String(x.CustomerId).toLowerCase().includes(searchVal)) ||
                    (x.FirstName && String(x.FirstName).toLowerCase().includes(searchVal)) ||
                    (x.LastName && String(x.LastName).toLowerCase().includes(searchVal)) ||
                    (x.CustomerType && String(x.CustomerType).toLowerCase().includes(searchVal)) ||
                    (x.CaseStatus && String(x.CaseStatus).toLowerCase().includes(searchVal))
                );

                if (sortCol >= 0) {
                    filteredData3.sort((a,b) => {
                        let keys = ['slno','customerId','firstName','nationality','dob','isMatched','source','uid','createdOnDB'];
                        let v1 = a[keys[sortCol]];
