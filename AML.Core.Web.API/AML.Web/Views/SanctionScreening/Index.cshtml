<script type="text/javascript">
    var searchData;

    function ExportToPDF() {



        $.ajax({
            type: "GET",
            url: "/SanctionScreening/DownloadPDFs/",
            data: {
                Name: $('#txtName').val().toUpperCase(), // < note use of 'this' here
                Nationality: $("#ddlNationalities").val().toUpperCase(),
                DOB: $('#dtDOB').val(),
                SelectionProperty: $("input[id='rdSelectionProperty']:checked").val()
            },
            success: function (data) {
                window.location = '/SanctionScreening/DownloadPDFs?Name=' + $('#txtName').val().toUpperCase() + '&Nationality=' + $("#ddlNationalities").val().toUpperCase() + '&DOB=' + $('#dtDOB').val() + '&SelectionProperty=' + $("input[id='rdSelectionProperty']:checked").val();

            },
            error: function (result) {
                alert('error');
            }
        });
    }

