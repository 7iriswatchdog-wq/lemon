@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Add Department";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.Department.DepartmentModel
<script src="~/plugins/jquery/jquery.min.js"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&family=Outfit:wght@100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Varela+Round&display=swap');

    .donut-chart {
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: conic-gradient( #2563EB 0% 65%, #AD87FF 65% 80%, #38BDF8 80% 100% );
        position: relative;
    }

    .donut-hole {
        position: absolute;
        width: 60%;
        height: 60%;
        background-color: white;
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .percentage {
        position: absolute;
        background-color: white;
        padding: 4px 8px;
        border-radius: 9999px;
        font-weight: bold;
        font-size: 1.25rem;
    }

    .percent-20 {
        top: 15%;
        right: -20%;
    }

    .percent-65 {
        bottom: -15%;
        left: 50%;
        transform: translateX(-50%);
    }

    .percent-15 {
        top: 10%;
        left: -20%;
    }
</style>

@* for the loading effect like data tables ... *@
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }</style>

<!-- RIGHT SIDE -->
<div class="max-w-screen h-full items-center ">

    <!-- RIGHT SIDE NAV -->
    @* <nav class="border-b">
        <div class="flex flex-row items-center justify-between w-full h-full md:p-5 p-5">
            <div>
                <h2 class="text-2xl font-bold">Add New</h2>
            </div>
            <div class="md:block hidden">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav> *@
    <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-surface">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                Add New
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>
    <div class="h-screen bg-gray-50 items-center  ">
        <div class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4  mx-auto">
            <!-- NAME SCREENING -->
            <div class="w-full bg-surface rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
                <div id="loadingeffect" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
                    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
                </div>
                <form asp-controller="Department" asp-action="Add" method="post" enctype="multipart/form-data" class="space-y-6">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedBy" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Code -->
                        <div>
                            <label for="txtCode" class="block text-sm font-medium text-gray-700">Code <span class="text-red-500">*</span></label>
                            <input type="text" asp-for="Code" id="txtCode" maxlength="30" placeholder="Enter code"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" />
                            <span asp-validation-for="Code" class="text-red-500 text-sm"></span>
                        </div>

                        <!-- Name -->
                        <div>
                            <label for="txtName" class="block text-sm font-medium text-gray-700">Name <span class="text-red-500">*</span></label>
                            <input type="text" asp-for="Name" id="txtName" maxlength="100" placeholder="Name"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" />
                            <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                        </div>

                        <!-- Description -->
                        <div>
                            <label for="txtDescription" class="block text-sm font-medium text-gray-700">Description</label>
                            <input type="text" asp-for="Description" id="txtDescription" maxlength="1000" placeholder="Description"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" />
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col md:flex-row justify-center mt-10 gap-4">
                        <button type="submit"
                                class="px-6 py-2 bg-[#2563EB] text-white rounded-md hover:bg-primary-hover"
                                onclick="fnSubmit()">
                            Submit
                        </button>
                        <a asp-controller="Department" asp-action="Index" onclick="showLoadingAndRedirect(event, this)"
                           class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100 text-center transition duration-200">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
