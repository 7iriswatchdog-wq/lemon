@{
    ViewData["Title"] = "Departments";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model List<AML.ViewModel.ViewModels.Department.DepartmentModel>



<div class="row">
    <div class="col-12">
        <div class="bg-surface rounded-xl border border-bordercolor shadow-none mb-4">
            <div class="px-6 py-4 border-b border-bordercolor">
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width: 150px;">
                        <input type="text" name="table_search" class="form-control float-right" placeholder="Search">

                        <div class="input-group-append">
                            <button type="submit" class="btn btn-default"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.card-header -->
            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap">
                    <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bordercolor">

                        @foreach (var item in Model)
                        {
                            <tr asp-controller="Department" asp-action="department-view">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                            </tr>
                        }
                       
                    </tbody>
                </table>
            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->
    </div>
</div>
