@{
    ViewData["Title"] = "Edit Department";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.Department.DepartmentModel

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Edit</h3>
                    </div>
                    <form role="form" asp-controller="Department" asp-action="Edit" class="form-horizontal" enctype="multipart/form-data" method="post">
                        <div class="card-body">
                            <div class="form-group row">
                                <label for="txtCode" class="col-sm-2 col-form-label">Code <span class="text-danger">*</span></label>
                                <div class="col-sm-6">
                                    <input type="text" asp-for="Code" class="form-control" id="txtCode" placeholder="Enter code" value="@Model.Code">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtName" class="col-sm-2 col-form-label">Name <span class="text-danger">*</span></label>
                                <div class="col-sm-6">
                                    <input type="text" asp-for="Name" class="form-control" id="txtName" placeholder="Name" value="@Model.Name">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtDescription" class="col-sm-2 col-form-label">Description</label>
                                <div class="col-sm-6">
                                    <input type="text" asp-for="Description" class="form-control" id="txtDescription" placeholder="Description" value="@Model.Description">
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="float-right">
                                <button type="submit" class="btn btn-primary btn-sm">Submit</button>
                                <a href="~/Department/List" type="button" class="btn btn-default btn-sm">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>