@{
    ViewData["Title"] = "Edit Department";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.Department.DepartmentModel

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="bg-surface rounded-xl border border-bordercolor shadow-none mb-4">
                    <div class="px-6 py-4 border-b border-bordercolor">
                        <h3 class="card-title">Edit</h3>
                    </div>
                    <form role="form" asp-controller="Department" asp-action="Edit" class="form-horizontal" enctype="multipart/form-data" method="post">
                        <div class="p-6">
                            <div class="form-group row">
                                <label for="txtCode" class="col-sm-2 col-form-label">Code <span class="text-danger">*</span></label>
                                <div class="col-sm-6">
                                    <input type="text" asp-for="Code" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCode" placeholder="Enter code" value="@Model.Code">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtName" class="col-sm-2 col-form-label">Name <span class="text-danger">*</span></label>
                                <div class="col-sm-6">
                                    <input type="text" asp-for="Name" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtName" placeholder="Name" value="@Model.Name">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtDescription" class="col-sm-2 col-form-label">Description</label>
                                <div class="col-sm-6">
                                    <input type="text" asp-for="Description" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtDescription" placeholder="Description" value="@Model.Description">
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="float-right">
                                <button type="submit" class="btn btn-primary btn-sm" title="Submit" aria-label="Submit"><i class="fas fa-check"></i></button>
                                <a href="~/Department/List" type="button" class="btn btn-default btn-sm" title="Cancel" aria-label="Cancel"><i class="fas fa-times"></i></a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>