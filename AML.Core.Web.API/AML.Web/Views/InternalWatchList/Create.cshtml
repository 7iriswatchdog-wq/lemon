<script type="text/javascript">
    function DownloadInternalWatchList(filename) {
        var type = $('#filename').val();
        $.ajax({
            type: "GET",
            url: "/InternalWatchList/DownloadInternalWatchList",
            data: { filename: filename },
            success: function(data) {
                window.location = '/InternalWatchList/DownloadInternalWatchList';
            },
            error: function(result) {
                alert('error');
            }
        });
    }

    function DownloadUAEIECLISTWatchList(filename) {
        var type = $('#filename').val();
        $.ajax({
            type: "GET",
            url: "/InternalWatchList/DownloadUAEIECLISTInternalWatchList",
            data: { filename: filename },
            success: function(data) {
                window.location = '/InternalWatchList/DownloadUAEIECLISTInternalWatchList';
            },
            error: function(result) {
                alert('error');
            }
        });
    }

    function DownloadOtherSample(filename) {
        var type = $('#filename').val();
        $.ajax({
            type: "GET",
            url: "/InternalWatchList/DownloadOtherSample",
            data: { filename: filename },
            success: function(data) {
                window.location = '/InternalWatchList/DownloadOtherSample';
            },
            error: function(result) {
                alert('error');
            }
        });
    }

    function fnSubmit() {

        // $(".se-pre-con").show();
        $('#loadingeffect').show();
    }
</script>
<script>
    function showLoadingAndRedirect(event, element) {
        event.preventDefault(); // Prevent default anchor action
        document.getElementById("loadingeffect").style.display = "flex"; // Show loader

        // Optional: wait a bit before redirecting (for loader visibility)
        setTimeout(() => {
            window.location.href = element.getAttribute("href");
        }, 300); // 300ms delay for smooth transition
    }
</script>

<script>
    function fnSubmit() {
        var form = document.getElementById("iwlForm");

        if (form.checkValidity()) {
            $('#loadingeffect').show(); // ✅ Show loader only if valid
            return true; // Continue with submit
        } else {
            form.reportValidity(); // ✅ Show validation errors
            return false; // Prevent submit
        }
    }
</script>
