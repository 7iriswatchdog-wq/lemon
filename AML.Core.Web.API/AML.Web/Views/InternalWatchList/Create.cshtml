<style>
    @@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&family=Outfit:wght@100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Varela+Round&display=swap');

    .donut-chart {
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: conic-gradient( #2563EB 0% 65%, #AD87FF 65% 80%, #38BDF8 80% 100% );
        position: relative;
    }

    .donut-hole {
        position: absolute;
        width: 60%;
        height: 60%;
        background-color: white;
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .percentage {
        position: absolute;
        background-color: white;
        padding: 4px 8px;
        border-radius: 9999px;
        font-weight: bold;
        font-size: 1.25rem;
    }

    .percent-20 {
        top: 15%;
        right: -20%;
    }

    .percent-65 {
        bottom: -15%;
        left: 50%;
        transform: translateX(-50%);
    }

    .percent-15 {
        top: 10%;
        left: -20%;
    }
</style>

@* for the loading effect like data tables ... *@
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }</style>

