@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using AML.DTO.DTO.InternalWatchListExcel;
@using AML.ViewModel.ViewModels.InternalWathcList;
@{
    ViewData["Title"] = "View Excel";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model List<InternalWatcListExcelDTO>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title" style="color:white">@localizer["List"]</h3>
                    </div>
                    <div class="card-body">
                        <div style="width: 100%; padding-left: -10px;">
                            <div class="table-responsive">
                                <table cellspacing="0" class="table table-striped table-hover dt-responsive display nowrap">
                                    <thead>
                                        <tr>
                                            <th>@localizer["Customer Id"]</th>
                                            <th>@localizer["FullName"]</th>
                                            <th>@localizer["Nationality"]</th>
                                            <th>@localizer["Source"]</th>
                                            <th>@localizer["Type"]</th>
                                        </tr>
                                    </thead>
                                    @foreach (InternalWatcListExcelDTO row in Model)
                                    {
                                            <tr>
                                                <td>@row.CustomerID</td>
                                                <td>@row.FullName</td>
                                                <td>@row.Nationality</td>
                                                <td>@row.Source</td>
                                                <td>@row.Type</td>
                                            </tr>
                                    }

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>