@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}


@model AML.ViewModel.ViewModels.InternalWathcList.WatchListModel

<div class="max-w-screen h-full items-center container">

    <!-- RIGHT SIDE NAV -->
    <nav class="border-b">
      <div class="flex flex-row items-center justify-between w-full h-full md:p-5 p-5">
        <div>
          <h2 class="text-2xl font-bold">Block List</h2>
        </div>
        <div class="md:block hidden">
         <img src="@Clientlogo" alt="Client Logo" width="50px" />
        </div>
      </div>
    </nav>
    <div class="h-screen bg-gray-50 items-center container ">
      <div class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4 container mx-auto">
        <!-- NAME SCREENING -->
        <div class="w-full bg-white rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
                <div id="loadingeffect" class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
                    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
                </div>
         
          <h1 class="text-lg mb-4 font-semibold">Block List Filter</h1>
                <form role="form" asp-controller="InternalWatchList" asp-action="Edit" class="form-horizontal" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedBy" />
        <input type="hidden" asp-for="UID" />
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:mb-60">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Type <span class="text-red-500">*</span></label> <select class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="ddlType" asp-for="Type">
                      <option value="CORPORATE">Corporate</option>
                      <option value="INDIVIDUAL">Individual</option>
                    </select>
                    <span asp-validation-for="Type" class="text-red-500"></span>
                </div>
              <div>
                <label for="txtFName" class="block text-sm font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
                    <input type="text" placeholder="Full Name" class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" asp-for="FullName" id="txtFName" maxlength="100" required>
                    <span asp-validation-for="FullName" class="text-red-500"></span>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nationality/Country of Incorporation</label> <select class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="ddlNationalities" asp-for="Nationality" asp-items="Model.Nationalities" >
                  <option value="0">--EMPTY--</option>
                </select>
            </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="dtDOB" >Date of Birth/Date of Incorporation</label> <input type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" asp-for="DOB" id="dtDOB" max="3000-12-31" placeholder="Date of Birth">
                <span asp-validation-for="DOB" class="text-red-500"></span>
              </div>
              
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                      Data Source<span class="text-red-500">*</span>
                    </label> 
                     <select class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="ddlSource" asp-for="Source">
                      <option value="CBWL">Central Bank Watch List</option>
                      <option value="BL">Black List</option>
                      <option value="INTERNAL">Block List</option>
                      <option value="UAE IEC LIST">UAE IEC LIST</option>
                    </select>
                    <span asp-validation-for="Source" class="text-red-500"></span>
                  </div>
             
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="txtIdNo">ID Number</label> <input type="text" placeholder="ID Number" class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" asp-for="IdNumber" id="txtIdNo">
                <span asp-validation-for="IdNumber" class="text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="remarks">Remarks</label> <textarea type="text" placeholder="Remarks" class="w-full px-3 py-2 border border-gray-300 rounded-md font-extralight resize-none" asp-for="Remarks" id="remarks" rows="3"> </textarea> 
            </div>
          </div>
            <div class="flex flex-col sm:flex-row justify-end space-y-4 sm:space-y-0 sm:space-x-4 md:mt-60">
                        <a asp-controller="InternalWatchList" asp-action="Create" onclick="showLoadingAndRedirect(event, this)"
                         class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100 text-center transition duration-200">Cancel
              </a>
              <button type="submit" class="px-6 py-2 bg-[#2563EB] text-white rounded-md hover:bg-blue-700" onclick="fnSubmit()">Submit</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>


<script>
 function fnSubmit() {
        $(".se-pre-con").show();
    }

    </script>
