@{
    var title    = ViewData["ReportTitle"] as string ?? "Report";
    var subtitle = ViewData["ReportSubtitle"] as string ?? "";
    var theme    = ViewData["Theme"] as string ?? "";
}
<div class="mb-4 flex items-start justify-between gap-4">
    <div>
        <div class="text-[11px] uppercase tracking-wider text-slate-500 font-bold">@theme</div>
        <h1 class="text-2xl font-semibold text-slate-800">@title</h1>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="text-sm text-slate-500 mt-1">@subtitle</p>
        }
    </div>
    <a href="@Url.Action("Hub", "ComplianceHub")" class="px-3 py-2 text-sm border border-slate-300 hover:bg-slate-50 rounded-lg inline-flex items-center gap-2 text-slate-700">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Compliance Hub
    </a>
</div>
