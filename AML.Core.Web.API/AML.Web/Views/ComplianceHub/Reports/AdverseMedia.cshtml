@using AML.ViewModel.ViewModels.ComplianceHub
@using System.Linq
@model AdverseMediaVM
@{
    ViewData["Title"] = "Adverse Media";
    ViewData["ReportTitle"] = "Adverse Media Watch";
    ViewData["ReportSubtitle"] = "Customers with adverse-media flags, sorted by time-since-last-review.";
    ViewData["Theme"] = "Screening";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<style>
    .am-strip { display:grid; grid-template-columns: repeat(4,1fr); gap:12px; margin-bottom:18px; }
    .am-card { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:14px 16px; }
    .am-card .n { font-size:24px; font-weight:800; line-height:1; }
    .am-card .l { font-size:11px; text-transform:uppercase; font-weight:700; color:#64748b; margin-top:6px; }
    .badge-conf { display:inline-block; padding:2px 9px; border-radius:9999px; font-size:11px; font-weight:700; background:#fae8ff; color:#86198f; }
    .badge-part { display:inline-block; padding:2px 9px; border-radius:9999px; font-size:11px; font-weight:700; background:#f3f4f6; color:#475569; }
</style>

<section class="content py-6 px-4">
    <div class="max-w-[1500px] mx-auto">
        <partial name="_ReportShell" />

        <div class="am-strip">
            <div class="am-card" style="border-left:4px solid #d946ef;"><div class="n" style="color:#a21caf;">@Model.Rows.Count</div><div class="l">Total flagged</div></div>
            <div class="am-card" style="border-left:4px solid #be185d;"><div class="n" style="color:#be185d;">@Model.Confirmed</div><div class="l">Confirmed</div></div>
            <div class="am-card" style="border-left:4px solid #94a3b8;"><div class="n" style="color:#475569;">@Model.Partial</div><div class="l">Partial / unresolved</div></div>
            <div class="am-card" style="border-left:4px solid #dc2626;"><div class="n" style="color:#dc2626;">@Model.OverdueReview</div><div class="l">Not reviewed in 90+ days</div></div>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50"><tr class="text-left text-xs uppercase font-bold text-slate-500"><th class="p-3">Case</th><th class="p-3">Customer</th><th class="p-3">Status</th><th class="p-3">Type</th><th class="p-3">Nationality</th><th class="p-3">Last reviewed</th><th class="p-3">Days since</th></tr></thead>
                <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="p-12 text-center text-slate-500">No adverse media flags recorded.</td></tr>
                }
                else
                {
                    foreach (var r in Model.Rows)
                    {
                        <tr class="border-t border-slate-100 hover:bg-slate-50">
                            <td class="p-3 font-mono text-xs text-blue-700 font-semibold">#@r.CaseId</td>
                            <td class="p-3"><div class="font-semibold text-slate-800">@r.FullName</div><div class="text-xs text-slate-500 font-mono">@r.CustomerCode</div></td>
                            <td class="p-3 text-xs text-slate-600">@r.Status</td>
                            <td class="p-3">@(r.IsConfirmed ? Html.Raw("<span class='badge-conf'>CONFIRMED</span>") : Html.Raw("<span class='badge-part'>PARTIAL</span>"))</td>
                            <td class="p-3 text-slate-600">@r.Nationality</td>
                            <td class="p-3 text-xs text-slate-500">@(r.UpdatedOn ?? r.CreatedOn).ToString("yyyy-MM-dd")</td>
                            <td class="p-3 font-bold @(r.DaysSinceReview > 90 ? "text-rose-600" : r.DaysSinceReview > 30 ? "text-amber-600" : "text-emerald-700")">@r.DaysSinceReview</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
