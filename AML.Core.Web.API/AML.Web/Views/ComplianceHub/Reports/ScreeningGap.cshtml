@using AML.ViewModel.ViewModels.ComplianceHub
@using System.Linq
@model ScreeningGapVM
@{
    ViewData["Title"] = "Screening Gap";
    ViewData["ReportTitle"] = "Onboarding Without Screening — Gap Register";
    ViewData["ReportSubtitle"] = "Customers in the master with no screening case attached. Direct compliance failure detector.";
    ViewData["Theme"] = "Lifecycle";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<style>
    .sg-hero {
        background: linear-gradient(135deg,#fee2e2,#fff);
        border:1px solid #fecaca; border-radius:16px; padding:24px; display:flex; align-items:center; gap:24px; margin-bottom:18px;
    }
    .sg-hero-num { font-size:54px; font-weight:900; line-height:1; color:#dc2626; }
    .sg-hero-pct { font-size:14px; font-weight:700; color:#991b1b; }
    .sg-hero-bar { flex:1; height:14px; background:#fff; border:1px solid #fca5a5; border-radius:7px; overflow:hidden; }
    .sg-hero-bar > span { display:block; height:100%; background:linear-gradient(90deg,#dc2626,#991b1b); transition:width 1s ease; }
</style>

<section class="content py-6 px-4">
    <div class="max-w-[1500px] mx-auto">
        <partial name="_ReportShell" />

        <div class="sg-hero">
            <div>
                <div class="sg-hero-num">@Model.Unscreened</div>
                <div class="text-sm text-slate-700 mt-1">customers without a screening case</div>
            </div>
            <div class="flex-1">
                <div class="flex items-baseline justify-between mb-2">
                    <span class="font-semibold text-slate-700">@Model.UnscreenedPct% of @Model.TotalCustomers customers</span>
                    <span class="sg-hero-pct">@(Model.UnscreenedPct < 5 ? "Healthy" : Model.UnscreenedPct < 20 ? "Investigate" : "Critical")</span>
                </div>
                <div class="sg-hero-bar"><span style="width:@(Model.UnscreenedPct)%"></span></div>
                <div class="text-xs text-slate-600 mt-2">Customer rows in <code>customermaster</code> with no matching <code>customercase</code>. These customers were onboarded but never sent through screening.</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr class="text-left text-xs uppercase font-bold text-slate-500"><th class="p-3">Customer</th><th class="p-3">Type</th><th class="p-3">Nationality</th><th class="p-3">Onboarded</th><th class="p-3">Days waiting</th></tr>
                </thead>
                <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="5" class="p-12 text-center text-emerald-700 font-semibold">All customers have been screened.</td></tr>
                }
                else
                {
                    foreach (var r in Model.Rows.Take(500))
                    {
                        <tr class="border-t border-slate-100 hover:bg-slate-50">
                            <td class="p-3"><div class="font-semibold text-slate-800">@r.FullName</div><div class="text-xs text-slate-500 font-mono">@r.CustomerCode</div></td>
                            <td class="p-3 text-slate-600">@(r.CustomerType == "I" ? "Individual" : r.CustomerType == "C" ? "Corporate" : r.CustomerType)</td>
                            <td class="p-3 text-slate-600">@r.Nationality</td>
                            <td class="p-3 text-slate-600 text-xs">@r.CreatedOn.ToString("yyyy-MM-dd")</td>
                            <td class="p-3"><span class="font-bold @(r.DaysSinceOnboarding > 7 ? "text-rose-600" : "text-amber-600")">@r.DaysSinceOnboarding days</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
