@using AML.ViewModel.ViewModels.ComplianceHub
@using System.Linq
@model ProliferationRegisterVM
@{
    ViewData["Title"] = "Proliferation Finance";
    ViewData["ReportTitle"] = "Proliferation Finance Register";
    ViewData["ReportSubtitle"] = "PF cases with chemical name, CAS / HS-code matches and decision status.";
    ViewData["Theme"] = "Governance";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";

    var maxChem = Model.TopChemicals.Any() ? Model.TopChemicals.Max(c => c.Value) : 1;
}

<style>
    .pf-strip { display:grid; grid-template-columns: repeat(4,1fr); gap:12px; margin-bottom:18px; }
    .pf-card { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:16px; }
    .pf-card .n { font-size:26px; font-weight:800; line-height:1; }
    .pf-card .l { font-size:11px; text-transform:uppercase; font-weight:700; color:#64748b; margin-top:6px; }

    .badge-status { display:inline-block; padding:3px 10px; border-radius:9999px; font-size:11px; font-weight:700; }
    .st-Pending { background:#fef3c7; color:#92400e; }
    .st-Approved { background:#d1fae5; color:#065f46; }
    .st-Rejected { background:#fee2e2; color:#991b1b; }

    .chem-row { display:grid; grid-template-columns: 1fr 60px; gap:10px; align-items:center; padding:8px 0; }
    .chem-row + .chem-row { border-top:1px solid #f1f5f9; }
    .chem-name { font-size:13px; color:#334155; font-weight:600; }
    .chem-bar { height:8px; background:#f1f5f9; border-radius:4px; overflow:hidden; }
    .chem-bar > span { display:block; height:100%; background:linear-gradient(90deg,#f97316,#c2410c); border-radius:4px; }
</style>

<section class="content py-6 px-4">
    <div class="max-w-[1500px] mx-auto">
        <partial name="_ReportShell" />

        <div class="pf-strip">
            <div class="pf-card" style="border-left:4px solid #f97316;"><div class="n" style="color:#c2410c;">@Model.Total</div><div class="l">Total PF cases</div></div>
            <div class="pf-card" style="border-left:4px solid #d97706;"><div class="n" style="color:#92400e;">@Model.Pending</div><div class="l">Pending</div></div>
            <div class="pf-card" style="border-left:4px solid #059669;"><div class="n" style="color:#065f46;">@Model.Approved</div><div class="l">Approved</div></div>
            <div class="pf-card" style="border-left:4px solid #dc2626;"><div class="n" style="color:#991b1b;">@Model.Rejected</div><div class="l">Rejected</div></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="bg-white border border-slate-200 rounded-xl p-5 lg:col-span-1">
                <div class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-3">Top chemicals matched</div>
                @if (!Model.TopChemicals.Any())
                {
                    <div class="text-sm text-slate-500 py-8 text-center">No chemical matches.</div>
                }
                else
                {
                    foreach (var c in Model.TopChemicals)
                    {
                        var pct = c.Value * 100 / maxChem;
                        <div class="chem-row">
                            <div>
                                <div class="chem-name">@c.Key</div>
                                <div class="chem-bar"><span style="width:@(pct)%"></span></div>
                            </div>
                            <div class="text-right font-bold text-orange-700">@c.Value</div>
                        </div>
                    }
                }
            </div>

            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden lg:col-span-2">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50"><tr class="text-left text-xs uppercase font-bold text-slate-500"><th class="p-3">Company</th><th class="p-3">HS Code</th><th class="p-3">CAS</th><th class="p-3">Chemical</th><th class="p-3">Score</th><th class="p-3">Status</th><th class="p-3">Created</th></tr></thead>
                    <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="7" class="p-12 text-center text-slate-500">No proliferation cases recorded.</td></tr>
                    }
                    else
                    {
                        foreach (var r in Model.Rows)
                        {
                            <tr class="border-t border-slate-100 hover:bg-slate-50">
                                <td class="p-3 font-semibold text-slate-800">@r.CompanyName</td>
                                <td class="p-3 font-mono text-xs">@r.HsCode</td>
                                <td class="p-3 font-mono text-xs">@r.CasNumber</td>
                                <td class="p-3 text-slate-600">@(r.MatchedChemicalName ?? r.ChemicalName)</td>
                                <td class="p-3 font-bold text-orange-700">@(r.Score?.ToString() ?? "—")</td>
                                <td class="p-3"><span class="badge-status st-@(r.Status ?? "Pending")">@(r.Status ?? "—")</span></td>
                                <td class="p-3 text-xs text-slate-500">@r.CreatedOn.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
