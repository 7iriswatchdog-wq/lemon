@using AML.ViewModel.ViewModels.ComplianceHub
@using System.Linq
@model ComplianceHubVM
@{
    ViewData["Title"] = "Compliance Hub";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var themes = new[] { "Lifecycle", "Screening", "Geography", "Governance" };
    string ThemeIcon(string t) => t switch
    {
        "Lifecycle" => "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a9 9 0 1 1-6.2-8.55\"/><path d=\"M21 3v6h-6\"/></svg>",
        "Screening" => "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>",
        "Geography" => "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg>",
        "Governance" => "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 12l2 2 4-4\"/><path d=\"M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z\"/></svg>",
        _ => ""
    };
    string AccentBg(string a) => a switch
    {
        "blue" => "from-blue-500 to-blue-700",
        "indigo" => "from-indigo-500 to-indigo-700",
        "emerald" => "from-emerald-500 to-emerald-700",
        "sky" => "from-sky-500 to-sky-700",
        "rose" => "from-rose-500 to-rose-700",
        "amber" => "from-amber-500 to-amber-700",
        "purple" => "from-purple-500 to-purple-700",
        "fuchsia" => "from-fuchsia-500 to-fuchsia-700",
        "teal" => "from-teal-500 to-teal-700",
        "cyan" => "from-cyan-500 to-cyan-700",
        "lime" => "from-lime-500 to-lime-700",
        "orange" => "from-orange-500 to-orange-700",
        _ => "from-slate-500 to-slate-700"
    };
    string AccentText(string a) => a switch
    {
        "blue"=>"text-blue-700","indigo"=>"text-indigo-700","emerald"=>"text-emerald-700",
        "sky"=>"text-sky-700","rose"=>"text-rose-700","amber"=>"text-amber-700",
        "purple"=>"text-purple-700","fuchsia"=>"text-fuchsia-700","teal"=>"text-teal-700",
        "cyan"=>"text-cyan-700","lime"=>"text-lime-700","orange"=>"text-orange-700",_=>"text-slate-700"
    };
    string Lucide(string name)
    {
        return name switch
        {
            "calendar-clock"   => "<path d='M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7'/><path d='M16 2v4M8 2v4M3 10h18'/><circle cx='17' cy='17' r='4'/><path d='M17 15v2l1 1'/>",
            "calendar-check"   => "<rect x='3' y='4' width='18' height='18' rx='2' ry='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/><path d='m9 16 2 2 4-4'/>",
            "list-checks"      => "<line x1='10' y1='6' x2='21' y2='6'/><line x1='10' y1='12' x2='21' y2='12'/><line x1='10' y1='18' x2='21' y2='18'/><polyline points='3 6 4 7 6 5'/><polyline points='3 12 4 13 6 11'/><polyline points='3 18 4 19 6 17'/>",
            "trending-up"      => "<polyline points='22 7 13.5 15.5 8.5 10.5 2 17'/><polyline points='16 7 22 7 22 13'/>",
            "alert-triangle"   => "<path d='M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/>",
            "shield-alert"     => "<path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>",
            "user-cog"         => "<circle cx='9' cy='7' r='4'/><path d='M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2'/><circle cx='19' cy='11' r='2'/><path d='M19 8v1M19 13v1M21.6 9.5l-.8.5M17.2 12l-.8.5M21.6 12.5l-.8-.5M17.2 10l-.8-.5'/>",
            "newspaper"        => "<path d='M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2'/><path d='M18 14h-8M15 18h-5M10 6h8v4h-8z'/>",
            "globe"            => "<circle cx='12' cy='12' r='10'/><line x1='2' y1='12' x2='22' y2='12'/><path d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'/>",
            "git-merge"        => "<circle cx='18' cy='18' r='3'/><circle cx='6' cy='6' r='3'/><path d='M6 21V9a9 9 0 0 0 9 9'/>",
            "list-check"       => "<path d='m3 17 2 2 4-4'/><path d='m3 7 2 2 4-4'/><path d='M13 6h8'/><path d='M13 12h8'/><path d='M13 18h8'/>",
            "atom"             => "<circle cx='12' cy='12' r='1'/><path d='M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5z'/><path d='M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5z'/>",
            _ => "<circle cx='12' cy='12' r='10'/>"
        };
    }
}

<style>
    .ch-page-bg { background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 240px); }
    .ch-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #4f46e5 100%);
        color: #fff;
        border-radius: 18px;
        padding: 28px 32px;
        margin-bottom: 24px;
        position: relative; overflow: hidden;
    }
    .ch-hero::before {
        content: ''; position: absolute; right: -100px; top: -100px;
        width: 400px; height: 400px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,.15) 0%, transparent 60%);
    }
    .ch-hero h1 { font-size: 28px; font-weight: 800; margin: 0; letter-spacing: -.02em; }
    .ch-hero p { opacity: .85; margin-top: 6px; max-width: 720px; font-size: 14px; }
    .ch-tile {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 16px;
        padding: 0; overflow: hidden; transition: box-shadow .2s ease, transform .2s ease;
        text-decoration: none; color: inherit; display: flex; flex-direction: column;
        position: relative;
    }
    .ch-tile:hover { box-shadow: 0 12px 32px rgba(15,23,42,.10); transform: translateY(-3px); text-decoration: none; color: inherit; }
    .ch-tile-head { height: 6px; background: linear-gradient(90deg, var(--c-from), var(--c-to)); }
    .ch-tile-body { padding: 18px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .ch-tile-icon {
        width: 44px; height: 44px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--c-bg); color: var(--c-fg);
    }
    .ch-tile-name { font-weight: 700; font-size: 15px; color: #0f172a; line-height: 1.3; }
    .ch-tile-desc { font-size: 12.5px; color: #64748b; line-height: 1.5; flex: 1; }
    .ch-tile-stat { font-size: 22px; font-weight: 800; line-height: 1; }
    .ch-tile-stat-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: .04em; color: #94a3b8; font-weight: 700; margin-top: 3px; }
    .ch-tile-cta { color: #2563eb; font-size: 12px; font-weight: 700; margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; }
    .ch-tile-code { position: absolute; top: 14px; right: 14px; font-size: 10px; font-family: ui-monospace, SFMono-Regular, monospace; color: #cbd5e1; font-weight: 700; }

    .ch-section-head {
        display: flex; align-items: center; gap: 10px; margin: 24px 0 12px;
        font-size: 14px; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: .06em;
    }
    .ch-section-head .ch-section-bar { flex: 1; height: 1px; background: linear-gradient(90deg, #cbd5e1, transparent); }

    /* Per-accent CSS variables */
    .acc-blue    { --c-from:#3b82f6; --c-to:#1d4ed8; --c-bg:#dbeafe; --c-fg:#1e40af; }
    .acc-indigo  { --c-from:#6366f1; --c-to:#4338ca; --c-bg:#e0e7ff; --c-fg:#3730a3; }
    .acc-emerald { --c-from:#10b981; --c-to:#047857; --c-bg:#d1fae5; --c-fg:#065f46; }
    .acc-sky     { --c-from:#0ea5e9; --c-to:#0369a1; --c-bg:#e0f2fe; --c-fg:#075985; }
    .acc-rose    { --c-from:#f43f5e; --c-to:#be123c; --c-bg:#ffe4e6; --c-fg:#9f1239; }
    .acc-amber   { --c-from:#f59e0b; --c-to:#b45309; --c-bg:#fef3c7; --c-fg:#92400e; }
    .acc-purple  { --c-from:#a855f7; --c-to:#6b21a8; --c-bg:#f3e8ff; --c-fg:#6b21a8; }
    .acc-fuchsia { --c-from:#d946ef; --c-to:#a21caf; --c-bg:#fae8ff; --c-fg:#86198f; }
    .acc-teal    { --c-from:#14b8a6; --c-to:#0f766e; --c-bg:#ccfbf1; --c-fg:#115e59; }
    .acc-cyan    { --c-from:#06b6d4; --c-to:#0e7490; --c-bg:#cffafe; --c-fg:#155e75; }
    .acc-lime    { --c-from:#84cc16; --c-to:#4d7c0f; --c-bg:#ecfccb; --c-fg:#3f6212; }
    .acc-orange  { --c-from:#f97316; --c-to:#c2410c; --c-bg:#ffedd5; --c-fg:#9a3412; }
</style>

<section class="content py-6 px-4 ch-page-bg">
    <div class="max-w-[1500px] mx-auto">
        <div class="ch-hero">
            <div style="position:relative;z-index:1;">
                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:700;opacity:.8;">Compliance</div>
                <h1>Compliance Hub</h1>
                <p>One place for every compliance lens that isn't EWRA or transaction monitoring — KYC freshness, screening dispositions, geographic exposure and governance audit, all in 12 reports.</p>
            </div>
        </div>

        @foreach (var theme in themes)
        {
            var themeTiles = Model.Tiles.Where(t => t.Theme == theme).ToList();
            if (!themeTiles.Any()) continue;
            <div class="ch-section-head">
                <span style="display:inline-flex;align-items:center;gap:8px;color:#1e293b;">@Html.Raw(ThemeIcon(theme)) @theme</span>
                <span class="ch-section-bar"></span>
                <span style="font-size:11px;font-weight:600;color:#94a3b8;text-transform:none;letter-spacing:0;">@themeTiles.Count report@(themeTiles.Count==1?"":"s")</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var tile in themeTiles)
                {
                    <a href="@tile.Url" class="ch-tile acc-@tile.Accent">
                        <div class="ch-tile-head"></div>
                        <div class="ch-tile-body">
                            <span class="ch-tile-code">@tile.Code</span>
                            <div class="ch-tile-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(Lucide(tile.Icon))</svg>
                            </div>
                            <div class="ch-tile-name">@tile.Name</div>
                            <div class="ch-tile-desc">@tile.Description</div>
                            @if (!string.IsNullOrEmpty(tile.LiveStat))
                            {
                                <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-top:6px;">
                                    <div>
                                        <div class="ch-tile-stat" style="color:var(--c-fg);">@tile.LiveStat</div>
                                        <div class="ch-tile-stat-lbl">@tile.LiveStatLabel</div>
                                    </div>
                                    <span class="ch-tile-cta">Open
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div style="display:flex;justify-content:flex-end;margin-top:6px;">
                                    <span class="ch-tile-cta">Open report
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                                    </span>
                                </div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>
