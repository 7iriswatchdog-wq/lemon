<script type="text/javascript">
            $('#selectAll').on('change', function () {
        const isChecked = $(this).prop('checked');
        $('#customerMasterTable tbody input.chkClass').each(function () {
            $(this).prop('checked', isChecked);
            const val = $(this).val();

            if (isChecked) {
                if (!arrChk.includes(val)) arrChk.push(val);
            } else {
                arrChk = arrChk.filter(id => id !== val);
            }
        });
    });

    let arrChk = [];
    let currentPage = 1;
    let totalPages = 1;
    let pageSize = 10;
    let sortColumn = "cust_ref_id"; // default column
    let sortDirection = "asc";
    $(document).ready(function () {
        showLoader2();
        fetchData();
    });

    $('#rowsPerPage').on('change', function () {
        pageSize = parseInt($(this).val()) || 10;
        currentPage = 1;
        showLoader();
        fetchData();
    });

    $('#searchBox').on('input', function () {
        currentPage = 1;
        showLoader2();
        fetchData();
    });

    $('.pagination-controls').on('click', 'button', function () {
        const pg = parseInt($(this).data('page'));
        if (!isNaN(pg) && pg >= 1 && pg <= totalPages) {
            currentPage = pg
            showLoader2();
            fetchData();
        }
    });
    $('#customerMasterTable thead').on('click', 'th.sortable', function () {
        const newSortCol = $(this).data('column');
        if (sortColumn === newSortCol) {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            sortColumn = newSortCol;
            sortDirection = 'asc';
        }
        $('#customerMasterTable thead th').removeClass('active asc desc');
        $(this).addClass(`active ${sortDirection}`);
        currentPage = 1;
        showLoader2();
        fetchData();
    });
    function getColumnIndex(columnName) {
        const columns = ["cust_ref_id", "fname", "dob", "nationality", "cust_type"];
        return columns.indexOf(columnName);
    }
    function fetchData() {
        const searchValue = $('#searchBox').val() || '';
        const start = (currentPage - 1) * pageSize;

        $.ajax({
            url: '/CustomerMaster/CustomPaginationPosition',
            type: 'POST',
            dataType: 'json',
            data: {
                draw: 1,
                start: start,
                length: pageSize,
                search: { value: searchValue },
                order: [{ column: getColumnIndex(sortColumn), dir: sortDirection }]
            },
            success: function (resp) {
                const rows = resp.data || [];
                const totalRecords = resp.recordsFiltered || 0;
                totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));

                renderTable(rows);
                renderPager();
                hideLoader();
                hideLoader2();
            },
            error: function (xhr) {
                console.error('Error fetching data:', xhr.statusText);
            }
        });
    }

            function renderTable(rows) {
        const $tbody = $('#customerMasterTable tbody');
        $tbody.empty();

        if (!rows.length) {
            $tbody.append(`<tr><td colspan="7" class="text-center py-4">No data available</td></tr>`);
            return;
        }

        rows.forEach(row => {
            let name = [row.firstName, row.middleName, row.lastName]
                .filter(n => n && n !== 'null')
                .join(' ');

            let dob = '';
            if (row.dob && row.dob !== "0001-01-01T00:00:00") {
                const [y, m, d] = row.dob.split('T')[0].split("-");
                dob = `${d}-${m}-${y}`;
            }

            let checked = arrChk.includes(row.customerReferenceId) ? 'checked' : '';
            let toggleChecked = row.whiteListed === 'YES' ? 'checked' : '';

            const html = `
                <tr>
                    <td class="px-6 py-4 text-sm text-gray-900">
                        <input type="checkbox" class="w-4 h-4 rounded border-gray-400 chkClass" value="${row.customerReferenceId}" ${checked}>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-900">${row.customerReferenceId}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${name}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${dob}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${row.nationality}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">${row.customerType}</td>
                    <td class="px-6 py-4 text-sm text-gray-900 flex items-center gap-2">
                        <a href='AddUpdate?id=${row.id}' class='sas-button bg-color-4 pt-2 mr-2 action-icons'>
                            <i class='fas fa-user-edit'></i>
                        </a>

                        <label class="relative inline-flex cursor-pointer items-center">
                            <input type="checkbox" class="peer sr-only" ${toggleChecked}
                                onchange="UpdateWhiteList(${row.id}, '${row.customerReferenceId}', this.checked ? 1 : 0)">
                            <div class="h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-blue-600 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:ring-4 peer-focus:ring-blue-300"></div>
                        </label>

                        <a id='deleteCustomerBtn${row.customerReferenceId}' onclick='deleteCustomer("${row.customerReferenceId}")' class='sas-button p-8-25 bg-color-3 mr-2 action-icons'>
                            <i id='deleteLogo${row.customerReferenceId}' class='fas fa-user-minus'></i>
                            <div id='deleteSpinner${row.customerReferenceId}' style='display: none; height: 20px; width: 20px;' class='spinner-border text-dark' role='status'>
                                <span class='sr-only'>Loading...</span>
                            </div>
                        </a>
                    </td>
                </tr>`;
            $tbody.append(html);
        });
    }



    function renderPager() {
        const $pager = $('.pagination-controls').empty();
        if (totalPages <= 1) return;

        const btn = (label, pg, disabled, active = false) =>
            `<button class="px-3 py-1 border rounded ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'} ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}" data-page="${pg}" ${disabled ? 'disabled' : ''}>${label}</button>`;

        $pager.append(btn('First', 1, currentPage === 1));
        $pager.append(btn('Prev', currentPage - 1, currentPage === 1));

        const maxVisible = 5;
        let start = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let end = Math.min(totalPages, start + maxVisible - 1);
        if (end - start < maxVisible) start = Math.max(1, end - maxVisible + 1);

        for (let i = start; i <= end; i++) {
            $pager.append(btn(i, i, false, i === currentPage));
        }

        $pager.append(btn('Next', currentPage + 1, currentPage === totalPages));
        $pager.append(btn('Last', totalPages, currentPage === totalPages));
    }

    $('#customerMasterTable').on('click', 'input.chkClass', function () {
        const val = $(this).val();
        if ($(this).prop("checked")) {
            if (!arrChk.includes(val)) arrChk.push(val);
        } else {
            arrChk = arrChk.filter(id => id !== val);
        }
    });

    function deleteCustomer(id) {
        $(`#deleteCustomerBtn${id}`).prop("disabled", true);
        $(`#deleteSpinner${id}`).show();
        $(`#deleteLogo${id}`).hide();

        $.ajax({
            url: `/customerMaster/delete?CustomerReferenceID=${id}`,
            type: "GET",
            success: function () {
                fetchData();
            },
            error: function (error) {
                alert(JSON.stringify(error));
                $(`#deleteCustomerBtn${id}`).prop("disabled", false);
                $(`#deleteSpinner${id}`).hide();
                $(`#deleteLogo${id}`).show();
            }
        });
    }

    function deleteMultipleCustomer() {
        if (!arrChk.length) return alert("Nothing to delete");
        if (!confirm('Do you want to delete the selected customers?')) return;
        showLoader();
        $.ajax({
            url: `/customerMaster/delete?CustomerReferenceID=${arrChk.join(",")}`,
            type: "GET",
            success: function () {
                arrChk = [];
                fetchData();
                hideLoader();
                alert("Deleted Successfully");
            },
            error: function (error) {
                alert(JSON.stringify(error));
            }
        });
    }

    function UpdateWhiteList(id, refId, isWhiteList) {
        showLoader();
        $.ajax({
            url: "/CustomerMaster/UpdateWhiteList",
            type: "POST",
            data: {
                Id: id,
                CustomerReferenceId: refId,
                IsWhiteListed: isWhiteList === 1 ? 'YES' : 'NO'
            },
            success: function () {
                fetchData();
                hideLoader();
            },
            error: function (error) {
                alert(JSON.stringify(error));
            }
        });
    }
    function showLoader() {
        $('#loadingRiskCategory').removeClass('hidden');
    }

    function hideLoader() {
        $('#loadingRiskCategory').addClass('hidden');
    }
    function showLoader2() {
        $('#loadingRiskCategory2').removeClass('hidden');
    }
    function hideLoader2() {
        $('#loadingRiskCategory2').addClass('hidden');
    }
</script>
