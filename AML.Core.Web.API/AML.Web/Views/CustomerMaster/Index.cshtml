<style>
    .hw-25 {
        height: 25px !important;
        width: 25px !important;
    }

    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }

    th.sortable {
        position: relative;
        padding-right: 20px;
        cursor: pointer;
    }

        /* Show vertical gray arrows by default */
        th.sortable::after {
            content: '▲\A▼';
            white-space: pre; /* respect \A (newline) */
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            color: #bbb;
            line-height: 1;
            text-align: center;
        }

        /* Only ▲ when sorting ascending */
        th.sortable.active.asc::after {
            content: '▲';
            color: #000;
        }

        /* Only ▼ when sorting descending */
        th.sortable.active.desc::after {
            content: '\A▼';
            color: #000;
        }
</style>


