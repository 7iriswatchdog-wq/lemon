@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Behavioral Patterns — Searchin Intelligence"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-intel-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#7c3aed,#a78bfa);color:#fff}.si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}.si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}.si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}.si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}.si-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}.si-chart-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px}.si-chart-card.full{grid-column:span 2}.si-chart-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}.si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}.si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}.si-table-title{font-size:15px;font-weight:700;color:#0f172a}.si-table{width:100%;border-collapse:collapse}.si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;white-space:nowrap}.si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}.si-table tbody tr:hover{background:#f8fafc}.si-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}.si-badge-critical{background:#fee2e2;color:#991b1b}.si-badge-warning{background:#fef3c7;color:#92400e}.si-badge-info{background:#e0e7ff;color:#3730a3}.si-badge-normal{background:#d1fae5;color:#065f46}@@media(max-width:768px){.si-kpi-row,.si-chart-grid{grid-template-columns:1fr}.si-chart-card.full{grid-column:span 1}}</style>
<div class="si-page" x-data="behavioralPatterns()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Behavioral Patterns</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/Intelligence">Intelligence</a> / Behavioral Patterns</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-intel-badge"><i class="fa-solid fa-brain"></i> AI Analytics</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#7c3aed;--kpi-bg:#ede9fe"><div class="si-kpi-icon"><i class="fa-solid fa-brain"></i></div><div class="si-kpi-value" x-text="summary.anomalies||'0'"></div><div class="si-kpi-label">Anomalies Detected</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div><div class="si-kpi-value" x-text="summary.critical||'0'"></div><div class="si-kpi-label">Critical Patterns</div></div>
            <div class="si-kpi" style="--kpi-color:#06b6d4;--kpi-bg:#cffafe"><div class="si-kpi-icon"><i class="fa-solid fa-user-group"></i></div><div class="si-kpi-value" x-text="summary.clusters||'0'"></div><div class="si-kpi-label">Risk Clusters</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-chart-line"></i></div><div class="si-kpi-value" x-text="summary.accuracy+'%'"></div><div class="si-kpi-label">Model Accuracy</div></div>
        </div>
        <div class="si-chart-grid">
            <div class="si-chart-card full"><div class="si-chart-title">Anomaly Score Distribution Over Time</div><div style="height:300px"><canvas id="timelineChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Pattern Categories</div><div style="height:280px"><canvas id="catChart"></canvas></div></div>
            <div class="si-chart-card"><div class="si-chart-title">Severity Breakdown</div><div style="height:280px"><canvas id="sevChart"></canvas></div></div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header"><div class="si-table-title">Detected Behavioral Anomalies</div></div>
            <div style="overflow-x:auto">
                <table class="si-table"><thead><tr><th>Customer</th><th>Pattern</th><th>Anomaly Score</th><th>Category</th><th>Severity</th><th>Detected</th><th>Status</th></tr></thead>
                <tbody><template x-for="row in patterns" :key="row.id"><tr>
                    <td x-text="row.customer" style="font-weight:600;color:#6366f1"></td><td x-text="row.pattern" style="font-size:12px;max-width:250px;overflow:hidden;text-overflow:ellipsis"></td>
                    <td><span style="font-weight:700" :style="'color:'+(row.score>=80?'#ef4444':row.score>=50?'#f59e0b':'#22c55e')" x-text="row.score"></span></td>
                    <td x-text="row.category" style="font-size:12px"></td>
                    <td><span class="si-badge" :class="row.severity==='Critical'?'si-badge-critical':row.severity==='Warning'?'si-badge-warning':'si-badge-info'" x-text="row.severity"></span></td>
                    <td x-text="row.detected" style="font-size:12px"></td>
                    <td><span class="si-badge" :class="row.status==='Resolved'?'si-badge-normal':'si-badge-warning'" x-text="row.status"></span></td>
                </tr></template></tbody></table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function behavioralPatterns(){return{summary:{anomalies:23,critical:5,clusters:8,accuracy:94},
patterns:[
{id:1,customer:'Ahmed Al-Rashid',pattern:'Rapid succession of high-value transfers to multiple jurisdictions',score:92,category:'Transaction Velocity',severity:'Critical',detected:'14 Mar 2026',status:'Under Review'},
{id:2,customer:'Global Trade LLC',pattern:'Unusual increase in cash deposits followed by wire transfers',score:85,category:'Structuring',severity:'Critical',detected:'13 Mar 2026',status:'Under Review'},
{id:3,customer:'Sarah Chen',pattern:'Account dormancy followed by sudden high activity',score:78,category:'Dormancy Alert',severity:'Warning',detected:'12 Mar 2026',status:'Under Review'},
{id:4,customer:'Nexus Holdings',pattern:'Round-trip transactions between related entities',score:74,category:'Layering',severity:'Warning',detected:'11 Mar 2026',status:'Resolved'},
{id:5,customer:'Omar Khalil',pattern:'Cross-border transfers to high-risk jurisdictions',score:71,category:'Geo Risk',severity:'Warning',detected:'10 Mar 2026',status:'Resolved'},
{id:6,customer:'Pacific Trading Co',pattern:'Inconsistent transaction patterns vs declared business type',score:65,category:'Profile Mismatch',severity:'Info',detected:'09 Mar 2026',status:'Resolved'}],
init(){this.renderCharts()},
renderCharts(){const c1=document.getElementById('timelineChart');
if(c1){const days=[];for(let i=29;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);days.push(d.toISOString().split('T')[0].substring(5))}
new Chart(c1.getContext('2d'),{type:'line',data:{labels:days,datasets:[{label:'Anomaly Score',data:days.map(()=>Math.floor(Math.random()*40)+40),borderColor:'#7c3aed',backgroundColor:'rgba(124,58,237,.08)',fill:true,tension:.3,pointRadius:2},{label:'Threshold',data:days.map(()=>70),borderColor:'#ef4444',borderDash:[5,5],pointRadius:0,fill:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{size:11,weight:'600'},usePointStyle:true}}},scales:{y:{beginAtZero:true,max:100,grid:{color:'#f1f5f9'}},x:{grid:{display:false},ticks:{maxTicksLimit:10,font:{size:10}}}}}})}
const c2=document.getElementById('catChart');
if(c2){new Chart(c2.getContext('2d'),{type:'doughnut',data:{labels:['Transaction Velocity','Structuring','Dormancy','Layering','Geo Risk','Profile Mismatch'],datasets:[{data:[8,5,3,3,2,2],backgroundColor:['#7c3aed','#ef4444','#f59e0b','#06b6d4','#22c55e','#94a3b8'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'right',labels:{font:{size:11,weight:'600'},usePointStyle:true,padding:8}}}}})}
const c3=document.getElementById('sevChart');
if(c3){new Chart(c3.getContext('2d'),{type:'bar',data:{labels:['Critical','Warning','Info'],datasets:[{data:[5,12,6],backgroundColor:['#ef4444','#f59e0b','#6366f1'],borderRadius:8,barPercentage:.4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false}}}}})}
}}}
</script>
