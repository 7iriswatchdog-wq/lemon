@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{ ViewData["Title"] = "Network Analysis — Searchin Intelligence"; Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml"; var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl"); }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>[x-cloak]{display:none!important}.si-page{min-height:100vh;background:#f8fafc}.si-page-inner{padding:24px;max-width:1440px;margin:0 auto}.si-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#fff;border-bottom:1px solid #e2e8f0}.si-header-title{font-size:18px;font-weight:700;color:#0f172a}.si-header-breadcrumb{font-size:12px;color:#94a3b8;margin-top:2px}.si-header-breadcrumb a{color:#6366f1;text-decoration:none}.si-intel-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:8px;font-size:11px;font-weight:700;background:linear-gradient(135deg,#7c3aed,#a78bfa);color:#fff}.si-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.si-kpi{background:#fff;border-radius:16px;padding:20px;border:1px solid #e2e8f0;transition:all .2s;position:relative;overflow:hidden}.si-kpi:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.si-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--kpi-color,#6366f1)}.si-kpi-value{font-size:28px;font-weight:800;color:#0f172a;margin-bottom:4px;line-height:1}.si-kpi-label{font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em}.si-kpi-icon{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--kpi-bg,#eef2ff);color:var(--kpi-color,#6366f1);font-size:16px}
.si-network-canvas{background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:20px;margin-bottom:24px;min-height:500px;position:relative}
.si-network-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.si-network-viz{width:100%;height:450px;background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:12px;overflow:hidden;position:relative}
.si-node{position:absolute;display:flex;flex-direction:column;align-items:center;cursor:pointer;transition:all .3s}
.si-node:hover{transform:scale(1.15)}
.si-node-circle{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;box-shadow:0 0 20px rgba(99,102,241,.4)}
.si-node-label{font-size:10px;font-weight:600;color:#94a3b8;margin-top:6px;text-align:center;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.si-legend{display:flex;gap:20px;margin-top:12px}.si-legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:#64748b;font-weight:600}.si-legend-dot{width:10px;height:10px;border-radius:50%}
.si-table-card{background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden}.si-table-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #f1f5f9}.si-table-title{font-size:15px;font-weight:700;color:#0f172a}.si-table{width:100%;border-collapse:collapse}.si-table thead th{padding:12px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;background:#f8fafc;border-bottom:1px solid #e2e8f0;white-space:nowrap}.si-table tbody td{padding:11px 14px;font-size:13px;color:#334155;border-bottom:1px solid #f1f5f9;white-space:nowrap}.si-table tbody tr:hover{background:#f8fafc}.si-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}.si-badge-high{background:#fee2e2;color:#991b1b}.si-badge-medium{background:#fef3c7;color:#92400e}.si-badge-low{background:#d1fae5;color:#065f46}
@@media(max-width:768px){.si-kpi-row{grid-template-columns:repeat(2,1fr)}}</style>
<div class="si-page" x-data="networkAnalysis()" x-init="init()" x-cloak>
    <div class="si-header"><div><div class="si-header-title">Network Analysis</div><div class="si-header-breadcrumb"><a href="/">Home</a> / <a href="/Intelligence">Intelligence</a> / Network Analysis</div></div><div style="display:flex;align-items:center;gap:12px"><span class="si-intel-badge"><i class="fa-solid fa-brain"></i> AI Analytics</span><img src="@Clientlogo" alt="Logo" style="height:32px"/></div></div>
    <div class="si-page-inner">
        <div class="si-kpi-row">
            <div class="si-kpi" style="--kpi-color:#7c3aed;--kpi-bg:#ede9fe"><div class="si-kpi-icon"><i class="fa-solid fa-circle-nodes"></i></div><div class="si-kpi-value">156</div><div class="si-kpi-label">Entities Mapped</div></div>
            <div class="si-kpi" style="--kpi-color:#06b6d4;--kpi-bg:#cffafe"><div class="si-kpi-icon"><i class="fa-solid fa-link"></i></div><div class="si-kpi-value">312</div><div class="si-kpi-label">Connections</div></div>
            <div class="si-kpi" style="--kpi-color:#ef4444;--kpi-bg:#fee2e2"><div class="si-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div><div class="si-kpi-value">12</div><div class="si-kpi-label">Suspicious Clusters</div></div>
            <div class="si-kpi" style="--kpi-color:#22c55e;--kpi-bg:#d1fae5"><div class="si-kpi-icon"><i class="fa-solid fa-magnifying-glass-chart"></i></div><div class="si-kpi-value">4</div><div class="si-kpi-label">Shell Indicators</div></div>
        </div>
        <div class="si-network-canvas">
            <div class="si-network-title"><i class="fa-solid fa-diagram-project" style="color:#7c3aed"></i> Entity Relationship Map</div>
            <div class="si-network-viz" id="networkViz">
                <svg width="100%" height="100%" id="networkSvg" style="position:absolute;top:0;left:0;z-index:0"></svg>
                <template x-for="node in nodes" :key="node.id">
                    <div class="si-node" :style="'left:'+node.x+'px;top:'+node.y+'px;z-index:1'">
                        <div class="si-node-circle" :style="'background:'+node.color"><i :class="node.icon"></i></div>
                        <div class="si-node-label" x-text="node.label"></div>
                    </div>
                </template>
            </div>
            <div class="si-legend">
                <div class="si-legend-item"><div class="si-legend-dot" style="background:#6366f1"></div> Individual</div>
                <div class="si-legend-item"><div class="si-legend-dot" style="background:#06b6d4"></div> Corporate</div>
                <div class="si-legend-item"><div class="si-legend-dot" style="background:#ef4444"></div> Sanctioned</div>
                <div class="si-legend-item"><div class="si-legend-dot" style="background:#f59e0b"></div> PEP</div>
            </div>
        </div>
        <div class="si-table-card">
            <div class="si-table-header"><div class="si-table-title">Suspicious Connection Clusters</div></div>
            <div style="overflow-x:auto">
                <table class="si-table"><thead><tr><th>Cluster ID</th><th>Primary Entity</th><th>Entities</th><th>Connections</th><th>Risk Level</th><th>Pattern</th><th>Detected</th></tr></thead>
                <tbody><template x-for="c in clusters" :key="c.id"><tr>
                    <td x-text="c.id" style="font-weight:600;color:#7c3aed"></td><td x-text="c.primary" style="font-weight:600"></td>
                    <td x-text="c.entities" style="font-weight:600"></td><td x-text="c.connections"></td>
                    <td><span class="si-badge" :class="c.risk==='High'?'si-badge-high':c.risk==='Medium'?'si-badge-medium':'si-badge-low'" x-text="c.risk"></span></td>
                    <td x-text="c.pattern" style="font-size:12px;max-width:250px;overflow:hidden;text-overflow:ellipsis"></td>
                    <td x-text="c.detected" style="font-size:12px"></td>
                </tr></template></tbody></table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
<script>
function networkAnalysis(){return{
nodes:[
{id:1,label:'Ahmed Al-R.',x:280,y:180,color:'#6366f1',icon:'fa-solid fa-user'},
{id:2,label:'Global Trade LLC',x:480,y:80,color:'#06b6d4',icon:'fa-solid fa-building'},
{id:3,label:'Sarah Chen',x:150,y:60,color:'#6366f1',icon:'fa-solid fa-user'},
{id:4,label:'Nexus Holdings',x:560,y:260,color:'#06b6d4',icon:'fa-solid fa-building'},
{id:5,label:'Omar K.',x:80,y:250,color:'#f59e0b',icon:'fa-solid fa-user'},
{id:6,label:'Shell Corp A',x:680,y:140,color:'#ef4444',icon:'fa-solid fa-building'},
{id:7,label:'Pacific Trading',x:400,y:320,color:'#06b6d4',icon:'fa-solid fa-building'},
{id:8,label:'Maria Lopez',x:200,y:350,color:'#6366f1',icon:'fa-solid fa-user'}],
edges:[[1,2],[1,5],[2,4],[2,6],[3,1],[4,6],[4,7],[5,8],[7,8]],
clusters:[
{id:'CLU-001',primary:'Ahmed Al-Rashid',entities:5,connections:8,risk:'High',pattern:'Circular fund flow between related entities',detected:'14 Mar 2026'},
{id:'CLU-002',primary:'Nexus Holdings',entities:4,connections:6,risk:'High',pattern:'Shell company layering structure',detected:'13 Mar 2026'},
{id:'CLU-003',primary:'Pacific Trading Co',entities:3,connections:4,risk:'Medium',pattern:'Cross-border value pass-through',detected:'12 Mar 2026'},
{id:'CLU-004',primary:'Global Trade LLC',entities:6,connections:10,risk:'High',pattern:'Multi-jurisdiction ownership chain',detected:'11 Mar 2026'}],
init(){this.$nextTick(()=>this.drawEdges())},
drawEdges(){const svg=document.getElementById('networkSvg');if(!svg)return;svg.innerHTML='';
this.edges.forEach(([fromId,toId])=>{const from=this.nodes.find(n=>n.id===fromId);const to=this.nodes.find(n=>n.id===toId);
if(from&&to){const line=document.createElementNS('http://www.w3.org/2000/svg','line');
line.setAttribute('x1',from.x+24);line.setAttribute('y1',from.y+24);line.setAttribute('x2',to.x+24);line.setAttribute('y2',to.y+24);
line.setAttribute('stroke','rgba(99,102,241,0.3)');line.setAttribute('stroke-width','1.5');svg.appendChild(line)}})}}}
</script>
