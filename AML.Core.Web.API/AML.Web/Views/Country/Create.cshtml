@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Country";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}


@model AML.ViewModel.ViewModels.Country.CountryModel
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<style>
    .page {
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border-bottom: 1px solid #dee2e6;
    }

    .card1 {
        max-width: 100%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
        box-shadow: 0 0 #0000, /* fallback ring-offset-shadow */
        0 0 #0000, /* fallback ring-shadow */
        0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .heading {
        font-size: 1.25rem;
    }

    .flex-box {
        display: flex;
        flex-wrap: wrap;
        margin: 10px 0px;
    }

        .flex-box > .flex-item {
            flex: 1 1 150px;
            text-align: center;
        }

    .form-group {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
    }

    .flex-item input {
        width: 90%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    .go {
        background-color: rgb(37,99,235);
        border-radius: 8px;
        padding: 8px 20px;
        color: white;
    }

    .clear {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    .flex-box1 {
        display: flex;
        width: 90%;
        justify-content: flex-end;
    }

    input:focus {
        border: 2px solid rgb(37,99,235) !important;
    }

    select:focus {
        border: 2px solid rgb(37,99,235) !important;
    }

    input, select {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter;
    }

    #isActive {
        display: block;
    }

    input[type="checkbox"] {
        width: 50px;
        height: 50px;
    }
</style>
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
    @@media (max-width: 768px) {
        .page {
            width: 79vw;
        }
    }
</style>
<div class="custom-container page bg-gray-50">
    @* <div class="page-heading">
        <div class="sas-card rounded-card br-10 mb-2 bg-blue head-section">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0 heading"><b>Add New</b></h4>
                <div class="menu-icon">
                    <i class="lni lni-microsoft"></i>
                </div>
            </div>
            <div class="md:block">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </div> *@

    <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-surface">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                Add New
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>

    <div class="sas-card rounded-card mb-2 bg-blue card1 relative">
        <div id="loader" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        </div>

        <!-- /.card-header -->
        <!-- form start -->
        <form role="form" asp-controller="Country" asp-action="Create" class="form-horizontal" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="Id" />
            @*<input type="hidden" asp-for="CreatedBy" />*@
            @*<input type="hidden" asp-for="IsActive" />*@
            <div class="form-contents">
                <div class="row flex-box">
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtCode">Code <span class="text-red-500">*</span></label>
                            <input type="text" asp-for="Code" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCode" maxlength="3" placeholder="Enter code">
                            <span asp-validation-for="Code" class="text-red-500"></span>
                        </div>
                    </div>
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtName">Name <span class="text-red-500">*</span></label>
                            <input type="text" asp-for="Name" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtName" maxlength="100" placeholder="Name">
                            <span asp-validation-for="Name" class="text-red-500"></span>
                        </div>
                    </div>
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtDescription">Description</label>
                            <input type="text" asp-for="Description" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtDescription" maxlength="200" placeholder="Description">
                        </div>
                    </div>
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtRiskRating">Risk Rating</label>
                            <input type="text" asp-for="RiskRating" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtRiskRating" placeholder="Risk Rating">
                        </div>
                    </div>
                </div>
                <div class="row flex-box">
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtFATFRiskRating">FATF Risk Rating</label>
                            <input type="text" asp-for="FATFRiskRating" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtFATFRiskRating" placeholder="FATF Risk Rating">
                        </div>
                    </div>
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtIsoCode">ISO Code</label>
                            <input type="text" asp-for="ISOCode3digit" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtIsoCode" placeholder="ISO Code">
                        </div>
                    </div>
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtRiskScore">Risk Score</label>
                            <input type="text" asp-for="Riskscore" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtRiskScore" placeholder="Risk Score">
                        </div>
                    </div>
                    <div class="col-md-3 flex-item">
                        <div class="form-group">
                            <label for="txtUNCode">UN Code</label>
                            <input type="text" asp-for="UNCode" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtUNCode" placeholder="UN Code">
                        </div>
                    </div>


                </div>
                <div class="d-flex justify-content-start">
                    <div class="col">
                        <label for="txtIsActive" id="isActive">Is Active</label>
                        <input type="checkbox" asp-for="IsActive" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtIsActive">
                    </div>
                </div>
                <!-- /.card-body -->
               
                <div class="flex flex-col md:flex-row justify-center mt-10 gap-4">
                    <button type="submit" class="px-6 py-2 bg-[#2563EB] text-white rounded-md hover:bg-primary-hover">Submit</button>
                    <button type="button" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100 text-center transition duration-200" onclick=" $('#loader').show(); location.href='@Url.Action("Index", "Country")'">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('form').on('submit', function () {
            $('#loader').show();
        });
    });
</script>

