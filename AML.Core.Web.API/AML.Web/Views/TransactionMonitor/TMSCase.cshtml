<script>
        $(document).ready(function () {

            let sortColumn = "tranRefno";
            let sortDirection = "asc";

            let pageSize = parseInt($('#rowsPerPage').val()) || 10;
            let currentPage = 1;
            let totalPages = 1;
            let draw = 1;
            function getColumnIndex(columnName) {
            const columns = ["tranRefno", "tranDate", "customerId","customerName","ruleViolated","statusDescription","createdOn"];
            return columns.indexOf(columnName);
            }


            function fetchData(searchValue = '', page = 1) {
                pageSize = parseInt($('#rowsPerPage').val()) || 10;
                const start = (page - 1) * pageSize;
                $('#loadingeffect').show();
                $.ajax({
                    url: '/tmscase/casemanagement',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
                    },
                    data: {
                        draw: draw++,
                        start: start,
                        length: pageSize,
                        search: { value: searchValue },
                        order: [{
                            column: getColumnIndex(sortColumn),
                            dir: sortDirection
                        }],

                        columns: [
                            // { data: null, orderable: false, searchable: false },
                            { data: "tranRefno" },
                            { data: "tranDate" },
                            { data: "customerId" },
                            { data: "customerName" },
                            { data: "ruleViolated" },
                            { data: "statusDescription" },
                            { data: "createdOn" }
                        ]

                    },
                    success: function (resp) {
                        console.log(resp.data);
                        const rows = resp.data || [];
                        const totalRecords = resp.recordsFiltered || 0;
                        totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));

                        renderTable(rows);
                        renderPager(page);
                    },
                    error: function (xhr) {
                        console.error('Error fetching data:', xhr.statusText);
                    },
                    complete:function(data){
                        $('#loadingeffect').hide();
                    }
                });
            }

            function renderTable(rows) {
                const $tbody = $('#example tbody').empty();

                if (!rows.length) {
                    $tbody.append('<tr><td colspan="5" class="text-center py-4">No data available</td></tr>');
                    return;
                }

                rows.forEach(r => {
                    $tbody.append(`
                        <tr>
                            <td class="px-6 py-4 text-sm">
                                <a class="sas-button px-5 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700" href="/tmscase/caseprocess/${r.tranRefno}">Process</a>
                            </td>
                            <td class="px-6 py-4 text-sm">${r.tranRefno || ''}</td>
                            <td class="px-6 py-4 text-sm">${r.tranDate || ''}</td>
                            <td class="px-6 py-4 text-sm">${r.customerId || ''}</td>
                            <td class="px-6 py-4 text-sm">${r.customerName || ''}</td>
                            <td class="px-6 py-4 text-sm">${r.ruleViolated || ''}</td>
                            <td class="px-6 py-4 text-sm">${r.statusDescription || ''}</td>
                            <td class="px-6 py-4 text-sm">${r.createdOn || ''}</td>
                        </tr>`);
                });
            }

            function renderPager(page) {
                const $pager = $('.pagination-controls').empty();
                if (totalPages <= 1) return;

                const btn = (lbl, pg, disabled, active) =>
                    `<button class="px-3 py-1 border rounded
                        ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
                        ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
                        data-page="${pg}" ${disabled ? 'disabled' : ''}>
                        ${lbl}
                    </button>`;

                $pager.append(btn('First', 1, page === 1));
                $pager.append(btn('Prev', page - 1, page === 1));

                const maxVisible = 5;
                let start = Math.max(1, page - Math.floor(maxVisible / 2));
                let end = start + maxVisible - 1;

                if (end > totalPages) {
                    end = totalPages;
                    start = Math.max(1, end - maxVisible + 1);
                }

                for (let i = start; i <= end; i++) {
                    $pager.append(btn(i, i, false, i === page));
                }

                $pager.append(btn('Next', page + 1, page === totalPages));
                $pager.append(btn('Last', totalPages, page === totalPages));
            }

            $('#rowsPerPage').on('change', () => {
                currentPage = 1;
                fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
            });

            $('input[placeholder="Search anything..."]').on('keyup change', function () {
                currentPage = 1;
                fetchData(this.value, currentPage);
            });

            $('.pagination-controls').on('click', 'button', function () {
                const pg = parseInt($(this).data('page'));
                if (!isNaN(pg) && pg >= 1 && pg <= totalPages) {
                    currentPage = pg;
                    fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
                }
            });

            $('#example thead').on('click', 'th.sortable', function () {
            const selectedColumn = $(this).data('column');

            if (sortColumn === selectedColumn) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = selectedColumn;
                sortDirection = 'asc';
            }

            // Remove active class from all, reset to gray
            $('#example thead th.sortable')
                .removeClass('active asc desc');

            // Add appropriate class to clicked column
            $(this).addClass(`active ${sortDirection}`);

            currentPage = 1;
            fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
            });
                // This sets the initial sort class for column headers
            $('#example thead th.sortable[data-column="' + sortColumn + '"]').addClass(`active ${sortDirection}`);

            // ✅ Fetch initial data
            fetchData('', currentPage);

    });
</script>


