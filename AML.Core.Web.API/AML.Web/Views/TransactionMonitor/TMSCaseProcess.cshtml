<script>
    $(".submitbtn").click(function (e) {
        e.preventDefault();

        $('#loadingeffect').show();

        // Get status from button value
        var val = $(this).val();
        var status = 0;
        if (val === "Approve") status = 1;
        else if (val === "Reject") status = 2;

        $('#hdnStatus').val(status);

        // Collect data
        var caseId = $('#hdnCaseId').val();
        var comments = $('#txtCaseActionRemarks').val();
        console.log(comments);

        $.ajax({
            url: '/tmscase/caseprocess',
            type: 'POST',
            data: $('#frmDocument').serialize(),
            success: function (response) {
                $("input[type=submit], #txtCaseActionRemarks").prop('disabled', true);
                toastr.success(response);
                setTimeout(function () {
                    location.href = '/tmscase';
                }, 3000);
            },
            complete: function (data) {
                console.log(data);
                $('#loadingeffect').hide();
            },
            error: function () {
                toastr.error("An error occurred. Please try again.");
                $('#loadingeffect').hide();
            }
        });
    });
</script>


