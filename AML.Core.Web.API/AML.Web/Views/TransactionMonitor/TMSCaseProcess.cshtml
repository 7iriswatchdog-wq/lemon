                                            <th class="px-4 py-3 text-center w-1/3">@localizer["Remitter Id"]</th>
                                            <th class="px-4 py-3 text-right w-1/3 pl-20 pr-32">@localizer["Amount"]</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-bordercolor">
                                        @for (var i = 0; i < Model.TMSBeneficiaryViewModel.Count; i++)
                                        {
                                            <tr class="border-b hover:bg-appbg">
                                                <td class="px-4 py-3 text-left w-1/3">@Model.TMSBeneficiaryViewModel[i].TranDate</td>
                                                <td class="px-4 py-3 text-center w-1/3">@Model.TMSBeneficiaryViewModel[i].CustomerId</td>
                                                <td class="px-4 py-3 text-right w-1/3 pl-20 pr-32">@Model.TMSBeneficiaryViewModel[i].Amount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

