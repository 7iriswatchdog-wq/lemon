                        <div class="overflow-x-auto">
                            <table class="min-w-full table-auto text-sm text-left">
                                <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                                    <tr class="bg-[#E9EFFD] p-4 rounded-lg mb-4">
                                        <th class="px-4 py-2">@localizer["Transaction Ref.No"]</th>
                                        <th class="px-4 py-2">@localizer["Transaction Date"]</th>
                                        <th class="px-4 py-2">@localizer["Transaction Type"]</th>
                                        <th class="px-4 py-2">@localizer["Remitter Id"]</th>
                                        <th class="px-4 py-2">@localizer["Remitter Name"]</th>
                                        <th class="px-4 py-2">@localizer["Beneficiary Name"]</th>
                                        <th class="px-4 py-2">@localizer["Beneficiary Country"]</th>
                                        <th class="px-4 py-2">@localizer["Status"]</th>
                                        <th class="px-4 py-2">@localizer["Amount"]</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-bordercolor">
                                    @for (var i = 0; i < Model.TMSCaseNewModels.Count; i++)
                                    {
                                        <tr class="border-b hover:bg-appbg">
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].TranRefno</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].TranDate</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].TranType</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].CustomerId</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].CustomerName</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].BeneficiaryName</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].BeneficiaryCountry</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].StatusDescription</td>
                                            <td class="px-4 py-2">@Model.TMSCaseNewModels[i].Amount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Case Action -->
                    <div class="w-full bg-surface rounded-xl shadow-sm p-6 overflow-hidden border border-blue-100">
                        <h3 class="text-xl font-semibold">@localizer["Case Action"]</h3>
                        <div class="py-4 col-span-2">
                            <label class="block text-sm font-medium mb-2">@localizer["Remarks"]</label>
                            <textarea rows="4" class="w-full max-w-xl px-4 py-3 rounded-lg border border-gray-200 placeholder-gray-400 resize-none" id="txtCaseActionRemarks" asp-for="comments" name="comments" placeholder=@localizer["Remarks"]></textarea>
                        </div>

                        <div class="flex flex-col sm:flex-row justify-end space-y-4 sm:space-y-0 sm:space-x-4">
                            <input type="submit" name="Approve" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-6 rounded submitbtn" value=@localizer["Approve"] />
                            <input type="submit" name="Reject" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-6 rounded submitbtn" value=@localizer["Reject"] />
                            <input type="hidden" id="hdnStatus" asp-for="Status" name="Status" value="0" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
