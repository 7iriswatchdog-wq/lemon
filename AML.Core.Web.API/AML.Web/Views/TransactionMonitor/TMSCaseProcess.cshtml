    <nav class="flex items-center px-4 h-[72.8px] border-b w-full">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                @localizer["Manage TMS Case"]
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>

    <div class="h-auto bg-gray-50 items-center  ">

        <div class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4  mx-auto">
            <!-- NAME SCREENING -->
            <div class=" relative w-full bg-surface rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
                <div id="loadingeffect" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
                    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
                </div>
                <form role="form" id="frmDocument" class="space-y-6" enctype="multipart/form-data" method="post">
                    <!-- Case Header -->
                    <div class="w-full bg-surface rounded-xl shadow-sm p-2 overflow-hidden border border-blue-100">
                        @* <div class="bg-surface text-black px-6 py-4 rounded-t-xl">
                            <div class="flex items-center justify-between">
                                <h2 class="font-bold">@localizer["Manage TMS Case"]</h2>
                                <input type="hidden" class="hidden" id="hdnCaseId" asp-for="TranRefno" name="Id">
                            </div>
                        </div> *@
                        <div class="p-6 grid grid-cols-1 lg:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@localizer["Transaction Ref.No"]</label>
                                <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtReportCode" readonly asp-for="TranRefno" name="CustomerId">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@localizer["Transaction Date"]</label>
                                <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtReportCode" readonly asp-for="TranDate" name="TranDate">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@localizer["Rule Violations"]</label>
                                <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRuleViolation" readonly asp-for="RuleViolated" name="RuleViolation">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@localizer["Rule Score"]</label>
                                <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRuleScore" readonly asp-for="TransactionScore">
                            </div>
                        </div>
                    </div>

                    <!-- Remitter and Beneficiary Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 rounded-xl">
                        <!-- Remitter Details -->
                        <div class="w-full bg-surface rounded-xl shadow-sm p-6 overflow-hidden border border-blue-100">
                            <h3 class="font-bold mb-4">@localizer["Remitter Details"]</h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Remitter Id</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRemitterId" asp-for="CustomerId" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Remitter Name</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRemitterName" asp-for="CustomerName" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Remitter Nationality</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRemitterName" asp-for="RemitterNationality" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Risk Score</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRiskScore" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Created on</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtCreatedOn" asp-for="Created_on" readonly>
                                </div>
                            </div>
                        </div>

                        <!-- Beneficiary Details -->
                        <div class="w-full bg-surface rounded-xl shadow-sm p-6 overflow-hidden border border-blue-100">
                            <h3 class="font-bold mb-4">@localizer["Beneficiary Details"]</h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Beneficiary Id</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtBeneficiaryId" asp-for="BeneficiaryId" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Beneficiary Name</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtBeneficiaryName" asp-for="BeneficiaryName" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Beneficiary Nationality</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRiskScore" asp-for="BeneficiaryNationCode" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Risk Score</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtRiskScore" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Created on</label>
                                    <input type="text" class="form-input w-full border-gray-300 rounded-md font-extralight" id="txtCreatedOn" asp-for="Created_on" readonly>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transaction Tables -->
                    <div class="space-y-8">
                        <div class="w-full bg-surface rounded-xl shadow-sm p-6 overflow-hidden border border-blue-100">
                            <h3 class="font-semibold mb-4">@localizer["Last Transactions of Remitter"]</h3>
                            <div class="overflow-x-auto">
                                <table class="min-w-full table-auto text-sm text-left">
                                    <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                                        <tr class="bg-[#E9EFFD] p-4 rounded-lg mb-4 ">
                                            <th class="px-4 py-3">@localizer["Transaction Date"]</th>
                                            <th class="px-4 py-3">@localizer["Beneficiary Id"]</th>
                                            <th class="px-4 py-3">@localizer["Beneficiary Country"]</th>
                                            <th class="px-4 py-3">@localizer["Amount"]</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-bordercolor">
                                        @for (var i = 0; i < Model.TMSCaseViewModel.Count; i++)
                                        {
                                            <tr class="border-b hover:bg-appbg">
                                                <td class="px-4 py-3">@Model.TMSCaseViewModel[i].TranDate</td>
                                                <td class="px-4 py-3">@Model.TMSCaseViewModel[i].BeneficiaryName</td>
                                                <td class="px-4 py-3">@Model.TMSCaseViewModel[i].BeneficiaryCountry</td>
                                                <td class="px-4 py-3">@Model.TMSCaseViewModel[i].Amount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="w-full bg-surface rounded-xl shadow-sm p-6 overflow-hidden border border-blue-100">
                            <h3 class="font-semibold mb-4">@localizer["Last Transactions of Beneficiary"]</h3>
                            <div class="overflow-x-auto">
                                <table class="min-w-full table-auto text-sm text-left">
                                    <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                                        <tr class="bg-[#E9EFFD] p-4 rounded-lg mb-4">
