                                            <td class="px-4 py-3">@Model.TMSCaseExclusiveModel[i].TranType</td>
                                            <td class="px-4 py-3">@Model.TMSCaseExclusiveModel[i].CustomerName</td>
                                            <td class="px-4 py-3">@Model.TMSCaseExclusiveModel[i].BeneficiaryName</td>
                                            <td class="px-4 py-3">@Model.TMSCaseExclusiveModel[i].BeneficiaryCountry</td>
                                            <td class="px-4 py-3">@Model.TMSCaseExclusiveModel[i].Amount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

