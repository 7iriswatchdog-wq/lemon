    function addSubcategoryRow() {
        // array for header.
        var x = document.getElementById('dvRiskSubcategoryList');
        x.style.display = "block";
        var z = document.getElementById('btnTypeSubmit');
        z.style.display = "block";
        var y = document.getElementById('divRiskType');
        y.style.display = "block";
        var empTab = document.getElementById('RiskTypeSubcategoryList');
