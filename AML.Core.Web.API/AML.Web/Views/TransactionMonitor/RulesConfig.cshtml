    function getRiskTypeCategory(riskCategoryID) {
        $.ajax({

            url: '/TransactionMonitor/GetRiskCategoryTypes',
            type: 'GET',
            data: {
                'riskCategoryID': riskCategoryID
            },
            dataType: 'json',
            beforeSend: function () {
                // Show image container
                $(".se-pre-con").show();
                $(".card-header").fadeOut()
            },


            success: function (data) {
                var item = '';
                $('#ddlRiskTypeCategory').empty();
                item += "<option value='0'>--@localizer["Select"]--</option>";
                $.each(data, function (i, riskCategoryTypes) {
                    item += "<option value='" + riskCategoryTypes.value + "'>" + riskCategoryTypes.text + "</option>";
                });
                $('#ddlRiskTypeCategory').html(item);
            },
            error: function (request, error) {
                alert("Request: " + JSON.stringify(request));
            },


            complete: function (data) {
                $(".se-pre-con").fadeOut();
                $(".card-header").show()
            }
        });
    }
