    function LoadTable(riskTypeID) {
        var table = $('#availableRiskItems').DataTable({
            "serverSide": true,
            "processing": true,
            "filter": false,
            "iDisplayLength": 10,
            "destroy": true,
            ajax: {
                url: '/TransactionMonitor/custompaginationRiskItems',
                type: 'POST',
                data: {
                    'riskTypeID': riskTypeID
                }
            },
            columns: [
                {
                    "render": function (data, type, full, meta) {
                        var colHtml = '<input type="text" value="' + full.lovRiskData + '" name="AvailableItems[' + meta.row + '].RiskItem" maxlength="500" onkeypress="alphaNumericCheck(event)" />';
                        colHtml += '<input type="hidden" value="' + full.id + '" name="AvailableItems[' + meta.row + '].Id" />';
                        return colHtml;
                    }
                }, {
                    "render": function (data, type, full, meta) {
                        //var colHtml = '<input type="text" value="' + full.lovRiskScore + '" name="AvailableItems[' + meta.row + '].RiskScore" />';
                        
                        var colHtml = '<input type="text" value="' + full.lovRiskScore + '" name="AvailableItems[' + meta.row + '].RiskScore" />';
                        return colHtml;
                        
                    }
                }, {
                    "render": function (data, type, full, meta) {
                        var colHtml = '<input type="text" value="' + full.overrideScore + '" name="AvailableItems[' + meta.row + '].OverrideScore" />';
                        return colHtml;
                    }
                }, {
                    "render": function (data, type, full, meta) {
                        var colHtml = '';
                        if (full.isActive == 'True') {
                            colHtml = '<input type="checkbox" onchange="ChangeStatus(' + meta.row + ',this);" checked />';
                            colHtml += '<input type="hidden" value="true" name="AvailableItems[' + meta.row + '].isActive" />';
                        }
                        else {
                            colHtml = '<input type="checkbox" onchange="ChangeStatus(' + meta.row + ', this);" />';
                            colHtml += '<input type="hidden" value="false" name="AvailableItems[' + meta.row + '].isActive" />';
                        }

                        return colHtml;
                    }
                }
            ]
        });
    }
