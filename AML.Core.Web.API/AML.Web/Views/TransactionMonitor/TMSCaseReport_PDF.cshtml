@model AML.ViewModel.ViewModels.TransactionMonitor.TMSReportModel
@using Microsoft.AspNetCore.Http
@{
    Layout = "_PdfLayout";
    ViewData["PdfTitle"] = "TMS Case Report";
    ViewData["PdfSubtitle"] = "Transaction Monitoring Details";
    var startDate = ViewBag.StartDate as string ?? "All";
    var endDate = ViewBag.EndDate as string ?? "All";
}

<div class="mt-4 text-[8px] text-slate-400 space-y-0.5 font-bold uppercase tracking-tight mb-8">
    <p>Date Range: @startDate to @endDate</p>
    <p>Total Records: @Model.TotalRows</p>
</div>

<div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-slate-50 border-b-2 border-slate-200 text-slate-500 uppercase tracking-wider font-bold text-[8px]">
                <th class="px-2 py-3 w-[5%]">#</th>
                <th class="px-2 py-3 w-[15%]">Creation Date</th>
                <th class="px-2 py-3 w-[15%]">Customer ID</th>
                <th class="px-2 py-3 w-[25%]">Customer Name</th>
                <th class="px-2 py-3 w-[20%]">Rule Violated</th>
                <th class="px-2 py-3 w-[10%]">Case Status</th>
                <th class="px-2 py-3 w-[10%]">Created By</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @if (Model.TMSCaseModels != null && Model.TMSCaseModels.Any())
            {
                var count = 1;
                foreach (var item in Model.TMSCaseModels)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-2 py-3 text-slate-600 font-medium border-l-2 border-slate-100 uppercase text-[8px]">@count</td>
                        <td class="px-2 py-3 text-slate-700 font-medium">@item.CreatedOn</td>
                        <td class="px-2 py-3 font-bold text-slate-900 whitespace-nowrap">@item.CustomerId</td>
                        <td class="px-2 py-3 text-slate-700">@item.CustomerName</td>
                        <td class="px-2 py-3 text-slate-600 text-[8px] break-all">@item.RuleViolatedText</td>
                        <td class="px-2 py-3 text-center">
                            @{
                                var statusClass = "bg-slate-100 text-slate-800 border-slate-200";
                                if (item.UpdatedStatus == "Pending") statusClass = "bg-yellow-100 text-yellow-800 border-yellow-200";
                                else if (item.UpdatedStatus == "Approved") statusClass = "bg-blue-100 text-blue-800 border-blue-200";
                                else if (item.UpdatedStatus == "Rejected") statusClass = "bg-red-100 text-red-800 border-red-200";
                            }
                            <span class="inline-flex w-full items-center justify-center px-1.5 py-1 rounded-full text-[7px] font-bold @statusClass border uppercase tracking-tighter">@item.UpdatedStatus</span>
                        </td>
                        <td class="px-2 py-3 text-slate-600 font-medium">@item.UpdatedByUSer</td>
                    </tr>
                    count++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="px-2 py-12 text-center text-slate-400 italic font-medium">No TMS records found matching filters.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
