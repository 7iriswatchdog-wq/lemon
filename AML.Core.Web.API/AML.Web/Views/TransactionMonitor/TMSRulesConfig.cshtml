                    @*<option value='='>&equals; (is equal to)</option>
                    <option value='!='>&ne; (is not equal to)</option>
                    <option value='>'>&gt; (is greater than)</option>
                    <option value='>='>&ge; (is greater or equal to)</option>
                    <option value='<'>&lt; (is less than)</option>
                    <option value='<='>&le; (is less or equal to)</option>
                    <option value='RANGE' style="display:none;">≤ x ≤ (is in range)</option>
                    <option value='NOT_IN_RANGE' style="display:none;">≰ x ≰ (is not in range)</option>
                    <option value='EXISTS'>&#8707; (exists)</option>
                    <option value='NOT EXISTS'>&#8708; (not exists)</option>
                    <option value="ILIKE">&supe; (contains)</option>
                    <option value="NOT ILIKE">&#8837; (does not contain)</option>
                    <option value="IN">&#8712; (is either)</option>
                    <option value="NOT IN">&notin; (is neither)</option>
                    <option value="LISTED ON">is listed on</option> *@                 
                </select>
                </div>
            </div>
       </div>

         <div class="form-group row">
