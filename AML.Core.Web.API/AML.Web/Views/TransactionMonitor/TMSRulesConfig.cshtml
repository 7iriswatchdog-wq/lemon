</div>
        

<script type="text/javascript">

$('#sentencetype').change(function () {
  
        if ($('#sentencetype :selected').val() == "datamatch") {
           
            var x = document.getElementById('type-datamatch');
            //$('#ddlBusinessTypehdn').val('');
            x.style.display = "";
        }
        else {
            var x = document.getElementById('type-datamatch');
            x.style.display = "none";

            //$('#ddlBusinessTypehdn').val($('#ddlBusinessType :selected').text());
        }
        
        if ($('#sentencetype :selected').val() == "datamatch") {
           
            var x = document.getElementById('compare-operation');
            x.style.display = "";
            var y = document.getElementById('operation');

            var text1 = "";
            var text2 = "";
            var result = "";

            y.options[0] = new Option ("Select the Operator", "Select" );
            
            text1 = decodeURIComponent('%3D');
            text2 =  " (is equal to)";
            result = text1.concat(" ", text2);

            y.options[1] = new Option (result, "=" );
             //y.options[0] = new Option (" (is equal to)", "=" );

            text1 = decodeURIComponent('!%3D');
            text2 =  " (is not equal to)";
            result = text1.concat(" ", text2);

            y.options[2] = new Option (result, "=" );


        }
        else {
            var x = document.getElementById('compare-operation');
            x.style.display = "none";

            //$('#ddlBusinessTypehdn').val($('#ddlBusinessType :selected').text());
        }
 });

</script>


   
  