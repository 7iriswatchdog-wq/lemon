@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = localizer["Manage Case"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
@model AML.ViewModel.ViewModels.TransactionMonitor.TMSCase
<form role="form" id="frmDocument" class="form-horizontal" enctype="multipart/form-data" method="post">
    <div class="card card-primary">
        <div class="px-6 py-4 border-b border-bordercolor">
            <div class="row">
                <div class="col">
                    <b>@localizer["Manage Case"]</b>
                    <input type="hidden" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="hdnCaseId" asp-for="TranRefno" name="Id">
                </div>
            </div>
        </div>
        <div class="p-6">
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label for="txtTxnRefNo">@localizer["Transaction Ref.No"]</label>
                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtTxnRefNo" readonly asp-for="TranRefno" name="CustomerId" placeholder=@localizer["Transaction Ref.No"]>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="txtCustId">@localizer["Customer Id"]</label>
                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCustId" readonly asp-for="CustomerId" name="CustomerId" placeholder=@localizer["Customer Id"]>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="txtCustName">@localizer["Customer Name"]</label>
                        <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCustName" readonly asp-for="CustomerName" name="CustomerName" placeholder=@localizer["Customer Name"]>
                    </div>
                </div>

            </div>


            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label for="txtReportIndicators">@localizer["Rule Violations"]</label>
                        <textarea rows="3" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="RuleViolated" readonly></textarea>
                    </div>
                </div>
            </div>

        </div>
        <div class="card card-primary">
            <div class="px-6 py-4 border-b border-bordercolor">
                <div class="row">
                    <div class="col">
                        <b>@localizer["TRANSACTION DETAILS"]</b>
                    </div>
                </div>
            </div>
            <div class="p-6" style="overflow-y:scroll;">
                <table  id="data-table" class="w-full text-sm text-left" cellspacing="0">
                    <thead >
                        <tr>
                            <th>
                                @localizer["Transaction Ref.No"]
                                 
                            </th>
                            <th>
                                @localizer["Transaction Date"]
                            </th>
                            <th>
                                @localizer["Transaction Type"]
                            </th>
                            <th>
                                @localizer["Remitter Id"]
                            </th>
                            <th>
                                @localizer["Remitter Name"]
                            </th>
                            <th>
                                @localizer["BeneficiaryName"]
                            </th>
                            <th>
                                @localizer["Beneficiary Country"]
                            </th>
                           <th>
                                @localizer["Status"]
                            </th>
                            <th>
                                @localizer["Amount"]
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-bordercolor">

                        @for (var i = 0; i < Model.TMSCaseNewModels.Count; i++)
                        {
                        <tr>
                            <td>
                                 <a href=/tmscasereport/caseprocess/@Model.TMSCaseNewModels[i].TranRefno>@Model.TMSCaseNewModels[i].TranRefno</a>
                                
                             <td>
                                @Model.TMSCaseNewModels[i].TranDate
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].TranType
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].CustomerId
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].CustomerName
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].BeneficiaryName
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].BeneficiaryCountry
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].StatusDescription
                            </td>
                            <td>
                                @Model.TMSCaseNewModels[i].Amount
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="p-6">
            <h3>@localizer["Case Action"]</h3>
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label for="txtDescription">@localizer["Remarks"]</label>
                        <textarea rows="3" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="txtCaseActionRemarks" asp-for="comments" name="comments" placeholder=@localizer["Remarks"]></textarea>
                    </div>
                </div>
            </div>
           @* <input type="submit" name="Approve" class="btn btn-success submitbtn" value=@localizer["Approve"] />
            <input type="submit" name="Reject" class="btn btn-danger submitbtn" value=@localizer["Reject"] />*@
            <input type="hidden" id="hdnStatus" asp-for="Status" name="Status" value="0" />
        </div>
</form>
<script>
    $(".submitbtn").click(function (e) {
        e.preventDefault();
        var val = $(this).val();
        var status = 0;
        if (val == "Approve") {
            status = 1;
        } else if (val == "Reject") {
            status = 2;
        }
        $('#hdnStatus').val(status);
        var caseId = $('#hdnCaseId').val();
        var comments = $('#txtCaseActionRemarks').val();
        console.log(comments);
        $('#hdnCaseId').val(caseId);
        $.ajax({
            url: '/tmscase/caseprocess',
            type: 'post',
            data: $('#frmDocument').serialize(),
            success: function (response) {
                $("input[type=submit]").attr('disabled', 'disabled');
                $('#txtCaseActionRemarks').attr('disabled', 'disabled');
                toastr.success(response);
                setTimeout(function () { location.href = '/tmscase'; }, 3000);
                location.href = '/tmscase';
            }
        });
    });
</script>