                <!-- ─────────────────────  Card Container  ───────────────────── -->
                <div id="createrule" class="w-full bg-surface rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
                    <div class="space-y-6">
                        <!-- inner sentence-edit wrapper → vertical spacing -->
                        <!-- Header row -->
                        <div class="flex items-center justify-between">
                            <h3 class="text-xl font-semibold">Rule parameters</h3>
                            <!-- Empty <div class="col"> was removed (no content) -->
                        </div>

                        <!-- ─────────────── Parameter‑type row ─────────────── -->
                        <div class="flex flex-wrap items-center gap-4">
                            <label for="parametertype" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Rule parameter type <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3 ">
                                <select id="parametertype" onchange="myfunction();getText();"
                                        class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md">
                                    <option value="">Select a parameter type</option>
                                    <option value="MATCH">Data match</option>
                                    <option value="COMP">Compare</option>
                                    <option value="TF">Velocity</option>
                                </select>
                            </div>
                        </div>

                        <!-- ─────────────── Source Field (Data match) ─────────────── -->
                        <div id="datafield" style="display:none;" class="flex flex-wrap items-center gap-4">
                            <label for="datafielddatamatch" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Source Field <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <select id="datafielddatamatch" onchange="getText();datafieldfunction();"
                                        asp-items="@Model.TMSHeaderMapScreennames"
                                        class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                    <option value="0">-- @localizer["EMPTY"] --</option>
                                </select>
                            </div>
                        </div>

                        <!-- ─────────────── Velocity Aggregate block ─────────────── -->
                        <div id="aggregate" style="display:none;" class="space-y-6">
                            <!-- Source Aggregate -->
                            <div class="flex flex-wrap items-center gap-4">
                                <label for="aggregatevelocity" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                    Source Aggregate <span class="text-red-500">*</span>
                                </label>
                                <div class="w-full md:w-1/2 lg:w-1/3">
                                    <select id="aggregatevelocity" onchange="getText();datafieldfunction();"
                                            class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                        <option value="Average">Average</option>
                                        <option value="AverageIf">Average if</option>
                                        <option value="Count">Count</option>
                                        <option value="CountIf">Count if</option>
                                        <option value="CountDistinct">Count Distinct</option>
                                        <option value="CountDistinctIf">Count Distinct if</option>
                                        <option value="Sum">Sum</option>
                                        <option value="SumIf">Sum if</option>
                                        <option value="Max">Max</option>
                                        <option value="MaxIf">Max if</option>
                                        <option value="Min">Min</option>
                                        <option value="MinIf">Min if</option>
                                        <option value="None" selected>None</option>
                                    </select>
                                </div>
                            </div>

                            <!-- If‑source‑field -->
                            <div class="flex flex-wrap items-center gap-4 if-source-fields">
                                <label for="datafieldDatamatchSourceIf" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                    If source field <span class="text-red-500">*</span>
                                </label>
                                <div class="w-full md:w-1/2 lg:w-1/3">
                                    <select id="datafieldDatamatchSourceIf" onchange="getText();datafieldfunction();"
                                            asp-items="@Model.TMSHeaderMapScreennames"
                                            class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                        <option value="0">-- @localizer["EMPTY"] --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- If‑target‑aggregate -->
                            <div class="flex flex-wrap items-center gap-4 if-source-fields">
                                <label for="aggregatevelocityIfSource" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                    If target aggregate <span class="text-red-500">*</span>
                                </label>
                                <div class="w-full md:w-1/2 lg:w-1/3">
                                    <select id="aggregatevelocityIfSource" onchange="getText();"
                                            class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                        <option value="">Not selected</option>
                                        <option value="Max">Max</option>
                                        <option value="Min">Min</option>
                                        <option value="None">None</option>
                                    </select>
                                </div>
                            </div>

                            <!-- If‑source‑operator -->
                            <div class="flex flex-wrap items-center gap-4 if-source-fields">
                                <label for="datamatchOperatorSourceIf" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                    If source operator <span class="text-red-500">*</span>
                                </label>
                                <div class="w-full md:w-1/2 lg:w-1/3">
                                    <select id="datamatchOperatorSourceIf" onchange="getText();"
                                            class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                        <option value="">Not Selected</option>
                                        <option value="EqualTo">Is Equal To</option>
                                        <option value="NotEqualTo">Is Not Equal To</option>
                                        <option value="GreaterThan">Is Greater Than</option>
                                        <option value="GreaterThanEqual">Is Greater Than Or Equal To</option>
                                        <option value="LessThan">Is Less Than</option>
                                        <option value="LessThanEqual">Is Less Than Or Equal To</option>
                                    </select>
                                </div>
                            </div>

                            <!-- If‑value -->
                            <div class="flex flex-wrap items-center gap-4 if-source-fields" id="compare-value">
                                <label for="valueDataSourceIf" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                    If value <span class="text-red-500">*</span>
                                </label>
                                <div class="w-full md:w-1/2 lg:w-1/3">
                                    <input id="valueDataSourceIf" type="text" onkeyup="getText();"
                                           class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md " />
                                </div>
                            </div>
                        </div>

                        <!-- ─────────────── Operator (Compare) ─────────────── -->
                        <div id="operator" style="display:none;" class="flex flex-wrap items-center gap-4">
                            <label for="datamatchoperator" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Operator <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <select id="datamatchoperator" onchange="getText();"
                                        class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                    <option value="">Not Selected</option>
                                    <option value="EqualTo">Is Equal To</option>
                                    <option value="NotEqualTo">Is Not Equal To</option>
                                    <option value="GreaterThan">Is Greater Than</option>
                                    <option value="GreaterThanEqual">Is Greater Than Or Equal To</option>
                                    <option value="LessThan">Is Less Than</option>
                                    <option value="LessThanEqual">Is Less Than Or Equal To</option>
                                </select>
                            </div>
                        </div>

                        <!-- ⚠️  Many additional blocks remain (compare‑to, time frame, target aggregate, etc.).
                             Follow the same pattern: use flex + gap‑4, w-full for small screens,
                             md:w-1/3 (≈col-4) or md:w-5/12 (≈col-md-5).
                             Keep IDs + inline style="display:none" so existing JS keeps toggling visibility.  -->
                        <!-- ───── Compare‑To (Field vs Data Match) ───── -->
                        <div id="compareto_remitter_id" style="display:none;" class="md:flex md:flex-wrap md:items-center md:gap-4 mt-3">
                            <label for="comparetodatamatch" class="md:w-1/3 text-sm font-medium text-gray-700">
                                Compare To <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <select id="comparetodatamatch" onchange="getText();"
                                        asp-items="@Model.TMSHeaderMapScreennames"
                                        class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                    <option value="0">--@localizer["EMPTY"]--</option>
                                </select>
                            </div>
                        </div>

                        <!-- ───── Data‑Match Value (free‑text) ───── -->
                        <div id="datamatchvalue" style="display:none;" class="md:flex md:flex-wrap md:items-center md:gap-4 mt-3">
                            <label for="valuedata" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Value <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <input id="valuedata" type="text" onkeyup="getText();"
                                       class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md " />
                            </div>
                        </div>

                        <!-- ───── Time Frame Source (Velocity) ───── -->
                        <div id="past_field" style="display:none;" class="md:flex md:flex-wrap md:items-center md:gap-4 mt-3">
                            <label for="pastfieldvelocity" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Time Frame Source <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <select id="pastfieldvelocity" onchange="myfunction();getText();"
                                        class="w-full px-3 py-2 border border-gray-300 rounded-md ">
                                    <option value="">Select a parameter type</option>
                                    <option value="TranDate" selected>Remittance Date</option>
                                </select>
                            </div>
                        </div>

                        <!-- ───── Time Frame Value + Unit ───── -->
                        <div id="time_frame" style="display:none;" class="md:flex md:flex-wrap md:items-center md:gap-4 mt-3">
                            <label for="timeframevelocity" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Time Frame <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3 space-y-2">
                                <input id="timeframevelocity" onkeyup="getText();"
                                       class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md " />
                                <select id="timetypevelocity" class="w-full px-3 py-2 border border-gray-300 rounded-md ">
                                    <option value="">Not Selected</option>
                                    <option value="Seconds">Seconds</option>
                                    <option value="Minutes">Minutes</option>
                                    <option value="Hours">Hours</option>
                                    <option value="Days" selected>Days</option>
                                </select>
                            </div>
                        </div>

                        <!-- ───── Compare‑to Radio Group ───── -->
                        <div id="Compar_to" style="display:none;" class="md:flex md:flex-wrap md:items-center md:gap-4 mt-3">
                            <span class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Compare to <span class="text-red-500">*</span>
                            </span>
                            <div class="w-full md:w-1/2 lg:w-1/3 space-x-2">
                                <label class="inline-flex items-center gap-2"><input type="radio" class="compareto_type" name="compareto" value="Field" id="comparetopresentfield" onchange="ComparedFields(this.id);datafieldfunction();"> Target field</label>
                                <label class="inline-flex items-center gap-2"><input type="radio" class="compareto_type" name="compareto" value="Value" id="comparetonumber" onchange="ComparedFields(this.id);datafieldfunction();"> Value</label>
                                <label class="inline-flex items-center gap-2"><input type="radio" class="compareto_type" name="compareto" value="Time" id="comparetosecondtimeframe" onchange="ComparedFields(this.id);datafieldfunction();"> Second time frame</label>
                            </div>
                        </div>

                        <!-- ───── Present / Target Field ───── -->
                        <div id="presentfield" style="display:none;" class="md:flex md:flex-wrap md:items-center md:gap-4 mt-3">
                            <label for="presentfieldvelocity" class="w-full md:w-1/3 text-sm font-medium text-gray-700">
                                Target Field <span class="text-red-500">*</span>
                            </label>
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <select id="presentfieldvelocity" onchange="getText();"
                                        asp-items="@Model.TMSHeaderMapScreennames"
                                        class="valuefields w-full px-3 py-2 border border-gray-300 rounded-md ">
                                    <option value="0">-- @localizer["EMPTY"] --</option>
                                </select>
                            </div>
                        </div>

                        <!-- ───── Velocity Numeric Value ───── -->
