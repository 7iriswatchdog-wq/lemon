@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "TMS Case Report";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.TransactionMonitor.TMSReportModel
<script src="~/plugins/jquery/jquery.min.js"></script>
<div class="card card-primary">
    <div class="px-6 py-4 border-b border-bordercolor">
        @localizer["Transaction Monitor Case Report"]
    </div>
    <div class="p-6">
        <div class="row">
            <div class="col-sm">
                <div class="form-group">
                    <label for="dtFromDate">@localizer["From Date"]</label>
                    <input type="date" asp-for="FromDt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtFromDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder="From Date">
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="dtToDate">@localizer["To Date"]</label>
                    <input type="date" asp-for="ToDt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtToDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))" placeholder="To Date">
                    @*<input type="date" asp-for="ToDt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtToDate" min="@(DateTime.Now.ToString("yyyy-MM-dd"))" max="3000-12-31" placeholder="To Date">*@
                    <span asp-validation-for="ToDt" class="text-danger"></span>
                </div>
            </div>

        </div>
    </div>
    <!-- /.card-body -->

    <div class="card-footer fc-center">
        <button type="submit" id="btnSearch" class="btn btn-primary center" onclick="LoadTable();" title="@localizer["Search"]" aria-label="@localizer["Search"]"><i class="fas fa-search"></i></button>
    </div>
    <!--/form-->
</div>
<div class="bg-surface rounded-xl border border-bordercolor shadow-none mb-4">
    <div class="px-6 py-4 border-b border-bordercolor">
        <h3 class="card-title">@localizer["Search Results"]</h3>
    </div>
    <div class="card-body table-responsive p-2">
        <button type="button" onclick="ExportList(true);" title="@localizer["Export to PDF"]" class="btn btn-default mb-2" style="background-color:#f8f9fa;border-color:#ddd;"><i class="fas fa-file-pdf"></i></button>
        <button type="button" onclick="ExportList(false);" title="@localizer["Export to Excel"]" class="btn btn-default mb-2" style="background-color:#f8f9fa;border-color:#ddd;"><i class="fas fa-file-excel-o"></i></button>
        <table id="tmsReportTbl" class="w-full text-sm text-left" cellspacing="0">
            <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                <tr>
                    <th>@localizer["Customer Id"]</th>
                    <th>@localizer["Customer Name"]</th>
                    <th>@localizer["Created On"]</th>
                    <th>@localizer["Rule Violated"]</th>
                    <th>@localizer["Status"]</th>
                    <th>@localizer["Action"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        LoadTable();
    });
    function LoadTable() {
        var fromDate = $('#dtFromDate').val();
        var toDate = $('#dtToDate').val();
        table = $('#tmsReportTbl').DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "order": [[0, 'asc']], // default sorting column(1 = "id") and sorting order
            "iDisplayLength": 25,
            "destroy": true,
            "ajax": {
                "url": "/TransactionMonitor/TMSReportCustomPagination",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "fromDate": fromDate,
                    "toDate": toDate

                }
            },
            "columns": [
                { data: "customerId" },
                {
                    data: "customerName"
                },
                { data: "createdOn" },
                { data: "ruleViolatedText" },
                { data: "updatedStatus" },
                {
                    "data": "view", "name": "View", "autoWidth": true,
                    "render": function (data, type, row) {
                        return '<a class="btn btn-info btn-sm" title="View" href="ViewTMSReport?id=' + row.id + '"><i class="fas fa-eye"></i></a>';
                    }
                }
            ]

        });
    }
    function ExportList(isPDF) {
        $.ajax({
            type: "GET",
            url: "/TransactionMonitor/ExportTMSCaseReport/",
            data: {
                startDate: $('#dtFromDate').val(), // < note use of 'this' here
                endDate: $("#dtToDate").val(),
                IsPDF: isPDF
            },
            success: function (data) {

                window.location = '/TransactionMonitor/ExportTMSCaseReport?startDate=' + $('#dtFromDate').val() + '&endDate=' + $("#dtToDate").val() + '&IsPDF=' + isPDF;
            },
            error: function (result) {
                alert('error');
            }
        });
    }
</script>