            let currentSortColumn = 0; // Default sort by Code
        let currentSortDirection = 'asc'; // Default sort direction

        // Add this function
        function sortTable(columnIndex) {
            // Reset all sort icons
            $('#example th').removeClass('sort-asc sort-desc');
            $('#example th i.fa-sort').css('color', '#ccc');

            // If clicking the same column, toggle direction
            if (currentSortColumn === columnIndex) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                // New column, default to ascending
                currentSortColumn = columnIndex;
                currentSortDirection = 'asc';
            }

            // Update the sort icon for the current column
            const $header = $('#example th').eq(columnIndex);
            $header.addClass(`sort-${currentSortDirection}`);
            $header.find('i.fa-sort').css('color', '#2563eb');

            // Reload the data with new sorting
            fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
        }

        // Add this function to update sort icons
        function updateSortIcons() {
            $('#example th').removeClass('sort-asc sort-desc');
            $('#example th i.fa-sort').css('color', '#ccc');

            const $header = $('#example th').eq(currentSortColumn);
            $header.addClass(`sort-${currentSortDirection}`);
            $header.find('i.fa-sort').css('color', '#2563eb');
        }
            let pageSize = parseInt($('#rowsPerPage').val()) || 10;
                let currentPage = 1;
                let totalPages = 1;
                let draw = 1;

                function fetchData(searchValue = '', page = 1) {
                    $('#loader').show();
                    pageSize = parseInt($('#rowsPerPage').val()) || 10;
                    const start = (page - 1) * pageSize;

                    $.ajax({
                        url: '/visatype/custompagination',
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
                        },
                        data: {
                            draw: draw++,
                            start: start,
                                length: pageSize,
                            search: { value: searchValue },
                                orderColumn: currentSortColumn,
                        orderDirection: currentSortDirection,
                            columns: [
                                { data: "code" },
                                { data: "name" },
                                { data: "description" }
                            ]
                        },
                        success: function (resp) {
                            const rows = resp.data || [];
                            const totalRecords = resp.recordsFiltered || 0;
                            totalPages = Math.max(1, Math.ceil((totalRecords * 1.0) / pageSize));
                            console.log(totalRecords);

                            renderTable(rows);
                            renderPager(page);
                        },
                        error: function (xhr) {
                            console.error('Error fetching data:', xhr.statusText);
                        },
                        complete: function () {
                            $('#loader').hide(); // Hide loader when request is complete
                        }
                    });
                }

