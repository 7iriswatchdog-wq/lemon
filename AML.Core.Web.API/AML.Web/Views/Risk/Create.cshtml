<script>


            $(document).ready(function () {

            // Initialize Select2
            $("#ddlCustomer").select2({
                placeholder: "Select Customer",
                allowClear: true,
                minimumResultsForSearch: Infinity,
                data: [] // start empty
            });

            clearSelect2Input(); // Ensure input is blank
            loadLatestRecords(); // Load latest 10 initially

            // Add custom search input + button inside dropdown
            $("#ddlCustomer").on('select2:open', function () {
                const $dropdown = $(".select2-dropdown");

                // Prevent duplicate input bar
                if ($dropdown.length && !$dropdown.find(".custom-search-container").length) {
                    const $customContainer = $(`
                        <span class="custom-search-container"
                              style="display:flex; align-items:center; padding:5px;">
                            <input type="text" class="custom-search-input"
                                   placeholder="Enter name and code"
                                   style="flex:1; padding:10px;  color:black;
                                          border-radius:10px; margin-top:5px; border:1px solid Black;" />
                                <button type="button" class="custom-search-btn bg-primary"
                                    style="margin-left:5px; padding:8px 12px; cursor:pointer;
                                           border-radius:10px;color:white">
                                Search
                            </button>
                        </span>
                    `);
                    $dropdown.prepend($customContainer);
                }
            });

            // Handle search button click
            $(document).on('click', '.custom-search-btn', function () {
                const searchText = $(".custom-search-input").val().trim();
                performSearch(searchText);
            });

            // Detect input clear to reload latest 10
            $(document).on('input', '.custom-search-input', function () {
                const searchText = $(this).val().trim();
                if (searchText === "") {
                    loadLatestRecords(true); // pass flag to reopen dropdown
                }
            });

            // Log selected
            $("#ddlCustomer").on('select2:select', function (e) {
                console.log("Selected:", e.params.data.text);
            });
        });


        // --- Utility: Clear Select2 text ---
        function clearSelect2Input() {
            $("#ddlCustomer").val("").trigger('change.select2');
            $("#select2-ddlCustomer-container")
                .text("--@localizer["EMPTY"]--") // or replace with @localizer if needed
                .attr("title", "");
        }


        // --- Function: Perform search ---
        function performSearch(searchText) {
            $.ajax({
                url: '/Risk/GetcustomerRecords',
                type: 'GET',
                dataType: 'json',
                data: { cust_type: 'I', searchTerm: searchText },
                success: function (data) {
                    $("#ddlCustomer").find("option:not(:first)").remove();

                    if (data.length === 0) {
                        const option = new Option("No records found", "", false, false);
                        $("#ddlCustomer").append(option);
                    } else {
                        data.forEach(function (item) {
                            const option = new Option(item.fullName, item.id, false, false);
                            $("#ddlCustomer").append(option);
                        });
                    }

                    clearSelect2Input();
                    $("#ddlCustomer").select2('close').select2('open'); // refresh dropdown
                }
            });
        }


        // --- Function: Load latest 10 records ---
        function loadLatestRecords(reopen = false) {
            $.ajax({
                url: '/Risk/GetLatestCustomerRecords',
                type: 'GET',
                dataType: 'json',
                data: { cust_type: 'I', limit: 10 },
                success: function (data) {
                    $("#ddlCustomer").find("option:not(:first)").remove();

                    data.forEach(function (item) {
                        const option = new Option(item.fullName, item.id, false, false);
                        $("#ddlCustomer").append(option);
                    });

                    clearSelect2Input();

                    if (reopen) {
                        $("#ddlCustomer").select2('close').select2('open'); // re-display list instantly
                    }
                }
            });
        }

