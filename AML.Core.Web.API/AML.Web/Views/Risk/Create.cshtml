            function ItemChange(a, data) {
            const scoreBtn = $('#clrScore_' + a);

            const val = $("#ddlItem_" + a + " option:selected").val();

            if (!val) {
                // Reset to gray for empty selection
                scoreBtn.removeClass('bg-green-500 bg-yellow-400 bg-red-400 pulse-button');
                scoreBtn.addClass('bg-gray-300');
                scoreBtn.text(0);
                $('#clrScorehdn_' + a).val(0);
                OverRideVariables[a] = false;
                calculateTotal(); // Still recalculate totals!
                return;
            }

            const score = val.split("|");
            const selectedVal = score[0];
            const overrideScore = score[1];
            const selectedItemId = score[2];

            $('#RiskItemTxt_' + a).val($("#ddlItem_" + a + " option:selected").text());
            $('#RiskItem_' + a).val(selectedVal);
            $('#RiskItemId_' + a).val(selectedItemId);

            // Reset classes
            scoreBtn.removeClass('bg-green-500 bg-yellow-400 bg-red-400 bg-gray-300 pulse-button');

            if (selectedVal == 1) {
                scoreBtn.addClass('bg-green-500');
                OverRideVariables[a] = false;
            } else if (selectedVal == 2) {
                scoreBtn.addClass('bg-yellow-400');
                OverRideVariables[a] = false;
            } else if (selectedVal == 3) {
                scoreBtn.addClass('bg-red-400');
                if (overrideScore == 3) {
                    scoreBtn.addClass('pulse-button');
                    OverRideVariables[a] = true;
                } else {
                    OverRideVariables[a] = false;
                }
            } else {
                scoreBtn.addClass('bg-gray-300');
                OverRideVariables[a] = false;
            }

            scoreBtn.text(selectedVal);
            $('#clrScorehdn_' + a).val(selectedVal);

            calculateTotal();
        }

