    function fetchRecords(searchTerm) {
  // Make an AJAX request to fetch records based on the search term

  var cust_type='I';
  $.ajax({
    url: '/Risk/GetcustomerRecords',
    type: 'GET',
    data: { searchTerm: searchTerm , cust_type: cust_type },
    success: function(response) {

        console.log("from ajax response");
        console.log(response);
      // Process the response and populate the select options accordingly
      populateSelectOptions(response);
    },
    error: function(xhr, status, error) {
      console.error('Error fetching records:', error);
    }
  });
}

function populateSelectOptions(records) {

    console.log(records);
  // Clear existing options
  $('#ddlCustomer').empty();
  
  // Populate options with fetched records
  records.forEach(function(record) {
    var option = new Option(record.fullName, record.id);
    $('#ddlCustomer').append(option);
  });

  // Trigger change event to update Select2
  $('#ddlCustomer').trigger('change');
} *@ 

