</div>
    <div class="card card-body">
        <div>
            <table class="table" style="page-break-after:auto">
                <thead>
                    <tr class="row">
                        <th class="col-md-2 print_color">
                            Categorization
                        </th>
                        <th class="col-md-5 print_color" style=" padding-left: 10px;">
                            Sub-Categorization
                        </th>
                        <th class="col-md-3 print_color text-center">
                            Select Drop Down
                        </th>
                        <th class="col-md-2  print_color" style="padding-left: 71px;">
                            Rating Scale
                        </th>
                    </tr>
                </thead>
                @{
                    int a = 0;
                }
                @foreach (var i in Model.RiskTypeCategoryDTO)
                {
                    <tr class="row">
                        <td class="d-flex align-items-center col-md-2 bg-center  print_color">
                            @i.RiskCategory
                        </td>
                        <td class="col-md-10 row">
                            <table class=" subcategory w-100" id="RiskSubTable">
                                <tbody>
                                    @foreach (var j in i.RiskTypes)
                                    {
                                        <tr>
                                            <td style="width: 592px;" class="print_color">
                                                @j.RiskType
                                            </td>
                                            <td style="width:500px">
                                                <input type="text" asp-for="@j.ItemTxt" id="RiskItemTxt_@a" class="form-control print_color br-50" readonly />
                                            </td>
                                            <td class="print_color" style="text-align: center;width: 15%;padding-left:3%;">
                                                @if (j.ItemScore == 0)
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-secondary  riskscorebtn">@j.ItemScore</button>
                                                }
                                                else if (j.ItemScore == 1)
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-success  riskscorebtn">@j.ItemScore</button>
                                                }
                                                else if (j.ItemScore == 2)
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-warning chip riskscorebtn">@j.ItemScore</button>
                                                }
                                                else if (j.ItemScore == 3)
                                                {
                                                    if (j.OverrideScore == 3)
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger  pulse-button riskscorebtn">@j.ItemScore</button>
                                                    }
                                                    else
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger  riskscorebtn">@j.ItemScore</button>
                                                    }
                                                }
                                                else
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger  riskscorebtn">@j.ItemScore</button>
                                                }
                                            </td>
                                        </tr>
                                        a = a + 1;
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }

            </table>
        </div>
        <div class="card-header">
            <div class="row">
                <div class="col-sm">
                    <h3 class="card-title">Total Selected :    <button id="btntotal" class="dt-button-info" type="submit">@Model.RiskScoreCount</button></h3>  <h3 class="card-title">Total score :    <button id="btntotalscore" class="dt-button-info" type="submit">@Model.RiskScoreSum</button></h3>
                </div>
                
            </div>
        </div>
    </div>
   
    <br />
    <div style="width:90%;display:none;padding-left:2%;" id="footdiv">
        <p>Computer generated report; hence no signature is required.</p>
    </div>
</div>
<script type="text/javascript">

   

    $('#printform').on("click", function () {

        $(this).hide();
        
        $('#printthisform').printThis({
            importCSS: true,
            importStyle: true,
            loadCSS: ["/css/risk_style_print.css"],
            header: '<div style="background: linear-gradient(180deg, #33394e 0%, #2F3961 100%);"><h1 style="color:white">@companyName <img src="@logo" style="width:10%;float: right;" /></h1></div>',
            afterPrint: function () {
                $('#printform').show();
   
            }
        });

    });

    
</script>





