        //y.style.display = "block";
        //var z = document.getElementById('btnTypeCategorySubmit');
        //z.style.display = "block";
        //z = document.getElementById('addMoreCategory');
        //z.style.display = "block";

        var empTab = document.getElementById('RiskTypeCategoryList');
        var rowIndexVal = $('#rowIndex1').val();
        var rowCnt = empTab.rows.length;   // table row count.
        var tr = empTab.insertRow(rowCnt); // the table row.
        @* tr = empTab.insertRow(rowCnt); *@

        for (var c = 0; c < arrHead1.length; c++) {
            var td = document.createElement('td'); // table definition.
            td = tr.insertCell(c);

            if (c == 1) {      // the first column.
                // add a button in every new row in the last column.
                var button = document.createElement('input');

                // set input attributes.
                button.setAttribute('type', 'button');
                button.setAttribute('value', '@localizer["Remove"]');

                // add button's 'onclick' event.
                button.setAttribute('onclick', 'removeRow(this)');

                td.appendChild(button);
            }
            else {
                // 1nd, 2rd,Url3rd and 4th column, will have textbox.
                var ele = document.createElement('input');
                if (c == 0) {
                    var hiddenIndex = document.createElement('input');
                    hiddenIndex.setAttribute('type', 'hidden');
                    hiddenIndex.setAttribute('class', 'form-control');
                    hiddenIndex.setAttribute('value', parseInt(rowIndexVal));
                    hiddenIndex.setAttribute('id', 'Index')
                    td.appendChild(hiddenIndex);
                    ele = addCategoryTypeRow(ele, 'RiskTypeCategory', '');
                    td.appendChild(ele);
                } else {
                    ele.setAttribute('type', 'hidden');
                    ele.setAttribute('class', 'form-control');
                    ele.setAttribute('value', false);
                    ele.setAttribute('name', 'AddedRiskTypeCategory[' + $('#rowIndex1').val() + '].isDeletedInUI');
                    ele.setAttribute('id', 'AddedRiskTypeCategory[' + $('#rowIndex1').val() + '].isDeletedInUI');
                    ele.setAttribute('maxlength', 500);
                    ele.setAttribute('onkeypress', "alphaNumericCheck(event)");
                    td.appendChild(ele);
                }

            }
        }

        $('#rowIndex1').val(parseInt(rowIndexVal) + 1);
    }

