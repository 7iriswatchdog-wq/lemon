    function addRow (ele, elementName, value) {
        var rowIndex = $('#rowIndex3').val();
        if (elementName == 'RiskScore' || elementName == 'OverrideScore') {
            ele.setAttribute('max', 3);
            ele.setAttribute('min', 0);

            ele.setAttribute('type', 'number');
            ele.setAttribute('name', 'AddedItems[' + rowIndex + '].' + elementName);
            ele.setAttribute('id', 'AddedItems[' + rowIndex + '].' + elementName);
            if (elementName == 'RiskScore') {
                ele.setAttribute('onchange', 'riskScoreOnChange(' + rowIndex + ')');
            } else if (elementName == 'OverrideScore') {
                ele.setAttribute('disabled', 'true');
            }
        }
        else {
            ele.setAttribute('type', 'text');
            ele.setAttribute('class', 'form-control');
            ele.setAttribute('value', value);
            ele.setAttribute('name', 'AddedItems[' + rowIndex + '].' + elementName);
            ele.setAttribute('id', 'AddedItems[' + rowIndex + '].' + elementName);
            ele.setAttribute('maxlength', 500);
            ele.setAttribute('onkeypress', "alphaNumericCheck(event)");
        }
        return ele;
    }

