    function riskScoreOnChange (rowIndex) {
        var riskScore = document.getElementById('AddedItems[' + rowIndex + '].RiskScore').value;
        if (riskScore == 3) {
            document.getElementById('AddedItems[' + rowIndex + '].OverrideScore').removeAttribute('disabled');
            document.getElementById('AddedItems[' + rowIndex + '].OverrideScore').setAttribute('enabled', 'true');
        } else {
            document.getElementById('AddedItems[' + rowIndex + '].OverrideScore').removeAttribute('enabled');
            document.getElementById('AddedItems[' + rowIndex + '].OverrideScore').value = 0;
            document.getElementById('AddedItems[' + rowIndex + '].OverrideScore').setAttribute('disabled', 'true');
        }
    }
    function tableRiskScoreOnChange (rowIndex) {
        var riskScore = document.getElementById('AvailableItems[' + rowIndex + '].RiskScore').value;
        if (riskScore == 3) {
            document.getElementById('AvailableItems[' + rowIndex + '].OverrideScore').removeAttribute('disabled');
            document.getElementById('AvailableItems[' + rowIndex + '].OverrideScore').setAttribute('enabled', 'true');
        } else {
            document.getElementById('AvailableItems[' + rowIndex + '].OverrideScore').removeAttribute('enabled');
            document.getElementById('AvailableItems[' + rowIndex + '].OverrideScore').value = 0;
            document.getElementById('AvailableItems[' + rowIndex + '].OverrideScore').setAttribute('disabled', 'true');
        }
    }
