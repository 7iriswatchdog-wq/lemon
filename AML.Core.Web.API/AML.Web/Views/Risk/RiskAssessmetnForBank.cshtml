<script type="text/javascript">
    $(function () {

        $('#ddlCustomer').change(function () {
            var selectedId = $("#ddlCustomer option:selected").val();
            $.ajax({
                url: '/Risk/GetCustomerDetailById/',
                data: { "id": selectedId },
                type: "POST",
                beforeSend: function () {
                    $('.se-pre-con').show();
                },
                success: function (data) {
                    $("#riskBody").load(location.href + " #riskBody");
                    $("#finalRiskBody").load(location.href + " #finalRiskBody");
                    $('#txtUniqueIDNumber').val(data.customerReferenceId);
                    $('#txtLegalNameOfTheEntity').val(data.firstName);// + ' ' + ((data.lastName != '' && data.lastName != 'null') ? data.lastName : ''));
                    $('#ddlCountry').val(((data.nationality != '' && data.nationality != 'null') ? data.nationality : ''));
                    $('#countryTxt').val(((data.nationality != '' && data.nationality != 'null') ? data.nationality : ''));
                },
                error: function (response) {
                    alert(response.responseText);
                },
                failure: function (response) {
                    alert(response.responseText);
                },
                complete: function () {
                    $('.se-pre-con').fadeOut("slow");
                }
            });
        });
    });

    function ValidateCustomerId(e) {
        var uniquiIdVal = $('#txtUniqueIDNumber').val();
        var legalName = $('#txtLegalNameOfTheEntity').val();
        var countryOfIncorp = $('#ddlCountryofIncorp').val();
        var assessmentDt = $('#dtEntityDate').val();
        if (uniquiIdVal == '' || uniquiIdVal == null) {
            alert('Enter Unique ID Number');
            event.preventDefault();
            $(".se-pre-con").hide();
            return false;
        } else if (legalName == '' || legalName == null) {
            alert('@localizer["Enter Legal Name Of The Entity"]');
            event.preventDefault();
            $(".se-pre-con").hide();
            return false;
        } else if (countryOfIncorp == '' || countryOfIncorp == 0) {
            alert('@localizer["Select Country Of Incorporation"]');
            event.preventDefault();
            $(".se-pre-con").hide();
            return false;
        } else if (assessmentDt == '' || assessmentDt == null) {
            alert('@localizer["Select Date Of Assessment"]');
            event.preventDefault();
            $(".se-pre-con").hide();
            return false;
        } else {
            return true;
        }
    }
</script>

