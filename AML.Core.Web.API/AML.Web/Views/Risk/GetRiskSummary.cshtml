<script>
    let currentPage = 1, totalPages = 1, pageSize = 25, draw = 1;
    let sortCol = 'riskType', sortDir = 'asc';

    function getColumnIndex(col) {
        return ['riskType', 'highRiskCount', 'mediumRiskCount', 'lowRiskCount'].indexOf(col);
    }

    function fetchData(searchVal = '', page = 1) {
    pageSize = +$('#rowsPerPage').val();
            $('#loadingRiskSummary').show();
        $.ajax({
            url: '/Risk/RiskSummaryCustomPagination',
            type: 'POST',
            data: {
                draw,
                start: (page - 1) * pageSize,
                length: pageSize,
                search: { value: searchVal },
                order: [{ column: getColumnIndex(sortCol), dir: sortDir }],
                columns: [
                    { data: 'riskType' }, { data: 'highRiskCount' },
                    { data: 'mediumRiskCount' }, { data: 'lowRiskCount' }
                ],
                OnDate: $('#dtOnDate').val()
            },
            success(res) {
                renderTable(res.data || []);
                totalPages = Math.max(1, Math.ceil((res.recordsFiltered || 0) / pageSize));
                renderPager(page);
                draw++;
            },
            error() { alert('Error loading data.'); },
            complete() { $('#loadingRiskSummary').hide(); }
        });
    }

    function renderTable(rows) {
        const $tbody = $('#riskSummaryTbl tbody').empty();
        if (!rows.length) {
            $tbody.append('<tr><td colspan="5" class="text-center py-4">No records found</td></tr>');
            return;
        }
        rows.forEach(r => {
            const total = (+r.highRiskCount || 0) + (+r.mediumRiskCount || 0) + (+r.lowRiskCount || 0);
            $tbody.append(`
                <tr>
                    <td class="px-4 py-3">${r.riskType}</td>
                    <td class="px-4 py-3">${r.highRiskCount}</td>
                    <td class="px-4 py-3">${r.mediumRiskCount}</td>
                    <td class="px-4 py-3">${r.lowRiskCount}</td>
                    <td class="px-4 py-3">${total}</td>
                </tr>
            `);
        });
    }

    function renderPager(page) {
        const $pager = $('.pagination-controls').empty();
        const btn = (label, pg, disabled, active) =>
            `<button class="px-3 py-1 border rounded ${active ? 'bg-primary text-white' : 'bg-surface text-primary'} ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
                    data-page="${pg}" ${disabled ? 'disabled' : ''}>${label}</button>`;
        $pager.append(btn('First', 1, page === 1, false));
        $pager.append(btn('Prev', page - 1, page === 1, false));
        for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) {
            $pager.append(btn(i, i, false, i === page));
        }
        $pager.append(btn('Next', page + 1, page === totalPages, false));
        $pager.append(btn('Last', totalPages, page === totalPages, false));
    }

    $('#btnSearch').on('click', () => fetchData($('#searchInput').val(), 1));
    $('#btnReset').on('click', () => { $('#filterForm')[0].reset(); fetchData('', 1); });
    $('#rowsPerPage, #searchInput').on('change keyup', () => fetchData($('#searchInput').val(), 1));
    $('.pagination-controls').on('click', 'button', function () {
        const pg = +$(this).data('page');
        if (!isNaN(pg)) fetchData($('#searchInput').val(), pg);
    });

    $('#riskSummaryTbl thead').on('click', 'th.sortable', function () {
        const col = $(this).data('column');
        if (sortCol === col) sortDir = (sortDir === 'asc' ? 'desc' : 'asc');
        else { sortCol = col; sortDir = 'asc'; }
        $('#riskSummaryTbl th.sortable').removeClass('active asc desc');
        $(this).addClass(`active ${sortDir}`);
        fetchData($('#searchInput').val(), 1);
    });

    function ExportList() {
        const query = $.param({
            OnDate: $('#dtOnDate').val(),
            search: $('#searchInput').val(),
            length: $('#rowsPerPage').val()
        });
        window.location = '/Risk/ExportRiskSummary?' + query;
    }

    $(document).ready(() => {
        $('#riskSummaryTbl th.sortable[data-column="' + sortCol + '"]').addClass(`active ${sortDir}`);
        fetchData('', 1);
    });
</script>
