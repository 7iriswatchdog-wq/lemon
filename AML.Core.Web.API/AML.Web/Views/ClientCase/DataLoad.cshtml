<script type="text/javascript">

    var customerList = [];
    function addCustomer() {
        var customer = $('#txtCustomer').val();
        var control = '<div class="chip bg-success"><label id="customerchip">' + customer
            + '</label><span class="closebtn" onclick="removeChip(this)">&times;</span></div>';
        $('#chips').append(control);
        customerList.push(customer);
        $('#hdnCustomerList').val(customerList);

        $('#txtCustomer').val('');

        var x = document.getElementById("val");
        var option = document.createElement("option");
        option.text = document.getElementById("txtCustomer").value;
        x.add(option);

    }
    function removeChip(obj) {
        obj.parentElement.style.display = 'none';
        customerList.splice(customerList.indexOf($('#customerchip').text()), 1);
        $('#hdnCustomerList').val(customerList);
    }

    function viewRecords(batchId) {
        $('#btnPdf').attr('formaction', '/ClientCase/GeneratePdf?BatchID=' + batchId);
        $('#hdnBatchId').val(batchId);
        //$('#btnView').attr('formaction', '/ClientCase/ViewCustomerData?BatchID=' + batchId);
        $('#btnView').click();
    }
    function downloadPdf() {
        $('tr').click(function (event) {
            event.stopPropagation();
        });
        $('#btnPdf').click();
    }
    $("#btnView").click(function (e) {
        e.preventDefault();
        $('#loader').show();
        $.ajax({
            type: "GET",
            url: "/ClientCase/ViewCustomerData?BatchID=" + $('#hdnBatchId').val(),
            success: function (result) {
                $('.file').removeClass('active');             // Remove from File
                $('.customer').addClass('active');

                $("#tableCustomerDetail tbody").find("tr:gt(0)").remove();
                $.each(result, function (i, v) {
                    if (i == 0) {
                        setDataOnRow($("#tableCustomerDetail tbody").find("tr").first(), v, i);
                    } else {
                        var clonnedRow = $($("#tableCustomerDetail tbody").find("tr").first()).clone();
                        setDataOnRow(clonnedRow, v, i);
                        $("#tableCustomerDetail tbody").append(clonnedRow);
                    }
                });

                $('#loader').hide();
            }
        });
    });



    function setDataOnRow(rowObject, v, i) {
        $(rowObject).find(".SlNo").html(i + 1);
        $(rowObject).find(".Nationality").html(v.nationality);
        $(rowObject).find(".FullName").html([v.firstName, v.middleName, v.lastName].join(' '));
        $(rowObject).find(".Source").html(v.source);
        $(rowObject).find(".CustomerId").html(v.customerId);
        $(rowObject).find(".Uploadedon").html(v.createdOnDB);
        if (v.dob.substr(0, v.dob.indexOf(' ')).split('/')[2] == '0001')
            $(rowObject).find(".DOB").html("NA");
        else
            $(rowObject).find(".DOB").html(v.dob.substr(0, v.dob.indexOf(' ')));
        //$(rowObject).find(".DOB").html(v.dob.substr(0,v.dob.indexOf(' ')));
        $(rowObject).find(".IsMatched").html(v.isMatched == 0 ? "False" : "True");
        $(rowObject).find(".UID").html(v.uid);
    }
    function showTable(tableClass) {
        // Hide all tables with class 'table1' and 'table2'
        const allTables = document.querySelectorAll('.table1, .table2');
        allTables.forEach(tbl => tbl.style.display = 'none');

        // Show the selected table by class name
        const targetTables = document.getElementsByClassName(tableClass);

        for (let i = 0; i < targetTables.length; i++) {
            targetTables[i].style.display = 'table';
        }
    }
    const buttons = document.querySelectorAll(".navigate button");
    buttons.forEach(btn => {
        btn.addEventListener("click", () => {
            buttons.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            if (customerBtn.hasClass('active')) {

                exportBtn.show();
            } else {
                exportBtn.hide();
            }
        });
        const customerBtn = $('.navigate .customer');
        const exportBtn = $('.export');
        // Initially check if .customer button is active

    });
    $('.table1 tbody').on('click', 'tr', function () {
        // Remove active from all nav buttons

        $('.navigate button').removeClass('active');

        // Add active to the customer button
        $('.navigate .customer').addClass('active');

        // Show the export button if customer button is active
        if ($('.navigate .customer').hasClass('active')) {
            $('.export').show();
        } else {
            $('.export').hide();
        }
    });



</script>
<script>
    $("#btnReset").click(function () {
        var date = new Date();
        var enddate = date.getFullYear() + "-" + (date.getMonth() + 1) + "-" + date.getDate();
        $('#filterTablebody').empty();
        $('#dtStartDate1').val(enddate);
        $('#dtEndDate').val(enddate);
        $('#exampleSelectRounded0').val(1);
        $('#txtCustomer').val('');
        $('#chips').html('');
        $("#tableCustomerDetail tbody").remove();


    });
</script>