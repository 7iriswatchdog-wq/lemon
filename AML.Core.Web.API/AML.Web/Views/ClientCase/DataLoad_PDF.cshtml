@using AML.ViewModel.ViewModels.CustomerCase
@using AML.Web.Controllers.ClientCase
@using Microsoft.AspNetCore.Http
@model List<CaseModel>
@functions {
    public bool ShowColumn(string colId)
    {
        var selectedColumns = ViewBag.SelectedColumns as string;
        if (string.IsNullOrEmpty(selectedColumns)) return true;
        return selectedColumns.Split(',').Contains(colId);
    }
}
@{
    Layout = null;
    var companyName = Context.Session.GetString("SessCompanyName") ?? "AML Report";
    var orientation = ViewBag.Orientation as string ?? "portrait";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bulk Upload Customer List Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @@media print {
            .no-print { display: none !important; }
            tr { page-break-inside: avoid !important; break-inside: avoid !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 text-[10px] p-8">
    <div id="pdf-container" class="max-w-[@(orientation == "landscape" ? "1280px" : "1024px")] mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <!-- Header -->
        <div class="flex justify-between items-start border-b border-slate-200 pb-6 mb-6">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900">Bulk Upload Customer List</h1>
                <p class="text-slate-500 font-medium mt-1">Generated on @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
            <div class="text-right">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Company</div>
                <div class="text-lg font-black text-blue-600">@companyName</div>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-slate-200 text-slate-500 uppercase tracking-wider font-bold text-[9px]">
                        <th class="px-2 py-3">#</th>
                        @if (ShowColumn("batchId")) { <th class="px-2 py-3">Batch ID</th> }
                        @if (ShowColumn("customerId")) { <th class="px-2 py-3">Customer ID</th> }
                        @if (ShowColumn("name")) { <th class="px-2 py-3">Customer Name</th> }
                        @if (ShowColumn("nationality")) { <th class="px-2 py-3">Nationality</th> }
                        @if (ShowColumn("dob")) { <th class="px-2 py-3">Date of Birth</th> }
                        @if (ShowColumn("source")) { <th class="px-2 py-3">Source</th> }
                        @if (ShowColumn("matched")) { <th class="px-2 py-3">Matched</th> }
                        @if (ShowColumn("status")) { <th class="px-2 py-3">Status</th> }
                        @if (ShowColumn("createdOn")) { <th class="px-2 py-3">Created On</th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-2 py-3 text-slate-400 font-medium">@index</td>
                                @if (ShowColumn("batchId")) { <td class="px-2 py-3">@item.CaseRefId</td> }
                                @if (ShowColumn("customerId")) { <td class="px-2 py-3 font-bold text-slate-900">@item.CustomerId</td> }
                                @if (ShowColumn("name")) { <td class="px-2 py-3 font-semibold text-slate-700">@string.Join(" ", new[] { item.FirstName, item.MiddleName, item.LastName }.Where(s => !string.IsNullOrEmpty(s)))</td> }
                                @if (ShowColumn("nationality")) { <td class="px-2 py-3">@item.Nationality</td> }
                                @if (ShowColumn("dob")) { <td class="px-2 py-3">@((item.DOB != null && item.DOB.Contains("0001")) ? "NA" : (item.DOB?.Split(' ')[0] ?? "-"))</td> }
                                @if (ShowColumn("source")) { <td class="px-2 py-3 text-slate-600">@item.Source</td> }
                                @if (ShowColumn("matched")) { 
                                    <td class="px-2 py-3">
                                        <span class="inline-block px-1.5 py-0.5 rounded-full text-[8px] font-bold @(item.IsMatched == 1 ? "bg-yellow-50 text-yellow-700 border border-yellow-100" : "bg-green-50 text-green-700 border border-green-100")">
                                            @(item.IsMatched == 1 ? "Yes" : "No")
                                        </span>
                                    </td> 
                                }
                                @if (ShowColumn("status")) { <td class="px-2 py-3 font-bold uppercase tracking-tighter">@item.CaseStatus</td> }
                                @if (ShowColumn("createdOn")) { <td class="px-2 py-3">@item.CreatedOn</td> }
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="px-2 py-12 text-center text-slate-400 italic font-medium">No bulk upload records found matching filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-[9px] text-slate-400 font-medium tracking-widest uppercase">COMPUTER GENERATED REPORT - WatchDog Compliance &copy; @DateTime.Now.Year</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="/js/pdf-export.js"></script>
    <script>
        window.onload = function() {
            setTimeout(() => {
                downloadPageAsPDF('#pdf-container', 'Bulk_Upload_Logs_@DateTime.Now.ToString("yyyyMMdd")' + '.pdf', '@orientation');
            }, 1000);
        };
    </script>
</body>
</html>
