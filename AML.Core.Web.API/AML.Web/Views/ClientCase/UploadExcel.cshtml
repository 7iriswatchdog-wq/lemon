<script type="text/javascript">
    document.getElementById('textInput').value = 85;

    function selects() {
        var ele = document.getElementsByClassName('modelcb');
        for (var i = 0; i < ele.length; i++) {
            if (ele[i].type == 'checkbox')
                ele[i].checked = true;
        }
    }
    function deSelect() {
        var ele = document.getElementsByClassName('modelcb');
        for (var i = 0; i < ele.length; i++) {
            if (ele[i].type == 'checkbox')
                ele[i].checked = false;

        }
    }

    function updateTextInput(val) {
        document.getElementById('textInput').value = val;
    }

    function DownloadSample() {
        var type = $('#typeid').val();
        $.ajax({
            type: "GET",
            url: "/ClientCase/DownloadCustomerUploadSample",
            data: { type: $('#typeid').val() },
            success: function (data) {
                window.location = '/ClientCase/DownloadCustomerUploadSample?type=' + type;
            },
            error: function (result) {
                alert('error');
            }
        });
    }

    $(document).ready(function () {
        var ele = document.getElementsByClassName('modelcb');
        for (var i = 0; i < ele.length; i++) {
            if (ele[i].type == 'checkbox')
                ele[i].checked = true;
        }
    })
</script>


@* for the cancel  *@
<script>
    function showLoadingAndRedirect(event, element) {
        event.preventDefault(); // Prevent default anchor action
        document.getElementById("loadingeffect").style.display = "flex"; // Show loader

        // Optional: wait a bit before redirecting (for loader visibility)
        setTimeout(() => {
            window.location.href = element.getAttribute("href");
        }, 300); // 300ms delay for smooth transition
    }
</script>