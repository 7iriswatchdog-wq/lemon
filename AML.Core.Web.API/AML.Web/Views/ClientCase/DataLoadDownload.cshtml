@using AML.ViewModel.ViewModels.CustomerCase
@model ETLReportDownloadModel

<div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
        <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
            <tr>
                <th>#</th>
                <th>DATE</th>
                <th>CUSTOMER ID</th>
                <th>CUSTOMER NAME</th>
                <th>NATIONALITY</th>
                <th>DATE OF BIRTH</th>
                <th>MATCHED</th>
                <th>SOURCE</th>
                <th>UID</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-bordercolor">
            @for(int i = 0; i < Model.Data.Count; i++)
            {
            <tr>
                <td>@(i+1)</td>
                <td>@Model.Data[i].DOB</td>
                <td>@Model.Data[i].CustomerId</td>
                <td>@(Model.Data[i].FirstName +" "+ Model.Data[i].MiddleName + " "+ Model.Data[i].LastName)</td>
                <td>@Model.Data[i].NationalityName</td>
                <td>@Model.Data[i].DOB</td>
                @if (Model.Data[i].IsMatched == 1)
                {
                    <td class="bg-success">
                        True
                    </td>
                }
                else
                {
                    <td class="bg-danger">
                        False
                    </td>
                }

                <td>@Model.Data[i].Source</td>
                <td>@Model.Data[i].UID</td>
            </tr>
            }

        </tbody>
    </table>
</div>
