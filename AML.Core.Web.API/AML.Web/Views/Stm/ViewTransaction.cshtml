@model AML.ViewModel.ViewModels.SectoralTMS.StmTransactionModel
@{
    ViewData["Title"] = "STM - Transaction Detail";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    ViewBag.StmActive = "transactions";
}

@await Html.PartialAsync("_StmLayout")

<div class="px-6 pb-12">
    <!-- ============================================================ -->
    <!-- TOP ROW: Information (left 2/3) + Risk Assessment (right 1/3) -->
    <!-- ============================================================ -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- LEFT: Transaction Information -->
        <div class="lg:col-span-2 space-y-4">
            <div class="stm-card">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <div class="stm-page-title">Transaction @Model.TranRefNo</div>
                        <div class="stm-page-sub">@Model.SectorName · @Model.TranType · @Model.TranDate.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    @{ var backUrl = (ViewBag.ReturnUrl as string) ?? "/stm/transactions"; }
                    <a href="@backUrl" class="stm-btn stm-btn-secondary"><i data-lucide="arrow-left" class="w-4 h-4"></i> Back</a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Amount</div><div class="text-lg font-bold">@Model.Amount.ToString("N2") @Model.Currency</div></div>
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Mode</div><div class="font-medium">@Model.TranMode</div></div>
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Channel</div><div class="font-medium">@Model.DeliveryChannel</div></div>
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Status</div><div><span class="stm-badge @(Model.RuleHitStatus == "HIT" ? "high" : "low")">@Model.RuleHitStatus</span></div></div>
                </div>

                <div class="stm-section-title">Customer</div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6 text-sm">
                    <div><span class="text-slate-500">Customer:</span> <strong>@Model.CustomerName</strong></div>
                    <div><span class="text-slate-500">Customer ID:</span> @Model.CustomerId</div>
                    <div><span class="text-slate-500">Type:</span> @(Model.CustomerType == "C" ? "Corporate" : "Individual")</div>
                </div>

                @if (Model.Parties != null && Model.Parties.Count > 0)
                {
                    <div class="stm-section-title">Parties (@Model.Parties.Count)</div>
                    <table class="stm-table mb-6">
                        <thead><tr><th>Role</th><th>Customer ID</th><th>Name</th><th>Nationality</th><th>Share %</th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Parties)
                        {
                            <tr><td>@p.PartyRole</td><td>@p.CustomerId</td><td>@p.CustomerName</td><td>@p.Nationality</td><td>@p.SharePercentage</td></tr>
                        }
                        </tbody>
                    </table>
                }

                <div class="stm-section-title">Counter-party</div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-2 text-sm">
                    <div><span class="text-slate-500">Remitter:</span> <strong>@Model.RemitterName</strong> (@Model.RemitterCountry)</div>
                    <div><span class="text-slate-500">Beneficiary:</span> <strong>@Model.BeneficiaryName</strong> (@Model.BeneficiaryCountry)</div>
                    @if (!string.IsNullOrEmpty(Model.PolicyNo))   { <div><span class="text-slate-500">Policy:</span> @Model.PolicyNo</div> }
                    @if (!string.IsNullOrEmpty(Model.PropertyRef)) { <div><span class="text-slate-500">Property:</span> @Model.PropertyRef</div> }
                    <div class="md:col-span-2"><span class="text-slate-500">Purpose:</span> @Model.Purpose</div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Transaction Risk Assessment -->
        <div class="space-y-4">
            <div class="stm-card">
                <div class="flex items-center justify-between mb-2">
                    <div class="stm-section-title mb-0">Transaction Risk</div>
                    <span id="riskBadge" class="stm-badge low">--</span>
                </div>
                <div id="riskSummary" class="text-xs text-slate-500 mb-3">Loading…</div>
                <div class="overflow-x-auto">
                    <table class="stm-table">
                        <thead><tr><th>Factor</th><th>Value</th><th>Band</th><th>Score</th><th>Rating</th></tr></thead>
                        <tbody id="riskBody"><tr><td colspan="5" class="text-slate-400 text-xs py-4 text-center">Loading risk breakdown...</td></tr></tbody>
                    </table>
                </div>
                <div class="mt-3 text-right">
                    <button type="button" class="stm-btn stm-btn-secondary" onclick="recomputeRisk()">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i> Re-evaluate
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
<script>
    const txnId = @Model.Id;
    async function loadRisk() {
        const r = await fetch('/stm/risk/result/' + txnId);
        const j = await r.json();
        const badge = document.getElementById('riskBadge');
        const summary = document.getElementById('riskSummary');
        const body = document.getElementById('riskBody');
        if (!j.success || !j.data) {
            badge.textContent = 'Not scored';
            badge.className = 'stm-badge closed';
            summary.textContent = 'No transaction risk computed. Click Re-evaluate to score now.';
            body.innerHTML = '<tr><td colspan="5" class="text-slate-400 text-xs py-4 text-center">No risk data</td></tr>';
            return;
        }
        const d = j.data;
        badge.textContent = (d.riskRating || 'Low') + ' Risk';
        badge.className = 'stm-badge ' + (d.riskRating || 'Low').toLowerCase();
        summary.innerHTML = `Score <strong>${d.totalScore || 0}</strong> from <strong>${d.factorCount || 0}</strong> factors. Computed ${(d.computedOn || '').toString().substring(0,16).replace('T',' ')}.`;
        const items = d.breakdown || [];
        body.innerHTML = items.length ? items.map(it => `
            <tr>
                <td><div class="font-medium text-slate-800 text-xs">${it.factorName || ''}</div><div class="text-xs text-slate-500">${it.factorCode || ''}</div></td>
                <td class="text-xs font-mono">${(it.fieldValue || '').toString().substring(0, 40)}</td>
                <td class="text-xs">${it.bandLabel || ''}</td>
                <td>${it.weightedScore || it.score || 0}</td>
                <td><span class="stm-badge ${(it.rating || 'low').toLowerCase()}">${it.rating || ''}</span></td>
            </tr>`).join('') : '<tr><td colspan="5" class="text-slate-400 text-xs py-4 text-center">No factors matched</td></tr>';
    }
    async function recomputeRisk() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const r = await fetch('/stm/risk/evaluate/' + txnId, {
            method: 'POST',
            headers: token ? { 'RequestVerificationToken': token } : {}
        });
        const j = await r.json();
        if (!j.success) alert('Re-evaluate failed: ' + (j.message || 'unknown'));
        loadRisk();
    }
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
        loadRisk();
    });
</script>
