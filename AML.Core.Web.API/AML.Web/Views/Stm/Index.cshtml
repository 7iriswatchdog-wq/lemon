@{
    ViewData["Title"] = "Sectoral TMS - Dashboard";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    ViewBag.StmActive = "dashboard";
}

@await Html.PartialAsync("_StmLayout")

<div class="px-6 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="stm-card">
            <div class="text-xs uppercase tracking-wider text-slate-500">Active Rules</div>
            <div class="text-3xl font-bold text-slate-900 mt-2" id="kpi-rules">--</div>
            <div class="text-xs text-slate-500 mt-1">Insurance + Real Estate</div>
        </div>
        <div class="stm-card">
            <div class="text-xs uppercase tracking-wider text-slate-500">Transactions (30d)</div>
            <div class="text-3xl font-bold text-slate-900 mt-2" id="kpi-txns">--</div>
            <div class="text-xs text-slate-500 mt-1">Submitted in last 30 days</div>
        </div>
        <div class="stm-card">
            <div class="text-xs uppercase tracking-wider text-slate-500">Open Cases</div>
            <div class="text-3xl font-bold text-blue-700 mt-2" id="kpi-open">--</div>
            <div class="text-xs text-slate-500 mt-1">Pending review</div>
        </div>
        <div class="stm-card">
            <div class="text-xs uppercase tracking-wider text-slate-500">Reviewed</div>
            <div class="text-3xl font-bold text-emerald-700 mt-2" id="kpi-closed">--</div>
            <div class="text-xs text-slate-500 mt-1">Closed / Approved / Rejected</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="stm-card">
            <div class="stm-section-title">Quick Actions</div>
            <div class="grid grid-cols-2 gap-3">
                <a href="/stm/transactions/create" class="stm-btn stm-btn-primary justify-center"><i data-lucide="plus" class="w-4 h-4"></i>New Transaction</a>
                <a href="/stm/rules/create" class="stm-btn stm-btn-secondary justify-center"><i data-lucide="git-branch" class="w-4 h-4"></i>New Rule</a>
                <a href="/stm/cases/open" class="stm-btn stm-btn-secondary justify-center"><i data-lucide="folder-open" class="w-4 h-4"></i>Open Cases</a>
                <a href="/stm/reports" class="stm-btn stm-btn-secondary justify-center"><i data-lucide="bar-chart-3" class="w-4 h-4"></i>Reports</a>
            </div>
        </div>
        <div class="stm-card">
            <div class="stm-section-title">Sectors Covered</div>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center"><i data-lucide="shield" class="w-5 h-5 text-blue-700"></i></div>
                        <div><div class="font-semibold text-slate-900">Insurance</div><div class="text-xs text-slate-500">Life, General, Health, Motor, Property</div></div>
                    </div>
                    <a href="/stm/rules?sector=INS" class="text-blue-600 text-sm hover:underline">View rules &rarr;</a>
                </div>
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center"><i data-lucide="building-2" class="w-5 h-5 text-emerald-700"></i></div>
                        <div><div class="font-semibold text-slate-900">Real Estate</div><div class="text-xs text-slate-500">Purchase, Sale, Lease, Brokerage</div></div>
                    </div>
                    <a href="/stm/rules?sector=RE" class="text-emerald-600 text-sm hover:underline">View rules &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => { if (window.lucide) lucide.createIcons(); });
</script>
