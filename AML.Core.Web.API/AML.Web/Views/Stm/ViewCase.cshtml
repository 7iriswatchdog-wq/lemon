@model AML.ViewModel.ViewModels.SectoralTMS.StmCaseModel
@{
    ViewData["Title"] = "STM - Case " + Model.CaseRefNo;
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var isOpenStatus = Model.Status == "OPEN" || Model.Status == "IN_REVIEW";
    ViewBag.StmActive = isOpenStatus ? "open" : "completed";
}

@await Html.PartialAsync("_StmLayout")

<div class="px-6 pb-12">
    <!-- ============================================================ -->
    <!-- TOP ROW: Information (left 2/3) + Risk Assessment (right 1/3) -->
    <!-- ============================================================ -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
        <!-- LEFT: case + customer + transaction details -->
        <div class="lg:col-span-2 space-y-4">
            <div class="stm-card">
                <div class="flex items-start justify-between mb-4">
                    <div>
                        <div class="stm-page-title">Case @Model.CaseRefNo</div>
                        <div class="stm-page-sub">@Model.SectorName · @(Model.CreatedOn?.ToString("yyyy-MM-dd HH:mm"))</div>
                    </div>
                    <div class="flex gap-2">
                        <span class="stm-badge @(Model.RiskRating?.ToLower() ?? "low")">@Model.RiskRating Risk</span>
                        <span class="stm-badge @(Model.Status?.ToLower() ?? "open")">@Model.Status</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mb-4">
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Transaction</div><div class="font-mono text-sm">@Model.TranRefNo</div></div>
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Date</div><div class="text-sm">@(Model.TranDate?.ToString("yyyy-MM-dd"))</div></div>
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Amount</div><div class="text-sm font-bold">@Model.Amount?.ToString("N2") @Model.Currency</div></div>
                    <div class="bg-slate-50 p-3 rounded-lg"><div class="text-xs text-slate-500">Total Score</div><div class="text-sm font-bold">@Model.TotalRiskScore</div></div>
                </div>

                <div class="stm-section-title">Customer</div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4 text-sm">
                    <div><span class="text-slate-500">Customer:</span> <strong>@Model.CustomerName</strong></div>
                    <div><span class="text-slate-500">Customer ID:</span> @Model.CustomerId</div>
                    <div><a href="/stm/reports?customerId=@Model.CustomerId" class="text-blue-600 hover:underline text-xs">View customer transactions →</a></div>
                </div>

                <div class="stm-section-title">Rules Violated</div>
                <div class="mb-4">
                    <div class="bg-red-50 text-red-800 p-3 rounded-lg text-sm">@Model.RuleNames</div>
                </div>

                @if (Model.Transaction != null)
                {
                    <div class="stm-section-title">Transaction Detail</div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-2 text-sm">
                        <div><span class="text-slate-500">Type:</span> @Model.Transaction.TranType</div>
                        <div><span class="text-slate-500">Mode:</span> @Model.Transaction.TranMode</div>
                        <div><span class="text-slate-500">Channel:</span> @Model.Transaction.DeliveryChannel</div>
                        <div><span class="text-slate-500">Remitter:</span> @Model.Transaction.RemitterName (@Model.Transaction.RemitterCountry)</div>
                        <div><span class="text-slate-500">Beneficiary:</span> @Model.Transaction.BeneficiaryName (@Model.Transaction.BeneficiaryCountry)</div>
                        <div><span class="text-slate-500">Policy/Property:</span> @(string.IsNullOrEmpty(Model.Transaction.PolicyNo) ? Model.Transaction.PropertyRef : Model.Transaction.PolicyNo)</div>
                    </div>
                    @if (Model.Transaction.Parties != null && Model.Transaction.Parties.Count > 0)
                    {
                        <div class="text-xs font-semibold text-slate-600 mt-3 mb-2">Parties (@Model.Transaction.Parties.Count)</div>
                        <table class="stm-table">
                            <thead><tr><th>Role</th><th>Name</th><th>Nationality</th><th>ID</th><th>Share %</th></tr></thead>
                            <tbody>
                            @foreach (var p in Model.Transaction.Parties)
                            {
                                <tr><td>@p.PartyRole</td><td>@p.CustomerName</td><td>@p.Nationality</td><td>@p.CustomerId</td><td>@p.SharePercentage</td></tr>
                            }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>

        <!-- RIGHT: Transaction Risk Assessment (industry-standard factor scoring) -->
        <div class="space-y-4">
            <div class="stm-card">
                <div class="flex items-center justify-between mb-3">
                    <div class="stm-section-title mb-0">Transaction Risk Assessment</div>
                    <span id="riskBadge" class="stm-badge low">--</span>
                </div>
                <div id="riskSummary" class="text-xs text-slate-500 mb-3">Loading…</div>
                <div class="overflow-x-auto">
                    <table class="stm-table">
                        <thead><tr><th>Factor</th><th>Value</th><th>Band</th><th>Score</th><th>Rating</th></tr></thead>
                        <tbody id="riskBody">
                            <tr><td colspan="5" class="text-slate-400 text-xs py-4 text-center">Loading risk breakdown...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-right">
                    <button type="button" class="stm-btn stm-btn-secondary" onclick="recomputeRisk()">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i> Re-evaluate
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- BOTTOM ROW: Comments (left) + Decision (right)                -->
    <!-- ============================================================ -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- LEFT: Activity Log + Add Comment -->
        <div class="space-y-4">
            <div class="stm-card">
                <div class="stm-section-title">Activity Log</div>
                @if (Model.Comments == null || Model.Comments.Count == 0)
                {
                    <div class="text-sm text-slate-500">No activity yet.</div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var cm in Model.Comments)
                        {
                            <div class="border-l-4 border-blue-400 bg-blue-50 p-3 rounded-r-lg">
                                <div class="flex justify-between items-start">
                                    <div class="text-xs font-semibold text-slate-700">@cm.ActionType</div>
                                    <div class="text-xs text-slate-500">@(cm.CreatedOn?.ToString("yyyy-MM-dd HH:mm")) · @cm.CreatedUser</div>
                                </div>
                                <div class="text-sm text-slate-700 mt-1">@cm.CommentText</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="stm-card">
                <div class="stm-section-title">Add Comment</div>
                <form id="commentForm">
                    <label class="stm-label">Comment</label>
                    <textarea id="commentBox" class="stm-input mb-3" rows="4" placeholder="Investigation notes..."></textarea>
                    <button type="button" class="stm-btn stm-btn-primary w-full justify-center" onclick="addComment()">Submit Comment</button>
                </form>
            </div>
        </div>

        <!-- RIGHT: Decision -->
        <div class="space-y-4">
            <div class="stm-card">
                <div class="stm-section-title">Decision</div>
                @if (isOpenStatus)
                {
                    <form id="reviewForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="caseId" value="@Model.Id" />
                        <label class="stm-label">Decision</label>
                        <select class="stm-select mb-3" name="decision" required>
                            <option value="">-- choose --</option>
                            <option value="TRUE_POSITIVE">True Positive (real risk)</option>
                            <option value="FALSE_POSITIVE">False Positive (no real risk)</option>
                            <option value="ESCALATE">Escalate to Senior Compliance</option>
                        </select>
                        <label class="stm-label">Final Status</label>
                        <select class="stm-select mb-3" name="status" required>
                            <option value="">-- choose --</option>
                            <option value="APPROVED">Approve (clear)</option>
                            <option value="REJECTED">Reject (block / refuse)</option>
                            <option value="ESCALATED">Escalate</option>
                            <option value="CLOSED">Close</option>
                        </select>
                        <label class="stm-label">Remarks</label>
                        <textarea class="stm-input mb-3" name="remarks" rows="4" placeholder="Investigation notes..." required></textarea>
                        <button type="button" class="stm-btn stm-btn-primary w-full justify-center" onclick="submitReview()">Submit Decision</button>
                    </form>
                }
                else
                {
                    <div class="text-sm">
                        <div><span class="text-slate-500">Decision:</span> <strong>@Model.ReviewDecision</strong></div>
                        <div><span class="text-slate-500">Reviewed on:</span> @(Model.ReviewedOn?.ToString("yyyy-MM-dd HH:mm"))</div>
                        <div class="mt-3"><span class="text-slate-500">Remarks:</span></div>
                        <div class="bg-slate-50 p-3 rounded-lg mt-1">@Model.ReviewRemarks</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    async function submitReview() {
        const f = document.getElementById('reviewForm');
        const fd = new FormData(f);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const r = await fetch('/stm/cases/review', { method: 'POST', body: fd, headers: token ? { 'RequestVerificationToken': token } : {} });
        const j = await r.json();
        alert(j.message || (j.success ? 'Decision submitted' : 'Failed'));
        if (j.success) location.reload();
    }
    async function addComment() {
        const c = document.getElementById('commentBox').value.trim();
        if (!c) return;
        const fd = new FormData();
        fd.append('caseId', '@Model.Id'); fd.append('comment', c);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const r = await fetch('/stm/cases/comment', { method: 'POST', body: fd, headers: token ? { 'RequestVerificationToken': token } : {} });
        const j = await r.json();
        if (j.success) location.reload(); else alert(j.message || 'Failed');
    }
    // ---- Transaction Risk panel ----
    const txnId = @(Model.TransactionId);
    async function loadRisk() {
        try {
            const r = await fetch('/stm/risk/result/' + txnId);
            const j = await r.json();
            const badge = document.getElementById('riskBadge');
            const summary = document.getElementById('riskSummary');
            const body = document.getElementById('riskBody');
            if (!j.success || !j.data) {
                badge.textContent = 'Not scored';
                badge.className = 'stm-badge closed';
                summary.textContent = 'No transaction risk has been computed yet. Click Re-evaluate to score now.';
                body.innerHTML = '<tr><td colspan="5" class="text-slate-400 text-xs py-4 text-center">No risk data</td></tr>';
                return;
            }
            const d = j.data;
            badge.textContent = (d.riskRating || 'Low') + ' Risk';
            badge.className = 'stm-badge ' + (d.riskRating || 'Low').toLowerCase();
            summary.innerHTML = `Score <strong>${d.totalScore || 0}</strong> from <strong>${d.factorCount || 0}</strong> factors. Computed ${(d.computedOn || '').toString().substring(0,16).replace('T',' ')}.`;
            const items = d.breakdown || [];
            if (!items.length) {
                body.innerHTML = '<tr><td colspan="5" class="text-slate-400 text-xs py-4 text-center">No factors matched</td></tr>';
            } else {
                body.innerHTML = items.map(it => `
                    <tr>
                        <td><div class="font-medium text-slate-800 text-xs">${it.factorName || ''}</div><div class="text-xs text-slate-500">${it.factorCode || ''}</div></td>
                        <td class="text-xs font-mono">${(it.fieldValue || '').toString().substring(0, 40)}</td>
                        <td class="text-xs">${it.bandLabel || ''}</td>
                        <td>${it.weightedScore || it.score || 0}</td>
                        <td><span class="stm-badge ${(it.rating || 'low').toLowerCase()}">${it.rating || ''}</span></td>
                    </tr>`).join('');
            }
        } catch (err) {
            console.error(err);
        }
    }
    async function recomputeRisk() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const r = await fetch('/stm/risk/evaluate/' + txnId, {
            method: 'POST',
            headers: token ? { 'RequestVerificationToken': token } : {}
        });
        const j = await r.json();
        if (!j.success) alert('Re-evaluate failed: ' + (j.message || 'unknown'));
        loadRisk();
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
        loadRisk();
    });
</script>
