@*
    Shared partial header / nav-bar fragment for STM module.
    Renders the top-level navigation pills used across STM pages.
*@
@{
    var active = ViewBag.StmActive as string ?? "";
}

<style>
    .stm-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 10px rgba(15,23,42,0.06); padding: 24px; }
    .stm-page-title { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
    .stm-page-sub { font-size: 0.875rem; color: #64748b; margin-bottom: 24px; }
    .stm-nav-pill {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 16px; border-radius: 8px;
        background: #f1f5f9; color: #475569; font-weight: 500; font-size: 0.875rem;
        text-decoration: none; transition: all .15s ease;
    }
    .stm-nav-pill:hover { background: #e2e8f0; color: #0f172a; text-decoration: none; }
    .stm-nav-pill.active { background: #2563eb; color: #fff; }
    .stm-badge {
        display: inline-block; padding: 2px 10px; border-radius: 12px;
        font-size: 0.75rem; font-weight: 600;
    }
    .stm-badge.high   { background: #fef2f2; color: #b91c1c; }
    .stm-badge.medium { background: #fef3c7; color: #b45309; }
    .stm-badge.low    { background: #ecfdf5; color: #047857; }
    .stm-badge.open   { background: #dbeafe; color: #1e40af; }
    .stm-badge.review { background: #fef3c7; color: #92400e; }
    .stm-badge.closed { background: #e2e8f0; color: #334155; }
    .stm-badge.approved { background: #d1fae5; color: #065f46; }
    .stm-badge.rejected { background: #fee2e2; color: #991b1b; }
    .stm-table { width: 100%; border-collapse: collapse; }
    .stm-table th { text-align: left; padding: 12px; background: #f8fafc; font-size: .75rem; text-transform: uppercase; color: #64748b; letter-spacing: 0.05em; }
    .stm-table td { padding: 12px; border-top: 1px solid #f1f5f9; font-size: .875rem; color: #334155; }
    .stm-table tr:hover { background: #f8fafc; }
    .stm-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: .875rem; font-weight: 500; cursor: pointer; border: 1px solid transparent; transition: all .15s; }
    .stm-btn-primary  { background: #2563eb; color: #fff; }
    .stm-btn-primary:hover  { background: #1d4ed8; }
    .stm-btn-secondary { background: #fff; color: #334155; border-color: #cbd5e1; }
    .stm-btn-secondary:hover { background: #f1f5f9; }
    .stm-btn-danger { background: #dc2626; color: #fff; }
    .stm-btn-success { background: #059669; color: #fff; }
    .stm-input, .stm-select { width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.875rem; background: #fff; }
    .stm-input:focus, .stm-select:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .stm-label { display: block; font-size: 0.75rem; font-weight: 600; color: #475569; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
    .stm-section-title { font-size: 1rem; font-weight: 600; color: #0f172a; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0; }
</style>

<div class="bg-white border-b border-slate-200 px-6 py-4 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Sectoral Transaction Monitoring</div>
            <div class="text-lg font-semibold text-slate-900 mt-1">Insurance &amp; Real Estate AML Monitoring</div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/stm" class="stm-nav-pill @(active == "dashboard" ? "active" : "")"><i data-lucide="layout-dashboard" class="w-4 h-4"></i>Dashboard</a>
            <a href="/stm/rules" class="stm-nav-pill @(active == "rules" ? "active" : "")"><i data-lucide="git-branch" class="w-4 h-4"></i>Rules</a>
            <a href="/stm/risk/factors" class="stm-nav-pill @(active == "risk" ? "active" : "")"><i data-lucide="shield-alert" class="w-4 h-4"></i>Risk Factors</a>
            <a href="/stm/transactions" class="stm-nav-pill @(active == "transactions" ? "active" : "")"><i data-lucide="receipt" class="w-4 h-4"></i>Transactions</a>
            <a href="/stm/cases/open" class="stm-nav-pill @(active == "open" ? "active" : "")"><i data-lucide="folder-open" class="w-4 h-4"></i>Open Cases</a>
            <a href="/stm/cases/completed" class="stm-nav-pill @(active == "completed" ? "active" : "")"><i data-lucide="check-circle-2" class="w-4 h-4"></i>Reviewed Cases</a>
            <a href="/stm/reports" class="stm-nav-pill @(active == "reports" ? "active" : "")"><i data-lucide="bar-chart-3" class="w-4 h-4"></i>Reports</a>
        </div>
    </div>
</div>
