@model AML.ViewModel.ViewModels.Report.CaseReportDownloadModel

<div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
        <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
            <tr>
                <th>#</th>
                <th>DATE</th>
                <th>CUSTOMER TYPE</th>
                <th>CUSTOMER ID</th>
                <th>CUSTOMER NAME</th>
                <th>MATCHED</th>
                <th>CREATED BY</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-bordercolor">
            @for (int i = 0; i < Model.Data.Count; i++)
            {
                <tr>
                    <td>@(i+1)</td>
                    <td>@Model.Data[i].CreatedOn</td>
                    <td>@Model.Data[i].CustomerType</td>
                    <td>@Model.Data[i].CustomerID</td>
                    <td>@Model.Data[i].CustomerName</td>
                    <td>@Model.Data[i].Match</td>
                    <td>@Model.Data[i].CreatedBy</td>
                </tr>
            }

        </tbody>
    </table>
</div>