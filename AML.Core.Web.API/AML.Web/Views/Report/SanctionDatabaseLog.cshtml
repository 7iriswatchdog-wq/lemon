<script type="text/javascript">
        let currentSortColumn = 0; // Default sort by Id
    let currentSortDirection = 'asc';
        let pageSize = parseInt($('#rowsPerPage').val()) || 10;
            let currentPage = 1;
            let totalPages = 1;
            let draw = 1;
            let allData;


            function fetchData(searchValue = '', page = 1) {
                $('#loader').show();
                pageSize = parseInt($('#rowsPerPage').val()) || 10;
                const start = (page - 1) * pageSize;

                $.ajax({
                    url: '/Report/SanctionDBUploadListing',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
                    },
                    data: {
                        draw: draw++,
                        start: start,
                        length: pageSize,  // Changed from 1e9 to use actual pageSize
                        search: { value: searchValue },
                        orderColumn: currentSortColumn, // Add this
            orderDirection: currentSortDirection

                    },
                    success: function (resp) {
                        const rows = resp.data || [];
                        const totalRecords = resp.recordsFiltered || 0;
                        allData = resp.allRows;
                        totalPages = Math.max(1, Math.ceil((totalRecords * 1.0) / pageSize));
                        console.log(totalRecords);

                        renderTable(rows);
                        renderPager(page);
                    },
                    error: function (xhr) {
                        console.error('Error fetching data:', xhr.statusText);
                    },
                    complete: function () {
                        $('#loader').hide();                }
                });
            }

            function renderTable(rows) {
                const $tbody = $('#filterTable tbody').empty();

                if (!rows.length) {
                    $tbody.append('<tr><td colspan="4" class="text-center py-4">No data available</td></tr>');
                    return;
                }

                rows.forEach(item => {  // Changed parameter from 'r' to 'item' to match usage
                    $tbody.append(`<tr>
                    <td>${item.id || ''}</td>
                    <td>${item.source || ''}</td>
                    <td>${formatDate(item.createdOn) || ''}</td>
                    <td>${item.totalrecords || ''}</td>
                </tr>`);  // Removed extra "</tr> td>" that was causing syntax error
                });
            }

            function renderPager(page) {
                const $pagerButtons = $('.pagination-buttons').empty();
                if (totalPages <= 1) return;

                const btn = (lbl, pg, disabled, active) =>
                    `<button class="px-3 py-1 border rounded
        ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
        ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
        data-page="${pg}" ${disabled ? 'disabled' : ''}>
        ${lbl}
    </button>`;

                $pagerButtons.append(btn('First', 1, page === 1));
                $pagerButtons.append(btn('Previous', page - 1, page === 1));

                const maxVisible = 5;
                let start = Math.max(1, page - Math.floor(maxVisible / 2));
                let end = start + maxVisible - 1;

                if (end > totalPages) {
                    end = totalPages;
                    start = Math.max(1, end - maxVisible + 1);
                }

                for (let i = start; i <= end; i++) {
                    $pagerButtons.append(btn(i, i, false, i === page));
                }

                $pagerButtons.append(btn('Next', page + 1, page === totalPages));
                $pagerButtons.append(btn('Last', totalPages, page === totalPages));
            }

            function formatDate(dateString) {
                if (!dateString) return '';
                const date = new Date(dateString);
                return date.toLocaleDateString('en-GB') + ' ' + date.toLocaleTimeString();
            }

            $('#rowsPerPage').on('change', () => {
                currentPage = 1;
                fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
            });

            $('.search').on('input', function () {
                const keyword = $(this).val().toLowerCase();

                const filteredData = allData.filter(item =>
                    (item.source || '').toLowerCase().includes(keyword) ||
                    (item.totalrecords + '').toLowerCase().includes(keyword) ||
                    (item.id + '').toLowerCase().includes(keyword) ||
                    (formatDate(item.createdOn) || '').toLowerCase().includes(keyword)
                );

                currentPage = 1;
                totalPages = Math.ceil(filteredData.length / pageSize);
                $('#loader').show();
                setTimeout(() => {
                    renderTable(filteredData.slice(0, pageSize));
                    renderPager(currentPage);
                    $('#loader').hide();
                }, 100);

            });

            $('.pagination-container').on('click', '.pagination-buttons button', function () {
                const pg = parseInt($(this).data('page'));
                if (!isNaN(pg) && pg >= 1 && pg <= totalPages) {
                    currentPage = pg;
                    fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
                }
            });// Default sort direction
        function sortTable(columnIndex) {
        // Reset all sort icons
        $('#filterTable th').removeClass('sort-asc sort-desc');
        $('#filterTable th i.fa-sort').css('color', '#ccc');

        // If clicking the same column, toggle direction
        if (currentSortColumn === columnIndex) {
            currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            // New column, default to ascending
            currentSortColumn = columnIndex;
            currentSortDirection = 'asc';
        }

        // Update the sort icon for the current column
        const $header = $('#filterTable th').eq(columnIndex);
        $header.addClass(`sort-${currentSortDirection}`);
        $header.find('i.fa-sort').css('color', '#2563eb');

        // Reload the data with new sorting
        fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
    }

    $(document).ready(function () {


        fetchData('', 1);
    });

    // Removed duplicate rowsPerPage change handler at the bottom
    
    function exportExcel() {
        const searchValue = $('input[placeholder="Search anything..."]').val() || '';
        toastr.info("Generating Excel report...");
        window.location.href = `/Report/SanctionDBUploadLogsExportExcel?match=${searchValue}`;
    }
</script>
