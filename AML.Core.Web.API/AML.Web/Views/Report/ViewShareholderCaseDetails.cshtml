                <h3 class="text-[13px] font-bold text-textprimary tracking-tight">
                    Search Results
                </h3>
            </div>

            <!-- Body -->
            <div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar">
                        @if (Model.DataList != null && Model.DataList.Any())
                        {
                            <div class="border-bordercolor rounded-lg overflow-hidden shadow-sm m-5">
                                <div class="overflow-x-auto">
                                    <table id="APITable" class="w-full text-sm text-left whitespace-nowrap">
                                    
                                        <thead class="text-xs text-textmuted  bg-surface border-b border-bordercolor">
                                            <tr>
                                                @* <th class="px-3 py-2">Type</th>
                                                <th class="px-3 py-2">Category</th> *@
                                                    <th class="px-3 py-2 whitespace-nowrap min-w-[260px]">Name</th>
