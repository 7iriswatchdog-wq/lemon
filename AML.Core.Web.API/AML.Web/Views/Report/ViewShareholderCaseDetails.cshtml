                                                            onclick="location.href='@Url.Action("GetDetails","Case",
                                                            new { caseId = Model.Case.Id, index = i })'">
                                                        Details
                                                    </button>
                                                }
                                            </td>

                                             <td class="px-3 py-3">
                                                        <input type="text" class="h-7 w-[120px] text-[10px] border p-1 rounded"
                                                               id="searchTypesValue-@i" readonly
                                                               value="@string.Join(",", Model.DataList[i].searchTypes ?? new List<string>())" />
                                             </td>

                                            <td class="px-3 py-3">
                                                <textarea asp-for="@Model.DataList[i].remarks"
                                                          class="h-7 w-[120px] text-[10px] border p-1 rounded"
                                                          placeholder="Enter" readonly></textarea>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* <div class="px-5 pb-4">
