                                                    <th class="px-3 py-2 min-w-[140px]">Nationality</th>
                                            <!-- <th class="px-3 py-2">Id No</th> -->
                                                    <th class="px-3 py-2 dob-label  whitespace-nowrap min-w-[120px]">DOB</th>
