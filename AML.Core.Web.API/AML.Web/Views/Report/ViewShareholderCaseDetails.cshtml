            function displayShortFileName(input) {

    if (input.files.length === 0) {
        document.getElementById("fileNameDisplay").innerText = "No file chosen";
        return;
    }

    let fullName = input.files[0].name;

    // Split name and extension
    let extension = fullName.split('.').pop();
    let nameWithoutExt = fullName.substring(0, fullName.lastIndexOf('.'));

    // Show first 5 characters only
    let shortName = nameWithoutExt.length > 10
        ? nameWithoutExt.substring(0, 10) + "..."
        : nameWithoutExt;

    document.getElementById("fileNameDisplay").innerText =
        shortName + "." + extension;
}
function setScreeningOptions(){
            const maxItems = 3; // show first 3 comma-separated values
            const shortEl = document.getElementById("screeningShort");
            const fullEl = document.getElementById("screeningFull");

            if (!shortEl) return;

            const fullText = shortEl.innerText;
            const items = fullText.split(",");

            // If content is small → no tooltip, no trimming
            if (items.length <= maxItems) {
                return;
            }

            // Trim text
            const shortText = items.slice(0, maxItems).join(", ") + " etc…";
            shortEl.innerText = shortText;
            shortEl.classList.add("cursor-pointer");

            // Enable hover tooltip ONLY when trimmed
            shortEl.parentElement.addEventListener("mouseenter", () => {
                fullEl.classList.remove("hidden");
            });

            shortEl.parentElement.addEventListener("mouseleave", () => {
                fullEl.classList.add("hidden");
            });
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', function () {
            //initializeSearchResults();
            
            setScreeningOptions();
        });
