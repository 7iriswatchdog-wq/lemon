@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = localizer["Manage Case"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
    var controllerName = "Risk";
    var actionName = "Create";

    if (Model?.Case?.CustomerType == "I")
    {
        controllerName = "Risk";
        actionName = "Create";
    }
    else if (Model?.Case?.CustomerType == "C")
    {
        controllerName = "Risk";
        actionName = "RiskAssessmentForCorpCustomer";
    }
}

@model AML.ViewModel.ViewModels.CaseProcess.CaseProcessModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Manager - Case Details</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        /* Modal backdrop */
        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.5);
        }

        /* Transition for column width */
        .column-transition {
            transition: width 300ms, opacity 300ms;
        }
    </style>
    <style>
        .dt-loader {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }</style>
</head>
<body class="bg-appbg min-h-screen text-textprimary">

    <div class="p-4 sm:p-6 min-h-screen flex flex-col">
        <div id="loadingeffect" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        </div>
    
    <div class="shrink-0 pb-4">
     <div class="flex items-center justify-between mb-2">
    <h1 class="text-lg font-black text-textprimary tracking-tight uppercase mb-3">
        Shareholders Case Manager
    </h1>
    <a href="@(ViewBag.ReturnUrl ?? "/case/process")" id="backBtn" class="bg-surface border border-bordercolor shadow-sm hover:bg-appbg text-textlabel font-bold h-10 px-5 rounded-md flex items-center gap-2 transition-colors text-sm">
                    Back
                </a>
    </div>

    <!-- Case Details Summary -->
    <div class="bg-surface rounded-lg border border-bordercolor p-5 shadow-sm">

        <!-- Header -->
        <div class="flex justify-between items-start mb-5">
            <div class="flex items-center gap-2">
                <div class="h-4 w-1 bg-primary rounded-full"></div>
                <h2 class="text-base font-bold text-textprimary leading-none">
                    Case Details
                </h2>
            </div>
            
            <div class="flex gap-1">
                <a href="/Report/ViewShareholderCaseDetails_PDF/@Model.Case.CustomerId?type=@Context.Request.Query["type"]&download=true" target="_blank"
                   class="h-8 w-8 flex items-center justify-center rounded-lg text-primary hover:bg-blue-50 transition-all" title="Download PDF">
                    <i data-lucide="download" class="h-4 w-4"></i>
                </a>
            </div>
            <button onclick="openModal('caseVersionModal')"
                                    class="h-8 w-8 flex items-center justify-center rounded-lg text-primary hover:bg-blue-50 transition-all no-pdf"
                                    title="View Case Version">

                                <i data-lucide="git-compare" class="h-4 w-4"></i>
                            </button>
            @* <button onclick="openModal('caseVersionModal')"
              class="h-8 text-[10px] font-bold  tracking-wider text-textmuted hover:text-primary px-3 border border-slate-300 rounded-md hover:border-blue-600 transition-colors">
                            View Case Version
            </button> *@
        </div>

        <!-- ROW 1 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mb-6">
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Customer ID</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.CustomerId</span>
            </div>

            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Creation Date</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.CreatedOnText</span>
            </div>
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Screening Options</span>
                <span id="screeningShort" class="text-sm font-bold text-textprimary tracking-tight">@Model.Case.ScreeningOptions</span>
                <span id="screeningFull"
                                    class="absolute left-0 top-full mt-1 hidden
                        bg-surface border shadow-md rounded-md
                        p-2 text-xs text-textlabel z-50
                        whitespace-normal max-w-lg">
                                @(Model.Case.ScreeningOptions)
                            </span>
            </div>

           

            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Customer Name</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight" truncate"
                      title="@($"{Model.Case.FirstName} {Model.Case.LastName}")">
                    @Model.Case.FirstName @Model.Case.LastName
                </span>
            </div>

           
        </div>

        <!-- ROW 2 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mb-6">
             <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Category</span>
                @if(Model.Case.CustomerType == "I"){
                <span class="text-[13px] font-medium text-textprimary " >
                    Individual
                            </span>
                        }
                        else
                        {
                            <span class="text-[13px] font-medium text-textprimary">
                                Corporate
                            </span>
                        }
                    </div>
             <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">@(Model.Case.CustomerType == "I" ? "Nationality" : "Country Of Incorporation")</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.Nationality</span>
            </div>
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">@(Model.Case.CustomerType == "I" ? "Date Of Birth" : "Date Of Registration")</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.DOB</span>
            </div>

            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">ID Type</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.CustomerIdType</span>
            </div>

           
           
            
        </div>

        <!-- ROW 3 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6">
             <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">ID Number</span>
                <span class="text-[13px] font-medium text-textprimary  truncate">@Model.Case.CustomerIdNumber</span>
            </div>
              <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Gender</span>
                <span class="text-[13px] font-medium text-textprimary ">@Model.Case.Gender</span>
            </div>
              

                    

            

            
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mt-6">
                    @if (Model.Case.CustomerType == "I")
                    {
                        <div class="grid grid-cols-[180px_1fr] pb-1 border-b border-dotted border-slate-300">
                            <span class="text-xs font-medium text-black-400 ml-3">
                                Place Of Birth
                            </span>
                            <span class="text-xs text-textmuted"> @(Model.Case.PlaceOfBirth) </span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Case.PassportId))
                    {
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">Passport Number</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.PassportId</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">Passport Issue Date</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">
                                @(string.IsNullOrWhiteSpace(Model.Case.PassportIssueDate)
                                                            ? "-"
                                                            : DateTime.TryParse(Model.Case.PassportIssueDate, out var passportDate)
                                                            ? passportDate.ToString("dd/MM/yyyy")
                                                            : Model.Case.PassportIssueDate)
                                                                                       </span>
                                                                                   </div>
                                                                                   <div class="flex flex-col space-y-1">
                                                                                       <span class="text-[12px]  text-textmuted  tracking-tight">Passport Expiry Date</span>
                                                                                       <span class="text-[13px] font-medium text-textprimary tracking-tight">
                                @(string.IsNullOrWhiteSpace(Model.Case.PassportExpiryDate)
                                                            ? "-"
                                                            : DateTime.TryParse(Model.Case.PassportExpiryDate, out var passportexipryDate)
                                                            ? passportexipryDate.ToString("dd/MM/yyyy")
                                                            : Model.Case.PassportExpiryDate)
                        </span>
                    </div>
                                        }
                    @if (!string.IsNullOrWhiteSpace(Model.Case.EmiratesIdNumber))
                    {
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">Emirates ID</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.EmiratesIdNumber</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">EID Issue Date</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">
                                @(string.IsNullOrWhiteSpace(Model.Case.EmiratesIdIssueDate)
                                                            ? "-"
                                                            : DateTime.TryParse(Model.Case.EmiratesIdIssueDate, out var emiratesissueDate)
                                                            ? emiratesissueDate.ToString("dd/MM/yyyy")
                                                            : Model.Case.EmiratesIdIssueDate)
                                                                                         </span>
                                                                                     </div>
                                                                                     <div class="flex flex-col space-y-1">
                                                                                         <span class="text-[12px]  text-textmuted  tracking-tight">EID Expiry Date</span>
                                                                                         <span class="text-[13px] font-medium text-textprimary tracking-tight">
                                @(string.IsNullOrWhiteSpace(Model.Case.EmiratesIdExpiryDate)
                                                            ? "-"
                                                            : DateTime.TryParse(Model.Case.EmiratesIdExpiryDate, out var emiratesexpiryDate)
                                                            ? emiratesexpiryDate.ToString("dd/MM/yyyy")
                                                            : Model.Case.EmiratesIdExpiryDate)
                        </span>
                    </div>
                                        }
                    @if (string.IsNullOrWhiteSpace(Model.Case.PassportId) && string.IsNullOrWhiteSpace(Model.Case.EmiratesIdNumber) && !string.IsNullOrWhiteSpace(Model.Case.CustomerIdType))
                    {
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">ID Type</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.CustomerIdType</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">ID Number</span>
                            <span class="text-[13px] font-medium text-textprimary  truncate">@Model.Case.CustomerIdNumber</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">ID Issue Date</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@(Model.Case.IdIssueDate?.ToString("dd/MM/yyyy") ?? "NA")</span>
                        </div>
                        <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">ID Expiry Date</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@(Model.Case.IdExpiryDate?.ToString("dd/MM/yyyy") ?? "NA")</span>
                        </div>
                    }
         </div>
        <!-- DOCUMENTS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mt-6">
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Customer CIF No</span>
                <span class="text-[13px] text-textprimary tracking-tight">@Model.Case.CIFNumber</span>
            </div>
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Match Parameter</span>
                <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.Threshold</span>
            </div>
                    @if(Model.Case.CustomerType == "I")
                    {
                      <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">Employer</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.Employer</span>
                      </div>  
                      <div class="flex flex-col space-y-1">
                            <span class="text-[12px]  text-textmuted  tracking-tight">Golden Visa</span>
                            <span class="text-[13px] font-medium text-textprimary tracking-tight">@Model.Case.GoldenVisa</span>
                      </div>  
                    }
            
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mt-6">
            <div class="flex flex-col space-y-1">
                <span class="text-[12px]  text-textmuted  tracking-tight">Uploaded Documents</span>
                @foreach (var item in Model.CaseDocuments)
                {
                    var shortName = item.DocumentFileName?.Length > 12
                        ? item.DocumentFileName.Substring(0, 12) + "..."
                        : item.DocumentFileName;

                    <a href="/Case/DownloadCaseDocument?filePath=@item.DocumentFullPath&fileName=@item.DocumentFileName"
                       title="@item.DocumentFileName"
                       class="text-primary text-xs font-semibold hover:underline">
                        @shortName
                    </a>
                }
            </div>
        </div>

    </div>
</div>
    <div class="flex-1 min-h-0 py-2 overflow-hidden flex w-full">

    <!-- FULL WIDTH COLUMN -->
    <div id="leftColumn" class="flex flex-col gap-6 w-full">

        <!-- Search Results Section -->
