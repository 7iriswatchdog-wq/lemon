        <div class="flex-6 min-h-0 flex flex-col gap-6">
                    @functions {
                        public string GetDynamicType(AML.ViewModel.ViewModels.CustomerCase.CaseModel child, IEnumerable<AML.ViewModel.ViewModels.CustomerCase.CaseModel> allShareholders, string currentCaseId, string currentCaseType, string parentCustomerId = null)
                        {
                            return AML.Web.Helpers.CaseStudioTypeHelper.GetDynamicType(child, allShareholders, currentCaseId, currentCaseType, parentCustomerId);
                        }

                        public IHtmlContent RenderShareholderTree(IEnumerable<AML.ViewModel.ViewModels.CustomerCase.CaseModel> shareholders, string parentCustomerId, int level = 0, bool isLastChild = false, List<bool> parentHasNextSibling = null, HashSet<string> renderedIds = null)
                        {
                            if (renderedIds == null) renderedIds = new HashSet<string>();
                            if (parentHasNextSibling == null) parentHasNextSibling = new List<bool>();

                            var currentPath = new HashSet<string>(renderedIds);
                            // Mark parent as rendered if it's the root call
                            if (level == 1 && !currentPath.Contains(parentCustomerId)) currentPath.Add(parentCustomerId);

                            // 1. Get Direct Children
                            var children = shareholders.Where(s => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, parentCustomerId) && !currentPath.Contains(s.CustomerId)).ToList();

                            // 2. Get Group Members (Entities in the same group but not in a parent-child relationship)
                            var parentNode = shareholders.FirstOrDefault(s => s.CustomerId == parentCustomerId);
                            var groupMembers = new List<AML.ViewModel.ViewModels.CustomerCase.CaseModel>();
                            if (parentNode != null && !string.IsNullOrEmpty(parentNode.GroupId))
                            {
                                var parentGroups = parentNode.GroupId.Split(',').Select(g => g.Trim()).Where(g => !string.IsNullOrEmpty(g)).ToList();
                                groupMembers = shareholders.Where(s =>
                                    s.CustomerId != parentCustomerId &&
                                    !currentPath.Contains(s.CustomerId) &&
                                    !AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, parentCustomerId) &&
                                    !string.IsNullOrEmpty(s.GroupId) &&
                                    s.GroupId.Split(',').Select(g => g.Trim()).Any(g => parentGroups.Contains(g))
                                ).ToList();
                            }

                            var allRelatedRaw = children.Concat(groupMembers).ToList();
                            var allRelated = allRelatedRaw
                                 .OrderBy(s => children.Contains(s) ? 0 : 1) // Direct children first
                                 .ThenBy(s => allRelatedRaw.Any(other => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, other.CustomerId)) ? 1 : 0) // Parents before children
                                 .ToList();

                            if (!allRelated.Any()) return HtmlString.Empty;

                            var html = new System.Text.StringBuilder();
                            html.Append("<div class='ml-5 space-y-1'>");

                             for (int i = 0; i < allRelated.Count; i++)
                             {
                                 var child = allRelated[i];
                                 if (currentPath.Contains(child.CustomerId)) continue;

                                 var currentIsLast = i == allRelated.Count - 1;
                                 var displayType = GetDynamicType(child, shareholders, Model.Case?.CustomerId, Model.Case?.CustomerType, parentCustomerId);
                                 
                                 html.Append($@"
                                         <div class='grid grid-cols-12 gap-2 items-center py-1 border-l border-bordercolor pl-2 hover:bg-gray-50'>
                                         <div class='col-span-3 font-semibold text-xs'>{child.CustomerId}</div>
                                         <div class='col-span-3 text-xs'>{child.LastName}</div>
                                         <div class='col-span-2 text-[10px] text-gray-500'>{displayType}</div>
                                         <div class='col-span-2 text-[10px] text-gray-400'>{((AML.Core.DataContract.Enum.CaseStatus)child.Status)}</div>
                                         <div class='col-span-2 text-primary text-xs font-bold'>");

                                 if (child.Status == 5 || child.Status == 0 || child.Status == 6)
                                     html.Append($"<a href='/case/Process/{child.Id}' class='hover:underline'>Process</a>");
                                 else
                                     html.Append($"<a href='/report/ViewIndividualCaseDetail?id={child.CustomerId}&version={child.Version}&type=1' class='hover:underline'>View</a>");

                                 html.Append("</div></div>");

                                 // Recursive call
                                 var nextPath = new HashSet<string>(currentPath);
                                 nextPath.Add(child.CustomerId);
                                 html.Append(RenderShareholderTree(shareholders, child.CustomerId, level + 1, currentIsLast, parentHasNextSibling, nextPath).ToString());
                             }

                             html.Append("</div>");
                             return new HtmlString(html.ToString());
                         }
                    }

                    @if (Model.Case.CustomerType == "C" && Model.ShareholdersData != null && Model.ShareholdersData.Any())
                    {
                        <div id="shareholdersSection" class="flex-1 min-h-0 bg-surface rounded-xl border border-bordercolor shadow-sm flex flex-col overflow-hidden">
                            <!-- Section Header -->
                            <div class="px-5 py-3 border-b border-bordercolor shrink-0">
                                <h3 class="text-[13px] font-bold text-textprimary uppercase">Shareholders Tree</h3>
                            </div>

                            <!-- Tree Container -->
                            <div class="flex-1 overflow-y-auto custom-scrollbar p-5">

                                <!-- Table Headers -->
                                <div class="grid grid-cols-12 gap-2 py-2 border-b border-bordercolor bg-gray-50">
                                    <div class="col-span-3 text-[10px] font-bold text-textmuted uppercase">ID</div>
                                    <div class="col-span-3 text-[10px] font-bold text-textmuted uppercase">Name</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted uppercase">Type</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted uppercase">Status</div>
                                    <div class="col-span-2 text-[10px] font-bold text-textmuted uppercase">Link</div>
                                </div>

                                <!-- Tree Body -->
                                @{
                                    var mainCustomerId = Model.Case?.CustomerId;
                                    var allShareholders = (Model.ShareholdersData ?? new List<AML.ViewModel.ViewModels.CustomerCase.CaseModel>())
                                        .GroupBy(s => s.CustomerId)
                                        .Select(g => {
                                            var first = g.First();
                                            var mergedParentIds = g
                                                .Where(x => !string.IsNullOrEmpty(x.ParentId))
                                                .SelectMany(x => x.ParentId.Split(',').Select(p => p.Trim()))
                                                .Where(p => !string.IsNullOrEmpty(p))
                                                .Distinct()
                                                .ToList();
                                            if (mergedParentIds.Any()) first.ParentId = string.Join(",", mergedParentIds);
                                            return first;
                                        })
                                        .ToList();
                                    var roots = new List<AML.ViewModel.ViewModels.CustomerCase.CaseModel>();

                                    if (!string.IsNullOrEmpty(mainCustomerId))
                                    {
                                        // 1. Direct children of the main entity
                                        var children = allShareholders.Where(s => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, mainCustomerId)).ToList();
                                        roots.AddRange(children);

                                        // 1.5 Immediate parent of the main entity
                                        if (!string.IsNullOrEmpty(Model.Case?.ParentId))
                                        {
                                            var parentNode = allShareholders.FirstOrDefault(s => s.CustomerId == Model.Case.ParentId);
                                            if (parentNode != null)
                                            {
                                                roots.Add(parentNode);
                                            }
                                        }

                                        // 2. Members of the same group — use Model.Case.GroupId directly
                                        // (mainNode lookup fails because the current entity is not in allShareholders)
                                        var caseGroupId = Model.Case?.GroupId;
                                        if (!string.IsNullOrEmpty(caseGroupId))
                                        {
                                            var mainGroups = caseGroupId.Split(',').Select(g => g.Trim()).Where(g => !string.IsNullOrEmpty(g)).ToList();
                                            var groupMembers = allShareholders.Where(s =>
                                                s.CustomerId != mainCustomerId &&
                                                !AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, mainCustomerId) &&
                                                !string.IsNullOrEmpty(s.GroupId) &&
                                                s.GroupId.Split(',').Select(g => g.Trim()).Any(g => mainGroups.Contains(g)) &&
                                                (!allShareholders.Any(other => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(s.ParentId, other.CustomerId)))
                                            ).ToList();
                                            roots.AddRange(groupMembers);
                                        }
                                    }

                                    // Deduplicate and sort (children first)
                                    roots = roots.GroupBy(r => r.CustomerId).Select(g => g.First())
                                                 .OrderBy(r => AML.Web.Helpers.CaseStudioTypeHelper.ParentIdContains(r.ParentId, mainCustomerId) ? 0 : 1)
                                                 .ToList();

                                    var renderedIds = new HashSet<string>();
                                    // CRITICAL: Explicitly exclude the main entity from the Related Parties list
                                    if (!string.IsNullOrEmpty(mainCustomerId)) renderedIds.Add(mainCustomerId);
                                }

                                @foreach (var parent in roots)
                                {
                                    <div class="grid grid-cols-12 gap-2 items-center py-2 border-b border-bordercolor bg-gray-50 font-bold hover:bg-gray-100">
                                        <div class="col-span-3 text-xs">@parent.CustomerId</div>
                                        <div class="col-span-3 text-xs">@parent.LastName</div>
                                        <div class="col-span-2 text-[10px] text-gray-500">@GetDynamicType(parent, allShareholders, Model.Case?.CustomerId, Model.Case?.CustomerType, Model.Case?.CustomerId)</div>
                                        <div class="col-span-2 text-[10px] text-gray-400">@((AML.Core.DataContract.Enum.CaseStatus)parent.Status)</div>
                                        <div class="col-span-2 text-primary text-xs font-bold">
                                            @if (parent.Status == 5 || parent.Status == 0 || parent.Status == 6)
                                            {
                                                <a href="/case/Process/@parent.Id" class="hover:underline">Process</a>
                                            }
                                            else
                                            {
                                                <a href="/report/ViewIndividualCaseDetail?id=@parent.CustomerId&version=@parent.Version&type=1" class="hover:underline">View</a>
                                            }
                                        </div>
                                    </div>

                                    @RenderShareholderTree(allShareholders, parent.CustomerId, 1, false, null, renderedIds)
                                }
                            </div>
                        </div>
                    }


                    <!-- Case History -->
                    <div class="flex-1 min-h-0 bg-surface rounded-xl border border-bordercolor shadow-sm overflow-hidden flex flex-col">

                        <div class="px-5 py-3 border-b shrink-0">
                            <h3 class="text-[13px] font-bold ">Case History</h3>
                        </div>

                        <div class="flex-1 min-h-0 overflow-y-auto p-5">
                            <div id="commentsContainer"
                                 class="relative border-l-2 border-bordercolor ml-2 space-y-8">
                            </div>
                        </div>

                    </div>

                </div>
    </div>
</div>
