                                                    <th class="px-3 py-2 min-w-[120px]">Search Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody id="searchResultsBody" class="divide-y divide-slate-100">

                                            @for (int i = 0; i < Model.DataList.Count; i++)
