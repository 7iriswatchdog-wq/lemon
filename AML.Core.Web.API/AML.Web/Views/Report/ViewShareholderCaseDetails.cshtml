                                                    <tr class="bg-surface hover:bg-appbg">
                                                        <td class="px-3 py-3 text-[11px] font-bold hidden">@Model.DataList[i].matchtype</td>
                                                        <td class="px-3 py-3 text-[11px] hidden">@Model.DataList[i].matchcategory</td>
                                                        @*  @* <td class="px-3 py-3 text-[11px]">@Model.DataList[i].matchname</td> *@
                                                        <td class="px-3 py-3 text-[11px] align-top">
                                                            <div class="max-w-[260px] whitespace-normal break-normal leading-snug">
                                                                @Model.DataList[i].matchname
                                                                @if (Model.DataList[i].FlagType == "OM")
                                                                {
                                                                    <!-- Ongoing Monitoring Icon -->

                                                                    <span class="inline-flex items-center" title="Hit generated by Ongoing Monitoring">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-500" viewBox="0 0 24 24" fill="currentColor">
                                                                            <path d="M12 2a6 6 0 0 0-6 6v3.586L4.293 13.293A1 1 0 0 0 5 15h14a1 1 0 0 0 .707-1.707L18 11.586V8a6 6 0 0 0-6-6zm0 20a3 3 0 0 0 2.995-2.824L15 19H9a3 3 0 0 0 3 3z" />
                                                                        </svg>
                                                                    </span>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="px-3 py-3 text-[11px]">@Model.DataList[i].matchscore</td>
                                                        <td class="px-3 py-3 text-[11px]">@Model.DataList[i].matchnationality</td>
                                                        <td class="px-3 py-3 text-[11px] hidden">@Model.DataList[i].matchidno</td>
                                                        <td class="px-3 py-3 text-[11px] whitespace-nowrap">@Model.DataList[i].matchdob</td>
@*                                                         <td class="px-3 py-3 text-[11px]">@Model.DataList[i].matchdatasets</td> *@
                                                        <td class="px-3 py-3 text-[11px]">
                                                            @{
                                                                var datasets = Model.DataList[i].matchdatasets?.Split(',');
                                                                var status = Model.DataList[i].Status;
                                                            }

                                                            @if (datasets != null)
                                                            {
                                                                for (int k = 0; k < datasets.Length; k += 2)
                                                                {
                                                                    <div>
                                                                        @{
                                                                            string Format(string val)
                                                                            {
                                                                                var value = val.Trim();

                                                                                if (!value.Equals("KYC6", StringComparison.OrdinalIgnoreCase) && status == "D")
                                                                                {
                                                                                    value += "-Former";
                                                                                }

                                                                                return value;
                                                                            }
                                                                        }

                                                                        @Format(datasets[k])

                                                                        @if (k + 1 < datasets.Length)
                                                                        {
                                                                            @(", " + Format(datasets[k + 1]))
                                                                        }
                                                                    </div>
                                                                }
                                                            }
                                                        </td>

                                                    @if (@Model.DataList[i].matchtype == "KYC6")
                                                    {
                                                        <td class="px-3 py-3">
                                                            <button class="h-7 px-3 text-[10px] bg-primary text-white rounded" onclick="location.href='@Url.Action("GetDetailsApi", "Case", new { Id = @Model.DataList[i].matchuid, Category = @Model.DataList[i].matchcategory, CaseId = Model.Case.Id, Type = @Model.DataList[i].matchtype, Resourcesid = @Model.DataList[i].matchresourcesid })'">
                                                                Details
                                                            </button>
                                                        </td>

                                                        @if (Model.DataList[i].matchresourcesid != "")
                                                        {
                                                            @* <td class="px-3 py-3">
                                                                <button class="h-7 px-3 text-[10px] bg-primary text-white rounded" onclick="location.href='@Url.Action("CallApi", "Case", new { Id = @Model.DataList[i].matchresourcesid, Category = @Model.DataList[i].matchcategory })'">
                                                                    Download
                                                                </button>
                                                            </td> *@
                                                            @* <td style="height:auto">
                                                                <input type="button" class="sas-button" value="Download" id="download"  style="background-image: url(/img/edit.png);background-repeat: no-repeat;background-position: 2px 3px;padding: 5px 10px !important;" />
                                                            </td> *@
                                                        }
                                                        else
                                                        {
                                                            @* <td class="px-3 py-3">
                                                                <button class="h-7 px-3 text-[10px] bg-primary text-white rounded" onclick="location.href='@Url.Action("CallApiMatchuid", "Case", new { Id = @Model.DataList[i].matchuid, Category = @Model.DataList[i].matchcategory })'">
                                                                    Download
                                                                </button>
                                                            </td> *@



                                                        }

                                                    }
                                                    else
                                                    {
                                                        <td class="px-3 py-3">
                                                            <button class="h-7 px-3 text-[10px] bg-primary text-white rounded" onclick="location.href='@Url.Action("GetDetails", "Case", new { caseId = Model.Case.Id, index = i })'">
                                                                Details
                                                            </button>
                                                        </td>
                                                        @* <td class="px-3 py-3">
                                                            <button class="h-7 px-3 text-[10px] bg-primary text-white rounded" onclick="location.href='@Url.Action("DownloadPdf", "Case", new { caseId = Model.Case.Id, index = i })'" style="display:none">
                                                                Download
                                                            </button>
                                                        </td> *@

                                                    }



                                                    @* Razor table cell example *@
                                                    <td class="px-3 py-3">
                                                            <!-- Hidden input holding existing values -->
                                                        <input class="h-7 w-[120px] text-[10px] border p-1 rounded"
                                                                   id="searchTypesValue-@i"
                                                                   value="@string.Join(", ", Model.DataList[i].searchTypes ?? new List<string>())" readonly />
                                                       
                                                    </td>



                                                    <td class="px-3 py-3">
