function LoadTable() {
    $('#filterTable').DataTable({
        "serverSide": true, "processing": true,
         order: [[0, 'desc']],
        ajax: {
            url: '/Report/KycReportCustompagination',
            type: 'POST',
            data: function (d) {
                d.userID = $('#userID').val(),
                    d.startDate = $('#dtStartDate').val(),
                    d.endDate = $('#dtEndDate').val(),
                    console.log("this is endDate", JSON.stringify(d.endDate));
                if ($('#customertype').val() == 'INDIVIDUAL')
                    d.cust_type = "I"
                else
                    if ($('#customertype').val() == 'CORPORATE')
                        d.cust_type = "C"
                    else
                        if ($('#customertype').val() == 'SHAREHOLDER')
                            d.cust_type = "S"
                        else
                            d.cust_type = ""
                    d.status = $('#caseStatusID').val(),
                    d.nomatch = $('#hdnnomatch').val(),
                    d.tdomesticpep = $('#hdndometicpep').val(),
                    d.tforeignpep = $('#hdntforeignpep').val(),
                    d.tadversemedia = $('#hdntadversemedia').val(),
                    d.pdomesticpep = $('#hdnpdometicpep').val(),
                    d.pforeignpep = $('#hdnpforeignpep').val(),
                    d.padversemedia = $('#hdnpadversemedia').val(),
                    d.pepdeclaration = $('#Pepdeclarationfrmclient').val(),
                    d.idstatus = $('#IdStatus').val()


            }
        },
