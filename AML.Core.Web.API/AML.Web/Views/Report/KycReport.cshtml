            align-items: center;
            padding: 4px 0;
            text-align: left;
            white-space: normal;
        }

        #checkboxes input[type="checkbox"] {
            width: 16px;
            min-width: 16px;
            height: 16px;
            margin: 4px;
            flex-shrink: 0;
        }

