        // KYC Report Module
        let pageSize = parseInt($('#rowsPerPage').val()) || 10;
        let currentPage = 1;
        let totalPages = 1;
        let drawCounter = 1;
        let searchTimeout;
        let allData;
            let currentSortColumn = 5; // Default sort by Customer ID
        let currentSortDirection = 'desc'; // Default sort direction
            function sortTable(columnIndex) {
            // Reset all sort icons
            $('#filterTable th').removeClass('sort-asc sort-desc');
            $('#filterTable th i.fa-sort').css('color', '#ccc');

            // If clicking the same column, toggle direction
            if (currentSortColumn === columnIndex) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                // New column, default to ascending
                currentSortColumn = columnIndex;
                currentSortDirection = 'asc';
            }

            // Update the sort icon for the current column
            const $header = $('#filterTable th').eq(columnIndex);
            $header.addClass(`sort-${currentSortDirection}`);
            $header.find('i.fa-sort').css('color', '#2563eb');

            // Reload the data with new sorting
            loadKycReport(currentPage, $('input[placeholder="Search anything..."]').val());
        }

        $(document).ready(function () {
            loadKycReport();

            // Debounced Search
            $('.search').on('input', function () {
                const keyword = $(this).val().toLowerCase();

                const filteredData = (allData || []).filter(item =>
                    (item.customerID + '').toLowerCase().includes(keyword) ||
                    (item.customerType || '').toLowerCase().includes(keyword) ||
                    (item.customerName || '').toLowerCase().includes(keyword) ||
                    (item.status || '').toLowerCase().includes(keyword) ||
                    (item.createdBy || '').toLowerCase().includes(keyword) ||
                    (item.createdOn || '').toLowerCase().includes(keyword)
                );

                currentPage = 1;
                totalPages = Math.ceil(filteredData.length / pageSize);
                $('#loader').show();

                setTimeout(() => {
                    const paginatedData = filteredData.slice(0, pageSize);
                    renderKycTable(paginatedData);
                    renderPager(currentPage);
                    $('#loader').hide();
                }, 100);
            });



            // Page size change
            $('#rowsPerPage').on('change', function () {
                pageSize = parseInt($(this).val()) || 10;
                currentPage = 1;
                loadKycReport(currentPage, $('input[placeholder="Search anything..."]').val());
            });

            // Pagination button
            $('.pagination-container').on('click', '.pagination-buttons button', function () {
                const pg = parseInt($(this).data('page'));
                if (!isNaN(pg) && pg >= 1 && pg <= totalPages) {
                    currentPage = pg;
                    loadKycReport(currentPage, $('input[placeholder="Search anything..."]').val());
                }
            });

            // Search button
            $('#btnSearch').click(function (e) {
                e.preventDefault();
                currentPage = 1;
                loadKycReport(currentPage);
            });

            // Reset button
            $("#btnReset").click(function () {
                const date = new Date();
                const today = date.toISOString().split('T')[0];
                date.setDate(date.getDate() - 7);
                const stdate = date.toISOString().split('T')[0];

                $('#dtStartDate').val(stdate);
                $('#dtEndDate').val(today);
                $('#caseStatusID').val(10);
                $('#userID').val(0);
                $('#customertype').val(0);
                $('input[placeholder="Search anything..."]').val('');

                currentPage = 1;
                loadKycReport(currentPage);
            });
        });

        function loadKycReport(page = 1, searchValue = '') {
            $('#loader').show();

            const filters = {
                draw: drawCounter++,
                start: (page - 1) * pageSize,
                length: pageSize,
                order: [{ column: 0, dir: "desc" }],
                userID: $('#userID').val(),
                startDate: $('#dtStartDate').val(),
                endDate: $('#dtEndDate').val(),
                status: $('#caseStatusID').val(),
                cust_type: $('#customertype').val() === 'INDIVIDUAL' ? 'I' :
                    $('#customertype').val() === 'CORPORATE' ? 'C' :
                        $('#customertype').val() === 'SHAREHOLDER' ? 'S' : '',
                nomatch: $('#hdnnomatch').val(),
                tdomesticpep: $('#hdndometicpep').val(),
                tforeignpep: $('#hdntforeignpep').val(),
                tadversemedia: $('#hdntadversemedia').val(),
                pdomesticpep: $('#hdnpdometicpep').val(),
                pforeignpep: $('#hdnpforeignpep').val(),
                padversemedia: $('#hdnpadversemedia').val(),
                pepdeclaration: $('#Pepdeclarationfrmclient').val(),
                idstatus: $('#IdStatus').val(),
                value: searchValue,
                    orderColumn: currentSortColumn, // Add this
                orderDirection: currentSortDirection
            };

            $.ajax({
                url: '/Report/KycReportCustompagination',
                type: 'POST',
                data: filters,
                success: function (resp) {
                    const rows = resp.data || [];
                    const totalRecords = resp.recordsFiltered || 0;
                    allData = resp.allRows;
                    totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));

                    renderKycTable(rows);
                    renderPager(page);
                },
                error: function (xhr) {
                    console.error('Error:', xhr.responseText);
                    alert('Error loading data');
                },
                complete: function () {
                    $('#loader').hide();
                }
            });
        }

        function renderKycTable(rows) {
            const $tbody = $('#filterTable tbody').empty();

            if (!rows.length) {
                $tbody.append('<tr><td colspan="7" class="text-center py-4">No data available</td></tr>');
                return;
            }

            rows.forEach(row => {
                let viewLink = '';
                const type = row.status?.includes('Auto') ? 2 : row.status?.includes('Pending') ? 3 : 1;
                const isIndividual = row.customerType === "Individual";
                const urlBase = isIndividual ? 'ViewIndividualKYCReport' : 'ViewCorporateKYCReport';
                viewLink = `<a class="sas-button bg-color-2 pt-2 view" href="${urlBase}?id=${row.customerID}&type=${type}" onclick="$('#loader').show();">View</a>`;

                $tbody.append(`
                <tr>
                    <td>${row.customerID || ''}</td>
                    <td>${row.customerType || ''}</td>
                    <td>${row.customerName || ''}</td>
                    <td>${row.status || ''}</td>
                    <td>${row.createdBy || ''}</td>
                    <td>${row.createdOn || ''}</td>
                    <td>${viewLink}</td>
                </tr>
            `);
            });
        }

        function renderPager(page) {
            const $pagerButtons = $('.pagination-buttons').empty();
            if (totalPages <= 1) return;

            const btn = (lbl, pg, disabled, active) =>
                `<button class="px-3 py-1 border rounded
                ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
                ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
                data-page="${pg}" ${disabled ? 'disabled' : ''}>${lbl}</button>`;

            $pagerButtons.append(btn('First', 1, page === 1));
            $pagerButtons.append(btn('Prev', page - 1, page === 1));

            const maxVisible = 5;
            let start = Math.max(1, page - Math.floor(maxVisible / 2));
            let end = Math.min(totalPages, start + maxVisible - 1);
            if (end - start < maxVisible - 1) {
                start = Math.max(1, end - maxVisible + 1);
            }

            for (let i = start; i <= end; i++) {
                $pagerButtons.append(btn(i, i, false, i === page));
            }

            $pagerButtons.append(btn('Next', page + 1, page === totalPages));
            $pagerButtons.append(btn('Last', totalPages, page === totalPages));
        }



        function showExportOptions() {
            const columns = [
                { id: "customerID", label: "Customer ID" },
                { id: "customerType", label: "Customer Type" },
                { id: "customerName", label: "Customer Name" },
                { id: "status", label: "Case Status" },
                { id: "createdBy", label: "Created By" },
                { id: "createdOn", label: "Creation Date" }
            ];

            openExportModal({
                getColumnsByActiveTab: () => columns,
                onExport: (format, selectedColumns, orientation) => {
                    ExportList(format === 'pdf', selectedColumns, orientation);
                }
            });
        }

        function ExportList(isPDF, selectedColumns, orientation) {
            $('#loader').show();
            const params = $.param({
                userID: $('#userID').val(),
                startDate: $('#dtStartDate').val(),
                endDate: $("#dtEndDate").val(),
                status: $('#caseStatusID').val(),
                IsPDF: isPDF,
                selectedColumns: selectedColumns || '',
                orientation: orientation || 'portrait'
            });

            window.location = '/Report/ExportkycCaseReport?' + params;
            $('#loader').hide();
        }

