        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    label, h6 {
        color: rgb(17, 24, 39);
    }

    input, select {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter;
    }

        input:focus {
            border: 1px solid rgb(37,99,235) !important;
        }

        select:focus {
            border: 1px solid rgb(37,99,235) !important;
        }


    select {
        font-weight: lighter;
    }

    option {
        font-weight: lighter;
    }

    .flex-box1 {
