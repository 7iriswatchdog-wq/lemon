@{
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
    var clientId = HttpContextAccessor.HttpContext.Session.GetString("SessClientId");
    var logo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.Risk.RiskModel
<style>
    .risk-header {
        text-align: center;
    }

    .risk-assessment-div {
        margin-top: 20px;
        padding-left: 10px;
        padding-right: 10px;
    }

    .subcategory tr td {
        border-top: none !important;
        border-bottom: 1px solid #ddd;
    }

    .row {
        display: -ms-flexbox;
        display: flex;
        -ms-flex-wrap: wrap;
        flex-wrap: wrap;
        margin-right: 7.5px;
        margin-left: -7.5px;
    }

    .subcategory tr td {
        border-top: none !important;
        /* border-bottom: 1px solid #ddd; */
    }

    .subcategory tr td {
        /* border-top: none !important; */
        border-bottom: none !important;
    }

    .grid-select {
        width: 300px !important;
    }

    .pulse-button {
        position: relative;
        width: 34px;
        height: 34px;
        border: none;
        box-shadow: 0 0 0 0 rgba(232, 76, 61, 0.7);
        border-radius: 50%;
        background-color: #e84c3d;
        background-size: cover;
        background-repeat: no-repeat;
        cursor: pointer;
        -webkit-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        -moz-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        -ms-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
    }

        .pulse-button:hover {
            -webkit-animation: none;
            -moz-animation: none;
            -ms-animation: none;
            animation: none;
        }


    @@-webkit-keyframes pulse {
        to {
            box-shadow: 0 0 0 45px rgba(232, 76, 61, 0);
        }
    }

    @@-moz-keyframes pulse {
        to {
            box-shadow: 0 0 0 45px rgba(232, 76, 61, 0);
        }
    }

    @@-ms-keyframes pulse {
        to {
            box-shadow: 0 0 0 45px rgba(232, 76, 61, 0);
        }
    }

    @@keyframes pulse {
        to {
            box-shadow: 0 0 0 45px rgba(232, 76, 61, 0);
        }
    }

    #container {
        display: block;
        position: relative
    }

    .ui-autocomplete {
        position: absolute;
    }
/*
    @@media print {
        

        .print_color{
           color:black !important;
        }
    }*/
</style>
<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css" rel="Stylesheet" type="text/css" />
<link href="~/css/print.css" media="print" rel="Stylesheet" type="text/css" />
<div class="col-md-12 text-right">
    <a asp-controller="Risk" asp-action="GetRiskReport"> <button type="button" id="btnBack" class="btn btn-primary center" >Back</button></a>
    <input name="b_print" type="button" onClick="printdiv();" value="Print" class="btn btn-secondary center" >

</div>
<div class="card card-primary bg-blue" id="reportViewDetails">
    <br />
    <div style="width:100%;display:none" id="logodiv">
        <div style="width:98%;text-align:center;">
            <h2>@companyName</h2>
            <img src=@logo style="width:8%;float:right;" />
        </div>
        <br />
    </div>
    <br />
    <br />
    <!-- form start -->
    @*<form role="form" asp-controller="Risk" asp-action="Create" class="form-horizontal" enctype="multipart/form-data" method="post">*@
    <input type="hidden" asp-for="IsWhiteListed" id="hfIsWhiteListed" />
    <div class="row">
        <div class="col-md-8">
            <div class="card card-primary card-body">
                <div class="px-6 py-4 border-b border-bordercolor">
                    <h3 class="card-title">RISK ASSESSMENT FOR INDIVIDUALS</h3>
                </div>
                <div class="risk-assessment-div">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="dtCustomerCode" class="print_color">Customer Code</label>
                                <input type="text" class="form-control print_color" asp-for="CustomerCode" id="hfCustomerCode" readonly />
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label for="dtCustomerName">Customer Name</label>
                                <input type="text" asp-for="CustomerName" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtCustomerName" placeholder="Customer Name" maxlength="200" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="txtAddress">DOB</label>
                                  <input type="text" asp-for="Dob" class="form-control h-38px" id="txtdob"  readonly />
                               
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Nationality</label>
                                <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="MainNationalityTxt" id="mainNationalityTxt" placeholder="Nationality" readonly />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label for="txtDateofAssessment">Date of Assessment</label>
                                <input type="date" asp-for="DateofAssessment" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" max="3000-12-31" id="txtDateofAssessment" placeholder="Date of Assessment" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-primary card-body">
                <div class="px-6 py-4 border-b border-bordercolor">
                    <h3 class="card-title">Final Risk Score</h3>
                </div>
                <br>
                <div class="col-sm">
                    @*<button id="btntotalscoretop" disabled class="dt-button-info form-control" type="button">Low</button>*@
                    <label for="txtDateofAssessment">Final Risk Score</label><br />
                    <input type="text" asp-for="FinalRiskScore" id="finalRiskScoreTxt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly />
                    <br />
                    <label for="txtDateofAssessment">Risk Score Before Override</label><br />
                    <input type="text" asp-for="RiskScoreBeforeOverride" id="riskScoreBeforeOverrideTxt" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly />
                </div>
                <br />
                <div>
                    <div class="row">
                        <div class="col-sm">
                            @*<label>Risk Override</label>
                            <div class="form-group">
                            <button id="btnAsPerRiskScore" disabled class="dt-button-info form-control risk-button" type="button">As Per Risk Score</button>
                            </div>
                            <div class="form-group">
                            <button id="btnDomocileOverride" disabled class="btn btn-danger form-control risk-button" type="button">Country of Domicile Override</button>
                            <input type="hidden" asp-for="Riskc12Override" id="riskc12OverrideTxt" />
                            </div>
                            <div class="form-group">
                            <button id="btnResidenceOverrides" disabled class="btn btn-danger form-control risk-button" type="button">Residence vs Nationality Overrides</button>
                            <input type="hidden" asp-for="Riskc9c11Override" id="riskc9c11OverrideTxt" />
                            </div>
                            <div class="form-group">
                            <button id="btnTransactionOverrides" disabled class="btn btn-danger form-control risk-button" type="button">Transaction Monitoring Overrides</button>
                            <input type="hidden" asp-for="Riskc19Toc22Override" id="riskc19Toc22OverrideTxt" />
                            </div>
                            <div class="form-group">
                            <button id="btnRiskScreeningAndFindingOverrides" disabled class="btn btn-danger form-control risk-button" type="button">Screening & Payments Overrides</button>
                            <input type="hidden" asp-for="RiskScreeningAndFindingOverride" id="riskScreeningAndFindingOverrideTxt" />
                            </div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card card-body">
        <div>
            <table class="table" style="page-break-after:auto">
                <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                    <tr class="row">
                        <th class="col-md-2">
                            Categorization
                        </th>
                        <th class="col-md-6" style=" padding-left: 98px;">
                            Sub-Categorization
                        </th>
                        <th class="col-md-2">
                            Select Drop Down
                        </th>
                        <th class="col-md-2" style="padding-left: 71px;">
                            Rating Scale
                        </th>
                    </tr>
                </thead>
                @{
                    int a = 0;
                }
                @foreach (var i in Model.RiskTypeCategoryDTO)
                {
                    <tr class="row">
                        <td class="col-md-2">
                            @i.RiskCategory
                        </td>
                        <td class="col-md-10 row">
                            <table class=" subcategory" id="RiskSubTable">
                                <tbody class="divide-y divide-bordercolor">
                                    @foreach (var j in i.RiskTypes)
                                    {
                                        <tr>
                                            <td style="width: 592px;">
                                                @j.RiskType
                                            </td>
                                            <td>
                                                <input type="text" asp-for="@j.ItemTxt" id="RiskItemTxt_@a" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly />
                                            </td>
                                            <td style="text-align: center;">
                                                @if (j.ItemScore == 0)
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-secondary riskscorebtn">@j.ItemScore</button>
                                                }
                                                else if (j.ItemScore == 1)
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-success riskscorebtn">@j.ItemScore</button>
                                                }
                                                else if (j.ItemScore == 2)
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-warning riskscorebtn">@j.ItemScore</button>
                                                }
                                                else if (j.ItemScore == 3)
                                                {
                                                    if (j.OverrideScore == 3)
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger pulse-button riskscorebtn">@j.ItemScore</button>
                                                    }
                                                    else
                                                    {
                                                        <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger riskscorebtn">@j.ItemScore</button>
                                                    }
                                                }
                                                else
                                                {
                                                    <button id="clrScore_@a" type="submit" class="btn btn-block btn-danger riskscorebtn">@j.ItemScore</button>
                                                }
                                            </td>
                                        </tr>
                                        a = a + 1;
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }

            </table>
        </div>
        <div class="px-6 py-4 border-b border-bordercolor">
            <div class="row">
                <div class="col-sm">
                    <label class="card-title">Total Selected :    <button id="btntotal" class="dt-button-info result-score" type="submit">@Model.RiskScoreCount</button></label>  <label class="card-title" style="margin-left: 20px;">Total score :    <button id="btntotalscore" class="dt-button-info result-score" type="submit">@Model.RiskScoreSum</button></label>
                </div>
                @*<div class="col-sm">
                <h3 class="card-title" style="padding-top: 13px;"><b>RISK SCORE &nbsp;</b></h3><button type="button" class="btn btn-success" style="padding: 8px 30px;" id="lowTxt">0</button><button type="button" class="btn btn-warning" style="padding: 8px 30px;" id="mediumTxt">0</button><button class="btn btn-danger" style="padding: 8px 30px;" id="highTxt">0</button>
                </div>*@
            </div>
        </div>
    </div>
    <!-- /.card-body -->
    @*<div class="card-footer">
    <button type="submit" class="btn btn-primary">Submit</button>
    <button type="button" class="btn btn-danger" onclick="location.href='@Url.Action("Index", "Risk" )'">Cancel</button>
    </div>*@
    @*</form>*@
    <br />
    <div style="width:90%;display:none;padding-left:2%;" id="footdiv">
        <p>Computer generated report; hence no signature is required.</p>
    </div>
</div>
<script type="text/javascript">
    function printdiv() 
    {
        var newstr = document.all.item(reportViewDetails).innerHTML;
        const oldstr = document.body.innerHTML;
        document.body.innerHTML = newstr ;
        
        document.getElementById("logodiv").style.display = "";
        document.getElementById("footdiv").style.display = "";
        window.print();
        return false;
    }
</script>





