@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer

@{

    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";

}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var companyName = HttpContextAccessor.HttpContext.Session.GetString("SessCompanyName");
    var companyLog = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
    var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}
@model AML.ViewModel.ViewModels.Kyc.CorporateKycModel
<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.4/css/jquery.dataTables.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>

<style>
    .page {
   
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border-bottom: 1px solid #dee2e6;
        
    }

    .card1 {
        max-width: 95%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
        box-shadow: 0 0 #0000, /* fallback ring-offset-shadow */
        0 0 #0000, /* fallback ring-shadow */
        0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .heading {
        font-size: 1.25rem;
    }

    #printBtnDiv {
        display: flex;
        width: 90%;
        justify-content: flex-end;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .go {
        background-color: rgb(37,99,235);
        border-radius: 8px;
        padding: 8px 20px;
        color: white;
    }

    .clear {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    .form-group {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
    }

    .firstrow {
        display: flex;
        width: 100%; /* Full width of its parent */
    }

    .flex-item1 {
        flex: 1;
    }

        .flex-item1 input {
            width: 90%; /* full width of the parent */
            min-width: 40%;
            box-sizing: border-box; /* includes padding in the width */
            padding: 8px;
            border-radius: 4px; /* spacing between inputs */
        }

    .match-parameter input {
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    input, select, textarea {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter;
    }

    textarea {
        width: 100%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px;
    }

    input:focus {
        border: 2px solid rgb(37,99,235) !important;
    }

    select:focus {
        border: 2px solid rgb(37,99,235) !important;
    }

    select {
        font-weight: lighter;
    }

    .flex-box {
        width: 90%;
        display: flex;
        flex-wrap: wrap;
        margin: 10px 0px;
    }

        .flex-box > .flex-item {
            flex: 1 1 250px !important;
            text-align: center !important;
        }

    .flex-item input, .flex-item textarea {
        width: 80%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    .flex-box > .flex-item3 {
        flex: 1 1 150px !important;
        text-align: center !important;
    }

    .flex-item3 input, .flex-item textarea {
        width: 80%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    .status {
        display: flex;
        gap: 20%;
        flex-wrap: wrap;
    }
    @@media (max-width: 768px) {
        .page {
            width: 80vw;
        }
    }

        .flex-item2 input {
            padding: 8px;
            border-radius: 4px;
            min-width: 300px;
        }

        table {
            max-width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        thead {
            background-color: rgb(233,239,253);
        }

        th, td {
            padding: 10px;
            text-align: left;
        }

        thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

        th {
            font-weight: 500;
        }

        table {
            width: 100% !important;
        }

        .table1 th, .table1 td {
            width: calc(100% / 2);
            word-wrap: break-word;
            text-align: center;
        }

        .table2 th, .table2 td {
            width: calc(100% / 7);
            word-wrap: break-word;
            text-align: center;
        }

        .table3 th, .table3 td {
            width: calc(100% / 7);
            word-wrap: break-word;
            text-align: center;
        }

        table {
            display: table; /* Ensure tables display as tables */
            width: 100% !important;
        }

        .footer-row {
            display: flex;
            justify-content: space-between;
        }

        @@media (max-width: 768px) {
            .table-container {
                overflow-x: auto;
            }

            .footer-row {
                display: flex;
                flex-direction: column;
                gap: 20px;
            }
        }

        tr {
            border: none !important;
        }

        td {
            padding: 15px;
        }
</style>
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>

<body>
    <div class="page bg-gray-50">
        <div class="custom-container">

            <div class="page-heading head-section">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 heading"><b>KYC View</b></h4>
                    <div class="menu-icon">
                        <i class="lni lni-microsoft"></i>
                    </div>
                </div>
                <div class="md:block">
                    <img src="@Clientlogo" alt="Client Logo" width="50px" />
                </div>
            </div>
            @* *@
        <div class="card1 relative">
            <div id="loader" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
                <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
            </div>
            <div id="printthisform">
                <div class="sas-card rounded-card mb-2 bg-blue">


                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><b>Corporate KYC Details</b></h6>
                    </div>




                    <div id="printDetails" class="row justify-content-end" style="width:100%">
                        <div style="width:100% !important;" id="printBtnDiv" class="col-md-12 text-right">
                            <a asp-controller="Report" asp-action="KycReport"> <button type="button" id="btnBack" class="h-10 px-4 rounded-lg border border-bordercolor bg-surface hover:bg-appbg text-textprimary text-[13px] font-bold transition-colors clear" align="right" onclick="$('#loader').show();">Back</button></a>
                            <input name="b_print" class="h-10 px-4 rounded-lg bg-primary hover:bg-primary-hover text-white text-[13px] font-bold transition-colors ml-2 go" type="button" id="printform" onclick="$('#loader').show(); setTimeout(function() { $('#loader').hide(); }, 2000);" value=@localizer["Print"]>
                        </div>
                        <div style="width:100%;display:none" id="logodiv">
                            <div style="width:98%;text-align:center;">
                                <h2>@companyName</h2>
                                <img src="~/img/Watchdog Logo.png" style="width:100%;float:right;" />
                            </div>
                        </div>
                    </div>



                    <form role="form" asp-controller="CustomerMaster" asp-action="EditCorporate" class="form-horizontal" enctype="multipart/form-data" method="post">
                        <input type="hidden" asp-for="CustomerId" id="hfCustomerID">
                        <span class="print_color">@localizer["Name of Corporate"]</span>
                        <div class=" firstrow">
                            <div class="col-sm-12 flex-item1">
                                <div class="form-group">
                                    <span for="fname" class="m-0">@localizer["Full Name"]</span>
                                    <input type="text" asp-for="FullName" readonly class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" required="required" id="fname">
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4 flex-box">



                            <div class="col-sm-6 flex-item">
                                <div class="form-group">
                                    @if (@Model.DateofIncorporation.ToString() == "1/1/0001 12:00:00 AM")
                        {
                                    <span for="date_incorporation" class="m-0">@localizer["Date of Incorporation"]</span>
                                    <input type="date" value="" readonly class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="date_incorporation" max="@(DateTime.Now.ToString("yyyy-MM-dd"))">
                        }
                        else
                        {
                                    <span for="date_incorporation" class="m-0">@localizer["Date of Incorporation"]</span>
                                    <input type="date" asp-for="DateofIncorporation" readonly class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="date_incorporation" max="@(DateTime.Now.ToString("yyyy-MM-dd"))">
                        }
                                </div>
                            </div>

                            <div class="col-sm-6 flex-item">
                                <div class="form-group">
                                    <span for="place_incorporation" class="m-0">@localizer["Country of Incorporation"]</span>
                                    <input type="text" asp-for="PlaceofIncorporation" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="place_incorporation" readonly>
                                </div>
                            </div>
                        </div>


                        <div class="status row mb-4">
                            <div class="col-sm-4 flex-item2">
                                <strong class="mb-2">@localizer["Type of Entity/ Legal Status"]</strong>
                            </div>
                            <div class="col-sm-4 flex-item2">
                                <input class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" type="text" readonly asp-for="EntityTypeTxt" id="ddlpublic_l_Company" />
                            </div>
                        </div>

                        <div class="row" id="entityTypeOther" style="display:none;">
                            <div class="col-sm-6">
                                <span>@localizer["Others (Please specify)"] </span>
                            </div><div class="col-sm-6">
                                <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="EntityType" asp-for="EntityTypeTxt" onkeypress="alphaCheck(event)">
                            </div>
                        </div>

                        <span class="print_color">@localizer["Address of Entity"]</span>
                        <div class="flex-box row">
                            <div class="flex-item3 col-sm-3">
                                <div class="form-group">
                                    <span for="city" class="m-0">@localizer["City"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly id="city" asp-for="EntityAddress.City">
                                </div>
                            </div>

                            <div class="col-sm-3 flex-item3">
                                <div class="form-group">
                                    <span for="emirate" class="m-0">@localizer["Emirate"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="emirate" readonly asp-for="EntityAddress.Emirate">
                                </div>
                            </div>

                            <div class="flex-item3 col-sm-3">
                                <div class="form-group">
                                    <span for="country" class="m-0">@localizer["Country"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="country" readonly asp-for="EntityAddress.Country">
                                </div>
                            </div>

                            <div class="col-sm-3 flex-item3">
                                <div class="form-group">
                                    <span for="p_o_box" class="m-0">@localizer["P.O. Box"]:</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="p_o_box" readonly asp-for="EntityAddress.POBox">
                                </div>
                            </div>
                        </div>


                        <div class="flex-box row mb-4">
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="corporate_website" class="col-12"><strong>@localizer["Corporate Website"]</strong></span>

                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="corporate_website" readonly asp-for="CorporateWebsite">
                                </div>
                            </div>

                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="telephone_no" class="m-0">@localizer["Tel. No"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="telephone_no" readonly asp-for="Telephone">
                                </div>
                            </div>

                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span class="m-0" for="fax_no">@localizer["Email ID"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="email_id" readonly asp-for="Email">
                                </div>
                            </div>
                        </div>


                        <span class="print_color">@localizer["Commercial License Details"]</span>
                        <div class="flex-box row mb-4">
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="license_no" class="m-0">@localizer["License Number"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="license_no" readonly asp-for="CommercialLicense.LicenseNumber">
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="licence_issue_date" class="m-0">@localizer["License Issue Date"]</span>
                                    <input type="date" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="licence_issue_date" readonly asp-for="CommercialLicense.LicenseIssueDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))">
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="licence_issuing_authority" class="m-0">@localizer["License Issuing Authority"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly id="licence_issuing_authority" asp-for="CommercialLicense.LicenseIssuingAuthority">
                                </div>
                            </div>
                        </div>

                        <div class="flex-box row mb-4">
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="licence_exp_date" class="m-0">@localizer["License Expiry Date"]</span>
                                    <input type="date" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="licence_exp_date" asp-for="CommercialLicense.LicenseExpiryDate" max="@(DateTime.Now.ToString("yyyy-MM-dd"))">
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="place_of_issue" class="m-0">@localizer["Place of Issue"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="place_of_issue" readonly asp-for="CommercialLicense.PlaceofIssue">
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="ddlLicenseType" class="m-0">@localizer["License Type"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly id="ddlLicenseTypehdn" asp-for="CommercialLicense.LicenseTypeTxt" />
                                </div>
                            </div>

                        </div>

                        <div class="flex-box row mb-4">
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span for="oprations_trading" class="m-0">@localizer["Business Activity"]</span>
                                    <input type="text" id="ddlBusinessTypehdn" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" readonly asp-for="BusinessType">
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span class="m-0">@localizer["Product Type"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="ddlProductTypehdn" asp-for="ProductName" />
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span class="m-0">@localizer["Delivery Channel"]</span>
                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="ddlProductTypehdn" asp-for="DeliveryChannelName" />
                                </div>
                            </div>
                        </div>

                        <div class="flex-box row mb-4">

                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span>@localizer["Mode of Payment"]</span>
                                    <input id="ddlmodeofpayment" type="text" readonly class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" asp-for="Modeofpayment" />
                                </div>

                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span>@localizer["VAT Registration Number"]</span>

                                    <input type="text" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="vat_registration" readonly asp-for="VATRegistrationNumber">
                                </div>
                            </div>



                            <div class="col-sm-4 flex-item">
                                <div class="form-group">

                                    <span>@localizer["Source of funds"]</span>

                                    <input type="text" id="ddlFundSource" class="form-control mb-2 mt-2 br-50" readonly asp-for="FundSourceOther">
                                </div>
                            </div>
                        </div>

                        <div class="flex-box mb-2">
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span>@localizer["Pep Declaration"]</span>
                                    <input class="form-control " type="text" readonly asp-for="PEPStatus" id="pep" />
                                </div>
                            </div>
                            <div class="col-sm-4 flex-item">
                                <div class="form-group">
                                    <span>@localizer["Address"]</span>
                                    <input class="form-control " type="text" readonly asp-for="Address" id="address" />
                                </div>
                            </div>
                            <div class="flex-item">
                            </div>
                        </div>

                        <div class="form-group row" style="display:none;" id="FundOther">
                            <div class="col-sm-3">
                                <label for="other_ps">@localizer["Other (Please Specify)"]</label>
                            </div>
                            <div class="col-sm-9">
                                <input type="text" readonly class="form-control mb-2 mt-2 br-50" id="ddlFundSourcehdn" placeholder=@localizer["Other"] asp-for="FundSourceOther">

                            </div>
                        </div>




                        @{
                    if (Model.GroupEntity != null)
                    {
                            <span class="print_color" style="display: block;">@localizer["Group Entity Information (if Applicable)"]</span>
                            <input type="hidden" id="GroupEntityRowIndex" value="1" />
                            <input type="hidden" id="GroupEntityCount" value="1" />
                            <input type="button" value="Add" class="btn btn-info" onclick="AddGroupEntity()" style="display:none;" />

                            <div class="row table-container">
                                <table id="tbl_group_entity" class="w-full text-sm text-left">
                                    <thead class="table1">
                                        <tr>
                                            <th class="print_color">@localizer["Entity Name"]</th>
                                            <th class="print_color">@localizer["Country of Incorporation"]</th>

                                        </tr>
                                    </thead>
                                    <tbody class="table1">
                                        @foreach (var item in @Model.GroupEntity)
                                    {
                                        <tr>
                                            <td class="print_color">@item.EntityName</td>
                                            <td class="print_color">@item.PlaceofIncorporation</td>
                                        </tr>
