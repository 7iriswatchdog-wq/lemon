<script type="text/javascript">

    $('#printform').on("click", function () {
        $(this).hide();
        $('#btnBack').hide();
        $('#printthisform').printThis({
            importCSS: true,
            loadCSS: "/css/print.css",
            header: '<div style="background: linear-gradient(180deg, #33394e 0%, #2F3961 100%);"><h1 style="color:white">@companyName <img src="@companyLog" style="width:10%;float: right;" /></h1></div>',
            afterPrint: function () {
                $('#printform').show();
                $('#btnBack').show();
            }
        });

    });

    $('#ddlCountryList').change(function () {
        $('#country').val($('#ddlCountryList :selected').text());

    });

    $('#ddlLicenseType').change(function () {
        $('#ddlLicenseTypehdn').val($('#ddlLicenseType :selected').text());

    });



    $('#ddlpublic_l_Company').change(function () {
        $('#EntityType').val($('#ddlpublic_l_Company :selected').text());

    });

    $('#ddlFundSource').change(function () {
        if ($('#ddlFundSource :selected').text() == "Other") {
            var x = document.getElementById('FundOther');
            $('#ddlFundSourcehdn').val('');
            x.style.display = "block";
        }
        else {
            var x = document.getElementById('FundOther');
            x.style.display = "none";
        }
        $('#ddlFundSourcehdn').val($('#ddlFundSource :selected').text());

    });
    $('#ddlpublic_l_Company').change(function () {
        if ($('#ddlpublic_l_Company :selected').text() == "Other") {
            var x = document.getElementById('entityTypeOther');
            $('#EntityType').val('');
            x.style.display = "";
        }
        else {
            var x = document.getElementById('entityTypeOther');
            x.style.display = "none";
        }
        $('#EntityType').val($('#ddlpublic_l_Company :selected').text());
    });

    $('#btnSubmit').click(function () {
        $('.se-pre-con').show();
        $('.se-pre-con').fadeOut(5000);
    });

    function printdiv(printpage) {

        var newstr = document.all.item(printpage).innerHTML;
        var oldstr = document.body.innerHTML;
        document.body.innerHTML =  newstr;
        document.getElementById("logodiv").style.display = "";
        //document.getElementById("createddiv").style.display = "";
        document.getElementById("footdiv").style.display = "";
        document.getElementById("printBtnDiv").style.display = "none";
        window.print();
        document.body.innerHTML = oldstr;
        document.getElementById("printBtnDiv").style.display = "";
        return false;
    }
</script>



