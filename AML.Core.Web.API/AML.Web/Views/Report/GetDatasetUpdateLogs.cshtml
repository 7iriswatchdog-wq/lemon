<script>
    let pageSize = 10;
    let currentPage = 1;
    let totalRecords = 0;
    let orderColumn = 0;
    let orderDirection = 'desc';
    let drawCounter = 1;

    $(document).ready(function () {
        lucide.createIcons();
        loadData();

        // Filters should work only upon clicking the Apply button
        /*
        $('#searchInput').on('input', function() {
            currentPage = 1;
            loadData();
        });

        $('#datasetsFilter').on('change', function() {
            currentPage = 1;
            loadData();
        });
        */
    });

    function formatDate(value) {
        if (!value) return null;

        // ✅ Already in yyyy-MM-dd
        if (value.includes('-') && value.split('-')[0].length === 4) {
            return value;
        }

        // ✅ Convert dd/MM/yyyy → yyyy-MM-dd
        if (value.includes('/')) {
            let parts = value.split('/');
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        return null;
    }
        function formatDateTime(dateStr) {
        if (!dateStr) return { date: '-', time: '-' };

        const d = new Date(dateStr);

        return {
            date: d.toLocaleDateString('en-GB'), // 20/02/2026
            time: d.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',   // ✅ added
                hour12: true
            }) // 06:43:15 PM
        };
    }

    

    function exportTableToCSV(filename) {
        // We will fetch all data from backend for export to get the complete dataset
        $("#loadingCaseDetails").removeClass("hidden");
        $.ajax({
            url: '/Report/DatasetUpdateLogsCustompagination',
            type: 'POST',
            data: {
                draw: 1,
                start: 0,
                length: -1, // Fetch all records for export if supported, otherwise just current total
                orderColumn: orderColumn,
                orderDirection: orderDirection,
                search: { value: $('#searchInput').val() },
                startDate: formatDate($('#startDate').val()),
                endDate: formatDate($('#endDate').val()),
                datasets: $('#datasetsFilter').val()
            },
            success: function (resp) {
                let csv = [];
                let headers = ['Updated Date', 'Datasets', 'Delta', 'Humiliated', 'Action'];
                csv.push(headers.join(','));

                console.log(resp);
                console.log(resp.data);

                resp.data.forEach(row => {
                    const updated = formatDateTime(row.updatedDate);
                    

                    let r = [
                        updated?.date ? `="${updated.date}"` : '',
                        row.datasets ?? '',
                        row.delta ?? '',
                        row.humiliated ?? '',
                        row.action ?? ''
                    ];
                    csv.push(r.join(','));
                });

                let csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
                let downloadLink = document.createElement('a');
                downloadLink.download = filename;
                downloadLink.href = window.URL.createObjectURL(csvFile);
                downloadLink.style.display = 'none';
                document.body.appendChild(downloadLink);
                downloadLink.click();
                document.body.removeChild(downloadLink);
            },
            complete: function() {
                $("#loadingCaseDetails").addClass("hidden");
            }
        });
    }

    function sortTable(columnIndex, element) {
        $('.sortable').removeClass('active asc desc');
        if (orderColumn === columnIndex) {
            orderDirection = orderDirection === 'asc' ? 'desc' : 'asc';
        } else {
            orderColumn = columnIndex;
            orderDirection = 'asc';
        }
        $(element).addClass('active ' + orderDirection);
        loadData();
    }
     function applyFilters() {
        loadData();
    }

    function loadData() {
        
        $("#loadingCaseDetails").removeClass("hidden");
        $.ajax({
            url: '/Report/DatasetUpdateLogsCustompagination',
            type: 'POST',
            data: {
                draw: drawCounter++,
                start: (currentPage - 1) * pageSize,
                length: pageSize,
                orderColumn: orderColumn,
                orderDirection: orderDirection,
                search: { value: $('#searchInput').val() },
                startDate: formatDate($('#startDate').val()),
                endDate: formatDate($('#endDate').val()),
                datasets: $('#datasetsFilter').val()
            },
            success: function (resp) {
                if (resp.error) {
                   // $('#clientsTableBody').empty().append('<tr><td colspan="5" class="h-24 text-center text-red-500">Error: ' + resp.error + '</td></tr>');
                   $('#clientsTableBody').empty().append('<tr><td colspan="5" class="h-24 text-center text-red-500">Something went wrong</td></tr>');
                   toastr.error('Error: ' + resp.error);
                    return;
                }
                console.log(resp.data);
                renderTable(resp.data);
                totalRecords = resp.recordsFiltered;
                updatePagination();
            },
            complete: function () {
                $("#loadingCaseDetails").addClass("hidden");
            },
            error: function (xhr) {
                $('#clientsTableBody').empty().append('<tr><td colspan="5" class="h-24 text-center text-red-500">Something went wrong</td></tr>');
                toastr.error('HTTP Error: ' + xhr.status + ' ' + xhr.statusText);
            }
        });
    }

    function renderTable(data) {
        const tbody = $('#clientsTableBody').empty();
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="5" class="h-24 text-center text-slate-500">No client records found.</td></tr>');
            return;
        }

        data.forEach(row => {
             const { date, time } = formatDate(row.updatedDate);
            const updated = formatDateTime(row.updatedDate);
            
            tbody.append(`
                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                   <td class="px-6 py-4">
                             <!-- Updated (only if exists) -->
                            ${updated ? `
                                <div class="text-xs text-slate-700">
                                    <div>${updated?.date || '-'}</div>
                                    <div class="ml-2">
                                        ${updated?.time ? updated.time.replace(/\s?(AM|PM)/i, '') : ''}
                                    </div>
                                </div>
                            ` : ''}
                        </td>



                <td class="px-6 py-4 ">${row.datasets}</td>
                 <td class="px-6 py-4 ">${row.delta}</td>
                 <td class="px-6 py-4 ">${row.humiliated}</td>
                 <td class="px-6 py-4 text-left">
                        ${row.datasets && row.datasets.toLowerCase().includes('kyc6') ? '' : `
                       <a href="javascript:void(0)"
                       onclick="openPopup('${updated?.date}','${row.datasets}')"
                       class="text-blue-600 font-bold text-xs underline">
                       View
                    </a>`}
                    </td>
                </tr>
            `);
        });
        lucide.createIcons();
    }

    function updatePagination() {
        const start = totalRecords === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);
    }

    function goToPage(page) {
        currentPage = page;
        loadData();
    }

    function previousPage() {
        if (currentPage > 1) goToPage(currentPage - 1);
    }

    function nextPage() {
        if (currentPage * pageSize < totalRecords) goToPage(currentPage + 1);
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        loadData();
    }
    
    document.addEventListener("DOMContentLoaded", function () {

        function initDatePicker(selector, defaultDate, isEndDate = false) {
            return flatpickr(selector, {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                defaultDate: defaultDate,
                allowInput: true,

                // ✅ Conditional logic
                // ...(isEndDate
                //     ? { minDate: "today" }   // End Date → no past dates
                //     : { maxDate: "today" }   // Start Date → no future dates
                // )
            });
        }

        // ✅ Start Date → 1 year back, max today
        const startPicker = initDatePicker("#startDate", new Date().fp_incr(-365));

        // ✅ End Date → today, min today
        const endPicker = initDatePicker("#endDate", new Date(), true);

    });
    
    function clearFilters() {
        // Reset text inputs and dropdowns
        $('#searchInput').val('');
        $('#datasetsFilter').val('');
        currentPage = 1;

        // Reset dates
        const today = new Date();
        const lastYear = new Date();
        lastYear.setFullYear(today.getFullYear() - 1);

        // Reset Flatpickr instances
        if (document.querySelector("#startDate")._flatpickr) {
            document.querySelector("#startDate")._flatpickr.setDate(lastYear, true);
        }

        if (document.querySelector("#endDate")._flatpickr) {
            document.querySelector("#endDate")._flatpickr.setDate(today, true);
        }

        // Apply the reset state
        loadData();
    }

            async function openPopup(date,type) {
        try {
            // date = "07/04/2026" (DD/MM/YYYY)

            const parts = date.split('/');
            const formattedDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 


            const response = await fetch(`/GetNamesByCreatedDate?date=${formattedDate}&type=${type}`);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            

            const data = await response.json();

            let indHtml = "";
            let corpHtml = "";
            let indCount = 0;
            let corpCount = 0;

            const maxRecords = 100;
            let totalProcessed = 0;

            if (data && data.length > 0) {
                for (const item of data) {
                    const li = `<li class="py-2 px-3 bg-white/50 hover:bg-white hover:shadow-sm rounded-lg transition-all duration-200 border border-transparent hover:border-slate-200">${item.fullname}</li>`;
                    
                    if (item.category === "INDIVIDUAL") {
                        if (indCount < maxRecords) indHtml += li;
                        indCount++;
                    } else {
                        if (corpCount < maxRecords) corpHtml += li;
                        corpCount++;
                    }
                    totalProcessed++;
                }
            }

            const individualList = document.getElementById("individualList");
            const corporateList = document.getElementById("corporateList");


            if (indCount > 0) {
                individualList.innerHTML = indHtml;
                if (indCount > maxRecords) {
                    // individualList.innerHTML += `<li class="py-2 px-3 text-xs italic text-slate-500 text-center border-t border-slate-100 mt-2">Showing 100 of ${indCount} records</li>`;
                }

            

            } else {
                individualList.innerHTML = `<li class="py-8 text-center text-slate-500 italic flex flex-col items-center gap-3"><i data-lucide="inbox" class="h-8 w-8 text-blue-200"></i>No individual records found</li>`;
            }

            if (corpCount > 0) {
                corporateList.innerHTML = corpHtml;
                if (corpCount > maxRecords) {
                    // corporateList.innerHTML += `<li class="py-2 px-3 text-xs italic text-slate-500 text-center border-t border-slate-100 mt-2">Showing 100 of ${corpCount} records</li>`;
                }
            } else {
                corporateList.innerHTML = `<li class="py-8 text-center text-slate-500 italic flex flex-col items-center gap-3"><i data-lucide="inbox" class="h-8 w-8 text-green-200"></i>No corporate records found</li>`;
            }
            
            document.getElementById("individualCount").textContent = indCount;
            document.getElementById("corporateCount").textContent = corpCount;
            
            // Re-initialize for empty states inbox icons
            if (window.lucide) {
                lucide.createIcons();
            }

        } catch (err) {
            console.error("Error fetching name list:", err);
            document.getElementById("individualList").innerHTML = `<li class="text-red-500 text-center py-4 font-bold bg-red-50 rounded-lg">Error loading data</li>`;
            document.getElementById("corporateList").innerHTML = `<li class="text-red-500 text-center py-4 font-bold bg-red-50 rounded-lg">Error loading data</li>`;
            if (typeof toastr !== 'undefined') {
                toastr.error("Failed to load records.");
            }
        } finally {
            document.getElementById("modalLoader").classList.add("hidden");
        }
    }

    function closePopup() {
        const overlay = document.getElementById("nameModalOverlay");
        const dialog = document.getElementById("nameModalDialog");
        
        // Add leave animations
        overlay.classList.add("opacity-0");
        dialog.classList.remove("scale-100", "opacity-100");
        dialog.classList.add("scale-95", "opacity-0");
        
        // Wait for transition to finish before hiding
        setTimeout(() => {
            overlay.classList.add("hidden");
        }, 300);
    }

    // Handle click outside to close
    function handleModalOverlayClick(event) {
        if (event.target.id === "nameModalOverlay") {
            closePopup();
        }
    }

    // Close modal on Escape key
    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            const overlay = document.getElementById("nameModalOverlay");
            if (overlay && !overlay.classList.contains("hidden")) {
                closePopup();
            }
        }
    });
</script>


