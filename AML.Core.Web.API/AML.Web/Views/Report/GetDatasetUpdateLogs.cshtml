        body {
            font-family: 'Inter', sans-serif;
        }
        
        /* Scrollable lists styling */
        .scrollable-list {
            max-height: 300px;
            overflow-y: auto;
            padding-right: 8px;
        }
        
        .scrollable-list::-webkit-scrollbar {
            width: 6px;
        }
        
        .scrollable-list::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }
        
        .scrollable-list::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 3px;
        }
        
        .scrollable-list::-webkit-scrollbar-thumb:hover {
            background: #a0aec0;
        }
    </style>
    

    <style>
        .dt-loader {
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0,1,1,0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }

        #caseDetailsTbl, #caseDetailsTbl th, #caseDetailsTbl td {
            border: none !important;
            border-radius: 0 !important;
        }

        th.sortable {
            cursor: pointer;
            position: relative;
            padding-right: 20px;
        }

            th.sortable::after {
                content: "▲\A▼";
                white-space: pre;
                font-size: 10px;
                position: absolute;
                right: 6px;
                top: 50%;
                transform: translateY(-50%);
                color: #bbb;
                line-height: 1;
                text-align: center;
            }

            th.sortable.active.asc::after {
                content: "▲";
                color: #000;
            }

            th.sortable.active.desc::after {
                content: '\A▼';
                color: #000;
            }
    </style>
</head>
