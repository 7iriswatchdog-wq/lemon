<script>
    let pageSize = 10;
    let currentPage = 1;
    let totalRecords = 0;
    let orderColumn = 0;
    let orderDirection = 'desc';
    let drawCounter = 1;

    $(document).ready(function () {
        lucide.createIcons();
        loadData();

        // Filters should work only upon clicking the Apply button
        /*
        $('#searchInput').on('input', function() {
            currentPage = 1;
            loadData();
        });

        $('#datasetsFilter').on('change', function() {
            currentPage = 1;
            loadData();
        });
        */
    });

    function formatDate(value) {
        if (!value) return null;

        // ✅ Already in yyyy-MM-dd
        if (value.includes('-') && value.split('-')[0].length === 4) {
            return value;
        }

        // ✅ Convert dd/MM/yyyy → yyyy-MM-dd
        if (value.includes('/')) {
            let parts = value.split('/');
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        return null;
    }
        function formatDateTime(dateStr) {
        if (!dateStr) return { date: '-', time: '-' };

        const d = new Date(dateStr);

        return {
            date: d.toLocaleDateString('en-GB'), // 20/02/2026
            time: d.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',   // ✅ added
                hour12: true
            }) // 06:43:15 PM
        };
    }


    function showExportOptions() {
        const columns = [
            { id: "updatedDate", label: "Updated Date" },
            { id: "datasets", label: "Datasets" },
            { id: "delta", label: "Delta" },
            { id: "individual", label: "Individual" },
            { id: "corporate", label: "Corporate" },
            { id: "cumulative", label: "Cumulative" }
        ];

        openExportModal({
            getColumnsByActiveTab: () => columns,
            onExport: (format, selectedColumns, orientation) => {
                const orientationValue = orientation || 'portrait';
                ExportList(format === 'pdf', selectedColumns, orientationValue);
            }
        });
    }

    function ExportList(isPDF, selectedColumns, orientation) {
        const startDate = formatDate($('#startDate').val());
        const endDate = formatDate($('#endDate').val());
        const datasets = $('#datasetsFilter').val();
        const searchValue = $('#searchInput').val() || '';
        const params = `startDate=${startDate}&endDate=${endDate}&datasets=${datasets}&searchValue=${encodeURIComponent(searchValue)}&selectedColumns=${selectedColumns || ''}&orientation=${orientation || 'portrait'}`;
        
        if (isPDF) {
            $('#loader').removeClass('hidden').addClass('flex');
            const url = `/Report/DatasetUpdateLogs_PDF?${params}`;
            $('#pdfExportFrame').attr('src', url);
        } else {
            const url = `/Report/DatasetUpdateLogsExportReport?${params}`;
            window.location.href = url;
        }
    }


    function sortTable(columnIndex, element) {
        $('.sortable').removeClass('active asc desc');
        if (orderColumn === columnIndex) {
            orderDirection = orderDirection === 'asc' ? 'desc' : 'asc';
        } else {
            orderColumn = columnIndex;
            orderDirection = 'asc';
        }
        $(element).addClass('active ' + orderDirection);
        loadData();
    }
     function applyFilters() {
        loadData();
    }

    function loadData() {
        
        $("#loadingCaseDetails").removeClass("hidden");
        $.ajax({
            url: '/Report/DatasetUpdateLogsCustompagination',
            type: 'POST',
            data: {
                draw: drawCounter++,
                start: (currentPage - 1) * pageSize,
                length: pageSize,
                orderColumn: orderColumn,
                orderDirection: orderDirection,
                search: { value: $('#searchInput').val() },
                startDate: formatDate($('#startDate').val()),
                endDate: formatDate($('#endDate').val()),
                datasets: $('#datasetsFilter').val()
            },
            success: function (resp) {
                if (resp.error) {
                   // $('#clientsTableBody').empty().append('<tr><td colspan="5" class="h-24 text-center text-red-500">Error: ' + resp.error + '</td></tr>');
                   $('#clientsTableBody').empty().append('<tr><td colspan="5" class="h-24 text-center text-red-500">Something went wrong</td></tr>');
                   toastr.error('Error: ' + resp.error);
                    return;
                }
                console.log(resp.data);
                renderTable(resp.data);
                totalRecords = resp.recordsFiltered;
                updatePagination();
            },
            complete: function () {
                $("#loadingCaseDetails").addClass("hidden");
            },
            error: function (xhr) {
                $('#clientsTableBody').empty().append('<tr><td colspan="5" class="h-24 text-center text-red-500">Something went wrong</td></tr>');
                toastr.error('HTTP Error: ' + xhr.status + ' ' + xhr.statusText);
            }
        });
    }

    function renderTable(data) {
        const tbody = $('#clientsTableBody').empty();
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="5" class="h-24 text-center text-slate-500">No client records found.</td></tr>');
            return;
        }

        data.forEach(row => {
             const { date, time } = formatDate(row.updatedDate);
            const updated = formatDateTime(row.updatedDate);
            
            tbody.append(`
                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                   <td class="px-6 py-4">
                             <!-- Updated (only if exists) -->
                            ${updated ? `
                                <div class="text-xs text-slate-700">
                                    <div>${updated?.date || '-'}</div>
                                    <div class="ml-2">
                                        ${updated?.time ? updated.time.replace(/\s?(AM|PM)/i, '') : ''}
                                    </div>
                                </div>
                            ` : ''}
                        </td>



                <td class="px-6 py-4 ">${row.datasets}</td>
                <td class="px-6 py-4 ">${row.delta}</td>
                 <td class="px-6 py-4 ">
                    ${(row.datasets && row.datasets.toLowerCase().includes('kyc6')) || !row.individual || row.individual == 0 ? row.individual : `
                        <a href="javascript:void(0)" onclick="openPopup('${updated?.date}','${row.datasets}', 'INDIVIDUAL')" class="text-blue-600 font-bold underline cursor-pointer">${row.individual}</a>
                    `}
                 </td>
                 <td class="px-6 py-4 ">
                    ${(row.datasets && row.datasets.toLowerCase().includes('kyc6')) || !row.corporate || row.corporate == 0 ? row.corporate : `
                        <a href="javascript:void(0)" onclick="openPopup('${updated?.date}','${row.datasets}', 'CORPORATE')" class="text-green-600 font-bold underline cursor-pointer">${row.corporate}</a>
                    `}
                 </td>
                 <td class="px-6 py-4 ">
                    ${(row.datasets && row.datasets.toLowerCase().includes('kyc6')) || !row.deleted || row.deleted == 0 ? row.corporate : `
                        <a href="javascript:void(0)" onclick="openDeletedPopup('${row.id}')" class="text-green-600 font-bold underline cursor-pointer">${row.deleted}</a>
                    `}
                 </td>
                 <td class="px-6 py-4 ">${row.cumulative}</td>
                </tr>
            `);
        });
        lucide.createIcons();
    }

    function updatePagination() {
        const start = totalRecords === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);
    }

    function goToPage(page) {
        currentPage = page;
        loadData();
    }

    function previousPage() {
        if (currentPage > 1) goToPage(currentPage - 1);
    }

    function nextPage() {
        if (currentPage * pageSize < totalRecords) goToPage(currentPage + 1);
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        loadData();
    }
    
    document.addEventListener("DOMContentLoaded", function () {

        function initDatePicker(selector, defaultDate, isEndDate = false) {
            return flatpickr(selector, {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                defaultDate: defaultDate,
                allowInput: true,

                // ✅ Conditional logic
                // ...(isEndDate
                //     ? { minDate: "today" }   // End Date → no past dates
                //     : { maxDate: "today" }   // Start Date → no future dates
                // )
            });
        }

        // ✅ Start Date → 1 year back, max today
        const startPicker = initDatePicker("#startDate", new Date().fp_incr(-365));

        // ✅ End Date → today, min today
        const endPicker = initDatePicker("#endDate", new Date(), true);

    });
    
    function clearFilters() {
        // Reset text inputs and dropdowns
        $('#searchInput').val('');
        $('#datasetsFilter').val('');
        currentPage = 1;

        // Reset dates
        const today = new Date();
        const lastYear = new Date();
        lastYear.setFullYear(today.getFullYear() - 1);

        // Reset Flatpickr instances
        if (document.querySelector("#startDate")._flatpickr) {
            document.querySelector("#startDate")._flatpickr.setDate(lastYear, true);
        }

        if (document.querySelector("#endDate")._flatpickr) {
            document.querySelector("#endDate")._flatpickr.setDate(today, true);
        }

        // Apply the reset state
        loadData();
    }

            async function openPopup(date, dataset, category) {
        const overlay = document.getElementById("nameModalOverlay");
        const dialog = document.getElementById("nameModalDialog");
        const modalLoader = document.getElementById("modalLoader");

        // Step 1: Show overlay & modal immediately with loader
        document.getElementById("modalRecordList").innerHTML = "";
        document.getElementById("modalRecordCount").textContent = "0";
        overlay.classList.remove("hidden");
        modalLoader.classList.remove("hidden");

        setTimeout(() => {
            overlay.classList.remove("opacity-0");
            dialog.classList.remove("scale-95", "opacity-0");
            dialog.classList.add("scale-100", "opacity-100");
        }, 10);

        try {
            // date = "07/04/2026" (DD/MM/YYYY)

            const parts = date.split('/');
            const formattedDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 


            const response = await fetch(`/GetNamesByCreatedDate?date=${formattedDate}&type=${dataset}&category=${category}`);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            

            const data = await response.json();

            let listHtml = "";
            let recordCount = 0;
            const maxRecords = 100;

            if (data && data.length > 0) {
                for (const item of data) {
                    const isCorporateItem = item.category !== "INDIVIDUAL";
                    const isCorporateFilter = category !== "INDIVIDUAL";

                    if ((category === "INDIVIDUAL" && item.category === "INDIVIDUAL") || 
                        (isCorporateFilter && isCorporateItem)) {
                        
                        const li = `<li class="py-2 px-3 border-b border-slate-100 last:border-0">${item.fullname}</li>`;
                        if (recordCount < maxRecords) listHtml += li;
                        recordCount++;
                    }
                }
            }

            const recordList = document.getElementById("modalRecordList");
            const modalCategoryTitle = document.getElementById("modalCategoryTitle");
            const modalRecordCount = document.getElementById("modalRecordCount");
            
            const modalRecordContainer = document.getElementById("modalRecordContainer");
            const modalRecordHeader = document.getElementById("modalRecordHeader");
            
            modalCategoryTitle.textContent = category === "INDIVIDUAL" ? "Individual" : "Corporate";
            modalRecordCount.textContent = recordCount;

            if (category === "INDIVIDUAL") {
                modalRecordContainer.className = "flex flex-col h-full bg-blue-50/30 border border-blue-100 rounded-xl overflow-hidden shadow-sm";
                modalRecordHeader.className = "px-5 py-3.5 bg-blue-50/70 border-b border-blue-100 flex justify-between items-center";
                modalCategoryTitle.className = "font-bold text-sm text-blue-800 uppercase tracking-widest";
                modalRecordCount.className = "bg-blue-200 text-blue-800 text-xs font-bold px-2.5 py-0.5 rounded-full shadow-sm";
            } else {
                modalRecordContainer.className = "flex flex-col h-full bg-green-50/30 border border-green-100 rounded-xl overflow-hidden shadow-sm";
                modalRecordHeader.className = "px-5 py-3.5 bg-green-50/70 border-b border-green-100 flex justify-between items-center";
                modalCategoryTitle.className = "font-bold text-sm text-green-800 uppercase tracking-widest";
                modalRecordCount.className = "bg-green-200 text-green-800 text-xs font-bold px-2.5 py-0.5 rounded-full shadow-sm";
            }

            if (recordCount > 0) {
                recordList.innerHTML = listHtml;
            } else {
                let iconColor = category === "INDIVIDUAL" ? "text-blue-200" : "text-green-200";
                let catName = category === "INDIVIDUAL" ? "individual" : "corporate";
                recordList.innerHTML = `<li class="py-8 text-center text-slate-500 italic flex flex-col items-center gap-3"><i data-lucide="inbox" class="h-8 w-8 ${iconColor}"></i>No ${catName} records found</li>`;
            }

                // Re-initialize for empty states inbox icons
            if (window.lucide) {
                lucide.createIcons();
            }

        } catch (err) {
            console.error("Error fetching name list:", err);
            document.getElementById("modalRecordList").innerHTML = `<li class="text-red-500 text-center py-4 font-bold bg-red-50 rounded-lg">Error loading data</li>`;
            if (typeof toastr !== 'undefined') {
                toastr.error("Failed to load records.");
            }
        } finally {
            document.getElementById("modalLoader").classList.add("hidden");
        }
    }
