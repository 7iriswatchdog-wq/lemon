@model List<AML.ViewModel.ViewModels.Report.DigiSchedulerLogModel>
@{
    Layout = "~/Views/Shared/_PdfLayout.cshtml";
    ViewData["Title"] = "Scheduler Logs Report";
    ViewData["Orientation"] = ViewBag.Orientation ?? "portrait";
}
<table>
    <thead>
        <tr>
            <th>Module Name</th>
            <th>Total API Hits</th>
            <th>Total Records Pushed</th>
            <th>Run Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Source</td>
                    <td>@item.TotalHits</td>
                    <td>@item.TotalRecords</td>
                    <td>@item.CreatedOn</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" style="text-align: center; color: #9CA3AF; padding: 20px;">No records found.</td>
            </tr>
        }
    </tbody>
</table>
