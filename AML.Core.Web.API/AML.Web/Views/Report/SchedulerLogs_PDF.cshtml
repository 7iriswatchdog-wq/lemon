@using AML.ViewModel.ViewModels.Report
@using Microsoft.AspNetCore.Http
@model List<DigiSchedulerLogModel>
@functions {
    public bool ShowColumn(string colId)
    {
        var selectedColumns = ViewBag.SelectedColumns as string;
        if (string.IsNullOrEmpty(selectedColumns)) return true;
        return selectedColumns.Split(',').Contains(colId);
    }
}
@{
    Layout = null;
    var companyName = Context.Session.GetString("SessCompanyName") ?? "AML Systems";
    var orientation = ViewBag.Orientation as string ?? "portrait";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ongoing Monitoring Scheduler Logs Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @@media print {
            .no-print { display: none !important; }
            tr { page-break-inside: avoid !important; break-inside: avoid !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 text-[10px] p-8">
    <div id="pdf-container" class="max-w-[@(orientation == "landscape" ? "1280px" : "1024px")] mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <!-- Header -->
        <div class="flex justify-between items-start border-b border-slate-200 pb-6 mb-6">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900">OM Scheduler Logs</h1>
                <p class="text-slate-500 font-medium mt-1">Generated on @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
            <div class="text-right">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Company</div>
                <div class="text-lg font-black text-blue-600">@companyName</div>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-slate-200 text-slate-500 uppercase tracking-wider font-bold text-[9px]">
                        <th class="px-2 py-3">#</th>
                        @if (ShowColumn("source")) { <th class="px-2 py-3 w-1/4">Source</th> }
                        @if (ShowColumn("totalRecords")) { <th class="px-2 py-3 w-1/6 text-center">Records</th> }
                        @if (ShowColumn("totalHits")) { <th class="px-2 py-3 w-1/6 text-center">Hits</th> }
                        @if (ShowColumn("cumulativeHits")) { <th class="px-2 py-3 w-1/6 text-center">Cumulative</th> }
                        @if (ShowColumn("createdOn")) { <th class="px-2 py-3">Updated On</th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{
                        var items = Model as List<DigiSchedulerLogModel>;
                    }
                    @if (items != null && items.Any())
                    {
                        int index = 1;
                        foreach (var item in items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-2 py-3 text-slate-400 font-medium">@index</td>
                                @if (ShowColumn("source")) { <td class="px-2 py-3 font-bold text-slate-900 uppercase tracking-tighter">@item.Source</td> }
                                @if (ShowColumn("totalRecords")) { <td class="px-2 py-3 text-center text-slate-600 font-medium">@item.TotalRecords</td> }
                                @if (ShowColumn("totalHits")) { <td class="px-2 py-3 text-center text-slate-600 font-medium">@item.TotalHits</td> }
                                @if (ShowColumn("cumulativeHits")) {
                                    <td class="px-2 py-3 text-center">
                                        <span class="font-black @(item.CumulativeHits > 0 ? "text-blue-600" : "text-slate-400")">
                                            @item.CumulativeHits
                                        </span>
                                    </td>
                                }
                                @if (ShowColumn("createdOn")) { 
                                    <td class="px-2 py-3 text-slate-500 font-medium tracking-tight">
                                        @{
                                            DateTime.TryParse(item.CreatedOn, out DateTime cDate);
                                        }
                                        @cDate.ToString("dd MMM yyyy, HH:mm") GST
                                    </td> 
                                }
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-2 py-12 text-center text-slate-400 italic font-medium">No scheduler logs found for the selected range.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-[9px] text-slate-400 font-medium">System Generated Log - @companyName &copy; @DateTime.Now.Year</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-export.js"></script>
    <script>
        window.onload = function() {
            setTimeout(() => {
                downloadPageAsPDF('#pdf-container', 'Scheduler_Logs_@DateTime.Now.ToString("yyyyMMdd")' + '.pdf', '@orientation');
            }, 1000);
        };
    </script>
</body>
</html>
