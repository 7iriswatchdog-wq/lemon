                      function saveVersion() {

                 $("#versionModal").hide();

                 let selected = document.querySelector('.versionRadio:checked');

                 if (!selected) {
                     toastr.error("Please select a version");
                     return;
                 }

                 let payload = {
                     customerCode: selected.value,
                     versionId: selected.dataset.id,
                     type: selected.dataset.type
                 };

                 console.log("Payload => ", payload);

                 // Optional loader
                 $('.se-pre-con').fadeIn("fast");

                 $.ajax({
                     url: '/risk/saveversion',
                     type: 'POST',
                     contentType: 'application/json',
                     data: JSON.stringify(payload),

                             success: function (res) {

                                 console.log("Returned Data => ", res);

                                 if (!res || !res.riskTypeCategoryDTO) {
                                     toastr.error("Invalid data received");
                                     $('.se-pre-con').fadeOut("slow");
                                     return;
                                 }

                                 // ⭐ RESET FIRST
                                 resetRiskAssessment();

                                applyRiskSelections(res.riskTypeCategoryDTO,res);

                                 toastr.success("Version loaded successfully");
                                 $('.se-pre-con').fadeOut("slow");
                             },


                     error: function (err) {

                         console.log(err);
                         toastr.error("Error loading version");
                         $('.se-pre-con').fadeOut("slow");
                     }
                 });
             }

