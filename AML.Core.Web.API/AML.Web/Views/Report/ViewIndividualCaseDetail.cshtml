 function toggleSaveRiskButton() {
    const btn = document.getElementById('btnSaveRisk');
    if (!btn) return;

    const selected = document.querySelector('.versionRadio:checked');

    if (!selected) {
        disableBtn(btn);
        return;
    }

    const index = parseInt(selected.dataset.index, 10);
    const total = parseInt(selected.dataset.total, 10);

    // allow only latest 2 versions
    if (index >= (total - 2)) {
        enableBtn(btn);
    } else {
        disableBtn(btn);
    }
}

function disableBtn(btn) {
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');
}

function enableBtn(btn) {
    btn.disabled = false;
    btn.classList.remove('opacity-50', 'cursor-not-allowed');
}

// radio change handler
document.addEventListener('change', function (e) {
    if (e.target.classList.contains('versionRadio')) {
        toggleSaveRiskButton();
    }
});

// safety on load / modal open
document.addEventListener('DOMContentLoaded', toggleSaveRiskButton);

// final protection on click
function saveRiskAssessment() {

    const selected = document.querySelector('.versionRadio:checked');
    if (!selected) return;

    const index = parseInt(selected.dataset.index, 10);
    const total = parseInt(selected.dataset.total, 10);

    if (index < total - 2) {
        alert('Save Risk Assessment is allowed only for the latest two versions.');
        return;
    }

    // ✅ CONTINUE ACTUAL SAVE LOGIC HERE
    console.log('Saving risk assessment for version index:', index);
}

