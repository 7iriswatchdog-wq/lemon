                        currentFullscreen = null;
                        resetLayout();
                            updateDobLabel(false);
                        return;
                    }

                    currentFullscreen = side;

                    if (side === 'left') {

                        leftCol.classList.remove('basis-[75%]');
                        leftCol.classList.add('basis-full');

                        rightCol.classList.add('hidden');
                    }
                    else {

                        rightCol.classList.remove('basis-[25%]');
                        rightCol.classList.add('basis-full');

