                 function applyRiskSelections(riskData, riskDetails) {

                let counter = 0;

                let rating =
                    riskDetails.riskAssessmentRating ||
                    riskDetails.finalRiskScore ||
                    "";

                let ratingWithoutOverride =
                    riskDetails.riskAssessmentRatingWithoutOverride ||
                    riskDetails.riskScoreBeforeOverride ||
                    "";

                    let type=riskDetails.type || "0";

                     $('#type').val(type);

                $('#btntotal').text(riskDetails.riskScoreCount);
                $('#btntotalscore').text(riskDetails.riskScoreSum);

                let hasHighOverride = false;

                for (let i = 0; i < riskData.length; i++) {
                    let category = riskData[i];

                    for (let j = 0; j < category.riskTypes.length; j++) {
                        if (Number(category.riskTypes[j].overrideScore) === 3) {
                            hasHighOverride = true;
                            break;
                        }
                    }

                    if (hasHighOverride) break;
                }

                for (let i = 0; i < riskData.length; i++) {
                    let category = riskData[i];

                    for (let j = 0; j < category.riskTypes.length; j++) {

                        let riskType = category.riskTypes[j];   // ⭐ DEFINE HERE

                        let inputField = $(`#RiskItemTxt_${counter}`);
                        let scoreCircle = $(`#clrScore_${counter}`);
                        let scoreHidden = $(`#clrScorehdn_${counter}`);

                        if (!inputField.length) {
                            counter++;
                            continue;
                        }

                        console.log(counter, riskType.itemTxt, riskType.itemScore, riskType.score);

                        inputField.val(riskType.itemTxt || "");

                        let score = riskType.itemScore || riskType.score || 0;

                        scoreHidden.val(score);

                        scoreCircle.text(score);

                        let overrideScore = riskType.overrideScore || 0;

                        updateScoreCircle(counter, score, overrideScore);

                        counter++;
                    }
                }

                let badge = $("#riskRatingBadge");

                if (!badge.length) return;

                badge.removeClass("bg-green-500 bg-yellow-400 bg-red-500 text-white");

                badge.addClass("px-3 py-1 rounded-full text-xs font-bold text-white");

           let displayRating = rating;

                if ((rating || "").toLowerCase() === "high risk" && hasHighOverride) {
                    displayRating = "High Risk(O)";
                }

               let ratingLower = (displayRating || "").toLowerCase();

            if (ratingLower.includes("low risk")) {
                            badge.removeClass("text-slate-600")
                                        badge.addClass("bg-green-500 text-white-600");
            }
            else if (ratingLower.includes("medium risk")) {
                            badge.removeClass("text-slate-600")
                                        badge.addClass("bg-yellow-400 text-white-600");
            }
            else if (ratingLower.includes("high risk")) {
                            badge.removeClass("text-slate-600")
                                        badge.addClass("bg-red-500 text-white-600");   // ⭐ works for both High Risk and High Risk (O)
            }

                            badge.text(displayRating);
                        }

                function updateScoreCircle(counter, score, overrideScore) {
            let el = $(`#clrScore_${counter}`);
            let scoreHidden = $(`#clrScorehdn_${counter}`);

            // Reset classes first
            el.removeClass();
                        el.addClass("score-badge text-[10px] font-semibold inline-flex items-center justify-center w-12 h-6 rounded-full");

            // Update hidden input
            scoreHidden.val(score);

            // Set text
            el.text(score);

            // Apply color based on score
            switch (score) {
                case 1:
                    el.addClass("bg-green-500 text-white");
                    break;
                case 2:
                    el.addClass("bg-yellow-400 text-black");
                    break;
                case 3:
                    el.addClass("bg-red-500 text-white");
                    if (overrideScore == 3) {
                        el.addClass("animate-pulse");
                    } else {
                        el.removeClass("animate-pulse");
                    }
                    break;
                default: // 0 or undefined
                    el.addClass("bg-gray-400 text-white");
            }
        }





