                <!-- Shareholders Detail & Case History -->
               
                <div class="flex-2 min-w-0 min-h-0 flex flex-col gap-6">
                        @functions {
                            public IHtmlContent RenderShareholderTree(IEnumerable<AML.ViewModel.ViewModels.CustomerCase.CaseModel> shareholders, string parentCustomerId, int level = 0, bool isLastChild = false, List<bool> parentHasNextSibling = null)
                            {
                                if (parentHasNextSibling == null) parentHasNextSibling = new List<bool>();

                                var children = shareholders.Where(s => s.ParentId == parentCustomerId).ToList();
                                if (!children.Any()) return HtmlString.Empty;

                                var html = new System.Text.StringBuilder();
                                html.Append("<div class='relative'>");

                                for (int i = 0; i < children.Count; i++)
                                {
                                    var child = children[i];
                                    var currentIsLast = i == children.Count - 1;
                                    var hasChildren = shareholders.Any(s => s.ParentId == child.CustomerId);

                                    // Current level parentHasNextSibling array
                                    var currentSiblingArr = new List<bool>(parentHasNextSibling);
                                    if (level > 0)
                                    {
                                        currentSiblingArr.Add(!isLastChild);
                                    }

                                    var status = (AML.Core.DataContract.Enum.CaseStatus)child.Status;

                                    html.Append($@"
                                                <div class='relative'>
                                                <div class='flex items-center py-2 hover:bg-slate-50 transition-colors group border-b border-slate-100'>

                                                <!-- Tree Indentation & Lines -->
                                                <div class='flex-none flex items-center relative h-full' style='width: {(level * 20) + 24}px; padding-left: {level * 20}px;'>");

                                    // Vertical lines from parents
                                    for (int idx = 0; idx < currentSiblingArr.Count; idx++)
                                    {
                                        if (currentSiblingArr[idx])
                                        {
                                            html.Append($@"<div class='absolute top-0 bottom-0 w-px bg-slate-200' style='left: {(idx * 20) + 10}px;'></div>");
                                        }
                                    }

                                    // Current level connector
                                    if (level > 0)
                                    {
                                        var topClass = currentIsLast ? "top-0 h-1/2" : "top-0 bottom-0";
                                        html.Append($@"
                                                <div class='absolute w-px bg-slate-200 {topClass}' style='left: {(level * 20) - 10}px;'></div>
                                                <div class='absolute h-px bg-slate-200' style='left: {(level * 20) - 10}px; width: 10px; top: 50%;'></div>
                                                ");
                                    }

                                    // Dot/Icon
                                    html.Append("<div class='relative z-10 pl-2'>");
                                    if (hasChildren)
                                    {
                                        // Hardcoded expanded state chevron down for simplicity in non-react version
                                        html.Append($@"<button class='h-4 w-4 rounded-[4px] bg-white border border-slate-300 flex items-center justify-center text-slate-500 hover:text-blue-600 hover:border-blue-400 transition-all shadow-sm'>
                                                <svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>
                                                </button>");
                                    }
                                    else
                                    {
                                        html.Append($@"<div class='h-2 w-2 rounded-full bg-slate-300 ml-1'></div>");
                                    }
                                    html.Append("</div></div>");


                                    // Content Columns
                                    html.Append($@"
                                                <div class='flex-1 grid grid-cols-15 gap-2 items-center pl-2'>
                                                <div class='col-span-3 text-xs font-bold text-slate-700'>{child.CustomerId}</div>
                                                <div class='col-span-5 text-xs font-semibold text-slate-900'>{child.LastName}</div>
                                                <div class='col-span-3 text-[11px] font-medium text-slate-500 truncate'>{child.Type}</div>
                                                <div class='col-span-2 text-[11px]  truncate'><span class='px-2 py-0.5 rounded text-[10px] font-semibold'
                                                data-status='{child.CaseStatus}'>
                                                {child.CaseStatus}
                                                </span></div>
                                                <div class='col-span-2 text-right pr-2 text-blue-600 text-[11px] font-bold'>");

                                    // if (child.Status == 5 || child.Status == 0 || child.Status == 6)
                                    //     html.Append($"<a  href='/case/Shareholder/{child.Id}' class='hover:underline'>Process</a>");
                                    // else
                                        html.Append($"<a  href='/report/ViewShareholderCaseDetails?id={child.CustomerId}&type=1' class='hover:underline'>View</a>");

                                    html.Append("</div></div></div>");

                                    // Recursive call
                                    html.Append(RenderShareholderTree(shareholders, child.CustomerId, level + 1, currentIsLast, currentSiblingArr).ToString());
                                    html.Append("</div>");
                                }

                                html.Append("</div>");
                                return new HtmlString(html.ToString());
                            }
                        }

