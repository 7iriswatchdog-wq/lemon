        <div id="printthisform">
            <div class="sas-card rounded-card mb-2 bg-blue">
                <input id="hdnCaseId" type="hidden" name="CaseId" value="@Model.Case.Id" />
                <div class="col-12 Container-17 mt-lg-5">
                    <h3 class="title"><b>Case Details</b></h3>

                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="CustomerId">Customer Id : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="CustomerId">@(Model.Case.CustomerId)</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="Source">Source :</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="SourceId">@(Model.Case.Source)</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="CustomerName">Customer Name : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="CustomerName">@($"{Model.Case.FirstName} {Model.Case.MiddleName} {Model.Case.LastName}")</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="Status">Status : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="Status">
                                @(Convert.ToString((AML.Core.DataContract.Enum.CaseStatus)Model.Case.Status))
                                @if (Model.Case.IsWhiteListed == "YES")
                                {
                                    <text>(Whitelisted)</text>
                                }
                            </label>
                        </div>
                    </div>
                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="DateOfBirth">Date Of Birth : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="DateOfBirth">
                                @(Model.Case.DOB == "1/1/0001 12:00:00 AM" ? "N/A" : Model.Case.DOB)
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="SourceId">Source Id : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="SourceId">@(Model.Case.SourceUniqueId)</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="Nationality">Nationality : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="Nationality">@(Model.Case.Nationality)</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="MatchScore">Match Score : </label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="Matchscore">
                                @(Model.Case.MatchScore == 0 ? "N/A" : $"{Model.Case.MatchScore}%")
                            </label>
                        </div>
                    </div>
                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="Gender">Gender</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="Gender">@(Model.Case.Gender)</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="IdType">Id Type</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="IdType">@(Model.Case.CustomerIdType)</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="IdNumber">Id Number</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="IdNumber">@(Model.Case.CustomerIdNumber)</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="Address">Address</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="Address">@(Model.Case.Address)</label>
                        </div>
                    </div>
                </div>

                <div class="col-12 form-row mb-2">
                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="EstablishmentDate">Establishment Date</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="EstablishmentDate">@(Model.Case.EstablishmentDate)</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-3 heading">
                            <label class="form_label" for="RiskScore">Risk Score</label>
                        </div>
                        <div class="col-3 subheadings">
                            <label name="RiskScore">
                                @(Model.Case.MatchCategory == "INDIVIDUAL"
                                                                ? Model.Case.Individual_final_risk_score
                                                                : Model.Case.corporate_final_risk_score)
                            </label>
                        </div>
                    </div>


                    <div class="action">
                        <div class="col-12 Container-17">
                            <h3 class="title">Case Action</h3>
                        </div>
                        @{
                            if (Model.Case.NoMatch == 0 && Model.Case.PartialDomesticpep == 0 && Model.Case.TrueDomesticpep == 0 && Model.Case.TrueDomesticpep == 0 && Model.Case.TrueUAEUNSanction == 0 && Model.Case.PartialForeignpep == 0 && Model.Case.TrueDomesticpep == 0 && Model.Case.TrueOtherSanction == 0 && Model.Case.Partialadversemedia == 0 && Model.Case.TrueAdverseMedia == 0)
                            {
                                <div class="row mb-3 subheadings ">
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            No Action Taken yet
                                        </label>
                                    </div>
                                </div>
                            }
                        }
                        @{


                            if (Model.Case.NoMatch == 1)
                            {
                                <div class="row mb-3 subheadings ">
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            No potential match found against the subject case, hence approved
                                        </label>
                                    </div>
                                </div>
                            }
                        }

                        <div class="row mb-3 subheadings">
                            @{
                                if (Model.Case.PartialDomesticpep == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            Partial Match - Domestic PEP found
                                        </label>
                                    </div>

                                }
                                if (Model.Case.TrueDomesticpep == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            True Match - Domestic PEP found
                                        </label>
                                    </div>
                                }
                                if (Model.Case.TrueUAEUNSanction == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            True Match - UAE/UN Sanction
                                        </label>
                                    </div>
                                }

                            }
                        </div>
                        <div class="row mb-3 subheadings">
                            @{
                                if (Model.Case.PartialForeignpep == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            Partial Match - Foreign PEP found
                                        </label>
                                    </div>

                                }
                                if (Model.Case.TrueForeignpep == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            True Match - Foreign PEP found
                                        </label>
                                    </div>
                                }
                                if (Model.Case.TrueOtherSanction == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            True Match -  Other Sanction
                                        </label>
                                    </div>
                                }
                            }


                        </div>

                        <div class="row mb-3 subheadings">
                            @{
                                if (Model.Case.Partialadversemedia == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            Partial Match - Adverse Media found
                                        </label>
                                    </div>

                                }
                                if (Model.Case.TrueAdverseMedia == 1)
                                {
                                    <div class="form-group col-md-6">
                                        <label class="form-check-label" for="flexCheckDefault">
                                            True Match - Adverse Media  found
                                        </label>
                                    </div>
                                }

                            }
                        </div>
                    </div>



