                                    <textarea id="txtCaseComment" name="Comment" class="w-full p-3 rounded-md border border-gray-300 text-gray-900 placeholder:text-gray-400 resize-none" rows="2" placeholder="Enter your comments"></textarea>
                                </div>
                                <div class="lg:col-span-2 flex justify-end">
                                    <button type="submit" class="w-full md:w-auto px-6 py-2 bg-primary text-white font-medium rounded-md hover:bg-primary-hover flex items-center justify-center">
                                        Send <i class="fa fa-paper-plane ml-2"></i>
                                    </button>
