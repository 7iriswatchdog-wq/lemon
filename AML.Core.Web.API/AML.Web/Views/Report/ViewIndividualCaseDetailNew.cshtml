                    </div>

                    <div class="action">

                        <div class="col-12 mb-6">
                            <h3 class="title">Search Result</h3>
                        </div>

                        <div>

                            @if (@Model.DataList != null)
                            {
                                <div class="w-full overflow-x-auto ">
                                    @*table *@
                                    <table id="APITable" class="w-full table-auto text-sm" cellspacing="0">
                                        <thead class="bg-[#E9EFFD]">
                                            <tr class="text-97">
                                                <th class=" px-4 py-3">Id</th>
                                                <th class=" px-4 py-3">Type</th>
                                                <th class=" px-4 py-3">Category</th>
                                                <th class=" px-4 py-3">Name</th>
                                                <th class=" px-4 py-3">Score</th>
                                                <th class=" px-4 py-3">Nationality</th>
                                                <th class=" px-4 py-3">Id No</th>
                                                <th class=" px-4 py-3">DOB</th>
                                                <th class=" px-4 py-3">Datasets</th>
                                                <th class=" px-4 py-3">Details</th>
                                                <th class=" px-4 py-3">Download</th>
                                                @*<th style=" @(@Model.Case.Source != "KYC6" ? "display:none" : "height:auto")">Details</th>
                                                <th style=" @(@Model.Case.Source != "KYC6" ? "display:none" : "height:auto")">Download</th>*@
                                                <th class=" px-4 py-3">Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-bordercolor">

                                            @foreach (var item in @Model.DataList)
                                            {
                                                <tr>
                                                    <td class="text-47">@item.matchuid</td>
                                                    <td class="text-47">@item.matchtype</td>
                                                    <td class="text-47">@item.matchcategory</td>
                                                    <td class="text-47">@item.matchname</td>
                                                    <td class="text-47">@item.matchscore</td>
                                                    @if (@item.matchnationality != "0")
                                                    {
                                                        <td class="text-47">@item.matchnationality</td>
                                                    }
                                                    else
                                                    {

                                                        <td class="text-47"></td>
                                                    }

                                                    <td class="text-47">@item.matchidno</td>
                                                    <td>@item.matchdob</td>
                                                    <td>@item.matchdatasets</td>
                                                    @if (item.matchtype == "KYC6")
                                                    {
                                                        <td class="text-47" style="height:auto">
                                                            <input type="button" class=" px-4 py-1 bg-primary text-white rounded hover:bg-primary-hover" value="Details" onclick="location.href='@Url.Action("GetDetailsApi", "Case", new { Id = item.matchuid, Category = item.matchcategory, CaseId = Model.Case.Id })'" style="padding: 5px 10px !important;" />
                                                        </td>
                                                        @if (item.matchresourcesid != "")
                                                        {
                                                            <td style="height:auto">
                                                                <input type="button" class="px-4 py-1 bg-green-600 text-white rounded hover:bg-green-700" value="Download" id="download" onclick="location.href='@Url.Action("CallApi", "Case", new { Id = item.matchresourcesid, Category = item.matchcategory })'" />
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td style="height:auto">
                                                                <input type="button" class=" px-4 py-1 bg-green-600 text-white rounded hover:bg-green-700" value="Download" id="download" onclick="location.href='@Url.Action("CallApiMatchuid", "Case", new { Id = item.matchuid, Category = item.matchcategory })'" />
                                                            </td>


                                                        }
                                                    }
                                                    else
