<script>
    $('#printform').on("click", function () {

        $(this).hide();
        $('#btnBack').hide();
        //$('#APITable').removeClass('table');
        $('#printthisform').printThis({
            importCSS: false,
            importStyle: true,
            loadCSS: ["/css/print.css"],
                header: '<div  style="background: linear-gradient(180deg, #33394e, #2F3961);width:100%;height:80px;padding-top:30px;padding:20px"><h1 style="color: white;">@companyName <img src="@logo" style="width:15%;float: right;" /></h1></div>',
            afterPrint: function () {
                $('#printform').show();
                $('#btnBack').show();
                $('#APITable').addClass('table');
            }
        });

    });

</script>


<script type="text/javascript">
    var comments = [];
    $('#Comments').hide();
    $('#nocomment').show();

    $(document).ready(function () {


        $("#CaseDetailsActive").show();
        $("#CaseCommentsActive").hide();
        $("#CaseActionActive").hide();
        $("#SearchResultsActive").hide();

        if ($('#hdnStatus').val() == '2' || $('#hdnStatus').val() == '3') {
            $('#txtCaseActionRemarks').attr('disabled', 'disabled');
            $("input[type=submit]").attr('disabled', 'disabled');
            $('#ddlUsers').attr('disabled', 'disabled');
            $("#btnTransfer").attr('disabled', 'disabled');
        }

        $.ajax({
            url: '/case/comment/' + $('#hdnCaseId').val(),
            type: 'get',
            success: function (response) {
                comments = response;
                buildComments();
            }
        });
    });
    $('#frmCmment').submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: '/case/comment',
            type: 'post',
            data: $('#frmCmment').serialize(),
            success: function (response) {
                comments = response;
                $('.commment-list').remove();
                buildComments();
            }
        });
    });
    $('#frmCloseCase').submit(function (e) {
        e.preventDefault();
        var val = $("input[type=submit][clicked=true]").val();
        if (val == 'Approve Case') {
            $('#hdnAction').val(2);
        } else {
            $('#hdnAction').val(3);
        }
        $.ajax({
            url: '/case/close',
            type: 'post',
            data: $('#frmCloseCase').serialize(),
            success: function (response) {
                $('#txtCaseActionRemarks').val('');
                $('#txtCaseActionRemarks').attr('disabled', 'disabled');
                $("input[type=submit]").attr('disabled', 'disabled');
                $('#ddlUsers').attr('disabled', 'disabled');
                $("#btnTransfer").attr('disabled', 'disabled');

                toastr.success(response);
                setTimeout(function () { location.href = '/case'; }, 3000);
                location.href = '/case';

            }
        });
    });

    $("#frmCloseCase input[type=submit]").click(function () {
        $("input[type=submit]", $(this).parents("form")).removeAttr("clicked");
        $(this).attr("clicked", "true");
    });






    $('#frmTransferCase').submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: '/case/assign',
            type: 'post',
            data: $('#frmTransferCase').serialize(),
            success: function () {
                $('#ddlUsers').val(0);
                toastr.success('Case Transferred');
            }
        });
    });


    function buildComments() {
        if (comments.length) {
            $('#Comments').show();
            $('#nocomment').hide();
            var template = '<div class="commment-list"><i class="fa fa-user bg-green"></i><div class="timeline-item"><span class="time" ><i class="fa fa-clock"></i> <label class="time-ago"></label></span >' +
                '<h3 class="timeline-header no-border"><div class="row"><a class="a-user heading" href="#"></a></div>&nbsp;&nbsp;<div class="row"><label class="case-comment"></label></div></h3></div></div>';
            $("#Comments").find('div.comment-section').prepend(template);
            $.each(comments, function (i, v) {
                //if (i == 0) {
                //    setDataOnRow($("#Comments").find('div.timeline-item'), v, i);
                //} else {
                //var clonnedRow = $($("#Comments").find('div.timeline-item').first()).clone();
                setDataOnRow($(template), v, i);
                //if (i == 0) {
                //
                //}
            });
            $('#txtCaseComment').val('');
            //$($("#Comments").find('div.commment-list').last()).remove();
            //$($("#Comments").find('div.commment-list').parent()).append('<div><i class= "fas fa-clock bg-gray" ></i></div>')
            $($("#Comments").find('div.commment-list').last()).remove();
            $($("#Comments").find('i').last()).remove();
            $($("#Comments").find('div.commment-list').parent()).append('<div><i class= "fa fa-clock bg-gray" ></i></div>');
        }
    }


    function setDataOnRow(rowObject, v, i) {
        $(rowObject).find(".a-user").html(v.createdUser);
        $(rowObject).find(".time-ago").html(v.duration);
        $(rowObject).find(".case-comment").html(v.comment);
        $("#Comments").find('div.comment-section').prepend(rowObject);
    }
    function clearDocuemnt() {
        $('#frmDocument').find("input[type=text], textarea").val("");
        $('#frmDocument').find("input[type=file]").val(null);
        $('#frmDocument').find("select").val(0);
    }

    function activateLink(link, action) {

        //alert(link);
        //alert(action);
        // Remove the 'active' class from all links
        var links = document.querySelectorAll('.navbar a');
        links.forEach(function (link) {
            link.classList.remove('active');
        });

        // Add the 'active' class to the clicked link
        link.classList.add('active');

        if (action == "caseDetails") {


            $("#CaseDetailsActive").show();
            $("#CaseCommentsActive").hide();
            $("#CaseActionActive").hide();
            $("#SearchResultsActive").hide();

        }
        if (action == "caseComments") {
            $("#CaseDetailsActive").hide();
            $("#CaseCommentsActive").show();
            $("#CaseActionActive").hide();
            $("#SearchResultsActive").hide();
        }
        if (action == "caseAction") {
            $("#CaseDetailsActive").hide();
            $("#CaseCommentsActive").hide();
            $("#CaseActionActive").show();
            $("#SearchResultsActive").hide();
        }
        if (action == "searchResults") {
            $("#CaseDetailsActive").hide();
            $("#CaseCommentsActive").hide();
            $("#CaseActionActive").hide();
            $("#SearchResultsActive").show();
        }
    }

</script>
