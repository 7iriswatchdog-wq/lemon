<script type="text/javascript">
    let pageSize = parseInt($('#pageSize').val()) || 10;
    let currentPage = 1;
    let totalPages = 1;
    let totalRecords = 0;
    let drawCounter = 1;
    let allData = [];
    let currentSortColumn = 0; 
    let currentSortDirection = 'asc'; 

    function formatDate(value) {
        if (!value) return null;

        // ✅ Already in yyyy-MM-dd
        if (value.includes('-') && value.split('-')[0].length === 4) {
            return value;
        }

        // ✅ Convert dd/MM/yyyy → yyyy-MM-dd
        if (value.includes('/')) {
            let parts = value.split('/');
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        return null;
    }

    function applyFilters() {
        fetchData('', 1);
    }

    function clearFilters() {
        const today = new Date();
        const lastYear = new Date();
        lastYear.setFullYear(today.getFullYear() - 1);

        function formatDateForDisplay(date) {
            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            return `${dd}/${mm}/${yyyy}`;
        }

        function formatDateTime(dateStr) {
        if (!dateStr) return { date: '-', time: '-' };

        const d = new Date(dateStr);

        return {
            date: d.toLocaleDateString('en-GB'), // 20/02/2026
            time: d.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',   // ✅ added
                hour12: true
            }) // 06:43:15 PM
        };
    }
        // Reset values with defaults
        if (document.querySelector("#startDate")._flatpickr) {
            document.querySelector("#startDate")._flatpickr.setDate(lastYear, true);
        }

        if (document.querySelector("#endDate")._flatpickr) {
            document.querySelector("#endDate")._flatpickr.setDate(today, true);
        }

        fetchData('', 1);
    }

    $(document).ready(function () {
        lucide.createIcons();
        
        // Initialize date pickers
        function initDatePicker(selector, defaultDate, isEndDate = false) {
            return flatpickr(selector, {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                defaultDate: defaultDate,
                allowInput: true,
                onClose: function(selectedDates, dateStr, instance) {
                    fetchData('', 1);
                }
            });
        }

        // ✅ Start Date → 1 year back, max today
        const startPicker = initDatePicker("#startDate", new Date().fp_incr(-365));

        // ✅ End Date → today, min today
        const endPicker = initDatePicker("#endDate", new Date(), true);

        fetchData('', 1);

        $('#searchInput').on('input', function () {
            const keyword = $(this).val().toLowerCase();
            
            let filteredData = allData.filter(item =>
                (item.source || '').toLowerCase().includes(keyword) ||
                (item.totalHits + '').includes(keyword) ||
                (item.totalRecords + '').includes(keyword) ||
                (formatDateForDisplay(item.createdOn) || '').toLowerCase().includes(keyword)
            );

            currentPage = 1;
            totalRecords = filteredData.length;
            totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));
            
            $('#loader').removeClass('hidden').addClass('flex');
            setTimeout(() => {
                renderTable(filteredData.slice(0, pageSize));
                updatePagination();
                $('#loader').addClass('hidden').removeClass('flex');
            }, 100);
        });
    });

    function fetchData(searchValue = '', page = 1) {
        $('#loader').removeClass('hidden').addClass('flex');
        pageSize = parseInt($('#pageSize').val()) || 10;
        const start = (page - 1) * pageSize;

        $.ajax({
            url: '/Report/OngoingmonitoringSchedulerLog',
            type: 'POST',
            headers: {
                'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
            },
            data: {
                draw: drawCounter++,
                start: start,
                length: pageSize,
                search: { value: searchValue },
                orderColumn: currentSortColumn,
                orderDirection: currentSortDirection,
                startDate: formatDate($('#startDate').val()),
                endDate: formatDate($('#endDate').val())
            },
            success: function (resp) {
                const rows = resp.data || [];
                totalRecords = resp.recordsFiltered || 0;
                allData = resp.allRows || [];
                totalPages = Math.max(1, Math.ceil((totalRecords * 1.0) / pageSize));

                renderTable(rows);
                updatePagination();
            },
            error: function (xhr) {
                console.error('Error fetching data:', xhr.statusText);
            },
            complete: function () {
                $('#loader').addClass('hidden').removeClass('flex');
            }
        });
    }

    function renderTable(rows) {
        console.log(rows);
        const tbody = $('#filterTableBody').empty();

        if (!rows || rows.length === 0) {
            tbody.append('<tr><td colspan="5" class="h-24 text-center text-textmuted">No data available</td></tr>');
            return;
        }

        rows.forEach((item, index) => {
            const updated = formatDateTime(item.createdOn);
            
            // Link ONLY for the first (most recent) row for pending
            const pendingContent = (index === 0 && (currentPage === 1 || !currentPage))
                ? `<a href="/Report/CaseReport?option=OnGoing&caseStatus=6" class="text-primary font-bold hover:underline transition-all">${item.pending}</a>`
                : item.pending;

            tbody.append(`
                <tr class="bg-surface border-b border-bordercolor hover:bg-appbg transition-colors">
                    <td class="px-6 py-4 text-center text-textlabel font-medium">${item.source || ''}</td>
                    <td class="px-6 py-4 text-center text-textlabel">${item.totalRecords || ''}</td>
                    <td class="px-6 py-4 text-center text-textlabel">${item.totalHits}</td>
                    <td class="px-6 py-4 text-center text-textlabel">${item.cumulativeHits}</td>
                    <td class="px-6 py-4 text-center text-textlabel">${pendingContent}</td>
                    <td class="px-6 py-4 text-center text-textlabel">
                             <!-- Updated (only if exists) -->
                            ${updated ? `
                                <div class="text-xs text-textlabel">
                                    <div>${updated?.date || '-'}</div>
                                    <div class="ml-2">
                                        ${updated?.time ? updated.time.replace(/\s?(AM|PM)/i, '') : ''}
                                    </div>
                                </div>
                            ` : ''}
                        </td>
                    
                </tr>
            `);
        });
    }

    function formatDate(value) {
        if (!value) return null;

        // ✅ Already in yyyy-MM-dd
        if (value.includes('-') && value.split('-')[0].length === 4) {
            return value;
        }

        // ✅ Convert dd/MM/yyyy → yyyy-MM-dd
        if (value.includes('/')) {
            let parts = value.split('/');
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        return null;
    }
        function formatDateTime(dateStr) {
        if (!dateStr) return { date: '-', time: '-' };

        const d = new Date(dateStr);

        return {
            date: d.toLocaleDateString('en-GB'), // 20/02/2026
            time: d.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',   // ✅ added
                hour12: true
            }) // 06:43:15 PM
        };
    }

    function updatePagination() {
        const start = totalRecords === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);

        const $pagerButtons = $('#pagination-buttons').empty();
        if (totalPages > 1) {
            const maxVisible = 5;
            let pStart = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let pEnd = pStart + maxVisible - 1;

            if (pEnd > totalPages) {
                pEnd = totalPages;
                pStart = Math.max(1, pEnd - maxVisible + 1);
            }

            for (let i = pStart; i <= pEnd; i++) {
                const isActive = i === currentPage;
                const btnClass = isActive 
                    ? 'h-8 w-8 flex items-center justify-center rounded-md bg-primary text-white font-bold shadow-sm'
                    : 'h-8 w-8 flex items-center justify-center rounded-md bg-surface border border-bordercolor text-textlabel hover:bg-appbg font-medium transition-colors';
                
                $pagerButtons.append(`<button onclick="goToPage(${i})" class="${btnClass}">${i}</button>`);
            }
        }
    }

    function goToPage(page) {
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            const searchValue = $('#searchInput').val();
            if (searchValue) {
                const keyword = searchValue.toLowerCase();
                let filteredData = allData.filter(item =>
                    (item.source || '').toLowerCase().includes(keyword) ||
                    (item.totalHits + '').includes(keyword) ||
                    (item.totalRecords + '').includes(keyword) ||
                    (formatDateForDisplay(item.createdOn) || '').toLowerCase().includes(keyword)
                );
                const start = (page - 1) * pageSize;
                renderTable(filteredData.slice(start, start + pageSize));
                updatePagination();
            } else {
                fetchData('', currentPage);
            }
        }
    }

    function previousPage() {
        if (currentPage > 1) goToPage(currentPage - 1);
    }

    function nextPage() {
        if (currentPage < totalPages) goToPage(currentPage + 1);
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        const searchValue = $('#searchInput').val();
        
        if (searchValue) {
            const keyword = searchValue.toLowerCase();
            let filteredData = allData.filter(item =>
                (item.source || '').toLowerCase().includes(keyword) ||
                (item.totalHits + '').includes(keyword) ||
                (item.totalRecords + '').includes(keyword) ||
                (formatDateForDisplay(item.createdOn) || '').toLowerCase().includes(keyword)
            );
            totalPages = Math.max(1, Math.ceil(filteredData.length / pageSize));
            renderTable(filteredData.slice(0, pageSize));
            updatePagination();
        } else {
            fetchData('', currentPage);
        }
    }

    /* 
    function sortTable(columnIndex, element) {
        $('.sortable').removeClass('active asc desc');
        if (currentSortColumn === columnIndex) {
            currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            currentSortColumn = columnIndex;
            currentSortDirection = 'asc';
        }
        $(element).addClass('active ' + currentSortDirection);

        const searchValue = $('#searchInput').val();
        fetchData(searchValue, 1);
    }
    */

    function formatDateForDisplay(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString('en-GB') + ' ' + date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    function showExportOptions() {
        const columns = [
            { id: "source", label: "Source" },
            { id: "totalRecords", label: "Total Records" },
            { id: "totalHits", label: "Total Hits" },
            { id: "cumulativeHits", label: "Cumulative" },
            { id: "pending", label: "Pending" },
            { id: "createdOn", label: "Updated On" }
        ];

        openExportModal({
            getColumnsByActiveTab: () => columns,
            onExport: (format, selectedColumns, orientation) => {
                ExportList(format === 'pdf', selectedColumns, orientation);
            }
        });
    }

    function ExportList(isPDF, selectedColumns, orientation) {
        const startDate = formatDate($('#startDate').val());
        const endDate = formatDate($('#endDate').val());
        const searchValue = $('#searchInput').val() || '';
        const params = `startDate=${startDate}&endDate=${endDate}&searchValue=${encodeURIComponent(searchValue)}&selectedColumns=${selectedColumns || ''}&orientation=${orientation || 'portrait'}`;

        if (isPDF) {
            $('#loader').removeClass('hidden').addClass('flex');
            const url = `/Report/SchedulerLogs_PDF?${params}`;
            $('#pdfExportFrame').attr('src', url);
        } else {
            const url = `/Report/SchedulerLogsExportReport?${params}`;
            window.location.href = url;
            setTimeout(() => $('#loader').addClass('hidden'), 2000);
        }
    }
</script>
