                        <i data-lucide="download" class="h-4 w-4"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
                <!-- Search wrapper -->
                <div class="relative flex-1 w-full">
                    <i data-lucide="search" class="absolute left-3.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-textmuted"></i>
                    <input type="text"
                           id="searchInput"
                           placeholder="Search anything..."
                           class="pl-10 h-11 w-full rounded-md border border-bordercolor bg-surface px-3 py-2 text-sm
                                  ring-offset-white focus-visible:outline-none focus-visible:ring-2
                                  focus-visible:ring-blue-500/20 focus-visible:border-blue-500
                                  shadow-sm transition-all placeholder:text-textmuted">
                </div>
                <!-- Export Option -->
                <!-- <div class="relative inline-block text-left group">
                    <button type="button" class="h-11 px-6 inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-textlabel font-medium rounded-md transition-colors border border-bordercolor focus:outline-none">
                        <i data-lucide="download" class="h-4 w-4"></i>
                        Export
                        <i data-lucide="chevron-down" class="h-4 w-4"></i>
                    </button>
                    <div class="absolute right-0 z-10 mt-2 w-40 origin-top-right rounded-md bg-surface shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200" role="menu" aria-orientation="vertical">
                        <div class="py-1" role="none">
                            <button onclick="ExportList(true);" class="w-full text-left font-medium text-textlabel block px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2 transition" role="menuitem">
                                <i data-lucide="file-text" class="h-4 w-4 text-red-500"></i> Export PDF
                            </button>
                            <button onclick="ExportList(false);" class="w-full text-left font-medium text-textlabel block px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2 transition" role="menuitem">
                                <i data-lucide="file-spreadsheet" class="h-4 w-4 text-green-600"></i> Export CSV
                            </button>
                        </div>
                    </div>
                </div> -->
            </div>

            <div class="bg-surface rounded-xl border border-bordercolor shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="text-[10px] text-textmuted  bg-appbg border-b border-bordercolor">
                            @* <tr>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(0, this)">Source</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(1, this)">Total Hits</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(2, this)">Total Records</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(3, this)">Updated On</th>
                            </tr>
                            <tr> *@
                                @* <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(0, this)">Source</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(1, this)">Total Records</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(2, this)">Total Hits</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(3, this)">Cumulative</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(4, this)">Updated On</th> *@

                                <th class="px-6 py-4 font-bold h-12 text-center">Source</th>
                                <th class="px-6 py-4 font-bold h-12 text-center">Total Records</th>
                                <th class="px-6 py-4 font-bold h-12 text-center">Total Hits</th>
                                <th class="px-6 py-4 font-bold h-12 text-center">Cumulative</th>
                                <th class="px-6 py-4 font-bold h-12 text-center">Pending</th>
