            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <img src="@Clientlogo" alt="Client Logo" class="h-10 w-auto" />
            </div>
        </div>

        <!-- Filters Section -->
        <div class="bg-surface rounded-xl border border-bordercolor p-5 shadow-sm">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-sm font-bold text-textprimary tracking-tight">Logs Filter</h3>
