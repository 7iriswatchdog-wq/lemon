@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Ongoing Monitoring Logs";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
    }

    .dt-loader {
        position: relative;
        width: 80px;
        height: 20px;
    }

    .dt-loader div {
        position: absolute;
        top: 8px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: #2563eb;
        animation-timing-function: cubic-bezier(0,1,1,0);
    }

    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }

    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }

    th.sortable {
        cursor: pointer;
        position: relative;
        padding-right: 20px;
    }

    th.sortable::after {
        content: "▲\A▼";
        white-space: pre;
        font-size: 10px;
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        color: #bbb;
        line-height: 1;
        text-align: center;
    }

    th.sortable.active.asc::after { content: "▲"; color: #2563eb; }
    th.sortable.active.desc::after { content: '\A▼'; color: #2563eb; }
</style>

<div id="loader" class="fixed inset-0 bg-white bg-opacity-75 items-center justify-center z-50 hidden">
    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
</div>

<div class="bg-slate-50 min-h-screen text-slate-900">
    <div class="p-8 space-y-8 max-w-[1600px] mx-auto">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Ongoing Monitoring Screening Logs</h1>
                <p class="text-slate-500 text-sm mt-1">Ongoing Monitoring Scheduler Logs</p>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <img src="@Clientlogo" alt="Client Logo" class="h-10 w-auto" />
            </div>
        </div>

        <!-- Table Section -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
                <!-- Search wrapper -->
                <div class="relative flex-1 w-full">
                    <i data-lucide="search" class="absolute left-3.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-slate-400"></i>
                    <input type="text"
                           id="searchInput"
                           placeholder="Search anything..."
                           class="pl-10 h-11 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm
                                  ring-offset-white focus-visible:outline-none focus-visible:ring-2
                                  focus-visible:ring-blue-500/20 focus-visible:border-blue-500
                                  shadow-sm transition-all placeholder:text-slate-500">
                </div>
                <!-- Export Option -->
                <button onclick="ExportList(false);" class="h-11 px-6 inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md transition-colors border border-slate-200">
                    <i data-lucide="download" class="h-4 w-4"></i>
                    Export CSV
                </button>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="text-[10px] text-slate-500 uppercase bg-slate-50/50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(0, this)">Source</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(1, this)">Total Hits</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(2, this)">Total Records</th>
                                <th class="px-6 py-4 font-bold h-12 sortable text-center" onclick="sortTable(3, this)">Uploaded On</th>
                            </tr>
                        </thead>
                        <tbody id="filterTableBody" class="divide-y divide-slate-100" style="font-size: 12px;">
                            <!-- Rows will be injected here -->
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Show</label>
                            <select id="pageSize" onchange="changePageSize()"
                                    class="h-8 w-20 rounded-md border border-slate-200 bg-white pl-3 pr-8 text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                        <div class="h-4 w-px bg-slate-200"></div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                            Showing <span id="showingStart" class="text-slate-900">0</span> - <span id="showingEnd" class="text-slate-900">0</span> 
                            <span class="mx-1 text-slate-300">of</span> 
                            <span id="totalRecords" class="text-slate-900">0</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <button id="prevBtn" onclick="previousPage()"
                                class="h-8 px-4 flex items-center gap-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                            <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i>
                            Previous
                        </button>
                        <div id="pagination-buttons" class="flex gap-1"></div>
                        <button id="nextBtn" onclick="nextPage()"
                                class="h-8 px-4 flex items-center gap-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                            Next
                            <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    let pageSize = parseInt($('#pageSize').val()) || 10;
    let currentPage = 1;
    let totalPages = 1;
    let totalRecords = 0;
    let drawCounter = 1;
    let allData = [];
    let currentSortColumn = 0; 
    let currentSortDirection = 'asc'; 

    $(document).ready(function () {
        lucide.createIcons();
        fetchData('', 1);

        $('#searchInput').on('input', function () {
            const keyword = $(this).val().toLowerCase();
            
            let filteredData = allData.filter(item =>
                (item.source || '').toLowerCase().includes(keyword) ||
                (item.totalHits + '').includes(keyword) ||
                (item.totalRecords + '').includes(keyword) ||
                (formatDate(item.createdOn) || '').toLowerCase().includes(keyword)
            );

            currentPage = 1;
            totalRecords = filteredData.length;
            totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));
            
            $('#loader').removeClass('hidden').addClass('flex');
            setTimeout(() => {
                renderTable(filteredData.slice(0, pageSize));
                updatePagination();
                $('#loader').addClass('hidden').removeClass('flex');
            }, 100);
        });
    });

    function fetchData(searchValue = '', page = 1) {
        $('#loader').removeClass('hidden').addClass('flex');
        pageSize = parseInt($('#pageSize').val()) || 10;
        const start = (page - 1) * pageSize;

        $.ajax({
            url: '/Report/OngoingmonitoringSchedulerLog',
            type: 'POST',
            headers: {
                'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
            },
            data: {
                draw: drawCounter++,
                start: start,
                length: pageSize,
                search: { value: searchValue },
                orderColumn: currentSortColumn,
                orderDirection: currentSortDirection
            },
            success: function (resp) {
                const rows = resp.data || [];
                totalRecords = resp.recordsFiltered || 0;
                allData = resp.allRows || [];
                totalPages = Math.max(1, Math.ceil((totalRecords * 1.0) / pageSize));

                renderTable(rows);
                updatePagination();
            },
            error: function (xhr) {
                console.error('Error fetching data:', xhr.statusText);
            },
            complete: function () {
                $('#loader').addClass('hidden').removeClass('flex');
            }
        });
    }

    function renderTable(rows) {
        const tbody = $('#filterTableBody').empty();

        if (!rows || rows.length === 0) {
            tbody.append('<tr><td colspan="4" class="h-24 text-center text-slate-500">No data available</td></tr>');
            return;
        }

        rows.forEach(item => {
            tbody.append(`
                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 text-center text-slate-600 font-medium">${item.source || ''}</td>
                    <td class="px-6 py-4 text-center text-slate-600">${item.totalHits || ''}</td>
                    <td class="px-6 py-4 text-center text-slate-600">${item.totalRecords || ''}</td>
                    <td class="px-6 py-4 text-center text-slate-600">${formatDate(item.createdOn) || ''}</td>
                </tr>
            `);
        });
    }

    function updatePagination() {
        const start = totalRecords === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);

        const $pagerButtons = $('#pagination-buttons').empty();
        if (totalPages > 1) {
            const maxVisible = 5;
            let pStart = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let pEnd = pStart + maxVisible - 1;

            if (pEnd > totalPages) {
                pEnd = totalPages;
                pStart = Math.max(1, pEnd - maxVisible + 1);
            }

            for (let i = pStart; i <= pEnd; i++) {
                const isActive = i === currentPage;
                const btnClass = isActive 
                    ? 'h-8 w-8 flex items-center justify-center rounded-md bg-blue-600 text-white font-bold shadow-sm'
                    : 'h-8 w-8 flex items-center justify-center rounded-md bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium transition-colors';
                
                $pagerButtons.append(`<button onclick="goToPage(${i})" class="${btnClass}">${i}</button>`);
            }
        }
    }

    function goToPage(page) {
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            const searchValue = $('#searchInput').val();
            if (searchValue) {
                const keyword = searchValue.toLowerCase();
                let filteredData = allData.filter(item =>
                    (item.source || '').toLowerCase().includes(keyword) ||
                    (item.totalHits + '').includes(keyword) ||
                    (item.totalRecords + '').includes(keyword) ||
                    (formatDate(item.createdOn) || '').toLowerCase().includes(keyword)
                );
                const start = (page - 1) * pageSize;
                renderTable(filteredData.slice(start, start + pageSize));
                updatePagination();
            } else {
                fetchData('', currentPage);
            }
        }
    }

    function previousPage() {
        if (currentPage > 1) goToPage(currentPage - 1);
    }

    function nextPage() {
        if (currentPage < totalPages) goToPage(currentPage + 1);
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        const searchValue = $('#searchInput').val();
        
        if (searchValue) {
            const keyword = searchValue.toLowerCase();
            let filteredData = allData.filter(item =>
                (item.source || '').toLowerCase().includes(keyword) ||
                (item.totalHits + '').includes(keyword) ||
                (item.totalRecords + '').includes(keyword) ||
                (formatDate(item.createdOn) || '').toLowerCase().includes(keyword)
            );
            totalPages = Math.max(1, Math.ceil(filteredData.length / pageSize));
            renderTable(filteredData.slice(0, pageSize));
            updatePagination();
        } else {
            fetchData('', currentPage);
        }
    }

    function sortTable(columnIndex, element) {
        $('.sortable').removeClass('active asc desc');
        if (currentSortColumn === columnIndex) {
            currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            currentSortColumn = columnIndex;
            currentSortDirection = 'asc';
        }
        $(element).addClass('active ' + currentSortDirection);

        const searchValue = $('#searchInput').val();
        fetchData(searchValue, 1);
    }

    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString('en-GB') + ' ' + date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    function ExportList(isPDF) {
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            type: "GET",
            url: "/Report/SchedulerLogsExportReport/",
            data: { IsPDF: isPDF },
            success: function () {
                window.location = '/Report/SchedulerLogsExportReport?IsPDF=' + isPDF;
            },
            error: function () {
                alert('error');
            },
            complete: function () {
                $('#loader').addClass('hidden').removeClass('flex');
            }
        });
    }
</script>pt>
