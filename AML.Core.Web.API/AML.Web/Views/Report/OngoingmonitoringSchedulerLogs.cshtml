<style>
    .page {
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border: 1px solid #dee2e6;
    }

    .flex-box {
        display: flex;
        width: 100%;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .flex-box1 {
        display: flex;
        width: 70%;
        justify-content: flex-end;
        margin: 10px 0px;
    }

    .card1 {
        max-width: 100%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
    }

    .export {
        background-color: none;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    thead {
        background-color: rgb(233,239,253);
        width: 100%;
    }

    th {
        padding: 15px 0px;
        font-weight: 500;
    }

    tr {
        text-align: center;
    }

    thead th:first-child {
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }

    thead th:last-child {
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    heading {
        font-size: 1.25rem;
    }

    input {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 8px !important;
    }

        input:focus {
            border: 1px solid rgb(37,99,235) !important;
        }

    select:focus {
        border: 1px solid rgb(37,99,235) !important;
    }

    th, td {
        width: calc(100% / 4);
        word-wrap: break-word;
        text-align: center;
    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        width: 100%;
        align-items: center;
    }

        .pagination-container select {
            width: 100px;
        }

    .loader-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .loader {
        border: 5px solid #f3f3f3;
        border-top: 5px solid #3498db;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }

        .export {
            margin: 10px;
        }

        .flex-box {
            display: flex;
            flex-direction: column;
        }

        .flex-box1 {
            display: flex;
            flex-direction: column;
        }

        .export {
            width: 60%;
            padding: 0px 0px;
            text-align: center;
            padding: 4px 10px;
        }

        .page {
            width: 80vw;
        }

        .items-center select {
            width: 115px;
        }
    }

    th.sort-asc i.fa-sort {
        color: #000 !important;
    }

    th.sort-desc i.fa-sort {
        color: #000 !important;
    }

    th.sort-asc i.fa-sort:before {
        content: "\f0de"; /* arrow up */
    }

    th.sort-desc i.fa-sort:before {
        content: "\f0dd"; /* arrow down */
    }

    tr {
        border: none !important;
    }

    td {
        padding: 15px;
    }

</style>
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>
<script src="~/plugins/jquery/jquery.min.js"></script>
