<style>
    select {
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.41 0L6 4.59L10.59 0L12 1.42L6 7.42L0 1.42L1.41 0Z' fill='black'/%3E%3C/svg%3E") !important;
        background-repeat: no-repeat !important;
        background-position-x: calc(100% - 20px) !important;
        background-position-y: 50% !important;
        background-size: 12px 8px !important;
