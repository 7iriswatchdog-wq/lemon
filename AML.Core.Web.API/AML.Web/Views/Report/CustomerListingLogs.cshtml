<script type="text/javascript">
    // ========== UTILITY FUNCTIONS ==========
    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
    }

    // ========== CORE FUNCTIONS ==========
    let draw = 1;
    let currentPage = 1;
    let totalPages = 1;
    let allData;
    let currentSortColumn = 0;
    let currentSortDirection = 'asc';

    function sortTable(columnIndex) {
        $('#filterTable th').removeClass('sort-asc sort-desc');
        $('#filterTable th i.fa-sort').css('color', '#ccc');

        if (currentSortColumn === columnIndex) {
            currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            currentSortColumn = columnIndex;
            currentSortDirection = 'asc';
        }

        const $header = $('#filterTable th').eq(columnIndex);
        $header.addClass(`sort-${currentSortDirection}`);
        $header.find('i.fa-sort').css('color', '#2563eb');

        fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
    }

    function fetchData(searchValue = '', page = 1) {
        $('#loader').show();
        const pageSize = parseInt($('#rowsPerPage').val()) || 10;
        const start = (page - 1) * pageSize;

        $.ajax({
            url: '/Report/CustomerListing',
            type: 'POST',
            headers: {
                'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
            },
            data: {
                draw: draw++,
                start: start,
                length: pageSize,
                search: { value: searchValue },
                orderColumn: currentSortColumn,
                orderDirection: currentSortDirection,
                startDate: $('#dtStartDate').val(),
                endDate: $('#dtEndDate').val(),
                match: $('#matchTypeID').val()
            },
            success: function (resp) {
                const rows = resp.data || [];
                const totalRecords = resp.recordsFiltered || 0;
                allData = resp.allRows;
                totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));

                renderTable(rows);
                renderPager(page);

                if ($('#dtStartDate').val() == '0001-01-01') {
                    $('#dtStartDate').val('');
                    $('#dtEndDate').val('');
                }
                $('#loader').hide();
            },
            error: function (xhr) {
                console.error('Error fetching data:', xhr.statusText);
                $('#loader').hide();
            }
        });
    }

    function renderTable(rows) {
        const $tbody = $('#filterTable tbody').empty();

        if (!rows.length) {
            $tbody.append('<tr><td colspan="8" class="text-center py-4">No data available</td></tr>');
            return;
        }

        rows.forEach(item => {
            $tbody.append(`<tr>
                <td>${item.customerType || ''}</td>
                <td>${item.customerID || ''}</td>
                <td>${item.customerName || ''}</td>
                <td>${formatDate(item.dob) || ''}</td>
                <td>${item.nationality || ''}</td>
                <td>${item.match || ''}</td>
                <td>${item.createdBy || ''}</td>
                <td>${formatDate(item.createdOn) || ''}</td>
            </tr>`);
        });
    }

    function renderPager(page) {
        const $pagerButtons = $('.pagination-buttons').empty();
        if (totalPages <= 1) return;

        const btn = (lbl, pg, disabled, active) =>
            `<button class="px-3 py-1 border rounded
                ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
                ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
                data-page="${pg}" ${disabled ? 'disabled' : ''}>
                ${lbl}
            </button>`;

        $pagerButtons.append(btn('First', 1, page === 1));
        $pagerButtons.append(btn('Previous', page - 1, page === 1));

        const maxVisible = 5;
        let start = Math.max(1, page - Math.floor(maxVisible / 2));
        let end = start + maxVisible - 1;

        if (end > totalPages) {
            end = totalPages;
            start = Math.max(1, end - maxVisible + 1);
        }

        for (let i = start; i <= end; i++) {
            $pagerButtons.append(btn(i, i, false, i === page));
        }

        $pagerButtons.append(btn('Next', page + 1, page === totalPages));
        $pagerButtons.append(btn('Last', totalPages, page === totalPages));
    }

    function ExportList(isPDF) {
        $.ajax({
            type: "GET",
            url: "/Report/ExportCustomerList/",
            data: {
                startDate: $('#dtStartDate').val(),
                endDate: $("#dtEndDate").val(),
                match: $("#matchTypeID").val(),
                IsPDF: isPDF
            },
            success: function (data) {
                window.location = '/Report/ExportCustomerList?startDate=' +
                    $('#dtStartDate').val() + '&endDate=' +
                    $("#dtEndDate").val() + '&match=' +
                    $("#matchTypeID").val() + '&IsPDF=' + isPDF;
            },
            error: function (result) {
                alert('error');
            }
        });
    }

    // ========== EVENT HANDLERS ==========
    $(document).ready(function () {
        fetchData('', 1);

        $('#btnRefresh').on('click', function () {
            fetchData('', 1);
        });

        $('#rowsPerPage').on('change', () => {
            currentPage = 1;
            fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
        });

        $('input[placeholder="Search anything..."]').on('input', function () {
            const keyword = $(this).val().toLowerCase();
            currentPage = 1;
            clientSideSearch(keyword, currentPage);
        });

        function clientSideSearch(keyword, page = 1) {
            const filtered = allData.filter(item =>
                (item.customerType || '').toLowerCase().includes(keyword) ||
                (item.customerID + '').toLowerCase().includes(keyword) ||
                (item.customerName || '').toLowerCase().includes(keyword) ||
                (formatDate(item.dob) || '').toLowerCase().includes(keyword) ||
                (item.nationality || '').toLowerCase().includes(keyword) ||
                (item.match || '').toLowerCase().includes(keyword) ||
                (item.createdBy || '').toLowerCase().includes(keyword) ||
                (formatDate(item.createdOn) || '').toLowerCase().includes(keyword)
            );

            const pageSize = parseInt($('#rowsPerPage').val()) || 10;
            totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
            const paginated = filtered.slice((page - 1) * pageSize, page * pageSize);

            renderTable(paginated);
            renderPager(page);
        }

        $(document).on('click', '.pagination-buttons button', function () {
            const pg = parseInt($(this).data('page'));
            console.log('Page clicked:', pg);
            if (!isNaN(pg) && pg >= 1 && pg <= totalPages) {
                currentPage = pg;
                fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
            }
        });

        $('#dtStartDate, #dtEndDate, #matchTypeID').on('change', function () {
            currentPage = 1;
            fetchData($('input[placeholder="Search anything..."]').val(), currentPage);
        });

        $("#btnReset").click(function () {
            const date = new Date();
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const today = `${year}-${month}-${day}`;
            $('#dtStartDate').val(today);
            $('#dtEndDate').val(today);
            $('#matchTypeID').val(1);
            fetchData('', 1);
        });
    });
</script>