    }

    heading {
        font-size: 1.25rem;
    }

    .page {
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    input, select {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border-bottom: 1px solid #dee2e6;
    }

    .card1 {
        max-width: 100%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
        box-shadow: 0 0 #0000, /* fallback ring-offset-shadow */
        0 0 #0000, /* fallback ring-shadow */
        0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .flex-box {
        display: flex;
        flex-wrap: wrap;
        margin: 10px 0px;
    }

        .flex-box > .flex-item {
            flex: 1 1 250px;
            text-align: center;
        }

    .form-group {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
    }

    .flex-item input {
        width: 90%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    select {
        width: 90%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    .flex-box1 {
        width: 80%;
        display: flex;
        justify-content: flex-end;
    }

    .go {
        background-color: rgb(37,99,235);
        border-radius: 8px;
        padding: 8px 20px;
        color: white;
    }

    .clear {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    input:focus {
        border: 1px solid rgb(37,99,235) !important;
    }

    select:focus {
        border: 1px solid rgb(37,99,235) !important;
    }

    .export {
        background-color: none;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    .flex-box2 {
        display: flex;
        justify-content: flex-end;
    }

    table {
        @* width: 75vw; *@
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    thead {
        background-color: rgb(233,239,253);
        width: 100%;
    }

    th {
        padding: 15px 0px;
        font-weight: 500;
    }

    thead th {
        width: calc(100% / 8); /* Replace with actual number */
        word-wrap: break-word; /* Wrap long words */
        white-space: normal; /* Allow wrapping */
        text-align: center;
        padding: 8px;
    }

    td {
        width: calc(100% / 8); /* Replace with actual number */
        word-wrap: break-word; /* Wrap long words */
        white-space: normal; /* Allow wrapping */
        text-align: center;
        padding: 8px;
    }

    tr {
        text-align: center;
    }

    thead th:first-child {
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }

    thead th:last-child {
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    th, td {
        width: calc(100% / 8);
        word-wrap: break-word;
        text-align: center;
    }

    tr {
        border: none !important;
    }

    td {
        padding: 15px;
    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        width: 100%;
        align-items: center;
    }

        .pagination-container select {
            width: 100px;
        }



    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }

        .search {
            margin: 10px 0px;
        }

        .page {
            width: 79vw;
        }

        .items-center select {
            width: 115px;
        }

        .export {
            margin: 10px;
        }
    }

    th.sort-asc i.fa-sort {
        color: #000 !important;
    }

    th.sort-desc i.fa-sort {
        color: #000 !important;
    }

    th.sort-asc i.fa-sort:before {
        content: "\f0de"; /* arrow up */
    }

    th.sort-desc i.fa-sort:before {
        content: "\f0dd"; /* arrow down */
    }
</style>
@* for the loading effect like data tables ... *@
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>
