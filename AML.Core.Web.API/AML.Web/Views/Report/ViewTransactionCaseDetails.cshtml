<script type="text/javascript">
    function DownloadDocument(fiPath, fiName) {
        $.ajax({
            type: "GET",
            url: "/Case/DownloadCaseDocument",
            data: {
                filePath: fiPath,
                fileName: fiName
            },
            success: function (data) {
                window.location = '/Case/DownloadCaseDocument?filePath=' + fiPath + '&fileName=' + fiName;
            },
            error: function (result) {
                alert('error');
            }
        });
    }
</script>
<script type="text/javascript">
    var comments = [];
    $('#Comments').hide();
    $('#nocomment').show();

    $(document).ready(function () {

        if ($('#hdnStatus').val() == '2' || $('#hdnStatus').val() == '3') {
            $('#txtCaseActionRemarks').attr('disabled', 'disabled');
            $("input[type=submit]").attr('disabled', 'disabled');
            $('#ddlUsers').attr('disabled', 'disabled');
            $("#btnTransfer").attr('disabled', 'disabled');
        }

        $.ajax({
            url: '/case/comment/' + $('#hdnCaseId').val(),
            type: 'get',
            success: function (response) {
                comments = response;
                buildComments();
            }
        });
    });




    $('#frmCmment').submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: '/case/comment',
            type: 'post',
            data: $('#frmCmment').serialize(),
            success: function (response) {
                comments = response;
                $('.commment-list').remove();
                buildComments();
            }
        });
    });
    $('#frmCloseCase').submit(function (e) {
        e.preventDefault();
        var val = $("input[type=submit][clicked=true]").val();
        if (val == 'Approve Case') {
            $('#hdnAction').val(2);
        } else {
            $('#hdnAction').val(3);
        }
        $.ajax({
            url: '/case/close',
            type: 'post',
            data: $('#frmCloseCase').serialize(),
            success: function (response) {
                $('#txtCaseActionRemarks').val('');
                $('#txtCaseActionRemarks').attr('disabled', 'disabled');
                $("input[type=submit]").attr('disabled', 'disabled');
                $('#ddlUsers').attr('disabled', 'disabled');
                $("#btnTransfer").attr('disabled', 'disabled');

                toastr.success(response);
                setTimeout(function () { location.href = '/case'; }, 3000);
                location.href = '/case';

            }
        });
    });

    $("#frmCloseCase input[type=submit]").click(function () {
        $("input[type=submit]", $(this).parents("form")).removeAttr("clicked");
        $(this).attr("clicked", "true");
    });






    $('#frmTransferCase').submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: '/case/assign',
            type: 'post',
            data: $('#frmTransferCase').serialize(),
            success: function () {
                $('#ddlUsers').val(0);
                toastr.success('Case Transferred');
            }
        });
    });


    function buildComments() {
        if (comments.length) {
            $('#Comments').show();
            $('#nocomment').hide();
            var template = '<div class="commment-list"><i class="fas fa-user bg-green"></i><div class="timeline-item"><span class="time" ><i class="fas fa-clock"></i> <label class="time-ago"></label></span >' +
                '<h3 class="timeline-header no-border"><a class="a-user" href="#"></a>&nbsp;&nbsp;<label class="case-comment"></label></h3></div></div>';
            $("#Comments").find('div.comment-section').prepend(template);
            $.each(comments, function (i, v) {

                setDataOnRow($(template), v, i);

            });
            $('#txtCaseComment').val('');

            $($("#Comments").find('div.commment-list').last()).remove();
            $($("#Comments").find('i').last()).remove();
            $($("#Comments").find('div.commment-list').parent()).append('<div><i class= "fas fa-clock bg-gray" ></i></div>');
        }
    }


    function setDataOnRow(rowObject, v, i) {
        $(rowObject).find(".a-user").html(v.createdUser);
        $(rowObject).find(".time-ago").html(v.duration);
        $(rowObject).find(".case-comment").html(v.comment);
        $("#Comments").find('div.comment-section').prepend(rowObject);
    }
    function clearDocuemnt() {
        $('#frmDocument').find("input[type=text], textarea").val("");
        $('#frmDocument').find("input[type=file]").val(null);
        $('#frmDocument').find("select").val(0);
    }

    function printdiv(printpage) {

        var newstr = document.all.item(printpage).innerHTML;
        var oldstr = document.body.innerHTML;
        document.body.innerHTML = newstr;
        document.getElementById("logodiv").style.display = "";
        document.getElementById("createddiv").style.display = "";
        document.getElementById("footdiv").style.display = "";
        document.getElementById("printBtnDiv").style.display = "none";
        document.getElementById("caseCmmnt").style.maxHeight = "none";
        window.print();
        document.body.innerHTML = oldstr;
        document.getElementById("printBtnDiv").style.display = "";
        return false;
    }
</script>
