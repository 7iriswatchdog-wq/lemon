@using AML.ViewModel.ViewModels.Report
@using Microsoft.AspNetCore.Http
@model List<CaseReportListModel>
@functions {
    public bool ShowColumn(string colId)
    {
        var selectedColumns = ViewBag.SelectedColumns as string;
        if (string.IsNullOrEmpty(selectedColumns)) return true;
        return selectedColumns.Split(',').Contains(colId);
    }
}
@{
    Layout = null;
    var companyName = Context.Session.GetString("SessCompanyName") ?? "AML Systems";
    var orientation = ViewBag.Orientation as string ?? "portrait";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @@media print {
            .no-print { display: none !important; }
            tr { page-break-inside: avoid !important; break-inside: avoid !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 text-[10px] p-8">
    <div id="pdf-container" class="max-w-[@(orientation == "landscape" ? "1280px" : "1024px")] mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <!-- Header -->
        <div class="flex justify-between items-start border-b border-slate-200 pb-6 mb-6">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900">Case Report</h1>
                <p class="text-slate-500 font-medium mt-1">Generated on @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
            <div class="text-right">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Company</div>
                <div class="text-lg font-black text-blue-600">@companyName</div>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-slate-200 text-slate-500 uppercase tracking-wider font-bold text-[9px]">
                        <th class="px-2 py-3">#</th>
                        @if (ShowColumn("customerID")) { <th class="px-2 py-3">Customer ID</th> }
                        @if (ShowColumn("createdOn")) { <th class="px-2 py-3">Created On</th> }
                        @if (ShowColumn("updatedOn")) { <th class="px-2 py-3">Updated On</th> }
                        @if (ShowColumn("customerType")) { <th class="px-2 py-3">Type</th> }
                        @if (ShowColumn("customerName")) { <th class="px-2 py-3">Customer Name</th> }
                        @if (ShowColumn("nationality")) { <th class="px-2 py-3">Nationality</th> }
                        @if (ShowColumn("status")) { <th class="px-2 py-3">Status</th> }
                        @if (ShowColumn("screeningScore")) { <th class="px-2 py-3">Screening Score</th> }
                        @if (ShowColumn("riskRating")) { <th class="px-2 py-3">Risk Rating</th> }
                        @if (ShowColumn("user")) { <th class="px-2 py-3">User</th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{
                        var items = Model as List<CaseReportListModel>;
                    }
                    @if (items != null && items.Any())
                    {
                        int index = 1;
                        foreach (var item in items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-2 py-3 text-slate-400 font-medium">@index</td>
                                @if (ShowColumn("customerID"))
                                {
                                    <td class="px-2 py-3 font-bold text-slate-900">@item.CustomerID</td>
                                }
                                @if (ShowColumn("createdOn"))
                                {
                                    <td class="px-2 py-3 text-slate-600">
                                        @if(DateTime.TryParse(item.CreatedOn, out DateTime dtCreate)) {
                                            <div class="font-medium">@dtCreate.ToString("dd MMM yyyy")</div>
                                            <div class="text-slate-400 text-[7px]">@dtCreate.ToString("HH:mm:ss tt")</div>
                                        } else {
                                            @item.CreatedOn
                                        }
                                    </td>
                                }
                                @if (ShowColumn("updatedOn"))
                                {
                                    <td class="px-2 py-3 text-slate-600">
                                        @{
                                            var updateDateStr = !string.IsNullOrEmpty(item.UpdatedOn) ? item.UpdatedOn : item.UpdatedOnDB;
                                        }
                                        @if(!string.IsNullOrEmpty(updateDateStr))
                                        {
                                            if(DateTime.TryParse(updateDateStr, out DateTime dtUpdate)) {
                                                <div class="font-medium">@dtUpdate.ToString("dd MMM yyyy")</div>
                                                <div class="text-slate-400 text-[7px]">@dtUpdate.ToString("HH:mm:ss tt")</div>
                                            } else {
                                                @updateDateStr
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                }
                                @if (ShowColumn("customerType"))
                                {
                                    <td class="px-2 py-3">
                                        <span class="px-2 py-0.5 rounded-full text-[8px] font-bold @(item.CustomerType == "I" || item.CustomerType == "Individual" ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                                            @(item.CustomerType == "I" || item.CustomerType == "Individual" ? "Individual" : "Corporate")
                                        </span>
                                    </td>
                                }
                                @if (ShowColumn("customerName"))
                                {
                                    <td class="px-2 py-3 font-semibold text-slate-800">@(item.FirstName + " " + item.LastName)</td>
                                }
                                @if (ShowColumn("nationality"))
                                {
                                    <td class="px-2 py-3 text-slate-600">@item.Nationality</td>
                                }
                                @if (ShowColumn("status"))
                                {
                                    <td class="px-2 py-3 text-left">
                                        @{
                                            var status = item.CaseStatus ?? "";
                                            if (status.Contains("| Shareholders:"))
                                            {
                                                var parts = status.Split('|');
                                                var mainStatus = parts[0].Trim();
                                                var shInfo = parts[1].Replace("Shareholders:", "").Trim();
                                                var metrics = shInfo.Split(',').Select(m => m.Trim()).Where(m => !m.EndsWith(" 0")).ToList();

                                                <div class="font-bold text-slate-900">@mainStatus</div>
                                                @if (metrics.Any())
                                                {
                                                    <div class="text-[8px] text-slate-500 mt-1">
                                                        <div class="font-black text-slate-400 uppercase tracking-tighter text-[7px]">Shareholders</div>
                                                        @foreach (var metric in metrics)
                                                        {
                                                            <div>@metric</div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="font-bold text-slate-700">@status</span>
                                            }
                                        }
                                    </td>
                                }
                                @if (ShowColumn("screeningScore"))
                                {
                                    <td class="px-2 py-3 font-bold text-slate-900 text-center">@item.MatchScore</td>
                                }
                                @if (ShowColumn("riskRating"))
                                {
                                    <td class="px-2 py-3 font-black text-blue-600 text-center">@item.MatchScore</td>
                                }
                                @if (ShowColumn("user"))
                                {
                                    <td class="px-2 py-3 text-slate-500">@item.CreatedUser</td>
                                }
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="px-2 py-12 text-center text-slate-400 italic font-medium">No records found for this case report.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-[9px] text-slate-400 font-medium">Confidential Report - @companyName &copy; @DateTime.Now.Year</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-export.js"></script>
    <script>
        window.onload = function() {
            setTimeout(() => {
                downloadPageAsPDF('#pdf-container', 'Case_Report_@DateTime.Now.ToString("yyyyMMdd")' + '.pdf', '@orientation');
            }, 1000);
        };
    </script>
</body>
</html>
