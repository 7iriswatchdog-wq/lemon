@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AML.ViewModel.ViewModels.Report.CaseReportDownloadModel

<div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
        <thead>
            <tr style="border: 1px solid black;">
                <th style="width:10%;border:1px solid black;">#</th>
                <th style="width:10%;border:1px solid black;">@localizer["ID"]</th>
                <th style="width:10%;border:1px solid black;">@localizer["TYPE"]</th>
                <th style="width:10%;border:1px solid black;">@localizer["CATEGORY"]</th>
                <th style="width:30%;border:1px solid black;">@localizer["NAME"]</th>
                <th style="width:10%;border:1px solid black;">@localizer["SCORE"]</th>
                <th style="width:10%;border:1px solid black;">@localizer["NATIONALITY"]</th>
                <th style="width:10%;border:1px solid black;">@localizer["DOB"]</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.ApiResultsjson.Count; i++)
            {
                <tr style="border: 1px solid black;">
                    <td style="width:10%;border:1px solid black;">@(i+1)</td>
                    <td style="width:10%;border:1px solid black;">@Model.ApiResultsjson[i].matchuid</td>
                    <td style="width:10%;border:1px solid black;">@Model.ApiResultsjson[i].matchtype</td>
                    <td style="width:10%;border:1px solid black;">@Model.ApiResultsjson[i].matchcategory</td>
                    <td style="width:30%;border:1px solid black;">@Model.ApiResultsjson[i].matchname</td>
                    <td style="width:10%;border:1px solid black;">@Model.ApiResultsjson[i].matchscore</td>
                    <td style="width:10%;border:1px solid black;">@Model.ApiResultsjson[i].nationality</td>
                    <td style="width:10%;border:1px solid black;">@Model.ApiResultsjson[i].matchdob</td>
                </tr>
            }

        </tbody>
    </table>
</div>