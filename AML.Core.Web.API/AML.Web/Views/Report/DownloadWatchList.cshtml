
@{
    Layout = null;
}
@model List<AML.ViewModel.ViewModels.Report.ReportInternalWatchListLogModel>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>DownloadWatchList</title>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>UID</th>
                <th>Type</th>
                <th>Name</th>
                <th>Nationality/Country</th>
                <th>DOB</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {

                <tr>
                    <th>@item.uid</th>
                    <th>@item.type</th>
                    <th>@item.fullname</th>
                    <th>@item.nationality</th>
                    <th>@item.dob</th>
                    <th>@item.type</th>
                </tr>
            }
        </tbody>

    </table>
</body>
</html>
