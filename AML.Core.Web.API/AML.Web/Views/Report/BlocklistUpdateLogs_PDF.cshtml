@using AML.DTO.DTO.FreeSource
@using Microsoft.AspNetCore.Http
@model List<BlackListMongoDTO.NAMELIST>
@functions {
    public bool ShowColumn(string colId)
    {
        var selectedColumns = ViewBag.SelectedColumns as string;
        if (string.IsNullOrEmpty(selectedColumns)) return true;
        return selectedColumns.Split(',').Contains(colId);
    }
}
@{
    Layout = null;
    var companyName = Context.Session.GetString("SessCompanyName") ?? "AML Systems";
    var orientation = ViewBag.Orientation as string ?? "portrait";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blocklist Update Logs Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @@media print {
            .no-print { display: none !important; }
            tr { page-break-inside: avoid !important; break-inside: avoid !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 text-[10px] p-8">
    <div id="pdf-container" class="max-w-[@(orientation == "landscape" ? "1280px" : "1024px")] mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <!-- Header -->
        <div class="flex justify-between items-start border-b border-slate-200 pb-6 mb-6">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900">Blocklist Update Logs</h1>
                <p class="text-slate-500 font-medium mt-1">Generated on @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
            <div class="text-right">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Company</div>
                <div class="text-lg font-black text-blue-600">@companyName</div>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-slate-200 text-slate-500 uppercase tracking-wider font-bold text-[9px]">
                        <th class="px-2 py-3">#</th>
                        @if (ShowColumn("Type")) { <th class="px-2 py-3">Type</th> }
                        @if (ShowColumn("Name")) { <th class="px-2 py-3">Name</th> }
                        @if (ShowColumn("Nationality")) { <th class="px-2 py-3">Nationality</th> }
                        @if (ShowColumn("DOB")) { <th class="px-2 py-3">DOB</th> }
                        @if (ShowColumn("IDNumber")) { <th class="px-2 py-3">ID Number</th> }
                        @if (ShowColumn("Source")) { <th class="px-2 py-3">Source</th> }
                        @if (ShowColumn("CreatedOn")) { <th class="px-2 py-3">Created On</th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{
                        var items = Model as List<BlackListMongoDTO.NAMELIST>;
                    }
                    @if (items != null && items.Any())
                    {
                        int index = 1;
                        foreach (var item in items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-2 py-3 text-slate-400 font-medium">@index</td>
                                @if (ShowColumn("Type")) {
                                    <td class="px-2 py-3 capitalize text-left">
                                        <span class="font-bold text-slate-700">@item.CATEGORY</span>
                                    </td>
                                }
                                @if (ShowColumn("Name")) { <td class="px-2 py-3 font-bold text-slate-900">@item.FULLNAME</td> }
                                @if (ShowColumn("Nationality")) { <td class="px-2 py-3 text-slate-600">@item.NATIONALITY</td> }
                                @if (ShowColumn("DOB")) {
                                    <td class="px-2 py-3 text-slate-600">
                                        @if(item.DOB != null && item.DOB.Any())
                                        {
                                            @string.Join(", ", item.DOB.Select(d => d.DOB))
                                        }
                                    </td>
                                }
                                @if (ShowColumn("IDNumber")) {
                                    <td class="px-2 py-3 text-slate-600 font-medium">
                                        @if(item.IDDETAILS != null && item.IDDETAILS.Any())
                                        {
                                            @string.Join(", ", item.IDDETAILS.Select(i => i.IDNUMBER))
                                        }
                                    </td>
                                }
                                @if (ShowColumn("Source")) { <td class="px-2 py-3 text-blue-600 font-semibold italic">@item.SUBCATEGORY</td> }
                                @if (ShowColumn("CreatedOn")) { <td class="px-2 py-3 text-slate-500">@item.CREATEDDATE.ToString("dd MMM yyyy HH:mm")</td> }
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-2 py-12 text-center text-slate-400 italic font-medium">No records found for blocklist update logs.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-[9px] text-slate-400 font-medium">Compliance Document - @companyName &copy; @DateTime.Now.Year</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-export.js"></script>
    <script>
        window.onload = function() {
            setTimeout(() => {
                downloadPageAsPDF('#pdf-container', 'Blocklist_Update_Logs_@DateTime.Now.ToString("yyyyMMdd")' + '.pdf', '@orientation');
            }, 1000);
        };
    </script>
</body>
</html>
