@model List<AML.DTO.DTO.FreeSource.BlackListMongoDTO.NAMELIST>
@{
    Layout = "~/Views/Shared/_PdfLayout.cshtml";
    ViewData["Title"] = "Blocklist Update Logs";
    ViewData["Orientation"] = ViewBag.Orientation ?? "portrait";
}
<table>
    <thead>
        <tr>
            <th>Category</th>
            <th>Full Name</th>
            <th>Nationality</th>
            <th>DOB</th>
            <th>ID Number</th>
            <th>Source</th>
            <th>Created On</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var idNumber = item.IDDETAILS != null && item.IDDETAILS.Count > 0 ? item.IDDETAILS[0].IDNUMBER : "-";
                var dob = item.DOB != null && item.DOB.Count > 0 ? item.DOB[0].DOB : "-";
                <tr>
                    <td>@item.CATEGORY</td>
                    <td>@item.FULLNAME</td>
                    <td>@item.NATIONALITY</td>
                    <td>@dob</td>
                    <td>@idNumber</td>
                    <td>@item.TYPE</td>
                    <td>@item.CREATEDON</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" style="text-align: center; color: #9CA3AF; padding: 20px;">No records found.</td>
            </tr>
        }
    </tbody>
</table>
