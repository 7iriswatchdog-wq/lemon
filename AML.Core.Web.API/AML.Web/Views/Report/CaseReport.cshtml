<style>
    select {
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.41 0L6 4.59L10.59 0L12 1.42L6 7.42L0 1.42L1.41 0Z' fill='black'/%3E%3C/svg%3E") !important;
        background-repeat: no-repeat !important;
        background-position-x: calc(100% - 20px) !important;
        background-position-y: 50% !important;
        background-size: 12px 8px !important;
        padding-right: 2rem; /* Space for arrow */
    }
    .selectBox {
        position: relative;
    }
    .overSelect {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
    }

    #checkboxes {
        display: none;
        border: 1px #dadada solid;
    }


        #checkboxes label {
            display: block;
            text-align: left;
        }

            #checkboxes label:hover {
            }

    .page {
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border-bottom: 1px solid #dee2e6;
    }

    .heading, .menu-icon, .md.block {
        min-width: 0; /* allows shrinking */
        flex-shrink: 1; /* enables shrinking */
    }

    .heading {
        font-size: 1.25rem;
    }


    .card1 {
        max-width: 100%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
        box-shadow: 0 0 #0000, /* fallback ring-offset-shadow */
        0 0 #0000, /* fallback ring-shadow */
        0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .flex-box {
        display: flex;
        flex-wrap: wrap;
        margin: 10px 0px;
    }

        .flex-box > .flex-item {
            flex: 1 1 250px;
            text-align: center;
        }

    .form-group {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
    }

    .flex-item input {
        width: 90%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }
    .flex-item select {
        width: 90%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    .multiselect {
        width: 100%;
        align-self: flex-start;
    }

    .selectBox {
        width: 100%;
        align-self: flex-start;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* <-- This aligns inner elements to the left */
    }

    select {
        width: 80%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }
    /* Add this to your CSS */
    .buttons-div {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
    }

    .go {
        background-color: rgb(37,99,235);
        border-radius: 8px;
        padding: 8px 20px;
        color: white;
    }

    .clear {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    thead {
        background-color: rgb(233,239,253);
    }

    th, td {
        padding: 10px;
        text-align: left;
    }

    thead th:first-child {
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }

    thead th:last-child {
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    label, h6 {
        color: rgb(17, 24, 39);
    }

    input, select {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter;
    }
        input:focus {
            border: 1px solid rgb(37,99,235) !important;
        }

        select:focus {
            border: 1px solid rgb(37,99,235) !important;
        }


    select {
        font-weight: lighter;
    }

    option {
        font-weight: lighter;
    }

    .flex-box1 {
        width: 90%;
        justify-content: flex-end;
    }

    .export {
        background-color: none;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }
    /* Checkbox fixes */
    #checkboxes {
        width: 100%;
    }

        #checkboxes label {
            display: flex;
            align-items: center;
            padding: 4px 0;
            text-align: left;
            white-space: normal;
        }

        #checkboxes input[type="checkbox"] {
            width: 16px;
            min-width: 16px;
            height: 16px;
            margin: 4px;
            flex-shrink: 0;
        }

            #checkboxes input[type="checkbox"]:focus {
                border: none !important;
                outline: none !important;
                box-shadow: none !important;
            }

    /* Specific fix for your nomatch checkbox */
    th {
        font-weight: 500;
    }

    th, td {
        width: calc(100% / 8);
        word-wrap: break-word;
        text-align: center;
    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        width: 100%;
        align-items: center;
    }

        .pagination-container select {
            width: 100px;
        }

    .loader-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .loader {
        border: 5px solid #f3f3f3;
        border-top: 5px solid #3498db;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
    .view, .revert {
        background-color: rgb(239 246 255);
        color: rgb(37 99 235);
        border-radius: 8px;
        padding: 8px 10px;
        margin : 10px;
    }


    /* Optional: Add visual scroll hint for mobile */
    @@media (max-width: 768px) {
        .table-container {
            overflow-x: auto;
        }

        .export {
            margin: 10px;
        }

        .page {
            width: 80vw;
        }

        .items-center select {
            width: 115px;
        }

    }
    th.sort-asc i.fa-sort {
        color: #000 !important;
    }

    th.sort-desc i.fa-sort {
        color: #000 !important;
    } 

    th.sort-asc i.fa-sort:before {
        content: "\f0de"; /* arrow up */
    } 

    th.sort-desc i.fa-sort:before {
        content: "\f0dd"; /* arrow down */
    }

   
    tr {
        border: none !important;
    }
    td{
        padding: 15px;
    }
</style>
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>
