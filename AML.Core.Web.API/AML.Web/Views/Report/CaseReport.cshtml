    // Initialize variables outside document.ready for wider scope
    let pageSize = parseInt($('#rowsPerPage').val()) || 10;
    let currentPage = 1;
    let totalPages = 1;
    let drawCounter = 1;
    let allData;
    let searchTimeout;
    let currentSearchTerm = '';
    let currentSortColumn = 6; // Default sort by Customer ID
    let currentSortDirection = 'desc'; // Default sort direction
    function sortTable(columnIndex) {
        // Reset all sort icons
        $('#filterTable th').removeClass('sort-asc sort-desc');
        $('#filterTable th i.fa-sort').css('color', '#ccc');

        // If clicking the same column, toggle direction
        if (currentSortColumn === columnIndex) {
            currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            // New column, default to ascending
            currentSortColumn = columnIndex;
            currentSortDirection = 'asc';
        }

        // Update the sort icon for the current column
        const $header = $('#filterTable th').eq(columnIndex);
        $header.addClass(`sort-${currentSortDirection}`);
        $header.find('i.fa-sort').css('color', '#2563eb');

        // Reload the data with new sorting
        loadCaseReport(currentPage, currentSearchTerm);
    }

    $(document).ready(function () {
        // Initialize the table
