            var month = date.getMonth() + 1;
            var year = date.getFullYear();
            if (month < 10) month = "0" + month;
            if (day < 10) day = "0" + day;
            var today = year + "-" + month + "-" + day;
            var ddate = new Date(date.setDate(date.getDate() - 7));
            var day1 = ddate.getDate();
            var month1 = ddate.getMonth() + 1;
