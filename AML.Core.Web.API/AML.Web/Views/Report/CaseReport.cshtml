            { id: "user", label: "User" },
            { id: "status", label: "Status" }
        ];

        openExportModal({
            getColumnsByActiveTab: () => columns,
            onExport: (format, selectedColumns, orientation) => {
                ExportList(format === 'pdf', selectedColumns, orientation);
            }
        });
    }

    function ExportList(isPDF, selectedColumns, orientation) {
        const params = $.param({
            startDate: formatDate($('#startDate').val()),
            endDate: formatDate($('#endDate').val()),
            cust_type: $('#customertype').val(),
            createdBy: $('#user').val(),
            matchScore: $('#screeningScore').val(),
            caseStatus: $('#caseStatus').val(),
            caseStatusChange: $('#caseStatusChange').val(),
            riskLevel: $('#riskScore').val(),
            includingDuplicate :$('#includingDuplicate').val(),
            searchValue: ($('#searchInput').val() || ''),
            selectedColumns: selectedColumns || '',
            orientation: orientation || 'portrait'
        });

        if (isPDF) {
            $('#loader').removeClass('hidden').addClass('flex');
            const url = '/Report/CaseReport_PDF?' + params;
            $('#pdfExportFrame').attr('src', url);
        } else {
            $("#loadingCaseDetails").show();
            window.location = '/Report/ExportCaseReport?' + params;
            $("#loadingCaseDetails").hide();
        }
    }

        function checkFilterValues() {

        const fields = [
            document.getElementById("startDate"),
            document.getElementById("endDate"),
            document.getElementById("customertype"),
            document.getElementById("columnFilter"),
            document.getElementById("caseStatusChange"),
            document.getElementById("screeningScore"),
            document.getElementById("user"),
            document.getElementById("caseStatus"),
            document.getElementById("riskScore")
        ];

        const applyBtn = document.getElementById("applyBtn");
        const exportBtn = document.getElementById("exportBtn");
            const searchBtn = document.getElementById("searchButton");

        let hasValue = false;

        fields.forEach(field => {
            if (!field) return;

            if (field.tagName === "SELECT") {
                if (field.value !== "" && field.value !== "0" && field.value !== "10") {
                    hasValue = true;
                }
            } else {
                if (field.value.trim() !== "") {
                    hasValue = true;
                }
            }
        });
        if (applyBtn) applyBtn.disabled = !hasValue;
        if (exportBtn) exportBtn.disabled = !hasValue;
        if (searchBtn) searchBtn.disabled = !hasValue;

        if (!hasValue) {
            if (applyBtn) applyBtn.classList.add("opacity-50","cursor-not-allowed");
            if (exportBtn) exportBtn.classList.add("opacity-50","cursor-not-allowed");
            if (searchBtn) searchBtn.classList.add("opacity-50","cursor-not-allowed");
        } else {
            if (applyBtn) applyBtn.classList.remove("opacity-50","cursor-not-allowed");
            if (exportBtn) exportBtn.classList.remove("opacity-50","cursor-not-allowed");
            if (searchBtn) searchBtn.classList.remove("opacity-50","cursor-not-allowed");
        }
    }
    
    // Use more specific selectors for filter inputs to avoid conflicts
    document.querySelectorAll("#filterSection input, #filterSection select").forEach(el => {
        el.addEventListener("change", checkFilterValues);
        el.addEventListener("input", checkFilterValues);
    });
    

        document.addEventListener("DOMContentLoaded", function () {

        function initDatePicker(selector, defaultDate, isEndDate = false) {
            return flatpickr(selector, {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                defaultDate: defaultDate,
                allowInput: true,

                // ✅ Conditional logic
                // ...(isEndDate
                //     ? { minDate: "today" }   // End Date → no past dates
                //     : { maxDate: "today" }   // Start Date → no future dates
                // )
            });
        }

        // Get initial values from inputs (bound to Model)
        const initialStartDate = document.querySelector("#startDate").value;
        const initialEndDate = document.querySelector("#endDate").value;

        // ✅ Start Date → Use model value or 1 year back
        const startPicker = initDatePicker("#startDate", initialStartDate || new Date().fp_incr(-365));

        // ✅ End Date → Use model value or today
        const endPicker = initDatePicker("#endDate", initialEndDate || new Date(), true);

        // ✅ Handle automated filtering from other pages (e.g. Scheduler Logs)
        const tempStatus = document.getElementById("tempCaseStatus")?.value;
        if (tempStatus && tempStatus !== "10" && tempStatus !== "") {
            // Show the status field if it's hidden
            document.getElementById("extraFilters").classList.remove("hidden");
            document.getElementById("columnFilter").value = "Status";
            Colunmfilterfunction();
            
            // Set the status value
            document.getElementById("caseStatus").value = tempStatus;
            
            // Trigger search
            setTimeout(() => {
                searchCases();
            }, 500);
        }

    });
        function setRowType(element) {
        const rowType = element.dataset.rowtype;
        sessionStorage.setItem("rowType", rowType);
    }
    function setRowTypeAndNav(el, rowType, url) {
        sessionStorage.setItem("rowType", rowType);
        window.location.href = url;
    }
   
    
</script>
