    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Premium page header */
        .cr-header { background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #1e293b 100%); border-radius: 16px; padding: 28px 32px; color: #fff; position: relative; overflow: hidden; }
        .cr-header::before { content: ''; position: absolute; top: -50%; right: -20%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(59,130,246,.15) 0%, transparent 70%); }
        .cr-header h1 { font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; }
        .cr-header p { color: rgba(255,255,255,.6); font-size: 13px; margin-top: 4px; }
        .cr-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(255,255,255,.45); margin-bottom: 8px; }
        .cr-breadcrumb span:last-child { color: rgba(255,255,255,.8); }
        /* Stat pills in header */
        .cr-stats { display: flex; gap: 12px; margin-top: 16px; }
        .cr-stat { background: rgba(255,255,255,.08); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.1); border-radius: 10px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; }
        .cr-stat .num { font-size: 18px; font-weight: 800; color: #fff; }
        .cr-stat .lbl { font-size: 11px; color: rgba(255,255,255,.5); text-transform: uppercase; letter-spacing: .04em; }
        /* Filter card */
        .cr-filter { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px 24px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
        .cr-filter label { font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .03em; }
        .cr-filter input, .cr-filter select { height: 40px; border-radius: 8px; border: 1px solid #e2e8f0; padding: 0 12px; font-size: 13px; transition: all .2s; background: #f8fafc; }
        .cr-filter input:focus, .cr-filter select:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.1); outline: none; background: #fff; }
        /* Premium table */
        .cr-table-wrap { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
        .cr-table thead { background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); }
        .cr-table thead th { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #64748b; padding: 14px 12px; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
        .cr-table tbody tr { transition: background .15s; }
        .cr-table tbody tr:hover { background: #f0f7ff; }
        .cr-table tbody td { padding: 14px 12px; font-size: 12.5px; color: #334155; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
        /* Status badges */
        .badge-status { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
        .badge-pending { background: #fef3c7; color: #92400e; }
        .badge-approved { background: #d1fae5; color: #065f46; }
        .badge-rejected { background: #fee2e2; color: #991b1b; }
        .badge-onhold { background: #e0e7ff; color: #3730a3; }
        .badge-closed { background: #f1f5f9; color: #475569; }
        .badge-smr { background: #fae8ff; color: #86198f; }
        /* View link */
        .cr-view-link { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: #2563eb; padding: 4px 14px; border-radius: 6px; border: 1px solid #bfdbfe; background: #eff6ff; transition: all .2s; text-decoration: none; }
        .cr-view-link:hover { background: #2563eb; color: #fff; border-color: #2563eb; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(37,99,235,.25); }
        /* Search bar */
        .cr-search { border-radius: 10px; border: 1px solid #e2e8f0; background: #f8fafc; height: 44px; padding-left: 40px; transition: all .2s; }
        .cr-search:focus { background: #fff; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.1); }
        /* Score pill */
        .score-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; padding: 2px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; }
        .score-high { background: #fee2e2; color: #dc2626; }
        .score-mid { background: #ffedd5; color: #ea580c; }
        .score-low { background: #d1fae5; color: #059669; }
        /* Risk text */
        .risk-high { color: #dc2626; font-weight: 700; }
        .risk-medium { color: #f59e0b; font-weight: 700; }
        .risk-low { color: #10b981; font-weight: 700; }
        /* Buttons */
        .cr-btn-primary { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #fff; font-weight: 600; height: 40px; padding: 0 20px; border-radius: 8px; font-size: 13px; border: none; cursor: pointer; transition: all .2s; box-shadow: 0 1px 3px rgba(37,99,235,.2); }
        .cr-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,.3); }
        .cr-btn-outline { background: #fff; color: #334155; font-weight: 600; height: 40px; padding: 0 20px; border-radius: 8px; font-size: 13px; border: 1px solid #e2e8f0; cursor: pointer; transition: all .2s; }
        .cr-btn-outline:hover { background: #f8fafc; border-color: #cbd5e1; }
        .cr-btn-reset { background: transparent; color: rgba(255,255,255,.7); font-weight: 600; height: 36px; padding: 0 16px; border-radius: 8px; font-size: 12px; border: 1px solid rgba(255,255,255,.2); cursor: pointer; transition: all .2s; }
        .cr-btn-reset:hover { background: rgba(255,255,255,.1); color: #fff; }
        /* Premium clickable rows */
        .cr-table tbody tr { cursor: pointer; transition: all .2s cubic-bezier(.25,.8,.25,1); position: relative; }
        .cr-table tbody tr:hover { background: linear-gradient(90deg, #eff6ff 0%, #f8fafc 100%) !important; transform: translateX(3px); box-shadow: 0 2px 12px rgba(59,130,246,.08), inset 4px 0 0 #3b82f6; }
        .cr-table tbody tr:hover td { color: #1e293b !important; }
        .cr-table tbody tr:hover td:first-child { color: #3b82f6 !important; }
        .cr-table tbody tr .row-arrow { opacity: 0; transform: translateX(-8px); transition: all .2s ease; color: #3b82f6; }
        .cr-table tbody tr:hover .row-arrow { opacity: 1; transform: translateX(0); }
        .cr-table tbody tr:active { transform: translateX(1px) scale(.998); box-shadow: 0 1px 4px rgba(59,130,246,.06), inset 4px 0 0 #2563eb; }
    </style>
    <div id="loadingCaseDetails" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-50 hidden">
        <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
    </div>

    <style>
        .dt-loader {
            position: relative;
            width: 80px;
            height: 20px;
        }

            .dt-loader div {
                position: absolute;
                top: 8px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #2563eb;
                animation-timing-function: cubic-bezier(0,1,1,0);
            }

                .dt-loader div:nth-child(1) {
                    left: 8px;
                    animation: dt-anim1 0.6s infinite;
                }

                .dt-loader div:nth-child(2) {
                    left: 8px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(3) {
                    left: 32px;
                    animation: dt-anim2 0.6s infinite;
                }

                .dt-loader div:nth-child(4) {
                    left: 56px;
                    animation: dt-anim3 0.6s infinite;
                }

        @@keyframes dt-anim1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes dt-anim2 {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(24px);
            }
        }

        @@keyframes dt-anim3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }

        #caseDetailsTbl, #caseDetailsTbl th, #caseDetailsTbl td {
            border: none !important;
            border-radius: 0 !important;
        }

        th.sortable {
            cursor: pointer;
            position: relative;
            padding-right: 20px;
        }

            th.sortable::after {
                content: "▲\A▼";
                white-space: pre;
                font-size: 10px;
                position: absolute;
                right: 6px;
                top: 50%;
                transform: translateY(-50%);
                color: #bbb;
                line-height: 1;
                text-align: center;
            }

            th.sortable.active.asc::after {
                content: "▲";
                color: #000;
            }

            th.sortable.active.desc::after {
                content: '\A▼';
                color: #000;
            }
    </style>
</head>

