    function loadCaseReport(page = 1, searchValue = '') {
        $("#loader").show();
        console.log("Search value" + searchValue);
        const filters = {
            draw: drawCounter++,
            start: (page - 1) * pageSize,
            length: pageSize,
            order: [{ column: 0, dir: "asc" }],
            userID: $('#userID').val(),
            startDate: $('#dtStartDate').val(),
            endDate: $('#dtEndDate').val(),
            status: $('#caseStatusID').val(),
            cust_type: $('#customertype').val() === 'INDIVIDUAL' ? 'I' :
                $('#customertype').val() === 'CORPORATE' ? 'C' :
                    $('#customertype').val() === 'SHAREHOLDER' ? 'S' : '',
            updatedByUserID: $('#UpdatedByUserID').val(),
            nomatch: $('#hdnnomatch').val(),
            tdomesticpep: $('#hdntdometicpep').val(),
            tforeignpep: $('#hdntforeignpep').val(),
            tadversemedia: $('#hdntadversemedia').val(),
            pdomesticpep: $('#hdnpdometicpep').val(),
            pforeignpep: $('#hdnpforeignpep').val(),
            padversemedia: $('#hdnpadversemedia').val(),
            tuaeunsanction: $('#hdntuaeunsanction').val(),
            tothersanction: $('#hdntothersanction').val(),
            idstatus: $('#IdStatus').val(),
            option: $('#pageoption').val(),
            allapprovedcases: $('#hdnallprovedcases').val(),
            value: searchValue,
            orderColumn: currentSortColumn,
            orderDirection: currentSortDirection
        };

        $.ajax({
            url: '/Report/CaseReportCustompagination',
            type: 'POST',
            data: filters,
            success: function (resp) {
                const rows = resp.data || [];
                const totalRecords = resp.recordsFiltered || 0;
                allData = resp.allRows;
                totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));

                renderTable(rows);
                renderPager(page);
            },
            error: function (xhr) {
                console.error('Error:', xhr.responseText);
                alert('Error loading data');
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    }

    // Rest of your functions (renderTable, renderPager, showLoader, hideLoader, etc.) remain the same

    // Render table rows
    function renderTable(rows) {
        const $tbody = $('#filterTable tbody').empty();

        if (!rows.length) {
            $tbody.append('<tr><td colspan="8" class="text-center py-4">No data available</td></tr>');
            return;
        }

        rows.forEach(row => {
            let rowType = -1;
            let buttonsHtml = '';

            if (row.status) {
                if (!row.status.includes("Auto")) {
                    rowType = row.status.includes("Pending") ? 3 : 1;

                    if (row.status.includes("Approved") || row.status.includes("Rejected")) {
                        let rollbackType = row.isWhiteListed === 'YES' ? 4 :
                            row.status.includes("Approved") ? 0 : 1;

                        buttonsHtml += `<button class="sas-button p-8-25 bg-color-8 ml-2 revert"
                              onclick=" $('#loader').show(); rollbackCase('${row.customerID}', '${rollbackType}')">
                              Revert
                          </button>`;
                    }
                } else {
                    rowType = 2;
                }

                buttonsHtml = `<a class="sas-button bg-color-2 pt-2 view"
                       href="ViewIndividualCaseDetailNew?id=${row.customerID}&type=${rowType}" onclick="$('#loader').show();">
                       View
                    </a>` + buttonsHtml;
            }

            $tbody.append(`
        <tr>
            <td>${row.customerID || ''}</td>
            <td>${row.customerType || ''}</td>
            <td>${row.customerName || ''}</td>
            <td>${row.status || ''}</td>
            <td>${row.companyCode || ''}</td>
            <td>${row.createdBy || ''}</td>
            <td>${row.createdOn ? new Date(row.createdOn).toLocaleDateString('en-GB') : ''}</td>
            <td>${buttonsHtml}</td>
        </tr>
    `);
        });
    }

    // Render pagination controls
    function renderPager(page) {
        const $pagerButtons = $('.pagination-buttons').empty();
        if (totalPages <= 1) return;

        const btn = (lbl, pg, disabled, active) =>
            `<button class="px-3 py-1 border rounded
        ${active ? 'bg-blue-600 text-white' : 'bg-white text-blue-600'}
        ${disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100'}"
        data-page="${pg}" ${disabled ? 'disabled' : ''}>
        ${lbl}
    </button>`;

        $pagerButtons.append(btn('First', 1, page === 1));
        $pagerButtons.append(btn('Prev', page - 1, page === 1));

        const maxVisible = 5;
        let start = Math.max(1, page - Math.floor(maxVisible / 2));
        let end = start + maxVisible - 1;

        if (end > totalPages) {
            end = totalPages;
            start = Math.max(1, end - maxVisible + 1);
        }

        for (let i = start; i <= end; i++) {
            $pagerButtons.append(btn(i, i, false, i === page));
        }

        $pagerButtons.append(btn('Next', page + 1, page === totalPages));
        $pagerButtons.append(btn('Last', totalPages, page === totalPages));
    }
