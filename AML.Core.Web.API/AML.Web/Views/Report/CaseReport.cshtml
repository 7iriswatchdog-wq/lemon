    /* ---------------------- Pagination ---------------------- */

    function updatePagination() {

        const start = totalRecords === 0 ? 0 : (currentPage - 1) * size + 1;
        const end = Math.min(currentPage * size, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalCases').text(totalRecords);

        // Update header stats
        $('#statTotal').text(totalRecords);
        if (filteredCases && filteredCases.length) {
            const pendingCount = filteredCases.filter(c => {
                const s = formatCaseStatus(c.status);
                return s && s.toLowerCase().includes('pending');
            }).length;
            const approvedCount = filteredCases.filter(c => {
                const s = formatCaseStatus(c.status);
                return s && s.toLowerCase().includes('approved');
            }).length;
            $('#statPending').text(pendingCount);
            $('#statApproved').text(approvedCount);
        }

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);
    }

    function previousPage() {
        if (currentPage > 1)
            loadCases(currentPage - 1);
    }

    function nextPage() {
        if (currentPage * size < totalRecords)
            loadCases(currentPage + 1);
    }

