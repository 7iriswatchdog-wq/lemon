@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = @localizer["User Password Change Logs"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.Report.ReportLogSearchModel
<script src="~/plugins/jquery/jquery.min.js"></script>
<style>
    select {
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        background-color: #1a2038 !important;
        background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.41 0L6 4.59L10.59 0L12 1.42L6 7.42L0 1.42L1.41 0Z' fill='white'/%3E%3C/svg%3E") !important;
        background-repeat: no-repeat !important;
        background-position-x: calc(100% - 20px) !important;
        background-position-y: 50% !important;
        color: #fff !important;
        border: none !important;
        height: calc(2rem + 20px) !important;
        border-radius: 10px !important;
        font-variant: none !important;
    }

        select option {
            background-color: #1a2038;
        }
</style>
<div class="custom-container aml-user-password-change-logs">
    <div class="sas-breadcrumbs aml-breadcrumbs pb-3">
        <ul class="mb-0 pl-0 d-flex">
            <li><a href="#">Home</a></li>/
            <li><a href="#">Reports</a></li>/
            <li><a href="#">User Password Change Logs</a></li>
        </ul>
    </div>
    <div class="page-heading">
        <div class="sas-card rounded-card br-20 mb-2 bg-blue">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><b>User Password Change Logs</b></h4>
                <div class="menu-icon">
                    <i class="lni lni-microsoft"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- /.card-header -->
    <!-- form start -->
    <!--form role="form" asp-controller="Case" asp-action="SanctionScreening" class="form-horizontal" enctype="multipart/form-data" method="post"-->
    <div class="sas-card rounded-card mb-2 bg-blue">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">User Password Change Logs Filter</h6>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="dtDOB">@localizer["Start Date"]</label>
                    <input type="date" asp-for="StartDate" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtStartDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder=@localizer["Start Date"]>
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="dtDOB">@localizer["End Date"]</label>
                    <input type="date" asp-for="EndDate" class="h-11 w-full rounded-lg border border-bordercolor px-3 text-[14px] bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" id="dtEndDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder=@localizer["End Date"]>
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">

                </div>
            </div>
        </div>
    </style>
        <div class="row justify-content-end">
            <button type="submit" id="btnSearch" class="sas-button p-8-25 bg-color-2" onclick="search();">@localizer["GO"]</button>
            <button type="reset" id="btnReset" class="sas-button p-8-25 bg-color-3 ml-3">Clear All</button>
    </div>
    <!-- /.card-body -->
    <!--/form-->
</div>

    <div class="sas-card rounded-card mb-2 bg-blue">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Results</h6>
        </div>
        <hr />
        <div class="row">
            <div class="col-12">
                
                    <div class="p-6">
                        <div style="width: 100%; padding-left: -10px;">
                            <div class="table-responsive">
                                <table id="passwordLogs" class="w-full text-sm text-left" cellspacing="0">
                                    <thead class="text-[13px] font-medium text-textlabel bg-appbg border-b-2 border-bordercolor">
                                        <tr>
                                            <th>@localizer["Sl.No"]</th>
                                            <th>@localizer["User Id"]</th>
                                            <th>@localizer["User Name"]</th>
                                            <th>@localizer["Changed By"]</th>
                                            <th>@localizer["Changed Date"]</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script type="text/javascript">
    var table;
    $(document).ready(function () {
        search();
    });
    function search() {
        $.fn.dataTable.ext.legacy.ajax;
        table = $('#passwordLogs').DataTable({
            "processing": true,
            "serverSide": true,
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "destroy": true,
            ajax: {
                url: '/Report/PasswordList/',
                type: 'POST',
                data: {
                    StartDate: $('#dtStartDate').val(), // < note use of 'this' here
                    EndDate: $("#dtEndDate").val()
                }
            },
            columns: [
                {
                    "render": function (data, type, full, meta) {
                        return meta.row+1;
                    }
                },
                { data: "userName" },
                { data: "fullName" },
                { data: "changeBy" },
                { data: "changedOn" }
            ],
            colReorder: true

        });
    }
    $("#btnReset").click(function () {
        var date = new Date();
        var day = date.getDate();
        var month = date.getMonth() + 1;
        var year = date.getFullYear();
        if (month < 10) month = "0" + month;
        if (day < 10) day = "0" + day;
        var today = year + "-" + month + "-" + day;
        $('#dtStartDate').val(today);
        $('#dtEndDate').val(today);
        search();
    });
</script>
