@model List<AML.ViewModel.ViewModels.Report.DatasetUpdateLogsModel>
@{
    Layout = "~/Views/Shared/_PdfLayout.cshtml";
    ViewData["Title"] = "Dataset Update Logs";
    ViewData["Orientation"] = ViewBag.Orientation ?? "portrait";
}
<table>
    <thead>
        <tr>
            <th>Updated Date</th>
            <th>Dataset Name</th>
            <th>Delta</th>
            <th>Individual</th>
            <th>Corporate</th>
            <th>Cumulative</th>
            <th>Deleted</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@(DateTime.TryParse(item.UpdatedDate, out DateTime dtUpdate) ? dtUpdate.ToString("dd MMM yyyy") : item.UpdatedDate)</td>
                    <td>@item.Datasets</td>
                    <td>@item.Delta</td>
                    <td>@item.Individual</td>
                    <td>@item.Corporate</td>
                    <td>@item.Cumulative</td>
                    <td>@item.Deleted</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" style="text-align: center; color: #9CA3AF; padding: 20px;">No records found.</td>
            </tr>
        }
    </tbody>
</table>
