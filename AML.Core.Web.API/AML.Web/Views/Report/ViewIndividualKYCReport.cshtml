<style>
    .page {
        width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .head-section {
        display: flex;
        justify-content: space-between; /* Better than flex-start + auto margin */
        align-items: center;
        width: 100%;
        height: 72px;
        overflow-x: hidden;
        padding: 0 16px; /* Add horizontal padding if needed */
        box-sizing: border-box;
        background-color: white !important;
        border-bottom: 1px solid #dee2e6;
    }

    .card1 {
        max-width: 100%; /* Ensures it never overflows parent */
        border-radius: 8px;
        overflow: hidden; /* Contains all child elements */
        background-color: white !important;
        margin: 30px 30px;
        padding: 20px;
        box-shadow: 0 0 #0000, /* fallback ring-offset-shadow */
        0 0 #0000, /* fallback ring-shadow */
        0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1); /* typical shadow-md */
    }

    .heading {
        font-size: 1.25rem;
    }

    #printBtnDiv {
        display: flex;
        width: 90%;
        justify-content: flex-end;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .go {
        background-color: rgb(37,99,235);
        border-radius: 8px;
        padding: 8px 20px;
        color: white;
    }

    .clear {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 20px;
    }

    .form-group {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
    }

    .firstrow {
        display: flex;
        width: 100%; /* Full width of its parent */
    }

    .flex-item1 {
        flex: 1;
    }

        .flex-item1 input {
            width: 100%; /* full width of the parent */
            min-width: 40%;
            box-sizing: border-box; /* includes padding in the width */
            padding: 8px;
            border-radius: 4px; /* spacing between inputs */
        }

    input, select, textarea {
        border: 1px solid #dee2e6 !important;
        font-weight: lighter;
    }

        input:focus {
            border: 1px solid rgb(37,99,235) !important;
        }

        select:focus , textarea:focus {
            border: 1px solid rgb(37,99,235) !important;
        }

    select {
        font-weight: lighter;
    }

    form {
        width: 100%;
    }

    .flex-box {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        margin: 10px 0px;
    }

        .flex-box > .flex-item {
            flex: 1 1 250px !important;
            text-align: center !important;
        }

    .flex-item input, .flex-item textarea {
        width: 95%; /* full width of the parent */
        min-width: 40%;
        box-sizing: border-box; /* includes padding in the width */
        padding: 8px;
        border-radius: 4px; /* spacing between inputs */
    }

    .flex-box2 {
        display: flex;
        justify-content: space-between;
    }

    @@media (max-width: 768px) {
        .flex-box2 {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
    }

    @@media (max-width: 768px) {
        .page {
            width: 80vw;
        }
    }
</style>
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
</style>

