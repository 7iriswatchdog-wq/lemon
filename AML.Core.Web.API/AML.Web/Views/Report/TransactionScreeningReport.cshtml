<script type="text/javascript">

    $(document).ready(function () {

        LoadTable();

    });

    function LoadTable() {
        $('#filterTable').DataTable({
            "serverSide": true, "processing": true,
            ajax: {
                url: '/Report/TransactionCaseReportCustompagination',
                type: 'POST',
                data: function (d) {

                    d.startDate = $('#dtStartDate').val(),
                    d.endDate = $('#dtEndDate').val()

                }
            },
            columns: [
                 {
                    data: "view", "name": "View", "autoWidth": true,
                    "render": function (data, type, full, meta)
                    {
                        return '<a class="btn btn-info" href="/Report/ViewTransactionCaseDetails/' + full.tranrefno + '">@localizer["View"]</a>'; }

                    },

                   {
                    "data": "tranrefno", "name": "Tran Ref No", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.tranrefno;
                    }
                },


                //{
                //    "data": "createdon", "name": "Created On", "autoWidth": true,
                //    "render": function (data, type, row) {

                //         var createdDate = new Date(row.custCreatedOn);
                //        createdDate = createdDate.getMonth() + 1 + "/" + createdDate.getDate() + "/" + createdDate.getFullYear();
                //        return createdDate;
                //    }
                //},

                  {
                    "data": "caseCount", "name": "Case #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.caseCount;
                    }

               },
                 {
                    "data": "pending", "name": "Pending #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.pending;
                    }

               },
               {
                    "data": "approved", "name": "Approved #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.approved;
                    }

               },
               {
                    "data": "rejected", "name": "Rejected #", "autoWidth": true,
                    "render": function (data, type, row) {
                        return row.rejected;
                    }

               },
                { data: "createdOn" }


            ],
            error: function (e, message) {
                jQuery("#filterTable").dataTable({

                }),
                    alert(message);
            },

            destroy: true

        });
        if ($('#dtStartDate').val() == '0001-01-01') {
            $('#dtStartDate').val('');
            $('#dtEndDate').val('');
        }
    }

    function saveByteArray(reportName, byte) {
        var blob = new Blob([byte], {type: "application/pdf"});
        var link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        var fileName = reportName;
        link.download = fileName;
        link.click();
    };

    function ExportList(isPDF) {
        console.log('Get file from', `/Report/ExportCaseReport?${new URLSearchParams({
            createdByUserId: $('#CreatedByUserID').val(),
            updatedByUserId: $('#UpdatedByUserID').val(),
            startDate: $('#dtStartDate').val(),
            endDate: $("#dtEndDate").val(),
            status: $('#caseStatusID').val(),
            IsPDF: isPDF
        })}`)
        window.location = `/Report/ExportCaseReport?${new URLSearchParams({
            createdByUserId: $('#CreatedByUserID').val(),
            updatedByUserId: $('#UpdatedByUserID').val(),
            startDate: $('#dtStartDate').val(),
            endDate: $("#dtEndDate").val(),
            status: $('#caseStatusID').val(),
            IsPDF: isPDF
        })}`;
    }
    $("#btnReset").click(function () {
        var date = new Date();
        var day = date.getDate();
        var month = date.getMonth() + 1;
        var year = date.getFullYear();
        if (month < 10) month = "0" + month;
        if (day < 10) day = "0" + day;
        var today = year + "-" + month + "-" + day;
        var ddate = new Date(date.setDate(date.getDate() - 7));
        var day1 = ddate.getDate();
        var month1 = ddate.getMonth() + 1;
        var year1 = ddate.getFullYear();
        if (month1 < 10) month1 = "0" + month1;
        if (day1 < 10) day1 = "0" + day1;
        var stdate = year1 + "-" + month1 + "-" + day1;
        $('#dtStartDate').val(stdate);
        $('#dtEndDate').val(today);
        LoadTable();
    });
</script>
