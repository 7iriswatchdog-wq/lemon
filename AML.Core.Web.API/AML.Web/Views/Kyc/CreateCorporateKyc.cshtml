    document.addEventListener("DOMContentLoaded", function () {
        const maxShareholders = 5;
        const maxDocuments = 5;
        let shareholderIndex = 1;

        const shareholdersContainer = document.getElementById("shareholdersContainer");
        const baseShareholderCard = shareholdersContainer.querySelector(".shareholders-card");

        shareholdersContainer.addEventListener("click", function (e) {
            // Add Shareholder
            if (e.target.closest(".add-shareholder")) {
                const total = shareholdersContainer.querySelectorAll(".shareholders-card").length;
                if (total >= maxShareholders) {
                    toastr.error("Maximum of 5 shareholders allowed.");
                    return;
                }
                const clone = baseShareholderCard.cloneNode(true);
                resetInputs(clone);
                updateShareholderIndex(clone, shareholderIndex++);
                shareholdersContainer.appendChild(clone);
            }

            // Remove Shareholder
            if (e.target.closest(".remove-shareholder")) {
                const allCards = shareholdersContainer.querySelectorAll(".shareholders-card");
                if (allCards.length > 1) {
                    e.target.closest(".shareholders-card").remove();
                } else {
                    toastr.error("At least one shareholder is required.");
                }
            }

            // Add Document
            if (e.target.closest(".add-document")) {
                const card = e.target.closest(".shareholders-card");
                const docTable = card.querySelector(".document-upload-table");
                const currentDocs = docTable.querySelectorAll(".document-row");
                if (currentDocs.length >= maxDocuments) {
                    toastr.error("Maximum of 5 documents allowed.");
                    return;
                }

                const docIndex = currentDocs.length;
                const newDocRow = currentDocs[0].cloneNode(true);
                resetInputs(newDocRow);
                updateDocumentIndex(newDocRow, card, docIndex);
                docTable.appendChild(newDocRow);
            }

            // Remove Document
            if (e.target.closest(".remove-document")) {
                const row = e.target.closest(".document-row");
                const table = row.closest(".document-upload-table");
                const allRows = table.querySelectorAll(".document-row");
                if (allRows.length > 1) {
                    row.remove();
                } else {
                    toastr.error("At least one document is required.");
                }
            }
        });

        function resetInputs(container) {
            container.querySelectorAll("input").forEach(input => {
                if (input.type !== "file") input.value = "";
            });
        }

        function updateShareholderIndex(container, index) {
            container.querySelectorAll("[name]").forEach(el => {
                el.name = el.name.replace(/Shareholders\[\d+\]/g, `Shareholders[${index}]`);
            });

            container.querySelectorAll("input[type='file']").forEach((input, i) => {
                const newId = `upload_shareholder_${index}_${i}`;
                const label = container.querySelector(`label[for='${input.id}']`);
                if (label) label.setAttribute("for", newId);
                input.id = newId;
            });
        }

        function updateDocumentIndex(row, card, docIndex) {
            const input = card.querySelector("input[name^='Shareholders']");
            const match = input?.name?.match(/Shareholders\[(\d+)\]/);
            const shareholderIdx = match ? match[1] : "0";

            row.querySelectorAll("[name]").forEach(el => {
                el.name = el.name.replace(/Shareholders\[\d+\]\.Documents\[\d+\]/, `Shareholders[${shareholderIdx}].Documents[${docIndex}]`);
            });

            const uploadInput = row.querySelector("input[type='file']");
            if (uploadInput) {
                const newId = `upload_shareholder_${shareholderIdx}_${docIndex}`;
                uploadInput.id = newId;
                const label = row.querySelector("label[for]");
                if (label) label.setAttribute("for", newId);
            }
        }
    });
</script>

<script>
    // Initialize Drag-and-Drop for Shareholders
    document.addEventListener("DOMContentLoaded", function () {
        const shareholdersContainer = document.getElementById("shareholdersContainer");
        
        if (shareholdersContainer) {
            const sortable = new Sortable(shareholdersContainer, {
                handle: '.shareholder-drag-handle',  // Only drag by the handle
                animation: 150,  // Smooth animation in ms
                ghostClass: 'shareholder-ghost',  // Class for placeholder
                chosenClass: 'shareholder-chosen',  // Class when item is selected
                dragClass: 'shareholder-drag',  // Class while dragging
                
                // Callback after reordering
                onEnd: function (evt) {
                    // Reindex all shareholders after drag-and-drop
                    reindexShareholders();
                }
            });
            
            // Function to update all shareholder array indices
            function reindexShareholders() {
                const cards = shareholdersContainer.querySelectorAll('.shareholders-card');
                
                cards.forEach((card, index) => {
                    // Update all form fields within this card
                    card.querySelectorAll('[name]').forEach(el => {
                        // Replace Shareholders[oldIndex] with Shareholders[newIndex]
                        el.name = el.name.replace(/Shareholders\[\d+\]/, `Shareholders[${index}]`);
                    });
                    
                    // Update file input IDs and their associated labels
                    const fileInputs = card.querySelectorAll('input[type="file"]');
                    fileInputs.forEach((input, docIndex) => {
                        const oldId = input.id;
                        const newId = `upload_shareholder_${index}_${docIndex}`;
                        
                        // Update input ID
                        input.id = newId;
                        
                        // Update associated label if it exists
                        const label = card.querySelector(`label[for="${oldId}"]`);
                        if (label) {
                            label.setAttribute('for', newId);
                        }
                    });
                    
                    // Update hidden fields and specific IDs
                    const nationalitySelect = card.querySelector('select[name*="Nationality"]');
                    if (nationalitySelect) {
                        nationalitySelect.name = `Shareholders[${index}].Nationality`;
                    }
                    
                    const nationalityHidden = card.querySelector('input[type="hidden"][id^="nationality_"]');
                    if (nationalityHidden) {
                        nationalityHidden.id = `nationality_${index}`;
                    }
                    
                    const emiratesId = card.querySelector('input[id^="emirates_id_"]');
                    if (emiratesId) {
                        emiratesId.id = `emirates_id_${index}`;
                    }
                    
                    const expiryDate = card.querySelector('input[id^="expiry_date_"]');
                    if (expiryDate) {
                        expiryDate.id = `expiry_date_${index}`;
                    }
                    
                    const passportNumber = card.querySelector('input[id^="passport_number_"]');
                    if (passportNumber) {
                        passportNumber.id = `passport_number_${index}`;
                    }
                    
                    const passportExpiry = card.querySelector('input[id^="passport_expiry_"]');
                    if (passportExpiry) {
                        passportExpiry.id = `passport_expiry_${index}`;
                    }
                });
                
                console.log('Shareholders reindexed after drag-and-drop');
            }
        }
    });
</script>


