    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }

    /* Drag-and-Drop Styles for Shareholders */
    .shareholder-drag-handle {
        cursor: move;
        padding: 0.5rem;
        transition: color 0.2s ease;
    }

    .shareholder-drag-handle:hover {
        color: #1e40af;
    }

    .shareholder-ghost {
        opacity: 0.4;
        background: #f0f9ff;
        border: 2px dashed #3b82f6;
    }

    .shareholder-drag {
        opacity: 1;
        transform: rotate(2deg);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        cursor: grabbing;
    }

    .shareholder-chosen {
        background: #eff6ff;
        border-color: #3b82f6;
    }

    .shareholders-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
</style>
