                if (allRows.length > 1) {
                    row.remove();
                } else {
                    toastr.error('@localizer["Atleast One Document is Required"]', {
                tapToDismiss: true, showMethod: 'fadeIn', showDuration: 200
            });
                }
            }
        });

        // Reset input fields
