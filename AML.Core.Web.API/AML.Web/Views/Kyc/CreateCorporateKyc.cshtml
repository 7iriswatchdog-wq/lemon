            container.querySelectorAll("input").forEach(input => {
                if (input.type === "file") return;
                input.value = "";
            });
        }

        // Update the indexes in name attributes for management entries
        function updateManagementIndex(container, index) {
            container.querySelectorAll("[name]").forEach(el => {
                el.name = el.name.replace(/SeniorManagements\[\d+\]/, `SeniorManagements[${index}]`);
            });

            container.querySelectorAll("input[type='file']").forEach((input, i) => {
                const newId = `upload_${index}_${i}`;
                input.id = newId;
                const label = container.querySelector(`label[for='${input.id}']`);
                if (label) label.setAttribute("for", newId);
            });
        }

        // Update document index inside a management entry
        function updateDocumentIndex(row, card, docIndex) {
            const managementNameMatch = card.querySelector("input, select").name.match(/SeniorManagements\[(\d+)\]/);
            const mgmtIndex = managementNameMatch ? managementNameMatch[1] : "0";

            row.querySelectorAll("[name]").forEach(el => {
