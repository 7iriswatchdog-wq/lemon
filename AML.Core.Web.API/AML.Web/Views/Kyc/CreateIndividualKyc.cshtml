            divStr1 += "<button class='bg-[#2563EB] text-white text-sm px-4 py-2.5 rounded-lg flex items-center gap-2 hover:bg-primary transition-colors DelCorporate '   type = 'button'  id = 'btnCorpDel_" + corpDivIndexVal + "' onclick = 'removeDocument(" + corpDivIndexVal + ")'> Remove</button>";
            divStr1 += "</div></div>";

            //corpDiv.innerHTML = divStr4 + divstr2 + divstr3 + divstr5 + divStr1 ;
            corpDiv.innerHTML = divStr4 + divstr2 + divstr3 + divstr5 + divStr1;

            var div = document.getElementById('corporateBodyDiv');
            div.appendChild(corpDiv);
            $('#corpDivIndex').val(parseInt(corpDivIndexVal) + 1);
            var d = new Date(),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;

            var dateToday = year + '-' + month + '-' + day;
            $("#txtAccomplishedDate_" + corpDivIndexVal).val(dateToday);
        } else {
            //alert("Maximum number of Corporates is 5")
            toastr.error('@localizer["Cannot add more than 5 Documents."]', {
                tapToDismiss: true, showMethod: 'fadeIn', showDuration: 200
            });
        }
        createTable(corpDivIndexVal);
        addListRow(corpDivIndexVal);
        var CorpCount = $('.Corporate:visible').length;
        if (CorpCount > 1) {
            $('.DelCorporate').show();
        }
    }
    function removeDocument(i) {
        $('#corporateDiv_' + i).remove();
    }
    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    })
</script>

@* for the cancel  *@
<script>
    function showLoadingAndRedirect(event, element) {
        event.preventDefault(); // Prevent default anchor action
        document.getElementById("loadingeffect").style.display = "flex"; // Show loader

        // Optional: wait a bit before redirecting (for loader visibility)
        setTimeout(() => {
            window.location.href = element.getAttribute("href");
        }, 300); // 300ms delay for smooth transition
    }
</script>
