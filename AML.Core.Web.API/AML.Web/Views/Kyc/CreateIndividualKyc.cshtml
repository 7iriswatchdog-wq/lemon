@using AML.Web.Helpers;
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor

@{
    var culture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name.ToLowerInvariant();

    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
        var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
        var userModules = HttpContextAccessor.HttpContext.Session.GetString("SessModules");
	var allowedModules = new List<int>();
	 if (!string.IsNullOrEmpty(userModules))
    {
        var modules = JsonConvert.DeserializeObject<List<dynamic>>(userModules);
        allowedModules = modules.Select(m => (int)m.Menu_Id).ToList();
    }

}
