<script type="text/javascript">
    document.getElementById('textInput').value = 70
    //function updateTextInput(val) {
    //    document.getElementById('textInput').value = val;
    //}

    function alphaNumericCheck(e) {
        var key = e.keyCode;
        if (!(key > 47 && key < 58) && !(key > 64 && key < 91) && !(key > 96 && key < 123)) {
            if (key == 34 || key == 32) {

            } else {
                e.preventDefault();
            }
        }
    }


    $('#ddlCountryList').change(function () {
        $('#nationality').val($('#ddlCountryList :selected').text());

    });
    $('#btnSubmit').click(function () {
        // $('.se-pre-con').show();
        // $('.se-pre-con').fadeOut(10000);
        $('#loadingeffect').show();
        // $('#loadingeffect').hide();
    });
    function alphaCheck(e) {
        var key = e.keyCode;
        if (!(key > 64 && key < 91) && !(key > 96 && key < 123)) {
            if (key == 34 || key == 32) {

            } else {
                e.preventDefault();
            }
        }
    }
    $('#ddlOccupation').change(function () {
        if ($('#ddlOccupation :selected').text() == "Other") {
            var x = document.getElementById('OccupOther');

            x.style.display = "";
            $('#ddlFundSourcehdn').val('');
        }
        else {
            var x = document.getElementById('OccupOther');
            x.style.display = "none";

            $('#ddlFundSourcehdn').val($('#ddlOccupation :selected').text());
        }
    });

    function isNumber(e) {
        var charCode = e.keyCode;
       
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
             e.preventDefault();
            return false;
           
        }
        else
            return true;
    }

    $(document).ready(function () {
        $(document).find("input[type=text]").val('');
        $(document).find("input[type=number]").val('');
        $('#ResidenceAddress').val('');
        $('#EmployerAddress').val('');
        $(document).find("select").val('0');
        $('#ddlIdType').val('Emirates ID');
        $('#ddlResidenceStatus').val('Resident');
    });
    function dobOnChange() {
        $('#hdnDOB').val($('#DOB').val());
        var dateString = $('#hdnDOB').val();
        var age = getAge(dateString);
        if (age < 18) {
            var x = document.getElementById('divGuardian');
            x.style.display = "block";
            $('#GuardianName').prop("required", true);
            $('#GuardianRelation').prop("required", true);
        }
        else {
            var x = document.getElementById('divGuardian');
            x.style.display = "none";
            $('#GuardianName').prop("required", false);
            $('#GuardianRelation').prop("required", false);
        }
    }
    function getAge(dateString) {
        var today = new Date();
        var birthDate = new Date(dateString);
        var age = today.getFullYear() - birthDate.getFullYear();
        var m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }
        return age;
    }
    $(document).ready(function () {
        $("#textInput").val("70");
    });

    function updateTextInput(val) {
        document.getElementById('textInput').value = val;
    }
</script>
