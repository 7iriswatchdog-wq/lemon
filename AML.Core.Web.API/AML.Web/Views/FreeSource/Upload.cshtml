
@{
    ViewData["Title"] = Model.Source + " Data Uplaod";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

@model AML.ViewModel.ViewModels.FreeSource.FreeSourceModel

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Uplaod @Model.Source</h3>
    </div>
    <!-- /.card-header -->
    <!-- form start -->
    <form role="form" asp-controller="FreeSource" asp-action="Upload" class="form-horizontal" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Source" />
        <input type="hidden" asp-for="CreatedBy" />
        <div class="card-body">
            <div class="form-group">
                <label for="fileUpload">Code</label>
                <input type="file" asp-for="Document.fileUpload" class="form-control-file" id="fileUpload" placeholder="Source Documnet">
                <span asp-validation-for="Document.fileUpload" class="text-danger"></span>
                <span asp-validation-for="Document" class="text-danger"></span>
            </div>
        </div>
        <!-- /.card-body -->

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Uplaod</button>
            <button type="button" class="btn btn-danger" onclick="location.href='@Url.Action("Index", "FreeSource")'">Cancel</button>
        </div>
    </form>
</div>

