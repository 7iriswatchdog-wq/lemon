@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Branch";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
     var Clientlogo= HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

@model AML.ViewModel.ViewModels.Branch.BranchModel
@*@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
<meta name="csrf-token" content="@antiforgery.GetAndStoreTokens(Context).RequestToken" />*@
<script src="~/plugins/jquery/jquery.min.js"></script>
<style>
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

        .dt-loader div {
            position: absolute;
            top: 8px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #2563eb;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .dt-loader div:nth-child(1) {
                left: 8px;
                animation: dt-anim1 0.6s infinite;
            }

            .dt-loader div:nth-child(2) {
                left: 8px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(3) {
                left: 32px;
                animation: dt-anim2 0.6s infinite;
            }

            .dt-loader div:nth-child(4) {
                left: 56px;
                animation: dt-anim3 0.6s infinite;
            }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
    @@media (max-width: 768px) {
        .page {
            width: 79vw;
        }
    }
</style>

<section class="content">
    @* <nav class="border-b">
        <div class="flex flex-row items-center justify-between w-full h-full md:p-5 p-5">
            <div>
                <h2 class="text-2xl font-bold">Add New</h2>
            </div>
            <div class="md:block hidden">
                Client Logo
            </div>
        </div>
    </nav> *@
    <nav class="flex items-center px-4 h-[72.8px] border-b w-full bg-surface">
        <div class="flex items-center justify-between w-full">
            <!-- Title -->
            <h2 class="text-base md:text-xl font-bold whitespace-nowrap overflow-hidden text-ellipsis">
                Add New
            </h2>

            <!-- Right-side content -->
            <div class="text-sm md:text-base text-right">
                <img src="@Clientlogo" alt="Client Logo" width="50px" />
            </div>
        </div>
    </nav>
    <div class="h-full bg-gray-50 items-center ">
        <div id="loader" class="fixed inset-0 bg-surface bg-opacity-75 flex items-center justify-center z-10" style="display:none;">
            <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
        </div>
        <div class="grid md:grid-cols-1 grid-cols-1 justify-center items-center md:p-8 p-4 md:gap-6 gap-4  mx-auto">
    @*<div class="custom-container">
        <div class="sas-breadcrumbs aml-breadcrumbs mt-2">
            <ul class="mb-0 pl-0 d-flex">
                <li><a href="#">Home</a></li>/
                <li><a href="#">Form Model</a></li>
            </ul>
        </div>
        <div class="page-heading">
            <div class="sas-card rounded-card br-10 mb-2 bg-blue">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><b>Add New</b></h4>
                    <div class="menu-icon">
                        <i class="lni lni-microsoft"></i>
                    </div>
                </div>
            </div>
        </div>*@

        <!-- /.card-header -->
        <!-- form start -->
            <div class="sas-card rounded-card w-full bg-surface rounded-xl shadow-sm p-8 overflow-hidden border border-blue-100">
            
        <form role="form" asp-controller="Branch" asp-action="Create" class="form-horizontal" enctype="multipart/form-data" method="post">
                  
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="IsActive"/>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                <div class="form-group col-md-4">
                            <label for="txtCode" class="form-label block text-sm font-medium text-gray-700 mb-1">Code <span class="text-danger text-red-500 text-sm">*</span></label>
                            <input type="text" asp-for="Code" class="form-control w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="txtCode" placeholder="Enter code">
                            <span asp-validation-for="Code" class="text-danger text-red-500 text-sm"></span>
                </div>
                <div class="form-group col-md-4">
                            <label for="txtName" class="form-label block text-sm font-medium text-gray-700 mb-1">Name <span class="text-danger text-red-500 text-sm">*</span></label>
                            <input type="text" asp-for="Name" class="form-control w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="txtName" placeholder="Name" maxlength="100">
                            <span asp-validation-for="Name" class="text-danger text-red-500 text-sm"></span>
                </div>
                <div class="form-group col-md-4">
                            <label for="txtDescription" class="form-label block text-sm font-medium text-gray-700 mb-1">Description</label>
                            <input type="text" asp-for="Description" class="form-control w-full px-3 py-2 border border-gray-300 rounded-md font-extralight" id="txtDescription" placeholder="Description">
                </div>
            </div>
            <!-- /.card-body -->

            <div class="flex flex-col md:flex-row justify-center mt-10 gap-4">
                            <button type="submit" class="h-10 w-10 inline-flex items-center justify-center bg-[#2563EB] text-white rounded-md hover:bg-primary-hover" title="Submit" aria-label="Submit"><i class="fas fa-check"></i></button>
                            <button type="button" class="h-10 w-10 inline-flex items-center justify-center border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100 transition duration-200" onclick=" $('#loader').show(); location.href='@Url.Action("Index","Branch")'" title="Cancel" aria-label="Cancel"><i class="fas fa-times"></i></button>
                </div>
            

        </form>
            </div>
