@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model List<AML.ViewModel.ViewModels.Common.ClientMaster>

@{
    ViewData["Title"] = "Admin Management";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
    }

    .dt-loader {
        position: relative;
        width: 80px;
        height: 20px;
    }

    .dt-loader div {
        position: absolute;
        top: 8px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: #2563eb;
        animation-timing-function: cubic-bezier(0,1,1,0);
    }

    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }

    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }

    th.sortable {
        cursor: pointer;
        position: relative;
        padding-right: 20px;
    }

    th.sortable::after {
        content: "▲\A▼";
        white-space: pre;
        font-size: 10px;
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        color: #bbb;
        line-height: 1;
        text-align: center;
    }

    th.sortable.active.asc::after { content: "▲"; color: #2563eb; }
    th.sortable.active.desc::after { content: '\A▼'; color: #2563eb; }
</style>

<div id="loader" class="fixed inset-0 bg-white bg-opacity-75 items-center justify-center z-50 hidden">
    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
</div>

<div class="bg-slate-50 min-h-screen text-slate-900">
    <div class="p-8 space-y-8 max-w-[1600px] mx-auto">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Admin Management</h1>
                <p class="text-slate-500 text-sm mt-1">Manage and configure client organizations and their security parameters.</p>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <a href="@Url.Action("Add", "Client")"
                   class="bg-blue-600 hover:bg-blue-700 text-white font-bold h-10 px-5 rounded-md flex items-center gap-2 transition-colors text-sm shadow-sm">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    Add New Client
                </a>
            </div>
        </div>

        <!-- Table Section -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
                <!-- Search wrapper -->
                <div class="relative flex-1 w-full">
                    <i data-lucide="search" class="absolute left-3.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-slate-400"></i>
                    <input type="text"
                           id="searchInput"
                           placeholder="Search"
                           class="pl-10 h-11 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm
                                  ring-offset-white focus-visible:outline-none focus-visible:ring-2
                                  focus-visible:ring-blue-500/20 focus-visible:border-blue-500
                                  shadow-sm transition-all placeholder:text-slate-500">
                </div>
                <!-- Filter Options -->
                <div class="relative w-40">
                    <select id="subStatusFilter" class="h-11 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/20 focus-visible:border-blue-500">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
                <div class="relative w-40">
                    <select id="isBlockedFilter" class="h-11 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/20 focus-visible:border-blue-500">
                        <option value="">All Blocked</option>
                        <option value="1">Unblocked</option>
                        <option value="0">Blocked</option>
                    </select>
                </div>
                <!-- Export Option -->
                <button onclick="exportTableToCSV('clients.csv')" class="h-11 px-4 inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md transition-colors border border-slate-200">
                    <i data-lucide="download" class="h-4 w-4"></i> Export
                </button>
                <button onclick="resetFilters()" class="h-11 px-4 inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md transition-colors border border-slate-200">
                    <i data-lucide="rotate-ccw" class="h-4 w-4"></i> Reset
                </button>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="text-[10px] text-slate-500 uppercase bg-slate-50/50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-4 font-bold h-12 sortable" onclick="sortTable(0, this)">Client ID</th>
                                <th class="px-6 py-4 font-bold h-12 sortable" onclick="sortTable(1, this)">Client Name</th>
                                <th class="px-6 py-4 font-bold h-12 sortable" onclick="sortTable(2, this)">Prefix</th>
                                <th class="px-6 py-4 font-bold h-12">Users</th>
                                <th class="px-6 py-4 font-bold h-12">Limit</th>
                                <th class="px-6 py-4 font-bold h-12">Expiry Date</th>
                                <th class="px-6 py-4 font-bold h-12">Status</th>
                                <th class="px-6 py-4 font-bold h-12">Blocked</th>
                                <th class="px-6 py-4 font-bold h-12 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="clientsTableBody" class="divide-y divide-slate-100" style="font-size: 12px;">
                            <!-- Rows will be injected here -->
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Show</label>
                            <select id="pageSize" onchange="changePageSize()"
                                    class="h-8 w-20 rounded-md border border-slate-200 bg-white pl-3 pr-8 text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="h-4 w-px bg-slate-200"></div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                            Showing <span id="showingStart" class="text-slate-900">0</span> - <span id="showingEnd" class="text-slate-900">0</span> 
                            <span class="mx-1 text-slate-300">of</span> 
                            <span id="totalRecords" class="text-slate-900">0</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <button id="prevBtn" onclick="previousPage()"
                                class="h-8 px-4 flex items-center gap-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                            <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i>
                            Previous
                        </button>
                        <button id="nextBtn" onclick="nextPage()"
                                class="h-8 px-4 flex items-center gap-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                            Next
                            <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let pageSize = 10;
    let currentPage = 1;
    let totalRecords = 0;
    let orderColumn = 0;
    let orderDirection = 'desc';
    let drawCounter = 1;

    $(document).ready(function () {
        lucide.createIcons();
        loadData();

        $('#searchInput').on('input', function() {
            currentPage = 1;
            loadData();
        });

        $('#subStatusFilter, #isBlockedFilter').on('change', function() {
            currentPage = 1;
            loadData();
        });
    });

    function resetFilters() {
        $('#searchInput').val('');
        $('#subStatusFilter').val('');
        $('#isBlockedFilter').val('');
        currentPage = 1;
        loadData();
    }

    function exportTableToCSV(filename) {
        // We will fetch all data from backend for export to get the complete dataset
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            url: '/adminmanagement/custompagination',
            type: 'POST',
            data: {
                draw: 1,
                start: 0,
                length: -1, // Fetch all records for export if supported, otherwise just current total
                orderColumn: orderColumn,
                orderDirection: orderDirection,
                search: { value: $('#searchInput').val() },
                subStatus: $('#subStatusFilter').val(),
                isBlocked: $('#isBlockedFilter').val()
            },
            success: function (resp) {
                let csv = [];
                let headers = ['Client ID', 'Client Name', 'Prefix', 'Users', 'Limit', 'Usage', 'Expiry', 'Status'];
                csv.push(headers.join(','));
                
                resp.data.forEach(row => {
                    const expDate = row.applicationEndDate ? new Date(row.applicationEndDate).toLocaleDateString('en-GB') : '-';
                    const isExpired = row.applicationEndDate ? new Date(row.applicationEndDate).setHours(0, 0, 0, 0) < new Date().setHours(0, 0, 0, 0) : false;
                    
                    let stat = isExpired ? 'Expired' : 'Active';
                    let r = [
                        row.clientId,
                        `"${(row.clientName || '').replace(/"/g, '""')}"`,
                        `"${(row.prefix || '').replace(/"/g, '""')}"`,
                        row.userCount || 0,
                        row.searchCount || 0,
                        row.usageCount || 0,
                        expDate,
                        stat
                    ];
                    csv.push(r.join(','));
                });
                
                let csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
                let downloadLink = document.createElement('a');
                downloadLink.download = filename;
                downloadLink.href = window.URL.createObjectURL(csvFile);
                downloadLink.style.display = 'none';
                document.body.appendChild(downloadLink);
                downloadLink.click();
                document.body.removeChild(downloadLink);
            },
            complete: function() {
                $('#loader').addClass('hidden').removeClass('flex');
            }
        });
    }

    function sortTable(columnIndex, element) {
        $('.sortable').removeClass('active asc desc');
        if (orderColumn === columnIndex) {
            orderDirection = orderDirection === 'asc' ? 'desc' : 'asc';
        } else {
            orderColumn = columnIndex;
            orderDirection = 'asc';
        }
        $(element).addClass('active ' + orderDirection);
        loadData();
    }

    function loadData() {
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            url: '/adminmanagement/custompagination',
            type: 'POST',
            data: {
                draw: drawCounter++,
                start: (currentPage - 1) * pageSize,
                length: pageSize,
                orderColumn: orderColumn,
                orderDirection: orderDirection,
                search: { value: $('#searchInput').val() },
                subStatus: $('#subStatusFilter').val(),
                isBlocked: $('#isBlockedFilter').val()
            },
            success: function (resp) {
                if (resp.error) {
                    $('#clientsTableBody').empty().append('<tr><td colspan="4" class="h-24 text-center text-red-500">Error: ' + resp.error + '</td></tr>');
                    return;
                }
                renderTable(resp.data);
                totalRecords = resp.recordsFiltered;
                updatePagination();
            },
            complete: function () { 
                $('#loader').addClass('hidden').removeClass('flex'); 
            },
            error: function (xhr) { 
                $('#clientsTableBody').empty().append('<tr><td colspan="4" class="h-24 text-center text-red-500">HTTP Error: ' + xhr.status + ' ' + xhr.statusText + '</td></tr>');
            }
        });
    }

    function renderTable(data) {
        const tbody = $('#clientsTableBody').empty();
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="4" class="h-24 text-center text-slate-500">No client records found.</td></tr>');
            return;
        }

        data.forEach(row => {
            const expDate = row.applicationEndDate ? new Date(row.applicationEndDate).toLocaleDateString('en-GB') : '-';
            const isExpired = row.applicationEndDate ? new Date(row.applicationEndDate).setHours(0, 0, 0, 0) < new Date().setHours(0, 0, 0, 0) : false;
            
            let statusBadge = '';
            if (isExpired) {
                statusBadge = '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700"><span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-1.5"></span>Expired</span>';
            } else {
                statusBadge = '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700"><span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span>Active</span>';
            }
            
            let blockedIcon = row.isActive === 0 
                ? '<i data-lucide="lock" class="h-4 w-4 text-red-500" title="Blocked"></i>' 
                : '<i data-lucide="unlock" class="h-4 w-4 text-green-500" title="Active"></i>';

            tbody.append(`
                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 font-medium text-slate-600">${row.clientId}</td>
                    <td class="px-6 py-4">
                        <a href="/adminmanagement/details/${row.clientId}" class="text-blue-600 font-bold hover:underline transition-all">
                            ${row.clientName}
                        </a>
                    </td>
                    <td class="px-6 py-4 text-slate-600">${row.prefix || '-'}</td>
                    <td class="px-6 py-4 text-slate-600 font-medium">${row.userCount || 0}</td>
                    <td class="px-6 py-4 text-slate-600 font-medium">${row.searchCount || 0}</td>
                    <td class="px-6 py-4 text-slate-600">${expDate}</td>
                    <td class="px-6 py-4">${statusBadge}</td>
                    <td class="px-6 py-4 cursor-pointer">
                        <div class="flex justify-center items-center">
                            ${blockedIcon}
                        </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <a href="/adminmanagement/details/${row.clientId}" 
                               class="inline-flex items-center gap-1 text-blue-600 font-bold text-xs hover:bg-blue-50 px-3 py-1.5 rounded-md transition-colors border border-slate-200 bg-white shadow-sm hover:border-blue-100" title="Manage Client">
                                <i data-lucide="settings-2" class="h-3.5 w-3.5"></i>
                                Manage
                            </a>
                        </div>
                    </td>
                </tr>
            `);
        });
        lucide.createIcons();
    }

    function updatePagination() {
        const start = totalRecords === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);
    }

    function goToPage(page) {
        currentPage = page;
        loadData();
    }

    function previousPage() {
        if (currentPage > 1) goToPage(currentPage - 1);
    }

    function nextPage() {
        if (currentPage * pageSize < totalRecords) goToPage(currentPage + 1);
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        loadData();
    }
</script>
