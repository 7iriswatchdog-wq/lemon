@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model List<AML.ViewModel.ViewModels.Common.ClientMaster>

@{
    ViewData["Title"] = "Admin Management";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
    }

    .dt-loader {
        position: relative;
        width: 80px;
        height: 20px;
    }

    .dt-loader div {
        position: absolute;
        top: 8px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: #2563eb;
        animation-timing-function: cubic-bezier(0,1,1,0);
    }

    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }

    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }

    th.sortable {
        cursor: pointer;
        position: relative;
        padding-right: 20px;
    }

    th.sortable::after {
        content: "▲\A▼";
        white-space: pre;
        font-size: 10px;
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        color: #bbb;
        line-height: 1;
        text-align: center;
    }

    th.sortable.active.asc::after { content: "▲"; color: #2563eb; }
    th.sortable.active.desc::after { content: '\A▼'; color: #2563eb; }
</style>

<div id="loader" class="fixed inset-0 bg-white bg-opacity-75 items-center justify-center z-50 hidden">
    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
</div>

<div class="bg-slate-50 min-h-screen text-slate-900">
    <div class="p-8 space-y-8 max-w-[1600px] mx-auto">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Admin Management</h1>
                <p class="text-slate-500 text-sm mt-1">Manage and configure client organizations and their security parameters.</p>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <a href="@Url.Action("Add", "Client")"
                   class="bg-blue-600 hover:bg-blue-700 text-white font-bold h-10 px-5 rounded-md flex items-center gap-2 transition-colors text-sm shadow-sm">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    Add New Client
                </a>
            </div>
        </div>

        <!-- Table Section -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
                <!-- Search wrapper -->
                <div class="relative flex-1 w-full">
                    <i data-lucide="search" class="absolute left-3.5 top-1/2 transform -translate-y-1/2 h-4 w-4 text-slate-400"></i>
                    <input type="text"
                           id="searchInput"
                           placeholder="Search by Client ID, Name, or Prefix..."
                           class="pl-10 h-11 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm
                                  ring-offset-white focus-visible:outline-none focus-visible:ring-2
                                  focus-visible:ring-blue-500/20 focus-visible:border-blue-500
                                  shadow-sm transition-all placeholder:text-slate-500">
                </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="text-[10px] text-slate-500 uppercase bg-white border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-4 font-small h-12 sortable" onclick="sortTable(0, this)">Client ID</th>
                                <th class="px-6 py-4 font-small h-12 sortable" onclick="sortTable(1, this)">Client Name</th>
                                <th class="px-6 py-4 font-small h-12 sortable" onclick="sortTable(2, this)">Prefix</th>
                                <th class="px-6 py-4 font-small h-12 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="clientsTableBody" class="divide-y divide-slate-100" style="font-size: 12px;">
                            <!-- Rows will be injected here -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="flex items-center justify-between px-6 py-4 border-t border-slate-200">
                    <div class="flex items-center gap-2 text-sm">
                        <select id="pageSize"
                                class="h-8 rounded-md border border-slate-200 bg-white px-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20"
                                onchange="changePageSize()">
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <label class="text-slate-600 font-medium">Entries per page</label>
                    </div>
                    <div class="text-sm text-slate-500">
                        Showing <span id="showingStart" class="font-medium text-slate-900">0</span> to <span id="showingEnd" class="font-medium text-slate-900">0</span> of <span id="totalRecords" class="font-medium text-slate-900">0</span> clients
                    </div>
                    <div class="flex items-center space-x-2">
                        <button id="prevBtn" onclick="previousPage()"
                                class="h-8 px-3 text-sm font-medium border border-slate-200 bg-white rounded-md text-slate-700 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-50 transition-colors">
                            Previous
                        </button>
                        <div id="pageNumbers" class="flex gap-1"></div>
                        <button id="nextBtn" onclick="nextPage()"
                                class="h-8 px-3 text-sm font-medium border border-slate-200 bg-white rounded-md text-slate-700 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-50 transition-colors">
                            Next
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let pageSize = 10;
    let currentPage = 1;
    let totalRecords = 0;
    let orderColumn = 0;
    let orderDirection = 'desc';
    let drawCounter = 1;

    $(document).ready(function () {
        lucide.createIcons();
        loadData();

        $('#searchInput').on('input', function() {
            currentPage = 1;
            loadData();
        });
    });

    function sortTable(columnIndex, element) {
        $('.sortable').removeClass('active asc desc');
        if (orderColumn === columnIndex) {
            orderDirection = orderDirection === 'asc' ? 'desc' : 'asc';
        } else {
            orderColumn = columnIndex;
            orderDirection = 'asc';
        }
        $(element).addClass('active ' + orderDirection);
        loadData();
    }

    function loadData() {
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            url: '/adminmanagement/custompagination',
            type: 'POST',
            data: {
                draw: drawCounter++,
                start: (currentPage - 1) * pageSize,
                length: pageSize,
                orderColumn: orderColumn,
                orderDirection: orderDirection,
                search: { value: $('#searchInput').val() }
            },
            success: function (resp) {
                renderTable(resp.data);
                totalRecords = resp.recordsFiltered;
                updatePagination();
            },
            complete: function () { 
                $('#loader').addClass('hidden').removeClass('flex'); 
            },
            error: function () { 
                alert('Error loading client data'); 
            }
        });
    }

    function renderTable(data) {
        const tbody = $('#clientsTableBody').empty();
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="4" class="h-24 text-center text-slate-500">No client records found.</td></tr>');
            return;
        }

        data.forEach(row => {
            tbody.append(`
                <tr class="bg-white border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 font-medium text-slate-600">${row.clientId}</td>
                    <td class="px-6 py-4">
                        <a href="/adminmanagement/details/${row.clientId}" class="text-blue-600 font-bold hover:underline transition-all">
                            ${row.clientName}
                        </a>
                    </td>
                    <td class="px-6 py-4 text-slate-600">${row.prefix || '-'}</td>
                    <td class="px-6 py-4 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <a href="/adminmanagement/details/${row.clientId}" 
                               class="inline-flex items-center gap-1 text-blue-600 font-bold text-xs hover:bg-blue-50 px-3 py-1.5 rounded-md transition-colors border border-slate-200 bg-white shadow-sm hover:border-blue-100" title="Manage Client">
                                <i data-lucide="settings-2" class="h-3.5 w-3.5"></i>
                                Manage
                            </a>
                            <a href="/Client/ClientRight/${row.clientId}" 
                               class="h-8 w-8 flex items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 hover:text-indigo-600 hover:border-indigo-100 hover:bg-indigo-50 transition-all shadow-sm" title="Client Rights">
                                <i data-lucide="shield-check" class="h-3.5 w-3.5"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            `);
        });
        lucide.createIcons();
    }

    function updatePagination() {
        const start = totalRecords === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', end >= totalRecords);

        renderPageNumbers();
    }

    function renderPageNumbers() {
        const totalPages = Math.ceil(totalRecords / pageSize);
        const container = $('#pageNumbers').empty();
        if (totalPages <= 1) return;

        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = Math.min(totalPages, startPage + maxVisible - 1);

        if (endPage - startPage + 1 < maxVisible) {
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            container.append(`
                <button onclick="goToPage(${i})" 
                        class="h-8 w-8 flex items-center justify-center text-sm font-medium border rounded-md transition-all
                        ${i === currentPage ? 'bg-blue-600 text-white border-blue-600' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'}">
                    ${i}
                </button>
            `);
        }
    }

    function goToPage(page) {
        currentPage = page;
        loadData();
    }

    function previousPage() {
        if (currentPage > 1) goToPage(currentPage - 1);
    }

    function nextPage() {
        if (currentPage * pageSize < totalRecords) goToPage(currentPage + 1);
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSize').val());
        currentPage = 1;
        loadData();
    }
</script>
