@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AML.ViewModel.ViewModels.Common.ClientMaster
@{
    ViewData["Title"] = "Admin Management - Details";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
    int clientId = ViewBag.ClientId;
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body { font-family: 'Inter', sans-serif; }
    .dt-loader { position: relative; width: 80px; height: 20px; }
    .dt-loader div { position: absolute; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #2563eb; animation-timing-function: cubic-bezier(0,1,1,0); }
    .dt-loader div:nth-child(1) { left: 8px; animation: dt-anim1 0.6s infinite; }
    .dt-loader div:nth-child(2) { left: 8px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(3) { left: 32px; animation: dt-anim2 0.6s infinite; }
    .dt-loader div:nth-child(4) { left: 56px; animation: dt-anim3 0.6s infinite; }
    @@keyframes dt-anim1 { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    @@keyframes dt-anim2 { 0% { transform: translateX(0); } 100% { transform: translateX(24px); } }
    @@keyframes dt-anim3 { 0% { transform: scale(1); } 100% { transform: scale(0); } }

    th.sortable { cursor: pointer; position: relative; padding-right: 20px; }
    th.sortable::after {
        content: "▲\A▼";
        white-space: pre;
        font-size: 10px;
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        color: #bbb;
        line-height: 1;
        text-align: center;
    }
    th.sortable.active.asc::after { content: "▲"; color: #2563eb; }
    th.sortable.active.desc::after { content: '\A▼'; color: #2563eb; }
</style>

<div id="loader" class="fixed inset-0 bg-white bg-opacity-75 items-center justify-center z-50 hidden">
    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
</div>

<div class="bg-slate-50 min-h-screen text-slate-900">
    <div class="p-8 space-y-8 max-w-[1600px] mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <div class="flex items-center gap-2 text-slate-500 text-xs mb-2">
                    <a href="/AdminManagement/Index" class="hover:text-blue-600">Admin Management</a>
                    <i data-lucide="chevron-right" class="h-3 w-3"></i>
                    <span class="text-slate-900 font-medium">@Model.ClientName</span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Client Details</h1>
                <p class="text-slate-500 text-sm mt-1">Configure client settings and manage delegated users.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/AdminManagement/Index" class="bg-white border border-slate-200 shadow-sm hover:bg-slate-50 text-slate-700 font-bold h-10 px-5 rounded-md flex items-center gap-2 transition-colors text-sm">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i>
                    Back
                </a>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 gap-8">
            <!-- Usage & Notifications Overview -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Usage Stats -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-tight flex items-center gap-2">
                            <i data-lucide="bar-chart-3" class="h-4 w-4 text-blue-600"></i>
                            Usage Statistics
                        </h3>
                    </div>
                    <div class="p-6 grow grid grid-cols-2 gap-4">
                        <div class="bg-slate-50 rounded-lg p-4 border border-slate-100">
                            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">User Limit</p>
                            <p class="text-2xl font-bold text-slate-900 leading-none">@ViewBag.userlimit</p>
                        </div>
                        <div class="bg-blue-50 rounded-lg p-4 border border-blue-100">
                            <p class="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1">Total Usage</p>
                            <p class="text-2xl font-bold text-blue-700 leading-none">@ViewBag.totalcount</p>
                        </div>
                        <div class="bg-indigo-50 rounded-lg p-4 border border-indigo-100">
                            <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider mb-1">Individual Cases</p>
                            <p class="text-2xl font-bold text-indigo-700 leading-none">@ViewBag.individualCount</p>
                        </div>
                        <div class="bg-slate-50 rounded-lg p-4 border border-slate-100">
                            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Corporate Cases</p>
                            <p class="text-2xl font-bold text-slate-900 leading-none">@ViewBag.corporateCount</p>
                        </div>
                    </div>
                </div>

                <!-- Notification Logs -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-tight flex items-center gap-2">
                            <i data-lucide="mail" class="h-4 w-4 text-blue-600"></i>
                            Email Notifications Logs
                        </h3>
                    </div>
                    <div class="p-6 grow">
                        <div class="space-y-4">
                            <div class="flex items-start gap-3">
                                <div class="h-8 w-8 rounded-full bg-green-50 flex items-center justify-center shrink-0 border border-green-100">
                                    <i data-lucide="check-circle-2" class="h-4 w-4 text-green-600"></i>
                                </div>
                                <div class="grow pt-0.5">
                                    <div class="flex justify-between items-center mb-0.5">
                                        <h4 class="text-xs font-bold text-slate-800">100% Limit Reached</h4>
                                        <span class="text-[10px] font-bold text-slate-400">@ViewBag.hundredemail</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">Critical: Usage cap successfully reached and notification dispatched.</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="h-8 w-8 rounded-full bg-blue-50 flex items-center justify-center shrink-0 border border-blue-100">
                                    <i data-lucide="info" class="h-4 w-4 text-blue-600"></i>
                                </div>
                                <div class="grow pt-0.5">
                                    <div class="flex justify-between items-center mb-0.5">
                                        <h4 class="text-xs font-bold text-slate-800">80% Threshold Warning</h4>
                                        <span class="text-[10px] font-bold text-slate-400">@ViewBag.Eightemail</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">Usage alert: 400 out of 500 licenses currently in utilization.</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="h-8 w-8 rounded-full bg-slate-50 flex items-center justify-center shrink-0 border border-slate-100">
                                    <i data-lucide="clock" class="h-4 w-4 text-slate-500"></i>
                                </div>
                                <div class="grow pt-0.5">
                                    <div class="flex justify-between items-center mb-0.5">
                                        <h4 class="text-xs font-bold text-slate-800">30 Days Notice</h4>
                                        <span class="text-[10px] font-bold text-slate-400">@ViewBag.beforeexpdemail</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">Subscription renewal reminder sent to compliance officer.</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="h-8 w-8 rounded-full bg-rose-50 flex items-center justify-center shrink-0 border border-rose-100">
                                    <i data-lucide="calendar-x" class="h-4 w-4 text-rose-600"></i>
                                </div>
                                <div class="grow pt-0.5">
                                    <div class="flex justify-between items-center mb-0.5">
                                        <h4 class="text-xs font-bold text-slate-800">Expiry Date Dispatch</h4>
                                        <span class="text-[10px] font-bold text-slate-400">@ViewBag.onexpemail</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">Terminated: Subscription expired and final notice delivered.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Client Configuration Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-tight flex items-center gap-2">
                        <i data-lucide="settings" class="h-4 w-4 text-blue-600"></i>
                        Client Configuration
                    </h3>
                </div>
                <form id="frmClient" class="p-6">
                    <input type="hidden" id="hdnClientId" asp-for="ClientId" />
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Client Name</label>
                            <input type="text" asp-for="ClientName" id="txtClientName" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Prefix</label>
                            <input type="text" asp-for="Prefix" id="txtPrefix" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Description</label>
                            <input type="text" asp-for="Description" id="txtDescription" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">C6 Username</label>
                            <input type="text" asp-for="C6Username" id="txtC6Username" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Prefix</label>
                            <input type="text" asp-for="Prefix" id="txtPrefix" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">C6 Base API Url</label>
                            <input type="text" asp-for="C6BaseUrl" id="txtC6BaseUrl" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Threshold</label>
                            <input type="number" asp-for="Threshold" id="txtThreshold" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Search Limit</label>
                            <input type="number" asp-for="SearchCount" id="txtSearchCount" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Creation Date</label>
                            <p class="text-sm font-medium text-slate-900 mt-1 flex h-10 w-full rounded-md border border-slate-200 bg-slate-100 px-3 py-2 text-sm text-slate-500 cursor-not-allowed transition-all">@(Model.CreatedOn?.ToString("dd/MM/yyyy") ?? "-")</p>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Contract Start Date</label>
                            <input type="date" asp-for="ApplicationStartDate" id="txtApplicationStartDate" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-500 uppercase ml-0.5">Contract End Date</label>
                            <input type="date" asp-for="ApplicationEndDate" id="txtApplicationEndDate" class="flex h-10 w-full rounded-md border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        </div>
                    </div>
                    <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end">
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold h-10 px-8 rounded-md shadow-sm transition-colors text-sm flex items-center gap-2">
                            <i data-lucide="save" class="h-4 w-4"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- Client Rights Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-tight flex items-center gap-2">
            <i data-lucide="shield-check" class="h-4 w-4 text-blue-600"></i>
            Module Rights
        </h3>
        <button type="button" id="btnSaveClientRights"
                class="bg-blue-600 hover:bg-blue-700 text-white font-bold h-9 px-5 rounded-md shadow-sm transition-colors text-xs flex items-center gap-2">
            <i data-lucide="save" class="h-3.5 w-3.5"></i>
            Save Rights
        </button>
    </div>

    <div class="p-6 grow text-sm">
        <div id="clientRightsContainer"
             class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            <!-- Rights will be injected here -->
        </div>
    </div>
</div>



                  

            <!-- User Management Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-tight flex items-center gap-2">
                            <i data-lucide="users" class="h-4 w-4 text-blue-600"></i>
                            User Management
                        </h3>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <a href="/UserGroup/Index?clientId=@clientId" class="h-9 px-4 rounded-md border border-slate-200 bg-white text-slate-700 text-xs font-bold flex items-center gap-2 hover:bg-slate-50 transition-colors shadow-sm">
                            <i data-lucide="users" class="h-3.5 w-3.5"></i>
                            User Groups
                        </a>
                        <a href="/usergroup/create?clientId=@clientId" class="h-9 px-4 rounded-md border border-slate-200 bg-white text-slate-700 text-xs font-bold flex items-center gap-2 hover:bg-slate-50 transition-colors shadow-sm">
                            <i data-lucide="plus-square" class="h-3.5 w-3.5"></i>
                            New Group
                        </a>
                        <a href="/user/create?clientId=@clientId" class="h-9 px-4 rounded-md bg-blue-600 text-white text-xs font-bold flex items-center gap-2 hover:bg-blue-700 transition-colors shadow-sm">
                            <i data-lucide="user-plus" class="h-3.5 w-3.5"></i>
                            Add New Users 
                        </a>
                    </div>
                </div>

                <div class="p-6 space-y-4">
                    <div class="flex flex-col md:flex-row justify-end items-center gap-4">
                        
                        <div class="relative w-full md:w-80">
                            <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 h-3.5 w-3.5 text-slate-400"></i>
                            <input id="userSearch" type="text" placeholder="Search" 
                                   class="pl-9 h-9 w-full rounded-md border border-slate-200 bg-white px-3 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all">
                        </div>
                        <button onclick="resetUserFilters()" class="h-9 px-4 rounded-md border border-slate-200 bg-white text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
                            <i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>
                            Reset
                        </button>
                    </div>

                    <div class="overflow-x-auto border border-slate-100 rounded-lg">
                        <table id="usersTable" class="w-full text-sm text-left whitespace-nowrap">
                            <thead class="text-[10px] text-slate-500 uppercase bg-slate-50/50 border-b border-slate-100">
                                <tr>
                                    <th class="px-6 py-3 font-semibold sortable active asc" data-col="empCode">Emp Code</th>
                                    <th class="px-6 py-3 font-semibold sortable" data-col="fName">Full Name</th>
                                    <th class="px-6 py-3 font-semibold sortable" data-col="userName">Username</th>
                                    <th class="px-6 py-3 font-semibold text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100" style="font-size: 12px;">
                                <!-- User rows will be injected here -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Show</label>
                            <select id="pageSize" onchange="changePageSize()"
                                    class="h-8 w-20 rounded-md border border-slate-200 bg-white pl-3 pr-8 text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="h-4 w-px bg-slate-200"></div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                            Showing <span id="showingStart" class="text-slate-900">0</span> - <span id="showingEnd" class="text-slate-900">0</span> 
                            <span class="mx-1 text-slate-300">of</span> 
                            <span id="totalRecords" class="text-slate-900">0</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <button id="prevBtn" onclick="previousPage()"
                                class="h-8 px-4 flex items-center gap-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                            <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i>
                            Previous
                        </button>
                        <button id="nextBtn" onclick="nextPage()"
                                class="h-8 px-4 flex items-center gap-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                            Next
                            <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>
         </div>
       </div>
     </div>
  </div>
       

<script>
    const clientId = @clientId;
    let userPage = 1;
    let userPageSize = 10;
    let userSort = 'empCode';
    let userDir = 'asc';

    $(document).ready(function() {
        lucide.createIcons();
        loadUsers();
        loadClientRights();

        $('#userRowsPerPage').on('change', function() {
            userPageSize = parseInt($(this).val());
            userPage = 1;
            loadUsers();
        });

        $('#userSearch').on('input', function() {
            userPage = 1;
            loadUsers();
        });

        $('#usersTable').on('click', 'th.sortable', function() {
            const col = $(this).data('col');
            $('.sortable').removeClass('active asc desc');
            if (userSort === col) {
                userDir = userDir === 'asc' ? 'desc' : 'asc';
            } else {
                userSort = col;
                userDir = 'asc';
            }
            $(this).addClass('active ' + userDir);
            loadUsers();
        });

        $('#frmClient').submit(function(e) {
            e.preventDefault();
            $('#loader').removeClass('hidden').addClass('flex');
            const formData = new FormData(this);
            $.ajax({
                url: '/client/create',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function() {

                    toastr.success('Client configuration updated successfully');
                    setTimeout(() => location.reload(), 1500);

                },
                complete: function() {
                    $('#loader').addClass('hidden').removeClass('flex');
                }
            });
        });
    });

    function loadUsers() {
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            url: '/adminmanagement/userpagination',
            type: 'POST',
            data: {
                draw: 1,
                start: (userPage - 1) * userPageSize,
                length: userPageSize,
                Id: clientId,
                search: { value: $('#userSearch').val() },
                order: [{ column: 0, dir: userDir }],
                columns: [{ data: userSort }]
            },
            success: function(resp) {
                renderUserTable(resp.data);
                renderUserPagination(resp.recordsFiltered);
                updateShowingEntries(resp.recordsFiltered);
                $('#userTotalVisible').text(resp.data ? resp.data.length : 0);
            },
            complete: function() { 
                $('#loader').addClass('hidden').removeClass('flex'); 
            }
        });
    }

    function renderUserTable(data) {
        const tbody = $('#usersTable tbody').empty();
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="4" class="px-6 py-12 text-center text-slate-400">No users found for this client</td></tr>');
            return;
        }
        data.forEach(u => {
            const blockIcon = u.isBlocked 
                ? '<i data-lucide="lock" class="h-3.5 w-3.5 text-red-600"></i>' 
                : '<i data-lucide="unlock" class="h-3.5 w-3.5 text-green-600"></i>';
            const blockColor = u.isBlocked ? 'hover:bg-red-50 hover:border-red-100' : 'hover:bg-green-50 hover:border-green-100';
            const blockTitle = u.isBlocked ? 'Unblock User' : 'Block User';

            tbody.append(`
                <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="px-6 py-4 font-medium text-slate-700 font-bold">${u.empCode}</td>
                    <td class="px-6 py-4 text-slate-900">${u.fName} ${u.lName || ''}</td>
                    <td class="px-6 py-4 text-slate-500">${u.userName}</td>
                    <td class="px-6 py-4 text-center">
                        <div class="flex justify-center gap-2">
                            <a href="/user/edit/${u.id}" class="h-8 w-8 flex items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 hover:text-blue-600 hover:border-blue-100 hover:bg-blue-50 transition-all shadow-sm" title="Edit User">
                                <i data-lucide="edit-3" class="h-3.5 w-3.5"></i>
                            </a>
                            <button onclick="BlockData(${u.id}, ${u.isBlocked ? 0 : 1})" class="h-8 w-8 flex items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 ${blockColor} transition-all shadow-sm" title="${blockTitle}">
                                ${blockIcon}
                            </button>
                            <button onclick="deleteUser(${u.id})" class="h-8 w-8 flex items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 hover:text-red-600 hover:border-red-100 hover:bg-red-50 transition-all shadow-sm" title="Delete User">
                                <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `);
        });
        lucide.createIcons();
    }

    function renderUserPagination(total) {
        const container = $('#userPagination').empty();
        const pages = Math.ceil(total / userPageSize);
        if (pages <= 1) return;
        
        const maxVisible = 5;
        let start = Math.max(1, userPage - Math.floor(maxVisible / 2));
        let end = Math.min(pages, start + maxVisible - 1);
        if (end - start + 1 < maxVisible) start = Math.max(1, end - maxVisible + 1);

        for (let i = start; i <= end; i++) {
            container.append(`
                <button onclick="goUserPage(${i})" 
                        class="h-7 w-7 flex items-center justify-center text-[11px] font-bold border rounded transition-all
                        ${i === userPage ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}">
                    ${i}
                </button>
            `);
        }
    }

        function updateShowingEntries(totalRecords) {

        if (totalRecords === 0) {
            $('#showingStart').text(0);
            $('#showingEnd').text(0);
            $('#totalRecords').text(0);
            return;
        }

        let start = (userPage - 1) * userPageSize + 1;
        let end = Math.min(userPage * userPageSize, totalRecords);

        $('#showingStart').text(start);
        $('#showingEnd').text(end);
        $('#totalRecords').text(totalRecords);
    }

    function goUserPage(p) { userPage = p; loadUsers(); }

    function BlockData(id, status) {
        const title = status === 1 ? 'Block User' : 'Unblock User';
        const msg = `Are you sure you want to ${status === 1 ? 'block' : 'unblock'} this user?`;
        
        confirmModal(title, msg, function() {
            $('#loader').removeClass('hidden').addClass('flex');
            $.ajax({
                url: `/User/Block?Id=${id}&Status=${status}`,
                type: 'POST',
                success: function () { 
                    toastr.success('User status updated successfully');
                    loadUsers(); 
                },
                complete: function() {
                    $('#loader').addClass('hidden').removeClass('flex');
                }
            });
        });
    }

    function deleteUser(id) {
        confirmModal('Delete User', 'Are you sure you want to delete this user? This action cannot be undone.', function() {
            $('#loader').removeClass('hidden').addClass('flex');
            $.ajax({
                url: '/user/delete/' + id,
                type: 'DELETE',
                success: function() { 
                    toastr.success('User deleted successfully');
                    loadUsers(); 
                }
            });
        });
    }

    function resetUserFilters() {
        $('#userSearch').val('');
        $('#userSearch').trigger('input');
    }

    function loadClientRights() {
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            url: '/client/GetClientRightsData/' + clientId,
            type: 'GET',
            success: function(resp) {
                const container = $('#clientRightsContainer').empty();
                if (!resp || resp.length === 0) {
                    container.append('<p class="text-slate-500">No rights available.</p>');
                    return;
                }
                console.log(resp);
                resp.forEach((m, idx) => {
                    if (m.menu_Name === "Risk Assessmnet" || m.menu_Name === "User Management"  ) {
                    return;
                }
                    const chkId = 'chkMenu_' + m.menu_Id;
                    const checkedStr = m.isChecked ? 'checked' : '';
                    container.append(`
                        <div class="flex items-center space-x-2">
                            <input type="checkbox" id="${chkId}" value="${m.menu_Id}" class="client-right-checkbox h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" ${checkedStr}>
                            <label for="${chkId}" class="text-sm text-slate-700 font-medium">${m.menu_Name}</label>
                        </div>
                    `);
                });
            },
            complete: function() {
                $('#loader').addClass('hidden').removeClass('flex');
            }
        });
    }

    $('#btnSaveClientRights').click(function() {
        const selectedIds = [];
        $('.client-right-checkbox:checked').each(function() {
            selectedIds.push($(this).val());
        });
        
        $('#loader').removeClass('hidden').addClass('flex');
        $.ajax({
            url: '/client/ClientRight',
            type: 'POST',
            data: { ClientId: clientId, MenuIds: selectedIds },
            success: function() {
                toastr.success('Client rights updated successfully');
            },
            complete: function() {
                $('#loader').addClass('hidden').removeClass('flex');
            }
        });
    });

    // Custom Confirmation Modal Helper
    function confirmModal(title, message, onConfirm) {
        $('#confirmModalTitle').text(title);
        $('#confirmModalMessage').text(message);
        $('#confirmModalOkBtn').off('click').on('click', function() {
            onConfirm();
            closeConfirmModal();
        });
        $('#confirmModal').removeClass('hidden').addClass('flex');
    }

    function closeConfirmModal() {
        $('#confirmModal').addClass('hidden').removeClass('flex');
    }
</script>

<!-- Custom Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/40">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6 space-y-4">
        <h3 id="confirmModalTitle" class="text-lg font-bold text-slate-900">Confirm Action</h3>
        <p id="confirmModalMessage" class="text-sm text-slate-600">Are you sure you want to proceed?</p>
        <div class="flex justify-end gap-3 pt-4">
            <button onclick="closeConfirmModal()" class="h-9 px-8 text-slate-600 rounded-md bg-slate-100 hover:bg-slate-200 font-semibold transition-colors">
                Cancel
            </button>
            <button id="confirmModalOkBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold h-9 px-8 rounded-md transition-colors text-xs uppercase tracking-wider">
                OK
            </button>
        </div>
    </div>
</div>
