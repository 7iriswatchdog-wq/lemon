        $("#addRow").prop("disabled", true);
        $('#rowIndex1').val('1');
        $('#rowIndex2').val('1');
        $('#rowIndex3').val('1');
    }

        function initDatePicker(selector, defaultDate, options = {}) {
        const elements = document.querySelectorAll(selector);

        elements.forEach(el => {
            if (el._flatpickr) return; // prevent duplicate init

            flatpickr(el, {
                dateFormat: "Y-m-d",       // actual value posted to backend
                altInput: true,            // user sees altInput
                altFormat: "d/m/Y",        // display format
                altInputClass: "block w-full h-11 bg-white border border-slate-200 rounded-xl px-4 text-sm font-medium",
                allowInput: true,
                defaultDate: defaultDate,
                appendTo: document.body,   // calendar floats over card
                ...options,

                // ------------------ Custom key restrictions & auto-format ------------------
                onReady: function (selectedDates, dateStr, instance) {
                    const input = instance.altInput;

                    // Restrict keys to numbers and navigation
                    input.addEventListener("keydown", function (e) {
                        const allowedKeys = ["Backspace", "Delete", "ArrowLeft", "ArrowRight", "Tab"];
                        if (allowedKeys.includes(e.key) || (e.key >= "0" && e.key <= "9")) return;
                        e.preventDefault();
                    });

                    // Auto-format as dd/MM/yyyy while typing
                    input.addEventListener("input", function () {
                        let value = input.value.replace(/\D/g, '');
                        if (value.length > 8) value = value.substring(0, 8);

                        let formatted = '';
                        if (value.length > 0) formatted += value.substring(0, 2);
                        if (value.length >= 3) formatted += '/' + value.substring(2, 4);
                        if (value.length >= 5) formatted += '/' + value.substring(4, 8);

                        input.value = formatted;
                    });
                },

                // ------------------ Sync with Alpine ------------------
                onChange: function (selectedDates, dateStr, instance) {
                    if (el._x_model) {
                        el._x_model.set(dateStr);
                    }
                },

                // ------------------ Final validation ------------------
                onClose: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length > 0) return; // date picked by calendar, safe

                    let val = instance.altInput.value;
                    if (!val) return;

                    // Validate manually typed value dd/MM/yyyy
                    let regex = /^\d{2}\/\d{2}\/\d{4}$/;
                    if (!regex.test(val)) {
                        instance.clear();
                        return;
                    }

                    let parts = val.split('/');
                    let dd = parseInt(parts[0], 10);
                    let mm = parseInt(parts[1], 10);
                    let yyyy = parseInt(parts[2], 10);

                    let date = new Date(yyyy, mm - 1, dd);
                    if (date.getFullYear() !== yyyy || date.getMonth() !== mm - 1 || date.getDate() !== dd) {
                        instance.clear();
                        return;
                    }

                    // ✅ Set Flatpickr date correctly for backend
                    instance.setDate(`${yyyy}-${String(mm).padStart(2,'0')}-${String(dd).padStart(2,'0')}`, true);
                }
            });
        });
    }

    // ------------------ Example usage ------------------
    document.addEventListener("DOMContentLoaded", function () {

        initDatePicker(
            "#txtApplicationStartDate",
            "@(Model.ApplicationStartDate.HasValue? Model.ApplicationStartDate.Value.ToString("yyyy-MM-dd") : null)",
            { maxDate: "today" }
        );

        initDatePicker(
            "#txtApplicationEndDate",
            "@(ViewBag.contractExpiryDate != null ? ((DateTime)ViewBag.contractExpiryDate).ToString("yyyy-MM-dd") : null)",
            { minDate: "today" }
        );

    });
             
            
