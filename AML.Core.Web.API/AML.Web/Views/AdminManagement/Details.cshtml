                    $("input[type='text'],textarea").val("");
                    LoadRiskTypeCategoryTable($("#ddlRiskCategory").val());
                },

                /* ---------- COMPLETE ---------- */
                complete() {
                    $loader.fadeOut();                    // hide overlay
                    $btn.prop("disabled", false)          // unlock button
                        .removeClass("opacity-50 cursor-not-allowed");
                    ReloadAfterSubmit();
                }
            });

            return false;                                 // stop normal submit
        });
    });


    


