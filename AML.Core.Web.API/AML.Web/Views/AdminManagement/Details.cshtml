    function renderRiskItemsTable(data) {
        const tbody = $('#availableRiskItems tbody').empty();
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="4" class="px-6 py-4 text-center text-slate-400">No risk items found</td></tr>');
            return;
        }

        data.forEach((full, i) => {
            let idx = i; 

            // Risk Item Column
            let col1 = '<input type="text" value="' + (full.lovRiskData || '') + '" name="AvailableItems[' + idx + '].RiskItem" maxlength="500" class="w-full px-2 py-1 text-sm border border-slate-200 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500/20" onkeypress="alphaNumericCheck(event)" />';
            col1 += '<input type="hidden" value="' + full.id + '" name="AvailableItems[' + idx + '].Id" />';

            // Risk Score Column
            let col2 = '<select value="' + full.lovRiskScore + '" id="AvailableItems[' + idx + '].RiskScore" onchange="tableRiskScoreOnChange(' + idx + ')" name="AvailableItems[' + idx + '].RiskScore" class="w-full px-2 py-1 text-sm border border-slate-200 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500/20">';
            for (let s = 0; s <= 3; s++) {
                col2 += '<option value="' + s + '" ' + (s == full.lovRiskScore ? 'selected' : '') + '>' + s + '</option>';
            }
            col2 += '</select>';

            // Override Score Column
            let col3 = '<select value="' + full.overrideScore + '" id="AvailableItems[' + idx + '].OverrideScore" name="AvailableItems[' + idx + '].OverrideScore" class="w-full px-2 py-1 text-sm border border-slate-200 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500/20" ' + (full.lovRiskScore == '3' ? '' : 'disabled') + '>';
            col3 += '<option value="0" ' + (full.overrideScore == '0' ? 'selected' : '') + '>0</option>';
            col3 += '<option value="3" ' + (full.overrideScore == '3' ? 'selected' : '') + '>3</option>';
            col3 += '</select>';

            // Active Y/N Column
            let isActiveChecked = (full.isActive === true || full.isActive === 'True' || full.isActive === 'true') ? 'checked' : '';
            let col4 = '<input type="checkbox" onchange="ChangeStatus(' + idx + ',this);" ' + isActiveChecked + ' class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"/>';
            col4 += '<input type="hidden" value="' + (isActiveChecked ? 'true' : 'false') + '" name="AvailableItems[' + idx + '].isActive" />';

            tbody.append(`
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-2">${col1}</td>
                    <td class="px-6 py-2">${col2}</td>
                    <td class="px-6 py-2">${col3}</td>
                    <td class="px-6 py-2 text-center items-center justify-center">${col4}</td>
                </tr>
            `);
        });
    }

