@using AML.ViewModel.ViewModels.AmlTracker
@using System.Collections.Generic
@model List<TopErrorRow>
@{
    ViewData["Title"] = "Top Errors";
    ViewData["ActiveTab"] = "Reports";
    ViewData["ReportTitle"] = "Top Application Errors";
    ViewData["ReportSubtitle"] = $"Most-frequent errors in the last {ViewBag.Days} days.";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}
<section class="content py-6 px-4">
    <div class="max-w-[1300px] mx-auto">
        <partial name="Reports/_ReportShell" />
        <div class="flex gap-2 my-3">
            <a href="?days=7" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 7 ? "bg-blue-50 border-blue-300" : "border-slate-300")">7d</a>
            <a href="?days=30" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 30 ? "bg-blue-50 border-blue-300" : "border-slate-300")">30d</a>
            <a href="?days=90" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 90 ? "bg-blue-50 border-blue-300" : "border-slate-300")">90d</a>
            <span class="ml-auto text-sm text-slate-600">@Model.Count rows · top occurrences first</span>
        </div>
        <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-left">
                        <th class="px-3 py-2">Source</th>
                        <th class="px-3 py-2">Error</th>
                        <th class="px-3 py-2 text-right">Occurrences</th>
                        <th class="px-3 py-2">Last Seen</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="px-3 py-12 text-center text-slate-500">No errors logged in this window.</td></tr>
                    }
                    else
                    {
                        foreach (var r in Model)
                        {
                            <tr class="border-b border-slate-100 hover:bg-slate-50">
                                <td class="px-3 py-2 text-slate-600">@r.Source</td>
                                <td class="px-3 py-2 text-xs font-mono">@r.ErrorType</td>
                                <td class="px-3 py-2 text-right font-semibold">@r.Occurrences</td>
                                <td class="px-3 py-2 text-slate-600 text-xs">@(r.LastSeen?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
