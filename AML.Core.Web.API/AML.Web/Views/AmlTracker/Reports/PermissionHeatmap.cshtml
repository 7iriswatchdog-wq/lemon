@using AML.ViewModel.ViewModels.AmlTracker
@model PermissionHeatmapVM
@{
    ViewData["Title"] = "Permission Heatmap";
    ViewData["ActiveTab"] = "Reports";
    ViewData["ReportTitle"] = "Permission Heatmap";
    ViewData["ReportSubtitle"] = "User-group × module rights matrix. Darker = more rights granted.";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var max = Model.Groups.SelectMany(g => g.ModuleCounts.Values).DefaultIfEmpty(0).Max();
    if (max < 1) max = 1;
    string Cell(int n)
    {
        if (n == 0) return "bg-slate-50 text-slate-400";
        var ratio = (double)n / max;
        if (ratio > 0.66) return "bg-blue-700 text-white";
        if (ratio > 0.33) return "bg-blue-400 text-white";
        return "bg-blue-100 text-blue-900";
    }
}
<section class="content py-6 px-4">
    <div class="max-w-[1700px] mx-auto">
        <partial name="Reports/_ReportShell" />

        <div class="bg-white border border-slate-200 rounded-lg overflow-hidden mt-3">
            <div class="overflow-x-auto">
                <table class="min-w-full text-xs">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-3 py-2 text-left sticky left-0 bg-slate-50">User Group</th>
                            @foreach (var m in Model.Modules) { <th class="px-3 py-2 text-center">@m</th> }
                            <th class="px-3 py-2 text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.Groups)
                        {
                            <tr class="border-b border-slate-100">
                                <td class="px-3 py-2 font-medium sticky left-0 bg-white">@g.GroupName</td>
                                @foreach (var m in Model.Modules)
                                {
                                    var n = g.ModuleCounts.TryGetValue(m, out var v) ? v : 0;
                                    <td class="px-2 py-1 text-center @Cell(n) font-mono">@(n == 0 ? "·" : n.ToString())</td>
                                }
                                <td class="px-3 py-2 text-right font-semibold">@g.TotalRights</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
