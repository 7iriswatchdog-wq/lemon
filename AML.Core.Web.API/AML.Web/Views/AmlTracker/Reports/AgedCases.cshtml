@using AML.ViewModel.ViewModels.AmlTracker
@model AgedCasesVM
@{
    ViewData["Title"] = "Aged Cases";
    ViewData["ActiveTab"] = "Reports";
    ViewData["ReportTitle"] = "Aged Cases Register";
    ViewData["ReportSubtitle"] = "Open cases bucketed by age. Sorted oldest first — focus the queue.";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    string BucketCls(string b) => b switch
    {
        "≤ 7 days" => "bg-emerald-50 border-emerald-200 text-emerald-800",
        "8–14 days" => "bg-blue-50 border-blue-200 text-blue-800",
        "15–30 days" => "bg-amber-50 border-amber-200 text-amber-800",
        "31–60 days" => "bg-rose-50 border-rose-200 text-rose-800",
        _ => "bg-rose-100 border-rose-300 text-rose-900"
    };
}
<section class="content py-6 px-4">
    <div class="max-w-[1500px] mx-auto">
        <partial name="Reports/_ReportShell" />

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 my-3">
            @foreach (var kv in Model.ByBucket)
            {
                <div class="border rounded-lg p-3 @BucketCls(kv.Key)">
                    <div class="text-[10px] uppercase font-medium tracking-wide">@kv.Key</div>
                    <div class="text-2xl font-semibold mt-0.5">@kv.Value</div>
                </div>
            }
        </div>

        <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-left">
                        <th class="px-3 py-2">Case</th>
                        <th class="px-3 py-2">Customer</th>
                        <th class="px-3 py-2">Status</th>
                        <th class="px-3 py-2">Owner</th>
                        <th class="px-3 py-2 text-right">Age (d)</th>
                        <th class="px-3 py-2 text-right">Days Since Touch</th>
                        <th class="px-3 py-2">Bucket</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="7" class="px-3 py-12 text-center text-slate-500">No open cases — queue is clear.</td></tr>
                    }
                    else
                    {
                        foreach (var r in Model.Rows)
                        {
                            <tr class="border-b border-slate-100 hover:bg-slate-50">
                                <td class="px-3 py-2 font-mono text-xs"><a href="/Case/Process/@r.CaseId" class="text-blue-600 hover:underline">@r.CaseId</a></td>
                                <td class="px-3 py-2"><a href="@Url.Action("Customer360","AmlTracker", new { cmid = r.CustomerMasterId })" class="text-blue-700 hover:underline font-medium">@r.CustomerName</a><div class="text-xs text-slate-500 font-mono">@r.CustomerCode</div></td>
                                <td class="px-3 py-2 text-slate-600">@r.StatusLabel</td>
                                <td class="px-3 py-2 text-slate-600 text-xs">@(string.IsNullOrWhiteSpace(r.OwnerName) ? "—" : r.OwnerName)</td>
                                <td class="px-3 py-2 text-right font-semibold @(r.AgeDays > 30 ? "text-rose-700" : "")">@r.AgeDays</td>
                                <td class="px-3 py-2 text-right">@r.DaysSinceTouch</td>
                                <td class="px-3 py-2"><span class="px-2 py-0.5 text-xs rounded border @BucketCls(r.AgeBucket)">@r.AgeBucket</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
