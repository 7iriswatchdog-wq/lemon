@using AML.ViewModel.ViewModels.AmlTracker
@using System.Collections.Generic
@model List<InvestigationDepthRow>
@{
    ViewData["Title"] = "Case Investigation Depth";
    ViewData["ActiveTab"] = "Reports";
    ViewData["ReportTitle"] = "Case Investigation Depth";
    ViewData["ReportSubtitle"] = "Cases bucketed by comment-richness. Sparse-comment cases tend to correlate with QA rejection.";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var buckets = Model.GroupBy(r => r.Bucket).Select(g => new { Bucket = g.Key, Count = g.Count() }).OrderBy(b => b.Bucket).ToList();
}
<section class="content py-6 px-4">
    <div class="max-w-[1300px] mx-auto">
        <partial name="Reports/_ReportShell" />

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 my-3">
            @foreach (var b in buckets)
            {
                var cls = b.Bucket switch
                {
                    "None" => "bg-rose-50 text-rose-800 border-rose-200",
                    "Sparse" => "bg-amber-50 text-amber-800 border-amber-200",
                    "Adequate" => "bg-blue-50 text-blue-800 border-blue-200",
                    "Rich" => "bg-emerald-50 text-emerald-800 border-emerald-200",
                    _ => "bg-slate-50 text-slate-700 border-slate-200"
                };
                <div class="border rounded-lg p-3 @cls">
                    <div class="text-[10px] uppercase font-medium tracking-wide">@b.Bucket</div>
                    <div class="text-xl font-semibold mt-0.5">@b.Count</div>
                </div>
            }
        </div>

        <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-left">
                        <th class="px-3 py-2">Case</th>
                        <th class="px-3 py-2">Customer</th>
                        <th class="px-3 py-2">Status</th>
                        <th class="px-3 py-2 text-right">Comments</th>
                        <th class="px-3 py-2">Latest Comment</th>
                        <th class="px-3 py-2">Bucket</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var pillCls = r.Bucket switch
                        {
                            "None" => "bg-rose-100 text-rose-800",
                            "Sparse" => "bg-amber-100 text-amber-800",
                            "Adequate" => "bg-blue-100 text-blue-800",
                            "Rich" => "bg-emerald-100 text-emerald-800",
                            _ => "bg-slate-100 text-slate-700"
                        };
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="px-3 py-2 font-mono text-xs"><a href="/Case/Process/@r.CaseId" class="text-blue-600 hover:underline">@r.CaseId</a></td>
                            <td class="px-3 py-2">@r.CustomerName</td>
                            <td class="px-3 py-2 text-slate-600">@r.StatusLabel</td>
                            <td class="px-3 py-2 text-right font-semibold">@r.CommentCount</td>
                            <td class="px-3 py-2 text-slate-600 text-xs">@(r.LatestComment?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="px-3 py-2"><span class="px-2 py-0.5 text-xs rounded-full @pillCls">@r.Bucket</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
