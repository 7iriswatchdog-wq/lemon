@using AML.ViewModel.ViewModels.AmlTracker
@model QaThroughputVM
@{
    ViewData["Title"] = "QA Throughput";
    ViewData["ActiveTab"] = "Reports";
    ViewData["ReportTitle"] = "QA Throughput";
    ViewData["ReportSubtitle"] = $"Daily approve/reject counts and average turnaround over the last {Model.DaysBack} days.";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var maxBar = Model.Points.Count == 0 ? 1 : Math.Max(1, Model.Points.Max(p => p.Approved + p.Rejected));
}
<section class="content py-6 px-4">
    <div class="max-w-[1300px] mx-auto">
        <partial name="Reports/_ReportShell" />

        <div class="grid grid-cols-3 gap-3 my-3">
            <div class="bg-white border border-emerald-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-emerald-700 font-bold">Total Approved</div>
                <div class="text-2xl font-semibold text-emerald-700">@Model.TotalApproved</div>
            </div>
            <div class="bg-white border border-rose-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-rose-700 font-bold">Total Rejected</div>
                <div class="text-2xl font-semibold text-rose-700">@Model.TotalRejected</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-700 font-bold">Avg Turnaround</div>
                <div class="text-2xl font-semibold text-slate-800">@Model.AvgTurnaroundHours <span class="text-sm text-slate-500">h</span></div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-lg p-4 mb-4">
            @if (Model.Points.Count > 0)
            {
                <svg viewBox="0 0 600 160" preserveAspectRatio="none" class="w-full h-40">
                    @{
                        var w = 600.0 / Math.Max(1, Model.Points.Count);
                        double x = 0;
                    }
                    @foreach (var p in Model.Points)
                    {
                        var totalH = (p.Approved + p.Rejected) * 140.0 / maxBar;
                        var apprH = p.Approved * 140.0 / maxBar;
                        var apprY = 150 - apprH;
                        var rejH = p.Rejected * 140.0 / maxBar;
                        var rejY = apprY - rejH;
                        <rect x="@(x.ToString("0.0"))" y="@(apprY.ToString("0.0"))" width="@((w-2).ToString("0.0"))" height="@(apprH.ToString("0.0"))" fill="#059669" />
                        <rect x="@(x.ToString("0.0"))" y="@(rejY.ToString("0.0"))" width="@((w-2).ToString("0.0"))" height="@(rejH.ToString("0.0"))" fill="#e11d48" />
                        x += w;
                    }
                </svg>
                <div class="text-xs text-slate-500 mt-1 flex gap-3">
                    <span><span class="inline-block w-3 h-3 bg-emerald-600 mr-1"></span>Approved</span>
                    <span><span class="inline-block w-3 h-3 bg-rose-600 mr-1"></span>Rejected</span>
                </div>
            }
            else
            {
                <div class="py-12 text-center text-slate-500">No QA decisions in the window.</div>
            }
        </div>

        <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-left">
                        <th class="px-3 py-2">Day</th>
                        <th class="px-3 py-2 text-right">Approved</th>
                        <th class="px-3 py-2 text-right">Rejected</th>
                        <th class="px-3 py-2 text-right">Avg Turnaround (h)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Points)
                    {
                        <tr class="border-b border-slate-100">
                            <td class="px-3 py-2">@p.Day.ToString("yyyy-MM-dd")</td>
                            <td class="px-3 py-2 text-right text-emerald-700 font-semibold">@p.Approved</td>
                            <td class="px-3 py-2 text-right text-rose-700 font-semibold">@p.Rejected</td>
                            <td class="px-3 py-2 text-right">@p.AvgTurnaroundHours.ToString("0.0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
