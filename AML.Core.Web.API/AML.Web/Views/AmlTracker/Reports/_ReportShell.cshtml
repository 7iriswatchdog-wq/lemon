@{
    var title = ViewData["ReportTitle"] as string ?? "Report";
    var subtitle = ViewData["ReportSubtitle"] as string ?? "";
}
<div class="mb-3 flex items-start justify-between">
    <div>
        <h1 class="text-2xl font-semibold text-slate-800">@title</h1>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="text-sm text-slate-500">@subtitle</p>
        }
    </div>
    <a href="@Url.Action("Reports", "AmlTracker")" class="px-3 py-2 text-sm border border-slate-300 hover:bg-slate-50 rounded">← All Reports</a>
</div>
<partial name="_TrackerTabs" />
