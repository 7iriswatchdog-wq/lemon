@using AML.ViewModel.ViewModels.AmlTracker
@using System.Collections.Generic
@model List<WhitelistAnalystRow>
@{
    ViewData["Title"] = "Whitelist Patterns";
    ViewData["ActiveTab"] = "Reports";
    ViewData["ReportTitle"] = "Whitelist Analyst Patterns";
    ViewData["ReportSubtitle"] = $"Who is whitelisting customers (last {ViewBag.Days} days). Outliers may indicate leniency.";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var max = Model.Select(r => r.Whitelistings).DefaultIfEmpty(0).Max();
    if (max < 1) max = 1;
}
<section class="content py-6 px-4">
    <div class="max-w-[1100px] mx-auto">
        <partial name="Reports/_ReportShell" />

        <div class="flex gap-2 my-3">
            <a href="?days=7" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 7 ? "bg-blue-50 border-blue-300" : "border-slate-300")">7d</a>
            <a href="?days=30" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 30 ? "bg-blue-50 border-blue-300" : "border-slate-300")">30d</a>
            <a href="?days=90" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 90 ? "bg-blue-50 border-blue-300" : "border-slate-300")">90d</a>
            <a href="?days=365" class="px-3 py-1.5 text-xs border rounded @(ViewBag.Days == 365 ? "bg-blue-50 border-blue-300" : "border-slate-300")">1y</a>
        </div>

        <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-left">
                        <th class="px-3 py-2">Analyst</th>
                        <th class="px-3 py-2 text-right">Whitelistings</th>
                        <th class="px-3 py-2">Distribution</th>
                        <th class="px-3 py-2">Last Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="px-3 py-12 text-center text-slate-500">No whitelisting in this window.</td></tr>
                    }
                    else
                    {
                        foreach (var r in Model)
                        {
                            var pct = max > 0 ? (r.Whitelistings * 100 / max) : 0;
                            <tr class="border-b border-slate-100 hover:bg-slate-50">
                                <td class="px-3 py-2 font-medium">@(string.IsNullOrWhiteSpace(r.AnalystName) ? "—" : r.AnalystName)</td>
                                <td class="px-3 py-2 text-right font-semibold">@r.Whitelistings</td>
                                <td class="px-3 py-2 w-1/3">
                                    <div class="bg-slate-100 rounded-full h-2 overflow-hidden">
                                        <div class="bg-blue-500 h-2" style="width:@(pct)%;"></div>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-slate-600">@(r.LastAction?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
