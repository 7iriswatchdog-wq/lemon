@{
    var active = (ViewData["ActiveTab"] as string) ?? "Tracker";
    string TabClass(string name)
        => active == name
            ? "px-3 py-2 border-b-2 border-blue-600 text-blue-700 font-semibold text-sm"
            : "px-3 py-2 border-b-2 border-transparent text-slate-600 hover:text-slate-900 hover:border-slate-300 text-sm";
}
<div class="bg-white border border-slate-200 rounded-lg mb-4 overflow-hidden">
    <nav class="flex flex-wrap items-center gap-1 px-2">
        <a href="@Url.Action("Index", "AmlTracker")" class="@TabClass("Tracker")">
            <i class="fas fa-table mr-1"></i> Tracker
        </a>
        <a href="@Url.Action("Workspace", "AmlTracker")" class="@TabClass("Workspace")">
            <i class="fas fa-clipboard-check mr-1"></i> QA Workspace
        </a>
        <a href="@Url.Action("Leaderboard", "AmlTracker")" class="@TabClass("Leaderboard")">
            <i class="fas fa-trophy mr-1"></i> Leaderboard
        </a>
        <a href="@Url.Action("Reports", "AmlTracker")" class="@TabClass("Reports")">
            <i class="fas fa-chart-bar mr-1"></i> Reports
        </a>
        <a href="@Url.Action("SlaConfig", "AmlTracker")" class="@TabClass("SlaConfig")">
            <i class="fas fa-clock mr-1"></i> SLA Settings
        </a>
        <a href="@Url.Action("AuditLog", "AmlTracker")" class="@TabClass("AuditLog")">
            <i class="fas fa-file-alt mr-1"></i> Audit Log
        </a>
    </nav>
</div>
