@using AML.ViewModel.ViewModels.AmlTracker
@model ReportsHubVM
@{
    ViewData["Title"] = "Reports";
    ViewData["ActiveTab"] = "Reports";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var byCategory = Model.Tiles.GroupBy(t => t.Category).OrderBy(g => g.Key);
}

<section class="content py-6 px-4">
    <div class="max-w-[1400px] mx-auto">
        <div class="mb-3">
            <h1 class="text-2xl font-semibold text-slate-800">Reports</h1>
            <p class="text-sm text-slate-500">Built on populated data. Tier 2/3 reports populate as the Tracker is used.</p>
        </div>
        <partial name="_TrackerTabs" />

        @foreach (var grp in byCategory)
        {
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mt-6 mb-2">@grp.Key</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                @foreach (var t in grp)
                {
                    var statusCls = t.Status switch
                    {
                        "Ready" => "bg-emerald-100 text-emerald-800",
                        var s when s.StartsWith("Tier 2") => "bg-amber-100 text-amber-800",
                        var s when s.StartsWith("Tier 3") => "bg-blue-100 text-blue-800",
                        _ => "bg-slate-100 text-slate-700"
                    };
                    <a href="@t.Url" class="block bg-white border border-slate-200 hover:border-blue-400 hover:shadow-sm rounded-lg p-4 transition">
                        <div class="flex items-start justify-between mb-1">
                            <span class="font-mono text-[10px] text-slate-500">@t.Code</span>
                            <span class="px-2 py-0.5 text-[10px] rounded-full @statusCls">@t.Status</span>
                        </div>
                        <div class="font-semibold text-slate-800">@t.Name</div>
                        <div class="text-xs text-slate-500 mt-1">@t.Description</div>
                    </a>
                }
            </div>
        }
    </div>
</section>
