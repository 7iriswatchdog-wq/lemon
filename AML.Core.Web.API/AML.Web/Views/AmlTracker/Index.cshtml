@using AML.ViewModel.ViewModels.AmlTracker
@model AmlTrackerIndexVM
@{
    ViewData["Title"] = "AML Tracker";
    ViewData["ActiveTab"] = "Tracker";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";

    string SortLink(string column, string label)
    {
        var dir = (Model.Filter.SortBy?.Equals(column, StringComparison.OrdinalIgnoreCase) ?? false)
            ? (Model.Filter.SortDir == "asc" ? "desc" : "asc") : "desc";
        var arrow = (Model.Filter.SortBy?.Equals(column, StringComparison.OrdinalIgnoreCase) ?? false)
            ? (Model.Filter.SortDir == "asc" ? " &uarr;" : " &darr;") : "";
        var url = $"?SortBy={column}&SortDir={dir}&StartDate={Model.Filter.StartDate}&EndDate={Model.Filter.EndDate}&CustomerType={Model.Filter.CustomerType}&CaseStatus={Model.Filter.CaseStatus}&QaStatus={Model.Filter.QaStatus}&Search={Model.Filter.Search}";
        return $"<a href=\"{url}\" class=\"hover:underline text-slate-700 font-semibold\">{label}{arrow}</a>";
    }

    string SlaPill(string status)
    {
        var cls = status switch
        {
            "On Track" => "bg-emerald-100 text-emerald-800",
            "At Risk" => "bg-amber-100 text-amber-800",
            "Breach" => "bg-rose-100 text-rose-800",
            "Closed" => "bg-slate-100 text-slate-700",
            "Reviewed" => "bg-emerald-100 text-emerald-800",
            _ => "bg-slate-50 text-slate-500"
        };
        return $"<span class=\"px-2 py-0.5 text-xs rounded-full {cls}\">{status}</span>";
    }
    string StatusPill(string label, int code)
    {
        var cls = code switch
        {
            2 or 1 or 5 => "bg-emerald-50 text-emerald-700 border border-emerald-200",
            3 => "bg-rose-50 text-rose-700 border border-rose-200",
            4 => "bg-amber-50 text-amber-800 border border-amber-200",
            7 => "bg-slate-100 text-slate-600 border border-slate-200",
            0 or 6 => "bg-blue-50 text-blue-700 border border-blue-200",
            _ => "bg-slate-50 text-slate-600 border border-slate-200"
        };
        return $"<span class=\"px-2 py-0.5 text-xs rounded {cls}\">{label}</span>";
    }
    string RiskPill(string tier)
    {
        var cls = tier switch
        {
            "High" => "bg-rose-100 text-rose-800",
            "Medium" => "bg-amber-100 text-amber-800",
            "Low" => "bg-emerald-100 text-emerald-800",
            _ => "bg-slate-100 text-slate-600"
        };
        return $"<span class=\"px-2 py-0.5 text-xs rounded-full {cls}\">{tier}</span>";
    }
    string QaPill(int code, string label)
    {
        var cls = code switch
        {
            2 => "bg-emerald-100 text-emerald-800",
            3 => "bg-rose-100 text-rose-800",
            1 => "bg-amber-100 text-amber-800",
            4 => "bg-blue-100 text-blue-800",
            _ => "bg-slate-100 text-slate-600"
        };
        return $"<span class=\"px-2 py-0.5 text-xs rounded-full {cls}\">{label}</span>";
    }
    string SarPill(string status)
    {
        var cls = status switch
        {
            "Filed" => "bg-emerald-100 text-emerald-800",
            "Drafted" => "bg-amber-100 text-amber-800",
            "Required" => "bg-rose-100 text-rose-800",
            "NotFiled" => "bg-slate-100 text-slate-600",
            _ => "bg-slate-50 text-slate-500"
        };
        return $"<span class=\"px-2 py-0.5 text-xs rounded-full {cls}\">{status}</span>";
    }
    string TrendArrow(TrendDelta t)
    {
        if (t == null) return "";
        if (t.Delta > 0) return $"<span class=\"text-emerald-600\">▲ {t.Delta} ({t.DeltaPct:0.0}%)</span>";
        if (t.Delta < 0) return $"<span class=\"text-rose-600\">▼ {Math.Abs(t.Delta)} ({t.DeltaPct:0.0}%)</span>";
        return "<span class=\"text-slate-400\">―</span>";
    }
    var qaBtnDisabled = Model.CurrentUserCanQa ? "" : "opacity-50 cursor-not-allowed";
    var qaBtnTitle = Model.CurrentUserCanQa ? "" : "Your role isn't allowed to perform QA actions.";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<section class="content py-6 px-4" x-data="{ density: localStorage.getItem('amltracker-density') || 'comfy' }" :class="density === 'compact' ? 'tracker-compact' : ''">
    <div class="max-w-[1700px] mx-auto">

        <div class="flex items-start justify-between mb-3 gap-4 flex-wrap">
            <div>
                <h1 class="text-2xl font-semibold text-slate-800">AML Tracker</h1>
                <p class="text-sm text-slate-500">Maker–checker QA, SLA tracking, SAR linkage, sampling, audit. Updates automatically every 60s.</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" @@click="density = density === 'compact' ? 'comfy' : 'compact'; localStorage.setItem('amltracker-density', density);"
                        class="px-3 py-2 border border-slate-300 hover:bg-slate-50 text-sm rounded">
                    <i class="fas fa-text-height"></i> <span x-text="density === 'compact' ? 'Comfy' : 'Compact'"></span>
                </button>

                <button type="button" onclick="document.getElementById('notifPanel').classList.toggle('hidden')"
                        class="relative px-3 py-2 border border-slate-300 hover:bg-slate-50 text-sm rounded">
                    <i class="fas fa-bell"></i>
                    @if (Model.UnreadNotificationCount > 0)
                    {
                        <span id="notifBadge" class="absolute -top-1 -right-1 bg-rose-600 text-white text-[10px] rounded-full px-1.5 py-0.5 font-bold">@Model.UnreadNotificationCount</span>
                    }
                    else
                    {
                        <span id="notifBadge" class="absolute -top-1 -right-1 bg-rose-600 text-white text-[10px] rounded-full px-1.5 py-0.5 font-bold hidden">0</span>
                    }
                </button>

                <div class="relative inline-block">
                    <button type="button" id="columnsToggleBtn"
                            onclick="document.getElementById('columnsPanel').classList.toggle('hidden')"
                            class="px-3 py-2 border border-slate-300 hover:bg-slate-50 text-sm rounded" title="Show / hide columns">
                        <i class="fas fa-columns"></i> Columns
                    </button>
                    <div id="columnsPanel" class="hidden absolute right-0 mt-1 w-72 max-h-[60vh] overflow-y-auto bg-white border border-slate-200 rounded-lg shadow-lg z-40 p-3">
                        <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
                            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Optional columns</span>
                            <div class="flex gap-2">
                                <button type="button" onclick="setAllOptionalCols(true)" class="text-[11px] text-blue-600 hover:underline">All</button>
                                <button type="button" onclick="setAllOptionalCols(false)" class="text-[11px] text-slate-500 hover:underline">None</button>
                            </div>
                        </div>
                        <div id="columnsList" class="space-y-1.5 text-sm">
                            <!-- Populated by JS from data-col-key tags on the table -->
                        </div>
                        <div class="mt-3 pt-2 border-t border-slate-100 text-[10px] text-slate-400 leading-tight">
                            Selection persists per browser. The 16 default columns are always shown.
                        </div>
                    </div>
                </div>

                <a href="@Url.Action("Export", "AmlTracker", new { Model.Filter.StartDate, Model.Filter.EndDate, Model.Filter.CustomerType, Model.Filter.CaseStatus, Model.Filter.QaStatus, Model.Filter.Search, Model.Filter.SortBy, Model.Filter.SortDir })"
                   class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded">
                    <i class="fas fa-file-excel"></i> Excel
                </a>
                <a href="@Url.Action("ExportCsv", "AmlTracker", new { Model.Filter.StartDate, Model.Filter.EndDate, Model.Filter.CustomerType, Model.Filter.CaseStatus, Model.Filter.QaStatus, Model.Filter.Search, Model.Filter.SortBy, Model.Filter.SortDir })"
                   class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded border border-slate-300">CSV</a>
            </div>
        </div>

        <partial name="_TrackerTabs" />

        @if (!string.IsNullOrEmpty(Model.FlashMessage))
        {
            var flashCls = Model.FlashLevel switch
            {
                "success" => "bg-emerald-50 border-emerald-300 text-emerald-800",
                "error" => "bg-rose-50 border-rose-300 text-rose-800",
                _ => "bg-blue-50 border-blue-300 text-blue-800"
            };
            <div class="border @flashCls rounded p-3 mb-4 text-sm">@Model.FlashMessage</div>
        }

        @if (!Model.CurrentUserCanQa)
        {
            <div class="border bg-amber-50 border-amber-300 text-amber-900 rounded p-3 mb-4 text-sm">
                <strong>Read-only QA:</strong> your role isn't authorized for QA actions. Allowed: Compliance, Senior Management, Quality Assurance, QA Reviewer, Audit.
            </div>
        }

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 mb-3">
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">Total</div>
                <div class="text-xl font-semibold text-slate-800 mt-0.5">@Model.TotalCount</div>
                <div class="text-[10px] mt-0.5">@Html.Raw(TrendArrow(Model.TotalTrend)) <span class="text-slate-400">vs prev wk</span></div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">Open</div>
                <div class="text-xl font-semibold text-blue-700 mt-0.5">@Model.OpenCount</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">Pending Sr. Mgmt</div>
                <div class="text-xl font-semibold text-amber-700 mt-0.5">@Model.PendingSrMgmtCount</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">Completed</div>
                <div class="text-xl font-semibold text-emerald-700 mt-0.5">@Model.CompletedCount</div>
                <div class="text-[10px] mt-0.5">@Html.Raw(TrendArrow(Model.CompletedTrend))</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">SLA Breach</div>
                <div class="text-xl font-semibold text-rose-700 mt-0.5" id="kpi-sla-breach">@Model.SlaBreachCount</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">High Risk</div>
                <div class="text-xl font-semibold text-rose-700 mt-0.5">@Model.HighRiskCount</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">Today / New</div>
                <div class="text-xl font-semibold text-slate-800 mt-0.5">@Model.TodayCount<span class="text-xs text-slate-500"> / @Model.NewSinceLastVisitCount</span></div>
            </div>
            <div class="bg-white border border-slate-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-slate-500 font-medium tracking-wide">Avg Aging</div>
                <div class="text-xl font-semibold text-slate-800 mt-0.5">@Model.AvgAgingDays<span class="text-xs text-slate-500 ml-1">d</span></div>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 mb-3">
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">QA Pending</div>
                <div class="text-xl font-semibold text-indigo-800 mt-0.5">@Model.QaPendingCount</div>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">QA Approved</div>
                <div class="text-xl font-semibold text-emerald-700 mt-0.5">@Model.QaApprovedCount</div>
                <div class="text-[10px] mt-0.5">@Html.Raw(TrendArrow(Model.QaApprovedTrend))</div>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">QA Rejected</div>
                <div class="text-xl font-semibold text-rose-700 mt-0.5">@Model.QaRejectedCount</div>
                <div class="text-[10px] mt-0.5">@Html.Raw(TrendArrow(Model.QaRejectedTrend))</div>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">Awaiting QA</div>
                <div class="text-xl font-semibold text-indigo-800 mt-0.5">@Model.QaEligibleNotReviewedCount</div>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">QA SLA Breach</div>
                <div class="text-xl font-semibold text-rose-700 mt-0.5">@Model.QaSlaBreachCount</div>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">Stale</div>
                <div class="text-xl font-semibold text-amber-700 mt-0.5">@Model.StaleCount</div>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">SAR Required / Filed</div>
                <div class="text-sm font-semibold text-indigo-800 mt-0.5">@Model.SarRequiredCount <span class="text-slate-400">/</span> <span class="text-emerald-700">@Model.SarFiledCount</span></div>
                @if (Model.SarOverdueCount > 0) { <div class="text-[10px] text-rose-700 mt-0.5">@Model.SarOverdueCount overdue</div> }
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
                <div class="text-[10px] uppercase text-indigo-700 font-bold tracking-wide">QA Cycle (30d)</div>
                @if (Model.CycleTime?.Points?.Any() == true)
                {
                    var pts = Model.CycleTime.Points;
                    var maxDec = pts.Max(p => p.Decisions);
                    if (maxDec < 1) { maxDec = 1; }
                    <svg viewBox="0 0 100 30" preserveAspectRatio="none" class="w-full h-8 mt-0.5">
                        @{
                            var width = 100.0 / Math.Max(1, pts.Count);
                            var x = 0.0;
                        }
                        @foreach (var p in pts)
                        {
                            var h = (p.Decisions * 28.0) / maxDec;
                            var y = 30 - h;
                            <rect x="@(x.ToString("0.0"))" y="@(y.ToString("0.0"))" width="@((width-0.5).ToString("0.0"))" height="@(h.ToString("0.0"))" fill="#4f46e5" />
                            x += width;
                        }
                    </svg>
                    <div class="text-[10px] text-slate-500">@pts.Sum(p => p.Decisions) decisions</div>
                }
                else
                {
                    <div class="text-sm text-slate-400 mt-1">no data</div>
                }
            </div>
        </div>

        <form method="get" class="bg-white border border-slate-200 rounded-lg p-4 mb-3">
            <div class="grid grid-cols-1 md:grid-cols-7 gap-3">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Search</label>
                    <input type="text" name="Search" value="@Model.Filter.Search" placeholder="Customer / code"
                           class="w-full border border-slate-300 rounded px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">From</label>
                    <input type="text"
                           id="startDate"
                           name="StartDate"
                           value="@Model.Filter.StartDate"
                           placeholder="dd/MM/yyyy"
                           class="h-10 w-full rounded-md border border-bordercolor px-3 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">To</label>
                    <input type="text"
                           id="endDate"
                           name="EndDate"
                           value="@Model.Filter.EndDate"
                           placeholder="dd/MM/yyyy"
                           class="h-10 w-full rounded-md border border-bordercolor px-3 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Customer Type</label>
                    <select name="CustomerType" class="w-full border border-slate-300 rounded px-3 py-2 text-sm">
                        <option value="">All</option>
                        <option value="I" selected="@(Model.Filter.CustomerType == "I")">Individual</option>
                        <option value="C" selected="@(Model.Filter.CustomerType == "C")">Corporate</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Status</label>
                    <select name="CaseStatus" class="w-full border border-slate-300 rounded px-3 py-2 text-sm">
                        <option value="10" selected="@(Model.Filter.CaseStatus == 10)">All</option>
                        <option value="0" selected="@(Model.Filter.CaseStatus == 0)">Pending</option>
                        <option value="4" selected="@(Model.Filter.CaseStatus == 4)">Pending Sr. Mgmt</option>
                        <option value="6" selected="@(Model.Filter.CaseStatus == 6)">Daily Batch</option>
                        <option value="7" selected="@(Model.Filter.CaseStatus == 7)">On Hold</option>
                        <option value="1" selected="@(Model.Filter.CaseStatus == 1)">Whitelisted</option>
                        <option value="2" selected="@(Model.Filter.CaseStatus == 2)">Approved</option>
                        <option value="3" selected="@(Model.Filter.CaseStatus == 3)">Rejected</option>
                        <option value="5" selected="@(Model.Filter.CaseStatus == 5)">Auto</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">QA Status</label>
                    <select name="QaStatus" class="w-full border border-slate-300 rounded px-3 py-2 text-sm">
                        <option value="-1" selected="@(Model.Filter.QaStatus == -1)">All</option>
                        <option value="0" selected="@(Model.Filter.QaStatus == 0)">Not Reviewed</option>
                        <option value="1" selected="@(Model.Filter.QaStatus == 1)">Pending QA</option>
                        <option value="2" selected="@(Model.Filter.QaStatus == 2)">Approved</option>
                        <option value="3" selected="@(Model.Filter.QaStatus == 3)">Rejected</option>
                        <option value="4" selected="@(Model.Filter.QaStatus == 4)">Reopened</option>
                    </select>
                </div>
                <div class="flex items-end gap-2">
                    <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded">Apply</button>
                    <a href="@Url.Action("Index", "AmlTracker")" class="px-3 py-2 text-sm text-slate-600 hover:text-slate-900">Reset</a>
                </div>
            </div>
        </form>

        <div class="bg-white border border-slate-200 rounded-lg p-3 mb-3 flex flex-wrap items-center gap-2 text-xs">
            <span class="text-slate-600 font-medium">Saved views:</span>
            @if (!Model.SavedViews.Any())
            {
                <span class="text-slate-400 italic">none yet</span>
            }
            else
            {
                foreach (var v in Model.SavedViews)
                {
                    <button type="button" onclick='applySavedView(@Html.Raw(Json.Serialize(v.FilterJson)))'
                            class="px-2 py-1 border border-slate-300 hover:bg-slate-50 rounded">@v.Name@(v.IsShared ? " ★" : "")</button>
                }
            }
            <button type="button" onclick="openSavedViewModal()" class="ml-2 px-2 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded">Save current as…</button>
        </div>

        <form id="batchForm" method="post" action="@Url.Action("BatchAction", "AmlTracker")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Action" id="batchActionInput" value="" />
            <input type="hidden" name="Comments" id="batchComments" value="" />
            <input type="hidden" name="ReasonCode" id="batchReasonCode" value="" />
            <input type="hidden" name="NewOwnerId" id="batchNewOwnerId" value="" />
            <input type="hidden" name="SamplePercent" id="batchSamplePercent" value="" />
            <input type="hidden" name="HighPercent" id="batchHighPct" value="" />
            <input type="hidden" name="MediumPercent" id="batchMedPct" value="" />
            <input type="hidden" name="LowPercent" id="batchLowPct" value="" />

            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 mb-3 flex flex-wrap items-center gap-2">
                <span class="text-sm text-slate-700"><span id="selectedCount" class="font-semibold">0</span> selected</span>
                <span class="mx-2 text-slate-300">|</span>

                <button type="button" onclick="submitBatch('MarkForQa')" @(Model.CurrentUserCanQa ? "" : "disabled") title="@qaBtnTitle"
                        class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded @qaBtnDisabled">Mark for QA</button>
                <button type="button" onclick="openQaModal('approve')" @(Model.CurrentUserCanQa ? "" : "disabled") title="@qaBtnTitle"
                        class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium rounded @qaBtnDisabled">QA Approve</button>
                <button type="button" onclick="openQaModal('reject')" @(Model.CurrentUserCanQa ? "" : "disabled") title="@qaBtnTitle"
                        class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium rounded @qaBtnDisabled">QA Reject</button>

                <span class="mx-2 text-slate-300">|</span>
                <select id="reassignSelect" class="border border-slate-300 rounded px-2 py-1 text-xs">
                    <option value="">Reassign to…</option>
                    @foreach (var u in Model.OwnerOptions) { <option value="@u.Id">@u.Name</option> }
                </select>
                <button type="button" onclick="submitReassign()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white text-xs font-medium rounded">Reassign</button>

                <span class="mx-2 text-slate-300">|</span>
                <span class="text-xs text-slate-600">Sample</span>
                <input type="number" id="samplePctInput" min="1" max="100" value="10" class="w-14 border border-slate-300 rounded px-2 py-1 text-xs" />
                <span class="text-xs text-slate-600">%</span>
                <button type="button" onclick="submitSample()" @(Model.CurrentUserCanQa ? "" : "disabled") title="@qaBtnTitle"
                        class="px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white text-xs font-medium rounded @qaBtnDisabled">Sample</button>
                <button type="button" onclick="openStratifiedModal()" @(Model.CurrentUserCanQa ? "" : "disabled") title="@qaBtnTitle"
                        class="px-3 py-1.5 bg-violet-700 hover:bg-violet-800 text-white text-xs font-medium rounded @qaBtnDisabled">Stratified</button>

                <span class="ml-auto text-xs text-slate-500">Auto-refresh in <span id="refreshTimer">60</span>s · <button type="button" onclick="refreshSummary()" class="text-blue-600 hover:underline">refresh now</button></span>
            </div>

            <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr class="text-left">
                                <th class="px-3 py-2 w-8"><input type="checkbox" id="selectAll" onclick="toggleAll(this)" /></th>
                                
                                
