                                        <td class="px-3 py-2 text-xs text-slate-700">
                                            @{
                                                string dobText = "NA";

                                                if (!string.IsNullOrWhiteSpace(r.DOB) &&
                                                DateTime.TryParse(r.DOB, out DateTime dob) &&
                                                dob != DateTime.MinValue &&
                                                dob.Year != 1900)
                                                {
                                                    dobText = dob.ToString("dd/MM/yyyy");
                                                }
                                            }

                                            @dobText
                                        </td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.Gender) ? "NA" : r.Gender)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ChangeStatus) ? "NA" : r.ChangeStatus)</td>
                                        <td class="px-3 py-2 text-xs">
                                            @{
                                                bool isNA = r.MatchScore == null || r.MatchScore == 0;

                                                var scoreClass = isNA
                                                ? ""
                                                : r.MatchScore < 70
                                                ? "text-green-600 font-semibold"
                                                : r.MatchScore < 85
                                                ? "text-orange-500 font-semibold"
                                                : "text-red-600 font-semibold";
                                            }

                                    <span class="@scoreClass">
                                        @(isNA ? "NA" : r.MatchScore.ToString())
                                    </span>
                                </td>
                                @functions {
                                    public string GetRiskScoreClass(string riskScore)
                                    {
                                        var score = (riskScore ?? "").ToLower().Trim();

                                        if (score.Contains("low"))
                                            return "text-green-500";

                                        if (score.Contains("medium"))
                                            return "text-yellow-400";

                                        if (score.Contains("high"))
                                            return "text-red-500";

                                        if (string.IsNullOrWhiteSpace(score) || score == "unclassified")
                                            return "text-slate-400";

                                        return "text-black";
                                    }
                                }
                                <td class="px-3 py-2 text-xs">
                                    @{
                                        var riskScore = r.CustomerType == "Individual"
                                        ? r.Individual_final_risk_score
                                        : r.corporate_final_risk_score;
                                    }

                                    <span class="font-bold @(GetRiskScoreClass(riskScore))">
                                        @(string.IsNullOrWhiteSpace(riskScore)
                                                                                ? "Unclassified"
                                                                                : riskScore.Replace(" Risk", "").Replace("High (O)", "High(O)"))
                                    </span>
                                </td>
                                        <td class="px-3 py-2 text-xs">
                                            <span class="px-2 py-1 rounded-full case-status">
                                                @(string.IsNullOrWhiteSpace(r.StatusName) ? "NA" : r.StatusName)
