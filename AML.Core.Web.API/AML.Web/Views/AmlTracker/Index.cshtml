<div id="notifPanel" class="hidden fixed top-20 right-6 w-96 max-h-[70vh] bg-white shadow-xl border border-slate-200 rounded-lg z-50 overflow-hidden">
    <div class="p-3 border-b border-slate-200 flex items-center justify-between">
        <span class="font-semibold text-slate-800">Notifications</span>
        <div class="flex gap-2">
            <button type="button" onclick="markAllNotifsRead()" class="text-xs text-blue-600 hover:underline">Mark all read</button>
            <button type="button" onclick="document.getElementById('notifPanel').classList.add('hidden')" class="text-slate-500 hover:text-slate-800">&times;</button>
        </div>
    </div>
    <div id="notifBody" class="overflow-y-auto max-h-[60vh] p-2 text-sm">
        <div class="text-slate-500 italic p-2">Loading…</div>
    </div>
</div>

<div id="qaModal" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-5">
        <h3 id="qaModalTitle" class="text-lg font-semibold text-slate-800 mb-2">QA Decision</h3>
        <p id="qaModalSubtitle" class="text-sm text-slate-500 mb-3"></p>
        <label class="block text-xs font-medium text-slate-600 mb-1">Reason</label>
        <select id="qaModalReason" class="w-full border border-slate-300 rounded px-3 py-2 text-sm mb-3">
            <option value="">— select reason —</option>
            <option value="RiskTooLow">Risk score too low</option>
            <option value="InsufficientDocs">Insufficient documents</option>
            <option value="WrongCustomerType">Wrong customer type</option>
            <option value="WeakRationale">Weak rationale</option>
            <option value="MissingPepCheck">Missing PEP check</option>
            <option value="MissingAdverseMedia">Missing adverse media check</option>
            <option value="DataQuality">Data quality issue</option>
            <option value="Other">Other</option>
        </select>
        <textarea id="qaModalComments" rows="4" placeholder="Comments (required for QA Reject)"
                  class="w-full border border-slate-300 rounded px-3 py-2 text-sm"></textarea>
        <div class="flex justify-end gap-2 mt-4">
            <button type="button" onclick="closeQaModal()" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-900">Cancel</button>
            <button type="button" id="qaModalConfirm" class="px-4 py-2 text-white text-sm font-medium rounded"></button>
        </div>
    </div>
</div>

<div id="historyModal" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl p-5 max-h-[80vh] overflow-y-auto">
        <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold text-slate-800">QA History — Case #<span id="historyCaseId"></span></h3>
            <button type="button" onclick="closeHistory()" class="text-slate-500 hover:text-slate-800">&times;</button>
        </div>
        <div id="historyBody" class="text-sm"><div class="text-slate-500">Loading…</div></div>
    </div>
</div>

<div id="stratifiedModal" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-5">
        <h3 class="text-lg font-semibold text-slate-800 mb-2">Stratified QA Sampling</h3>
        <p class="text-sm text-slate-500 mb-3">Sample by risk tier — typical: 100% of High, 25% of Medium, 5% of Low.</p>
        <div class="grid grid-cols-3 gap-3 mb-4">
            <div><label class="block text-xs font-medium mb-1">High Risk %</label><input type="number" id="stratHigh" value="100" min="0" max="100" class="w-full border border-slate-300 rounded px-3 py-2 text-sm" /></div>
            <div><label class="block text-xs font-medium mb-1">Medium Risk %</label><input type="number" id="stratMed" value="25" min="0" max="100" class="w-full border border-slate-300 rounded px-3 py-2 text-sm" /></div>
            <div><label class="block text-xs font-medium mb-1">Low Risk %</label><input type="number" id="stratLow" value="5" min="0" max="100" class="w-full border border-slate-300 rounded px-3 py-2 text-sm" /></div>
        </div>
        <div class="flex justify-end gap-2">
            <button type="button" onclick="closeStratified()" class="px-4 py-2 text-sm text-slate-600">Cancel</button>
            <button type="button" onclick="submitStratified()" class="px-4 py-2 bg-violet-700 hover:bg-violet-800 text-white text-sm font-medium rounded">Sample</button>
        </div>
    </div>
</div>

<div id="sarModal" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">
    <form method="post" action="@Url.Action("SaveSar","AmlTracker")" class="bg-white rounded-lg shadow-xl w-full max-w-lg p-5">
        @Html.AntiForgeryToken()
        <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold text-slate-800">SAR / STR Linkage — Case #<span id="sarCaseId"></span></h3>
            <button type="button" onclick="closeSar()" class="text-slate-500 hover:text-slate-800">&times;</button>
        </div>
        <input type="hidden" name="CaseId" id="sarCaseIdInput" />
        <div class="grid grid-cols-2 gap-3 mb-3">
            <div>
                <label class="block text-xs font-medium mb-1">SAR Status</label>
                <select name="SarStatus" id="sarStatus" class="w-full border border-slate-300 rounded px-3 py-2 text-sm">
                    <option value="NotRequired">Not Required</option>
                    <option value="Required">Required</option>
                    <option value="Drafted">Drafted</option>
                    <option value="Filed">Filed</option>
                    <option value="NotFiled">Not Filed</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium mb-1">SAR Reference</label>
                <input type="text" name="SarReference" id="sarRef" class="w-full border border-slate-300 rounded px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-medium mb-1">Filing Deadline</label>
                <input type="date" name="SarFilingDeadline" id="sarDeadline" class="w-full border border-slate-300 rounded px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-medium mb-1">Filed On</label>
                <input type="date" name="FiledOn" id="sarFiledOn" class="w-full border border-slate-300 rounded px-3 py-2 text-sm" />
            </div>
        </div>
        <label class="block text-xs font-medium mb-1">Notes</label>
        <textarea name="Notes" id="sarNotes" rows="3" class="w-full border border-slate-300 rounded px-3 py-2 text-sm"></textarea>
        <div class="flex justify-end gap-2 mt-4">
            <button type="button" onclick="closeSar()" class="px-4 py-2 text-sm text-slate-600">Cancel</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded">Save</button>
        </div>
    </form>
</div>

<div id="savedViewModal" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">
    <form method="post" action="@Url.Action("SaveView","AmlTracker")" class="bg-white rounded-lg shadow-xl w-full max-w-md p-5">
        @Html.AntiForgeryToken()
        <h3 class="text-lg font-semibold text-slate-800 mb-3">Save Current Filter as View</h3>
        <label class="block text-xs font-medium mb-1">Name</label>
        <input type="text" name="name" required class="w-full border border-slate-300 rounded px-3 py-2 text-sm mb-3" placeholder="My QA Queue" />
        <input type="hidden" name="filterJson" id="savedViewJson" />
        <label class="inline-flex items-center gap-2 mb-3 text-sm">
            <input type="checkbox" name="isShared" value="true" /> Share with all users in tenant
        </label>
        <div class="flex justify-end gap-2">
            <button type="button" onclick="closeSavedViewModal()" class="px-4 py-2 text-sm text-slate-600">Cancel</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded">Save</button>
        </div>
    </form>
</div>

<style>
.tracker-compact table { font-size: 11px; }
.tracker-compact td, .tracker-compact th { padding-top: 2px !important; padding-bottom: 2px !important; }
</style>

@section Scripts {
<script>

                     function initDatePicker(selector, defaultDate, maxToday = false) {
                return flatpickr(selector, {
                    dateFormat: "d/m/Y",
                    defaultDate: defaultDate,
                    maxDate: maxToday ? "today" : null
                });
            }

            document.addEventListener("DOMContentLoaded", function () {

                const startDate = new Date();
                startDate.setDate(startDate.getDate() - 365);

                const startPicker = initDatePicker("#startDate", startDate);

                // End date -> today
                const endPicker = initDatePicker("#endDate", new Date(), true);
            });

                    function formatCaseStatus(statusText) {
                if (!statusText) return '';

                const t = statusText.toLowerCase().trim();

                if (t.includes('pending')) return 'bg-yellow-100 text-yellow-800';
                if (t.includes('hold')) return 'bg-orange-500 text-white';
                if (t.includes('approved')) return 'bg-green-700 text-white';
                if (t.includes('white')) return 'bg-indigo-600 text-white';
                if (t.includes('wait')) return 'bg-indigo-600 text-white';
                if (t.includes('auto')) return 'bg-green-100 text-green-800';
                if (t.includes('transfer')) return 'bg-green-100 text-green-800';
                if (t.includes('rejected')) return 'bg-red-100 text-red-800';

                return 'bg-slate-100 text-textprimary';
            }
                         document.querySelectorAll('.case-status').forEach(el => {
                el.classList.add(...formatCaseStatus(el.innerText).split(' '));
            });
/* ── Optional-columns toggle (Columns button) ─────────────────────────────
   Reads metadata from <th class="col-opt" data-col-key data-col-label> tags,
   builds a checkbox list, persists user selection to localStorage. */
const COLS_LSKEY = 'amltracker.optionalCols.v1';
function getOptionalColKeys() {
    return Array.from(document.querySelectorAll('thead th.col-opt'))
        .map(th => ({ key: th.dataset.colKey, label: th.dataset.colLabel || th.textContent.trim() }));
}
function loadColSelection() {
    try {
        const raw = localStorage.getItem(COLS_LSKEY);
        // First visit (no preference saved yet) → default to all optional columns visible.
        // Once the user toggles anything, their explicit choice is saved and respected.
        if (raw === null) return new Set(getOptionalColKeys().map(c => c.key));
        return new Set(JSON.parse(raw));
    } catch { return new Set(); }
}
function saveColSelection(set) {
    localStorage.setItem(COLS_LSKEY, JSON.stringify(Array.from(set)));
}
function applyColSelection(set) {
    document.querySelectorAll('.col-opt').forEach(el => {
        const key = el.dataset.colKey || (el.className.match(/col-([A-Za-z0-9]+)/) || [])[1];
        if (key && set.has(key)) el.classList.remove('hidden');
        else if (key) el.classList.add('hidden');
    });
}
function applyColByKey(key, on) {
    document.querySelectorAll('.col-opt.col-' + key).forEach(el => {
        if (on) el.classList.remove('hidden'); else el.classList.add('hidden');
    });
}
function setAllOptionalCols(on) {
    const cols = getOptionalColKeys();
    const set = on ? new Set(cols.map(c => c.key)) : new Set();
    saveColSelection(set);
    cols.forEach(c => {
        const cb = document.getElementById('colcb-' + c.key);
        if (cb) cb.checked = on;
    });
    applyColSelection(set);
}
function buildColumnsPanel() {
    const list = document.getElementById('columnsList');
    if (!list) return;
    const cols = getOptionalColKeys();
    const sel = loadColSelection();
    list.innerHTML = cols.map(c =>
        '<label class="flex items-center gap-2 px-1 py-0.5 hover:bg-slate-50 rounded cursor-pointer">' +
        '<input type="checkbox" id="colcb-' + c.key + '" data-col-key="' + c.key + '" ' +
        (sel.has(c.key) ? 'checked' : '') + ' />' +
        '<span class="text-slate-700">' + c.label + '</span></label>'
    ).join('');
    list.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        cb.addEventListener('change', e => {
            const k = e.target.dataset.colKey;
            const cur = loadColSelection();
            if (e.target.checked) cur.add(k); else cur.delete(k);
            saveColSelection(cur);
            applyColByKey(k, e.target.checked);
        });
    });
    applyColSelection(sel);
}
document.addEventListener('DOMContentLoaded', buildColumnsPanel);
// Close popover on outside click
document.addEventListener('click', e => {
    const panel = document.getElementById('columnsPanel');
    const btn = document.getElementById('columnsToggleBtn');
    if (!panel || panel.classList.contains('hidden')) return;
    if (!panel.contains(e.target) && !btn.contains(e.target)) panel.classList.add('hidden');
});

function updateCount() {
    var n = document.querySelectorAll('input.row-check:checked').length;
    document.getElementById('selectedCount').innerText = n;
}
function toggleAll(cb) {
    document.querySelectorAll('input.row-check').forEach(c => c.checked = cb.checked);
    updateCount();

}
function ensureAtLeastOne() {
    if (document.querySelectorAll('input.row-check:checked').length === 0) {
        alert('Select at least one case first.'); return false;
    } return true;
}
function clearHidden() {
    ['batchComments','batchReasonCode','batchNewOwnerId','batchSamplePercent','batchHighPct','batchMedPct','batchLowPct'].forEach(id => document.getElementById(id).value = '');
}
function submitBatch(action) {
    document.getElementById('batchActionInput').value = action;
    document.getElementById('batchForm').submit();
}
function submitReassign() {
    var sel = document.getElementById('reassignSelect');
    if (!sel.value) { alert('Pick an owner first.'); return; }
    if (!ensureAtLeastOne()) return;
    if (!confirm('Reassign ' + document.querySelectorAll('input.row-check:checked').length + ' case(s) to ' + sel.options[sel.selectedIndex].text + '?')) return;
    clearHidden();
    document.getElementById('batchNewOwnerId').value = sel.value;
    submitBatch('Reassign');
}
function submitSample() {
    var pct = parseInt(document.getElementById('samplePctInput').value, 10);
    if (!(pct > 0 && pct <= 100)) { alert('Sample percent must be 1-100.'); return; }
    if (!confirm('Sample ' + pct + '% of QA-eligible cases?')) return;
    clearHidden();
    document.getElementById('batchSamplePercent').value = pct;
    submitBatch('SampleForQa');
}
function quickAction(caseId, action) {
    if (!confirm('Apply ' + action + ' to case #' + caseId + '?')) return;
    document.querySelectorAll('input.row-check').forEach(c => c.checked = (c.value == String(caseId)));
    updateCount();
    clearHidden();
    submitBatch(action);
}

function openStratifiedModal() {
    document.getElementById('stratifiedModal').classList.remove('hidden');
    document.getElementById('stratifiedModal').classList.add('flex');
}
function closeStratified() {
    document.getElementById('stratifiedModal').classList.add('hidden');
    document.getElementById('stratifiedModal').classList.remove('flex');
}
function submitStratified() {
    var hi = parseInt(document.getElementById('stratHigh').value, 10);
    var md = parseInt(document.getElementById('stratMed').value, 10);
    var lo = parseInt(document.getElementById('stratLow').value, 10);
    clearHidden();
    document.getElementById('batchHighPct').value = hi;
    document.getElementById('batchMedPct').value = md;
    document.getElementById('batchLowPct').value = lo;
    submitBatch('StratifiedSample');
}

var qaModalAction = null;
function openQaModal(kind) {
    if (!ensureAtLeastOne()) return;
    qaModalAction = kind;
    var n = document.querySelectorAll('input.row-check:checked').length;
    var title = kind === 'approve' ? 'Approve QA' : 'Reject QA';
    var subtitle = kind === 'approve'
        ? 'Approves QA on ' + n + ' case(s). 4-eyes: cases you made or own will be skipped.'
        : 'Rejects QA on ' + n + ' case(s). Reopens to maker, emails them. Comment required.';
    document.getElementById('qaModalTitle').innerText = title;
    document.getElementById('qaModalSubtitle').innerText = subtitle;
    var btn = document.getElementById('qaModalConfirm');
    btn.innerText = kind === 'approve' ? 'Confirm Approve' : 'Confirm Reject';
    btn.className = 'px-4 py-2 text-white text-sm font-medium rounded ' + (kind === 'approve' ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-rose-600 hover:bg-rose-700');
    btn.onclick = confirmQa;
    document.getElementById('qaModalComments').value = '';
    document.getElementById('qaModalReason').value = '';
    var m = document.getElementById('qaModal');
    m.classList.remove('hidden'); m.classList.add('flex');
}
function closeQaModal() {
    var m = document.getElementById('qaModal');
    m.classList.add('hidden'); m.classList.remove('flex');
}
function confirmQa() {
    var comments = document.getElementById('qaModalComments').value.trim();
    var reason = document.getElementById('qaModalReason').value;
    if (qaModalAction === 'reject' && comments.length === 0) { alert('A comment is required for QA Reject.'); return; }
    clearHidden();
    document.getElementById('batchComments').value = comments;
    document.getElementById('batchReasonCode').value = reason;
    submitBatch(qaModalAction === 'approve' ? 'QaApprove' : 'QaReject');
}

function qaPillClass(code) {
    switch (code) { case 2: return 'bg-emerald-100 text-emerald-800'; case 3: return 'bg-rose-100 text-rose-800'; case 1: return 'bg-amber-100 text-amber-800'; case 4: return 'bg-blue-100 text-blue-800'; default: return 'bg-slate-100 text-slate-600'; }
}
function escapeHtml(s) { return s == null ? '' : String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }

function openQaHistory(caseId) {
    document.getElementById('historyCaseId').innerText = caseId;
    document.getElementById('historyBody').innerHTML = '<div class="text-slate-500">Loading…</div>';
    document.getElementById('historyModal').classList.remove('hidden');
    document.getElementById('historyModal').classList.add('flex');
    fetch('@Url.Action("QaHistory","AmlTracker")/' + caseId, { credentials: 'same-origin' })
        .then(r => r.json())
        .then(items => {
            var body = document.getElementById('historyBody');
            if (!items || items.length === 0) { body.innerHTML = '<div class="text-slate-500 italic">No QA actions recorded yet.</div>'; return; }
            body.innerHTML = items.map(it => {
                var when = it.qaReviewedOn ? new Date(it.qaReviewedOn).toLocaleString() : '—';
                return '<div class="border border-slate-200 rounded p-3 mb-2">' +
                    '<div class="flex items-center justify-between mb-1">' +
                    '<span class="px-2 py-0.5 text-xs rounded-full ' + qaPillClass(it.qaStatus) + '">' + escapeHtml(it.qaStatusLabel) + '</span>' +
                    '<span class="text-xs text-slate-500">' + escapeHtml(when) + '</span></div>' +
                    '<div class="text-sm text-slate-700"><strong>Reviewer:</strong> ' + escapeHtml(it.qaReviewerName || '—') + '</div>' +
                    (it.qaComments ? '<div class="text-sm text-slate-600 mt-1 whitespace-pre-wrap">' + escapeHtml(it.qaComments) + '</div>' : '') + '</div>';
            }).join('');
        }).catch(e => { document.getElementById('historyBody').innerHTML = '<div class="text-rose-700">Failed to load.</div>'; });
}
function closeHistory() {
    document.getElementById('historyModal').classList.add('hidden');
    document.getElementById('historyModal').classList.remove('flex');
}

function openSar(caseId) {
    document.getElementById('sarCaseId').innerText = caseId;
    document.getElementById('sarCaseIdInput').value = caseId;
    fetch('@Url.Action("GetSar","AmlTracker")/' + caseId, { credentials: 'same-origin' })
        .then(r => r.json())
        .then(d => {
            document.getElementById('sarStatus').value = d.sarStatus || 'NotRequired';
            document.getElementById('sarRef').value = d.sarReference || '';
            document.getElementById('sarDeadline').value = d.sarFilingDeadline || '';
            document.getElementById('sarFiledOn').value = d.filedOn || '';
            document.getElementById('sarNotes').value = d.notes || '';
        });
    document.getElementById('sarModal').classList.remove('hidden');
    document.getElementById('sarModal').classList.add('flex');
}
function closeSar() {
    document.getElementById('sarModal').classList.add('hidden');
    document.getElementById('sarModal').classList.remove('flex');
}

function openSavedViewModal() {
    var qs = window.location.search;
    document.getElementById('savedViewJson').value = qs;
    document.getElementById('savedViewModal').classList.remove('hidden');
    document.getElementById('savedViewModal').classList.add('flex');
}
function closeSavedViewModal() {
    document.getElementById('savedViewModal').classList.add('hidden');
    document.getElementById('savedViewModal').classList.remove('flex');
}
function applySavedView(filterJson) {
    if (!filterJson) return;
    if (filterJson.startsWith('?')) { window.location.search = filterJson; return; }
    try { var f = JSON.parse(filterJson); var p = new URLSearchParams(f); window.location.search = '?' + p.toString(); } catch(e) { window.location.search = filterJson; }
}

// Notifications
function loadNotifs() {
    fetch('@Url.Action("Notifications","AmlTracker")?onlyUnread=false&limit=20', { credentials: 'same-origin' })
        .then(r => r.json())
        .then(items => {
            var b = document.getElementById('notifBody');
            if (!items || items.length === 0) { b.innerHTML = '<div class="p-3 text-slate-500 italic">No notifications.</div>'; return; }
            b.innerHTML = items.map(n => {
                var when = n.createdOn ? new Date(n.createdOn).toLocaleString() : '';
                return '<div class="p-2 mb-1 border-l-2 ' + (n.isRead ? 'border-slate-200' : 'border-blue-500 bg-blue-50/40') + '">' +
                    '<div class="font-medium text-sm">' + escapeHtml(n.title) + '</div>' +
                    '<div class="text-xs text-slate-600">' + escapeHtml(n.body || '') + '</div>' +
                    '<div class="text-[10px] text-slate-400 mt-0.5">' + when + (n.link ? ' · <a href="'+ escapeHtml(n.link) +'" class="text-blue-600">open</a>' : '') + '</div></div>';
            }).join('');
        });
}
function markAllNotifsRead() {
    var fd = new FormData();
    fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    fetch('@Url.Action("MarkAllRead","AmlTracker")', { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(() => { var b = document.getElementById('notifBadge'); if (b) b.classList.add('hidden'); loadNotifs(); });
}
loadNotifs();

// S3: polling for real-time KPI updates
var refreshSec = 60;
function tickRefresh() {
    refreshSec--;
    if (refreshSec <= 0) { refreshSec = 60; refreshSummary(); }
    var el = document.getElementById('refreshTimer'); if (el) el.innerText = refreshSec;
}
function refreshSummary() {
    fetch('@Url.Action("Summary","AmlTracker")', { credentials: 'same-origin' })
        .then(r => r.json())
        .then(s => {
            var el = document.getElementById('kpi-sla-breach'); if (el) el.innerText = s.slaBreach;
            var b = document.getElementById('notifBadge');
            if (b) {
                if (s.unreadNotifications > 0) { b.innerText = s.unreadNotifications; b.classList.remove('hidden'); }
                else { b.classList.add('hidden'); }
            }
        });
}
setInterval(tickRefresh, 1000);


</script>
}
