                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.EmiratesIdExpiryDate) ? "NA" : r.EmiratesIdExpiryDate)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.PassportId) ? "NA" : r.PassportId)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.PassportIssueDate) ? "NA" : r.PassportIssueDate)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.PassportExpiryDate) ? "NA" : r.PassportExpiryDate)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.Profession) ? "NA" : r.Profession)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ResidentStatus) ? "NA" : r.ResidentStatus)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.SOWSOFCountry) ? "NA" : r.SOWSOFCountry)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.CounterParty) ? "NA" : r.CounterParty)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.CounterPartyName) ? "NA" : r.CounterPartyName)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ProductType) ? "NA" : r.ProductType)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ProductValue) ? "NA" : r.ProductValue)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.DeliveryChannel) ? "NA" : r.DeliveryChannel)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.PaymentMode) ? "NA" : r.PaymentMode)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.DomesticPep) ? "NA" : r.DomesticPep)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ForeginPep) ? "NA" : r.ForeginPep)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.RedFlags) ? "NA" : r.RedFlags)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.HighNetwork) ? "NA" : r.HighNetwork)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.UAEUNSanction) ? "NA" : r.UAEUNSanction)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.OtherSanction) ? "NA" : r.OtherSanction)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.LegalStatus) ? "NA" : r.LegalStatus)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.BusinessType) ? "NA" : r.BusinessType)</td>

                               

                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.Employer) ? "NA" : r.Employer)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.EmployerIndustry) ? "NA" : r.EmployerIndustry)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.EmployerSector) ? "NA" : r.EmployerSector)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.GoldenVisa) ? "NA" : r.GoldenVisa)</td>
                                        <td class="px-3 py-2   text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ClientCifNumber) ? "NA" : r.ClientCifNumber)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.ProductRefNo) ? "NA" : r.ProductRefNo)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.Tradelicense) ? "NA" : r.Tradelicense)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.TradeLicenseAuthority) ? "NA" : r.TradeLicenseAuthority)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.TradeLicenseSector) ? "NA" : r.TradeLicenseSector)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.CreatedUser) ? "NA" : r.CreatedUser)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.QAStatus) ? "NA" : r.QAStatus)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.QAReason) ? "NA" : r.QAReason)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.QAComments) ? "NA" : r.QAComments)</td>
                                        <td class="px-3 py-2  text-xs text-slate-700">@(string.IsNullOrWhiteSpace(r.QAReviewerName) ? "NA" : r.QAReviewerName)</td>
                                <td class="px-3 py-2">
                                    <div class="text-xs text-textlabel">
                                        <div>
                                            @(r.QAReviewdOn?.ToString("dd/MM/yyyy") ?? "NA")
                                        </div>

                                        <div class="ml-2">
                                            @(r.QAReviewdOn?.ToString("HH:mm:ss") ?? "")
                                        </div>
                                    </div>
                                </td>
                                        

                                        @*                                         <td class="px-3 py-2 whitespace-nowrap">
                                            <button type="button" onclick="openQaHistory(@r.CaseId)" class="text-xs text-blue-600 hover:underline mr-1" title="QA history"><i class="fas fa-history"></i></button>
