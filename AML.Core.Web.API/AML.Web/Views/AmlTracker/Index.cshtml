                            else
                            {
                                foreach (var r in Model.Rows)
                                {
                                    <tr class="border-b border-slate-100 hover:bg-slate-50 @(r.IsNewSinceLastVisit ? "bg-blue-50/40" : "") @(r.IsStale ? "ring-1 ring-amber-200" : "")">
                                        <td class="px-3 py-2"><input type="checkbox" name="CaseIds" value="@r.CaseId" class="row-check" onchange="updateCount()" /></td>
                                        @* <td class="px-3 py-2 text-slate-600">@r.CaseId</td> *@
                                        <td class="px-3 py-2 text-slate-600">@r.CustomerCode</td>
                                        <td class="px-3 py-2">
                                            <div class="text-xs text-textlabel">
                                                <div>
                                                    @(r.CreatedOn?.ToString("dd/MM/yyyy") ?? "NA")
                                                </div>

                                                <div class="ml-2">
                                                    @(r.CreatedOn?.ToString("HH:mm:ss") ?? "")
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-3 py-2">
                                            <div class="text-xs text-textlabel">
                                                <div>
                                                    @(r.UpdatedOn?.ToString("dd/MM/yyyy") ?? "NA")
                                                </div>

                                                <div class="ml-2">
                                                    @(r.UpdatedOn?.ToString("HH:mm:ss") ?? "")
                                                </div>
                                            </div>
                                        </td>
