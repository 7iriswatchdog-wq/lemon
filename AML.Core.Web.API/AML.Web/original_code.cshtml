    .details-badge {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        border-radius: 0.5rem;
        padding: 0.25rem 0.75rem;
        margin-right: 0.25rem;
        font-size: 0.95em;
    }

    .details-badge-red {
        background: #fee2e2;
        color: #b91c1c;
    }

    .details-img {
        border-radius: 0.75rem;
        border: 1px solid #e9effd;
        width: 170px;
        height: 170px;
        object-fit: cover;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .details-title {
        font-size: 2rem;
        font-weight: bold;
        color: #2563eb;
    }

    .details-back-btn {
        padding: 0.5rem 1.5rem;
        background: #2563eb;
        color: #fff;
        border-radius: 0.5rem;
        border: none;
        transition: background 0.2s;
    }

        .details-back-btn:hover {
            background: #1d4ed8;
        }

    .details-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #2563eb;
    }

    .details-note {
        color: #64748B;
        font-size: 0.98em;
    }

    .details-download-btn {
        padding: 0.5rem 1.5rem;
        background: #2563eb;
        color: #fff;
        border-radius: 0.5rem;
        border: none;
        transition: background 0.2s;
    }
</style>

