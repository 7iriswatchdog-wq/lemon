@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = localizer["Case Details"];
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
    var Clientlogo = HttpContextAccessor.HttpContext.Session.GetString("SessLogoUrl");
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Loader -->
<div id="loadingdetails" class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-10" style="display:flex;">
    <div class="dt-loader"><div></div><div></div><div></div><div></div></div>
</div>

<style>
    table th, table td {
        text-align: center;
        vertical-align: middle;
        padding: 0.75rem;
        
    }

    /* Optional: Allow horizontal scrolling for smaller screens */
    .table-responsive {
        overflow-x: auto;
    }
    .dt-loader {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 20px;
    }

    .dt-loader div {
        position: absolute;
        top: 8px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: #2563eb;
        animation-timing-function: cubic-bezier(0, 1, 1, 0);
    }

        .dt-loader div:nth-child(1) {
            left: 8px;
            animation: dt-anim1 0.6s infinite;
        }

        .dt-loader div:nth-child(2) {
            left: 8px;
            animation: dt-anim2 0.6s infinite;
        }

        .dt-loader div:nth-child(3) {
            left: 32px;
            animation: dt-anim2 0.6s infinite;
        }

        .dt-loader div:nth-child(4) {
            left: 56px;
            animation: dt-anim3 0.6s infinite;
        }

    @@keyframes dt-anim1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes dt-anim2 {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(24px);
        }
    }

    @@keyframes dt-anim3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }
    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1rem;
        width: 100%;
    }

