<script>
     $(document).ready(function () {
        // Ensure loader shows immediately
        $("#loadingdetails").show();
    });

    $(window).on("load", function () {
        // Hide loader after everything including images is loaded
        $("#loadingdetails").fadeOut("slow");
    });

    // Show loader on back button click
    $(document).ready(function () {
        $('.details-back-btn').on('click', function () {
            $('#loadingdetails').show();
        });
    });
</script>